            "value": "キーを押すたびの音。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누를 때의 소리."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunyi setiap tekanan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O som de cada toque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как звучит каждое нажатие."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
