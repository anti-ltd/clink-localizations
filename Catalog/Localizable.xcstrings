    "Clink capitalises and adds punctuation on its own": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink kapitaliseer en voeg leestekens op sy eie by"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink schreibt groß und setzt Satzzeichen von selbst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink pone mayúsculas y puntuación por su cuenta"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kirjutab suure algustähe ja lisab kirjavahemärgid iseseisvalt"
