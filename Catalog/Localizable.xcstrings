    "Permanently removes every custom AI Tools action.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt dauerhaft alle eigenen KI-Tools-Aktionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente todas las acciones de herramientas de IA personalizadas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemaldab jäädavalt kõik kohandatud AI-tööriistade toimingud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement toutes les actions personnalisées des outils d’IA."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Végleg eltávolít minden egyéni MI-eszközműveletet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove definitivamente tutte le azioni degli strumenti IA personalizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのカスタムAIツールアクションを完全に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 사용자 설정 AI 도구 동작을 영구적으로 제거합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengalih keluar semua tindakan Alat AI tersuai secara kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove permanentemente todas as ações das ferramentas de IA personalizadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратно удаляет все пользовательские действия ИИ-инструментов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将永久移除所有自定 AI 工具操作。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină definitiv fiecare acțiune personalizată a Instrumentelor AI."
          }
        },
