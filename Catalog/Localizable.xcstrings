    "Restores the default pack and volume. Your custom packs stay.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Herstel die verstekpakket en -volume. Jou pasgemaakte pakke bly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt das Standardpaket und die Lautstärke wieder her. Deine eigenen Pakete bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece el paquete y el volumen predeterminados. Tus paquetes personalizados se conservan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taastab vaikimisi paki ja helitugevuse. Sinu kohandatud pakid jäävad alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit le pack et le volume par défaut. Tes packs personnalisés sont conservés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítja az alapértelmezett csomagot és hangerőt. Az egyedi csomagjaid megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina il pacchetto e il volume predefiniti. I tuoi pacchetti personalizzati restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトのパックと音量に戻します。カスタムパックはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 팩과 볼륨으로 되돌립니다. 사용자 팩은 그대로 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulihkan pek dan kelantangan lalai. Pek tersuai anda kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura o pacote e o volume predefinidos. Os seus pacotes personalizados permanecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает стандартный пакет и громкость. Ваши собственные пакеты остаются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复默认音效包和音量。您的自定义音效包会保留。"
          }
        }
      }
    },
    "Restores the default pack, volume and tuning. Your custom packs stay.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece el paquete, el volumen y el sonido predeterminados. Conserva tus paquetes personalizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit le pack, le volume et les réglages du son par défaut. Tes packs personnalisés sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt Paket, Lautstärke und Klang auf die Standardwerte zurück. Deine eigenen Pakete bleiben erhalten."
          }
        },
        "it": {
          "stringUnit": {
