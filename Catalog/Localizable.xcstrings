          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato klávesa živě kreslí vlastní štítek (stav posunu, návratová akce pole, zeměkoule nebo prázdný mezerník), takže zde není co nastavovat."
