        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Teclas, liga o Modo com uma mão e escolhe um lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Клавиши», включите режим одной руки и выберите сторону."
