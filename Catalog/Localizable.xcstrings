    "Nothing on the board fits these filters. If it’s missing, send it in.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada del tablero encaja con estos filtros. Si falta algo, envíalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien sur le tableau ne correspond à ces filtres. S’il manque quelque chose, envoie-le."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts auf dem Board passt zu diesen Filtern. Wenn etwas fehlt, schick es uns."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente in bacheca corrisponde a questi filtri. Se manca qualcosa, mandacelo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada no quadro corresponde a estes filtros. Se faltar alguma coisa, envia-a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На доске нет ничего по этим фильтрам. Если чего-то не хватает, отправьте нам."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa di papan yang sepadan dengan penapis ini. Jika ada yang tiada, hantarkannya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A táblán semmi sem felel meg ezeknek a szűrőknek. Ha valami hiányzik, küldd be."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフィルタに合うものはボードにありません。見当たらない場合は送ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看板上没有符合这些筛选条件的内容。如果缺少什么，请发给我们。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 필터에 맞는 항목이 보드에 없습니다. 빠진 게 있다면 보내 주세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahvlil pole midagi, mis nende filtritega sobiks. Kui midagi on puudu, saada see meile."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic de pe placă nu se potrivește cu aceste filtre. Dacă lipsește, trimiteți-l."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets op het bord past op deze filters. Als het ontbreekt, stuur het dan op."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看板上沒有符合這些篩選條件的內容。如果缺少什麼，請發給我們。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Niks op die bord pas by hierdie filters nie. As dit ontbreek, dien dit in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic na płytce nie pasuje do tych filtrów. Jeśli go brakuje, wyślij go."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніщо на платі не підходить до цих фільтрів. Якщо він відсутній, надішліть його."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karttaki hiçbir şey bu filtrelere uymuyor. Eksikse gönderin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tyto filtry nic na desce nepasuje. Pokud chybí, pošlete ji."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič na doske nepasuje do týchto filtrov. Ak chýba, pošlite ho."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα στον πίνακα δεν ταιριάζει σε αυτά τα φίλτρα. Εάν λείπει, στείλτε το."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget på tavlan passar dessa filter. Om den saknas, skicka in den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet på brættet passer til disse filtre. Hvis den mangler, så send den ind."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting på brettet passer til disse filtrene. Hvis den mangler, send den inn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään levyllä ei sovi näihin suodattimiin. Jos se puuttuu, lähetä se."
