        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på språkknappen på slutten av forslagslinjen for neste språk, eller hold den for å velge ett."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
