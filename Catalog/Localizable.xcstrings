    "Slide to move the cursor, and lift where you want it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skuif om die wyser te beweeg en lig op waar jy dit wil hê."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh, um den Cursor zu bewegen, und heb den Finger dort, wo er stehen soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para mover el cursor y levanta el dedo donde lo quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Libista, et kursorit liigutada, ja tõsta sõrm seal, kus tahad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser pour déplacer le curseur et lève le doigt à l'endroit voulu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzással mozgasd a kurzort, és ott emeld fel az ujjad, ahol jó."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri per spostare il cursore e solleva il dito dove vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのままスライドしてカーソルを動かし、置きたい位置で指を離します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밀어서 커서를 옮기고, 원하는 자리에서 손가락을 떼세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret untuk menggerakkan kursor, dan angkat jari di tempat yang anda mahu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para mover o cursor e levanta o dedo onde o queres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведите, чтобы двигать курсор, и поднимите палец там, где он вам нужен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动移动光标，到位了就抬手。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisați pentru a muta cursorul și ridicați-l unde doriți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schuif om de cursor te verplaatsen en til hem op waar u hem wilt hebben."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑動移動游標，到位了就抬手。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń, aby przesunąć kursor, i podnieś tam, gdzie chcesz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведіть пальцем, щоб перемістити курсор, і підніміть, де вам потрібно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmleci hareket ettirmek için kaydırın ve istediğiniz yere kaldırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posunutím přesuňte kurzor a zvedněte jej, kam chcete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posunutím presuňte kurzor a zdvihnite ho tam, kde ho chcete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε για να μετακινήσετε τον κέρσορα και σηκώστε το όπου θέλετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att flytta markören och lyft dit du vill ha den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skub for at flytte markøren, og løft, hvor du vil have den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skyv for å flytte markøren, og løft dit du vil ha den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä kohdistinta liu'uttamalla ja nosta haluamaasi kohtaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
