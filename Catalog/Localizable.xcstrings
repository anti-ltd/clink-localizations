        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir genişletmeyi geri aldığınızda yeniden genişlemez"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraťte rozšíření a znovu se nerozbalí"
