    "Open the Clink keyboard with Full Access enabled to show the text replacements iOS shares with Clink.": {
      "comment": "Text replacement settings page. iOS entries are a read-only snapshot shared by the keyboard extension; Settings opens the app settings page.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Clink keyboard with Full Access enabled to show the text replacements iOS shares with Clink."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el teclado Clink con «Permitir acceso total» activado para ver las sustituciones de texto que iOS comparte con Clink."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le clavier Clink avec l’option « Autoriser l’accès complet » activée pour afficher les remplacements de texte qu’iOS partage avec Clink."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere „Vollen Zugriff erlauben“ und öffne die Clink-Tastatur, um die von iOS geteilten Textersetzungen anzuzeigen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la tastiera Clink con «Consenti accesso completo» attivo per vedere le sostituzioni testo che iOS condivide con Clink."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o teclado Clink com a opção «Permitir acesso total» ativada para veres as substituições de texto que o iOS partilha com o Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Разрешить полный доступ» и откройте клавиатуру Clink, чтобы увидеть замены текста, которые iOS передаёт Clink."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka papan kekunci Clink dengan “Benarkan Akses Penuh” diaktifkan untuk melihat penggantian teks yang dikongsi oleh iOS dengan Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a „Teljes hozzáférés engedélyezése” beállítást, majd nyisd meg a Clink billentyűzetet az iOS által megosztott szövegcserék megtekintéséhez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「フルアクセスを許可」をオンにしてClinkキーボードを開くと、iOSから共有されたユーザ辞書の項目が表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用“允许完全访问”后打开 Clink 键盘，即可查看 iOS 向 Clink 共享的文本替换。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘전체 접근 허용’을 켜고 Clink 키보드를 열면 iOS에서 Clink에 공유한 텍스트 대치 항목을 볼 수 있습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita sisse „Luba täielik juurdepääs” ja ava Clinki klaviatuur, et näha tekstiasendusi, mida iOS Clinkiga jagab."
          }
        }
      }
    },
