        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jurang mendatar antara kekunci bersebelahan dalam baris yang sama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço horizontal entre teclas ao lado uma da outra na mesma linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Горизонтальный зазор между соседними клавишами в одном ряду."
          }
        },
        "zh-Hans": {
