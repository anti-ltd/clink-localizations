    "Changes lists everything you've moved away from its default.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veranderinge lys alles wat jy van die verstek af wegbeweeg het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Änderungen“ listet alles auf, was du vom Standard weggedreht hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambios enumera todo lo que has movido de su valor por defecto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„Muudatused\" loetleb kõik, mille oled vaikeväärtusest eemaldanud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifications liste tout ce que tu as éloigné de sa valeur d'origine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Módosítások mindent felsorol, amit elmozdítottál az alapértékétől."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiche elenca tutto quello che hai spostato dal valore predefinito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「変更」には、初期値から動かしたものがすべて並びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항에는 기본값에서 바꾼 것이 모두 나열됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan menyenaraikan semua yang anda ubah daripada nilai lalainya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterações lista tudo o que afastaste do valor de origem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Изменениях» перечислено всё, что вы сдвинули со стандартного значения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“更改”会列出所有被你从默认值改动过的项。"
          }
        }
      }
    },
    "Changing access clears this plugin's saved state. Code and version changes require approval again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el acceso borra el estado guardado del plugin. Si cambia el código o la versión, se solicitará tu aprobación de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier les accès efface l’état enregistré de ce plugin. Tout changement de code ou de version nécessite un nouvel accord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du den Zugriff änderst, wird der gespeicherte Zustand dieses Plugins gelöscht. Änderungen an Code oder Version erfordern eine erneute Zustimmung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificare l’accesso cancella lo stato salvato del plugin. Le modifiche al codice o alla versione richiedono una nuova approvazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar o acesso apaga o estado guardado deste plugin. As alterações ao código ou à versão exigem nova aprovação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение доступа удалит сохранённое состояние плагина. При изменении кода или версии потребуется новое разрешение."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menukar akses memadamkan keadaan tersimpan pemalam ini. Perubahan kod atau versi memerlukan kelulusan semula."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hozzáférés módosítása törli a bővítmény mentett állapotát. A kód vagy a verzió módosításakor új jóváhagyás szükséges."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスを変更すると、このプラグインの保存済み状態が消去されます。コードやバージョンが変わると、再度承認が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改访问权限会清除插件保存的状态。代码或版本更改后需要重新批准。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근 권한을 변경하면 플러그인의 저장된 상태가 지워집니다. 코드나 버전이 변경되면 다시 승인해야 합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Juurdepääsu muutmine kustutab pistikprogrammi salvestatud oleku. Koodi või versiooni muutmine nõuab uut nõusolekut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing access clears this plugin's saved state. Code and version changes require approval again."
          }
        }
      }
    },
