          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Clink κατασκευάζεται από την anti.ltd. Οι άδειες λεξικών βρίσκονται στα Λεξικά κάτω από τα Πρόσθετα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink är tillverkad av anti.ltd. Ordbokslicenser finns i Ordböcker under Extras."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink er lavet af anti.ltd. Ordbogslicenser findes i Ordbøger under Ekstra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink is made by anti.ltd. Ordboklisenser er i Ordbøker under Ekstra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink on anti.ltd:n valmistama. Sanakirjalisenssit ovat Sanakirjat-kohdassa Ekstrat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink dibuat oleh anti.ltd. Lisensi kamus ada di Kamus di bawah Ekstra."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink được sản xuất bởi anti.ltd. Giấy phép từ điển có trong Từ điển trong phần Bổ sung."
          }
        }
      }
    },
    "Clink is offline with no accounts. Your keystrokes never leave the device. Full Access only lets the keyboard play audio and vibrate.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink is vanlyn met geen rekeninge nie. Jou toetsaanslagen verlaat nooit die toestel nie. Met volle toegang kan die sleutelbord slegs oudio speel en vibreer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink läuft offline, ganz ohne Accounts. Deine Tastenanschläge verlassen nie das Gerät. Vollzugriff erlaubt der Tastatur nur, Sound abzuspielen und zu vibrieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink funciona sin conexión y sin cuentas. Lo que escribes nunca sale del dispositivo. El acceso completo solo sirve para que el teclado reproduzca sonido y vibre."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink töötab ühenduseta, ilma kontodeta. Sinu klahvivajutused ei lahku kunagi seadmest. Täisjuurdepääs lubab klaviatuuril ainult heli esitada ja vibreerida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink marche hors ligne, sans compte. Tes frappes ne quittent jamais l'appareil. L'accès complet sert juste à jouer du son et à faire vibrer le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink offline, fiók nélkül. A leütéseid soha nem hagyják el a készüléket. A Teljes hozzáférés csak arra kell, hogy a billentyűzet hangot adjon és rezegjen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink è offline e senza account. Quello che scrivi non lascia mai il dispositivo. L'accesso completo serve solo a far suonare e vibrare la tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkはオフラインで動き、アカウントもいりません。あなたのキー入力がデバイスの外に出ることはありません。フルアクセスでできるのは、キーボードで音を鳴らしたり振動させたりすることだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink은 오프라인이고 계정이 없어요. 입력한 키는 절대 기기 밖으로 나가지 않아요. 전체 접근을 켜도 키보드가 소리를 내고 진동하는 데만 써요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink berfungsi luar talian tanpa akaun. Ketukan kekunci anda tak pernah keluar dari peranti. Akses Penuh cuma benarkan papan kekunci mainkan audio dan bergetar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink funciona offline e sem contas. As tuas teclas nunca saem do dispositivo. O acesso total só deixa o teclado tocar áudio e vibrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink работает офлайн и без аккаунтов. Нажатия клавиш никогда не покидают устройство. Полный доступ нужен клавиатуре только для звука и вибрации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 离线运行，不用账户。你敲的字绝不会离开设备。完全访问权限只是用来让键盘发声和振动。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink funcționează offline, fără conturi. Ceea ce tastezi nu părăsește niciodată dispozitivul. Accesul complet permite doar redarea sunetelor și vibrațiile tastaturii."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink is offline zonder accounts. Uw toetsaanslagen verlaten het apparaat nooit. Met Volledige toegang kan het toetsenbord alleen audio afspelen en trillen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 離線執行，不用賬戶。你敲的字絕不會離開裝置。完整取用許可權只是用來讓鍵盤發聲和振動。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink jest offline i nie ma żadnych kont. Twoje naciśnięcia klawiszy nigdy nie opuszczają urządzenia. Pełny dostęp umożliwia jedynie odtwarzanie dźwięku i wibrację na klawiaturze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink офлайн, без облікових записів. Ваші натискання клавіш ніколи не залишають пристрій. Повний доступ дозволяє клавіатурі лише відтворювати звук і вібрувати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink çevrimdışı ve hesap yok. Tuş vuruşlarınız asla cihazın dışına çıkmaz. Tam Erişim yalnızca klavyenin ses çalmasına ve titreşime izin verir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink je offline bez účtů. Vaše stisknutí kláves nikdy neopustí zařízení. Plný přístup umožňuje klávesnici pouze přehrávat zvuk a vibrovat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink je offline bez účtov. Vaše stlačenia kláves nikdy neopustia zariadenie. Úplný prístup umožňuje iba klávesnici prehrávať zvuk a vibrovať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Clink είναι εκτός σύνδεσης χωρίς λογαριασμούς. Τα πλήκτρα σας δεν φεύγουν ποτέ από τη συσκευή. Η Full Access επιτρέπει στο πληκτρολόγιο μόνο να αναπαράγει ήχο και να δονείται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink är offline utan konton. Dina tangenttryckningar lämnar aldrig enheten. Full åtkomst låter endast tangentbordet spela upp ljud och vibrera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink er offline uden konti. Dine tastetryk forlader aldrig enheden. Fuld adgang lader kun tastaturet afspille lyd og vibrere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink is offline with no accounts. Your keystrokes never leave the device. Full tilgang lar bare tastaturet spille av lyd og vibrere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink on offline-tilassa ilman tilejä. Näppäinpainallukset eivät koskaan poistu laitteesta. Full Access sallii vain näppäimistön toistaa ääntä ja värinän."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink offline tanpa akun. Penekanan tombol Anda tidak pernah meninggalkan perangkat. Akses Penuh hanya memungkinkan keyboard memutar audio dan bergetar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink đang ngoại tuyến và không có tài khoản. Tổ hợp phím của bạn không bao giờ rời khỏi thiết bị. Full Access chỉ cho phép bàn phím phát âm thanh và rung."
          }
        }
      }
    },
    "Clink keeps a light theme and a dark one and follows your phone. Picking from the keyboard replaces whichever of the two is on screen at the time.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink guarda un tema claro y otro oscuro, y sigue a tu teléfono. Elegir desde el teclado sustituye al que esté en pantalla en ese momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink garde un thème clair et un thème sombre, et suit ton téléphone. Choisir depuis le clavier remplace celui qui est à l'écran à ce moment-là."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink behält ein helles und ein dunkles Theme und richtet sich nach deinem Telefon. Eine Auswahl von der Tastatur ersetzt das, was gerade auf dem Bildschirm ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink tiene un tema chiaro e uno scuro e segue il telefono. Sceglierne uno dalla tastiera sostituisce quello che in quel momento è sullo schermo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink guarda um tema claro e outro escuro e segue o telemóvel. Escolher a partir do teclado substitui aquele que estiver no ecrã nesse momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink хранит светлую и тёмную темы и следует за настройкой телефона. Выбор с клавиатуры заменяет ту из них, которая сейчас на экране."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink menyimpan satu tema cerah dan satu tema gelap dan mengikut telefon anda. Memilih dari papan kekunci akan menggantikan tema yang sedang dipaparkan ketika itu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink külön világos és sötét témát tart, és a telefonodat követi. A billentyűzetről választott téma azt váltja le, amelyik éppen a képernyőn van."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink はライトとダークのテーマをそれぞれ持ち、端末の設定に合わせます。キーボードから選ぶと、そのとき画面に出ている側が入れ替わります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 会分别保存浅色和深色两个主题，并跟随手机的设置。从键盘选择时，替换的是当时屏幕上正在用的那一个。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink는 밝은 테마와 어두운 테마를 따로 두고 기기 설정을 따릅니다. 키보드에서 고르면 그때 화면에 쓰이고 있는 쪽이 바뀝니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink hoiab eraldi heledat ja tumedat teemat ning järgib telefoni seadet. Klaviatuurilt valimine asendab selle, mis parajasti ekraanil on."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink păstrează o temă deschisă și una întunecată și urmărește telefonul dvs. Alegerea de la tastatură înlocuiește oricare dintre cele două care se află pe ecran în acel moment."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink heeft een licht thema en een donker thema en volgt je telefoon. Als u vanaf het toetsenbord kiest, vervangt u welke van de twee op dat moment op het scherm staat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 會分別儲存淺色和深色兩個主題，並跟隨手機的設定。從鍵盤選擇時，替換的是當時螢幕上正在用的那一個。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink hou 'n ligtema en 'n donkertema en volg jou foon. Kies van die sleutelbord vervang watter een van die twee tans op skerm is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ma jasny i ciemny motyw i podąża za Twoim telefonem. Wybieranie z klawiatury zastępuje tę, która jest w danym momencie widoczna na ekranie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink зберігає світлу та темну теми та стежить за вашим телефоном. Вибір із клавіатури замінює будь-який із двох, який у цей момент відображається на екрані."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink açık ve koyu bir temayı tutar ve telefonunuzu takip eder. Klavyeden seçim yapmak, o anda ikisinden hangisinin ekranda olduğunu değiştirir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink si zachovává světlé a tmavé téma a následuje váš telefon. Vybírání z klávesnice nahradí to, co je v daný okamžik na obrazovce."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink si zachováva svetlú a tmavú tému a nasleduje váš telefón. Výber z klávesnice nahradí to, čo je v danom čase na obrazovke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Clink διατηρεί ένα ανοιχτό και ένα σκοτεινό θέμα και ακολουθεί το τηλέφωνό σας. Η επιλογή από το πληκτρολόγιο αντικαθιστά όποιο από τα δύο είναι στην οθόνη εκείνη τη στιγμή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink håller ett ljust och ett mörkt tema och följer din telefon. Att välja från tangentbordet ersätter den av de två som visas på skärmen vid tillfället."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink beholder et lyst tema og et mørkt og følger din telefon. Valg fra tastaturet erstatter den af ​​de to, der er på skærmen på det tidspunkt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink beholder et lyst tema og et mørkt og følger telefonen din. Å velge fra tastaturet erstatter den av de to som er på skjermen på det tidspunktet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink säilyttää vaalean ja tumman teeman ja seuraa puhelintasi. Näppäimistöltä poimiminen korvaa sen, kumpi näistä kahdesta on näytöllä sillä hetkellä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink mempertahankan tema terang dan gelap serta mengikuti ponsel Anda. Memilih dari keyboard akan menggantikan keduanya yang ada di layar pada saat itu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink giữ chủ đề sáng và tối và đi theo điện thoại của bạn. Chọn từ bàn phím sẽ thay thế bất kỳ cái nào trong hai cái trên màn hình vào thời điểm đó."
          }
        }
      }
    },
