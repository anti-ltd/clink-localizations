    "Tap a tool, or hold the button and slide onto one in a single move.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik 'n instrument, of hou die knoppie in en gly op een in 'n enkele beweging."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe ein Werkzeug an oder halte die Taste gedrückt und zieh in einer Bewegung auf eines davon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una herramienta, o mantén pulsado el botón y deslízate hasta una en un solo movimiento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta tööriistal või hoia nuppu all ja libise ühele liigutusega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un outil, ou maintiens le bouton et glisse jusqu'à l'un d'eux d'un seul geste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy eszközre, vagy tartsd nyomva a gombot, és egyetlen mozdulattal csúszz rá valamelyikre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca uno strumento, oppure tieni premuto il pulsante e scivola su uno in un solo movimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールをタップするか、ボタンを長押ししたまま目的のツールへ一気にスライドします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구를 누르거나, 버튼을 누른 채 한 동작으로 원하는 도구까지 밀어 가세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik satu alat, atau tahan butang itu dan leret ke salah satunya dalam satu gerakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca numa ferramenta, ou mantém o botão premido e desliza até uma num só movimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на инструмент — или удержите кнопку и одним движением доведите палец до нужного."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点某个工具，或者按住按钮一路滑到某个工具上，一气呵成。"
          }
        }
      }
    },
    "Tap anything to change it. Hold and drag to move it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf etwas, um es zu ändern. Halten und ziehen, um es zu verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cualquier cosa para cambiarla. Mantén pulsado y arrastra para moverla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta, et muuta. Hoia ja lohista, et liigutada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un élément pour le modifier. Maintiens-le et fais-le glisser pour le déplacer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints bármire a módosításhoz. Tartsd lenyomva és húzd az áthelyezéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un elemento per cambiarlo. Tieni premuto e trascina per spostarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップで変更、長押ししてドラッグで移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 눌러 바꾸고, 길게 눌러 드래그하면 옮길 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik apa-apa untuk mengubahnya. Tahan dan seret untuk mengalihkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num elemento para o alterar. Mantenha-o premido e arraste para o mover."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на элемент, чтобы изменить его. Удерживайте и тяните, чтобы переместить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点即可更改，按住并拖动即可移动。"
          }
        }
      }
    },
    "Tap anywhere with another finger while dragging to start highlighting.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik enige plek met 'n ander vinger terwyl jy sleep om te begin uitlig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe während des Ziehens mit einem anderen Finger irgendwo hin, um zu markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca en cualquier parte con otro dedo mientras arrastras para empezar a marcar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta lohistamise ajal teise sõrmega kuskil, et alustada esiletõstmist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez n'importe où avec un autre doigt pendant le glissement pour commencer à sélectionner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints máshova a másik ujjaddal húzás közben, és onnan jelöl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ovunque con un altro dito mentre trascini per iniziare a selezionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグ中にもう一方の指でどこかをタップすると選択が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄는 동안 다른 손가락으로 아무 곳이나 탭하면 선택이 시작됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik di mana-mana dengan jari lain semasa menyeret untuk mula menonjolkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em qualquer lado com outro dedo enquanto arrastas para começar a destacar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь в любом месте другим пальцем во время перетаскивания, чтобы начать выделение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动时用另一根手指点按任意处即可开始选中。"
          }
        }
      }
    },
    "Tap anywhere with another finger while holding space to start highlighting.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik enige plek met 'n ander vinger terwyl jy spasie hou om te begin uitlig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe mit einem anderen Finger irgendwo hin, während du die Leertaste hältst, um zu markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca en cualquier parte con otro dedo mientras mantienes espacio para empezar a marcar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta tühiku hoidmise ajal teise sõrmega kuskil, et alustada esiletõstmist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans relâcher la barre d’espace, touche l’écran avec un autre doigt pour commencer à sélectionner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints máshova a másik ujjaddal, amíg a szóközt tartod, és onnan jelöl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ovunque con un altro dito mentre tieni premuto spazio per iniziare a selezionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースを押したまま、もう一方の指でどこかをタップすると選択が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스를 누른 채 다른 손가락으로 아무 곳이나 탭하면 선택이 시작됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik di mana-mana dengan jari lain semasa menahan ruang untuk mula menonjolkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em qualquer lado com outro dedo enquanto manténs o espaço para começar a destacar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь в любом месте другим пальцем, удерживая пробел, чтобы начать выделение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住空格时用另一根手指点按任意处即可开始选中。"
          }
        }
      }
    },
    "Tap buttons in the preview. Text they insert shows up here.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
