    "Want a key too? In Layout, add one and set its action to Tools menu.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wil jy ook 'n sleutel hê? In uitleg, voeg een by en stel die aksie daarvan op die Tools-kieslys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lieber eine Taste? Füge in „Layout“ eine hinzu und stell ihre Aktion auf „Tools-Menü“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿También quieres una tecla? En Diseño, añade una y pon su acción en Menú de herramientas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahad ka klahvi? Lisa Paigutuses üks ja määra selle tegevuseks Tööriistade menüü."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu veux aussi une touche ? Dans Disposition, ajoute-en une et règle son action sur Menu Outils."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Billentyűt is szeretnél? Az Elrendezésben adj hozzá egyet, és állítsd a műveletét Eszközök menüre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi anche un tasto? In Layout aggiungine uno e imposta la sua azione su Menu strumenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーも欲しいときは、「レイアウト」でキーを追加して、動作を「ツールメニュー」にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키도 두고 싶다면 ‘레이아웃’에서 키를 추가하고 동작을 ‘도구 메뉴’로 설정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahu kekunci juga? Dalam Susun atur, tambah satu dan tetapkan tindakannya kepada Menu alat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Também queres uma tecla? Em Esquema, adiciona uma e define a ação para Menu de ferramentas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хотите ещё и клавишу? Добавьте её в «Раскладке» и задайте действие «Меню инструментов»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也想要一个按键？在“布局”里加一个键，把它的动作设为“工具菜单”。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrei și cheie? În Aspect, adăugați unul și setați acțiunea în meniul Instrumente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wilt u ook een sleutel? Voeg er in Layout een toe en stel de actie in in het menu Extra."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也想要一個按鍵？在“佈局”里加一個鍵，把它的動作設為“工具選單”。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcesz też klucz? W Layout dodaj jeden i ustaw jego akcję na menu Narzędzia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хочете також ключ? У «Макеті» додайте його та встановіть для нього дію в меню «Інструменти»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir de anahtar ister misin? Düzen'de bir tane ekleyin ve eylemini Araçlar menüsüne ayarlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete také klíč? V rozvržení přidejte jeden a nastavte jeho akci na nabídku Nástroje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete aj kľúč? V rozložení pridajte jeden a nastavte jeho akciu na ponuku Nástroje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλετε και ένα κλειδί; Στο Layout, προσθέστε ένα και ορίστε την ενέργειά του στο μενού Εργαλεία."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du också ha en nyckel? I Layout, lägg till en och ställ in dess åtgärd på Verktyg-menyn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du også have en nøgle? I Layout skal du tilføje en og indstille dens handling til menuen Værktøjer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du også ha nøkkel? I Layout legger du til en og setter handlingen til Verktøy-menyen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko myös avaimen? Lisää Asettelussa yksi ja aseta sen toiminto Työkalut-valikkoon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mau kuncinya juga? Di Layout, tambahkan satu dan atur aksinya ke menu Tools."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn cũng muốn có chìa khóa à? Trong Bố cục, thêm một cái và đặt hành động của nó vào menu Công cụ."
          }
        }
      }
    },
