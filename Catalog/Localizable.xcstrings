          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O fotografie se umple în spatele tastelor și suprascrie gradientul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een foto vult achter de toetsen en overschrijft het verloop."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片鋪在按鍵後面，蓋過漸變。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie wypełnia klawisze i zastępuje gradient."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фотографія заповнюється за клавішами та перекриває градієнт."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir fotoğraf tuşların arkasını doldurur ve degradeyi geçersiz kılar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
