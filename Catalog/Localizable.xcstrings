        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbloccato per sempre. Grazie di esserci stato fin dall'inizio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ずっとアンロック済み。最初からいてくれてありがとう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평생 잠금 해제. 처음부터 함께해 주셔서 고마워요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
