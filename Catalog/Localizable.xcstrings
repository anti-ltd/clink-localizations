    "Paint the theme’s color, gradient or photo behind the keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verf die tema se kleur, gradiënt of foto agter die sleutels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Male die Farbe, den Verlauf oder das Foto des Themes hinter die Tasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta el color, degradado o foto del tema detrás de las teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Maali teema värv, üleminek või foto klahvide taha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peins la couleur, le dégradé ou la photo du thème derrière les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fesd fel a téma színét, színátmenetét vagy fotóját a billentyűk mögé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna il colore, la sfumatura o la foto del tema dietro i tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマの色、グラデーション、写真をキーの背後に描きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마의 색상, 그라데이션, 사진을 키 뒤에 깔아줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukis warna, kecerunan atau foto tema di sebalik kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta a cor, gradiente ou foto do tema por trás das teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисовать за клавишами цвет, градиент или фото темы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把主题的颜色、渐变或图片铺在按键背后。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pictează culoarea, gradientul sau fotografia temei în spatele tastelor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schilder de kleur, het verloop of de foto van het thema achter de toetsen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把主題的顏色、漸變或圖片鋪在按鍵背後。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomaluj kolor motywu, gradient lub zdjęcie za klawiszami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зафарбуйте колір теми, градієнт або фотографію за клавішами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşların arkasına temanın rengini, degradesini veya fotoğrafını boyayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Namalujte barvu, přechod nebo fotografii motivu za klávesy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaľujte farbu, prechod alebo fotografiu motívu za klávesmi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρωματίστε το χρώμα, τη διαβάθμιση ή τη φωτογραφία του θέματος πίσω από τα πλήκτρα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Måla temats färg, gradient eller foto bakom tangenterna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mal temaets farve, gradient eller foto bag tasterne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mal temaets farge, gradient eller bilde bak tastene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maalaa teeman väri, kaltevuus tai valokuva näppäinten taakse."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnai warna tema, gradien, atau foto di belakang tombol."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sơn màu, độ chuyển màu hoặc ảnh của chủ đề đằng sau các phím."
          }
        }
      }
    },
    "Paint the theme’s color, gradient or photo behind the keys. Off, the app you’re typing in shows through.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verf die tema se kleur, gradiënt of foto agter die sleutels. Af, die toepassing wat jy intik, wys deur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Malt die Farbe, den Verlauf oder das Foto des Designs hinter die Tasten. Aus scheint die App durch, in der du gerade tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta el color, el degradado o la foto del tema detrás de las teclas. Desactivado, se ve la app en la que escribes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Maalib teema värvi, ülemineku või foto klahvide taha. Välja lülitatuna paistab läbi rakendus, kus sa tipid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peint la couleur, le dégradé ou la photo du thème derrière les touches. Désactivé, l'app dans laquelle tu écris se voit à travers."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A téma színét, színátmenetét vagy fotóját festi a billentyűk mögé. Kikapcsolva átlátszik az app, amelybe éppen gépelsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipinge il colore, il gradiente o la foto del tema dietro i tasti. Disattivato, si vede l'app in cui stai scrivendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマの色、グラデーション、写真をキーの後ろに描きます。オフにすると、入力中のアプリが透けて見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마의 색상, 그러데이션, 사진을 키 뒤에 칠합니다. 끄면 입력 중인 앱이 그대로 비칩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Melukis warna, gradien atau foto tema di belakang kekunci. Bila dimatikan, apl yang anda taip padanya kelihatan menembusi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta a cor, o gradiente ou a fotografia do tema por trás das teclas. Desligado, vê-se a app onde estás a escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисовать за клавишами цвет, градиент или фото темы. Выключено — сквозь них видно приложение, в котором вы печатаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在按键后方绘制主题的颜色、渐变或照片。关闭后，正在输入的 App 会透出来。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pictează culoarea, gradientul sau fotografia temei în spatele tastelor. Dezactivată, se afișează aplicația pe care o introduceți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schilder de kleur, het verloop of de foto van het thema achter de toetsen. Uit, de app waarin je typt, wordt weergegeven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在按鍵後方繪製主題的顏色、漸變或照片。關閉後，正在輸入的 App 會透出來。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomaluj kolor motywu, gradient lub zdjęcie za klawiszami. Wyłączone, aplikacja, w której piszesz, jest widoczna."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зафарбуйте колір теми, градієнт або фотографію за клавішами. Вимкнено, додаток, у якому ви вводите текст, відображається."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşların arkasına temanın rengini, degradesini veya fotoğrafını boyayın. Kapalıysa, yazdığınız uygulama gösterilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Namalujte barvu, přechod nebo fotografii motivu za klávesy. Vypnuto, zobrazuje se aplikace, do které píšete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaľujte farbu, prechod alebo fotografiu motívu za klávesmi. Vypnuté, zobrazuje sa aplikácia, do ktorej píšete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρωματίστε το χρώμα, τη διαβάθμιση ή τη φωτογραφία του θέματος πίσω από τα πλήκτρα. Ανενεργό, εμφανίζεται η εφαρμογή που πληκτρολογείτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Måla temats färg, gradient eller foto bakom tangenterna. Av, appen du skriver i visas genom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mal temaets farve, gradient eller foto bag tasterne. Fra, den app, du skriver i, vises igennem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mal temaets farge, gradient eller bilde bak tastene. Av, appen du skriver inn vises gjennom."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maalaa teeman väri, kaltevuus tai valokuva näppäinten taakse. Pois päältä, sovellus, jota kirjoitat, näkyy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnai warna tema, gradien, atau foto di belakang tombol. Mati, aplikasi yang Anda ketik akan muncul."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sơn màu, độ chuyển màu hoặc ảnh của chủ đề đằng sau các phím. Tắt, ứng dụng bạn đang nhập sẽ hiển thị thông qua."
          }
        }
      }
    },
    "Paint the theme’s colour, gradient or photo behind the keys.": {
      "extractionState": "manual",
