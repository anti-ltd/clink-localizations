          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержите клавишу, чтобы всплыла полоса с дополнительными символами или панелями — как акценты в Gboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按按键会弹出一条包含额外字符或面板的栏，就像 Gboard 的重音符号。"
          }
        }
      }
    },
    "Hold the letter and slide onto the accent you want.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou die letter vas en skuif na die aksent wat jy wil hê."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den Buchstaben und zieh auf den Akzent, den du willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la letra y desliza hasta el acento que quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia tähte ja libise soovitud aksendile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens la lettre et glisse jusqu'à l'accent voulu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd nyomva a betűt, és csúsztass a kívánt ékezetre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta la lettera e scorri fino all'accento che vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字を長押しして、使いたいアクセント記号までスライドします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자를 길게 누른 다음 원하는 악센트로 밀어 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan huruf itu dan luncur ke aksen yang anda mahu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a letra premida e desliza até ao acento que queres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержите букву и доведите палец до нужного акцента."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住字母，滑到想要的重音符号上。"
          }
        }
      }
    },
    "Hold the space bar and slide. Tap with another finger while dragging to start highlighting.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou die spasiebalk vas en skuif. Tik met 'n ander vinger terwyl jy sleep om te begin uitlig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Leertaste und schiebe. Tippe mit einem anderen Finger während des Ziehens, um zu markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la barra espaciadora y desliza. Toca con otro dedo mientras arrastras para empezar a marcar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia tühikuklahvi ja libise. Puuduta lohistamise ajal teise sõrmega, et alustada esiletõstmist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la barre d'espace et faites glisser. Touchez avec un autre doigt pendant le glissement pour commencer à sélectionner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd a szóközt, és csúsztasd. Koppints a másik ujjaddal húzás közben, és onnan jelöl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta la barra spaziatrice e fai scorrere. Tocca con un altro dito mentre trascini per iniziare a selezionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースバーを押しながらスライド。ドラッグ中にもう一方の指でタップすると選択が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 바를 누른 채 미세요. 끄는 동안 다른 손가락으로 탭하면 선택이 시작됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan bar ruang dan seret. Ketik dengan jari lain semasa menyeret untuk mula menonjolkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a barra de espaço e desliza. Toca com outro dedo enquanto arrastas para começar a destacar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте пробел и ведите. Коснитесь другим пальцем во время перетаскивания, чтобы начать выделение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住空格键滑动。拖动时用另一根手指点按即可开始选中。"
          }
        }
      }
    },
    "Hold the space bar and slide. Tap with another finger while holding space to start highlighting.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou die spasiebalk vas en skuif. Tik met 'n ander vinger terwyl jy spasie hou om te begin uitlig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Leertaste und schiebe. Tippe mit einem anderen Finger, während du sie hältst, um zu markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la barra espaciadora y desliza. Toca con otro dedo mientras la mantienes para empezar a marcar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia tühikuklahvi ja libise. Puuduta tühiku hoidmise ajal teise sõrmega, et alustada esiletõstmist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens la barre d’espace et fais glisser ton doigt. Sans la relâcher, touche l’écran avec un autre doigt pour commencer à sélectionner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd a szóközt, és csúsztasd. Koppints a másik ujjaddal tartás közben, és onnan jelöl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta la barra spaziatrice e fai scorrere. Tocca con un altro dito mentre la tieni premuta per iniziare a selezionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースバーを押しながらスライド。押したままもう一方の指でタップすると選択が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 바를 누른 채 미세요. 누르고 있는 동안 다른 손가락으로 탭하면 선택이 시작됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan bar ruang dan seret. Ketik dengan jari lain semasa menahannya untuk mula menonjolkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a barra de espaço e desliza. Toca com outro dedo enquanto a manténs para começar a destacar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте пробел и ведите. Коснитесь другим пальцем, удерживая пробел, чтобы начать выделение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住空格键滑动。按住时用另一根手指点按即可开始选中。"
          }
        }
      }
    },
    "Hold the space bar and the keyboard becomes a trackpad for the text.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou die spasiebalk vas en die sleutelbord word 'n stuurvlak vir die teks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Leertaste, und die Tastatur wird zum Trackpad für den Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la barra espaciadora y el teclado se convierte en un trackpad para el texto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia tühikuklahvi ja klaviatuur muutub teksti trackpadiks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens la barre d'espace et le clavier devient un trackpad pour le texte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd nyomva a szóközt, és a billentyűzet érintőtáblává válik a szöveghez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta la barra spaziatrice e la tastiera diventa un trackpad per il testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースキーを長押しすると、キーボードがテキスト用のトラックパッドになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 바를 길게 누르면 키보드가 텍스트용 트랙패드가 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan bar ruang dan papan kekunci menjadi pad jejak untuk teks."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a barra de espaços premida e o teclado passa a ser um trackpad para o texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержите пробел — и клавиатура станет трекпадом для текста."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按空格键，键盘就变成操作文本的触控板。"
          }
        }
      }
    },
    "Hold the space bar and the keys become a trackpad. Glide anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou die spasiebalk vas en die sleutels word 'n trackpad. Gly enige plek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Leertaste gedrückt und die Tasten werden zum Trackpad. Gleite, wohin du willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la barra espaciadora y las teclas se vuelven un trackpad. Desliza a donde quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia tühikuklahvi ja klahvid muutuvad trackpadiks. Libise kuhu iganes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
