            "state": "translated",
            "value": "Solicitarea a expirat. Încearcă din nou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een time-out opgetreden voor het verzoek. Probeer het opnieuw."
