    "Tap the pet to poke it. Tap a corner to move it there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf das Haustier, um es anzustupsen. Tippe auf eine Ecke, um es dorthin zu setzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la mascota para darle un toque. Toca una esquina para moverla allí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta lemmikut, et seda torgata. Puuduta nurka, et see sinna viia."
          }
        },
        "fr": {
