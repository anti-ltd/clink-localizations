    "Typing stays on your device. No account or tracking.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik bly op jou toestel. Geen rekening of dop nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Eingaben bleiben auf deinem Gerät. Kein Konto, kein Tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura permanece en tu dispositivo. Sin cuenta ni seguimiento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Trükkimine jääb sinu seadmesse. Ei kontot ega jälgimist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta saisie reste sur ton appareil. Sans compte ni suivi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gépelés az eszközödön marad. Nincs fiók és nincs követés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La digitazione resta sul tuo dispositivo. Nessun account né tracciamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力はデバイス上に留まります。アカウントも追跡もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력은 기기에만 남습니다. 계정이나 추적이 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penaipan kekal pada peranti anda. Tiada akaun atau penjejakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A escrita fica no teu dispositivo. Sem conta nem rastreio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ввод остаётся на вашем устройстве. Без аккаунта и отслеживания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入内容留在你的设备上。无需账户，也不跟踪。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastarea rămâne pe dispozitiv. Fără cont sau urmărire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typen blijft op uw apparaat. Geen account of tracking."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入內容留在你的裝置上。無需賬戶，也不跟蹤。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisanie pozostaje na Twoim urządzeniu. Brak konta i śledzenia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введення тексту залишається на вашому пристрої. Немає облікового запису чи відстеження."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazma cihazınızda kalır. Hesap veya takip yok."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Psaní zůstane na vašem zařízení. Žádný účet ani sledování."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Písanie zostáva na vašom zariadení. Žiadny účet ani sledovanie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πληκτρολόγηση παραμένει στη συσκευή σας. Χωρίς λογαριασμό ή παρακολούθηση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivandet stannar på din enhet. Inget konto eller spårning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtastning forbliver på din enhed. Ingen konto eller sporing."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriving forblir på enheten din. Ingen konto eller sporing."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoittaminen jää laitteellesi. Ei tiliä tai seurantaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengetikan tetap ada di perangkat Anda. Tidak ada akun atau pelacakan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc gõ văn bản vẫn còn trên thiết bị của bạn. Không có tài khoản hoặc theo dõi."
          }
        }
      }
    },
    "Typing stays on your device. No account, no tracking.": {
      "extractionState": "stale",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik bly op jou toestel. Geen rekening, geen dop nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Eingaben bleiben auf deinem Gerät. Kein Konto, kein Tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que escribes se queda en tu dispositivo. Sin cuentas ni rastreo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipimine jääb sinu seadmesse. Kontot pole, jälgimist pole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta saisie reste sur ton appareil. Pas de compte, pas de pistage."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gépelésed az eszközödön marad. Se fiók, se követés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che digiti resta sul tuo dispositivo. Nessun account, nessun tracciamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力内容は端末内にとどまります。アカウントも追跡もなし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 내용은 기기에만 남습니다. 계정도 추적도 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taipan anda kekal pada peranti anda. Tiada akaun, tiada penjejakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que escreves fica no teu dispositivo. Sem contas, sem rastreio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что вы печатаете, остаётся на устройстве. Без аккаунта и без слежки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入内容只留在设备上。无账号，无跟踪。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastarea rămâne pe dispozitiv. Fără cont, fără urmărire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typen blijft op uw apparaat. Geen account, geen tracking."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入內容只留在裝置上。無賬號，無跟蹤。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisanie pozostaje na Twoim urządzeniu. Bez konta, bez śledzenia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введення тексту залишається на вашому пристрої. Немає облікового запису, немає відстеження."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazma cihazınızda kalır. Hesap yok, takip yok."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Psaní zůstane na vašem zařízení. Žádný účet, žádné sledování."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Písanie zostáva na vašom zariadení. Žiadny účet, žiadne sledovanie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πληκτρολόγηση παραμένει στη συσκευή σας. Χωρίς λογαριασμό, χωρίς παρακολούθηση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivandet stannar på din enhet. Inget konto, ingen spårning."
          }
        },
        "da": {
