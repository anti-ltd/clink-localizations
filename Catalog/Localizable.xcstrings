    "Open Translate and turn it on, then set the language you usually translate into.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maak Vertaal oop en skakel dit aan, stel dan die taal waarin jy gewoonlik vertaal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne „Übersetzen“, schalte es ein und leg die Sprache fest, in die du meistens übersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Traducir, actívalo y elige el idioma al que sueles traducir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava Tõlgi, lülita see sisse ja määra keel, millesse tavaliselt tõlgid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Traduire, active-le, puis choisis la langue vers laquelle tu traduis d'habitude."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Fordítást, kapcsold be, és állítsd be, mire szoktál fordítani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Traduci, attivalo e imposta la lingua in cui traduci di solito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「翻訳」を開いてオンにし、よく翻訳する言語を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역을 열어 켜고, 평소 번역하는 언어를 설정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Terjemah dan hidupkannya, kemudian tetapkan bahasa yang biasa anda terjemah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Traduzir e liga-o, depois define o idioma para o qual costumas traduzir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Перевод», включите его и задайте язык, на который обычно переводите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“翻译”并开启，再设好你常译入的语言。"
          }
        }
      }
    },
