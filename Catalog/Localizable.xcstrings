        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe sterk verligte sleutels hul kleur na die aangrensende \"Liquid Glass\" weerkaats.'n Laer instelling hou die kleur op die sleutel;'n hoër instelling laat dit deur die glas beweeg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak mocno podświetlone klawisze odbijają swój kolor od sąsiedniego Liquid Glass. Niższy utrzymuje kolor na kluczu; wyższa pozwala mu przejść przez szybę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскільки сильно освітлені клавіші відображають свій колір на сусідньому рідкому склі. Нижня зберігає колір на клавіші; вище дозволяє йому подорожувати крізь скло."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kadar güçlü yanan tuşlar renklerini komşu Liquid Glass'a yansıtıyor. Alt kısım, tuşun üzerindeki rengi korur; daha yüksek olması camın içinden geçmesini sağlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak silně osvětlené klávesy odrážejí svou barvu do sousedního tekutého skla. Nižší udržuje barvu na klíči; vyšší umožňuje průchod sklem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako silno osvetlené klávesy odrážajú svoju farbu do susedného tekutého skla. Nižšia ponecháva farbu na kľúči; vyššie umožňuje prechod cez sklo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο έντονα φωτισμένα πλήκτρα αντικατοπτρίζουν το χρώμα τους στο γειτονικό Liquid Glass. Το Lower διατηρεί το χρώμα στο κλειδί. ψηλότερα το αφήνει να ταξιδέψει μέσα από το γυαλί."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur starkt upplysta tangenter reflekterar deras färg i närliggande flytande glas. Lägre behåller färgen på nyckeln; högre låter den färdas genom glaset."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor stærkt oplyste taster afspejler deres farve ind i det tilstødende flydende glas. Lavere holder farven på tasten; higher lets it travel through the glass."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor sterkt opplyste taster reflekterer fargen deres inn i flytende glass. Lavere holder fargen på nøkkelen; høyere lar den bevege seg gjennom glasset."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka voimakkaasti valaistut näppäimet heijastavat väriään viereiseen nestelasiin. Alempi pitää värin avaimessa; korkeampi päästää sen kulkemaan lasin läpi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa kuat tombol yang menyala memantulkan warnanya ke Liquid Glass di dekatnya. Yang lebih rendah menjaga warna pada kunci; lebih tinggi memungkinkannya bergerak melalui kaca."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím được chiếu sáng mạnh như thế nào sẽ phản chiếu màu sắc của chúng sang Liquid Glass lân cận. Lower giữ màu trên phím; cao hơn cho phép nó đi qua kính."
          }
        }
      }
    },
    "How strongly predictions affect the hitboxes. Lower is subtle, higher pushes the bias harder.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe sterk beïnvloed voorspellings die hitboxes. Laer is subtiel, hoër druk die vooroordeel harder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark Vorhersagen die Trefferflächen beeinflussen. Niedriger ist dezent, höher drückt die Tendenz kräftiger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con qué fuerza las predicciones cambian las áreas táctiles. Más bajo es sutil, más alto empuja más el sesgo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui tugevasti ennustused tabamustsoone mõjutavad. Madalam on peen, kõrgem surub kaldu tugevamini."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quel point les prédictions influent sur les zones de frappe. Plus bas, c'est subtil ; plus haut, ça force le biais."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyire erősen hatnak az előrejelzések a találati zónákra. Az alacsonyabb finom, a magasabb erősebben tolja a torzítást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto le previsioni influiscono sulle aree di tocco. Più basso è discreto, più alto spinge di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測がタップ範囲に与える影響の強さです。低いと控えめ、高いと偏りが強く出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예측이 터치 영역에 얼마나 세게 영향을 주는지예요. 낮으면 은은하고, 높으면 더 강하게 밀어붙여요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuat mana ramalan mempengaruhi kotak sentuh. Lagi rendah lagi halus, lagi tinggi tolak berat sebelah lebih kuat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com que força as previsões afetam as áreas táteis. Mais baixo é subtil, mais alto puxa mais pela tendência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько сильно предсказания влияют на зоны нажатия. Меньше — едва заметно, больше — смещение жёстче."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预测对点击区域的影响有多强。越低越不明显，越高偏向越猛。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de puternic afectează predicțiile hitbox-urile. Mai jos este subtil, mai mare împinge părtinirea mai tare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe sterk voorspellingen de hitboxes beïnvloeden. Lager is subtiel, hoger duwt de bias harder."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預測對點選區域的影響有多強。越低越不明顯，越高偏向越猛。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak silnie prognozy wpływają na hitboxy. Niższa jest subtelna, wyższa zwiększa nacisk na stronniczość."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскільки сильно передбачення впливають на хітбокси. Нижчий – це непомітно, вищий посилює упередження сильніше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahminlerin hitbox'ları ne kadar güçlü etkilediği. Daha düşük olması hafiftir, daha yüksek olması ise önyargıyı daha da zorlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak silně ovlivňují předpovědi hitboxy. Nižší je subtilní, vyšší tlačí na zaujatost tvrději."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako silne ovplyvňujú predpovede hitboxy. Nižšie je subtílne, vyššie tlačí zaujatosť ťažšie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο έντονα επηρεάζουν οι προβλέψεις τα hitboxes. Το χαμηλότερο είναι λεπτό, το υψηλότερο ωθεί την προκατάληψη πιο σκληρά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur starkt påverkar förutsägelser hitboxarna. Lägre är subtilt, högre pressar biasen hårdare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor stærkt påvirker forudsigelser hitboxene. Lower is subtle, higher pushes the bias harder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor sterkt påvirker spådommer hitboksene. Lavere er subtilt, høyere presser skjevheten hardere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka voimakkaasti ennusteet vaikuttavat osumalaatikoihin. Alempi on hienovaraista, korkeampi painaa harhaa kovemmin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa kuat pengaruh prediksi terhadap hitbox. Lebih rendah tidak kentara, lebih tinggi mendorong bias lebih keras."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dự đoán ảnh hưởng mạnh mẽ đến các hộp sát thương như thế nào. Thấp hơn là tinh tế, cao hơn đẩy độ lệch mạnh hơn."
          }
        }
      }
    },
    "How strongly the Liquid Glass keys tint the theme's colors. Lower is clearer, higher is frostier.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe sterk kleur die Liquid Glass-sleutels die tema se kleure. Laer is duideliker, hoër is ryper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark die Liquid-Glass-Tasten die Farben des Themes einfärben. Niedriger ist klarer, höher frostiger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tiñen las teclas de Liquid Glass los colores del tema. Más bajo es más transparente, más alto más escarchado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui tugevalt Liquid Glass klahvid teema värve toonivad. Madalam on selgem, kõrgem jäisem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quel point les touches Liquid Glass teintent les couleurs du thème. Plus bas est plus clair, plus haut est plus givré."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyire színezi át a Liquid Glass billentyűk a téma színeit. Alacsonyabb értéknél átlátszóbb, magasabbnál fagyosabb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto le chiavi Liquid Glass colorano i colori del tema. Più basso è più trasparente, più alto è più ghiacciato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glassキーがテーマの色をどれだけ濃く染めるか。低いほど透明に、高いほど曇って見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass 키가 테마 색상을 얼마나 진하게 물들이는지. 낮을수록 맑고, 높을수록 서리가 낀 듯 보입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejauh mana kek Liquid Glass mewarnakan warna tema. Lebih rendah lebih jernih, lebih tinggi lebih berkabus."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O quanto as teclas Liquid Glass tingem as cores do tema. Mais baixo é mais transparente, mais alto é mais fosco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько сильно клавиши Liquid Glass окрашивают цвета темы. Ниже — прозрачнее, выше — более матово."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass 键对主题颜色的着色强度。数值越低越通透，越高越有霜感。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de puternic colorează tastele din sticlă lichidă culorile temei. Mai jos este mai clar, mai sus este mai înghețat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe sterk de Liquid Glass-toetsen de kleuren van het thema kleuren. Lager is helderder, hoger is ijziger."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass 鍵對主題顏色的著色強度。數值越低越通透，越高越有霜感。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak mocno klawisze Liquid Glass zabarwiają kolory motywu. Niżej jest jaśniej, wyżej jest bardziej mroźno."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскільки сильно клавіші з рідкого скла тонують кольори теми. Нижче – чіткіше, вище – морозніше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass tuşlarının temanın renklerini ne kadar güçlü bir şekilde renklendirdiği. Alt kısım daha temiz, yüksek kısım ise daha buzludur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak silně zbarvují klávesy tekutého skla barvy motivu. Nižší je jasnější, vyšší je mrazivější."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako silno zafarbia klávesy Liquid Glass farby témy. Nižšie je jasnejšie, vyššie je mrazivejšie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο έντονα χρωματίζουν τα χρώματα του θέματος τα πλήκτρα Liquid Glass. Το χαμηλότερο είναι πιο καθαρό, το υψηλότερο είναι πιο παγωμένο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur starkt färgar Liquid Glass-tangenterna temats färger. Lägre är klarare, högre är frostigare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor stærkt toner Liquid Glass-tasterne temaets farver. Lavere er klarere, højere er frostigere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor sterkt Liquid Glass-tastene toner temaets farger. Lavere er klarere, høyere er frostigere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka voimakkaasti Liquid Glass -näppäimet sävyttävät teeman värejä. Alempi on kirkkaampaa, korkeampi on pakkasta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa kuat tombol Liquid Glass mewarnai warna tema. Lebih rendah lebih jelas, lebih tinggi lebih dingin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím của Liquid Glass nhuộm màu chủ đề mạnh đến mức nào. Thấp hơn là rõ ràng hơn, cao hơn là băng giá."
          }
        }
      }
    },
