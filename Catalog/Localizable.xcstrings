          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukis laluan jari semasa anda meleret."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o traço do dedo enquanto deslizas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
