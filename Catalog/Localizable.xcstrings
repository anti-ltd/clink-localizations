    "Cling is off. Turn it on to use it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling ist aus. Schalte es ein, um es zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling está desactivado. Actívalo para usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling est désactivé. Active-le pour l'utiliser."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cling ki van kapcsolva. Kapcsold be, hogy használhasd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling è disattivato. Attivalo per usarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling はオフです。オンにすると使えます。"
          }
        },
        "ko": {
