    "How wide the ripple spreads. Larger values swell more neighbouring keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoe wyd versprei die rimpeling. Groter waardes swel meer naburige sleutels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit sich die Welle ausbreitet. Höhere Werte lassen mehr Nachbartasten anschwellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto se extiende la onda. Con valores más altos se agrandan más teclas vecinas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui laialt laine levib. Suuremad väärtused paisutavad rohkem naaberklahve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La largeur de l'ondulation. Plus la valeur est grande, plus les touches voisines gonflent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Milyen szélesen terjed a hullám. Nagyobb értéknél több szomszédos billentyű duzzad meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto si allarga l'onda. Con valori più alti si gonfiano più tasti vicini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "波紋が広がる範囲です。大きくするほど、まわりのキーがたくさん膨らみます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물결이 얼마나 넓게 퍼질지예요. 값이 클수록 주변 키가 더 많이 부풀어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluas mana riak itu merebak. Nilai lebih besar buat lebih banyak kekunci sebelah membengkak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até onde a ondulação se espalha. Valores maiores incham mais teclas à volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько широко расходится волна. Чем больше, тем больше соседних клавиш раздувается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "涟漪扩散的范围。值越大，一起鼓起的相邻键就越多。"
          }
        }
      }
    },
    "Hugs the word before it": {
