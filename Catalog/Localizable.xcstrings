    "That’s %@. It needs to be exactly ten, one for each digit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind %@. Es müssen genau zehn sein, eine für jede Ziffer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso son %@. Deben ser exactamente diez, una por cada dígito."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on %@. Neid peab olema täpselt kümme, üks iga numbri jaoks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela fait %@. Il en faut exactement dix, un par chiffre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez %@. Pontosan tízre van szükség, minden számjegyhez egyre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono %@. Devono essere esattamente dieci, uno per ogni cifra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在%@個です。ちょうど10個（各数字に1つ）必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 %@개입니다. 각 숫자에 하나씩, 정확히 10개여야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu %@. Ia perlu tepat sepuluh, satu untuk setiap digit."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "São %@. Têm de ser exatamente dez, uma por cada dígito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это %@. Нужно ровно десять, по одной на каждую цифру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 %@ 个。必须正好十个，每个数字一个。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit is %@. Dit moet presies tien wees, een vir elke syfer."
          }
        }
      }
    },
    "Up to %@ groups. Swipe a clip right on History or in the keyboard panel to assign it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu %@ Gruppen. Wische in „Verlauf“ oder auf dem Tastatur-Panel nach rechts über einen Clip, um ihn zuzuweisen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta %@ grupos. Desliza un fragmento a la derecha en Historial o en el panel del teclado para asignarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuni %@ rühma. Pühkige fragmendil paremale ajaloos või klaviatuuripaneelil, et see määrata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'à %@ groupes. Balayez un fragment vers la droite dans l'historique ou le panneau du clavier pour l'assigner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb %@ csoport. Csúsztasd jobbra egy folyamatot az Előzményekben vagy a billentyűzet-panelen a hozzárendeléshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a %@ gruppi. Scorri un frammento a destra nella Cronologia o nel pannello della tastiera per assegnarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大%@グループ。履歴またはキーボードパネルでクリップを右にスワイプすると割り当てられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 %@개 그룹. 기록 또는 키보드 패널에서 클립을 오른쪽으로 스와이프하면 지정됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehingga %@ kumpulan. Leret klip ke kanan dalam Sejarah atau panel papan kekunci untuk menetapkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até %@ grupos. Deslize um fragmento para a direita no Histórico ou no painel do teclado para o atribuir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До %@ групп. Проведите по фрагменту вправо в «Истории» или на панели клавиатуры, чтобы назначить его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %@ 个分组。在历史记录或键盘面板中向右滑动片段即可分配。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tot %@ groepe. Swiep 'n snit regs op Geskiedenis of in die sleutelbordpaneel om dit toe te wys."
          }
        }
      }
    },
