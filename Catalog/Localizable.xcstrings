            "state": "translated",
            "value": "Η ψηφοφορία χρειάζεται ένα πραγματικό iPhone ή iPad."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Röstning behöver en riktig iPhone eller iPad."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afstemning kræver en rigtig iPhone eller iPad."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avstemning trenger en ekte iPhone eller iPad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänestäminen vaatii oikean iPhonen tai iPadin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemungutan suara membutuhkan iPhone atau iPad asli."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc bỏ phiếu cần có iPhone hoặc iPad thật."
          }
        }
      }
    },
    "That’s as many cards as one device can vote for. Take a vote back first.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es el máximo de tarjetas que se pueden votar desde un dispositivo. Retira antes algún voto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est le maximum de fiches pour lesquelles un appareil peut voter. Retire d’abord un vote."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr Karten kann ein Gerät nicht bewerten. Nimm zuerst eine Stimme zurück."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il numero massimo di schede che un dispositivo può votare. Ritira prima un voto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É o máximo de cartões em que um dispositivo pode votar. Retira primeiro um voto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С одного устройства нельзя проголосовать за большее число карточек. Сначала отмените один голос."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu jumlah maksimum kad yang boleh diundi oleh satu peranti. Tarik balik satu undian dahulu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy eszközről ennél több kártyára nem lehet szavazni. Előbb vonj vissza egy szavazatot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1台のデバイスで投票できるカードの上限です。先にどれかの投票を取り消してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一台设备最多只能为这么多卡片投票。请先撤回一票。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 기기에서 투표할 수 있는 카드 수의 한도입니다. 먼저 투표 하나를 취소하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühest seadmest ei saa rohkemate kaartide poolt hääletada. Võta enne üks hääl tagasi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt atâtea carduri pentru câte poate vota un dispozitiv. Luați un vot înapoi mai întâi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat zijn net zoveel kaarten als waarop één apparaat kan stemmen. Stem eerst terug."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一臺裝置最多隻能為這麼多卡片投票。請先撤回一票。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is die maksimum aantal kaarte waarvoor een toestel kan stem. Trek eers 'n stem terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To tyle kart, na ile jedno urządzenie może głosować. Najpierw zagłosuj ponownie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це стільки карток, скільки може проголосувати один пристрій. Спочатку проголосуйте назад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bir cihazın oy verebileceği kart sayısı kadar. Önce geri oy verin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To je tolik karet, pro kolik může jedno zařízení hlasovat. Nejprve hlasujte zpět."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "To je toľko kariet, za koľko môže jedno zariadenie hlasovať. Najprv dajte hlasovať späť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι τόσες κάρτες όσες μπορεί να ψηφίσει μια συσκευή. Πάρτε μια ψήφο πίσω πρώτα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är så många kort som en enhet kan rösta på. Rösta tillbaka först."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er så mange kort, som én enhed kan stemme på. Stem først tilbage."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er så mange kort som én enhet kan stemme på. Stem tilbake først."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on niin monta korttia kuin yksi laite voi äänestää. Äänestä ensin takaisin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu adalah jumlah kartu yang dapat dipilih oleh satu perangkat. Ambil suara kembali dulu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là số lượng thẻ mà một thiết bị có thể bầu chọn. Hãy bỏ phiếu lại trước."
          }
        }
      }
    },
    "Everything sent is read. If it becomes a card on the board, it’s pinned for you on the Feedback page.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leemos todo lo que llega. Si se convierte en una tarjeta del tablero, la tendrás fijada en la página de Comentarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est envoyé est lu. Si ça devient une fiche sur le tableau, elle sera épinglée pour toi sur la page Avis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir lesen alles, was ankommt. Wird daraus eine Karte auf dem Board, ist sie für dich auf der Feedback-Seite angeheftet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggiamo tutto ciò che arriva. Se diventa una scheda in bacheca, la troverai fissata nella pagina Feedback."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lemos tudo o que é enviado. Se passar a cartão no quadro, fica afixado para ti na página Comentários."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы читаем всё, что приходит. Если из этого появится карточка на доске, она будет закреплена для вас на странице «Обратная связь»."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang dihantar akan dibaca. Jika ia menjadi kad di papan, ia disemat untuk anda di halaman Maklum balas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindent elolvasunk, amit küldesz. Ha kártya lesz belőle a táblán, kitűzve megtalálod a Visszajelzés oldalon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送られた内容はすべて読んでいます。ボードのカードになった場合は、フィードバックのページにピン留めされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送的每一条我们都会阅读。如果它成为看板上的卡片，会在“反馈”页面为你置顶。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내 주신 내용은 모두 읽습니다. 보드의 카드가 되면 피드백 페이지에 고정됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loeme läbi kõik, mis saadetakse. Kui sellest saab tahvli kaart, kinnitatakse see sulle tagasiside lehele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot ce este trimis este citit. Dacă devine un card pe tablă, este fixat pentru tine pe pagina Feedback."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat wordt verzonden, wordt gelezen. Als het een kaart op het bord wordt, wordt deze voor u vastgezet op de Feedbackpagina."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送的每一條我們都會閱讀。如果它成為看板上的卡片，會在“反饋”頁面為你置頂。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat gestuur word, word gelees. As dit 'n kaart op die bord word, word dit vir jou vasgepen op die Tervoer-bladsy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko wysłane jest czytane. Jeśli stanie się to kartą na tablicy, zostanie przypięta na stronie opinii."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Все надіслане читається. Якщо вона стане карткою на дошці, вона буде закріплена для вас на сторінці відгуків."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderilen her şey okunur. Tahtada bir kart haline gelirse sizin için Geri Bildirim sayfasına sabitlenir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše odeslané je přečteno. Pokud se stane kartou na nástěnce, bude vám připnuta na stránce Zpětná vazba."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko odoslané je prečítané. Ak sa stane kartou na nástenke, bude vám pripnutá na stránke Spätná väzba."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα όσα αποστέλλονται διαβάζονται. Εάν γίνει κάρτα στον πίνακα, καρφιτσώνεται για εσάς στη σελίδα Σχόλια."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt som skickas läses. Om det blir ett kort på tavlan, fästs det åt dig på Feedback-sidan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt afsendt læses. Hvis det bliver et kort på tavlen, er det fastgjort til dig på Feedback-siden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt som sendes leses. Hvis det blir et kort på tavlen, er det festet for deg på tilbakemeldingssiden."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki lähetetty luetaan. Jos siitä tulee kortti taululle, se kiinnitetään sinulle Palaute-sivulle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Segala sesuatu yang dikirim telah dibaca. Jika kartu tersebut menjadi kartu di papan, kartu tersebut akan disematkan untuk Anda di halaman Masukan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ được gửi đều được đọc. Nếu nó trở thành một tấm thẻ trên bảng, nó sẽ được ghim cho bạn trên trang Phản hồi."
          }
        }
      }
    },
    "Report a bug or suggest an idea and it goes straight to the team. Everything on the board is being tracked; pin a card to keep it here and see when it moves.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa de un error o sugiere una idea y llegará directamente al equipo. Todo lo que hay en el tablero está en seguimiento; fija una tarjeta para tenerla aquí y ver cuándo avanza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signale un bug ou propose une idée : ça arrive directement à l’équipe. Tout ce qui est sur le tableau est suivi ; épingle une fiche pour la garder ici et voir quand elle avance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde einen Fehler oder schlag eine Idee vor, und es landet direkt beim Team. Alles auf dem Board wird verfolgt; hefte eine Karte an, um sie hier zu behalten und zu sehen, wenn sich etwas tut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segnala un bug o suggerisci un’idea e arriverà direttamente al team. Tutto ciò che è in bacheca viene seguito; fissa una scheda per tenerla qui e vedere quando cambia stato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reporta um erro ou sugere uma ideia e chega diretamente à equipa. Tudo o que está no quadro está a ser acompanhado; afixa um cartão para o manteres aqui e veres quando avança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщите об ошибке или предложите идею, и это сразу попадёт к команде. Всё, что на доске, находится в работе; закрепите карточку, чтобы она была здесь и было видно, когда она сдвинется."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporkan pepijat atau cadangkan idea dan ia terus sampai kepada pasukan. Semua di papan sedang dijejaki; semat kad untuk menyimpannya di sini dan lihat apabila statusnya berubah."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelents be egy hibát vagy javasolj egy ötletet, és egyenesen a csapathoz kerül. Minden, ami a táblán van, nyomon követett; tűzz ki egy kártyát, hogy itt legyen, és lásd, ha változik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バグの報告やアイデアの提案は、チームに直接届きます。ボード上の項目はすべて追跡中です。カードをピン留めすると、ここに表示され、状況の変化がわかります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告问题或提出建议，都会直接送到团队手中。看板上的每一项都在跟进中；置顶卡片即可在这里查看它的进展。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버그를 보고하거나 아이디어를 제안하면 팀에 바로 전달됩니다. 보드의 모든 항목은 추적 중이며, 카드를 고정하면 여기에 두고 상태 변화를 확인할 수 있습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teata veast või paku ideed ja see jõuab otse meeskonnani. Kõike tahvlil olevat jälgitakse; kinnita kaart, et see oleks siin ja näeksid, kui see edasi liigub."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportați o eroare sau sugerați o idee și merge direct echipei. Tot ce se află pe tablă este urmărit; fixați un card pentru a-l păstra aici și a vedea când se mișcă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporteer een bug of stel een idee voor en het gaat rechtstreeks naar het team. Alles op het bord wordt bijgehouden; Speld een kaart vast om hem hier te bewaren en kijk wanneer hij beweegt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "報告問題或提出建議，都會直接送到團隊手中。看板上的每一項都在跟進中；置頂卡片即可在這裡檢視它的進展。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld 'n fout aan of stel 'n idee voor, en dit gaan direk na die span. Alles op die bord word nagespoor; pen 'n kaart vas om dit hier te hou en te sien wanneer dit beweeg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgłoś błąd lub zasugeruj pomysł, a trafi on bezpośrednio do zespołu. Wszystko na tablicy jest śledzone; przypnij kartę, aby ją tu zatrzymać i zobaczyć, kiedy się poruszy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомте про помилку або запропонуйте ідею, і вона перейде безпосередньо до команди. Все на дошці відстежується; закріпіть картку, щоб зберегти її тут і побачити, коли вона рухається."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hatayı bildirin veya bir fikir önerin; bu doğrudan ekibe iletilir. Tahtadaki her şey takip ediliyor; Burada tutmak ve ne zaman hareket ettiğini görmek için bir kart sabitleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahlaste chybu nebo navrhněte nápad a ten se dostane přímo k týmu. Všechno na desce je sledováno; připněte kartu, abyste ji zde nechali a uvidíte, kdy se pohne."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahláste chybu alebo navrhnite nápad a ten sa dostane priamo do tímu. Všetko na šachovnici sa sleduje; pripnite kartu, aby ste ju tu nechali a uvidíte, kedy sa pohne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναφέρετε ένα σφάλμα ή προτείνετε μια ιδέα και πηγαίνει κατευθείαν στην ομάδα. Τα πάντα στον πίνακα παρακολουθούνται. καρφιτσώστε μια κάρτα για να την κρατήσετε εδώ και να δείτε πότε μετακινείται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapportera en bugg eller föreslå en idé och den går direkt till teamet. Allt på tavlan spåras; fäst ett kort för att behålla det här och se när det rör sig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporter en fejl eller foreslå en idé, og den går direkte til teamet. Alt på tavlen bliver sporet; fastgør et kort for at beholde det her og se, hvornår det bevæger sig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporter en feil eller foreslå en idé, og den går rett til teamet. Alt på brettet blir sporet; fest et kort for å beholde det her og se når det beveger seg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoita virheestä tai ehdota ideaa, niin se menee suoraan tiimille. Kaikkea aluksella olevaa seurataan; kiinnitä kortti, jotta se pysyy täällä ja näet, milloin se liikkuu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporkan bug atau usulkan ide dan ide tersebut akan langsung disampaikan ke tim. Segala sesuatu di papan sedang dilacak; sematkan kartu untuk menyimpannya di sini dan lihat kapan kartu itu bergerak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo lỗi hoặc đề xuất ý tưởng và ý tưởng đó sẽ được chuyển thẳng đến nhóm. Mọi thứ trên bảng đang được theo dõi; ghim một thẻ để giữ nó ở đây và xem khi nào nó di chuyển."
          }
        }
      }
    },
    "Report a bug, suggest an idea, see the board": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa de errores, sugiere ideas, consulta el tablero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signale un bug, propose une idée, consulte le tableau"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehler melden, Ideen vorschlagen, das Board ansehen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segnala bug, suggerisci idee, guarda la bacheca"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reporta erros, sugere ideias, vê o quadro"
