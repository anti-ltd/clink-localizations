        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συγκρατεί το φως έτσι ώστε τα γράμματα να μην ξεπλένονται ποτέ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
