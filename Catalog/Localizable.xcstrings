            "value": "Obie prędkości znajdują się w Gesty, w obszarze Powtarzanie klawiszy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидві швидкості можна знайти в розділі «Жести» в розділі «Повтор клавіш»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her iki hız da Tuş tekrarı altında Hareketler bölümündedir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obě rychlosti jsou v Gesta, pod Key repeat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obe rýchlosti sú v časti Gestá v časti Opakovanie klávesu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Και οι δύο ταχύτητες είναι στις χειρονομίες, κάτω από την επανάληψη πλήκτρων."
          }
        },
        "sv": {
          "stringUnit": {
