    "Search this page for whatever's wrong, in a full sentence if you like.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Soek hierdie bladsy vir wat ook al fout is, in 'n volsin as jy wil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Such auf dieser Seite nach dem, was klemmt — ruhig als ganzen Satz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en esta página lo que te pasa, en una frase entera si quieres."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsi sellelt lehelt seda, mis valesti on, vajadusel tervelausena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherche sur cette page ce qui cloche, en une phrase complète si tu veux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Keress rá ezen az oldalon arra, ami nem stimmel — akár egész mondatban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca in questa pagina quello che non va, anche con una frase intera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "困っていることを、このページの検索欄に入力します。文章のままで構いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이 문제인지 이 페이지 검색란에 적으세요. 문장 그대로도 괜찮습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari pada halaman ini apa yang tidak kena, dalam ayat penuh pun boleh."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Procura nesta página o que está a correr mal, numa frase inteira se quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поищите на этой странице то, что не так, — можно целым предложением."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把出问题的地方打进本页搜索框，写成一整句也行。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Căutați în această pagină orice este greșit, într-o propoziție completă dacă doriți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek op deze pagina naar wat er mis is, in een volledige zin als je wilt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把出問題的地方打進本頁搜尋框，寫成一整句也行。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeszukaj tę stronę, aby znaleźć wszystko, co jest nie tak, całym zdaniem, jeśli chcesz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шукайте на цій сторінці все, що не так, повним реченням, якщо хочете."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsterseniz bu sayfada yanlış olanı tam bir cümleyle arayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledejte na této stránce cokoli špatně, pokud chcete, celou větou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhľadajte na tejto stránke čokoľvek, čo je nesprávne, ak chcete, aj celou vetou."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναζητήστε αυτή τη σελίδα για οτιδήποτε δεν πάει καλά, σε μια πλήρη πρόταση αν θέλετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sök på den här sidan efter vad som är fel, i en hel mening om du vill."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søg på denne side efter hvad der er galt, i en hel sætning, hvis du vil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søk på denne siden etter hva som er galt, i en hel setning hvis du vil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Etsi tältä sivulta mikä tahansa vialla, jos haluat, koko lauseella."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Telusuri halaman ini untuk mengetahui apa yang salah, dalam kalimat lengkap jika Anda mau."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm trang này để tìm bất cứ điều gì sai, trong một câu đầy đủ nếu bạn muốn."
          }
        }
      }
    },
