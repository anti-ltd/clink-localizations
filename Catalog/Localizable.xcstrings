    "Reads better, especially on idioms. Off is faster and covers more languages.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest sich besser, vor allem bei Redewendungen. Aus ist schneller und kann mehr Sprachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lee mejor, sobre todo con modismos. Desactivado es más rápido y cubre más idiomas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lit mieux, surtout pour les expressions. Désactivé, c'est plus rapide et il y a plus de langues."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jobban olvasható, főleg a szólásoknál. Kikapcsolva gyorsabb, és több nyelvet tud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si legge meglio, soprattutto con i modi di dire. Disattivata è più veloce e copre più lingue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特に慣用句が自然になります。オフのほうが速く、対応言語も多めです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특히 관용구가 자연스러워요. 끄면 더 빠르고 지원 언어도 더 많아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih sedap dibaca, terutama simpulan bahasa. Jika dimatikan, lebih laju dan lebih banyak bahasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê-se melhor, sobretudo nas expressões. Desligado é mais rápido e abrange mais idiomas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читается лучше, особенно на устойчивых выражениях. Выключено — быстрее и охватывает больше языков."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读起来更自然，尤其是习惯用语。关掉会更快，支持的语言也更多。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loeb paremini, eriti väljendite puhul. Väljas on kiirem ja hõlmab rohkem keeli."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lees beter, veral oor idiome. Af is vinniger en dek meer tale."
          }
        }
      }
    },
