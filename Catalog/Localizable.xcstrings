          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite horaire de recherche de GIFs est atteinte. Réessaie plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das stündliche Limit für die GIF-Suche ist erreicht. Versuche es später erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato raggiunto il limite orario per la ricerca di GIF. Riprova più tardi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi atingido o limite horário da pesquisa de GIFs. Tenta novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнут часовой лимит поиска GIF. Попробуйте позже."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Carian GIF telah mencapai had setiap jam. Cuba lagi kemudian."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GIF-keresés elérte az óránkénti korlátot. Próbáld újra később."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
