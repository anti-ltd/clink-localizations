    "All the languages below run at once, for bilingual typing. A word is only corrected when it's wrong in every one.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Al die tale hieronder loop gelyktydig, vir tweetalige tik. 'n Woord word net reggestel wanneer dit in elkeen verkeerd is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Sprachen unten laufen gleichzeitig, zweisprachiges Tippen. Ein Wort wird nur korrigiert, wenn es in jeder davon falsch ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los idiomas de abajo funcionan a la vez: escritura bilingüe, y una palabra solo se corrige si está mal en todos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik alljärgnevad keeled töötavad korraga, kahekeelseks tipimiseks. Sõna parandatakse ainult siis, kui see on vale kõigis keeltes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les langues ci-dessous marchent en même temps, saisie bilingue. Un mot n'est corrigé que s'il est faux dans toutes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alábbi nyelvek mind egyszerre futnak, kétnyelvű gépelés, egy szót csak akkor javít, ha mindegyikben hibás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le lingue qui sotto funzionano insieme, digitazione bilingue: una parola viene corretta solo se è sbagliata in tutte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の言語がすべて同時に動きます。二言語での入力なので、どの言語でも間違っている単語だけを直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 언어가 전부 한꺼번에 돌아가요. 두 언어를 같이 쓰는 방식이라, 어느 쪽에서도 틀렸을 때만 단어를 고쳐요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua bahasa di bawah jalan serentak, penaipan dwibahasa. Sesuatu perkataan cuma dibetulkan bila ia salah dalam semua bahasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as línguas abaixo correm ao mesmo tempo, escrita bilingue. Uma palavra só é corrigida quando está errada em todas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все языки ниже работают одновременно — для двуязычной печати. Слово исправляется, только если оно неверно в каждом из них."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下面所有语言一起跑，双语输入。一个词只有在每种语言里都写错时才会被纠正。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate limbile de mai jos rulează simultan, pentru tastare bilingvă. Un cuvânt este corectat numai atunci când este greșit în fiecare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle onderstaande talen worden in één keer uitgevoerd, voor tweetalig typen. Een woord wordt alleen gecorrigeerd als het in elk woord verkeerd is."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下面所有語言一起跑，雙語輸入。一個詞只有在每種語言裡都寫錯時才會被糾正。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie poniższe języki działają jednocześnie, co umożliwia pisanie dwujęzyczne. Słowo można poprawić tylko wtedy, gdy w każdym jest błędne."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі наведені нижче мови запускаються одночасно для двомовного введення. Слово виправляється лише тоді, коли воно неправильне в кожному."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki dilli yazım için aşağıdaki dillerin tümü aynı anda çalışır. Bir kelime ancak her birinde yanlış olduğunda düzeltilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny níže uvedené jazyky běží najednou, pro dvojjazyčné psaní. Slovo je opraveno pouze tehdy, když je v každém chybné."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky jazyky uvedené nižšie sa spúšťajú naraz na dvojjazyčné písanie. Slovo sa opraví len vtedy, keď je v každom nesprávne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλες οι παρακάτω γλώσσες εκτελούνται ταυτόχρονα, για δίγλωσση πληκτρολόγηση. Μια λέξη διορθώνεται μόνο όταν είναι λάθος σε κάθε μία."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla språk nedan körs samtidigt, för tvåspråkig skrivning. Ett ord korrigeras bara när det är fel i var och en."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle sprogene nedenfor kører på én gang for tosproget indtastning. Et ord bliver kun rettet, når det er forkert i hvert enkelt ord."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle språkene nedenfor kjører samtidig, for tospråklig skriving. Et ord blir bare rettet når det er feil i alle."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki alla olevat kielet toimivat kerralla kaksikielistä kirjoittamista varten. Sana korjataan vain, kun se on väärässä jokaisessa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua bahasa di bawah dijalankan sekaligus, untuk pengetikan bilingual. Sebuah kata hanya dikoreksi jika ada kesalahan dalam setiap kata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả các ngôn ngữ bên dưới đều chạy cùng lúc để gõ song ngữ. Một lời nói chỉ được sửa khi nó sai ở mỗi người."
          }
        }
      }
    },
