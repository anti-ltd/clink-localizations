        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞 단어에 붙는 기호"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapat pada perkataan sebelumnya"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cola-se à palavra anterior"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прижимается к слову перед ним"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紧跟前一个词"
          }
        }
      }
    },
    "I could not tell what this should change on the keyboard. Say what you want to see, such as color drawn on the keys, the space bar caption, the suggestions, or the typing feel.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pude determinar qué debería cambiar esto en el teclado. Di qué quieres ver, por ejemplo color dibujado en las teclas, el texto de la barra espaciadora, las sugerencias o la sensación al escribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n’ai pas pu déterminer ce que cela devrait changer sur le clavier. Dites ce que vous voulez voir : une couleur dessinée sur les touches, le texte de la barre d’espace, les suggestions ou le ressenti de frappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich konnte nicht erkennen, was sich dadurch an der Tastatur ändern soll. Sag, was du sehen möchtest, etwa Farbe auf den Tasten, die Beschriftung der Leertaste, die Vorschläge oder das Tippgefühl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono riuscito a capire che cosa dovrebbe cambiare sulla tastiera. Dimmi che cosa vuoi vedere, ad esempio colore sui tasti, la scritta sulla barra spaziatrice, i suggerimenti o la sensazione di digitazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consegui identificar o que isto deveria mudar no teclado. Diga o que quer ver, como cor desenhada nas teclas, o texto da barra de espaço, as sugestões ou a sensação ao digitar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось понять, что именно это должно менять на клавиатуре. Скажите, что вы хотите увидеть: цвет на клавишах, надпись на пробеле, подсказки или ощущение от набора."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya tidak dapat menentukan apa yang patut berubah pada papan kekunci. Nyatakan apa yang anda mahu lihat, seperti warna pada kekunci, teks pada bar ruang, cadangan, atau rasa menaip."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem tudtam megállapítani, minek kellene ettől megváltoznia a billentyűzeten. Mondd meg, mit szeretnél látni: például a billentyűkre rajzolt színt, a szóköz feliratát, a javaslatokat vagy a gépelés érzetét."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これがキーボードの何を変えるはずなのか判断できませんでした。見たいものを教えてください。たとえばキーに描く色、スペースバーの表示、変換候補、入力の感触などです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我无法判断这应该改变键盘上的什么。请说明你想看到什么，例如画在按键上的颜色、空格键上的文字、候选词，或者打字手感。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것이 키보드에서 무엇을 바꿔야 하는지 알 수 없었습니다. 보고 싶은 것을 알려주세요. 예를 들어 키에 그려지는 색, 스페이스바 문구, 추천 단어, 또는 타이핑 느낌 같은 것입니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma ei suutnud aru saada, mida see peaks klaviatuuril muutma. Ütle, mida soovid näha: näiteks klahvidele joonistatud värvi, tühikuklahvi teksti, soovitusi või kirjutamistunnet."
          }
        }
      }
    },
    "I keep hitting the key next to the one I want": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ek hou aan om die sleutel langs die een te druk wat ek wil hê"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich treffe ständig die Taste daneben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre doy a la tecla de al lado"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma taban pidevalt kõrvalolevat klahvi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tape sans arrêt à côté"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Folyton a szomszédos billentyűt találom el"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendo sempre il tasto accanto a quello giusto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつも隣のキーを押してしまいます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자꾸 옆에 있는 키가 눌립니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya asyik tertekan kekunci sebelah"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerto sempre na tecla ao lado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я всё время попадаю по соседней клавише"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "老是按到旁边那个键"
          }
        }
      }
    },
    "I only want the dictation and the tools. Can I hide the rest?": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ek wil net die diktee en die gereedskap hê. Kan ek die res wegsteek?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich will nur das Diktat und die Werkzeuge. Kann ich den Rest ausblenden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quiero el dictado y las herramientas. ¿Puedo ocultar lo demás?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma tahan ainult dikteerimist ja tööriistu. Kas ma saan ülejäänu peita?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je veux seulement la dictée et les outils. Puis-je masquer le reste ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a diktálás és az eszközök kellenek. El tudom rejteni a többit?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Voglio solo la dettatura e gli strumenti. Posso nascondere il resto?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力とツールだけ使いたいのですが、ほかは隠せますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기와 도구만 쓰고 싶어요. 나머지는 숨길 수 있나요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya mahu imlak dan alat sahaja. Boleh sembunyikan yang lain?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só quero o ditado e as ferramentas. Posso esconder o resto?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мне нужны только диктовка и инструменты. Можно спрятать остальное?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我只想要口述输入和工具，其他能藏起来吗？"
          }
        }
      }
    },
