            "state": "translated",
            "value": "Sur le clavier, ouvre Presse-papiers depuis le menu des outils et touche un élément pour le coller."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzeten nyisd meg a Vágólapot az eszközök menüből, és koppints egy elemre a beillesztéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulla tastiera, apri Appunti dal menu strumenti e tocca un elemento per incollarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードのツールメニューから「クリップボード」を開き、項目をタップすると貼り付けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드의 도구 메뉴에서 클립보드를 열고 항목을 누르면 붙여넣어집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada papan kekunci, buka Papan keratan dari menu alat dan ketik satu item untuk menampalnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No teclado, abre Área de transferência no menu de ferramentas e toca num item para o colares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На клавиатуре откройте «Буфер обмена» из меню инструментов и нажмите на фрагмент, чтобы вставить его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘上从工具菜单打开“剪贴板”，点一条就粘贴进去。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuuril ava tööriistade menüüst Lõikelaud ja puuduta klippi, et see kleepida."
