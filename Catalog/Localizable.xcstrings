    "Test interrupted. Try again when you’re ready.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Test unterbrochen. Versuch es erneut, wenn du bereit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test interrupted. Try again when you’re ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba interrumpida. Inténtalo de nuevo cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Test katkes. Proovi uuesti, kui oled valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test interrompu. Réessaie quand tu veux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teszt megszakadt. Próbáld újra, amikor készen állsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Test interrotto. Riprova quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストが中断されました。準備ができたら、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트가 중단되었습니다. 준비되면 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujian terganggu. Cuba lagi apabila anda bersedia."
          }
        },
        "pt": {
