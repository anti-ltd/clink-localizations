    "Shortcuts expand instantly, even with autocorrect off": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kortpaaie brei onmiddellik uit, selfs met outokorreksie af"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kürzel werden sofort erweitert, auch bei ausgeschalteter Autokorrektur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos se expanden al instante, incluso con la autocorrección apagada"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otseteed laienevad koheselt, isegi kui automaatparandus on väljas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis se développent instantanément, même avec la correction auto désactivée"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rövidítések azonnal kibővülnek, még kikapcsolt automatikus javítással is"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scorciatoie si espandono all'istante, anche con la correzione automatica disattivata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動修正がオフでも、ショートカットはすぐに展開されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 수정을 꺼도 단축어는 바로 확장돼요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan berkembang serta-merta, walaupun autobetul dimatikan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos expandem-se logo, mesmo com a correção automática desligada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сокращения разворачиваются мгновенно, даже при выключенной автокоррекции"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷替换即时展开，就算关了自动更正也一样"
          }
        }
      }
    },
