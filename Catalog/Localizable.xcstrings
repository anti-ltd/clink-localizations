    "Your own actions will be deleted and the built-in samples restored. This can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine eigenen Aktionen werden gelöscht und die integrierten Beispiele wiederhergestellt. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán tus propias acciones y se restaurarán las muestras integradas. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes propres actions seront supprimées et les exemples intégrés restaurés. Cette action est irréversible."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A saját műveleteid törlődnek, és visszaáll a beépített minták. Ez nem vonható vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue azioni personali verranno eliminate e verranno ripristinati i campioni integrati. Non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた自身のアクションは削除され、内蔵サンプルに戻ります。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 만든 액션은 삭제되고 기본 샘플로 복원돼요. 되돌릴 수 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan anda sendiri akan dipadam dan sampel terbina dalam dipulihkan. Ini tidak boleh dibuat asal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas ações próprias vão ser eliminadas e as amostras integradas restauradas. Isto não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши действия будут удалены, а встроенные примеры возвращены. Отменить это нельзя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己创建的操作会被删除，恢复为内置示例。此操作无法撤销。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu enda tegevused kustutatakse ja sisseehitatud näidised taastatakse. Seda ei saa tagasi võtta."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou eie aksies sal uitgevee word en die ingeboude monsters sal herstel word. Dit kan nie ongedaan gemaak word nie."
          }
        }
      }
    },
