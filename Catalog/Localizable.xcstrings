    "Change whatever you like afterwards. The saved one stays as it was.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach kannst du ändern, was du willst. Das gesicherte Profil bleibt, wie es war."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después cambia lo que quieras. El perfil guardado se queda como estaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, change ce que tu veux. Le profil enregistré reste tel quel."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Utána nyugodtan változtass bármit. A mentett profil olyan marad, amilyen volt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo cambia quello che vuoi. Il profilo salvato resta com'era."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとは自由に変更してかまいません。保存したプロファイルはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그다음에는 무엇을 바꿔도 됩니다. 저장된 프로필은 그대로 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas itu ubah apa sahaja. Profil yang disimpan kekal seperti asal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois muda o que quiseres. O perfil guardado fica como estava."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дальше меняйте что угодно. Сохранённый вариант останется прежним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后随便改。存下来的那个还是原样。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pärast võid muuta, mida iganes tahad. Salvestatud profiil jääb endisels kujul."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verander daarna waarvan jy hou. Die geredde bly soos dit was."
          }
        }
      }
    },
    "Change your whole setup mid-sentence, without leaving the field": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle dein ganzes Setup mitten im Satz, ohne das Feld zu verlassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia toda tu configuración a mitad de frase, sin salir del campo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change toute ta config en pleine phrase, sans quitter le champ"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Váltsd le a teljes beállításodat mondat közben, a mező elhagyása nélkül"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia tutta la configurazione a metà frase, senza lasciare il campo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄から離れずに、文の途中でセットアップをまるごと切り替え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력란을 벗어나지 않고 문장 도중에 설정을 통째로 바꿔보세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar seluruh persediaan anda di tengah ayat, tanpa meninggalkan medan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda toda a configuração a meio da frase, sem sair do campo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смените всю настройку посреди предложения, не выходя из поля"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写到一半也能整套换掉配置，不用离开输入框"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaheta kogu oma seadistus lause keskel, ilma väljalt lahkumata"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verander jou hele opstelling middelsin, sonder om die veld te verlaat"
          }
        }
      }
    },
