    "1024×1024 for App Store Connect ▸ Promoted In-App Purchases. Real app icon plus the plan name. Share → Save Image.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 para App Store Connect ▸ Compras dentro de la app promocionadas. El icono real más el nombre del plan. Compartir → Guardar imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 pour App Store Connect ▸ Achats in-app mis en avant. L’icône réelle plus le nom de l’offre. Partager → Enregistrer l’image."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 für App Store Connect ▸ Beworbene In-App-Käufe. Echtes App-Icon plus Planname. Teilen → Bild sichern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 per App Store Connect ▸ Acquisti in-app in evidenza. L’icona vera più il nome del piano. Condividi → Salva immagine."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 para o App Store Connect ▸ Compras no app em destaque. O ícone real mais o nome do plano. Partilhar → Guardar imagem."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 untuk App Store Connect ▸ Pembelian Dalam App Dipromosikan. Ikon app sebenar plus nama pelan. Kongsi → Simpan Imej."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 az App Store Connect ▸ Kiemelt appbeli vásárlásokhoz. A valódi ikon plusz a csomag neve. Megosztás → Kép mentése."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Connect ▸ プロモーション対象のアプリ内課金用の 1024×1024。本物のアプリアイコンにプラン名を載せます。共有 → 画像を保存。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024，用于 App Store Connect ▸ 推广的 App 内购买项目。真实图标加上套餐名。分享 → 存储图像。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Connect ▸ 프로모션된 앱 내 구입용 1024×1024. 실제 앱 아이콘에 요금제 이름. 공유 → 이미지 저장."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 App Store Connecti ▸ Reklaamitud rakendusesiseste ostude jaoks. Tegelik rakenduse ikoon koos plaani nimega. Jaga → Salvesta pilt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 для App Store Connect ▸ Продвигаемые покупки в приложении. Настоящая иконка приложения плюс название плана. Поделиться → Сохранить изображение."
          }
