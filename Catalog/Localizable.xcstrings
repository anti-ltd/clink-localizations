    },
    "Add a little more detail: a sentence or two is plenty.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un poco más de detalle: con una o dos frases basta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un peu plus de détails : une phrase ou deux suffisent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib etwas mehr dazu: ein, zwei Sätze reichen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi qualche dettaglio in più: bastano una o due frasi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acrescenta um pouco mais de detalhe: uma ou duas frases chegam."
          }
