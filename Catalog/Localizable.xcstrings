          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komt neer op %@ per maand. Wordt jaarlijks verlengd. Annuleer op elk gewenst moment."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相當於每月 %@。按年續訂，隨時可以取消。"
