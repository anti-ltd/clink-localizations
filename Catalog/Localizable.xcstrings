    "Allow Paste in Settings to stop the system asking every time Clink uses copied text.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat Plak in instellings toe om te keer dat die stelsel vra elke keer as Clink gekopieerde teks gebruik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Einfügen in den Einstellungen, damit das System nicht jedes Mal nachfragt, wenn Clink kopierten Text verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Pegar en Ajustes para que el sistema deje de preguntar cada vez que Clink usa texto copiado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Luba seadetes kleepimine, et süsteem ei küsiks iga kord, kui Clink kasutab kopeeritud teksti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Coller dans Réglages pour que le système ne vous le demande plus chaque fois que Clink utilise du texte copié."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a Beillesztést a Beállításokban, hogy a rendszer ne kérdezzen rá minden alkalommal, amikor a Clink másolt szöveget használ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Incolla in Impostazioni per evitare che il sistema chieda ogni volta che Clink usa testo copiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」でペーストを許可すると、Clinkがコピーしたテキストを使うたびにシステムから確認されなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 붙여넣기를 허용하면 Clink이 복사한 텍스트를 사용할 때마다 시스템이 묻지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan Tampal dalam Tetapan supaya sistem tidak bertanya setiap kali Clink menggunakan teks yang disalin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Colar nas Definições para o sistema deixar de perguntar sempre que o Clink usa texto copiado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите вставку в Настройках, чтобы система не спрашивала каждый раз, когда Clink использует скопированный текст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中允许粘贴后，Clink 每次使用复制的文本时，系统就不会再询问。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți Lipirea în Configurări pentru a opri sistemul să solicite de fiecare dată când Clink folosește text copiat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta Plakken in Instellingen toe om te voorkomen dat het systeem vraagt telkens wanneer Clink gekopieerde tekst gebruikt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在“設定”中允許貼上後，Clink 每次使用複製的文字時，系統就不會再詢問。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na wklejenie w Ustawieniach, aby zatrzymać pytanie systemowe za każdym razem, gdy Clink użyje skopiowanego tekstu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте вставити в налаштуваннях, щоб система не запитувала кожного разу, коли Clink використовує скопійований текст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kopyalanan metni her kullandığında sistemin sormasını durdurmak için Ayarlar'da Yapıştır'a izin ver."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte Vložit v Nastavení, aby se systém přestal ptát pokaždé, když Clink použije zkopírovaný text."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte Prilepiť v nastaveniach, aby sa systém zastavil pri každom použití skopírovaného textu Clink."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να επιτρέπεται η επικόλληση στις Ρυθμίσεις για να σταματήσει το σύστημα να ρωτά κάθε φορά που το Clink χρησιμοποιεί αντιγραμμένο κείμενο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt Klistra in i inställningarna för att stoppa systemet från att fråga varje gång Clink använder kopierad text."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad Indsæt i indstillinger for at stoppe systemet med at spørge, hver gang Clink bruger kopieret tekst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat Lim inn i innstillinger for å stoppe systemet fra å spørre hver gang Clink bruker kopiert tekst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli asetuksissa Liitä estääksesi järjestelmän kysymästä aina, kun Clink käyttää kopioitua tekstiä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan Tempel di Pengaturan untuk menghentikan permintaan sistem setiap kali Clink menggunakan teks yang disalin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép Dán trong Cài đặt để dừng hệ thống hỏi mỗi khi Clink sử dụng văn bản được sao chép."
          }
        }
      }
    },
