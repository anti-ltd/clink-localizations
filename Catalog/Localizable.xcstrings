    "Moving effects that play over the theme background, under the keys.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegte Effekte, die über dem Themenhintergrund und unter den Tasten laufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Efectos en movimiento que se reproducen sobre el fondo del tema, bajo las teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikuvad efektid, mis mängivad teema tausta peal ja klahvide all."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des effets animés qui jouent par-dessus le fond du thème, sous les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mozgó effektusok, amelyek a téma háttere fölött, a billentyűk alatt futnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Effetti in movimento che scorrono sopra lo sfondo del tema, sotto i tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマの背景の上、キーの下で動くエフェクトです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마 배경 위, 키 아래에서 움직이는 효과입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesan bergerak yang dimainkan di atas latar tema, di bawah kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Efeitos em movimento que tocam sobre o fundo do tema, sob as teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Движущиеся эффекты поверх фона темы, под клавишами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主题背景之上、按键之下播放的动态效果。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Efecte în mișcare care se joacă peste fundalul temei, sub taste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegende effecten die over de themaachtergrond worden afgespeeld, onder de toetsen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在主題背景之上、按鍵之下播放的動態效果。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegende effekte wat oor die tema-agtergrond en onder die sleutels speel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruchome efekty odtwarzane na tle motywu, pod klawiszami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рухомі ефекти, які відтворюються на фоні теми, під клавішами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
