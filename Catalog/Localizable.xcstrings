          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 내용을 읽고 바꿉니다. 전체 접근이 필요합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loeb ja asendab lõikelaua sisu. Vajab täielikku juurdepääsu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read and replace clipboard contents. Requires Full Access."
          }
        }
      }
    },
    "Read the answer, then open the pages it used, listed underneath it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lees die antwoord en maak dan die bladsye wat dit gebruik het, wat daaronder gelys is, oop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies die Antwort und öffne die Seiten, aus denen sie stammt — sie stehen darunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee la respuesta y abre las páginas que ha usado, listadas debajo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loe vastust ja ava siis lehed, mida ta kasutas, loetletud allpool."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lis la réponse, puis ouvre les pages qu'elle a utilisées, listées en dessous."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvasd el a választ, majd nyisd meg az alatta felsorolt oldalakat, amelyekből készült."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi la risposta, poi apri le pagine da cui è nata, elencate sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "答えを読んだら、その下に並ぶ参照元のページを開いてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답을 읽은 뒤, 그 아래 나열된 근거 페이지를 열어 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca jawapannya, kemudian buka halaman yang digunakannya, disenaraikan di bawah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê a resposta e abre as páginas que ela usou, listadas por baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитайте ответ, а потом откройте страницы, на которые он опирался, — они перечислены под ним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读完答案，再打开下面列出的、它所依据的页面。"
          }
        }
      }
    },
    "Read typed text, surrounding text, selections and typing statistics.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
