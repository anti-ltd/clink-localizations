    "Transform edits the captured draft in place. Replace leads.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformeer wysig die vasgelegde konsep in plek. Vervang leidrade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Umwandeln“ bearbeitet den erfassten Entwurf direkt. „Ersetzen“ macht das."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformar edita el borrador capturado ahí mismo. Con Reemplazar lo cambias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teisenda muudab tabatud mustandit kohapeal. Asenda juhib."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformer modifie le brouillon capturé sur place. Remplacement en tête."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Átalakítás a rögzített piszkozatot szerkeszti a helyén. A Csere a fő gomb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma modifica la bozza direttamente. Di solito sostituisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「変換」はキャプチャしたドラフトをその場で直します。「置換」が先に出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환은 캡처한 초안을 그 자리에서 고쳐요. 교체로 이어져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transform edit draf yang ditangkap terus di tempatnya. Replace yang utama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformar edita o rascunho capturado no próprio sítio. Substituir fica em primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Преобразовать» правит захваченный черновик на месте. «Заменить» идёт первым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「转换」会直接在原地改你捕获到的草稿。对应「替换」。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformare editează schița capturată în loc. Înlocuiți cablurile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transform bewerkt het vastgelegde concept op zijn plaats. Leidingen vervangen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「轉換」會直接在原地改你捕獲到的草稿。對應「替換」。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekształć edytuje przechwyconą wersję roboczą na miejscu. Wymień przewody."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Transform редагує зроблену чернетку на місці. Замініть дроти."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dönüştürme, yakalanan taslağı yerinde düzenler. Kabloları değiştirin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformace upraví zachycený koncept na místě. Vyměňte vodiče."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformácia upraví zachytený koncept na mieste. Vymeňte vodiče."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Transform επεξεργάζεται το πρόχειρο που καταγράφηκε στη θέση του. Αντικαταστήστε τα καλώδια."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transform redigerar det fångade utkastet på plats. Byt ut ledningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transform redigerer den optagne kladde på plads. Udskift ledninger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Transform redigerer det fangede utkastet på plass. Bytt ledninger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Transform muokkaa kaapattua luonnosta paikalleen. Vaihda johdot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformasi mengedit draf yang diambil di tempatnya. Ganti kabelnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Transform chỉnh sửa bản nháp đã chụp tại chỗ. Thay thế khách hàng tiềm năng."
          }
        }
      }
