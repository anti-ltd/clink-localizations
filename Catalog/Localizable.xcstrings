    },
    "Tap or drag to select keys. Tap again to deselect.": {
      "comment": "Canvas keyboard selection control.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap or drag to select keys. Tap again to deselect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca o arrastra para seleccionar teclas. Toca de nuevo para deseleccionarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche les touches ou fais glisser ton doigt pour les sélectionner. Touche-les à nouveau pour les désélectionner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Tasten oder streiche darüber, um sie auszuwählen. Tippe erneut, um die Auswahl aufzuheben."
          }
        },
        "it": {
