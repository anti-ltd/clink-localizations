    "Words you add yourself always apply, and survive a clear.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst hinzugefügte Wörter gelten immer und bleiben auch nach dem Löschen erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras que añades tú siempre valen y sobreviven a un borrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots que tu ajoutes toi-même s'appliquent toujours et survivent à un effacement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az általad hozzáadott szavak mindig érvényesek, és a törlés után is megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
