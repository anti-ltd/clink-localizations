          "stringUnit": {
            "state": "translated",
            "value": "Meilleure vitesse de chaque jour, mesurée sur des séquences de frappe continue."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Napi csúcssebesség, folyamatos gépelés közben mérve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocità massime giornaliere, misurate durante la digitazione continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続して入力したときの、各日の最高速度です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연속으로 타이핑하는 동안 측정한 일별 최고 속도입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelajuan tertinggi setiap hari, diukur semasa menaip secara berterusan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocidades máximas diárias, medidas durante períodos de escrita contínua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальная скорость за каждый день, измеренная при непрерывном наборе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天持续打字时测得的最高速度。"
          }
        }
      }
    },
