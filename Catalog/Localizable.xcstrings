    "Typing stays on your device. No account or tracking.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura permanece en tu dispositivo. Sin cuenta ni seguimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie reste sur votre appareil. Sans compte ni suivi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Eingaben bleiben auf deinem Gerät. Kein Konto, kein Tracking."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La digitazione resta sul tuo dispositivo. Nessun account né tracciamento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A escrita fica no teu dispositivo. Sem conta nem rastreio."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penaipan kekal pada peranti anda. Tiada akaun atau penjejakan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gépelés az eszközödön marad. Nincs fiók és nincs követés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力はデバイス上に留まります。アカウントも追跡もありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入内容留在你的设备上。无需账户，也不跟踪。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
