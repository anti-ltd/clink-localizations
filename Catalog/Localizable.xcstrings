    "In a hurry, hold a row on the Tools tab to flip it on or off without opening it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou inderhaas 'n ry op die Tools-oortjie om dit aan of af te draai sonder om dit oop te maak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn es schnell gehen muss: halte eine Zeile im Tab „Werkzeuge“ gedrückt, um sie umzuschalten, ohne sie zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con prisa: mantén pulsada una fila en la pestaña Herramientas para activarla o desactivarla sin abrirla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui kiire on, hoia Tööriistade kaardil rida all, et see avamata sisse või välja lülitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressé ? Maintiens une ligne dans l'onglet Outils pour l'activer ou la désactiver sans l'ouvrir."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha sietsz: tarts nyomva egy sort az Eszközök lapon, és be- vagy kikapcsolod anélkül, hogy megnyitnád."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di fretta: tieni premuta una riga nella scheda Strumenti per accenderla o spegnerla senza aprirla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "急ぐときは、「ツール」タブの行を長押しすれば、開かずにオン・オフを切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "급할 때는 도구 탭에서 목록을 길게 눌러, 열지 않고 켜고 끌 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tergesa-gesa, tahan satu baris dalam tab Alat untuk menghidupkan atau mematikannya tanpa membukanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com pressa: mantém uma linha premida no separador Ferramentas para a ligar ou desligar sem a abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если некогда — удержите строку на вкладке «Инструменты», чтобы включить или выключить её, не заходя внутрь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "赶时间的话，在“工具”标签页长按某一行，不打开也能开关它。"
          }
        }
      }
    },
    "In any app, hold the globe key and pick Clink.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In enige toepassing, hou die aardbolsleutel in en kies Clink."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte in einer beliebigen App die Globustaste gedrückt und wähle Clink."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cualquier app, mantén pulsada la tecla del globo y elige Clink."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Igas rakenduses hoia gloobusklahvi ja vali Clink."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans n'importe quelle app, maintiens la touche globe et choisis Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármelyik appban tartsd lenyomva a földgömböt, majd válaszd a Clinket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In qualsiasi app, tieni premuto il tasto del globo e scegli Clink."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリでも地球儀キーを長押ししてClinkを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 앱에서든 지구본 키를 길게 누르고 Clink를 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam mana-mana app, tekan lama kekunci glob dan pilih Clink."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em qualquer app, mantém premida a tecla do globo e escolhe Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В любом приложении удерживайте клавишу с глобусом и выберите Clink."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意 App 中，长按地球键并选择 Clink。"
          }
        }
      }
    },
    "In any app, hold the globe key and pick Clink. Typing and emoji work everywhere; the tools need a membership.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cualquier app, mantén pulsada la tecla del globo y elige Clink. La escritura y los emojis funcionan en todas partes; las herramientas requieren una suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans n’importe quelle app, maintiens la touche globe et choisis Clink. La saisie et les emojis fonctionnent partout ; les outils nécessitent un abonnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte in einer beliebigen App die Globustaste gedrückt und wähle Clink. Tippen und Emojis funktionieren überall; die Werkzeuge benötigen ein Abo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In qualsiasi app, tieni premuto il tasto del globo e scegli Clink. Scrittura ed emoji funzionano ovunque; gli strumenti richiedono un abbonamento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em qualquer app, mantenha premida a tecla do globo e escolha Clink. A escrita e os emojis funcionam em todo o lado; as ferramentas requerem uma subscrição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В любом приложении удерживайте клавишу глобуса и выберите Clink. Ввод и эмодзи работают везде; для инструментов нужна подписка."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam mana-mana app, tekan lama kekunci glob dan pilih Clink. Penaipan dan emoji berfungsi di mana-mana; alat memerlukan langganan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármely appban tartsd lenyomva a földgömb billentyűt, és válaszd a Clinket. A gépelés és az emojik mindenhol működnek; az eszközökhöz előfizetés kell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリで地球儀キーを長押ししてClinkを選んでください。文字入力と絵文字はどこでも使えます。ツールにはメンバーシップが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意 App 中长按地球键并选择 Clink。文字输入和表情符号随处可用；工具需要订阅。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 앱에서든 지구본 키를 길게 누르고 Clink를 선택하세요. 입력과 이모지는 어디서나 사용할 수 있으며, 도구는 구독이 필요합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia mis tahes rakenduses maakera klahvi all ja vali Clink. Kirjutamine ja emojid töötavad kõikjal; tööriistad vajavad tellimust."
          }
        }
      }
    },
    "In any app, tap the 🌐 globe key to switch to Clink.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik in enige toepassing die 🌐 aardbolsleutel om na Clink oor te skakel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp in einer beliebigen App auf die 🌐-Globustaste, um zu Clink zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cualquier app, toca la tecla 🌐 del globo para cambiar a Clink."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Igas rakenduses puuduta 🌐 gloobusklahvi, et minna üle Clinkile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans n'importe quelle app, touche la touche 🌐 du globe pour passer à Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármelyik appban koppints a 🌐 földgömb billentyűre, hogy a Clinkre válts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In qualsiasi app, tocca il tasto 🌐 del globo per passare a Clink."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリでも 🌐 地球儀キーをタップすると Clink に切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무 앱에서나 🌐 지구본 키를 눌러 Clink로 바꿔 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam mana-mana app, ketik kekunci glob 🌐 untuk tukar ke Clink."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em qualquer app, toca na tecla 🌐 do globo para mudares para o Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В любом приложении нажмите клавишу 🌐, чтобы переключиться на Clink."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何 App 里，点一下 🌐 地球键就能切换到 Clink。"
          }
        }
      }
    },
