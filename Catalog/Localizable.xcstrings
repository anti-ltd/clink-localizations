          "stringUnit": {
            "state": "translated",
            "value": "Atingeți pentru a comuta. Trageți pentru a muta rândul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om te schakelen. Sleep om de rij te verplaatsen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按可切換。拖動可移動該行。"
