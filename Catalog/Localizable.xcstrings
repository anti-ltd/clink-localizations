          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eszközök, szöveges gyorsműveletek és billentyűzeteffektusok egy helyen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi strumenti, scorciatoie di testo ed effetti della tastiera in un unico posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツール、テキストショートカット、キーボードのエフェクトをまとめて追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구, 텍스트 단축 명령, 키보드 효과를 한곳에서 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah alat, pintasan teks dan kesan papan kekunci di satu tempat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona ferramentas, atalhos de texto e efeitos do teclado num só lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте инструменты, команды для текста и эффекты клавиатуры в одном месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "集中添加工具、文本快捷操作和键盘特效。"
          }
        }
      }
    },
    "Add two or three takes of the same click. Clink rotates them as you type so repeats don't sound identical.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg twee of drie take van dieselfde klik by. Klink draai hulle terwyl jy tik sodat herhalings nie identies klink nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm zwei, drei Varianten desselben Klicks auf – Clink wechselt beim Tippen zwischen ihnen, damit Wiederholungen nicht gleich klingen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade dos o tres tomas del mismo clic: Clink las va alternando mientras escribes, para que las repeticiones no suenen iguales."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa kaks või kolm võtet sama klõpsu jaoks. Clink vahetab neid tipimise ajal, nii et kordused ei kõla ühtmoodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute deux ou trois prises du même clic — Clink les alterne pendant que tu tapes, pour que les répétitions ne sonnent pas pareil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegyél fel két-három változatot ugyanabból a kattanásból – a Clink gépelés közben váltogatja őket, így az ismétlődések nem hangzanak egyformán."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi due o tre versioni dello stesso clic — Clink le alterna mentre scrivi, così le ripetizioni non suonano identiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じクリック音を 2〜3 通り入れておくと、Clink がタイプ中に切り替えて鳴らすので、連打しても同じ音の繰り返しになりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 클릭 소리를 두세 번 나눠 담아 두세요. 타이핑할 때 Clink가 번갈아 재생해서 연타해도 같은 소리가 반복되지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah dua atau tiga rakaman bunyi klik yang sama — Clink akan menyilih gantikannya semasa anda menaip supaya bunyi berulang tidak kedengaran sama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona duas ou três versões do mesmo clique — o Clink vai alternando entre elas enquanto escreves, para as repetições não soarem iguais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте два-три варианта одного щелчка — Clink чередует их при печати, чтобы повторы не звучали одинаково."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一个按键声多录两三条——打字时 Clink 会轮换播放，连打时不会一直是同一个声音。"
          }
        }
      }
    },
