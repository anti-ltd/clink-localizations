    "Build a tab from whichever emoji you actually send. The ones you react with, the ones your group chat runs on.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Bou 'n oortjie van watter emoji jy ook al stuur. Diegene waarmee jy reageer, dié waarop jou groepklets loop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bau dir einen Tab aus den Emoji, die du wirklich verschickst. Die, mit denen du reagierst, die, von denen dein Gruppenchat lebt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una pestaña con los emoji que de verdad envías. Los de tus reacciones, los que sostienen tu grupo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehita kaart nendest emojidest, mida sa tegelikult saadad. Need, millega sa reageerid, need, mille pealt sinu rühmavestlus käib."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose un onglet avec les émojis que tu envoies vraiment. Ceux de tes réactions, ceux qui font tourner ta conversation de groupe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakj össze egy fület azokból az emodzsikból, amiket tényleg küldesz. Amikkel reagálsz, amiken a csoportos csevegésed elvan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una scheda con le emoji che mandi davvero. Quelle delle tue reazioni, quelle che tengono in piedi la chat di gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際に送っている絵文字だけでタブをつくれます。リアクションに使うもの、グループチャットで飛び交うもの。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제로 보내는 이모지만 모아 탭을 만드세요. 반응할 때 쓰는 것, 단체 대화방을 굴러가게 하는 것."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bina tab daripada emoji yang anda betul-betul hantar. Yang anda guna untuk bertindak balas, yang menghidupkan sembang kumpulan anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Monta um separador com os emoji que envias mesmo. Os das tuas reações, os que sustentam o teu grupo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соберите вкладку из тех эмодзи, которые вы правда отправляете. Тех, которыми реагируете, и тех, на которых держится ваш чат."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你真正会发的表情组一个标签页。你常拿来回应的那些，你的群聊离不开的那些。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creați o filă din orice emoji pe care îl trimiteți efectiv. Cei cu care reacționezi, cei pe care rulează chatul tău de grup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouw een tabblad van welke emoji je ook daadwerkelijk verzendt. Degene waarmee u reageert, de groepschat waarop uw groepschat draait."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用你真正會發的表情組一個標籤頁。你常拿來回應的那些，你的群聊離不開的那些。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz kartę z dowolnego emoji, który faktycznie wysyłasz. Ci, z którymi reagujesz, na których działa Twój czat grupowy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть вкладку з будь-якого емодзі, яке ви справді надсилаєте. Ті, з якими ви реагуєте, ті, на яких працює ваш груповий чат."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçekte gönderdiğiniz emojiden bir sekme oluşturun. Tepki verdiğiniz kişiler, grup sohbetinizin yürütüldüğü kişiler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořte kartu z libovolného emotikonu, který skutečně odešlete. Ty, na které reagujete, na kterých běží váš skupinový chat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvorte kartu z ľubovoľného emoji, ktorý skutočne odošlete. Tie, s ktorými reagujete, tie, na ktorých beží váš skupinový chat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε μια καρτέλα από οποιοδήποτε emoji στέλνετε πραγματικά. Αυτά με τα οποία αντιδράτε, αυτά με τα οποία εκτελείται η ομαδική σας συνομιλία."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygg en flik från vilken emoji du faktiskt skickar. De du reagerar med, de som din gruppchatt körs på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Byg en fane ud fra hvilken emoji du faktisk sender. Dem du reagerer med, dem kører din gruppechat på."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygg en fane fra hvilken emoji du faktisk sender. De du reagerer med, de gruppechatten din kjører på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo välilehti mistä tahansa emojista, jonka todella lähetät. Ne, joiden kanssa reagoit, ryhmäkeskustelut jatkuvat."
