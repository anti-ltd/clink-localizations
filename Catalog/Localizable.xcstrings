          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læs og erstat udklipsholderens indhold. Kræver fuld adgang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Les og erstatt innholdet i utklippstavlen. Krever full tilgang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lue ja vaihda leikepöydän sisältö. Vaatii täyden pääsyn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca dan mengganti konten clipboard. Membutuhkan Akses Penuh."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc và thay thế nội dung clipboard. Yêu cầu quyền truy cập đầy đủ."
          }
        }
      }
    },
    "Read the answer, then open the pages it used, listed underneath it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees die antwoord en maak dan die bladsye wat dit gebruik het, wat daaronder gelys is, oop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies die Antwort und öffne die Seiten, aus denen sie stammt — sie stehen darunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee la respuesta y abre las páginas que ha usado, listadas debajo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loe vastust ja ava siis lehed, mida ta kasutas, loetletud allpool."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lis la réponse, puis ouvre les pages qu'elle a utilisées, listées en dessous."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvasd el a választ, majd nyisd meg az alatta felsorolt oldalakat, amelyekből készült."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi la risposta, poi apri le pagine da cui è nata, elencate sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "答えを読んだら、その下に並ぶ参照元のページを開いてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답을 읽은 뒤, 그 아래 나열된 근거 페이지를 열어 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca jawapannya, kemudian buka halaman yang digunakannya, disenaraikan di bawah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê a resposta e abre as páginas que ela usou, listadas por baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитайте ответ, а потом откройте страницы, на которые он опирался, — они перечислены под ним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读完答案，再打开下面列出的、它所依据的页面。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citiți răspunsul, apoi deschideți paginile pe care le-a folosit, enumerate dedesubt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees het antwoord en open vervolgens de gebruikte pagina's, die eronder staan vermeld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀完答案，再開啟下面列出的、它所依據的頁面。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeczytaj odpowiedź, a następnie otwórz strony, z których korzystała, wymienione pod nią."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитайте відповідь, потім відкрийте сторінки, які вона використовувала, перелічені під нею."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cevabı okuyun ve altında listelenen, kullandığı sayfaları açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přečtěte si odpověď a poté otevřete stránky, které použila, uvedené pod ní."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prečítajte si odpoveď a potom otvorte stránky, ktoré použila, uvedené pod ňou."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάστε την απάντηση και μετά ανοίξτε τις σελίδες που χρησιμοποίησε, που αναφέρονται από κάτω."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läs svaret och öppna sedan sidorna som det använde, listade under det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læs svaret, og åbn derefter de sider, det brugte, anført under det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Les svaret, og åpne deretter sidene det brukte, oppført under det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lue vastaus ja avaa sitten sen alla luetellut sivut, joita se käytti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca jawabannya, lalu buka halaman yang digunakan, tercantum di bawahnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc câu trả lời, sau đó mở các trang được sử dụng và liệt kê bên dưới."
          }
        }
      }
    },
    "Read typed text, surrounding text, selections and typing statistics.": {
