    "Tap your key, then stop.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik jou sleutel en stop dan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück deine Taste, dann stopp."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa tu tecla y luego para."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajuta oma klahv ja siis peatu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur ta touche, puis arrête."
          }
        },
        "hu": {
          "stringUnit": {
