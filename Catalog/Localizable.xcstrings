    "Emoji is off. Turn it on to use and customize it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji is af. Skakel dit aan om dit te gebruik en aan te pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji ist aus. Schalte es ein, um es zu nutzen und anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los emojis están desactivados. Actívalos para usarlos y personalizarlos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji on väljas. Lülita need sisse, et kasutada ja kohandada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les emoji sont désactivés. Active-les pour les utiliser et les personnaliser."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az emodzsi ki van kapcsolva. Kapcsold be, hogy használhasd és beállíthasd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli emoji sono disattivati. Attivali per usarli e personalizzarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵文字はオフです。オンにすると使えて、設定も変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이모지가 꺼져 있어요. 켜면 쓰고 설정도 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji dimatikan. Hidupkannya untuk guna dan sesuaikannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os emojis estão desligados. Liga-os para os usares e personalizares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эмодзи выключены. Включите их, чтобы пользоваться и настраивать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表情符号已关闭。打开后就能使用并调整设置。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji este dezactivat. Porniți-l pentru ao utiliza și personalizați."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji staat uit. Schakel het in om het te gebruiken en aan te passen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "表情符號已關閉。開啟後就能使用並調整設定。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Emotikony są wyłączone. Włącz go, aby go używać i dostosowywać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Емодзі вимкнено. Увімкніть його, щоб використовувати та налаштовувати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji kapalı. Kullanmak ve özelleştirmek için açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji jsou vypnuté. Zapněte jej, abyste jej mohli používat a přizpůsobovat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji sú vypnuté. Zapnite ho, aby ste ho mohli používať a prispôsobovať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το emoji είναι απενεργοποιημένο. Ενεργοποιήστε το για να το χρησιμοποιήσετε και να το προσαρμόσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji är avstängd. Slå på den för att använda och anpassa den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji er slået fra. Tænd den for at bruge og tilpasse den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji er av. Slå den på for å bruke og tilpasse den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji on pois päältä. Ota se käyttöön, jotta voit käyttää ja muokata sitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji tidak aktif. Aktifkan untuk menggunakan dan menyesuaikannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biểu tượng cảm xúc đã tắt. Bật nó lên để sử dụng và tùy chỉnh nó."
          }
        }
      }
    },
