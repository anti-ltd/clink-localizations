          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 가나-한자 변환 표를 만드는 데 사용된 일본어 읽기 데이터입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
