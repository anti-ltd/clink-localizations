    "Waiting for the encryption key in your iCloud Keychain. Nothing is written until it's here.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wag tans vir die enkripsiesleutel in jou iCloud-sleutelhanger. Niks word geskryf totdat dit hier is nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf den Schlüssel im iCloud-Schlüsselbund. Bis er da ist, wird nichts geschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando la clave de cifrado en tu llavero de iCloud. No se escribe nada hasta que llegue."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ootab võtit sinu iCloudi võtmehoidjas. Enne kui ta on siin, ei kirjutata midagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de la clé de chiffrement dans ton trousseau iCloud. Rien n’est écrit tant qu’elle n’est pas là."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Várakozás a titkosítási kulcsra az iCloud-kulcskarikádon. Amíg nincs meg, semmi nem íródik ki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa della chiave di crittografia nel tuo portachiavi iCloud. Finché non arriva, non viene scritto nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudキーチェーン内の暗号鍵を待っています。届くまで何も書き込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 키체인의 암호화 키를 기다리는 중입니다. 키가 도착할 때까지 아무것도 기록되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu kunci penyulitan dalam Rantai Kunci iCloud anda. Tiada apa-apa ditulis sehingga ia tiba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "À espera da chave de encriptação no teu porta-chaves do iCloud. Nada é escrito até chegar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждём ключ шифрования из вашей Связки ключей iCloud. Пока его нет, ничего не записывается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待 iCloud 钥匙串中的加密密钥。密钥到达前不会写入任何内容。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Așteptați cheia de criptare în brelocul iCloud. Nu se scrie nimic până nu ajunge aici."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachten op de coderingssleutel in uw iCloud-sleutelhanger. Er wordt niets geschreven totdat het hier is."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待 iCloud 鑰匙串中的加密金鑰。金鑰到達前不會寫入任何內容。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwanie na klucz szyfrujący w pęku kluczy iCloud. Nic nie jest napisane, dopóki nie jest tutaj."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікування ключа шифрування у вашому брелоку iCloud. Нічого не написано, поки це не тут."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Anahtarlığınızda şifreleme anahtarı bekleniyor. Buraya gelene kadar hiçbir şey yazılmıyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čekání na šifrovací klíč ve vaší iCloud Keychain. Nic se nepíše, dokud to není tady."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čaká sa na šifrovací kľúč vo vašej kľúčenke iCloud. Nič sa nepíše, kým to tu nie je."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναμονή για το κλειδί κρυπτογράφησης στο iCloud Keychain σας. Τίποτα δεν γράφεται μέχρι να είναι εδώ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar på krypteringsnyckeln i din iCloud-nyckelring. Inget skrivs förrän det är här."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på krypteringsnøglen i din iCloud nøglering. Der er ikke skrevet noget før det er her."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på krypteringsnøkkelen i din iCloud nøkkelring. Ingenting er skrevet før det er her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odotetaan salausavainta iCloud-avainnipussa. Mitään ei ole kirjoitettu ennen kuin se on täällä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu kunci enkripsi di Gantungan Kunci iCloud Anda. Tidak ada yang tertulis sampai ada di sini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ khóa mã hóa trong Chuỗi khóa iCloud của bạn. Không có gì được viết cho đến khi nó ở đây."
          }
        }
      }
    },
