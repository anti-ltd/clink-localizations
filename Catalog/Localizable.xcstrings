    "Keep this key private and save it before signing out. Recovery signs out your other devices.": {
      "comment": "Optional private app account and purchase sharing. No email or typing data. Recovery key and pairing codes are secrets.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda esta clave en un lugar seguro antes de cerrar sesión. La recuperación cierra la sesión en tus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde cette clé secrète et sauvegarde-la avant de te déconnecter. La récupération déconnecte tes autres appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre diesen Schlüssel sicher auf, bevor du dich abmeldest. Die Wiederherstellung meldet deine anderen Geräte ab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva questa chiave in un luogo sicuro prima di uscire. Il recupero disconnette gli altri dispositivi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda esta chave em segurança antes de terminares sessão. A recuperação termina a sessão nos teus outros dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никому не сообщайте этот ключ и сохраните его перед выходом. Восстановление завершает сеансы на других ваших устройствах."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahsiakan dan simpan kunci ini sebelum mendaftar keluar. Pemulihan akan mendaftar keluar peranti anda yang lain."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd titokban ezt a kulcsot, és mentsd el kijelentkezés előtt. A helyreállítás kijelentkezteti a többi eszközödet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーは他人に教えず、サインアウト前に安全に保存してください。復旧すると、ほかのデバイスはサインアウトされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请妥善保管此密钥，并在退出登录前保存。恢复账户会使其他设备退出登录。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키를 타인에게 알리지 말고 로그아웃 전에 안전하게 보관해 주세요. 복구하면 다른 기기에서 로그아웃됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia seda võtit salajas ja salvesta see enne väljalogimist. Taastamine logib su teistest seadmetest välja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează cheia secretă și salveaz-o înainte de deconectare. Recuperarea deconectează celelalte dispozitive."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd deze sleutel geheim en bewaar hem voordat je uitlogt. Herstel logt je op andere apparaten uit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請妥善保管此密鑰，並在登出前儲存。復原帳號會讓其他裝置登出。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou hierdie sleutel geheim en bewaar dit voordat jy afmeld. Herstel meld jou ander toestelle af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj ten klucz w tajemnicy i zapisz go przed wylogowaniem. Odzyskanie konta wyloguje pozostałe urządzenia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігайте цей ключ у таємниці та збережіть його перед виходом. Відновлення завершує сеанси на інших ваших пристроях."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu anahtarı gizli tutun ve çıkış yapmadan önce kaydedin. Kurtarma, diğer cihazlarınızdaki oturumları kapatır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchovej tento klíč v tajnosti a ulož si ho před odhlášením. Obnovení odhlásí ostatní zařízení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchovaj tento kľúč v tajnosti a ulož si ho pred odhlásením. Obnovenie odhlási ostatné zariadenia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτησε αυτό το κλειδί μυστικό και αποθήκευσέ το πριν αποσυνδεθείς. Η ανάκτηση αποσυνδέει τις άλλες συσκευές σου."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll nyckeln hemlig och spara den innan du loggar ut. Återställning loggar ut dina andra enheter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold nøglen hemmelig, og gem den, før du logger ud. Gendannelse logger dine andre enheder ud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold nøkkelen hemmelig og lagre den før du logger ut. Gjenoppretting logger ut de andre enhetene dine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä avain salassa ja tallenna se ennen uloskirjautumista. Palautus kirjaa muut laitteesi ulos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahasiakan dan simpan kunci ini sebelum keluar. Pemulihan akan mengeluarkan akun dari perangkat Anda yang lain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ bí mật và lưu khóa này trước khi đăng xuất. Khôi phục sẽ đăng xuất các thiết bị khác của bạn."
          }
        }
      }
    },
    "Keep your recovery key. Recovery or replacing the key signs out your other devices. Accounts are not merged.": {
      "comment": "Optional private app account and purchase sharing. No email or typing data. Recovery key and pairing codes are secrets.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva tu clave de recuperación. Recuperar la cuenta o cambiar la clave cierra la sesión en tus otros dispositivos. Las cuentas no se fusionan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve ta clé de récupération. Récupérer le compte ou remplacer la clé déconnecte tes autres appareils. Les comptes ne sont pas fusionnés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre deinen Wiederherstellungsschlüssel auf. Eine Wiederherstellung oder ein neuer Schlüssel meldet deine anderen Geräte ab. Konten werden nicht zusammengeführt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva la chiave di recupero. Il recupero dell’account o la sostituzione della chiave disconnette gli altri dispositivi. Gli account non vengono uniti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda a tua chave de recuperação. Recuperar a conta ou substituir a chave termina a sessão nos teus outros dispositivos. As contas não são fundidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните ключ восстановления. Восстановление аккаунта или замена ключа завершает сеансы на других ваших устройствах. Аккаунты не объединяются."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan kunci pemulihan anda. Pemulihan atau penggantian kunci akan mendaftar keluar peranti anda yang lain. Akaun tidak digabungkan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Őrizd meg a helyreállítási kulcsodat. A helyreállítás vagy a kulcs cseréje kijelentkezteti a többi eszközödet. A fiókok nem egyesülnek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧キーを保管してください。アカウントの復旧やキーの再発行を行うと、ほかのデバイスはサインアウトされます。アカウントは統合されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保管好恢复密钥。恢复账户或更换密钥会使其他设备退出登录。账户不会合并。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 키를 보관해 주세요. 계정을 복구하거나 키를 교체하면 다른 기기에서 로그아웃됩니다. 계정은 병합되지 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia taastevõti alles. Konto taastamine või võtme vahetamine logib su teistest seadmetest välja. Kontosid ei ühendata üheks."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează cheia de recuperare. Recuperarea contului sau înlocuirea cheii deconectează celelalte dispozitive. Conturile nu se îmbină."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar je herstelsleutel. Herstellen of de sleutel vervangen logt je op andere apparaten uit. Accounts worden niet samengevoegd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保管好復原密鑰。復原帳號或更換密鑰會讓其他裝置登出。帳號不會合併。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar jou herstelsleutel. Herstel of vervanging van die sleutel meld jou ander toestelle af. Rekeninge word nie saamgevoeg nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj klucz odzyskiwania. Odzyskanie konta lub zmiana klucza wyloguje pozostałe urządzenia. Konta nie zostaną scalone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть ключ відновлення. Відновлення облікового запису або заміна ключа завершує сеанси на інших ваших пристроях. Облікові записи не об’єднуються."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma anahtarınızı saklayın. Hesabı kurtarmak veya anahtarı değiştirmek diğer cihazlarınızdaki oturumları kapatır. Hesaplar birleştirilmez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uschovej si klíč pro obnovení. Obnovení účtu nebo výměna klíče odhlásí ostatní zařízení. Účty se neslučují."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uschovaj si kľúč na obnovenie. Obnovenie účtu alebo výmena kľúča odhlási ostatné zariadenia. Účty sa nezlučujú."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φύλαξε το κλειδί ανάκτησης. Η ανάκτηση ή η αντικατάσταση του κλειδιού αποσυνδέει τις άλλες συσκευές σου. Οι λογαριασμοί δεν συγχωνεύονται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara din återställningsnyckel. Att återställa kontot eller byta nyckel loggar ut dina andra enheter. Konton slås inte ihop."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem din gendannelsesnøgle. Gendannelse af kontoen eller udskiftning af nøglen logger dine andre enheder ud. Konti flettes ikke sammen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta vare på gjenopprettingsnøkkelen. Gjenoppretting eller bytte av nøkkel logger ut de andre enhetene dine. Kontoer slås ikke sammen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilytä palautusavain. Tilin palauttaminen tai avaimen vaihtaminen kirjaa muut laitteesi ulos. Tilejä ei yhdistetä toisiinsa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan kunci pemulihan Anda. Memulihkan akun atau mengganti kunci akan mengeluarkan akun dari perangkat lain. Akun tidak digabungkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy giữ khóa khôi phục. Khôi phục tài khoản hoặc thay khóa sẽ đăng xuất các thiết bị khác. Các tài khoản không được gộp lại."
          }
        }
      }
    },
