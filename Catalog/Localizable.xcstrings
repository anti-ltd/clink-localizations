    "Add a key, or a row, where you want it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg 'n sleutel, of 'n ry, by waar jy dit wil hê."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge dort eine Taste oder eine Reihe ein, wo du sie haben willst."
          }
        },
