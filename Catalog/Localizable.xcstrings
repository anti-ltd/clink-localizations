        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingevoerde woordeboeke, op dieselfde bladsy, vul ook 'n taal wat op die lys is, 'n tegniese woordeskat of 'n dialek aan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Importierte Wörterbücher“ auf derselben Seite füllt auch eine vorhandene Sprache auf — Fachvokabular oder Dialekt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diccionarios importados, en la misma página, también amplía un idioma que sí está en la lista: vocabulario técnico, o un dialecto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Imporditud sõnaraamatud, samal lehel, täidavad ka loendis olevat keelt, tehnilist sõnavara või murret."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictionnaires importés, sur la même page, complète aussi une langue déjà présente : vocabulaire technique, ou dialecte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugyanezen az oldalon az Importált szótárak egy listán szereplő nyelvet is kiegészít — szakszókinccsel vagy nyelvjárással."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dizionari importati, nella stessa pagina, arricchisce anche una lingua già presente: lessico tecnico o un dialetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じページの「読み込んだ辞書」は、リストにある言語を補強するのにも使えます。専門用語や方言などです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 페이지의 가져온 사전은 목록에 있는 언어를 보강하는 데도 쓸 수 있습니다. 전문 용어나 방언 같은 것들요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamus yang diimport, pada halaman yang sama, juga menambah bahasa yang memang ada dalam senarai — istilah teknikal, atau dialek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicionários importados, na mesma página, também reforça um idioma que já está na lista — vocabulário técnico, ou um dialecto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортированные словари на той же странице умеют и дополнять язык из списка — технической лексикой или диалектом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一页的“导入的词典”也能给列表里已有的语言加料：专业术语，或者方言。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicționarele importate, pe aceeași pagină, completează și o limbă care se află pe listă, un vocabular tehnic sau un dialect."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geïmporteerde woordenboeken, op dezelfde pagina, vullen ook een taal aan die op de lijst staat, een technisch vocabulaire of een dialect."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一頁的“匯入的詞典”也能給列表裡已有的語言加料：專業術語，或者方言。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaimportowane słowniki na tej samej stronie uzupełniają także język znajdujący się na liście, słownictwo techniczne lub dialekt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортовані словники на тій же сторінці також доповнюють мову зі списку, технічну лексику чи діалект."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarılan sözlükler aynı sayfada listede bulunan bir dili, teknik kelime dağarcığını veya lehçeyi de tamamlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Importované slovníky na stejné stránce také doplňují jazyk, který je na seznamu, odbornou slovní zásobu nebo dialekt."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Importované slovníky na tej istej stránke dopĺňajú aj jazyk, ktorý je v zozname, odbornú slovnú zásobu alebo dialekt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα εισαγόμενα λεξικά, στην ίδια σελίδα, συμπληρώνουν επίσης μια γλώσσα που βρίσκεται στη λίστα, ένα τεχνικό λεξιλόγιο ή μια διάλεκτο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Importerade ordböcker, på samma sida, fyller också på ett språk som finns på listan, en teknisk vokabulär eller en dialekt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Importerede ordbøger på samme side supplerer også et sprog, der er på listen, et teknisk ordforråd eller en dialekt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importerte ordbøker, på samme side, fyller også opp et språk som er på listen, et teknisk vokabular eller en dialekt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuodut sanakirjat, samalla sivulla, täydentävät myös luettelossa olevaa kieltä, teknistä sanastoa tai murretta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamus yang diimpor, pada halaman yang sama, juga menambah bahasa yang ada dalam daftar, kosakata teknis, atau dialek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ điển nhập khẩu, trên cùng một trang, cũng bổ sung thêm ngôn ngữ có trong danh sách, từ vựng kỹ thuật hoặc phương ngữ."
          }
        }
      }
    },
