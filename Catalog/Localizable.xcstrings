          "stringUnit": {
            "state": "translated",
            "value": "Status telah berubah sejak kali terakhir anda melihat"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az állapot megváltozott, mióta utoljára megnézted"
