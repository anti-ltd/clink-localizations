    "Build history stays on this device. Delete a task to remove its request, drafts and details.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build history stays on this device. Delete a task to remove its request, drafts and details."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Aufgabenverlauf bleibt auf diesem Gerät. Wenn du eine Aufgabe löschst, werden ihre Anfrage, Entwürfe und Details entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de creación se guarda en este dispositivo. Elimina una tarea para borrar su solicitud, borradores y detalles."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Koostamisajalugu jääb sellesse seadmesse. Ülesande kustutamisel eemaldatakse ka selle päring, mustandid ja üksikasjad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique de création reste sur cet appareil. Supprime une tâche pour effacer sa demande, ses brouillons et ses détails."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A létrehozási előzmények ezen az eszközön maradnak. Egy feladat törlésével a hozzá tartozó kérés, piszkozatok és részletek is törlődnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia delle attività rimane su questo dispositivo. Elimina un’attività per rimuovere la richiesta, le bozze e i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成履歴はこのデバイスに保存されます。タスクを削除すると、そのリクエスト、下書き、詳細も削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성 기록은 이 기기에 보관됩니다. 작업을 삭제하면 해당 요청, 초안 및 세부사항도 삭제됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejarah pembinaan kekal pada peranti ini. Padam tugas untuk membuang permintaan, draf dan butirannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de criação fica neste dispositivo. Apaga uma tarefa para remover o pedido, os rascunhos e os detalhes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История создания хранится на этом устройстве. При удалении задачи удаляются её запрос, черновики и подробности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成历史记录保存在此设备上。删除任务会同时移除其请求、草稿和详情。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Istoricul construirii rămâne pe acest dispozitiv. Ștergeți o sarcină pentru a elimina cererea, schițele și detaliile acesteia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bouwgeschiedenis blijft op dit apparaat staan. Verwijder een taak om de aanvraag, concepten en details ervan te verwijderen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "生成歷史記錄儲存在此裝置上。刪除任務會同時移除其請求、草稿和詳情。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Bougeskiedenis bly op hierdie toestel. Verwyder 'n taak om die versoek, konseppe en besonderhede te verwyder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia budowania pozostaje na tym urządzeniu. Usuń zadanie, aby usunąć jego żądanie, wersje robocze i szczegóły."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історія збірок залишається на цьому пристрої. Видаліть завдання, щоб видалити його запит, чернетки та деталі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Derleme geçmişi bu cihazda kalır. İsteğini, taslaklarını ve ayrıntılarını kaldırmak için bir görevi silin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Historie sestavení zůstane na tomto zařízení. Odstraněním úkolu odstraníte jeho požadavek, koncepty a podrobnosti."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "História zostáv zostane na tomto zariadení. Odstrániť úlohu, ak chcete odstrániť jej požiadavku, koncepty a podrobnosti."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ιστορικό κατασκευής παραμένει σε αυτήν τη συσκευή. Διαγράψτε μια εργασία για να καταργήσετε το αίτημα, τα προσχέδια και τις λεπτομέρειες."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygghistorik finns kvar på den här enheten. Ta bort en uppgift för att ta bort begäran, utkast och detaljer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Byggehistorik forbliver på denne enhed. Slet en opgave for at fjerne dens anmodning, kladder og detaljer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Byggeloggen forblir på denne enheten. Slett en oppgave for å fjerne forespørselen, utkastene og detaljene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koontihistoria säilyy tällä laitteella. Poista tehtävä poistaaksesi sen pyynnön, luonnokset ja tiedot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat pembuatan tetap ada di perangkat ini. Hapus tugas untuk menghapus permintaan, draf, dan detailnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử xây dựng vẫn còn trên thiết bị này. Xóa một nhiệm vụ để loại bỏ yêu cầu, bản nháp và chi tiết của nhiệm vụ đó."
          }
        }
      }
    },
