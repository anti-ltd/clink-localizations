        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Pouze pokud je vaším jediným aktivním jazykem vietnamština."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Len pokiaľ je vaším jediným aktívnym jazykom vietnamčina."
