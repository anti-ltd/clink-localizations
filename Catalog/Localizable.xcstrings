    "Quick and calm. Keys settle without a bounce.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnell und ruhig. Tasten kommen ohne Nachfedern zur Ruhe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido y tranquilo. Las teclas se asientan sin rebote."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiire ja rahulik. Klahvid jäävad paigale ilma põrketa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapide et calme. Les touches se stabilisent sans rebond."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyors és nyugodt. A billentyűk pattogás nélkül állnak meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapido e calmo. I tasti si fermano senza rimbalzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素早く落ち着いた動き。キーは跳ねずに止まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠르고 차분하게. 키가 튕기지 않고 멈춰요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantas dan tenang. Kekunci berhenti tanpa lantunan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido e calmo. As teclas assentam sem ressalto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстро и спокойно. Клавиши останавливаются без отскока."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速而平静，按键停下时不回弹。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapid și calm. Tastele se stabilesc fără să sară."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snel en rustig. Sleutels worden zonder stuiteren afgezet."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速而平靜，按鍵停下時不回彈。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinnig en kalm. Sleutels kom tot rus sonder om te wip."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybko i spokojnie. Klawisze układają się bez odbić."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Швидко і спокійно. Ключі сидять без відскоку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı ve sakin. Anahtarlar sıçrama olmadan yerleşir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychle a v klidu. Klíče se usadí bez odskoku."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rýchlo a pokojne. Kľúče sa usadia bez odrazu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γρήγορα και ήρεμα. Τα κλειδιά εγκαθίστανται χωρίς αναπήδηση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snabbt och lugnt. Nycklar sätter sig utan studs."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtigt og roligt. Nøgler sætter sig uden at hoppe."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rask og rolig. Nøkler legger seg uten sprett."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nopea ja rauhallinen. Avaimet asettuvat ilman pomppimista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cepat dan tenang. Kunci menetap tanpa memantul."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhanh chóng và bình tĩnh. Phím ổn định mà không bị trả lại."
          }
        }
      }
    },
