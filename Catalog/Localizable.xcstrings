          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca no botão de idioma no fim da barra de sugestões para passares ao idioma seguinte, ou mantém premido para escolheres um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку языка в конце строки подсказок, чтобы перейти к следующему языку, или удержите её, чтобы выбрать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点候选栏末尾的语言按钮切到下一个语言，长按则从列表里挑。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți butonul de limbă de la sfârșitul barei de sugestii pentru următoarea limbă sau țineți apăsat pentru a alege una."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de taalknop aan het einde van de suggestiebalk voor de volgende taal, of houd deze ingedrukt om er een te kiezen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
