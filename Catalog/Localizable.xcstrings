    "Your own panels will be deleted and the built-in samples restored. This can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou eie panele sal uitgevee word en die ingeboude monsters sal herstel word. Dit kan nie ongedaan gemaak word nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine eigenen Panels werden gelöscht und die integrierten Beispiele wiederhergestellt. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán tus propios paneles y se restaurarán las muestras integradas. Esto no se puede deshacer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu enda paneelid kustutatakse ja sisseehitatud näidised taastatakse. Seda ei saa tagasi võtta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes propres panneaux seront supprimés et les exemples intégrés restaurés. Cette action est irréversible."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A saját paneljeid törlődnek, és visszaáll a beépített minták. Ez nem vonható vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi pannelli personali verranno eliminati e verranno ripristinati i campioni integrati. Non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた自身のパネルは削除され、内蔵サンプルに戻ります。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 만든 패널은 삭제되고 기본 샘플로 복원돼요. 되돌릴 수 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel anda sendiri akan dipadam dan sampel terbina dalam dipulihkan. Ini tidak boleh dibuat asal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus painéis próprios vão ser eliminados e as amostras integradas restauradas. Isto não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши панели будут удалены, а встроенные примеры возвращены. Отменить это нельзя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己创建的面板会被删除，恢复为内置示例。此操作无法撤销。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "propriile panouri vor fi șterse și mostrele încorporate vor fi restaurate. Acest lucru nu poate fi anulat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw eigen panelen worden verwijderd en de ingebouwde voorbeelden worden hersteld. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己建立的面板會被刪除，恢復為內建示例。此操作無法撤銷。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje własne panele zostaną usunięte, a wbudowane próbki przywrócone. Tego nie można cofnąć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші власні панелі буде видалено, а вбудовані зразки відновлено. Цю дію не можна скасувати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi panelleriniz silinecek ve yerleşik örnekler geri yüklenecektir. Bu geri alınamaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše vlastní panely budou smazány a vestavěné vzorky obnoveny. Toto nelze vrátit zpět."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše vlastné panely budú odstránené a vstavané vzorky budú obnovené. Toto sa nedá vrátiť späť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δικά σας πλαίσια θα διαγραφούν και τα ενσωματωμένα δείγματα θα αποκατασταθούν. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina egna paneler kommer att raderas och de inbyggda proverna återställs. Detta kan inte ångras."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine egne paneler vil blive slettet, og de indbyggede prøver vil blive gendannet. Dette kan ikke fortrydes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine egne paneler vil bli slettet og de innebygde prøvene gjenopprettet. Dette kan ikke angres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omat paneelisi poistetaan ja sisäänrakennetut näytteet palautetaan. Tätä ei voi kumota."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel Anda sendiri akan dihapus dan sampel bawaan akan dipulihkan. Hal ini tidak dapat dibatalkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảng của riêng bạn sẽ bị xóa và các mẫu tích hợp sẽ được khôi phục. Không thể hoàn tác việc này."
          }
        }
      }
    },
