    "Bento stacks notes in two columns, each card as tall as its note, so you can read one without loading it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento stapel notas in twee kolomme, elke kaart so lank soos sy noot, sodat jy een kan lees sonder om dit te laai."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento stapelt Notizen in zwei Spalten – jede Karte so hoch wie ihre Notiz, sodass du sie lesen kannst, ohne sie zu laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento apila las notas en dos columnas, con cada tarjeta tan alta como su nota, así puedes leerla sin cargarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento virnab märkused kahes veerus, iga kaart sama kõrge kui oma märkus, nii et sa saad ühe neist lugeda seda avamata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento empile les notes sur deux colonnes, chaque carte à la hauteur de sa note : tu peux la lire sans la charger."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Bento két oszlopba rendezi a jegyzeteket, minden kártya akkora, mint a jegyzete – így betöltés nélkül is elolvashatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento impila le note su due colonne, ogni scheda alta quanto la sua nota: così la leggi senza caricarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベントーはメモを2列に並べ、カードの高さをメモに合わせます。読み込まなくても全文が読めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벤토는 메모를 두 열로 쌓고 카드 높이를 메모에 맞춰요. 불러오지 않아도 전체를 읽을 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento menyusun nota dalam dua lajur, setiap kad setinggi notanya — jadi anda boleh membacanya tanpa memuatkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bento empilha as notas em duas colunas, cada cartão tão alto quanto a sua nota, para a leres sem a carregar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Бенто» складывает заметки в две колонки, и высота карточки равна длине заметки — можно прочитать её, не открывая."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "便当网格把备忘分成两列，卡片高度随备忘伸展，不用载入就能读完整条。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento stivuiește note în două coloane, fiecare card la fel de înalt ca nota sa, astfel încât să poți citi unul fără să îl încarci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento stapelt de bankbiljetten in twee kolommen, waarbij elke kaart even hoog is als het biljet, zodat je er één kunt lezen zonder deze te laden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "便當網格把備忘分成兩列，卡片高度隨備忘伸展，不用載入就能讀完整條。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento układa notatki w dwóch kolumnach, każda karta ma wysokość odpowiadającą jej notatce, dzięki czemu można ją przeczytać bez jej ładowania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бенто складає нотатки у два стовпці, кожна картка висотою як її нотатка, тож ви можете прочитати одну, не завантажуючи її."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento, notları iki sütun halinde istifler, her kart kendi notu kadar uzundur, böylece bir tanesini yüklemeden okuyabilirsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento ukládá bankovky do dvou sloupců, přičemž každá karta je stejně vysoká jako její bankovka, takže si můžete jednu přečíst, aniž byste ji načítali."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento ukladá bankovky do dvoch stĺpcov, pričom každá karta je taká vysoká ako jej bankovka, takže si môžete jednu prečítať bez toho, aby ste ju načítali."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Bento στοιβάζει τις σημειώσεις σε δύο στήλες, κάθε κάρτα τόσο ψηλή όσο η νότα της, ώστε να μπορείτε να διαβάσετε μία χωρίς να τη φορτώσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento staplar anteckningar i två kolumner, varje kort lika högt som dess sedel, så att du kan läsa en utan att ladda den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento stabler sedler i to kolonner, hvert kort er lige så højt som dets seddel, så du kan læse en uden at indlæse den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento stabler notater i to kolonner, hvert kort er like høyt som lappen, slik at du kan lese en uten å laste den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento pinoaa muistiinpanoja kahteen sarakkeeseen, joista kukin kortti on yhtä korkea kuin sen muistiinpano, joten voit lukea yhden lataamatta sitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento menumpuk catatan dalam dua kolom, masing-masing kartu setinggi catatannya, sehingga Anda dapat membacanya tanpa memuatnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento xếp các ghi chú thành hai cột, mỗi cột cao bằng ghi chú của nó để bạn có thể đọc một ghi chú mà không cần tải nó."
          }
        }
      }
    },
