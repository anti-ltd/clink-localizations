    "Send it over and we can tell what ran the keyboard out of memory.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stuur dit oor en ons kan sien wat die sleutelbord uit die geheue laat loop het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schick ihn uns, dann sehen wir, was der Tastatur den Speicher weggenommen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíanoslo y podremos ver qué dejó al teclado sin memoria."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saada see meile ja me näeme, mis klaviatuuril mälu otsa laskis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie-le-nous et on pourra voir ce qui a vidé la mémoire du clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Küldd el nekünk, és megnézzük, mi fogyasztotta el a billentyűzet memóriáját."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mandacelo e possiamo capire cosa ha esaurito la memoria della tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送っていただければ、何がキーボードのメモリを使い切ったのか調べられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내주시면 무엇이 키보드의 메모리를 다 써버렸는지 확인할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantar kepada kami dan kami boleh lihat apa yang menghabiskan memori papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia-nos e conseguimos ver o que esgotou a memória do teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пришлите его — и мы поймём, из-за чего клавиатуре не хватило памяти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发给我们，我们就能看出是什么耗尽了键盘的内存。"
          }
        }
      }
    },
    "Send it to us through Support on clinkkeys.app.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stuur dit aan ons deur ondersteuning op clinkkeys.app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schick ihn uns über den Support auf clinkkeys.app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíanoslo desde Soporte en clinkkeys.app."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saada see meile lehe Tugi kaudu aadressil clinkkeys.app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie-le-nous via Support sur clinkkeys.app."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Küldd el nekünk a clinkkeys.app Támogatás oldaláról."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mandacelo dalla sezione Assistenza su clinkkeys.app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.appの「サポート」から送ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app의 지원에서 보내 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantarkannya kepada kami melalui Sokongan di clinkkeys.app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia-nos o relatório pelo Apoio em clinkkeys.app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправьте его нам через «Поддержку» на clinkkeys.app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 clinkkeys.app 上的“支持”发给我们。"
          }
        }
      }
    },
