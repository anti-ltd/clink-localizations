            "value": "Πόσα πλήκτρα ταλαντεύονται πριν εγκατασταθούν. Κανένα δεν καθιζάνει καθαρά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur mycket nycklar vinglar innan de sätter sig. Ingen lägger sig rent."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
