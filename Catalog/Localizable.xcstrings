    "Landing-bias learning and tap correction live on the Hitboxes page.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lernen der Tippabweichung und die Tippkorrektur findest du auf der Seite „Trefferflächen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aprendizaje del sesgo de toque y la corrección de toques están en la página Zonas táctiles."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puudutuste kõrvalekalde õppimine ja puudutuste parandus asuvad lehel Tabamisalad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’apprentissage du décalage des frappes et la correction des touches se trouvent sur la page Zones tactiles."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az érintési eltérés tanulása és az érintésjavítás a Találati zónák oldalon található."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’apprendimento dello scostamento e la correzione dei tocchi si trovano nella pagina Aree di tocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップのずれの学習とタップ補正は「ヒットボックス」ページにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭 치우침 학습과 탭 보정은 히트박스 페이지에 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelajaran sisihan ketikan dan pembetulan ketikan ada di halaman Kotak Sentuhan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O aprendizado do desvio de toque e a correção de toques ficam na página Áreas de toque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обучение смещению нажатий и коррекция нажатий — на странице «Зоны касания»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "落点偏差学习和点按校正位于“点击区域”页面。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Învățare privind prejudecățile de aterizare și corectarea atingerii în direct pe pagina Hitboxes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leren van landingsbias en tikcorrectie live op de Hitboxes-pagina."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "落點偏差學習和點按校正位於“點選區域”頁面。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanleer van landingsvoorkeur en tikregstelling vind plaas op die Treffsones-bladsy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
