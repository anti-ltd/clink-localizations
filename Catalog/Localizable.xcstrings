    "To bring the rest back, tap Show everything at the bottom of that screen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um den Rest zurückzuholen, tippe unten auf diesem Bildschirm auf „Alles anzeigen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recuperar lo demás, toca Mostrar todo al final de esa pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour récupérer le reste, touche Tout afficher en bas de cet écran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A többi visszahozásához koppints a képernyő alján a Mutass mindent gombra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per riavere il resto, tocca Mostra tutto in fondo a quella schermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻すには、その画面の下にある「すべて表示」をタップします。"
