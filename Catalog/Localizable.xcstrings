    "Your tools come first, in the app and on the keyboard. Switch back to Keyboard mode anytime.": {
      "comment": "Tools mode introduction: tools appear first in both the app and keyboard; the header keyboard button returns to Keyboard mode.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tools stehen im Mittelpunkt – in der App und auf der Tastatur. Du kannst jederzeit zum Tastaturmodus zurückwechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tools come first, in the app and on the keyboard. Switch back to Keyboard mode anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus herramientas tienen prioridad, tanto en la app como en el teclado. Puedes volver al modo teclado cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Nii rakenduses kui ka klaviatuuril on esikohal sinu tööriistad. Klaviatuurirežiimi saad igal ajal tagasi lülituda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes outils passent au premier plan, dans l’app comme sur le clavier. Tu peux revenir au mode clavier à tout moment."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközeid kerülnek előtérbe az appban és a billentyűzeten is. Bármikor visszaválthatsz billentyűzet módra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi strumenti sono in primo piano, sia nell’app che sulla tastiera. Puoi tornare alla modalità tastiera in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリでもキーボードでも、ツールが最初に表示されます。キーボードモードにはいつでも戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱과 키보드에서 도구가 먼저 표시됩니다. 언제든지 키보드 모드로 돌아갈 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat anda diutamakan dalam aplikasi dan pada papan kekunci. Anda boleh kembali ke mod papan kekunci pada bila-bila masa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tools staan centraal, in de app en op het toetsenbord. Je kunt op elk moment terug naar de toetsenbordmodus."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas ferramentas ficam em primeiro plano, na app e no teclado. Podes voltar ao modo de teclado quando quiseres."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrumentele tale sunt în prim-plan, în aplicație și pe tastatură. Poți reveni oricând la modul tastatură."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструменты всегда под рукой — в приложении и на клавиатуре. Вернуться в режим клавиатуры можно в любой момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App 和键盘中，优先显示工具。你可以随时切回键盘模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App 和鍵盤中，優先顯示工具。你可以隨時切回鍵盤模式。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou nutsmiddels geniet voorrang, beide in die toepassing en op die sleutelbord. Skakel enige tyd terug na sleutelbordmodus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje narzędzia są na pierwszym miejscu, w aplikacji i na klawiaturze. W dowolnym momencie możesz wrócić do trybu klawiatury."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші інструменти на першому місці в програмі та на клавіатурі. Switch back to Keyboard mode anytime."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamada ve klavyede araçlarınız önce gelir. İstediğiniz zaman Klavye moduna geri dönün."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše nástroje jsou na prvním místě, v aplikaci a na klávesnici. Kdykoli přepněte zpět do režimu klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše nástroje sú na prvom mieste, v aplikácii a na klávesnici. Kedykoľvek prepnite späť do režimu klávesnice."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα εργαλεία σας έρχονται πρώτα, στην εφαρμογή και στο πληκτρολόγιο. Επιστρέψτε στη λειτουργία πληκτρολογίου ανά πάσα στιγμή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina verktyg kommer först, i appen och på tangentbordet. Växla tillbaka till tangentbordsläge när som helst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine værktøjer kommer først, i appen og på tastaturet. Skift tilbage til tastaturtilstand når som helst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verktøyene dine kommer først, i appen og på tastaturet. Bytt tilbake til tastaturmodus når som helst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalusi ovat ensin, sovelluksessa ja näppäimistössä. Vaihda takaisin näppäimistötilaan milloin tahansa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peralatan Anda adalah yang utama, di aplikasi dan di keyboard. Beralih kembali ke mode Keyboard kapan saja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ của bạn được ưu tiên hàng đầu, trong ứng dụng và trên bàn phím. Chuyển về chế độ Bàn phím bất kỳ lúc nào."
          }
        }
      }
    },
