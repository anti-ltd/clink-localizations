    "Every dictionary is bundled in the app and runs on-device. Nothing is sent anywhere. The links credit the source projects.": {
      "extractionState": "stale",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke woordeboek word in die toepassing gebundel en werk op die toestel. Niks word nêrens heen gestuur nie. Die skakels gee krediet aan die bronprojekte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Wörterbuch steckt in der App und läuft auf dem Gerät. Nichts wird irgendwohin geschickt. Die Links sind ein Dank an die Quellprojekte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los diccionarios vienen dentro de la app y funcionan en el dispositivo. No se envía nada a ningún sitio. Los enlaces dan crédito a los proyectos de origen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga sõnaraamat on rakendusse sisse ehitatud ja töötab seadmel. Midagi ei saadeta kuhugi. Lingid osutavad allikprojektidele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque dictionnaire est intégré à l'app et tourne sur l'appareil. Rien n'est envoyé où que ce soit. Les liens créditent les projets d'origine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden szótár benne van az appban, és a készüléken fut. Semmi nem megy sehová. A linkek a forrásprojekteknek járó elismerés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni dizionario è incluso nell'app e gira sul dispositivo. Niente viene inviato da nessuna parte. I link danno credito ai progetti originali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの辞書もアプリに同梱され、端末の中で動きます。何もどこにも送られません。リンクは元になったプロジェクトへの謝辞です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 사전은 앱에 들어 있고 기기에서 바로 돌아가요. 아무 데도 안 보내요. 링크는 원본 프로젝트를 밝혀둔 거예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap kamus disertakan dalam apl dan berjalan atas peranti. Tiada apa dihantar ke mana-mana. Pautan itu kredit untuk projek asalnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dicionários vêm com a app e funcionam no dispositivo. Nada é enviado para lado nenhum. As ligações dão crédito aos projetos de origem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все словари встроены в приложение и работают на устройстве. Ничего никуда не отправляется. Ссылки — благодарность исходным проектам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个词典都打包在应用里，全部在设备上运行。什么都不会发到任何地方。这些链接是给源项目的署名。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare dicționar este inclus în aplicație și rulează pe dispozitiv. Nimic nu este trimis nicăieri. Legăturile creditează proiectele sursă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk woordenboek is gebundeld in de app en draait op het apparaat. Er wordt niets verzonden. De links crediteren de bronprojecten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個詞典都打包在應用裡，全部在裝置上執行。什麼都不會發到任何地方。這些連結是給源專案的署名。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy słownik jest dołączony do aplikacji i działa na urządzeniu. Nic nie jest nigdzie wysyłane. Linki podają projekty źródłowe."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен словник включено в додаток і працює на пристрої. Нічого нікуди не відправляють. Посилання посилаються на вихідні проекти."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sözlük uygulamada paket halindedir ve cihazda çalışır. Hiçbir yere hiçbir şey gönderilmiyor. Bağlantılar kaynak projelere atıfta bulunur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý slovník je součástí aplikace a běží na zařízení. Nikam se nic neposílá. Odkazy připisují zdrojové projekty."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý slovník je súčasťou aplikácie a beží na zariadení. Nikde sa nič neposiela. Odkazy pripisujú zdrojové projekty."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε λεξικό είναι ομαδοποιημένο στην εφαρμογή και εκτελείται στη συσκευή. Τίποτα δεν αποστέλλεται πουθενά. Οι σύνδεσμοι πιστώνουν τα έργα πηγής."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje ordbok är paketerad i appen och körs på enheten. Inget skickas någonstans. Länkarna krediterar källprojekten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver ordbog er samlet i appen og kører på enheden. Intet sendes nogen steder. Linkene krediterer kildeprojekterne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver ordbok er samlet i appen og kjører på enheten. Ingenting sendes noe sted. Lenkene krediterer kildeprosjektene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen sanakirja on niputettu sovellukseen ja toimii laitteessa. Mitään ei lähetetä minnekään. Linkit antavat tunnustusta lähdeprojektille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap kamus dibundel dalam aplikasi dan dijalankan di perangkat. Tidak ada yang dikirim ke mana pun. Tautan tersebut memberi kredit pada proyek sumber."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi từ điển đều được gói trong ứng dụng và chạy trên thiết bị. Không có gì được gửi đi bất cứ đâu. Các liên kết ghi nhận các dự án nguồn."
          }
        }
      }
    },
