    "Hide this sticker without deleting it. Its place stays saved.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Versteek hierdie plakker sonder om dit uit te vee. Sy plek bly gestoor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blende diesen Sticker aus, ohne ihn zu löschen. Seine Position bleibt gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta esta pegatina sin borrarla: su posición se conserva."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peida see kleeps ilma seda kustutamata. Tema asukoht jääb alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquez cet autocollant sans le supprimer : sa position reste enregistrée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejtsd el ezt a matricát törlés nélkül. A helye megmarad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi questo adesivo senza eliminarlo: la sua posizione resta salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除せずにステッカーを隠します。位置は保存されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하지 않고 이 스티커를 숨깁니다. 위치는 그대로 저장됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan pelekat ini tanpa memadamkannya. Kedudukannya kekal disimpan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculte este adesivo sem excluí-lo: a posição dele permanece salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть стикер, не удаляя его. Его позиция сохранится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏此贴纸而不删除它，其位置会保留。"
          }
        }
      }
    },
    "Higher": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más agudo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus aigu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höher"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più acuto"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais agudo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выше"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih tinggi"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Magasabb"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更高"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높게"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõrgem"
          }
        }
      }
    },
    "Higher feels punchier and more mechanical. Lower is a faint tick.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoër voel sterker en meer meganies. Laer is 'n flou bosluis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höher fühlt sich knackiger und mechanischer an. Niedriger ist nur ein leises Ticken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más alto se siente más fuerte y mecánico. Más bajo es solo un toquecito."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõrgem tundub löögilt kindlam ja mehaanilisem. Madalam on ainult nõrk tiksuv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus haut, ça fait plus franc et plus mécanique. Plus bas, c'est un léger tic."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A magasabb ütősebb és mechanikusabb. Az alacsonyabb csak egy halvány kattanás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più alto è più deciso e meccanico. Più basso è un tocco leggero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高いほど力強くてメカニカルな感触に、低いほどかすかなカチッという感触になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높을수록 더 세고 기계 같은 느낌이에요. 낮으면 살짝 톡 하는 정도예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagi tinggi rasa lagi mantap dan mekanikal. Lagi rendah cuma ketikan samar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais alto parece mais forte e mais mecânico. Mais baixo é um toque ténue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше — резче и механичнее. Меньше — еле слышный тик."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调高手感更有力、更机械。调低就是轻轻一下的咔嗒感。"
          }
        }
      }
    },
