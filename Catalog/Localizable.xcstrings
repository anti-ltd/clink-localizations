    "Pick an effect (rain, aurora, fireflies) and it drifts behind the keys as you type.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies 'n effek (reën, aurora, vuurvliegies) en dit dryf agter die sleutels terwyl jy tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Effekt — Regen, Aurora, Glühwürmchen — und er zieht beim Tippen hinter den Tasten vorbei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un efecto —lluvia, aurora, luciérnagas— y se moverá detrás de las teclas mientras escribes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali efekt (vihm, aurora, tulesääsed) ja see triibib tipimise ajal klahvide taga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un effet — pluie, aurore, lucioles — et il dérive derrière les touches pendant que tu écris."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz egy effektet — eső, sarki fény, szentjánosbogarak —, és gépelés közben a billentyűk mögött sodródik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un effetto — pioggia, aurora, lucciole — e scorre dietro i tasti mentre scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エフェクトを選びます。雨、オーロラ、ホタル。入力中、キーの後ろを流れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비, 오로라, 반딧불 같은 효과를 고르면 타이핑하는 동안 키 뒤에서 흐릅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih satu kesan — hujan, aurora, kelip-kelip — dan ia hanyut di belakang kekunci sambil anda menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um efeito — chuva, aurora, pirilampos — e ele desliza por trás das teclas enquanto escreves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите эффект — дождь, полярное сияние, светлячков — и он будет плыть за клавишами, пока вы печатаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑一个特效——雨、极光、萤火虫——打字时它就在按键后方流动。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți un efect (ploaie, auroră, licurici) și acesta se deplasează în spatele tastelor pe măsură ce introduceți text."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een effect (regen, aurora, vuurvliegjes) en het zweeft achter de toetsen terwijl je typt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "挑一個特效——雨、極光、螢火蟲——打字時它就在按鍵後方流動。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz efekt (deszcz, zorza polarna, świetliki), a podczas pisania będzie on przesuwał się za klawiszami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть ефект (дощ, полярне сяйво, світлячки), і він буде рухатися за клавішами під час введення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir efekt seçin (yağmur, aurora, ateşböcekleri) ve siz yazarken o efekt tuşların arkasına sürüklensin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte si efekt (déšť, polární záře, světlušky) a ten se během psaní pohybuje za klávesami."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte si efekt (dážď, polárna žiara, svetlušky) a pri písaní sa bude pohybovať za klávesmi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ένα εφέ (βροχή, σέλας, πυγολαμπίδες) και παρασύρεται πίσω από τα πλήκτρα καθώς πληκτρολογείτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en effekt (regn, norrsken, eldflugor) och den driver bakom tangenterna medan du skriver."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en effekt (regn, nordlys, ildfluer), og den driver bag tasterne, mens du skriver."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en effekt (regn, nordlys, ildfluer) og den driver bak tastene mens du skriver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse tehoste (sade, aurora, tulikärpäset) ja se ajautuu näppäinten taakse kirjoittaessasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih efek (hujan, aurora, kunang-kunang) dan efek tersebut akan melayang di belakang tombol saat Anda mengetik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một hiệu ứng (mưa, cực quang, đom đóm) và hiệu ứng đó sẽ trôi ra sau các phím khi bạn gõ."
          }
        }
      }
    },
    "Pick every place the light shows.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle jede Stelle, an der das Licht erscheint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cada lugar donde se ve la luz."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali kõik kohad, kus valgus paistab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez chaque endroit où la lumière apparaît."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki az összes helyet, ahol a fény megjelenik."
