    "%@ Only while Vietnamese is the one language being checked.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Slegs terwyl Viëtnamees die een taal is wat nagegaan word."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Nur solange Vietnamesisch die einzige geprüfte Sprache ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Solo mientras el vietnamita sea el único idioma comprobado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ainult siis, kui vietnami on ainus kontrollitav keel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Uniquement tant que le vietnamien est la seule langue vérifiée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Csak amíg a vietnami az egyetlen ellenőrzött nyelv."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Solo finché il vietnamita è l’unica lingua controllata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ベトナム語だけをチェック対象にしているあいだのみ有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 베트남어만 검사 대상일 때에만 적용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Hanya selagi bahasa Vietnam ialah satu-satunya bahasa yang disemak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Só enquanto o vietnamita for o único idioma a ser verificado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Только пока вьетнамский — единственный проверяемый язык."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仅在越南语是唯一被检查的语言时生效。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Numai în timp ce vietnameza este singura limbă verificată."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Alleen als Vietnamees de enige taal is die wordt gecontroleerd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 僅在越南語是唯一被檢查的語言時生效。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tylko wtedy, gdy sprawdzany jest język wietnamski."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Перевіряється лише в’єтнамська мова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Yalnızca Vietnamca kontrol edilen tek dil olduğunda."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Kontroluje se pouze vietnamština."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Kontroluje sa iba vietnamčina."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Μόνο ενώ τα βιετναμέζικα είναι η μία γλώσσα που ελέγχεται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Endast medan vietnamesiska är det enda språket som kontrolleras."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Kun mens vietnamesisk er det ene sprog, der kontrolleres."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Bare mens vietnamesisk er det ene språket som sjekkes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vain kun vietnami on yksi tarkistettava kieli."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Hanya sementara bahasa Vietnam adalah satu-satunya bahasa yang diperiksa."
          }
        },
        "vi": {
          "stringUnit": {
