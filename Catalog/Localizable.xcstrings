          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간당 GIF 검색 한도에 도달했어요. 나중에 다시 시도하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-ide otsingu tunnilimiit on täis. Proovi hiljem uuesti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Căutarea GIF și-a atins limita orară. Încercați din nou mai târziu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
