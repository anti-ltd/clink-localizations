    "Darkens the key's inner edge, so the cap looks recessed.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak die sleutel se binnerand donkerder, sodat die doppie ingedruk lyk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkelt die Innenkante ab, sodass die Taste eingelassen wirkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscurece el borde interior para que la tecla parezca hundida."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumestab klahvi sisemise serva, nii et kate näib süvendatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assombrit le bord intérieur pour que la touche paraisse enfoncée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sötétíti a billentyű belső élét, így az bemélyedve hat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scurisce il bordo interno, così il tasto sembra incassato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの内側の縁が暗くなり、へこんで見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 안쪽 가장자리를 어둡게 해서 눌린 것처럼 보여요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggelapkan bibir dalam kekunci supaya ia nampak terbenam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escurece o bordo interior, para a tecla parecer encaixada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемняет внутренний край клавиши, и она выглядит утопленной."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压暗按键内缘，让键帽看起来是嵌进去的。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întunecă marginea interioară a cheii, astfel încât capacul să pară îngropat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt de binnenrand van de sleutel donkerder, zodat de dop verzonken lijkt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壓暗按鍵內緣，讓鍵帽看起來是嵌進去的。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyciemnia wewnętrzną krawędź klucza, dzięki czemu nasadka wygląda na zagłębioną."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемнює внутрішній край ключа, тому ковпачок виглядає втопленим."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarın iç kenarını karartır, böylece kapak girintili görünür."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ztmaví vnitřní okraj klíče, takže krytka vypadá jako zapuštěná."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stmaví vnútorný okraj kľúča, takže uzáver vyzerá ako zapustený."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σκουραίνει το εσωτερικό άκρο του κλειδιού, έτσι το καπάκι φαίνεται σε εσοχή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mörkar nyckelns inre kant, så locket ser infällt ut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør nøglens indvendige kant mørkere, så hætten ser forsænket ud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør nøkkelens indre kant mørkere, slik at hetten ser innfelt ut."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tummentaa avaimen sisäreunaa, joten korkki näyttää upotetulta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggelapkan tepi bagian dalam kunci, sehingga tutupnya terlihat tersembunyi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm tối cạnh bên trong của phím, do đó nắp trông có vẻ lõm vào."
          }
        }
      }
    },
