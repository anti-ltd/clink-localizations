    "Width of each letter key within its grid cell. Lower values add more space between keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Breedte van elke lettersleutel binne sy roostersel. Laer waardes voeg meer spasie tussen sleutels by."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite jeder Buchstabentaste in ihrer Gitterzelle. Kleinere Werte lassen mehr Platz zwischen den Tasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancho de cada tecla de letra dentro de su celda. Cuanto más bajo, más espacio deja entre teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga täheklahvi laius võrgulahtris. Madalamad väärtused lisavad klahvide vahele rohkem ruumi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur de chaque touche de lettre dans sa cellule. Plus la valeur est basse, plus il y a d'espace entre les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy betűbillentyű szélessége a rácscellán belül. Kisebb érték több helyet hagy a billentyűk közt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Larghezza di ogni tasto lettera nella sua cella. Valori più bassi lasciano più spazio tra i tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリッド内での文字キー1つの幅です。小さくするとキーの間隔が広がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "칸 안에서 글자 키가 차지하는 너비예요. 값이 작을수록 키 사이가 더 벌어져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar setiap kekunci huruf dalam sel gridnya. Nilai lebih rendah beri lebih ruang antara kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Largura de cada tecla de letra dentro da sua célula. Valores mais baixos deixam mais espaço entre as teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ширина буквенной клавиши внутри её ячейки. Меньше — больше места между клавишами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个字母键在格子里的宽度。值越小，键之间的空隙越大。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lățimea fiecărei taste de litere din celula grilă. Valorile mai mici adaugă mai mult spațiu între taste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breedte van elke lettertoets binnen zijn rastercel. Lagere waarden voegen meer ruimte toe tussen de toetsen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個字母鍵在格子裡的寬度。值越小，鍵之間的空隙越大。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szerokość każdego klawisza literowego w komórce siatki. Niższe wartości powodują zwiększenie odstępu między klawiszami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ширина кожної літери в клітинці сітки. Менші значення додають більше простору між клавішами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgara hücresi içindeki her harf anahtarının genişliği. Daha düşük değerler tuşlar arasında daha fazla boşluk ekler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šířka každého písmena v jeho buňce mřížky. Nižší hodnoty zvyšují mezeru mezi klávesami."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Šírka každého písmena v bunke mriežky. Nižšie hodnoty pridávajú medzi klávesmi viac priestoru."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλάτος κάθε κλειδιού γράμματος μέσα στο κελί του πλέγματος. Οι χαμηλότερες τιμές προσθέτουν περισσότερο χώρο μεταξύ των πλήκτρων."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bredden på varje bokstavstangent i dess rutnätscell. Lägre värden ger mer utrymme mellan tangenterna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bredden af hver bogstavtast i dens gittercelle. Lavere værdier tilføjer mere plads mellem tasterne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bredden på hver bokstavtast i rutenettcellen. Lavere verdier gir mer plass mellom tastene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunkin kirjainnäppäimen leveys sen ruudukon solussa. Pienemmät arvot lisäävät tilaa näppäinten väliin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar setiap tombol huruf dalam sel kisinya. Nilai yang lebih rendah menambah lebih banyak ruang antar tombol."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiều rộng của mỗi phím chữ cái trong ô lưới của nó. Giá trị thấp hơn sẽ thêm nhiều khoảng trống hơn giữa các phím."
          }
        }
      }
    },
    "Width of the shift and backspace keys relative to a standard letter key.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
