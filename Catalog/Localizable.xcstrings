        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoví výchozí sadu, hlasitost a ladění. Vaše vlastní balíčky zůstanou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoví predvolený balík, hlasitosť a ladenie. Vaše vlastné balíčky zostávajú."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφέρει το προεπιλεγμένο πακέτο, την ένταση και τον συντονισμό. Τα προσαρμοσμένα πακέτα σας παραμένουν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställer standardpaketet, volymen och inställningen. Dina anpassade paket stannar."
