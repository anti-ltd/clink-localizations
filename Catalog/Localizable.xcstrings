            "state": "translated",
            "value": "Màu sắc và độ sáng chính của chủ đề này."
          }
        }
      }
    },
    "The key you press lights up, then fades.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sleutel wat jy druk lig op en vervaag dan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gedrückte Taste leuchtet auf und verblasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tecla que pulsas se ilumina y se apaga."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajutatud klahv süttib ja siis tuhmub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La touche que vous frappez s'allume, puis s'éteint."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lenyomott gomb felvillan, majd elhalványul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasto che premi si accende e poi svanisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押したキーが光り、やがて消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누른 키가 켜졌다가 서서히 사라집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci yang anda tekan menyala, kemudian pudar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tecla que premes acende e desvanece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатая клавиша загорается, затем гаснет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下的按键亮起，随后淡去。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasta pe care o apăsați se aprinde, apoi dispare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De toets die u indrukt, licht op en vervaagt vervolgens."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下的按鍵亮起，隨後淡去。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnięty klawisz zaświeci się, a następnie zgaśnie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіша, яку ви натискаєте, світиться, а потім гасне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bastığınız tuşun ışığı yanar, sonra söner."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačítko, které stisknete, se rozsvítí a poté zhasne."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačidlo, ktoré stlačíte, sa rozsvieti a potom zhasne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πλήκτρο που πατάτε ανάβει και μετά σβήνει."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangenten du trycker på tänds och slocknar sedan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den tast, du trykker på, lyser op og toner derefter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasten du trykker på lyser og tones deretter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Painamasi näppäin syttyy ja sammuu sitten."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol yang Anda tekan menyala, lalu memudar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím bạn nhấn sáng lên rồi mờ dần."
          }
        }
      }
    },
    "The keyboard and Emoji are free, always. Subscribe to unlock Dictation, AI Tools, and everything else in Tools.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sleutelbord en Emoji is gratis, altyd. Teken in om Dictation, AI Tools en alles anders in Tools te ontsluit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastatur und Emoji sind immer kostenlos. Abonniere, um Diktieren, KI-Werkzeuge und alles Weitere in Werkzeuge freizuschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado y los Emoji son gratis, siempre. Suscríbete para desbloquear Dictado, Herramientas de IA y todo lo demás en Herramientas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuur ja Emoji on alati tasuta. Telli, et avada dikteerimine, TI-tööriistad ja kõik muu tööriistadest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier et les Emoji sont gratuits, toujours. Abonne-toi pour débloquer Dictée, Outils IA et tout le reste dans Outils."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzet és az emoji mindig ingyenes. Iratkozz fel, hogy feloldd a Diktálást, MI-eszközöket és minden mást az Eszközökben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera e le emoji sono sempre gratuite. Abbonati per sbloccare Dettatura, Strumenti AI e tutto il resto in Strumenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードと絵文字はいつでも無料です。サブスクリプションで音声入力、AIツール、その他すべてのツールをアンロック。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드와 이모지는 언제나 무료입니다. 구독하여 받아쓰기, AI 도구 및 도구의 기타 모든 기능을 잠금 해제하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci dan Emoji sentiasa percuma. Langgan untuk membuka kunci Imlak, Alat AI dan semua yang lain dalam Alat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado e os Emoji são sempre gratuitos. Subscreve para desbloquear Ditado, Ferramentas de IA e tudo o resto em Ferramentas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура и эмодзи всегда бесплатны. Оформите подписку, чтобы открыть диктовку, инструменты ИИ и всё остальное в «Инструментах»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘和表情符号始终免费。订阅以解锁听写、AI 工具及工具中的其他一切。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastatura și emoji sunt gratuite, întotdeauna. Abonați-vă pentru a debloca Dictarea, Instrumentele AI și orice altceva din Instrumente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het toetsenbord en de Emoji zijn altijd gratis. Abonneer u om Dictation, AI Tools en al het andere in Tools te ontgrendelen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤和表情符號始終免費。訂閱以解鎖聽寫、AI 工具及工具中的其他一切。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawiatura i emoji są zawsze bezpłatne. Zasubskrybuj, aby odblokować dyktowanie, narzędzia AI i wszystko inne w narzędziach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіатура та Emoji завжди безкоштовні. Підпишіться, щоб розблокувати Диктант, Інструменти AI та все інше в Інструментах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye ve Emoji her zaman ücretsizdir. Dikte, Yapay Zeka Araçları ve Araçlar'daki diğer her şeyin kilidini açmak için abone olun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesnice a Emoji jsou vždy zdarma. Přihlaste se k odběru a odemkněte Diktování, nástroje AI a vše ostatní v Nástrojích."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesnica a Emoji sú vždy zadarmo. Prihláste sa na odber a odomknite Diktovanie, Nástroje AI a všetko ostatné v Nástrojoch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πληκτρολόγιο και το Emoji είναι πάντα δωρεάν. Εγγραφείτε για να ξεκλειδώσετε το Υπαγόρευση, τα Εργαλεία AI και οτιδήποτε άλλο στα Εργαλεία."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangentbordet och emojin är alltid gratis. Prenumerera för att låsa upp diktering, AI-verktyg och allt annat i verktyg."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturet og Emoji er gratis, altid. Abonner for at låse op for diktering, AI-værktøjer og alt andet i Værktøjer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturet og Emoji er gratis, alltid. Abonner for å låse opp diktering, AI-verktøy og alt annet i Verktøy."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäimistö ja Emoji ovat aina ilmaisia. Tilaa avataksesi sanelun, tekoälytyökalut ja kaikki muut työkalut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard dan Emoji selalu gratis. Berlangganan untuk membuka kunci Dikte, Alat AI, dan semua hal lainnya di Alat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bàn phím và Biểu tượng cảm xúc luôn miễn phí. Đăng ký để mở khóa Đọc chính tả, Công cụ AI và mọi thứ khác trong Công cụ."
          }
        }
      }
    },
