    "Always-on keys ride along on all of them, either side of the space bar, no matter which layout or language you're in.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyd-aan-sleutels ry saam op almal van hulle, weerskante van die spasiebalk, maak nie saak in watter uitleg of taal jy is nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauerhafte Tasten sind überall dabei, links oder rechts von der Leertaste, egal in welchem Layout oder welcher Sprache du bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas siempre visibles te acompañan en todas, a un lado u otro de la barra espaciadora, sea cual sea la distribución o el idioma."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Püsiklahvid on kaasas kõikjal, tühikuklahvi kummalegi poole, ükskõik millises paigutuses või keeles sa oled."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches toujours présentes te suivent partout, d'un côté ou de l'autre de la barre d'espace, quelle que soit la disposition ou la langue."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mindig látható billentyűk mindegyiken ott vannak, a szóköz két oldalán, bármilyen kiosztásban vagy nyelven gépelsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti sempre presenti ti seguono ovunque, ai lati della barra spaziatrice, qualunque sia il layout o la lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「常時表示のキー」はスペースバーの左右に置かれ、レイアウトや言語が変わっても付いてきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 있는 키는 스페이스바 양옆에 자리 잡고, 레이아웃이나 언어가 바뀌어도 그대로 따라다닙니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci sentiasa ada mengikut anda pada semuanya, di kiri atau kanan bar ruang, tidak kira susun atur atau bahasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas sempre presentes acompanham-te em todos, de um lado ou outro da barra de espaços, seja qual for o esquema ou o idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постоянные клавиши едут вместе с ними по обе стороны пробела, в какой бы раскладке или языке вы ни были."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常驻按键会跟着你出现在每套布局上，在空格键的左边或右边，不管用哪种布局或语言。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastele mereu activate circulă pe toate, de fiecare parte a barei de spațiu, indiferent de aspectul sau limba în care vă aflați."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Always-on-toetsen rijden op alle toetsen mee, aan weerszijden van de spatiebalk, ongeacht in welke indeling of taal u zich bevindt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "常駐按鍵會跟著你出現在每套佈局上，在空格鍵的左邊或右邊，不管用哪種佈局或語言。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze włączone klawisze znajdują się po obu stronach spacji, niezależnie od układu i języka, w którym się znajdujesz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завжди ввімкнені клавіші є на кожному з них, по обидва боки від пробілу, незалежно від того, яку розкладку чи мову ви використовуєте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman açık tuşlar, hangi düzende veya dilde olursanız olun, boşluk çubuğunun her iki yanında da bulunur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vždy zapnuté klávesy jsou na všech z nich, na obou stranách mezerníku, bez ohledu na to, v jakém rozvržení nebo jazyce se nacházíte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vždy zapnuté klávesy jazdia na všetkých, na oboch stranách medzerníka, bez ohľadu na to, v akom rozložení alebo jazyku sa práve nachádzate."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πλήκτρα πάντα ενεργοποιημένα κινούνται σε όλα, σε κάθε πλευρά της γραμμής διαστήματος, ανεξάρτητα από τη διάταξη ή τη γλώσσα στην οποία βρίσκεστε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltid-på-tangenter följer med på alla, vardera sidan av mellanslagstangenten, oavsett vilken layout eller språk du är på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Altid-aktiverede taster kører med på dem alle, hver side af mellemrumstasten, uanset hvilket layout eller sprog du er på."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltid-på-taster følger med på dem alle, hver side av mellomromstasten, uansett hvilken layout eller språk du er på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aina päällä olevat näppäimet kulkevat niissä kaikissa välilyöntinäppäimen kummallakin puolella riippumatta siitä, mitä asettelua tai kieltä käytät."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol yang selalu aktif ada di semua tombol tersebut, di kedua sisi bilah spasi, apa pun tata letak atau bahasa yang Anda gunakan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím luôn bật xuất hiện trên tất cả các phím này, ở cả hai bên của phím cách, bất kể bạn đang sử dụng bố cục hoặc ngôn ngữ nào."
          }
        }
      }
    },
