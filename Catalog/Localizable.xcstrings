          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začněte psát. Obojí se kontroluje pravopisem najednou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Začnite písať. Oboje sa kontroluje pravopisom naraz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινήστε να πληκτρολογείτε. Και τα δύο ελέγχονται ορθογραφικά ταυτόχρονα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja skriva. Båda stavningskontrolleras på en gång."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begynd at skrive. Begge stavekontrolleres på én gang."
          }
        },
        "nb": {
          "stringUnit": {
