    "Clink taps into Apple Intelligence when available for smarter completions as you type.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink tik by Apple Intelligence wanneer dit beskikbaar is vir slimmer voltooiings terwyl jy tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink nutzt Apple Intelligence, wenn es verfügbar ist, für klügere Vervollständigungen beim Tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink recurre a Apple Intelligence cuando está disponible para completar con más inteligencia mientras escribes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kasutab võimalusel Apple Intelligence'i nutikamate lõpetuste jaoks tipimise ajal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink fait appel à Apple Intelligence quand c'est dispo pour des complétions plus malines pendant que tu tapes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink igénybe veszi az Apple Intelligence-t, ha elérhető, hogy okosabb kiegészítéseket adjon gépelés közben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink sfrutta Apple Intelligence, quando disponibile, per completamenti più intelligenti mentre scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink は使えるときに Apple Intelligence を活用して、入力中によりスマートな補完を出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink는 쓸 수 있을 때 Apple Intelligence를 활용해서 입력하는 동안 더 똑똑하게 자동 완성해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink guna Apple Intelligence apabila tersedia untuk pelengkapan lebih pintar semasa anda menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink usa a Apple Intelligence quando está disponível para conclusões mais espertas enquanto escreves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда Apple Intelligence доступен, Clink обращается к нему за более умными продолжениями по ходу печати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 Apple Intelligence 时，Clink 会用它，在你打字时给出更聪明的补全。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink accesează Apple Intelligence atunci când este disponibil pentru completări mai inteligente pe măsură ce tastați."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink maakt gebruik van Apple Intelligence, indien beschikbaar, voor slimmere voltooiingen terwijl u typt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 Apple Intelligence 時，Clink 會用它，在你打字時給出更聰明的補全。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink łączy się z Apple Intelligence, jeśli jest dostępny, w celu inteligentniejszego uzupełniania podczas pisania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink підключається до Apple Intelligence, коли це доступно для більш розумного завершення під час введення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink, siz yazarken daha akıllı tamamlamalar için uygun olduğunda Apple Intelligence'ten yararlanır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink se připojí k Apple Intelligence, když je k dispozici pro chytřejší dokončení při psaní."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink sa pripojí k Apple Intelligence, keď je k dispozícii pre inteligentnejšie dokončovanie pri písaní."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Clink χρησιμοποιεί το Apple Intelligence όταν είναι διαθέσιμο για πιο έξυπνες ολοκληρώσεις καθώς πληκτρολογείτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink utnyttjar Apple Intelligence när den är tillgänglig för smartare avslutningar medan du skriver."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink bruger Apple Intelligence, når den er tilgængelig for smartere afslutninger, mens du skriver."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink bruker Apple Intelligence når den er tilgjengelig for smartere fullføringer mens du skriver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink koskettaa Apple Intelligence:ää, kun se on saatavilla, ja tekee niistä älykkäämpiä kirjoittaessasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink memanfaatkan Apple Intelligence saat tersedia untuk penyelesaian yang lebih cerdas saat Anda mengetik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink khai thác Apple Intelligence khi có sẵn để hoàn thành thông minh hơn khi bạn nhập."
          }
        }
      }
    },
