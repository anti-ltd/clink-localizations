    "My tools disappeared and Clink is asking me to buy": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Werkzeuge sind verschwunden und Clink fordert mich zum Kauf auf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis herramientas han desaparecido y Clink me pide que me suscriba"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mu tööriistad kadusid ja Clink palub tellimuse osta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes outils ont disparu et Clink me demande de payer"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltűntek az eszközeim, és a Clink előfizetést kér"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I miei strumenti sono scomparsi e Clink mi chiede di abbonarmi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールが表示されなくなり、Clinkで購入を求められます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구가 사라지고 Clink에서 구매하라고 나와요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat saya hilang dan Clink meminta saya melanggan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As minhas ferramentas desapareceram e o Clink pede-me uma subscrição"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструменты пропали, и Clink предлагает оформить подписку"
