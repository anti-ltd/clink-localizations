    "Hold the key to pop up a bar of extra characters or panels, like Gboard's accents.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou die sleutel in om 'n balk met ekstra karakters of panele te laat verskyn, soos Gboard se aksent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt die Taste gedrückt, um eine Leiste mit zusätzlichen Zeichen oder Panels einzublenden, wie die Akzente bei Gboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la tecla para mostrar una barra con caracteres o paneles extra, como los acentos de Gboard."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia klahvi, et kuvada riba lisamärkide või paneelidega, nagu Gboardi aksendid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens la touche pour faire apparaître une barre de caractères ou de panneaux supplémentaires, comme les accents de Gboard."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd lenyomva a billentyűt, és felugrik egy sáv extra karakterekkel vagy panelekkel, mint a Gboard ékezetei."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto il tasto per far comparire una barra di caratteri o pannelli extra, come gli accenti di Gboard."
          }
        },
        "ja": {
