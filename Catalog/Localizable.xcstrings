        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как быстро успокаивается пружина пробела. Меньше — резче."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空格键的弹簧回稳有多快。数值越低越干脆。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de repede se instalează arcul barei de spațiu. Inferior este mai rapid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe snel de spatiebalkveer bezinkt. Lager is vlotter."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空格鍵的彈簧回穩有多快。數值越低越乾脆。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak szybko osiada sprężyna spacji. Niżej jest szybciej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як швидко встановлюється пружина пробілу. Нижче – швидше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluk çubuğu yayının ne kadar hızlı yerleştiği. Alt kısım daha hızlıdır."
