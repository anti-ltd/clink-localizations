    "Translate takes what you've typed and puts the translation into the field, ready to send.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate neem wat jy getik het en plaas die vertaling in die veld, gereed om te stuur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Übersetzen“ nimmt, was du getippt hast, und setzt die Übersetzung ins Feld — fertig zum Senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducir coge lo que has escrito y deja la traducción en el campo, lista para enviar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlge võtab selle, mida tipid, ja paneb tõlke välja, valmis saatmiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduire reprend ce que tu as tapé et place la traduction dans le champ, prête à envoyer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Fordítás fogja, amit beírtál, és a fordítást teszi a mezőbe, küldésre készen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduci prende quello che hai scritto e mette la traduzione nel campo, pronta da inviare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「翻訳」は入力した文章を訳し、送信できる状態で入力欄に入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역은 입력한 문장을 번역해 그대로 입력란에 넣어 줍니다. 바로 보내면 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemah mengambil apa yang anda taip dan meletakkan terjemahannya dalam medan itu, sedia untuk dihantar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Traduzir pega no que escreveste e põe a tradução no campo, pronta a enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Перевод» берёт напечатанное и кладёт перевод прямо в поле — можно отправлять."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“翻译”会把你写好的内容译好，直接放回输入框，可以直接发。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducerea preia ceea ce ați tastat și pune traducerea în câmp, gata de trimis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate neemt wat u heeft getypt en plaatst de vertaling in het veld, klaar om te verzenden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“翻譯”會把你寫好的內容譯好，直接放回輸入框，可以直接發。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tłumacz bierze to, co wpisałeś i umieszcza tłumaczenie w polu, gotowe do wysłania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекладач приймає те, що ви ввели, і розміщує переклад у полі, готовому для надсилання."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri, yazdıklarınızı alır ve çeviriyi gönderilmeye hazır şekilde alana koyar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překladač vezme, co jste zadali, a vloží překlad do pole, připraven k odeslání."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekladač vezme, čo ste zadali, a preklad vloží do poľa, pripravený na odoslanie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Translate παίρνει ό,τι πληκτρολογήσατε και τοποθετεί τη μετάφραση στο πεδίο, έτοιμο για αποστολή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Översätt tar det du har skrivit och lägger översättningen i fältet, redo att skickas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oversæt tager det, du har skrevet, og lægger oversættelsen i feltet, klar til at sende."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate tar det du har skrevet og legger oversettelsen inn i feltet, klar til å sendes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kääntäjä ottaa kirjoittamasi tekstin ja laittaa käännöksen kenttään valmiiksi lähetettäväksi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan mengambil apa yang Anda ketik dan memasukkan terjemahannya ke dalam bidang, siap dikirim."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch sẽ lấy nội dung bạn đã nhập và đưa bản dịch vào trường, sẵn sàng gửi."
          }
        }
      }
    },
