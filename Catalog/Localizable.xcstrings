        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 수정을 꺼도 단축어는 바로 확장돼요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan berkembang serta-merta, walaupun autobetul dimatikan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
