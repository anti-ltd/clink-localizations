    "Open Theme and tap one. The preview above changes as you go.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak Tema oop en tik een. Die voorskou hierbo verander soos jy gaan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne „Design“ und tippe eines an. Die Vorschau darüber ändert sich sofort mit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Tema y toca uno. La vista previa de arriba cambia sobre la marcha."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava Teema ja puuduta üht. Ülalolev eelvaade muutub kohe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Thème et touches-en un. L'aperçu au-dessus change au fur et à mesure."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Témát, és koppints egyre. A fenti előnézet rögtön követi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Tema e toccane uno. L'anteprima sopra cambia man mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「テーマ」を開いてタップします。上のプレビューがその場で切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마를 열고 하나를 누르세요. 위쪽 미리보기가 바로 바뀝니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Tema dan ketik satu. Pratonton di atas berubah serta-merta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Tema e toca num. A pré-visualização em cima muda à medida que vais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Темы» и нажмите на любую. Предпросмотр выше меняется на ходу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“主题”点一个，上面的预览会跟着变。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți Tema și atingeți una. Previzualizarea de mai sus se schimbă pe măsură ce mergeți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Thema en tik op één. Het bovenstaande voorbeeld verandert gaandeweg."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟“主題”點一個，上面的預覽會跟著變。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz motyw i dotknij jednego. Powyższy podgląd zmienia się w miarę upływu czasu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте тему та торкніться однієї. Попередній перегляд вище змінюється по ходу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temayı açın ve birine dokunun. Yukarıdaki önizleme siz ilerledikçe değişir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete Motiv a klepněte na jeden. Náhled výše se průběžně mění."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte tému a klepnite na jednu. Vyššie uvedený náhľad sa priebežne mení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το Θέμα και πατήστε ένα. Η παραπάνω προεπισκόπηση αλλάζει καθώς προχωράτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna tema och tryck på ett. Förhandsvisningen ovan ändras allt eftersom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn tema, og tryk på et. Forhåndsvisningen ovenfor ændres, mens du går."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne tema og trykk på ett. Forhåndsvisningen ovenfor endres mens du går."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa teema ja napauta yhtä. Yllä oleva esikatselu muuttuu edetessäsi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Tema dan ketuk salah satu. Pratinjau di atas berubah seiring berjalannya waktu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Chủ đề và nhấn vào một chủ đề. Bản xem trước ở trên sẽ thay đổi khi bạn thực hiện."
          }
        }
      }
    },
