    "Create groups to sort clips in the keyboard panel. Swipe a clip right to assign it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skep groepe om snitte in die sleutelbordpaneel te sorteer. Swiep 'n snit regs om dit toe te wys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg Gruppen an, um Clips im Tastaturpanel zu sortieren. Wisch einen Clip nach rechts, um ihn zuzuordnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea grupos para ordenar los clips en el panel del teclado. Desliza un clip a la derecha para asignarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loo gruppe, et klaviatuuri paneelil klippe sortida. Viipa klippi paremale, et see määrata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée des groupes pour trier les clips dans le panneau du clavier. Balaie un clip vers la droite pour l'assigner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozz létre csoportokat, hogy rendezd a vágólap-elemeket a billentyűzet panelén. Húzz egy elemet jobbra a hozzárendeléshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea gruppi per ordinare le clip nel pannello della tastiera. Scorri una clip verso destra per assegnarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループを作るとキーボードパネルのクリップを整理できます。クリップを右にスワイプすると割り当てられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹을 만들어서 키보드 패널의 클립을 정리해보세요. 클립을 오른쪽으로 밀면 그룹에 넣을 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipta kumpulan untuk susun klip dalam panel papan kekunci. Leret klip ke kanan untuk masukkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria grupos para organizar clipes no painel do teclado. Desliza um clipe para a direita para o atribuíres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавайте группы, чтобы разложить фрагменты в панели клавиатуры. Смахните фрагмент вправо, чтобы отнести его к группе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建分组，把键盘面板里的剪贴内容整理好。把剪贴内容向右滑就能分到组里。"
          }
        }
      }
    },
