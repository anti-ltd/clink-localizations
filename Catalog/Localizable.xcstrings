            "state": "translated",
            "value": "Capul deplasat se etichetează singur din acțiune."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verschoven dop labelt zichzelf van de actie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 鍵帽會根據操作自動顯示標籤。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesunięta czapka oznacza się od akcji."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміщена шапка позначає себе від дії."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırılan sınır kendisini eylemden etiketler."
