    "Your profiles and themes stay on this device.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou profiele en temas bly op hierdie toestel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Profile und Themes bleiben auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus perfiles y temas se quedan en este dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu profiilid ja teemad jäävad sellesse seadmesse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos profils et thèmes restent sur cet appareil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiljai és témái ezen az eszközön maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi profili e temi restano su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルとテーマはこのデバイスに留まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필과 테마는 이 기기에 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil dan tema anda kekal pada peranti ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus perfis e temas ficam neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши профили и темы остаются на этом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的配置文件和主题保留在此设备上。"
          }
        }
      }
    },
    "Your profiles and themes travel with your Apple Account.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou profiele en temas reis saam met jou Apple-rekening."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Profile und Themes reisen mit Ihrem Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus perfiles y temas viajan con tu Apple Account."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu profiilid ja teemad reisivad sinu Apple’i kontoga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos profils et thèmes voyagent avec votre Apple Account."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiljai és témái utaznak az Apple Accountjával."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi profili e temi viaggiano con il tuo Apple Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルとテーマは Apple Account に従って移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필과 테마가 Apple Account와 함께 이동합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil dan tema anda bergerak bersama Apple Account anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus perfis e temas viajam com a sua Apple Account."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши профили и темы переносятся вместе с вашим Apple Account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的配置文件和主题随你的 Apple Account 同步。"
          }
        }
      }
    },
    "Your profiles, themes, and clipboard stay on this device. This clears the copies in iCloud and turns sync off.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou profiele, temas en knipbord bly op hierdie toestel. Dit maak die kopieë in iCloud skoon en skakel sinkronisering af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Profile, Themes und die Zwischenablage bleiben auf diesem Gerät. Das hier löscht die Kopien in iCloud und schaltet die Synchronisierung aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus perfiles, temas y portapapeles se quedan en este dispositivo. Esto borra las copias de iCloud y desactiva la sincronización."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu profiilid, teemad ja lõikelaud jäävad sellesse seadmesse. See tühjendab koopiad iCloudist ja lülitab sünkroonimise välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes profils, tes thèmes et ton presse-papiers restent sur cet appareil. Cette action efface les copies dans iCloud et désactive la synchronisation."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A profiljaid, témáid és a vágólapod ezen az eszközön maradnak. Ez az iCloudban lévő másolatokat törli, és kikapcsolja a szinkronizálást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi profili, i temi e gli appunti restano su questo dispositivo. Questa azione cancella le copie su iCloud e disattiva la sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイル、テーマ、クリップボードはこの端末に残ります。iCloud上のコピーを削除し、同期をオフにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필, 테마, 클립보드는 이 기기에 그대로 남습니다. iCloud에 있는 사본을 지우고 동기화를 끕니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, tema dan papan keratan anda kekal pada peranti ini. Tindakan ini memadam salinan dalam iCloud dan mematikan penyegerakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus perfis, temas e área de transferência ficam neste dispositivo. Isto apaga as cópias no iCloud e desliga a sincronização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши профили, темы и буфер обмена остаются на этом устройстве. Это удалит копии в iCloud и выключит синхронизацию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的配置文件、主题和剪贴板都会保留在这台设备上。此操作会清除 iCloud 中的副本并关闭同步。"
          }
        }
      }
    },
    "Your recording visual, shown live. Swipe it to change style.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou opname visueel, regstreeks gewys. Swiep dit om styl te verander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufnahme-Grafik, live. Wisch darüber, um den Stil zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu visual de grabación, en directo. Deslízalo para cambiar de estilo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu salvestuse visuaal, reaalajas. Viipa sellel, et stiili vahetada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton visuel d'enregistrement, en direct. Balaie-le pour changer de style."
          }
        },
        "hu": {
