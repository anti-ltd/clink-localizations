    "How long to hold the key before rapid-delete begins, and how fast it accelerates.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoe lank om die sleutel vas te hou voordat vinnige uitvee begin, en hoe vinnig dit versnel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange du die Taste hältst, bis das Schnelllöschen startet, und wie schnell es beschleunigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
