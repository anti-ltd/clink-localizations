    "No bloom · no lean · firm 0.12s springs. Flattest, most static.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Aufleuchten · keine Neigung · feste 0,12-s-Federn. Am flachsten und statischsten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin brillo · sin inclinación · resortes firmes de 0,12 s. El más plano y estático."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun éclat · aucune inclinaison · ressorts fermes de 0,12 s. Le plus plat et le plus statique."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs duzzadás · nincs dőlés · feszes, 0,12 mp-es rugók. A leglaposabb, legmozdulatlanabb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente bagliore · niente inclinazione · molle rigide da 0,12 s. Il più piatto e statico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブルームなし · 傾きなし · 硬い0.12秒のスプリング。いちばんフラットで動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "블룸 없음 · 기울임 없음 · 단단한 0.12초 스프링. 가장 평평하고 움직임이 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada kembang · tiada condong · spring tegas 0.12s. Paling rata, paling statik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem brilho · sem inclinação · molas firmes de 0,12 s. O mais plano e estático."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без свечения · без наклона · жёсткие пружины 0,12 с. Самый плоский и статичный вариант."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无光晕 · 无倾斜 · 0.12 秒硬弹簧。最平、最静。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomi pole · kallet pole · kindlad 0,12 s vedrud. Kõige lame ja staatilisem."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geen blom · geen maer · ferm 0.12s vere. Platste, mees statiese."
          }
        }
      }
    },
