    "How fully your learned offset is undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark dein gelernter Versatz rückgängig gemacht wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta qué punto se deshace el desplazamiento aprendido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quel point ton décalage appris est annulé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyire teljesen áll vissza a megtanult eltolás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto viene annullato lo scostamento appreso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習した位置ずれをどれだけ元に戻すかです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학습된 보정이 얼마나 되돌려지는지예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejauh mana ofset dipelajari anda dibatalkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até que ponto o desvio aprendido é desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько полно отменяется выученное смещение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把你学到的偏移撤销到什么程度。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui täielikult su õpitud nihe tühistatakse."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoe volledig jou aangeleerde verrekening ongedaan gemaak word."
          }
        }
      }
    },
    "Draw an arrow and spread ellipse per key, showing where your taps tend to land.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnet pro Taste einen Pfeil und eine Streuungsellipse, die zeigen, wo deine Tipper meist landen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja una flecha y una elipse de dispersión por tecla, mostrando dónde suelen caer tus toques."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une flèche et une ellipse d'étalement par touche, montrant où tes appuis atterrissent généralement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Billentyűnként rajzol egy nyilat és egy szórásellipszist, megmutatva, hová esnek általában a koppintásaid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna una freccia e un'ellisse di dispersione per tasto, mostrando dove atterrano di solito i tuoi tocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーに矢印と広がり楕円を描き、タップがどこに着地しがちかを示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키마다 화살표와 분포 타원을 그려 탭이 주로 닿는 위치를 보여 줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukis anak panah dan elips sebaran bagi setiap kekunci, menunjukkan tempat ketikan anda biasanya mendarat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenha uma seta e uma elipse de dispersão por tecla, mostrando onde os teus toques costumam cair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисует стрелку и эллипс разброса для каждой клавиши, показывая, куда обычно попадают нажатия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个按键绘制箭头和扩散椭圆，显示你的点按通常落在哪里。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Joonistab igale klahvile noole ja hajuvusellipsi, näidates, kuhu su vajutused tavaliselt maanduvad."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teken 'n pyl en versprei ellips per sleutel, wat wys waar jou krane geneig is om te land."
          }
        }
      }
    },
