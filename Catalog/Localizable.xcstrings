    "Finger-write letters or a whole line and Clink recognizes it and types the text. Adds a handwriting pad to the panel button.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vinger-skryf letters of 'n hele reël en Clink herken dit en tik die teks. Voeg 'n handskrifblok by die paneelknoppie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe Buchstaben oder eine ganze Zeile mit dem Finger – Clink erkennt sie und tippt den Text. Fügt dem Panel-Button ein Schreibfeld hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe letras o una línea entera con el dedo y Clink la reconoce y teclea el texto. Añade un panel de escritura al botón de paneles."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjuta sõrmega tähti või terve rida ja Clink tunneb ära ning tipib teksti. Lisab paneelinupule käsikirjapadja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris des lettres ou une ligne entière au doigt : Clink les reconnaît et tape le texte. Ajoute un pavé d’écriture au bouton des panneaux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írj betűket vagy egy egész sort ujjal, a Clink felismeri és begépeli a szöveget. Egy kézíró felületet ad a panel gombhoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi lettere o un’intera riga col dito: Clink le riconosce e digita il testo. Aggiunge un’area di scrittura al pulsante dei pannelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字や一行まるごとを指で書くと、Clink が認識して入力します。パネルボタンに手書きパッドを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손가락으로 글자나 한 줄 전체를 쓰면 Clink가 인식해 텍스트로 입력해요. 패널 버튼에 손글씨 패드를 추가합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis huruf atau satu baris penuh dengan jari, dan Clink mengecamnya lalu menaip teksnya. Menambah pad tulisan tangan pada butang panel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve letras ou uma linha inteira com o dedo e o Clink reconhece-as e escreve o texto. Adiciona um bloco de escrita ao botão de painéis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пишите пальцем буквы или целую строку — Clink распознает написанное и наберёт текст. Добавляет площадку для рукописного ввода к кнопке панелей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用手指书写字母或整行文字，Clink 会识别并输入。会在面板按钮中添加手写板。"
          }
        }
      }
    },
