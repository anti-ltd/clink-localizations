    "Stays on this device unless you turn on Learned Words in iCloud Sync.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt auf diesem Gerät, solange du Gelernte Wörter in der iCloud-Synchronisierung nicht einschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda en este dispositivo salvo que actives Palabras aprendidas en la sincronización con iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste sur cet appareil, sauf si tu actives Mots appris dans la synchro iCloud."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen az eszközön marad, hacsak be nem kapcsolod a Tanult szavak elemet az iCloud-szinkronban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta su questo dispositivo, a meno che tu non attivi Parole apprese nella sincronizzazione iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud同期で「学習した単語」をオンにしない限り、この端末から出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화에서 학습된 단어를 켜지 않으면 이 기기에만 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekal pada peranti ini melainkan awak hidupkan Perkataan dipelajari dalam Penyegerakan iCloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica neste dispositivo, a não ser que ligues Palavras aprendidas na sincronização iCloud."
