    "No trail, no ripple. Cleanest.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Spur, keine Welle. Am aufgeräumtesten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin estela, sin onda. El más limpio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune traînée, aucune ondulation. Le plus net."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs nyom, nincs hullám. A legtisztább."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna scia, nessuna onda. Il più pulito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軌跡なし、波紋なし。いちばんすっきり。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔상도 물결도 없어요. 가장 깔끔해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada jejak, tiada riak. Paling bersih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem rasto, sem ondulação. O mais limpo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без следа и без волны. Самый чистый вариант."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无拖尾、无涟漪。最干净。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jälge pole, laineid pole. Puhtaim."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geen spoor, geen rimpeling. Skoonste."
          }
        }
      }
    },
    "No trail. Nothing is drawn while you glide.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Spur. Beim Gleiten wird nichts gezeichnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin rastro. No se dibuja nada mientras deslizas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune traînée. Rien ne s'affiche pendant que tu glisses."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs nyomvonal. Húzás közben semmi nem rajzolódik ki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna scia. Non viene disegnato niente mentre scorri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軌跡なし。スワイプ中は何も描かれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "궤적 없음. 밀어서 입력하는 동안 아무것도 그리지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada jejak. Tiada apa-apa dilukis semasa anda meluncur."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem rasto. Não é desenhado nada enquanto deslizas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без следа. Во время скольжения ничего не рисуется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不显示轨迹。滑动时什么都不画。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jälge pole. Libisemise ajal ei joonistata midagi."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geen spoor nie. Niks word geteken terwyl jy gly nie."
          }
        }
      }
    },
