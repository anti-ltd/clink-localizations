          }
        }
      }
    },
    "Make your keyboard\nyours, everywhere.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teclado, a tu manera.\nEn todas partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton clavier, à ton image.\nPartout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tastatur. Dein Stil.\nÜberall."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua tastiera, a modo tuo.\nOvunque."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu teclado, à sua medida.\nEm todo o lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша клавиатура, ваш стиль.\nВезде."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci mengikut gaya anda.\nDi mana-mana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A te billentyűzeted, a te stílusod.\nMindenhol."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこでも、自分らしい\nキーボードに。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让键盘随处\n都属于你。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서나 나만의\n키보드로."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu klaviatuur, sinu moodi.\nKõikjal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți-vă tastatura\na ta, peste tot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak je toetsenbord\nde jouwe, overal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓鍵盤隨處\n都屬於你。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak jou sleutelbord\r\njoune, oral."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób swoją klawiaturę\r\nTwoje, wszędzie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зробіть свою клавіатуру\r\nтвій, всюди."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyenizi yapın\r\nsenin, her yerde."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyrobte si klávesnici\r\nvaše, všude."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvorte si klávesnicu\r\ntvoj, všade."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φτιάξτε το πληκτρολόγιό σας\r\nδικό σου, παντού."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör ditt tangentbord\r\ndin, överallt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lav dit tastatur\r\ndin, overalt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lag tastaturet ditt\r\ndin, overalt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee näppäimistösi\r\nsinun, kaikkialla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat papan ketik Anda\r\nmilikmu, di mana pun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm bàn phím của bạn\r\ncủa bạn, ở mọi nơi."
          }
        }
      }
    },
    "Making a light, sharp ringing sound.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Que produce un sonido tintineante, ligero y agudo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui produit un son clair et léger de tintement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen hellen, klirrenden Klang erzeugend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Che produce un suono tintinnante, leggero e acuto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que produz um som tilintante, leve e agudo."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghasilkan bunyi denting yang halus dan nyaring."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Könnyed, éles csengő hangot adó."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軽く澄んだ、チリンという音を立てること。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发出轻快清脆的叮当声。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가볍고 맑게 쨍그랑거리는 소리를 내는."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerget ja teravat kõlisevat heli tekitav."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Издающий лёгкий, звонкий звенящий звук."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Emite un sunet ușor și ascuțit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt een licht, scherp belgeluid."
