        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn Clink trong bộ chọn bàn phím. Bạn có thể chuyển lại bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘选择器中选择 Clink。你可以随时切换回去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從鍵盤選擇器中選擇 Clink。你隨時都可以切換回來。"
          }
        }
      }
    },
    "Clink needs your language’s dictionary to suggest and correct words. It works offline once downloaded.": {
      "comment": "Android-only onboarding copy (Android settings terminology). Translations drafted for the Android port; native-speaker review required before release. Add to clink-index.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink het jou taal se woordeboek nodig om woorde voor te stel en reg te stel. Dit werk vanlyn sodra dit afgelaai is."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink potřebuje slovník vašeho jazyka, aby mohl navrhovat a opravovat slova. Po stažení funguje offline."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink skal bruge dit sprogs ordbog for at foreslå og rette ord. Den virker offline, når den er hentet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink braucht das Wörterbuch deiner Sprache, um Wörter vorzuschlagen und zu korrigieren. Nach dem Laden funktioniert es offline."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Clink χρειάζεται το λεξικό της γλώσσας σας για να προτείνει και να διορθώνει λέξεις. Λειτουργεί εκτός σύνδεσης μόλις γίνει λήψη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink necesita el diccionario de tu idioma para sugerir y corregir palabras. Una vez descargado, funciona sin conexión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink vajab sõnade soovitamiseks ja parandamiseks sinu keele sõnastikku. Pärast allalaadimist töötab see võrguühenduseta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink tarvitsee kielesi sanakirjan ehdottaakseen ja korjatakseen sanoja. Se toimii offline-tilassa, kun se on ladattu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink a besoin du dictionnaire de ta langue pour suggérer et corriger les mots. Une fois téléchargé, il fonctionne hors ligne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clinknek szüksége van a nyelved szótárára a szavak javasolásához és javításához. Letöltés után offline is működik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink membutuhkan kamus bahasa Anda untuk menyarankan dan mengoreksi kata. Kamus berfungsi offline setelah diunduh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ha bisogno del dizionario della tua lingua per suggerire e correggere le parole. Una volta scaricato, funziona offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語の候補と修正には、お使いの言語の辞書が必要です。ダウンロード後はオフラインで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink가 단어를 제안하고 교정하려면 사용하는 언어의 사전이 필요합니다. 한 번 다운로드하면 오프라인에서도 작동합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink memerlukan kamus bahasa anda untuk mencadangkan dan membetulkan perkataan. Ia berfungsi luar talian selepas dimuat turun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink trenger ordboken for språket ditt for å foreslå og rette ord. Den virker uten nett når den er lastet ned."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink heeft het woordenboek van je taal nodig om woorden voor te stellen en te verbeteren. Na het downloaden werkt het offline."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink potrzebuje słownika Twojego języka, aby podpowiadać i poprawiać słowa. Po pobraniu działa offline."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink precisa do dicionário do teu idioma para sugerir e corrigir palavras. Depois de descarregado, funciona offline."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink are nevoie de dicționarul limbii tale pentru a sugera și corecta cuvinte. Funcționează offline după descărcare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink нужен словарь вашего языка, чтобы предлагать и исправлять слова. После загрузки он работает без интернета."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink potrebuje slovník vášho jazyka, aby mohol navrhovať a opravovať slová. Po stiahnutí funguje offline."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink behöver ditt språks ordlista för att föreslå och rätta ord. Den fungerar offline när den har laddats ned."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink’in sözcük önerip düzeltebilmesi için dilinizin sözlüğü gerekir. İndirildikten sonra çevrimdışı çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink потрібен словник вашої мови, щоб пропонувати й виправляти слова. Після завантаження він працює офлайн."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink cần từ điển của ngôn ngữ bạn dùng để gợi ý và sửa từ. Sau khi tải về, nó hoạt động ngoại tuyến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 需要你所用语言的词典来推荐和纠正字词。下载后即可离线使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 需要你所用語言的字典才能建議和修正字詞。下載後即可離線使用。"
          }
        }
      }
    },
    "Turn Clink on in Android’s list of on-screen keyboards.": {
      "comment": "Android-only onboarding copy (Android settings terminology). Translations drafted for the Android port; native-speaker review required before release. Add to clink-index.",
