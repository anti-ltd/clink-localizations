          "stringUnit": {
            "state": "translated",
            "value": "Désactive le compagnon, ou choisis-en un autre et place-le dans un autre coin."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold ki a kisállatot, vagy válassz másikat, és tedd át egy másik sarokba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva l'animaletto, oppure scegline un altro e spostalo in un angolo diverso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペットをオフにするか、別のペットを選んで違う隅に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펫을 끄거나, 다른 펫을 골라 다른 구석으로 옮기세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan peliharaan itu, atau pilih yang lain dan alihkannya ke sudut berbeza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga a mascote, ou escolhe outra e muda-a para outro canto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите питомца — или выберите другого и переставьте его в другой угол."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把宠物关掉，或者换一只、挪到别的角落。"
          }
        }
      }
    },
    "Turn typing analytics on or off": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel tikanalise aan of af"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipppanalysen ein- oder ausschalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva las estadísticas de escritura"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita trükkimisanalüüs sisse või välja"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez ou désactivez les statistiques de saisie"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gépelési elemzések be- vagy kikapcsolása"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva o disattiva le analisi di digitazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力分析のオン／オフ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 분석 켜기 또는 끄기"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan atau matikan analitik penaipan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa ou desativa as estatísticas de escrita"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить или выключить аналитику ввода"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启或关闭输入分析"
          }
        }
      }
    },
    "Turns off the backdrop and animation, and clears the selected style.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel die agtergrond en animasie af en maak die geselekteerde styl skoon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet Hintergrund und Animation aus und entfernt den ausgewählten Stil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva el fondo y la animación, y borra el estilo seleccionado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülitab tausta ja animatsiooni välja ning tühjendab valitud stiili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive l'arrière-plan et l'animation, et efface le style sélectionné."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikapcsolja a hátteret és az animációt, és törli a kiválasztott stílust."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva lo sfondo e l'animazione e cancella lo stile selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景とアニメーションをオフにし、選択したスタイルをクリアします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경과 애니메이션을 끄고 선택한 스타일을 지웁니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mematikan latar belakang dan animasi, serta mengosongkan gaya yang dipilih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativa o fundo e a animação e limpa o estilo selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключает фон и анимацию и очищает выбранный стиль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭背景和动画，并清除所选样式。"
          }
        }
      }
    },
    "Turns on the on-device smarts behind smarter suggestions and translation. Nothing works until you flip this.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel die slimfone op die toestel aan agter slimmer voorstelle en vertaling. Niks werk totdat jy dit omdraai nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet die Intelligenz auf dem Gerät ein, die hinter cleveren Vorschlägen und dem Übersetzen steckt. Nichts läuft, bevor du das anmachst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la inteligencia en el dispositivo que hay detrás de las sugerencias y la traducción más listas. Nada funciona hasta que actives esto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülitab sisse seadmesisesed nutikused nutikamate soovituste ja tõlke taga. Midagi ei tööta, enne kui sa seda lülitad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active l'intelligence sur l'appareil derrière des suggestions et une traduction plus malines. Rien ne marche tant que tu n'as pas activé ça."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolja az eszközön futó okos funkciókat, amik az okosabb javaslatok és a fordítás mögött állnak. Semmi sem működik, amíg ezt be nem kapcsolod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l'intelligenza sul dispositivo dietro suggerimenti e traduzione più intelligenti. Niente funziona finché non la attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よりスマートな候補や翻訳を支える、オンデバイスの知能をオンにします。これをオンにするまで何も動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 똑똑한 추천이랑 번역을 뒷받침하는 온디바이스 지능을 켜요. 이걸 켜기 전에는 아무것도 작동하지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghidupkan kepintaran atas-peranti di sebalik cadangan dan terjemahan yang lebih pintar. Tiada apa berfungsi sehingga anda menghidupkan ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga a inteligência no dispositivo por trás de sugestões e tradução mais espertas. Nada funciona até ligares isto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает работающий на устройстве интеллект, на котором держатся умные подсказки и перевод. Пока это выключено, ничего из них не работает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设备端的智能功能，更聪明的建议和翻译都靠它。不开的话这些都用不了。"
          }
        }
      }
    },
    "Tweak the key size, the bounce, the sounds, the haptics. Or don't. It works great as-is.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pas die sleutelgrootte, die weiering, die klanke, die haptika aan. Of moenie. Dit werk uitstekend soos dit is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell die Tastengröße, das Abprallen, die Töne, die Haptik ein. Oder lass es – es funktioniert auch so super."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el tamaño de las teclas, el rebote, los sonidos, la vibración. O no lo hagas: funciona genial tal cual."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Näpi klahvi suurust, põrget, helisid, haptikat. Või ära näpi. See töötab suurepäraselt nii nagu on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste la taille des touches, le rebond, les sons, le retour haptique. Ou pas — ça marche très bien tel quel."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítgasd a billentyűméretet, a pattanást, a hangokat, a rezgést. Vagy ne – így is remekül működik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola la dimensione dei tasti, il rimbalzo, i suoni, il feedback aptico. Oppure no — funziona benissimo così com'è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの大きさ、跳ね具合、サウンド、触覚フィードバックを調整できます。もちろんそのままでも十分に使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 크기, 바운스, 소리, 햅틱을 손봐요. 아니면 그냥 둬도 돼요 — 기본으로도 훌륭해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah suai saiz kekunci, lantunan, bunyi, haptik. Atau tidak — ia berfungsi hebat seadanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta o tamanho das teclas, o ressalto, os sons, a vibração. Ou não — funciona lindamente como está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подкрутите размер клавиш, отскок, звуки, тактильную отдачу. Или не подкручивайте — и так отлично работает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调调按键大小、回弹、声音、触感。不调也行——它开箱就很好用。"
          }
        }
      }
    },
