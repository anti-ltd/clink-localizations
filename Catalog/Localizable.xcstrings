    "Lighting borrows a color your theme already uses, so the theme still looks like itself.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beligting leen 'n kleur wat jou tema reeds gebruik, so die tema lyk steeds soos homself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beleuchtung leiht sich eine Farbe, die dein Theme schon nutzt – so bleibt es sich selbst treu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La iluminación toma un color que ya usa tu tema, así el tema sigue siendo el mismo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgustus laenab värvi, mida sinu teema juba kasutab, nii et teema näeb ikka välja nagu ise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’éclairage reprend une couleur de ton thème pour en garder le style."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megvilágítás a téma egyik meglévő színét használja, így a téma önmaga marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'illuminazione prende in prestito un colore già usato dal tema, così il tema resta sé stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマがすでに使っている色を借りるので、テーマの印象はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마가 이미 쓰는 색을 빌려 오므로 테마는 그대로 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencahayaan meminjam warna yang sudah digunakan tema anda, jadi tema kekal seperti asalnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A iluminação empresta uma cor que o teu tema já usa, para o tema continuar a ser ele mesmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсветка берёт цвет, который ваша тема уже использует, так что тема остаётся сама собой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯光沿用主题已有的颜色，主题依旧是它本来的样子。"
          }
        }
      }
    },
    "Lighting borrows a colour your theme already uses, so the theme still looks like itself.": {
      "extractionState": "manual",
