    "No way in yet. Switch on the Tools button, or add a Tools key to your layout.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Zugang. Aktiviere die Werkzeug-Taste in der Leiste oder füge deinem Layout eine Werkzeug-Taste hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso: activa el botón de herramientas o añade una tecla de herramientas a tu diseño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun accès pour l’instant. Active le bouton Outils ou ajoute une touche Outils à ta disposition."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyelőre nincs bejárat. Kapcsold be az Eszközök gombot, vagy tegyél egy Eszközök gombot az elrendezésedbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso: attiva il pulsante Strumenti o aggiungi un tasto Strumenti al tuo layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開く手段がありません。ツールボタンをオンにするか、レイアウトにツールキーを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들어갈 방법이 없습니다. 도구 버튼을 켜거나 레이아웃에 도구 키를 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada cara masuk. Hidupkan butang Alatan, atau tambah kekunci Alatan pada susun atur anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem forma de entrar. Ative o botão de ferramentas ou adicione uma tecla de ferramentas ao seu esquema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет способа туда попасть. Включите кнопку инструментов или добавьте клавишу инструментов в раскладку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有入口。请打开工具按钮，或在布局中添加一个工具键。"
          }
        },
        "et": {
          "stringUnit": {
