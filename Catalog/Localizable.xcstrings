    "Correction stays off until a key shows a bias that beats its own spread.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La corrección permanece desactivada hasta que el desplazamiento habitual de una tecla supera la dispersión de sus toques."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La correction reste désactivée tant que le décalage habituel d’une touche ne dépasse pas la dispersion de ses appuis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Korrektur bleibt aus, bis die systematische Abweichung einer Taste größer ist als die Streuung ihrer Berührungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La correzione resta disattivata finché lo scostamento abituale di un tasto non supera la dispersione dei suoi tocchi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A correção permanece desligada até o desvio habitual de uma tecla superar a dispersão dos toques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коррекция отключена, пока систематическое смещение нажатий на клавишу не превысит их разброс."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembetulan kekal dimatikan sehingga sisihan tetap kekunci melebihi sebaran sentuhannya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A javítás addig kikapcsolva marad, amíg egy billentyű következetes eltérése nem haladja meg az érintéseinek szórását."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーのタップ位置の偏りがばらつきを上回るまで、補正は行われません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有按键触点的固定偏移超过其分散程度，才会启用纠正。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키의 일정한 치우침이 터치 위치의 흩어짐보다 커질 때까지 보정하지 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Parandus jääb välja lülitatuks, kuni klahvi püsiv kõrvalekalle ületab puudutuste hajuvuse."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Corecția rămâne dezactivată până când o cheie arată o părtinire care își bate propria răspândire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De correctie blijft uit totdat een sleutel een bias vertoont die groter is dan zijn eigen spread."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有按鍵觸點的固定偏移超過其分散程度，才會啟用糾正。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Korreksie bly af totdat 'n sleutel 'n vooroordeel toon wat sy eie verspreiding oortref."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korekta pozostaje wyłączona, dopóki klucz nie wykaże odchylenia przewyższającego własny spread."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Корекція залишається вимкненою, доки ключ не покаже зміщення, яке перевищує його власний розкид."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir anahtar kendi yayılımını aşan bir eğilim gösterene kadar düzeltme kapalı kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Korekce zůstane vypnutá, dokud klíč neukáže odchylku, která překoná její vlastní šíření."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Korekcia zostane vypnutá, kým kľúč neukáže odchýlku, ktorá prekoná svoj vlastný rozptyl."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διόρθωση παραμένει απενεργοποιημένη έως ότου ένα κλειδί εμφανίσει μια προκατάληψη που ξεπερνά τη δική του εξάπλωση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigeringen förblir avstängd tills en nyckel visar en bias som slår sin egen spridning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrektion forbliver slukket, indtil en nøgle viser en bias, der slår sin egen spredning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Korreksjon forblir av til en nøkkel viser en skjevhet som slår sin egen spredning."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korjaus pysyy pois päältä, kunnes näppäin näyttää harhaa, joka voittaa sen oman leviämisen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koreksi tidak akan terjadi sampai suatu kunci menunjukkan bias yang mengalahkan spreadnya sendiri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc điều chỉnh sẽ dừng lại cho đến khi một khóa thể hiện độ lệch vượt quá mức chênh lệch của chính nó."
          }
        }
      }
    },
