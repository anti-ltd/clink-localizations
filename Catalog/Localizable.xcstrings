          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el teclado, ábrelo desde el menú de herramientas y toca un efecto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava see klaviatuuri tööriistamenüüst ja puuduta soovitud efekti."
          }
        },
        "fr": {
