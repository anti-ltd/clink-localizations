            "value": "Satu warna stabil di setiap tombol."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một màu ổn định trên mỗi phím."
          }
        }
      }
    },
    "One sweep. One word. Two thumbs.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Een sweep. Een woord. Twee duime."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wisch. Ein Wort. Zwei Daumen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un desliz. Una palabra. Dos pulgares."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üks pühk. Üks sõna. Kaks pöialt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un balayage. Un mot. Deux pouces."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy húzás. Egy szó. Két hüvelykujj."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gesto. Una parola. Due pollici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとスワイプ。ひとつの言葉。両方の親指。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 스와이프. 한 단어. 두 엄지."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu leret. Satu perkataan. Dua ibu jari."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um deslize. Uma palavra. Dois polegares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один взмах. Одно слово. Два больших пальца."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次滑动。一个词。两枚拇指。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O singură măturare. Un cuvânt. Două degete mari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén veegbeweging. Eén woord. Twee duimen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次滑動。一個詞。兩枚拇指。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno przeciągnięcie. Jedno słowo. Dwa kciuki."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один розмах. Одне слово. Два великих пальця."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tarama. Tek kelime. İki başparmak."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden zátah. Jedno slovo. Dva palce."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno zametanie. Jedno slovo. Dva palce."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα σκούπισμα. Μια λέξη. Δύο αντίχειρες."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett svep. Ett ord. Två tummar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et slag. Et ord. To tommelfingre."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett sveip. Ett ord. To tomler."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi pyyhkäisy. Yksi sana. Kaksi peukkua."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu sapuan. Satu kata. Dua jempol."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần quét. Một từ. Hai ngón tay cái."
          }
        }
      }
    },
    "One tap recolors the whole keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tik herkleur die hele sleutelbord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipp färbt die ganze Tastatur neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque recolorea todo el teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühe puudutusega värvad ümber kogu klaviatuuri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul geste recolore tout le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy koppintás átszínezi az egész billentyűzetet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco ricolora l’intera tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップでキーボード全体の色が変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 탭으로 키보드 전체 색상이 바뀝니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu ketikan mewarnakan semula seluruh papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque recolore o teclado inteiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно нажатие перекрашивает всю клавиатуру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一下即可为整个键盘重新配色。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O singură atingere recolorează întreaga tastatură."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met één tik wordt het hele toetsenbord opnieuw gekleurd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點一下即可為整個鍵盤重新配色。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno dotknięcie zmienia kolor całej klawiatury."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перефарбуйте всю клавіатуру одним дотиком."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek dokunuşla tüm klavye yeniden renklendirilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedním klepnutím přebarvíte celou klávesnici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedným klepnutím prefarbíte celú klávesnicu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα πάτημα επαναχρωματίζει ολόκληρο το πληκτρολόγιο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett tryck färgar om hela tangentbordet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et tryk omfarver hele tastaturet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett trykk omfarger hele tastaturet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi napautus värittää koko näppäimistön uudelleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu ketukan akan mewarnai ulang seluruh keyboard."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần nhấn sẽ đổi màu toàn bộ bàn phím."
          }
        }
      }
    },
