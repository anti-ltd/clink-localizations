    "This style only lights up when you press a key, so it never runs while you're not typing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Stil leuchtet nur beim Tippen auf und läuft nie, wenn du nicht schreibst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este estilo solo se ilumina al pulsar una tecla, así que nunca funciona si no escribes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See stiil süttib ainult klahvi vajutamisel, nii et see ei tööta kunagi, kui sa ei kirjuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce style ne s’allume que lorsque vous appuyez sur une touche : il ne tourne jamais quand vous ne tapez pas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a stílus csak billentyűnyomásra világít, így gépelés nélkül sosem fut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo stile si illumina solo quando premi un tasto, quindi non è mai attivo mentre non scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスタイルはキーを押したときだけ光るので、入力していない間は動作しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스타일은 키를 누를 때만 켜져서, 입력하지 않을 때는 작동하지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaya ini hanya menyala apabila anda menekan kekunci, jadi ia tidak berjalan semasa anda tidak menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este estilo só acende quando carregas numa tecla, por isso nunca funciona enquanto não escreves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот стиль загорается только при нажатии клавиш, поэтому не работает, пока вы не печатаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此样式只在按键时亮起，所以不打字时从不运行。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest stil se aprinde numai atunci când apăsați o tastă, așa că nu rulează niciodată când nu scrieți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze stijl licht alleen op als je op een toets drukt en wordt dus nooit uitgevoerd terwijl je niet aan het typen bent."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此樣式只在按鍵時亮起，所以不打字時從不執行。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie styl lig slegs op wanneer jy 'n sleutel druk; dit loop dus nooit terwyl jy nie tik nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten styl podświetla się tylko po naciśnięciu klawisza, więc nigdy nie jest uruchamiany, gdy nie piszesz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей стиль підсвічується лише тоді, коли ви натискаєте клавішу, тому він ніколи не запускається, поки ви не друкуєте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu stil yalnızca bir tuşa bastığınızda yanar, dolayısıyla siz yazmadığınız sürece asla çalışmaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento styl se rozsvítí pouze při stisknutí klávesy, takže se nikdy nespustí, když nepíšete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento štýl sa rozsvieti iba pri stlačení klávesu, takže sa nikdy nespustí, keď nepíšete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το στυλ ανάβει μόνο όταν πατάτε ένα πλήκτρο, επομένως δεν εκτελείται ποτέ όταν δεν πληκτρολογείτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här stilen tänds bara när du trycker på en tangent, så den körs aldrig medan du inte skriver."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne stil lyser kun op, når du trykker på en tast, så den kører aldrig, mens du ikke skriver."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne stilen lyser bare når du trykker på en tast, så den kjører aldri mens du ikke skriver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tyyli syttyy vain, kun painat näppäintä, joten se ei koskaan toimi, kun et kirjoita."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaya ini hanya menyala ketika Anda menekan tombol, sehingga tidak pernah berjalan saat Anda tidak mengetik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểu này chỉ sáng lên khi bạn nhấn một phím nên nó không bao giờ chạy khi bạn không gõ."
          }
        }
      }
    },
    "This theme is too detailed to fit in one QR code. Export its theme file instead.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie tema is te gedetailleerd vir een QR-kode. Voer eerder die temalêer uit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Theme ist zu detailliert für einen einzelnen QR-Code. Exportiere stattdessen die Theme-Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tema es demasiado detallado para un solo código QR. Exporta su archivo de tema."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See teema on ühe QR-koodi jaoks liiga üksikasjalik. Ekspordi selle asemel teemafail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce thème est trop détaillé pour tenir dans un seul code QR. Exportez plutôt son fichier de thème."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह थीम एक QR कोड में समाने के लिए बहुत विस्तृत है। इसके बजाय थीम फ़ाइल निर्यात करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a téma túl részletes ahhoz, hogy egy QR-kódba beleférjen. Exportáld inkább a témafájlt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo tema è troppo dettagliato per un solo codice QR. Esporta invece il file del tema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテーマは詳細すぎて1つのQRコードに収まりません。代わりにテーマファイルを書き出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 테마는 하나의 QR 코드에 담기에는 너무 상세합니다. 대신 테마 파일을 내보내세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema ini terlalu terperinci untuk dimuatkan dalam satu kod QR. Eksport fail tema sebagai ganti."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो थिम एउटै QR कोडमा अटाउन धेरै विस्तृत छ। यसको सट्टा थिम फाइल निर्यात गर्नुहोस्।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tema tem demasiados detalhes para caber num só código QR. Exporte o ficheiro do tema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта тема слишком подробная, чтобы поместиться в одном QR-коде. Экспортируйте файл темы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tema tek bir QR koduna sığmayacak kadar ayrıntılı. Bunun yerine tema dosyasını dışa aktarın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此主题内容过多，无法放入一个二维码。请改为导出主题文件。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această temă este prea detaliată pentru a se potrivi într-un singur cod QR. În schimb, exportați fișierul temă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit thema is te gedetailleerd om in één QR-code te passen. Exporteer in plaats daarvan het themabestand."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此主題內容過多，無法放入一個二維碼。請改為匯出主題檔案。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten motyw jest zbyt szczegółowy, aby zmieścić się w jednym kodzie QR. Zamiast tego wyeksportuj plik motywu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця тема занадто деталізована, щоб поміститися в один QR-код. Натомість експортуйте його файл теми."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto téma je příliš podrobné na to, aby se vešlo do jednoho QR kódu. Místo toho exportujte jeho soubor motivu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto téma je príliš podrobná na to, aby sa zmestila do jedného QR kódu. Namiesto toho exportujte jeho súbor témy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το θέμα είναι πολύ λεπτομερές για να χωρέσει σε έναν κωδικό QR. Αντ' αυτού, εξάγετε το αρχείο θέματός του."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här temat är för detaljerat för att få plats i en QR-kod. Exportera dess temafil istället."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette tema er for detaljeret til at passe ind i én QR-kode. Eksporter dens temafil i stedet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette temaet er for detaljert til å passe inn i én QR-kode. Eksporter temafilen i stedet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä teema on liian yksityiskohtainen mahtumaan yhteen QR-koodiin. Vie sen sijaan sen teematiedosto."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema ini terlalu detail untuk dimasukkan dalam satu kode QR. Ekspor file temanya sebagai gantinya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ đề này quá chi tiết để có thể nhét vừa một mã QR. Thay vào đó hãy xuất tệp chủ đề của nó."
          }
        }
      }
    },
    "This theme uses multiple QR codes. Scan or import every image to receive the complete theme.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This theme uses multiple QR codes. Scan or import every image to receive the complete theme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tema usa varios códigos QR. Escanea o importa todas las imágenes para recibir el tema completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce thème utilise plusieurs codes QR. Scanne ou importe toutes les images pour recevoir le thème complet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Design verwendet mehrere QR-Codes. Scanne oder importiere alle Bilder, um das vollständige Design zu erhalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo tema usa più codici QR. Scansiona o importa tutte le immagini per ricevere il tema completo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tema usa vários códigos QR. Lê ou importa todas as imagens para receberes o tema completo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этой темы нужно несколько QR-кодов. Отсканируйте или импортируйте все изображения, чтобы получить тему целиком."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema ini menggunakan beberapa kod QR. Imbas atau import semua imej untuk mendapatkan tema yang lengkap."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a téma több QR-kódból áll. A teljes téma átvételéhez olvasd be vagy importáld az összes képet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテーマは複数のQRコードに分かれています。テーマ全体を受け取るには、すべての画像をスキャンまたは読み込んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此主题包含多个二维码。请扫描或导入所有图片，以获取完整主题。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 테마는 여러 QR 코드로 나뉘어 있습니다. 전체 테마를 받으려면 모든 이미지를 스캔하거나 가져오세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See teema kasutab mitut QR-koodi. Terve teema saamiseks skanni või impordi kõik pildid."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această temă folosește mai multe coduri QR. Scanați sau importați fiecare imagine pentru a primi tema completă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit thema maakt gebruik van meerdere QR-codes. Scan of importeer elke afbeelding om het volledige thema te ontvangen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此主題包含多個二維碼。請掃描或匯入所有圖片，以獲取完整主題。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie tema gebruik verskeie QR-kodes. Skandeer of invoer elke prent om die volledige tema te kry."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym motywie zastosowano wiele kodów QR. Zeskanuj lub zaimportuj każdy obraz, aby otrzymać kompletny motyw."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця тема використовує кілька QR-кодів. Відскануйте або імпортуйте кожне зображення, щоб отримати повну тему."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tema birden fazla QR kodu kullanır. Temanın tamamını almak için her görüntüyü tarayın veya içe aktarın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto téma používá více QR kódů. Naskenujte nebo importujte každý obrázek, abyste získali kompletní motiv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto téma používa viacero QR kódov. Naskenujte alebo importujte každý obrázok, aby ste získali úplný motív."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το θέμα χρησιμοποιεί πολλαπλούς κωδικούς QR. Σαρώστε ή εισαγάγετε κάθε εικόνα για να λάβετε το πλήρες θέμα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tema använder flera QR-koder. Skanna eller importera varje bild för att få hela temat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette tema bruger flere QR-koder. Scan eller importer hvert billede for at modtage det komplette tema."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette temaet bruker flere QR-koder. Skann eller importer hvert bilde for å motta hele temaet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä teema käyttää useita QR-koodeja. Skannaa tai tuo jokainen kuva saadaksesi täydellisen teeman."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema ini menggunakan beberapa kode QR. Pindai atau impor setiap gambar untuk menerima tema lengkap."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ đề này sử dụng nhiều mã QR. Quét hoặc nhập từng hình ảnh để nhận chủ đề hoàn chỉnh."
          }
        }
      }
    },
    "This will overwrite all your current settings. Your themes are kept.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit sal al jou huidige instellings oorskryf. Jou temas word behou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit werden alle deine aktuellen Einstellungen überschrieben. Deine Designs bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sobrescribirá toda tu configuración actual. Tus temas se mantienen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See kirjutab kõik sinu praegused seaded üle. Sinu teemad jäävad alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça va écraser tous tes réglages actuels. Tes thèmes sont gardés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez felülír minden mostani beállítást. A témáid megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così sovrascrivi tutte le tue impostazioni attuali. I tuoi temi restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今の設定はすべて上書きされます。テーマはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 설정이 전부 덮어써져요. 테마는 그대로 남아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menulis ganti semua tetapan semasa anda. Tema anda dikekalkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto vai substituir todas as tuas definições atuais. Os teus temas ficam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это перезапишет все текущие настройки. Темы останутся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会覆盖你当前的所有设置。主题会保留下来。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest lucru va suprascrie toate setările dvs. actuale. Temele tale sunt păstrate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden al uw huidige instellingen overschreven. Je thema's blijven behouden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會覆蓋你當前的所有設定。主題會保留下來。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to zastąpienie wszystkich bieżących ustawień. Twoje motywy zostaną zachowane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це перезапише всі ваші поточні налаштування. Ваші теми збережено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, mevcut tüm ayarlarınızın üzerine yazacaktır. Temalarınız korunur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím přepíšete všechna vaše aktuální nastavení. Vaše témata jsou zachována."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tým sa prepíšu všetky vaše aktuálne nastavenia. Vaše témy sú zachované."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα αντικαταστήσει όλες τις τρέχουσες ρυθμίσεις σας. Τα θέματά σας διατηρούνται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta kommer att skriva över alla dina nuvarande inställningar. Dina teman behålls."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil overskrive alle dine nuværende indstillinger. Dine temaer bevares."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil overskrive alle gjeldende innstillinger. Temaene dine beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä korvaa kaikki nykyiset asetuksesi. Teemasi säilytetään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menimpa semua pengaturan Anda saat ini. Tema Anda disimpan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều này sẽ ghi đè lên tất cả các cài đặt hiện tại của bạn. Chủ đề của bạn được lưu giữ."
          }
        }
      }
    },
    "Those are three separate switches, so you can drop the one that's bothering you and keep the rest.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is drie afsonderlike skakelaars, so jy kan die een wat jou pla laat val en die res hou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind drei getrennte Schalter — du kannst also genau den abschalten, der stört, und den Rest behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son tres interruptores distintos, así que puedes quitar el que te molesta y dejar los demás."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Need on kolm eraldi lülitit, seega saad tülitava välja jätta ja ülejäänud hoida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont trois interrupteurs distincts : tu peux couper celui qui te gêne et garder les autres."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez három külön kapcsoló, így pont azt kapcsolhatod ki, amelyik zavar, a többi maradhat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono tre interruttori separati: puoi togliere quello che ti dà fastidio e tenere gli altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは3つの別々のスイッチなので、気になるものだけをオフにして、ほかは残せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각각 다른 스위치 세 개라서, 거슬리는 것만 끄고 나머지는 그대로 둘 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu tiga suis berasingan, jadi anda boleh matikan yang mengganggu dan kekalkan yang lain."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "São três interruptores diferentes, por isso podes desligar o que te incomoda e manter os outros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это три отдельных переключателя, так что можно убрать тот, который мешает, и оставить остальные."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是三个独立开关，可以只关掉烦人的那个，其余照旧。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acestea sunt trei comutatoare separate, așa că îl puteți renunța pe cel care vă deranjează și păstrați restul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat zijn drie afzonderlijke schakelaars, dus je kunt degene die je hindert laten vallen en de rest behouden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是三個獨立開關，可以只關掉煩人的那個，其餘照舊。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To trzy osobne przełączniki, więc możesz odrzucić ten, który Ci przeszkadza i zachować resztę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це три окремі перемикачі, тому ви можете відкинути той, який вас турбує, і залишити решту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar üç ayrı anahtardır, böylece sizi rahatsız edeni bırakıp gerisini saklayabilirsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jsou to tři samostatné přepínače, takže ten, který vás obtěžuje, můžete zahodit a zbytek si ponechat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sú to tri samostatné prepínače, takže ten, ktorý vás obťažuje, môžete zahodiť a zvyšok si ponechať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτοί είναι τρεις ξεχωριστοί διακόπτες, ώστε να μπορείτε να ρίξετε αυτόν που σας ενοχλεί και να κρατήσετε τους υπόλοιπους."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är tre separata omkopplare, så du kan släppa den som stör dig och behålla resten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er tre separate kontakter, så du kan slippe den, der generer dig, og beholde resten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er tre separate brytere, så du kan slippe den som plager deg og beholde resten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä ovat kolme erillistä kytkintä, joten voit pudottaa sinua häiritsevän ja pitää loput."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu adalah tiga saklar terpisah, jadi Anda dapat membuang salah satu yang mengganggu Anda dan menyimpan sisanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là ba công tắc riêng biệt, vì vậy bạn có thể bỏ công tắc đang làm phiền mình và giữ lại công tắc còn lại."
          }
        }
      }
    },
    "Three steps, and then you can type with it anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Drie stappe, en dan kan jy enige plek daarmee tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Schritte, danach tippst du überall damit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres pasos y ya puedes escribir con él en cualquier sitio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolm sammu ja seejärel saad sellega kõikjal tipida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois étapes, et tu écris avec partout."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Három lépés, és bárhol vele gépelhetsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre passaggi e poi scrivi con Clink ovunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3ステップで、どのアプリでも使えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 단계면 어디서든 쓸 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiga langkah, kemudian anda boleh menaip dengannya di mana-mana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Três passos e passas a escrever com ele em todo o lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три шага — и можно печатать где угодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三步就能在任何地方用它打字。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trei pași și apoi puteți scrie oriunde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drie stappen, en dan kun je er overal mee typen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三步就能在任何地方用它打字。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzy kroki, a potem możesz pisać w dowolnym miejscu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Три кроки, а потім ви зможете друкувати з ним будь-де."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç adımdan sonra istediğiniz yere yazabilirsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tři kroky a pak s ním můžete psát kdekoli."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tri kroky a potom s ním môžete písať kdekoľvek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τρία βήματα και, στη συνέχεια, μπορείτε να πληκτρολογήσετε με αυτό οπουδήποτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre steg, och sedan kan du skriva med den var som helst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre trin, og så kan du skrive med den hvor som helst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre trinn, og så kan du skrive med den hvor som helst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolme vaihetta, ja sitten voit kirjoittaa sillä missä tahansa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiga langkah, lalu Anda dapat mengetikkannya di mana saja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba bước và sau đó bạn có thể gõ bằng nó ở bất cứ đâu."
          }
        }
      }
    },
    "Tidy up what I say and use British spelling.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak netjies wat ek sê en gebruik Britse spelling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring das Gesagte in Form und verwende britische Schreibweise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena lo que digo y usa ortografía británica."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrasta, mida ma ütlen, ja kasuta briti õigekirja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mets de l'ordre dans ce que je dis et utilise l'orthographe britannique."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozd rendbe, amit mondok, és használj brit helyesírást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema quello che dico e usa l'ortografia britannica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容を整えて、イギリス式のつづりにして。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 말한 내용을 다듬고 영국식 철자를 써 줘."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemaskan apa yang saya sebut dan guna ejaan British."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arruma o que digo e usa a ortografia britânica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привести сказанное в порядок и использовать британское написание."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把我说的整理一下，并使用英式拼写。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îngrijește ceea ce spun și folosește ortografia britanică."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruim op wat ik zeg en gebruik de Britse spelling."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把我說的整理一下，並使用英式拼寫。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporządkuj to, co mówię i używaj brytyjskiej pisowni."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Упорядкуйте те, що я говорю, і використовуйте британську орфографію."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Söylediklerimi toparla ve İngiliz yazımını kullan."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukliďte si, co říkám, a používejte britský pravopis."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Urobte poriadok v tom, čo hovorím, a používajte britský pravopis."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τακτοποιήστε αυτά που λέω και χρησιμοποιήστε βρετανική ορθογραφία."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Städa till vad jag säger och använd brittisk stavning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryd op i, hvad jeg siger, og brug britisk stavning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rydd i det jeg sier og bruk britisk stavemåte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selvitä sanani ja käytä brittiläistä oikeinkirjoitusta."
          }
        },
        "id": {
