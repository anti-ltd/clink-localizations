    "Its words join a language you already type in. Nothing is replaced.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sy woorde sluit aan by 'n taal wat jy reeds intik. Niks word vervang nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Wörter kommen zu einer Sprache dazu, die du schon tippst. Es wird nichts ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus palabras se suman a un idioma que ya usas. No se sustituye nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle sõnad ühinevad keelega, mida sa juba tipid. Midagi ei asendata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses mots s’ajoutent à une langue que tu utilises déjà. Rien n’est remplacé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szavai egy már használt nyelvhez adódnak hozzá. Semmi nem cserélődik le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue parole si aggiungono a una lingua che già usi. Non viene sostituito nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに使っている言語に語彙が加わります。置き換えは起きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 쓰고 있는 언어에 단어가 더해집니다. 대체되는 것은 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataannya ditambah pada bahasa yang anda sudah guna. Tiada apa-apa yang diganti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras juntam-se a um idioma que já usas. Nada é substituído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его слова добавятся к языку, на котором вы уже печатаете. Ничего не заменяется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些词会加入你已经在用的语言，不会替换任何内容。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuvintele sale se alătură unei limbi în care tastați deja. Nimic nu este înlocuit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De woorden sluiten zich aan bij een taal waarin u al typt. Er wordt niets vervangen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些詞會加入你已經在用的語言，不會替換任何內容。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego słowa dołączają do języka, w którym już piszesz. Nic nie jest zastępowane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його слова приєднуються до мови, якою ви вже вводите текст. Ніщо не замінюється."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelimeleri zaten yazdığınız dile katılır. Hiçbir şey değiştirilmez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho slova se připojují k jazyku, který již zadáváte. Nic není nahrazeno."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho slová sa pripájajú k jazyku, ktorý už zadávate. Nič sa nenahrádza."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λέξεις του ενώνονται με μια γλώσσα που ήδη πληκτρολογείτε. Τίποτα δεν αντικαθίσταται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dess ord ansluter till ett språk du redan skriver i. Ingenting ersätts."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dens ord slutter sig til et sprog, du allerede skriver i. Intet erstattes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordene slutter seg til et språk du allerede skriver i. Ingenting erstattes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen sanat liittyvät jo kirjoittamaasi kieleen. Mitään ei korvata."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata-katanya bergabung dengan bahasa yang Anda ketik. Tidak ada yang diganti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các từ của nó tham gia vào ngôn ngữ bạn đã nhập. Không có gì được thay thế."
          }
        }
      }
    },
