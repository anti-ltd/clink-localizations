          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink menulis huruf besar dan menambah tanda baca sendiri"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink põe maiúsculas e pontuação sozinho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink сам расставляет заглавные буквы и знаки препинания"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 会自己大写、自己加标点"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kirjutab suure algustähe ja lisab kirjavahemärgid iseseisvalt"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink kapitaliseer en voeg leestekens op sy eie by"
          }
        }
      }
    },
    "Clink checks every language on your list as you type, so two languages can share a sentence without you switching.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink prüft beim Tippen jede Sprache deiner Liste, zwei Sprachen können sich also einen Satz teilen, ohne dass du umschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink comprueba todos los idiomas de tu lista mientras escribes, así que dos idiomas pueden compartir una frase sin que cambies de teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink vérifie chaque langue de ta liste pendant que tu écris : deux langues peuvent partager une phrase sans que tu bascules."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink gépelés közben a listád minden nyelvét figyeli, így két nyelv megoszthat egy mondatot anélkül, hogy váltanál."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink controlla ogni lingua del tuo elenco mentre scrivi, così due lingue possono condividere una frase senza che tu cambi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkは入力中にリスト内のすべての言語を照合するので、切り替えなくても2つの言語が同じ文に混ざって大丈夫です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink은 입력하는 동안 목록의 모든 언어를 확인하므로, 전환하지 않아도 두 언어가 한 문장에 섞일 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink menyemak setiap bahasa dalam senarai anda semasa menaip, jadi dua bahasa boleh berkongsi satu ayat tanpa anda bertukar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink verifica todos os idiomas da tua lista enquanto escreves, por isso dois idiomas podem partilhar uma frase sem trocares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink проверяет все языки из вашего списка по ходу печати, так что два языка могут уживаться в одном предложении без переключения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打字时 Clink 会校对列表里的每一种语言，所以两种语言可以共处一句，不用切换。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kontrollib tipimise käigus igat sinu loendis olevat keelt, nii et kaks keelt saavad lauses jagada ilma, et sa lülitaksid."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink kontroleer elke taal op jou lys terwyl jy tik, so twee tale kan 'n sin deel sonder dat jy oorskakel."
          }
        }
      }
    },
    "Clink couldn’t reach its storage to save that dictionary.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink konnte seinen Speicher nicht erreichen, um das Wörterbuch zu sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink no pudo acceder a su almacenamiento para guardar ese diccionario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink n’a pas pu accéder à son stockage pour enregistrer ce dictionnaire."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink nem érte el a tárhelyét, hogy elmentse a szótárat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink non è riuscito ad accedere alla sua memoria per salvare quel dizionario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書を保存するための保存領域にアクセスできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전을 저장할 저장 공간에 접근하지 못했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink tidak dapat mencapai storannya untuk menyimpan kamus itu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink não conseguiu aceder ao seu armazenamento para guardar esse dicionário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink не смог добраться до своего хранилища, чтобы сохранить этот словарь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 无法访问存储空间来保存该词典。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ei pääsenud selle sõnaraamatu salvestamiseks oma salvestusruumile ligi."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink kon nie sy berging bereik om daardie woordeboek te stoor nie."
          }
        }
      }
    },
    "Clink does not use Full Access for network, tracking, or anything else.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink nutzt Vollzugriff nicht für Netzwerk, Tracking oder sonst was."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink no usa el acceso completo para red, seguimiento ni nada más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink n'utilise pas l'accès complet pour le réseau, le suivi ou quoi que ce soit d'autre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink nem használja a teljes hozzáférést hálózathoz, követéshez vagy bármi máshoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink non usa l'accesso completo per la rete, il tracciamento o altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink はフルアクセスをネットワークや追跡などには使いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink는 전체 접근을 네트워크나 추적, 그 밖의 어떤 것에도 쓰지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink tak guna Akses Penuh untuk rangkaian, penjejakan atau apa-apa lain."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink não usa o acesso total para rede, rastreio ou seja o que for."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink не использует полный доступ ни для сети, ни для слежки, ни для чего-либо ещё."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 不会拿完全访问去联网、追踪或做别的事。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ei kasuta täisjuurdepääsu võrgu, jälgimise või millegi muu jaoks."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink gebruik nie Volle Toegang vir netwerk, opsporing of enigiets anders nie."
          }
        }
      }
    },
    "Clink doesn't have access to Cling's shared container on this device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink hat auf diesem Gerät keinen Zugriff auf Clings gemeinsamen Container."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink no tiene acceso al contenedor compartido de Cling en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink n'a pas accès au conteneur partagé de Cling sur cet appareil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clinknek nincs hozzáférése a Cling megosztott tárolójához ezen az eszközön."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink non ha accesso al contenitore condiviso di Cling su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末では Clink が Cling の共有コンテナにアクセスできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 Clink가 Cling의 공유 컨테이너에 접근할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink tiada akses kepada bekas kongsi Cling pada peranti ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink não tem acesso ao contentor partilhado do Cling neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве у Clink нет доступа к общему контейнеру Cling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台设备上，Clink 无法访问 Cling 的共享容器。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkil puudub selles seadmes juurdepääs Clingi ühiskasutuses konteinerile."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink het nie toegang tot Cling se gedeelde houer op hierdie toestel nie."
          }
        }
      }
    },
    "Clink figures out where you actually meant to tap. Keys grow a bit based on what you're likely to type next so you miss less.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink erkennt, wo du eigentlich tippen wolltest. Tasten wachsen ein wenig, je nachdem, was du wahrscheinlich als Nächstes tippst, damit du seltener danebentippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink deduce dónde querías tocar de verdad. Las teclas crecen un poco según lo que es probable que escribas después, para que falles menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink comprend où tu voulais vraiment appuyer. Les touches grandissent un peu selon ce que tu risques de taper ensuite pour que tu rates moins."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink kitalálja, hova akartál valójában koppintani. A billentyűk kicsit megnőnek aszerint, hogy mit fogsz valószínűleg gépelni, így kevesebbszer hibázol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink capisce dove volevi davvero toccare. I tasti crescono un po' in base a ciò che probabilmente scriverai, così sbagli di meno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink が実際にタップしようとした場所を割り出します。次に打ちそうな文字に合わせてキーが少し大きくなるので、押し間違いが減ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink가 실제로 누르려던 곳을 알아내요. 다음에 칠 것 같은 키가 조금씩 커져서 덜 놓쳐요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kenal pasti di mana anda sebenarnya nak ketik. Kekunci membesar sedikit ikut apa yang anda mungkin taip seterusnya supaya anda kurang tersasar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink percebe onde querias mesmo tocar. As teclas crescem um pouco com base no que é provável que escrevas a seguir, para falhares menos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink понимает, куда вы на самом деле целились. Клавиши немного растут в зависимости от того, что вы, скорее всего, напечатаете дальше, — и вы реже промахиваетесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 会算出你实际想点的位置。按键会根据你接下来可能打的字稍微变大，让你少点错。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink saab aru, kuhu sa tegelikult vajutada tahtsid. Klahvid kasvavad natuke sõltuvalt sellest, mida sa järgmisena tõenäoliselt tipid, et sa eksiksid vähem."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink vind uit waar jy eintlik bedoel het om te tik. Sleutels groei 'n bietjie op grond van wat jy waarskynlik volgende gaan tik, sodat jy minder mis."
          }
        }
      }
    },
    "Clink has no server and no copy of the key, so nobody at Clink can read any of it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink hat keinen Server und keine Kopie des Schlüssels – niemand bei Clink kann davon irgendetwas lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink no tiene servidor ni copia de la clave, así que nadie en Clink puede leer nada de esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink n’a ni serveur ni copie de la clé : personne chez Clink ne peut en lire quoi que ce soit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clinknek nincs szervere és nincs másolata a kulcsról, így a Clinknél senki nem tudja elolvasni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink non ha server né una copia della chiave, quindi nessuno in Clink può leggerne nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkにはサーバーも鍵の控えもないため、Clinkの誰も内容を読むことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink에는 서버도 키 사본도 없으므로 Clink의 누구도 내용을 읽을 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink tiada pelayan dan tiada salinan kunci, jadi tiada sesiapa di Clink boleh membacanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink não tem servidor nem cópia da chave, por isso ninguém no Clink consegue ler nada disto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У Clink нет ни сервера, ни копии ключа, поэтому прочитать это не может никто из нас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 没有服务器，也没有密钥副本，因此 Clink 的任何人都无法读取这些内容。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkil pole serverit ega koopia võtmest, seega keegi Clinkis ei saa seda lugeda."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink het geen bediener en geen kopie van die sleutel nie, so niemand by Clink kan enige daarvan lees nie."
          }
        }
      }
    },
    "Clink hasn't been shut down on this device. If that changes, it'll show up here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink wurde auf diesem Gerät noch nie beendet. Falls sich das ändert, steht es hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no ha cerrado Clink en este dispositivo. Si eso cambia, aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink n'a jamais été arrêté sur cet appareil. Si cela change, ça apparaîtra ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clinket még semmi nem állította le ezen az eszközön. Ha ez megváltozik, itt fog megjelenni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink non è mai stato chiuso su questo dispositivo. Se dovesse succedere, lo trovi qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末で Clink が終了させられたことはありません。もしそうなれば、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 Clink가 종료된 적이 없어요. 그런 일이 생기면 여기에 표시돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink belum pernah ditutup pada peranti ini. Kalau itu berubah, ia akan muncul di sini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink nunca foi fechado neste dispositivo. Se isso mudar, aparece aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве Clink ни разу не выгружали. Если это изменится, здесь появится запись."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 在这台设备上还没有被关闭过。如果发生了，会显示在这里。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinki pole selles seadmes suletud. Kui see muutub, ilmub see siia."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink is nie op hierdie toestel afgeskakel nie. As dit verander, sal dit hier verskyn."
          }
        }
      }
    },
    "Clink is free for everyone now, but **you'll never pay again**. It's yours, unlocked, for life.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora Clink es gratis para todo el mundo, pero **tú no volverás a pagar nunca**. Es tuyo y estará desbloqueado para siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink est maintenant gratuit pour tout le monde, mais **tu ne paieras plus jamais**. Il est à toi, déverrouillé à vie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ist jetzt für alle kostenlos, aber **du musst nie wieder bezahlen**. Für dich bleibt alles für immer freigeschaltet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora Clink è gratis per tutti, ma **tu non pagherai mai più**. È tuo, sbloccato per sempre."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora o Clink é grátis para toda a gente, mas **tu nunca mais vais pagar**. É teu e fica desbloqueado para sempre."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kini percuma untuk semua, tetapi **anda tak perlu bayar lagi**. Semuanya dibuka untuk anda, selamanya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink mostantól mindenkinek ingyenes, de **neked soha többé nem kell fizetned**. Örökre fel van oldva neked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkは今では誰でも無料ですが、**あなたがもう支払うことはありません**。ずっとすべて使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 现在对所有人免费，但**你以后再也不用付费**。它永远属于你，所有功能都已解锁。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 Clink는 모두에게 무료지만, **앞으로 다시 결제할 일은 없어요**. 평생 모든 기능을 사용할 수 있어요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink on nüüd kõigile tasuta, aga **sa ei pea kunagi enam maksma**. See on sinu, avatud, eluaegselt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь Clink бесплатен для всех, но **вы больше никогда не заплатите**. Он ваш, разблокирован, навсегда."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink is nou gratis vir almal, maar **jy sal nooit weer betaal nie**. Dit is joune, oopgesluit, lewenslank."
          }
        }
      }
    },
    "Clink is free to use inside this app. Pick a plan to make it your keyboard in every other app too.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink es gratis dentro de esta app. Elige un plan para usar su teclado también en todas las demás apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink est gratuit dans cette app. Choisis une formule pour utiliser son clavier dans toutes tes autres apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser App ist Clink kostenlos. Wähle einen Tarif, um die Tastatur auch in allen anderen Apps zu verwenden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink è gratis dentro questa app. Scegli un piano per usare la sua tastiera anche in tutte le altre app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink é grátis nesta app. Escolhe um plano para usares o teclado também em todas as outras apps."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink percuma dalam app ini. Pilih pelan untuk menggunakan papan kekuncinya dalam semua app lain juga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink ebben az appban ingyenes. Válassz csomagot, hogy minden más appban is ezt a billentyűzetet használhasd."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリ内ではClinkを無料で使えます。ほかのアプリでもキーボードとして使うには、プランを選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 可在此 App 内免费使用。选择一个方案，即可在其他所有 App 中使用 Clink 键盘。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱 안에서는 Clink를 무료로 사용할 수 있어요. 다른 모든 앱에서도 키보드로 쓰려면 요금제를 선택하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink on selles rakenduses tasuta. Vali plaan, et muuta see oma klaviatuuriks ka kõigis teistes rakendustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink бесплатен внутри этого приложения. Выберите план, чтобы сделать его своей клавиатурой и во всех остальных приложениях."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink is gratis om binne hierdie toepassing te gebruik. Kies 'n plan om dit ook jou sleutelbord in elke ander toepassing te maak."
          }
        }
      }
    },
    "Clink is fully offline. Nothing you type is uploaded, and you don't need an account.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink läuft komplett offline. Nichts, was du tippst, wird hochgeladen, und du brauchst kein Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink funciona sin conexión. Nada de lo que escribes se sube, y no hace falta cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink marche entièrement hors ligne. Rien de ce que tu tapes n'est envoyé, et tu n'as pas besoin de compte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink teljesen offline. Amit beírsz, azt semmi nem tölti fel, és fiók sem kell hozzá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink funziona tutto offline. Niente di quello che scrivi viene caricato, e non ti serve un account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink は完全オフラインです。入力した文字はどこにもアップロードされませんし、アカウントもいりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink는 완전히 오프라인으로 동작해요. 입력한 건 어디에도 올라가지 않고, 계정도 필요 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink berfungsi sepenuhnya luar talian. Apa yang anda taip tidak dimuat naik, dan anda tak perlukan akaun."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink funciona todo offline. Nada do que escreves é enviado e não precisas de conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink работает полностью офлайн. Ничего из напечатанного не загружается, и аккаунт не нужен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 完全离线。你打的字不会上传，也不用注册账户。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink töötab täielikult ühenduseta. Midagi, mida tipid, ei laadita üles ja sul pole vaja kontot."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink is heeltemal vanlyn. Niks wat jy tik word opgelaai nie, en jy het nie 'n rekening nodig nie."
          }
        }
      }
    },
    "Clink is made by anti.ltd. Dictionary licenses are in Dictionaries under Extras.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kommt von anti.ltd. Die Wörterbuchlizenzen findest du unter Wörterbücher in Extras."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink lo hace anti.ltd. Las licencias de los diccionarios están en Diccionarios, dentro de Extras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink est fait par anti.ltd. Les licences des dictionnaires sont dans Dictionnaires, sous Extras."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clinket az anti.ltd készíti. A szótárlicenceket az Extrák Szótárak részében találod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink è fatto da anti.ltd. Le licenze dei dizionari sono in Dizionari, dentro Extra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink は anti.ltd が作っています。辞書のライセンスは「その他」の辞書にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink는 anti.ltd에서 만들었어요. 사전 라이선스는 추가 기능의 사전에 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink dibuat oleh anti.ltd. Lesen kamus ada dalam Kamus di bawah Tambahan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink é feito pela anti.ltd. As licenças dos dicionários estão em Dicionários, em Extras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink делает anti.ltd. Лицензии словарей — в разделе «Словари», в «Дополнительном»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 由 anti.ltd 制作。词典许可证在扩展功能的词典里。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinki loob anti.ltd. Sõnaraamatute litsentsid asuvad jaotises Sõnaraamatud all Lisad."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klink word gemaak deur anti.ltd. Woordeboeklisensies is in Woordeboeke onder Ekstras."
          }
        }
      }
    },
    "Clink is offline with no accounts. Your keystrokes never leave the device. Full Access only lets the keyboard play audio and vibrate.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink läuft offline, ganz ohne Accounts. Deine Tastenanschläge verlassen nie das Gerät. Vollzugriff erlaubt der Tastatur nur, Sound abzuspielen und zu vibrieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink funciona sin conexión y sin cuentas. Lo que escribes nunca sale del dispositivo. El acceso completo solo sirve para que el teclado reproduzca sonido y vibre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink marche hors ligne, sans compte. Tes frappes ne quittent jamais l'appareil. L'accès complet sert juste à jouer du son et à faire vibrer le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink offline, fiók nélkül. A leütéseid soha nem hagyják el a készüléket. A Teljes hozzáférés csak arra kell, hogy a billentyűzet hangot adjon és rezegjen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink è offline e senza account. Quello che scrivi non lascia mai il dispositivo. L'accesso completo serve solo a far suonare e vibrare la tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkはオフラインで動き、アカウントもいりません。あなたのキー入力がデバイスの外に出ることはありません。フルアクセスでできるのは、キーボードで音を鳴らしたり振動させたりすることだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink은 오프라인이고 계정이 없어요. 입력한 키는 절대 기기 밖으로 나가지 않아요. 전체 접근을 켜도 키보드가 소리를 내고 진동하는 데만 써요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink berfungsi luar talian tanpa akaun. Ketukan kekunci anda tak pernah keluar dari peranti. Akses Penuh cuma benarkan papan kekunci mainkan audio dan bergetar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink funciona offline e sem contas. As tuas teclas nunca saem do dispositivo. O acesso total só deixa o teclado tocar áudio e vibrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink работает офлайн и без аккаунтов. Нажатия клавиш никогда не покидают устройство. Полный доступ нужен клавиатуре только для звука и вибрации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 离线运行，不用账户。你敲的字绝不会离开设备。完全访问权限只是用来让键盘发声和振动。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink töötab ühenduseta, ilma kontodeta. Sinu klahvivajutused ei lahku kunagi seadmest. Täisjuurdepääs lubab klaviatuuril ainult heli esitada ja vibreerida."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink is vanlyn met geen rekeninge nie. Jou toetsaanslagen verlaat nooit die toestel nie. Met volle toegang kan die sleutelbord slegs oudio speel en vibreer."
          }
        }
      }
    },
    "Clink keeps correcting a word I actually use": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink korrigiert ständig ein Wort, das ich wirklich benutze"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink me corrige una palabra que sí uso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink corrige sans cesse un mot que j'utilise vraiment"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink folyton kijavít egy szót, amit tényleg használok"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink continua a correggere una parola che uso davvero"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う単語をClinkが毎回直してしまいます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제로 쓰는 단어를 Clink이 자꾸 고칩니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink asyik membetulkan perkataan yang memang saya guna"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink corrige uma palavra que eu uso mesmo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink всё время исправляет слово, которым я реально пользуюсь"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我常用的词老是被 Clink 改掉"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink parandab pidevalt sõna, mida ma tegelikult kasutan"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink hou aan om 'n woord reg te stel wat ek eintlik gebruik"
          }
        }
      }
    },
    "Clink keeps the guardrails on: it rewrites what you say your way, but never answers it or adds anything you didn't say.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink behält die Leitplanken: Es schreibt das Gesagte nach deinen Wünschen um, beantwortet es aber nie und fügt nichts hinzu, was du nicht gesagt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink mantiene las salvaguardas: reescribe lo que dices a tu manera, pero nunca lo responde ni añade nada que no dijeras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink garde les garde-fous : il réécrit ce que tu dis à ta façon, mais ne le répond jamais et n'ajoute rien que tu n'aies dit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink megtartja a védőkorlátokat: a te stílusodban írja át, amit mondasz, de sosem válaszol rá, és nem tesz hozzá semmit, amit nem mondtál."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink mantiene le protezioni: riscrive quello che dici a modo tuo, ma non risponde mai e non aggiunge nulla che tu non abbia detto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink はガードレールを保ちます。話した内容をあなたの指示どおりに書き直しますが、それに答えたり、言っていないことを付け足したりは決してしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink는 안전장치를 유지해요. 말한 내용을 원하는 방식으로 다시 쓸 뿐, 거기에 답하거나 하지 않은 말을 덧붙이지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink mengekalkan garis panduannya: ia menulis semula apa yang anda sebut mengikut cara anda, tetapi tidak sekali-kali menjawabnya atau menambah apa-apa yang anda tidak sebut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink mantém as proteções: reescreve o que dizes à tua maneira, mas nunca responde nem acrescenta nada que não tenhas dito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink держит границы: он переписывает сказанное вашими словами, но никогда не отвечает на него и не добавляет того, чего вы не говорили."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 会守住安全边界：它按你的方式改写你说的话，但绝不会去回应，也不会添加你没说过的内容。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink hoiab piiraiad püsti: ta kirjutab sinu üteldu sinu moel ümber, aga ei vasta sellele kunagi ega lisa midagi, mida sa ei öelnud."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink hou die vangrelings aan: dit herskryf wat jy sê op jou manier, maar antwoord dit nooit of voeg iets by wat jy nie gesê het nie."
          }
        }
      }
    },
    "Clink keyboard added": {
      "extractionState": "manual",
      "localizations": {
        "de": {
