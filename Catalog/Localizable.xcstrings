    "Works out to %@ a month. Renews yearly. Cancel anytime.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk uit na %@ per maand. Hernu jaarliks. Kanselleer enige tyd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das entspricht %@ pro Monat. Verlängert sich jährlich. Jederzeit kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equivale a %@ al mes. Se renueva cada año. Cancela cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuleb %@ kuus. Uueneb aastaselt. Tühista igal ajal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça revient à %@ par mois. Renouvellement annuel. Résiliable à tout moment."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez havi %@-nak felel meg. Évente megújul. Bármikor lemondhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrisponde a %@ al mese. Si rinnova ogni anno. Annulla quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月あたり%@になります。年ごとに自動更新。いつでも解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월 %@ 꼴이에요. 매년 자동 갱신되고, 언제든 취소할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersamaan %@ sebulan. Diperbaharui setiap tahun. Batal bila-bila masa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá para %@ por mês. Renova anualmente. Cancela quando quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выходит %@ в месяц. Продлевается раз в год. Отменить можно в любой момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相当于每月 %@。按年续订，随时可以取消。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
