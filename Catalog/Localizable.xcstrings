    "Higher feels punchier and more mechanical. Lower is a faint tick.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoër voel sterker en meer meganies. Laer is 'n flou bosluis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höher fühlt sich knackiger und mechanischer an. Niedriger ist nur ein leises Ticken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más alto se siente más fuerte y mecánico. Más bajo es solo un toquecito."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõrgem tundub löögilt kindlam ja mehaanilisem. Madalam on ainult nõrk tiksuv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus haut, ça fait plus franc et plus mécanique. Plus bas, c'est un léger tic."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A magasabb ütősebb és mechanikusabb. Az alacsonyabb csak egy halvány kattanás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più alto è più deciso e meccanico. Più basso è un tocco leggero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高いほど力強くてメカニカルな感触に、低いほどかすかなカチッという感触になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높을수록 더 세고 기계 같은 느낌이에요. 낮으면 살짝 톡 하는 정도예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagi tinggi rasa lagi mantap dan mekanikal. Lagi rendah cuma ketikan samar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais alto parece mais forte e mais mecânico. Mais baixo é um toque ténue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше — резче и механичнее. Меньше — еле слышный тик."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调高手感更有力、更机械。调低就是轻轻一下的咔嗒感。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher se simte mai puternic și mai mecanic. Mai jos este o căpușă slabă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoger voelt pittiger en mechanischer aan. Lager is een zwakke teek."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調高手感更有力、更機械。調低就是輕輕一下的咔嗒感。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyższe są bardziej dynamiczne i mechaniczne. Niżej widać słaby tyk."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вищий виглядає більш різким і більш механічним. Нижче – слабка галочка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yüksek, daha keskin ve daha mekanik hissettirir. Altta hafif bir işaret var."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyšší působí úderněji a mechanicky. Nižší je slabé klíště."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyššie pôsobí údernejšie a mechanickejšie. Nižšie je slabý kliešť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Higher αισθάνεται πιο διάτρητο και πιο μηχανικό. Κάτω είναι ένα αχνό τσιμπούρι."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högre känns slagkraftigare och mer mekaniskt. Nedre är en svag fästing."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højere føles stærkere og mere mekanisk. Nederste er en svag skovflåt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyere føles sterkere og mer mekanisk. Nedre er en svak flått."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korkeampi tuntuu iskevämmältä ja mekaanisemmalta. Alempi on heikko rasti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih tinggi terasa lebih kuat dan lebih mekanis. Yang lebih rendah adalah tanda centang yang samar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cao hơn cho cảm giác mạnh mẽ và cơ khí hơn. Phía dưới là một tiếng tích tắc mờ nhạt."
          }
        }
      }
    },
