      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne einen Eintrag oder lösche alle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina una palabra o bórralas todas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemalda üks sõna või tühjenda kogu loend."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime-en un ou efface-les tous."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törölj egy szót, vagy ürítsd ki az egész listát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovine una oppure cancellale tutte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つずつ削除することも、まとめて消去することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나씩 삭제하거나 모두 지울 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam satu perkataan atau kosongkan semuanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove uma palavra ou apaga-as todas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалите одно слово или очистите весь список."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以逐个移除，也可以全部清空。"
          }
        }
      }
    },
    "Remove one, or clear the lot. Learn from your typing turns the whole thing off.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwyder een, of maak die lot skoon. Leer uit jou tik skakel die hele ding af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösch einzelne oder alle. „Aus deinem Tippen lernen“ schaltet das Ganze ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra una, o vacíalas todas. Aprender de tu escritura lo apaga por completo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemalda üks või tühjenda kõik. Õpi sinu tipimisest lülitab kogu asja välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime-en une, ou tout. Apprendre de ta saisie désactive complètement le mécanisme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törölj egyet, vagy üresítsd ki az egészet. A Tanulás a gépelésedből kapcsoló az egészet kikapcsolja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellane una o svuota tutto. Impara da come scrivi disattiva l'intera cosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つずつ削除しても、すべて消しても構いません。「入力から学習する」をオフにすれば、そもそも覚えなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나씩 지워도 되고 전부 비워도 됩니다. 입력한 내용에서 배우기를 끄면 아예 기억하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam satu, atau kosongkan semuanya. Belajar dari cara anda menaip mematikan keseluruhannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga uma, ou limpa tudo. Aprender com a tua escrita desliga o mecanismo por completo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уберите одно слово или очистите весь список. «Учиться на вашей печати» выключает это целиком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以删掉某一个，也可以全部清空。关掉“从你的输入里学习”，它就不再记了。"
          }
        }
      }
    },
