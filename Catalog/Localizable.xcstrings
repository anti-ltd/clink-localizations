    "Changes lists everything you've moved away from its default.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Veranderinge lys alles wat jy van die verstek af wegbeweeg het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Änderungen“ listet alles auf, was du vom Standard weggedreht hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambios enumera todo lo que has movido de su valor por defecto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„Muudatused\" loetleb kõik, mille oled vaikeväärtusest eemaldanud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifications liste tout ce que tu as éloigné de sa valeur d'origine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Módosítások mindent felsorol, amit elmozdítottál az alapértékétől."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiche elenca tutto quello che hai spostato dal valore predefinito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「変更」には、初期値から動かしたものがすべて並びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항에는 기본값에서 바꾼 것이 모두 나열됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan menyenaraikan semua yang anda ubah daripada nilai lalainya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterações lista tudo o que afastaste do valor de origem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Изменениях» перечислено всё, что вы сдвинули со стандартного значения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“更改”会列出所有被你从默认值改动过的项。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările listează tot ceea ce ați mutat de la valoarea implicită."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen geeft een overzicht van alles wat u van de standaardinstelling hebt verwijderd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“更改”會列出所有被你從預設值改動過的項。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany wyświetla wszystko, co przeniosłeś z ustawień domyślnych."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни перераховують усе, що ви віддалили від стандартного значення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler, varsayılan ayarından uzaklaştırdığınız her şeyi listeler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny uvádí vše, co jste přesunuli z výchozího nastavení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmeny uvádza všetko, čo ste presunuli z predvoleného nastavenia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Changes παραθέτει όλα όσα έχετε απομακρυνθεί από την προεπιλογή του."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringar listar allt du har flyttat bort från dess standard."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændringer viser alt, hvad du har flyttet væk fra standarden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringer viser alt du har flyttet bort fra standarden."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutokset näyttää kaiken, mitä olet siirtynyt pois oletusasetuksista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan mencantumkan semua yang telah Anda tinggalkan dari defaultnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thay đổi liệt kê mọi thứ bạn đã di chuyển khỏi mặc định."
          }
        }
      }
