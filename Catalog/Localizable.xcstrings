        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모와 테마 뒤에 놓인 배경 사진."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota, dan sebarang foto latar di belakang tema anda."
