      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geaktiveerde handelinge verskyn agter die sleutelbord se aksieknoppie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivierte Aktionen erscheinen hinter der Aktions-Taste der Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones activadas aparecen detrás del botón de acción del teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lubatud tegevused ilmuvad klaviatuuri tegevusnupu taha."
          }
