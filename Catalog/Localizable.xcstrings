    "The text you copy, ready on every device. Copied images stay on the device that saved them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text, den du kopierst, steht auf jedem Gerät bereit. Kopierte Bilder bleiben auf dem Gerät, das sie gespeichert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto que copias, listo en todos tus dispositivos. Las imágenes copiadas se quedan en el dispositivo que las guardó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte que tu copies, prêt sur chaque appareil. Les images copiées restent sur l’appareil qui les a enregistrées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A másolt szöveged minden eszközön kéznél van. A másolt képek azon az eszközön maradnak, amelyik elmentette őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo che copi, pronto su ogni dispositivo. Le immagini copiate restano sul dispositivo che le ha salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたテキストをすべてのデバイスで使えます。コピーした画像は保存したデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 텍스트를 모든 기기에서 바로 사용할 수 있습니다. 복사한 이미지는 저장한 기기에 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang anda salin, tersedia pada setiap peranti. Imej yang disalin kekal pada peranti yang menyimpannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto que copias, pronto em todos os dispositivos. As imagens copiadas ficam no dispositivo que as guardou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопированный текст доступен на всех устройствах. Скопированные изображения остаются на том устройстве, где были сохранены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你复制的文本可在每台设备上随时取用。复制的图片则保留在保存它的设备上。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst, mida kopeerid, on valmis igas seadmes. Kopeeritud pildid jäävad seadmesse, mis need salvestas."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die teks wat jy kopieer, gereed op elke toestel. Gekopieerde beelde bly op die toestel wat hulle gestoor het."
          }
        }
      }
    },
    "The text you copy, ready on every device. Copied images stay put.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kopierte Text, auf jedem Gerät bereit. Kopierte Bilder bleiben, wo sie sind."
