    "Browse everything you've saved in Cling and tap to type it wherever you are.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blaai deur alles wat jy in Cling gestoor het en tik om dit te tik waar jy ook al is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchstöbere alles, was du in Cling gespeichert hast, und tippe darauf, um es überall einzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora todo lo que has guardado en Cling y toca para escribirlo donde estés."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirvi kõike, mida oled Clingi salvestanud, ja puuduta, et see kuskil tipida."
