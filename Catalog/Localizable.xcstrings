    "Messages, mail, notes, search bars. Anywhere you type.": {
      "extractionState": "stale",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Boodskappe, pos, notas, soekbalke. Enige plek waar jy tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten, Mail, Notizen, Suchfelder. Überall, wo du tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensajes, correo, notas, barras de búsqueda. Donde sea que escribas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sõnumid, e-post, märkmed, otsinguribad. Kus iganes sa tipid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages, mail, notes, barres de recherche. Partout où tu écris."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzenetek, levelek, jegyzetek, keresőmezők. Bárhol, ahol gépelsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Messaggi, mail, note, barre di ricerca. Ovunque tu scriva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ、メール、メモ、検索バー。入力する場所ならどこでも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지, 메일, 메모, 검색창까지. 입력하는 곳이라면 어디든."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesej, mel, nota, bar carian. Di mana-mana sahaja anda menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensagens, mail, notas, barras de pesquisa. Onde quer que escrevas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщения, почта, заметки, строки поиска. Везде, где вы печатаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信息、邮件、备忘录、搜索栏。任何输入的地方。"
          }
        }
      }
    },
