    "Gestures → Cursor sets movement type, feel, and tap to select.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestos → Cursor ajusta el tipo de movimiento, el tacto y tocar para seleccionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestes → Curseur règle le type de mouvement, le ressenti et toucher pour sélectionner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesten → Cursor stellt Bewegungsart, Gefühl und Tippen zum Markieren ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesti → Cursore imposta tipo di movimento, feeling e tocca per selezionare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestos → Cursor define o tipo de movimento, o toque e tocar para selecionar."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerak isyarat → Kursor menetapkan jenis pergerakan, rasa, dan ketik untuk pilih."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesztusok → Kurzor állítja a mozgás típusát, az érzést és az érintésre kijelölést."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジェスチャー → カーソルで移動の種類、感触、タップして選択を設定します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手势 → 光标可设置移动方式、手感和点按选择。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제스처 → 커서에서 이동 방식, 느낌, 탭해서 선택을 설정합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Žestid → Kursor sätestab liikumise liigi, tunnetuse ja puudutuse valimiseks."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жесты → Курсор задаёт тип движения, ощущение и «касание для выделения»."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gebare → Wyser stel bewegingtipe, gevoel en tik om te kies."
          }
        }
      }
    },
    "Hold space, tap anywhere with another finger, keep dragging to highlight.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén espacio, toca en cualquier parte con otro dedo, sigue arrastrando para marcar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez espace, touchez n'importe où avec un autre doigt, continuez à glisser pour sélectionner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Leertaste, tippe mit einem anderen Finger irgendwo hin, ziehe weiter zum Markieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto spazio, tocca ovunque con un altro dito, continua a trascinare per selezionare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o espaço, toca em qualquer lado com outro dedo, continua a arrastar para destacar."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan ruang, ketik di mana-mana dengan jari lain, terus seret untuk menonjolkan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd a szóközt, koppints a másik ujjaddal, húzd tovább a kijelöléshez."
          }
        },
        "ja": {
