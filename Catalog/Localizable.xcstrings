    "Typing stays on your device. No account or tracking.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik bly op jou toestel. Geen rekening of dop nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Eingaben bleiben auf deinem Gerät. Kein Konto, kein Tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura permanece en tu dispositivo. Sin cuenta ni seguimiento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Trükkimine jääb sinu seadmesse. Ei kontot ega jälgimist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie reste sur votre appareil. Sans compte ni suivi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gépelés az eszközödön marad. Nincs fiók és nincs követés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La digitazione resta sul tuo dispositivo. Nessun account né tracciamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力はデバイス上に留まります。アカウントも追跡もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력은 기기에만 남습니다. 계정이나 추적이 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penaipan kekal pada peranti anda. Tiada akaun atau penjejakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A escrita fica no teu dispositivo. Sem conta nem rastreio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ввод остаётся на вашем устройстве. Без аккаунта и отслеживания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入内容留在你的设备上。无需账户，也不跟踪。"
          }
        }
      }
    },
    "Typing stays on your device. No account, no tracking.": {
      "extractionState": "stale",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik bly op jou toestel. Geen rekening, geen dop nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Eingaben bleiben auf deinem Gerät. Kein Konto, kein Tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que escribes se queda en tu dispositivo. Sin cuentas ni rastreo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipimine jääb sinu seadmesse. Kontot pole, jälgimist pole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta saisie reste sur ton appareil. Pas de compte, pas de pistage."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gépelésed az eszközödön marad. Se fiók, se követés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che digiti resta sul tuo dispositivo. Nessun account, nessun tracciamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力内容は端末内にとどまります。アカウントも追跡もなし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 내용은 기기에만 남습니다. 계정도 추적도 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taipan anda kekal pada peranti anda. Tiada akaun, tiada penjejakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que escreves fica no teu dispositivo. Sem contas, sem rastreio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что вы печатаете, остаётся на устройстве. Без аккаунта и без слежки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入内容只留在设备上。无账号，无跟踪。"
          }
        }
      }
    },
