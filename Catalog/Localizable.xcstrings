    "Tools list floats over the keys. Slide onto one and release.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gereedskaplys sweef oor die sleutels. Skuif op een en laat los."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werkzeugliste schwebt über den Tasten. Gleite auf einen Eintrag und lass los."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de herramientas flota sobre las teclas. Desliza hasta una y suelta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tööriistade loend hõljub klahvide kohal. Libise ühele ja vabasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des outils flotte au-dessus des touches. Glisse jusqu'à l'un d'eux et relâche."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközlista a billentyűk fölött lebeg. Csússz rá egyre, és engedd el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco degli strumenti fluttua sopra i tasti. Scorri su uno e rilascia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールの一覧がキーの上に浮かびます。指をすべらせて離すと選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 목록이 키 위에 떠요. 원하는 항목으로 밀고 손을 떼면 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai alatan terapung atas kekunci. Luncur ke salah satu dan lepaskan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de ferramentas flutua sobre as teclas. Desliza até uma e larga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список инструментов всплывает над клавишами. Доведите палец до нужного и отпустите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具列表浮在按键上方。滑到其中一项再松手就行。"
          }
        }
      }
    },
