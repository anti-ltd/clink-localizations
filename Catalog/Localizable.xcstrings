    "Open the Search tab and enter the setting or feature you want.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne den Tab Suchen und gib die gewünschte Einstellung oder Funktion ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la pestaña Buscar e introduce el ajuste o la función que quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava vahekaart „Otsi” ja sisesta soovitud seade või funktsioon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l’onglet Rechercher et saisis le réglage ou la fonction que tu cherches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Keresés lapot, és írd be a keresett beállítást vagy funkciót."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri il pannello Cerca e digita l’impostazione o la funzione che cerchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「検索」タブを開き、探したい設定や機能を入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘검색’ 탭을 열고 찾고 싶은 설정이나 기능을 입력하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka tab Cari dan masukkan tetapan atau ciri yang anda mahu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o separador Pesquisar e introduz a definição ou funcionalidade que procuras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте вкладку «Поиск» и введите название нужной настройки или функции."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“搜索”标签页，输入想找的设置或功能。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți fila Căutare și introduceți setarea sau caracteristica dorită."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open het tabblad Zoeken en voer de gewenste instelling of functie in."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟“搜尋”標籤頁，輸入想找的設定或功能。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak die Soek-oortjie oop en voer die instelling of kenmerk in wat jy wil hê."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz kartę Szukaj i wprowadź żądane ustawienie lub funkcję."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте вкладку Пошук і введіть потрібний параметр або функцію."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama sekmesini açın ve istediğiniz ayarı veya özelliği girin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete kartu Hledat a zadejte požadované nastavení nebo funkci."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte kartu Hľadať a zadajte požadované nastavenie alebo funkciu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε την καρτέλα Αναζήτηση και εισαγάγετε τη ρύθμιση ή τη δυνατότητα που θέλετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna fliken Sök och ange den inställning eller funktion du vill ha."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn fanen Søg, og indtast den indstilling eller funktion, du ønsker."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne fanen Søk og skriv inn innstillingen eller funksjonen du ønsker."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Haku-välilehti ja kirjoita haluamasi asetus tai ominaisuus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka tab Pencarian dan masukkan pengaturan atau fitur yang Anda inginkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở tab Tìm kiếm và nhập cài đặt hoặc tính năng bạn muốn."
          }
        }
      }
    },
