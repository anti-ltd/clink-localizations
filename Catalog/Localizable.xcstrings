        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo ainda se está a preparar. Tenta outra vez daqui a bocado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель ещё готовится. Попробуйте чуть позже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型还在准备中，过一会儿再试试。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudel on veel ettevalmistamisel. Proovi pisut hiljem uuesti."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die model maak nog gereed. Probeer oor 'n rukkie weer."
          }
        }
      }
    },
    "The other keys in the row give way to make space. You can also drag a key's edge in the preview.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die anderen Tasten der Reihe machen Platz. Du kannst auch in der Vorschau am Rand einer Taste ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las demás teclas de la fila se apartan para hacer sitio. También puedes arrastrar el borde de una tecla en la vista previa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres touches de la rangée s'écartent pour faire de la place. Tu peux aussi tirer le bord d'une touche dans l'aperçu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sor többi billentyűje helyet ad neki. Az előnézetben a billentyű szélét is húzhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli altri tasti della riga si stringono per fare spazio. Puoi anche trascinare il bordo di un tasto nell'anteprima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ行のほかのキーが縮んで場所を空けます。プレビューでキーの端をドラッグしても変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 행의 다른 키들이 자리를 내줘요. 미리보기에서 키의 가장자리를 끌어도 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci lain dalam baris itu beralah untuk beri ruang. Anda juga boleh seret tepi kekunci dalam pratonton."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As outras teclas da linha abrem espaço. Também podes puxar a extremidade de uma tecla na pré-visualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остальные клавиши в ряду подвинутся, освобождая место. Можно также потянуть за край клавиши в предпросмотре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一行的其他按键会让出空间。你也可以在预览里拖按键的边缘。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülejäänud klahvid reas teevad ruumi. Sa võid ka eelvaates klahvi serva lohistada."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die ander sleutels in die ry maak plek om plek te maak. Jy kan ook 'n sleutel se rand in die voorskou sleep."
          }
        }
      }
    },
    "The output is inserted at the cursor, keeping the input.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgabe wird an der Cursorposition eingefügt, deine Eingabe bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado se inserta donde tengas el cursor y se conserva lo que escribiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat s'insère au niveau du curseur, sans toucher au texte d'origine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kimenet a kurzorhoz kerül be, a bevitt szöveg megmarad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'output viene inserito al cursore, tenendo l'input."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力はそのままに、カーソル位置に結果を挿入します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력한 내용은 그대로 두고 커서 위치에 결과가 들어가요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasilnya dimasukkan pada kursor, input anda kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado é inserido no cursor, mantendo o que escreveste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат вставляется у курсора, а исходный текст остаётся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果会插入到光标处，输入的内容还留着。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Väljund sisestatakse kursori kohale, sisend jääb alles."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die afvoer word by die wyser ingevoeg, en behou die invoer."
          }
        }
      }
    },
    "The padding sliders below set how much room the keyboard takes overall.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abstands-Regler darunter bestimmen, wie viel Platz die Tastatur insgesamt einnimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los deslizadores de margen de debajo fijan cuánto espacio ocupa el teclado en total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les curseurs de marge en dessous fixent la place que prend le clavier au total."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alattuk lévő térköz-csúszkák szabják meg, mennyi helyet foglal összesen a billentyűzet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I cursori dei margini sotto stabiliscono quanto spazio occupa la tastiera in tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その下の余白スライダーで、キーボード全体が占める広さを決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 아래 여백 슬라이더는 키보드 전체가 차지하는 공간을 정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peluncur pelapik di bawah menetapkan berapa banyak ruang yang papan kekunci ambil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cursores de margem por baixo definem o espaço que o teclado ocupa no total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регуляторы отступов ниже задают, сколько места занимает клавиатура целиком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下面的边距滑块决定整个键盘占多大地方。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Allpool olevad äärise liugurid määravad, kui palju ruumi klaviatuur kokku võtab."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die opvulling-glyers hieronder bepaal hoeveel spasie die sleutelbord in die algemeen neem."
          }
        }
      }
    },
    "The page opens the rest of its controls, and stays open.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite klappt ihre restlichen Einstellungen auf und bleibt so."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página despliega el resto de sus controles y se queda así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page déplie le reste de ses réglages et reste ouverte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az oldal kinyitja a maradék vezérlőt, és nyitva is marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pagina apre il resto dei suoi controlli e resta così."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのページの残りの設定が開き、以後は開いたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 페이지의 나머지 설정이 열리고, 계속 열린 채로 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman itu membuka baki kawalannya, dan kekal terbuka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A página abre o resto dos controlos e fica assim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страница раскрывает остальные регуляторы и остаётся раскрытой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一页剩下的设置会展开，并保持展开。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Leht avab oma ülejäänud juhtelemendid ja jääb avatuks."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die bladsy maak die res van sy kontroles oop en bly oop."
          }
        }
      }
    },
    "The popups are a switch, and they've got their own timing if you'd rather keep them but calm them down.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Popups sind ein Schalter — und wenn du sie behalten, aber beruhigen willst, hat ihr Verhalten eigene Regler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas emergentes son un interruptor, y tienen sus propios ajustes por si prefieres dejarlas pero calmarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bulles se coupent d'un interrupteur, et si tu préfères les garder en plus discrètes, leur animation a ses propres réglages."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előugró ablakok egyetlen kapcsoló, és ha inkább maradnának, csak visszafogottabban, saját beállításaik is vannak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I popup si tolgono con un interruttore e, se preferisci tenerli ma più tranquilli, hanno i loro tempi regolabili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポップアップはスイッチ1つでオフにできます。残したまま控えめにしたい場合は、動きの設定も別にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팝업은 스위치 하나로 끌 수 있고, 남겨 두되 차분하게 만들고 싶다면 움직임 설정도 따로 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop timbul ada suisnya sendiri, dan jika anda mahu kekalkan tetapi lebih tenang, gerakannya boleh dilaraskan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pop-ups são um interruptor e, se preferires mantê-los mas mais calmos, têm os seus próprios ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всплывающие окна — это переключатель, и у них есть свои тайминги, если хочется их оставить, но приглушить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹窗有单独的开关；想留着但让它安静点，动画节奏也能单独调。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hüpikud on lüliti — ja kui tahad neid hoida, aga rahustada, on nende ajastusel oma reguleerimine."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die pop-ups is 'n skakelaar, en hulle het hul eie tydsberekening as jy hulle eerder wil hou, maar kalmeer."
          }
        }
      }
    },
    "The preview stays pinned at the top while you drag, so you can size it against real keys.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschau bleibt beim Ziehen oben angeheftet, du kannst also an echten Tasten Maß nehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa se queda fija arriba mientras arrastras, así ajustas el tamaño contra teclas de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aperçu reste épinglé en haut pendant que tu fais glisser : tu ajustes la taille sur de vraies touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előnézet húzás közben fent marad, így valódi billentyűkhöz mérheted a méretet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'anteprima resta fissata in alto mentre trascini, così regoli la dimensione su tasti veri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグ中もプレビューは上部に固定されるので、実際のキーを見ながら大きさを決められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하는 동안 미리보기가 위에 고정돼 있어서, 실제 키를 보며 크기를 맞출 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratonton kekal disemat di atas semasa anda menyeret, jadi anda boleh menyesuaikan saiznya berbanding kekunci sebenar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A pré-visualização fica presa no topo enquanto arrastas, por isso ajustas o tamanho contra teclas a sério."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпросмотр закреплён наверху, пока вы тянете, — так размер можно подбирать по настоящим клавишам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动时预览一直钉在上方，可以对着真实按键来定大小。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eelvaade jääb lohistamise ajal üles kinnitatuks, nii et sa saad suurust määrata päris klahvide järgi."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die voorskou bly aan die bokant vasgespeld terwyl jy sleep, sodat jy dit teen regte sleutels kan grootte."
          }
        }
      }
    },
    "The rest of Clink": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rest von Clink"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resto de Clink"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le reste de Clink"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink többi része"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il resto di Clink"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink のそのほかの機能"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink의 나머지 기능"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selebihnya dalam Clink"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O resto do Clink"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё остальное в Clink"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 的其余部分"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülejäänud Clink"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die res van Clink"
          }
        }
      }
    },
    "The same page lists what Clink has learned from your typing, so a word it picked up by mistake can go from there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf derselben Seite steht, was Clink von deinem Tippen gelernt hat: ein versehentlich aufgeschnapptes Wort löschst du dort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esa misma página está lo que Clink ha aprendido de tu escritura, así que una palabra que cogió por error se borra ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La même page liste ce que Clink a appris en te lisant : un mot attrapé par erreur se supprime là."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugyanezen az oldalon látod, mit tanult a Clink a gépelésedből, így a tévedésből felszedett szó onnan törölhető."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stessa pagina elenca quello che Clink ha imparato da come scrivi, così una parola presa per errore si toglie da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じページにClinkがあなたの入力から学習した単語が並ぶので、誤って覚えたものはそこから削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 페이지에 Clink이 입력에서 배운 단어가 나열되니, 잘못 배운 단어는 거기서 지우면 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman yang sama menyenaraikan apa yang Clink pelajari daripada taipan anda, jadi perkataan yang tersilap diambil boleh dibuang dari situ."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesma página lista o que o Clink aprendeu com a tua escrita, por isso uma palavra apanhada por engano sai dali."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На той же странице перечислено то, чему Clink научился из вашей печати, — слово, подхваченное по ошибке, можно убрать оттуда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一页还列出了 Clink 从你打字中学到的词，学错的可以在那里删掉。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sama leht loetleb, mida Clink sinu tipimisest õppinud on, seega ekslikult ülesvõetud sõna saab sealt minna."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieselfde bladsy lys wat Clink uit jou tik geleer het, so 'n woord wat dit per ongeluk opgetel het, kan daarvandaan gaan."
          }
        }
      }
    },
    "The shape of the press: grow, press in, or wobble. Applies when Bloom is on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie sich der Tastendruck anfühlt: wachsen, eindrücken oder wackeln. Gilt, wenn Bloom an ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma de la pulsación: crecer, hundirse u oscilar. Funciona cuando Bloom está activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La forme de l'appui : grandir, s'enfoncer ou osciller. S'applique quand Bloom est activé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lenyomás alakja: nő, benyomódik vagy remeg. Akkor számít, ha a Bloom be van kapcsolva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma della pressione: cresce, si preme o oscilla. Vale quando Bloom è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押したときの動き。拡大、押し込み、または揺れ。Bloom がオンのときに使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누를 때 모양이에요: 커지기, 눌리기, 흔들리기. Bloom이 켜져 있을 때 적용돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bentuk tekanan: membesar, menekan masuk, atau bergoyang. Berkuat kuasa apabila Bloom dihidupkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A forma do toque: crescer, afundar ou abanar. Aplica-se quando o Bloom está ligado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Характер нажатия: рост, вдавливание или покачивание. Работает при включённом «Свечении»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键的动作：放大、按下去，还是晃一下。开启 Bloom 后生效。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajutuse kuju: kasvamine, sissevajumine või võbina. Kehtib, kui Bloom on sees."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die vorm van die pers: groei, druk in of wiebel. Van toepassing wanneer Bloom aan is."
          }
        }
      }
    },
    "The shifted cap labels itself from the action.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umschalt-Kappe beschriftet sich anhand der Aktion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La leyenda con Mayús toma su etiqueta de la acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La légende avec Maj se nomme d'après l'action."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Shift alatti sapka az akció alapján kapja a feliratát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La legenda con shift si etichetta in base all'azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフト時のキートップはアクションに基づいて自動的にラベル付けされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시프트 키캡은 동작에 따라 자동으로 레이블이 붙어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muka kekunci semasa shift dilabel secara automatik daripada tindakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A legenda com shift rotula-se a partir da ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надпись с Shift подписывается сама, по действию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 键帽会根据操作自动显示标签。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõstetud kate nimetab end tegevuse järgi."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die verskuifde doppie merk homself van die aksie."
          }
        }
      }
    },
    "The shifted cap shows what the shift face types.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umschalt-Kappe zeigt, was die Umschalt-Belegung tippt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La leyenda con Mayús muestra lo que escribe el carácter con Mayús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La légende avec Maj montre ce que tape la face Maj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Shift alatti sapka azt mutatja, amit a Shift karakter beír."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La legenda con shift mostra ciò che digita la faccia shift."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフト時のキートップには、シフト時の文字が入力する内容が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시프트 키캡에는 시프트 문자가 입력하는 내용이 표시돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muka kekunci semasa shift menunjukkan apa yang ditaip oleh aksara shift."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A legenda com shift mostra o que a face do shift escreve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надпись с Shift показывает то, что вводится с Shift."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 键帽显示 Shift 字符输入的内容。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõstetud kate näitab, mida tõstuklahvi kuju sisestab."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die geskuifde doppie wys wat die skofgesig tipes."
          }
        }
      }
    },
    "The standard iOS click. Works without Full Access.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El clic estándar de iOS. Funciona sin acceso total."
