    "While you drag the cursor, tap anywhere with another finger to start highlighting.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terwyl jy die wyser sleep, tik enige plek met 'n ander vinger om te begin uitlig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während du den Cursor ziehst, tippe mit einem anderen Finger irgendwo hin, um zu markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras arrastras el cursor, toca en cualquier parte con otro dedo para empezar a marcar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui sa kursorit lohistad, puuduta teise sõrmega kuskil, et alustada esiletõstmist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant que tu déplaces le curseur, touche l’écran avec un autre doigt pour commencer à sélectionner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amíg a kurzort húzod, koppints máshova a másik ujjaddal, és onnan jelöl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre trascini il cursore, tocca ovunque con un altro dito per iniziare a selezionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルをドラッグ中に、もう一方の指でキーボードをタップすると選択が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서를 끄는 동안 다른 손가락으로 아무 곳이나 탭하면 선택을 시작합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semasa anda seret kursor, ketik di mana-mana dengan jari lain untuk mula menonjolkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto arrastas o cursor, toca em qualquer lado com outro dedo para começar a destacar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивая курсор, коснитесь в любом месте другим пальцем, чтобы начать выделение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动光标时，用另一根手指点按键盘任意处即可开始选中。"
          }
        }
      }
    },
