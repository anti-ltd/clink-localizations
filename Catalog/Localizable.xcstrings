    "Our lowest annual price. Renews yearly.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuestro precio anual más bajo. Se renueva cada año."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notre prix annuel le plus bas. Renouvellement chaque année."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unser günstigster Jahrespreis. Verlängert sich jährlich."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nostro prezzo annuale più basso. Si rinnova ogni anno."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O nosso preço anual mais baixo. Renova anualmente."
          }
        },
        "ru": {
          "stringUnit": {
