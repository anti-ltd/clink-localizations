    "Broad, flat and translucent, like a highlighter.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Breed, plat en deurskynend, soos 'n highlighter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breit, flach und durchscheinend, wie ein Textmarker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancho, plano y translúcido, como un rotulador fluorescente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai, lame ja läbipaistev, nagu tõstpliiats."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Large, plat et translucide, comme un surligneur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Széles, lapos és áttetsző, mint egy szövegkiemelő."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Largo, piatto e traslucido, come un evidenziatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅広で平らで半透明、蛍光ペンのような。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넓고 평평하며 반투명한, 형광펜처럼."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar, rata dan lut sinar, seperti penyerlah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Largo, plano e translúcido, como um marcador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Широкий, плоский и полупрозрачный, как маркер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宽大、扁平且半透明，像荧光笔一样。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lat, plat și translucid, ca un iluminator."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breed, vlak en doorschijnend, als een highlighter."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寬大、扁平且半透明，像熒光筆一樣。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szerokie, płaskie i półprzezroczyste jak rozświetlacz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Широкий, плоский і напівпрозорий, як хайлайтер."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fosforlu kalem gibi geniş, düz ve yarı saydam."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Široký, plochý a průsvitný jako zvýrazňovač."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Široké, ploché a priesvitné ako zvýrazňovač."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φαρδύ, επίπεδο και ημιδιαφανές, σαν highlighter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bred, platt och genomskinlig, som en highlighter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bred, flad og gennemsigtig, som en highlighter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bred, flat og gjennomsiktig, som en highlighter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leveä, tasainen ja läpikuultava, kuin korostuskynä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar, datar, dan tembus cahaya, seperti stabilo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rộng, phẳng và trong mờ, giống như phấn highlighter."
          }
        }
      }
    },
