    "Hold it to run back through the text, picking up speed as you go.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou dit vas om deur die teks terug te hardloop en spoed op te tel terwyl jy gaan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte sie gedrückt, um durch den Text zurückzulaufen, dabei wird es schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenla pulsada para ir borrando hacia atrás, cada vez más rápido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia seda, et tagasi tekstis joosta, kiirendades kiirust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens-la pour remonter dans le texte, de plus en plus vite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd nyomva, és visszafelé fut a szövegen, közben egyre gyorsabban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienilo premuto per risalire il testo, accelerando via via."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しすると文字をさかのぼって消し、だんだん速くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 누르면 글을 거슬러 지워 나가며, 점점 빨라집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan untuk memadam ke belakang menyusuri teks, semakin laju."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém-na premida para recuar pelo texto, ganhando velocidade à medida que vai."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержите, чтобы пройти по тексту назад, постепенно разгоняясь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按会一路往回删，而且越删越快。"
          }
        }
      }
    },
    "Hold space to drag. Keys stay visible but go inert.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou spasie om te sleep. Sleutels bly sigbaar, maar gaan inert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt die Leertaste zum Ziehen. Die Tasten bleiben sichtbar, reagieren aber nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el espacio para arrastrar. Las teclas se ven pero no responden."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia tühikut, et lohistada. Klahvid jäävad nähtavaks, aga muutuvad inertseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens espace pour glisser. Les touches restent visibles mais deviennent inertes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd lenyomva a szóközt a húzáshoz. A gombok láthatók maradnak, de nem reagálnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto spazio per trascinare. I tasti restano visibili ma diventano inattivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースを長押しするとドラッグできます。キーは見えたままですが反応しなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스를 길게 눌러서 끌어보세요. 키는 보이지만 눌러도 반응 안 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan ruang untuk seret. Kekunci kekal nampak tapi jadi tak aktif."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o espaço premido para arrastar. As teclas ficam visíveis mas param de responder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте пробел, чтобы вести. Клавиши остаются видимыми, но перестают реагировать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按空格就能拖动。按键还看得见，但点不动了。"
          }
        }
      }
    },
    "Hold space to turn the whole keyboard into a 2-D trackpad.": {
      "extractionState": "manual",
