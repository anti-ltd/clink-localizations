          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mostani beállításaid megmaradnak, ahogy vannak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue impostazioni attuali restano come sono."
          }
        },
        "ja": {
