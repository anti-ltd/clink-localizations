    "Save recently copied text and images for quick re-paste. Adds a clipboard icon to the suggestions bar.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stoor onlangs gekopieerde teks en beelde vir vinnige herplak. Voeg 'n knipbordikoon by die voorstellebalk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkt sich kürzlich kopierte Texte und Bilder, damit du sie schnell wieder einfügen kannst. Fügt der Vorschlagsleiste ein Zwischenablage-Symbol hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el texto y las imágenes que copias hace poco para volver a pegarlos rápido. Añade un icono de portapapeles a la barra de sugerencias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvesta hiljuti kopeeritud tekst ja pildid kiireks taaskleepimiseks. Lisab soovituseribale lõikelaua ikooni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde le texte et les images copiés récemment pour les recoller vite fait. Ajoute une icône de presse-papiers à la barre de suggestions."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elmenti a nemrég másolt szövegeket és képeket, hogy gyorsan újra beilleszthesd. Egy vágólap ikont tesz a javaslatsávba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva testi e immagini copiati di recente per incollarli di nuovo al volo. Aggiunge un'icona degli appunti alla barra dei suggerimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近コピーしたテキストや画像を保存して、すぐに貼り付け直せます。候補バーにクリップボードのアイコンを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 복사한 글과 이미지를 저장해 두고 빠르게 다시 붙여넣어요. 추천 바에 클립보드 아이콘이 생겨요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan teks dan imej yang baru disalin supaya senang tampal semula. Ia tambah ikon papan keratan pada bar cadangan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda texto e imagens que copiaste há pouco para colares outra vez depressa. Põe um ícone de área de transferência na barra de sugestões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять недавно скопированные текст и изображения для быстрой повторной вставки. Добавляет значок буфера обмена в строку подсказок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存你最近复制的文字和图片，方便随手再粘贴。会在候选栏加一个剪贴板图标。"
          }
        }
      }
    },
