          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină definitiv fiecare temă personalizată și fotografiile de fundal ale acesteia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
