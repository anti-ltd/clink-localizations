        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下时，空格键放大多少。"
          }
        }
      }
    },
    "How much the space bar tilts in the direction you're sliding the cursor.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoeveel die spasiebalk kantel in die rigting waarin jy die wyser skuif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark sich die Leertaste in die Richtung neigt, in die du den Cursor schiebst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto se inclina la barra espaciadora hacia el lado al que deslizas el cursor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui palju tühikuklahv kallutab selles suunas, kuhu sa kursorit libised."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De combien la barre d'espace s'incline dans le sens où tu fais glisser le curseur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyire dől a szóköz abba az irányba, amerre a kurzort csúsztatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto si inclina la barra spaziatrice nella direzione in cui fai scorrere il cursore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルをスライドさせる向きに、スペースバーがどれくらい傾くかです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서를 미는 방향으로 스페이스바가 얼마나 기우는지예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak bar ruang condong ke arah anda meluncurkan kursor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto a barra de espaços se inclina na direção em que deslizas o cursor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько пробел наклоняется в ту сторону, куда вы ведёте курсор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动光标时，空格键朝那个方向倾斜多少。"
          }
        }
      }
    },
    "How much the space-bar spring bounces. Lower bounces more, 1.0 settles cleanly.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoeveel die spasiebalkveer bons. Laer bons meer, 1.0 sit skoon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark die Feder der Leertaste nachfedert. Niedriger federt mehr, 1.0 kommt sauber zur Ruhe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto rebota el resorte de la barra espaciadora. Más bajo rebota más, 1.0 se asienta sin más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui palju tühikuklahvi vedru põrkab. Madalam põrkab rohkem, 1.0 raugab puhtalt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De combien le ressort de la barre d'espace rebondit. Plus bas rebondit plus, 1.0 se stabilise net."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyit pattog a szóköz rugója. Az alacsonyabb többet pattog, az 1.0 szépen elül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto rimbalza la molla della barra spaziatrice. Più basso rimbalza di più, 1.0 si assesta netto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースバーのバネの跳ね具合です。低いほど強く跳ね、1.0できれいに収まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스바 스프링이 얼마나 튀는지예요. 낮으면 더 튀고, 1.0이면 깔끔하게 멈춰요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak spring bar ruang melantun. Lagi rendah lagi banyak lantun, 1.0 mengendap kemas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto a mola da barra de espaços ressalta. Mais baixo ressalta mais, 1.0 assenta de forma limpa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько пружинит пробел. Меньше — сильнее отскок, 1,0 — чистая остановка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空格键弹簧弹跳多少。越低弹得越厉害，1.0 干干净净停稳。"
          }
        }
      }
    },
    "How much the spring bounces. Lower bounces more, 1.0 settles cleanly.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoeveel bons die lente. Laer bons meer, 1.0 sit skoon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark die Feder nachfedert. Niedriger federt mehr, 1.0 kommt sauber zur Ruhe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto rebota el resorte. Más bajo rebota más, 1.0 se asienta sin más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui palju vedru põrkab. Madalam põrkab rohkem, 1.0 raugab puhtalt."
          }
        },
        "fr": {
          "stringUnit": {
