    "Clipboard needs Full Access, and reading it shows the iOS paste banner.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Knipbord het volledige toegang nodig, en die lees daarvan wys die iOS-plakbanier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zwischenablage braucht Vollzugriff, und beim Lesen zeigt iOS das Einfügen-Banner an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles necesita acceso completo, y al leerlo iOS muestra el aviso de pegado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lõikelaud vajab täisjuurdepääsu ja selle lugemine näitab iOS-i kleepimisriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers nécessite l'accès complet, et sa lecture affiche la bannière de collage d'iOS."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágólaphoz Teljes hozzáférés kell, és a beolvasásakor az iOS megjeleníti a beillesztési sávot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli appunti richiedono l'accesso completo, e leggerli mostra il banner di incolla di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードにはフルアクセスが必要で、読み取るとiOSの貼り付けバナーが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드를 쓰려면 전체 접근 허용이 필요하고, 읽을 때 iOS의 붙여넣기 배너가 떠요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan keratan memerlukan Akses Penuh, dan membacanya memaparkan sepanduk tampal iOS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A área de transferência precisa de acesso total, e lê-la mostra o aviso de colar do iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буферу обмена нужен полный доступ, и при чтении iOS показывает баннер о вставке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板需要完全访问权限，读取时会弹出 iOS 的粘贴提示条。"
          }
        }
      }
    },
    "Clipboard style": {
      "extractionState": "manual",
      "localizations": {
        "af": {
