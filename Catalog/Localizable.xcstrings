    "Draw with a finger or a stylus. Two fingers move and zoom the canvas.": {
      "comment": "Android-only copy for the companion app (batch B6: the glyph editor's empty-glyph hint; iOS says \"Apple Pencil\", Android says a stylus). Translations drafted for the Android port; native-speaker review required before release.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken met ’n vinger of ’n stilus. Twee vingers skuif en zoem die doek."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreslete prstem nebo stylusem. Dvěma prsty plátno posunete a přiblížíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn med en finger eller en pen. To fingre flytter og zoomer lærredet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne mit dem Finger oder einem Eingabestift. Mit zwei Fingern verschiebst und zoomst du die Zeichenfläche."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδιάστε με το δάχτυλο ή με γραφίδα. Με δύο δάχτυλα μετακινείτε και μεγεθύνετε τον καμβά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja con el dedo o con un lápiz óptico. Con dos dedos mueves y amplías el lienzo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Joonista sõrme või puutepliiatsiga. Kahe sõrmega liigutad ja suumid lõuendit."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirrä sormella tai kynällä. Kahdella sormella siirrät ja zoomaat piirtoalustaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez avec le doigt ou un stylet. Deux doigts déplacent et zooment le canevas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajzolj ujjal vagy érintőtollal. Két ujjal mozgathatod és nagyíthatod a vásznat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar dengan jari atau stylus. Dua jari untuk menggeser dan memperbesar kanvas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna con un dito o con uno stilo. Con due dita sposti e ingrandisci la tela."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指またはスタイラスで描きます。2本指でキャンバスを移動・拡大できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손가락이나 스타일러스로 그리세요. 두 손가락으로 캔버스를 이동하고 확대할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukis dengan jari atau stilus. Dua jari menggerakkan dan mengezum kanvas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn med en finger eller en pekepenn. To fingre flytter og zoomer lerretet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken met een vinger of een stylus. Met twee vingers verplaats en zoom je het canvas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rysuj palcem lub rysikiem. Dwoma palcami przesuwasz i powiększasz płótno."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe com o dedo ou uma caneta. Dois dedos movem e ampliam a tela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenează cu degetul sau cu un stylus. Cu două degete muți și mărești pânza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисуйте пальцем или стилусом. Двумя пальцами можно двигать и масштабировать холст."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreslite prstom alebo stylusom. Dvoma prstami plátno posuniete a priblížite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rita med ett finger eller en pekpenna. Med två fingrar flyttar och zoomar du duken."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmağınızla veya kalemle çizin. İki parmakla tuvali taşıyıp yakınlaştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Малюйте пальцем або стилусом. Двома пальцями можна переміщувати й масштабувати полотно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẽ bằng ngón tay hoặc bút cảm ứng. Dùng hai ngón để di chuyển và thu phóng khung vẽ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用手指或触控笔绘制。双指可移动和缩放画布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用手指或觸控筆繪製。用兩指可移動和縮放畫布。"
          }
        }
      }
    },
    "Microphone access is off for Clink. Turn it on in Settings > Apps > Clink > Permissions to record.": {
      "comment": "Android-only copy for the companion app (batch B6: the sound-pack editor after the microphone permission was refused; the iOS string names iOS Settings). Translations drafted for the Android port; native-speaker review required before release.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofoontoegang is af vir Clink. Skakel dit aan in Instellings > Apps > Clink > Toestemmings om op te neem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup k mikrofonu je pro Clink vypnutý. Chcete-li nahrávat, zapněte ho v Nastavení > Aplikace > Clink > Oprávnění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonadgang er slået fra for Clink. Slå den til under Indstillinger > Apps > Clink > Tilladelser for at optage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mikrofonzugriff ist für Clink ausgeschaltet. Aktiviere ihn unter Einstellungen > Apps > Clink > Berechtigungen, um aufzunehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσβαση στο μικρόφωνο είναι απενεργοποιημένη για το Clink. Ενεργοποιήστε τη στις Ρυθμίσεις > Εφαρμογές > Clink > Άδειες για να κάνετε εγγραφή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al micrófono está desactivado para Clink. Actívalo en Ajustes > Aplicaciones > Clink > Permisos para grabar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinki mikrofonijuurdepääs on väljas. Salvestamiseks lülita see sisse: Seaded > Rakendused > Clink > Load."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonin käyttö on pois päältä Clinkiltä. Ota se käyttöön kohdassa Asetukset > Sovellukset > Clink > Luvat, jotta voit tallentaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au micro est désactivé pour Clink. Activez-le dans Paramètres > Applications > Clink > Autorisations pour enregistrer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink mikrofonhozzáférése ki van kapcsolva. A felvételhez kapcsold be: Beállítások > Alkalmazások > Clink > Engedélyek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon nonaktif untuk Clink. Aktifkan di Setelan > Aplikasi > Clink > Izin untuk merekam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso al microfono è disattivato per Clink. Attivalo in Impostazioni > App > Clink > Autorizzazioni per registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkのマイクへのアクセスがオフです。録音するには「設定」>「アプリ」>「Clink」>「権限」でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink의 마이크 접근이 꺼져 있어요. 녹음하려면 설정 > 앱 > Clink > 권한에서 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon dimatikan untuk Clink. Hidupkannya dalam Tetapan > Apl > Clink > Kebenaran untuk merakam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofontilgang er av for Clink. Slå den på i Innstillinger > Apper > Clink > Tillatelser for å ta opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfoontoegang staat uit voor Clink. Zet het aan via Instellingen > Apps > Clink > Rechten om op te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do mikrofonu jest wyłączony dla Clink. Aby nagrywać, włącz go w Ustawienia > Aplikacje > Clink > Uprawnienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone está desativado para o Clink. Ative-o em Configurações > Apps > Clink > Permissões para gravar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul la microfon este dezactivat pentru Clink. Activează-l din Setări > Aplicații > Clink > Permisiuni pentru a înregistra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к микрофону для Clink выключен. Чтобы записывать, включите его в Настройки > Приложения > Clink > Разрешения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prístup k mikrofónu je pre Clink vypnutý. Ak chcete nahrávať, zapnite ho v Nastavenia > Aplikácie > Clink > Povolenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonåtkomst är avstängd för Clink. Slå på den i Inställningar > Appar > Clink > Behörigheter för att spela in."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink için mikrofon erişimi kapalı. Kayıt için Ayarlar > Uygulamalar > Clink > İzinler’den açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до мікрофона для Clink вимкнено. Щоб записувати, увімкніть його в Налаштування > Застосунки > Clink > Дозволи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập micrô đang tắt với Clink. Hãy bật trong Cài đặt > Ứng dụng > Clink > Quyền để ghi âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 的麦克风访问已关闭。要录音，请在“设置”>“应用”>“Clink”>“权限”中开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 的麥克風存取權已關閉。請前往「設定」>「應用程式」>「Clink」>「權限」開啟，才能錄音。"
          }
        }
      }
    },
    "Priority": {
