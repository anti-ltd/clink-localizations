    "The keys squeeze to one side, in reach of one thumb.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tasten rücken an eine Seite, erreichbar mit einem Daumen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas se juntan a un lado, al alcance de un pulgar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvid koonduvad ühele poole, ühe pöidla ulatusse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches se resserrent d’un côté, à portée d’un pouce."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk egy oldalra húzódnak, egy hüvelykujjal elérhetően."
          }
        },
        "it": {
          "stringUnit": {
