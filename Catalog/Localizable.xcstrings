    "Clipboard features need Full Access because iOS requires it to read the pasteboard.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Knipbordkenmerke benodig Volle Toegang omdat iOS dit vereis om die plakbord te lees."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Zwischenablage-Funktionen braucht es Vollzugriff, weil iOS das zum Lesen der Zwischenablage verlangt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones del portapapeles necesitan acceso completo porque iOS lo pide para leerlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lõikelaua funktsioonid vajavad täisjuurdepääsu, sest iOS nõuab seda lõikelaua lugemiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctions du presse-papiers ont besoin de l'accès complet, parce que iOS l'exige pour lire le presse-papiers."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágólapfunkciókhoz teljes hozzáférés kell, mert az iOS enélkül nem engedi olvasni a vágólapot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le funzioni appunti hanno bisogno dell'accesso completo perché iOS lo richiede per leggere gli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード機能にはフルアクセスが必要です。ペーストボードを読むのに iOS がそれを求めるからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 클립보드를 읽으려면 전체 접근이 필요해서, 클립보드 기능도 전체 접근이 있어야 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciri papan keratan perlukan Akses Penuh sebab iOS memerlukannya untuk membaca papan keratan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As funcionalidades da área de transferência precisam de acesso total porque o iOS exige-o para ler a área de transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Функциям буфера обмена нужен полный доступ: без него iOS не даёт читать буфер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板功能需要完全访问，因为 iOS 规定这样才能读剪贴板。"
          }
        }
      }
    },
