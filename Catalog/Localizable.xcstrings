    "Read and replace clipboard contents. Requires Full Access.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee y reemplaza el contenido del portapapeles. Requiere acceso total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit et remplace le contenu du presse-papiers. Nécessite l’accès complet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest und ersetzt den Inhalt der Zwischenablage. Benötigt vollen Zugriff."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge e sostituisce il contenuto degli appunti. Richiede accesso completo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê e substitui o conteúdo da área de transferência. Requer acesso completo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтение и замена содержимого буфера обмена. Нужен полный доступ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca dan gantikan kandungan papan klip. Memerlukan Akses Penuh."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágólap tartalmának olvasása és cseréje. Teljes hozzáférés szükséges."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードの内容を読み取り、置き換えます。フルアクセスが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
