    "Swipe works fully offline. The first letter shows right away, then gets replaced by the full word once the glide is read.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Swiep werk ten volle vanlyn. Die eerste letter wys dadelik en word dan vervang deur die volle woord sodra die gly gelees is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wischen funktioniert komplett offline. Der erste Buchstabe erscheint sofort und wird dann durch das ganze Wort ersetzt, sobald die Bewegung gelesen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El deslizamiento funciona del todo sin conexión. La primera letra aparece enseguida y luego la reemplaza la palabra completa en cuanto se lee el trazo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pühkimine töötab täielikult ühenduseta. Esimene tähe ilmub kohe ja asendatakse seejärel tervelt sõnaga, kui liug on loetud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le balayage marche entièrement hors ligne. La première lettre s'affiche tout de suite, puis elle est remplacée par le mot complet une fois le tracé lu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A húzás teljesen offline működik. Az első betű azonnal megjelenik, majd a húzás beolvasása után lecserélődik a teljes szóra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scorrimento funziona del tutto offline. La prima lettera compare subito, poi viene sostituita dalla parola completa una volta letto lo scorrimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプは完全にオフラインで動きます。最初の文字がすぐに表示され、なぞりを読み取ると単語全体に置き換わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스와이프는 완전히 오프라인으로 돼요. 첫 글자가 바로 나오고, 궤적을 다 읽으면 완전한 단어로 바뀌어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret berfungsi sepenuhnya luar talian. Huruf pertama muncul serta-merta, kemudian diganti dengan perkataan penuh sebaik luncuran dibaca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O deslize funciona totalmente offline. A primeira letra aparece logo e depois é substituída pela palavra completa assim que o traço é lido."
          }
        },
        "ru": {
          "stringUnit": {
