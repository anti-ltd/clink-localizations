    "^[%@ active day](inflect: true)": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "^[%@ aktiewe dag](verbuig: waar)"
          }
        },
        "de": {
