        }
      }
    },
    "How much of the screen the effect fills. Higher packs in more particles.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel van die skerm vul die effek. Hoër pakke in meer deeltjies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel vom Bildschirm der Effekt ausfüllt. Höhere Werte erzeugen mehr Partikel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánta parte de la pantalla llena el efecto. Los valores más altos concentran más partículas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui palju ekraanist efekt täidab. Suurem väärtus lisab rohkem osakesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle part de l'écran l'effet remplit. Plus haut, plus de particules s'accumulent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyit tölt ki az effektus a képernyőből. A magasabb érték több részecskét sűrít be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanta parte dello schermo riempie l'effetto. Più alto è il valore, più particelle si concentrano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エフェクトが画面のどれだけを埋めるか。値を上げるとパーティクルが増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "효과가 화면의 얼마나 많은 부분을 채우는지 설정합니다. 높을수록 입자가 더 많이 들어갑니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak skrin dipenuhi oleh kesan. Lebih tinggi, lebih banyak zarah dimuatkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto do ecrã o efeito preenche. Valores mais altos concentram mais partículas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какую часть экрана заполняет эффект. Выше — больше частиц."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "效果在屏幕上占据多大面积。数值越高，粒子越多。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de mult din ecran umple efectul. Pachete mai mari în mai multe particule."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel van het scherm het effect vult. Hogere verpakkingen in meer deeltjes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "效果在螢幕上佔據多大面積。數值越高，粒子越多。"
          }
        },
        "pl": {
