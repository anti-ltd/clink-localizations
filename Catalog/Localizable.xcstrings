    "Change whatever you like afterwards. The saved one stays as it was.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verander daarna waarvan jy hou. Die geredde bly soos dit was."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach kannst du ändern, was du willst. Das gesicherte Profil bleibt, wie es war."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después cambia lo que quieras. El perfil guardado se queda como estaba."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pärast võid muuta, mida iganes tahad. Salvestatud profiil jääb endisels kujul."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, change ce que tu veux. Le profil enregistré reste tel quel."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Utána nyugodtan változtass bármit. A mentett profil olyan marad, amilyen volt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo cambia quello che vuoi. Il profilo salvato resta com'era."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとは自由に変更してかまいません。保存したプロファイルはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그다음에는 무엇을 바꿔도 됩니다. 저장된 프로필은 그대로 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas itu ubah apa sahaja. Profil yang disimpan kekal seperti asal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois muda o que quiseres. O perfil guardado fica como estava."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дальше меняйте что угодно. Сохранённый вариант останется прежним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后随便改。存下来的那个还是原样。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbați tot ce vă place după aceea. Cel salvat rămâne așa cum a fost."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verander daarna wat je maar wilt. De geredde blijft zoals hij was."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後隨便改。存下來的那個還是原樣。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Później zmień co chcesz. Zbawiony pozostaje taki, jaki był."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінюйте все, що вам подобається, потім. Врятований залишається таким, яким був."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha sonra dilediğinizi değiştirin. Kurtarılan olduğu gibi kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poté změňte, co chcete. Zachráněný zůstává tak, jak byl."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potom zmeňte, čo sa vám páči. Zachránený zostáva tak, ako bol."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλαξε ό,τι σου αρέσει μετά. Ο σωζόμενος μένει όπως ήταν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändra vad du vill efteråt. Den frälsta stannar som den var."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift hvad du kan lide bagefter. Den frelste bliver som den var."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endre hva du vil etterpå. Den frelste blir som den var."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuta mitä haluat jälkeenpäin. Pelastettu pysyy entisellään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah apa pun yang Anda suka setelahnya. Orang yang diselamatkan tetap seperti semula."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi bất cứ điều gì bạn thích sau đó. Người được cứu vẫn như cũ."
          }
        }
      }
    },
    "Change your whole setup mid-sentence, without leaving the field": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verander jou hele opstelling middelsin, sonder om die veld te verlaat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle dein ganzes Setup mitten im Satz, ohne das Feld zu verlassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia toda tu configuración a mitad de frase, sin salir del campo"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaheta kogu oma seadistus lause keskel, ilma väljalt lahkumata"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change toute ta config en pleine phrase, sans quitter le champ"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Váltsd le a teljes beállításodat mondat közben, a mező elhagyása nélkül"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia tutta la configurazione a metà frase, senza lasciare il campo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄から離れずに、文の途中でセットアップをまるごと切り替え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력란을 벗어나지 않고 문장 도중에 설정을 통째로 바꿔보세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar seluruh persediaan anda di tengah ayat, tanpa meninggalkan medan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda toda a configuração a meio da frase, sem sair do campo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смените всю настройку посреди предложения, не выходя из поля"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写到一半也能整套换掉配置，不用离开输入框"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbați-vă întreaga configurație la mijlocul propoziției, fără a părăsi câmpul"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verander uw hele opstelling midden in een zin, zonder het veld te verlaten"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫到一半也能整套換掉配置，不用離開輸入框"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmień całą konfigurację w połowie zdania, bez opuszczania pola"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змініть усе налаштування на півслові, не залишаючи поля"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahadan ayrılmadan tüm kurulumunuzu cümlenin ortasında değiştirin"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změňte celé nastavení uprostřed věty, aniž byste opustili pole"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmeňte celé nastavenie uprostred vety bez toho, aby ste opustili pole"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάξτε ολόκληρη τη ρύθμιση στη μέση πρόταση, χωρίς να φύγετε από το πεδίο"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändra hela din inställning mitt i meningen, utan att lämna fältet"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift hele din opsætning midt i sætningen uden at forlade feltet"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endre hele oppsettet midt i setningen uten å forlate feltet"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuta koko asetusta lauseen puolivälissä poistumatta kentästä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah seluruh pengaturan Anda di tengah kalimat, tanpa meninggalkan lapangan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi toàn bộ thiết lập của bạn ở giữa câu mà không cần rời khỏi trường"
          }
        }
      }
    },
