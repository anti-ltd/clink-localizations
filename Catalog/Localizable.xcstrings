    "This request is too long. Shorten it and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud es demasiado larga. Acórtala e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette requête est trop longue. Raccourcis-la et réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anfrage ist zu lang. Kürze sie und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La richiesta è troppo lunga. Accorciala e riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O pedido é demasiado longo. Encurte-o e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос слишком длинный. Сократите его и попробуйте снова."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan ini terlalu panjang. Pendekkannya dan cuba lagi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kérés túl hosszú. Rövidítsd le, és próbáld újra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが長すぎます。短くして、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求过长。请缩短后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 너무 깁니다. 줄인 후 다시 시도하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Päring on liiga pikk. Lühenda seda ja proovi uuesti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această cerere este prea lungă. Scurtați-l și încercați din nou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verzoek is te lang. Kort het in en probeer het opnieuw."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求過長。請縮短後重試。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie versoek is te lank. Verkort dit en probeer weer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta prośba jest za długa. Skróć go i spróbuj ponownie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей запит занадто довгий. Скоротіть його та повторіть спробу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu istek çok uzun. Kısaltın ve tekrar deneyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento požadavek je příliš dlouhý. Zkraťte to a zkuste to znovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto žiadosť je príliš dlhá. Skráťte to a skúste to znova."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το αίτημα είναι πολύ μεγάλο. Συντομεύστε το και δοκιμάστε ξανά."
          }
        },
        "sv": {
