    "Choose a GIF to copy it, then paste it in your conversation. Some apps accept only a link.": {
      "comment": "GIF browser UI and accessibility. Native-speaker editorial sign-off for this release is tracked in docs/gif-tool-localization-review.md.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a GIF to copy it, then paste it in your conversation. Some apps accept only a link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un GIF para copiarlo y pégalo en tu conversación. Algunas apps solo admiten enlaces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un GIF pour le copier, puis colle-le dans ta conversation. Certaines apps n’acceptent qu’un lien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein GIF aus, um es zu kopieren, und füge es dann in deine Unterhaltung ein. Manche Apps unterstützen nur Links."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una GIF per copiarla, poi incollala nella conversazione. Alcune app accettano solo un link."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um GIF para o copiar e cola-o na tua conversa. Algumas apps só aceitam uma ligação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите GIF, чтобы скопировать его, а затем вставьте в переписку. Некоторые приложения принимают только ссылки."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih GIF untuk menyalinnya, kemudian tampalkannya dalam perbualan anda. Sesetengah app hanya menerima pautan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz ki egy GIF-et a másoláshoz, majd illeszd be a beszélgetésbe. Egyes appok csak hivatkozásokat fogadnak el."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFを選んでコピーし、会話にペーストしてください。リンクのみ対応しているアプリもあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 GIF 进行复制，然后粘贴到对话中。有些 App 只支持链接。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF를 선택해 복사한 다음 대화에 붙여넣으세요. 일부 앱에서는 링크만 사용할 수 있어요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopeerimiseks vali GIF ja kleebi see siis vestlusesse. Mõned rakendused toetavad ainult linke."
          }
        }
      }
    },
