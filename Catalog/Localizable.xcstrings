        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Uueneb aastaselt. Tühista igal ajal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvelé chaque année. Annulable à tout moment."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Évente megújul. Bármikor lemondhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova ogni anno. Annulla quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎年自動更新。いつでもキャンセルできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매년 갱신됩니다. 언제든 해지할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperbaharui setiap tahun. Batal bila-bila masa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova-se anualmente. Cancela quando quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продлевается раз в год. Отменить можно в любой момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每年续订。随时可取消。"
          }
        }
      }
    },
    "Reopen on the category you used last.": {
