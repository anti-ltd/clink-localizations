    "Letters for a script are usually in the private-use area, shown first.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las letras de una escritura suelen estar en el área de uso privado, que se muestra primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lettres d’une écriture se trouvent généralement dans la zone à usage privé, affichée en premier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Buchstaben einer Schrift liegen meist im Bereich für privaten Gebrauch, der zuerst angezeigt wird."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lettere di una scrittura di solito si trovano nell’area a uso privato, mostrata per prima."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As letras de uma escrita costumam ficar na área de uso privado, mostrada primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буквы письменности обычно находятся в области для частного использования — она показана первой."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Huruf bagi sesuatu tulisan biasanya berada dalam kawasan kegunaan peribadi, yang ditunjukkan dahulu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy írásrendszer betűi általában a magánhasználatú tartományban vannak, ezt látod elsőként."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字体系の文字は通常、私用領域にあり、最初に表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一种文字的字母通常位于私用区，会优先显示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자 체계의 글자는 보통 사용자 정의 영역에 있으며 먼저 표시됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirja tähed on tavaliselt erakasutusalas, mida näidatakse esimesena."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Literele pentru un script se află de obicei în zona de utilizare privată, afișată mai întâi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Letters voor een script bevinden zich meestal in het privégedeelte en worden eerst weergegeven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一種文字的字母通常位於私用區，會優先顯示。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Letters vir 'n skrif is gewoonlik in die area vir private gebruik; hulle word eerste gewys."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Litery do scenariusza znajdują się zwykle w obszarze użytku prywatnego, pokazanym jako pierwsze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Літери для сценарію зазвичай знаходяться в області приватного використання, показані першими."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir senaryonun harfleri genellikle özel kullanım alanında ilk önce gösterilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Písmena pro skript jsou obvykle v oblasti soukromého použití, která je zobrazena jako první."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Písmená pre skript sú zvyčajne v oblasti súkromného použitia, ktorá je zobrazená ako prvá."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα γράμματα για ένα σενάριο βρίσκονται συνήθως στην περιοχή ιδιωτικής χρήσης και εμφανίζονται πρώτα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bokstäver för ett manus är vanligtvis i det privata området, visas först."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bogstaver til et script er normalt i det private område, vist først."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bokstaver for et manus er vanligvis i det private bruksområdet, vist først."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käsikirjoituksen kirjaimet ovat yleensä yksityiskäytön alueella, näytetään ensin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Surat untuk naskah biasanya berada di area penggunaan pribadi, ditampilkan terlebih dahulu."
