    "Make up your own language, or open one someone shared with you.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfinde deine eigene Sprache oder öffne eine, die jemand mit dir geteilt hat."
          }
        },
        "es": {
          "stringUnit": {
