    "This theme is too detailed to fit in one QR code. Export its theme file instead.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie tema is te gedetailleerd vir een QR-kode. Voer eerder die temalêer uit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Theme ist zu detailliert für einen einzelnen QR-Code. Exportiere stattdessen die Theme-Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tema es demasiado detallado para un solo código QR. Exporta su archivo de tema."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See teema on ühe QR-koodi jaoks liiga üksikasjalik. Ekspordi selle asemel teemafail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce thème est trop détaillé pour tenir dans un seul code QR. Exportez plutôt son fichier de thème."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह थीम एक QR कोड में समाने के लिए बहुत विस्तृत है। इसके बजाय थीम फ़ाइल निर्यात करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a téma túl részletes ahhoz, hogy egy QR-kódba beleférjen. Exportáld inkább a témafájlt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo tema è troppo dettagliato per un solo codice QR. Esporta invece il file del tema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテーマは詳細すぎて1つのQRコードに収まりません。代わりにテーマファイルを書き出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 테마는 하나의 QR 코드에 담기에는 너무 상세합니다. 대신 테마 파일을 내보내세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema ini terlalu terperinci untuk dimuatkan dalam satu kod QR. Eksport fail tema sebagai ganti."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो थिम एउटै QR कोडमा अटाउन धेरै विस्तृत छ। यसको सट्टा थिम फाइल निर्यात गर्नुहोस्।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tema tem demasiados detalhes para caber num só código QR. Exporte o ficheiro do tema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта тема слишком подробная, чтобы поместиться в одном QR-коде. Экспортируйте файл темы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tema tek bir QR koduna sığmayacak kadar ayrıntılı. Bunun yerine tema dosyasını dışa aktarın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此主题内容过多，无法放入一个二维码。请改为导出主题文件。"
          }
        }
      }
    },
    "This theme uses multiple QR codes. Scan or import every image to receive the complete theme.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This theme uses multiple QR codes. Scan or import every image to receive the complete theme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tema usa varios códigos QR. Escanea o importa todas las imágenes para recibir el tema completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce thème utilise plusieurs codes QR. Scanne ou importe toutes les images pour recevoir le thème complet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Design verwendet mehrere QR-Codes. Scanne oder importiere alle Bilder, um das vollständige Design zu erhalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo tema usa più codici QR. Scansiona o importa tutte le immagini per ricevere il tema completo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tema usa vários códigos QR. Lê ou importa todas as imagens para receberes o tema completo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этой темы нужно несколько QR-кодов. Отсканируйте или импортируйте все изображения, чтобы получить тему целиком."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema ini menggunakan beberapa kod QR. Imbas atau import semua imej untuk mendapatkan tema yang lengkap."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a téma több QR-kódból áll. A teljes téma átvételéhez olvasd be vagy importáld az összes képet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテーマは複数のQRコードに分かれています。テーマ全体を受け取るには、すべての画像をスキャンまたは読み込んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此主题包含多个二维码。请扫描或导入所有图片，以获取完整主题。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 테마는 여러 QR 코드로 나뉘어 있습니다. 전체 테마를 받으려면 모든 이미지를 스캔하거나 가져오세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See teema kasutab mitut QR-koodi. Terve teema saamiseks skanni või impordi kõik pildid."
          }
        }
      }
    },
    "This will overwrite all your current settings. Your themes are kept.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit sal al jou huidige instellings oorskryf. Jou temas word behou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit werden alle deine aktuellen Einstellungen überschrieben. Deine Designs bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sobrescribirá toda tu configuración actual. Tus temas se mantienen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See kirjutab kõik sinu praegused seaded üle. Sinu teemad jäävad alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça va écraser tous tes réglages actuels. Tes thèmes sont gardés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez felülír minden mostani beállítást. A témáid megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così sovrascrivi tutte le tue impostazioni attuali. I tuoi temi restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今の設定はすべて上書きされます。テーマはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 설정이 전부 덮어써져요. 테마는 그대로 남아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menulis ganti semua tetapan semasa anda. Tema anda dikekalkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto vai substituir todas as tuas definições atuais. Os teus temas ficam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это перезапишет все текущие настройки. Темы останутся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会覆盖你当前的所有设置。主题会保留下来。"
          }
        }
      }
    },
    "Those are three separate switches, so you can drop the one that's bothering you and keep the rest.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit is drie afsonderlike skakelaars, so jy kan die een wat jou pla laat val en die res hou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind drei getrennte Schalter — du kannst also genau den abschalten, der stört, und den Rest behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son tres interruptores distintos, así que puedes quitar el que te molesta y dejar los demás."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Need on kolm eraldi lülitit, seega saad tülitava välja jätta ja ülejäänud hoida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont trois interrupteurs distincts : tu peux couper celui qui te gêne et garder les autres."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez három külön kapcsoló, így pont azt kapcsolhatod ki, amelyik zavar, a többi maradhat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono tre interruttori separati: puoi togliere quello che ti dà fastidio e tenere gli altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは3つの別々のスイッチなので、気になるものだけをオフにして、ほかは残せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각각 다른 스위치 세 개라서, 거슬리는 것만 끄고 나머지는 그대로 둘 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu tiga suis berasingan, jadi anda boleh matikan yang mengganggu dan kekalkan yang lain."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "São três interruptores diferentes, por isso podes desligar o que te incomoda e manter os outros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это три отдельных переключателя, так что можно убрать тот, который мешает, и оставить остальные."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是三个独立开关，可以只关掉烦人的那个，其余照旧。"
          }
        }
      }
    },
    "Three steps, and then you can type with it anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drie stappe, en dan kan jy enige plek daarmee tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Schritte, danach tippst du überall damit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres pasos y ya puedes escribir con él en cualquier sitio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolm sammu ja seejärel saad sellega kõikjal tipida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois étapes, et tu écris avec partout."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Három lépés, és bárhol vele gépelhetsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre passaggi e poi scrivi con Clink ovunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3ステップで、どのアプリでも使えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 단계면 어디서든 쓸 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiga langkah, kemudian anda boleh menaip dengannya di mana-mana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Três passos e passas a escrever com ele em todo o lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три шага — и можно печатать где угодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三步就能在任何地方用它打字。"
          }
        }
      }
    },
    "Tidy up what I say and use British spelling.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maak netjies wat ek sê en gebruik Britse spelling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring das Gesagte in Form und verwende britische Schreibweise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena lo que digo y usa ortografía británica."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrasta, mida ma ütlen, ja kasuta briti õigekirja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mets de l'ordre dans ce que je dis et utilise l'orthographe britannique."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozd rendbe, amit mondok, és használj brit helyesírást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema quello che dico e usa l'ortografia britannica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容を整えて、イギリス式のつづりにして。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 말한 내용을 다듬고 영국식 철자를 써 줘."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemaskan apa yang saya sebut dan guna ejaan British."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arruma o que digo e usa a ortografia britânica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привести сказанное в порядок и использовать британское написание."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把我说的整理一下，并使用英式拼写。"
          }
        }
      }
    },
