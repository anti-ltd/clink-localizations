        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posunutá čepice se označuje z akce."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posunutá čiapočka sa označuje z akcie."
          }
        },
        "el": {
