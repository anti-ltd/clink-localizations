            "state": "translated",
            "value": "Émet un son à chaque appui de touche."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden billentyűnyomásnál szóljon egy hang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai un suono a ogni tasto premuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを押すたびに音を鳴らします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누를 때마다 소리를 내요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainkan bunyi pada setiap tekanan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
