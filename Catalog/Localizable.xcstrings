    "Cling keeps the clips and saved notes you pin from the keyboard. Enable sharing for either tool above.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling hou die snitte en gestoorde notas wat jy van die sleutelbord vaspen. Aktiveer deling vir enige nutsding hierbo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling bewahrt Clips und gespeicherte Notizen auf, die du über die Tastatur anheftest. Aktiviere oben die Freigabe für eines der beiden Werkzeuge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling guarda los clips y las notas que fijes desde el teclado. Activa arriba el uso compartido para cualquiera de las dos herramientas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling hoiab klippe ja salvestatud märkmeid, mida sa klaviatuurilt kinnitad. Lülita ülal sisse mõlema tööriista jagamine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling conserve les extraits et les notes enregistrées que tu épingles depuis le clavier. Active le partage pour l’un des deux outils ci-dessus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cling megőrzi a billentyűzetről kitűzött klipeket és mentett jegyzeteket. Kapcsold be fent a megosztást valamelyik eszközhöz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling conserva gli appunti e le note salvate che fissi dalla tastiera. Attiva qui sopra la condivisione per uno dei due strumenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clingは、キーボードからピン留めしたクリップや保存済みメモを保管します。上のいずれかのツールで共有を有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling은 키보드에서 고정한 클립과 저장된 메모를 보관합니다. 위 도구 중 하나에서 공유를 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling menyimpan klip dan nota tersimpan yang anda pin daripada papan kekunci. Dayakan perkongsian untuk salah satu alat di atas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cling guarda os recortes e as notas que afixar a partir do teclado. Ative acima a partilha para uma das ferramentas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling хранит фрагменты и заметки, которые вы закрепляете с клавиатуры. Включите обмен для любого из инструментов выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling 会保存你从键盘置顶的剪贴内容和已存笔记。请为上方任一工具开启共享。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling păstrează clipurile și notele salvate pe care le fixați de la tastatură. Activați partajarea pentru oricare dintre instrumentele de mai sus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling bewaart de clips en opgeslagen notities die u vanaf het toetsenbord vastzet. Schakel delen in voor beide tools hierboven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling 會儲存你從鍵盤置頂的剪貼內容和已存筆記。請為上方任一工具開啟共享。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling przechowuje klipy i zapisane notatki, które przypinasz do klawiatury. Włącz udostępnianie dla któregokolwiek z powyższych narzędzi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling зберігає кліпи та збережені нотатки, які ви закріплюєте з клавіатури. Увімкніть спільний доступ для будь-якого інструмента вище."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling, klavyeden sabitlediğiniz klipleri ve kayıtlı notları saklar. Yukarıdaki araçlardan herhangi biri için paylaşımı etkinleştirin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling uchovává klipy a uložené poznámky, které připnete z klávesnice. Povolit sdílení pro oba výše uvedené nástroje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling uchováva klipy a uložené poznámky, ktoré pripnete z klávesnice. Povoliť zdieľanie pre ktorýkoľvek z vyššie uvedených nástrojov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Cling διατηρεί τα κλιπ και τις αποθηκευμένες σημειώσεις που καρφιτσώνετε από το πληκτρολόγιο. Ενεργοποιήστε την κοινή χρήση για οποιοδήποτε από τα παραπάνω εργαλεία."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling behåller klippen och sparade anteckningar som du fäster från tangentbordet. Aktivera delning för båda verktygen ovan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling gemmer klippene og de gemte noter, du fastgør fra tastaturet. Aktiver deling for begge værktøjer ovenfor."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling beholder klippene og de lagrede notatene du fester fra tastaturet. Aktiver deling for begge verktøyene ovenfor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling säilyttää näppäimistöltä kiinnittämäsi leikkeet ja tallennetut muistiinpanot. Ota jakaminen käyttöön kummassakin yllä olevassa työkalussa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling menyimpan klip dan catatan tersimpan yang Anda pin dari keyboard. Aktifkan berbagi untuk salah satu alat di atas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling giữ các clip và ghi chú đã lưu mà bạn ghim từ bàn phím. Cho phép chia sẻ cho một trong hai công cụ ở trên."
          }
        }
      }
    },
    "Cling keeps the clips you pin from the keyboard's clipboard panel. Turn on Clipboard history to send to it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling hou die knipsels wat jy vasspeld van die sleutelbord se knipbordpaneel af. Skakel knipbordgeskiedenis aan om daarnatoe te stuur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling behält die Clips, die du aus der Zwischenablage des Tastatur-Panels anheftest. Schalte den Zwischenablageverlauf ein, um zu senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling guarda los clips que fijas desde el panel del portapapeles del teclado. Activa el historial del portapapeles para enviarlos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling hoiab klippe, mida sa klaviatuuri lõikelaua paneelilt kinnitad. Lülita sisse Lõikelaua ajalugu, et sinna saata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling garde les clips que tu épingles depuis le panneau presse-papiers du clavier. Active l'historique du presse-papiers pour envoyer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cling megőrzi a vágólap-panelből rögzített klippeket. Kapcsold be a Vágólap-előzményeket a küldéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling conserva le clip che fissi dal pannello appunti della tastiera. Attiva la cronologia degli appunti per inviarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clingはキーボードのクリップボードパネルからピン留めしたクリップを保持します。送信するにはクリップボード履歴をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling이 키보드 클립보드 패널에서 고정한 클립을 보관합니다. 보내려면 클립보드 기록을 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling menyimpan klip yang anda semat dari panel papan keratan papan kekunci. Hidupkan Sejarah papan keratan untuk menghantar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cling guarda os clipes que fixas a partir do painel da área de transferência do teclado. Liga o histórico da área de transferência para os enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling хранит фрагменты, которые вы закрепляете в панели буфера обмена. Включите «Историю буфера обмена», чтобы отправлять их туда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling 会保存你从键盘剪贴板面板固定的剪辑。开启剪贴板历史即可发送。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling păstrează clipurile pe care le fixați din panoul clipboard al tastaturii. Activați istoricul Clipboard pentru a-l trimite."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling bewaart de clips die u vastmaakt van het klembordpaneel van het toetsenbord. Schakel de Klembordgeschiedenis in om ernaar te verzenden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling 會儲存你從鍵盤剪貼簿面板固定的剪輯。開啟剪貼簿歷史即可傳送。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling przechowuje klipy, które przypinasz, do panelu schowka klawiatury. Włącz historię schowka, aby do niego wysyłać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling зберігає кліпи, які ви закріплюєте з панелі буфера обміну клавіатури. Увімкніть історію буфера обміну, щоб надіслати в нього."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling, klavyenin pano panelinden sabitlediğiniz klipleri saklar. Göndermek için Pano geçmişini açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling uchovává klipy, které připnete z panelu schránky klávesnice. Chcete-li do ní odesílat zprávy, zapněte historii schránky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling uchováva klipy, ktoré pripnete z panela schránky klávesnice. Ak chcete odosielať do schránky, zapnite históriu schránky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Cling διατηρεί τα κλιπ που καρφιτσώνετε από το πλαίσιο του προχείρου του πληκτρολογίου. Ενεργοποιήστε το ιστορικό του Προχείρου για αποστολή σε αυτό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling behåller klippen du fäster från tangentbordets urklippspanel. Aktivera Urklippshistorik för att skicka till den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling beholder de klip, du fastgør, fra tastaturets udklipsholderpanel. Slå Udklipsholderhistorik til for at sende til den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling beholder klippene du fester fra tastaturets utklippstavlepanel. Slå på utklippstavleloggen for å sende til den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling säilyttää näppäimistön leikepöytäpaneelista kiinnittämäsi leikkeet. Ota leikepöydän historia käyttöön lähettääksesi sille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling menyimpan klip yang Anda sematkan dari panel papan klip keyboard. Aktifkan riwayat Clipboard untuk mengirimkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling giữ các clip bạn ghim từ bảng clipboard của bàn phím. Bật lịch sử Clipboard để gửi tới nó."
          }
        }
      }
    },
