    "Removes every word Clink picked up from your typing. Custom words stay.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwyder elke woord wat geklink word van jou tikwerk. Gepasmaakte woorde bly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt alle Wörter, die Clink aus deinem Tippen übernommen hat. Eigene Wörter bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todas las palabras que Clink aprendió de tu escritura. Se conservan las palabras personalizadas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemaldab kõik sõnad, mille Clink sinu tippimisest õppis. Kohandatud sõnad jäävad alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime tous les mots que Clink a appris en tapant. Les mots personnalisés restent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolít minden szót, amit Clink a gépelésedből tanult. A saját szavak megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove tutte le parole che Clink ha imparato dalla tua digitazione. Le parole personalizzate restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink が入力から学習した単語をすべて削除します。カスタム単語は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink가 입력에서 학습한 모든 단어를 제거합니다. 사용자 단어는 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengalih keluar semua perkataan yang dipelajari Clink daripada taipan anda. Perkataan tersuai kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove todas as palavras que o Clink aprendeu com a sua digitação. As palavras personalizadas permanecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет все слова, которые Clink выучил из вашего ввода. Пользовательские слова сохраняются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 Clink 从你的输入中学到的所有词语。自定义词语会保留。"
          }
        }
      }
    },
    "Removes the restarts recorded on this device. Nothing else changes.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwyder die herbeginsels wat op hierdie toestel aangeteken is. Niks anders verander nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt die auf diesem Gerät gespeicherten Neustarts. Sonst ändert sich nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina los reinicios guardados en este dispositivo. No cambia nada más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemaldab sellesse seadmesse salvestatud taaskäivitused. Midagi muud ei muutu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les redémarrages enregistrés sur cet appareil. Rien d'autre ne change."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törli az ezen az eszközön rögzített újraindulásokat. Más nem változik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove i riavvii registrati su questo dispositivo. Nient'altro cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末に記録された再起動を削除します。ほかには何も変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 기록된 다시 시작 항목을 지워요. 다른 건 그대로예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuang mula semula yang direkodkan pada peranti ini. Tiada apa-apa lagi berubah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove os reinícios registados neste dispositivo. Não muda mais nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет записи о перезапусках на этом устройстве. Больше ничего не меняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
