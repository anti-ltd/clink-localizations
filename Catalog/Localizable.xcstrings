    "Shortcuts expand instantly, even with autocorrect off": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kürzel werden sofort erweitert, auch bei ausgeschalteter Autokorrektur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos se expanden al instante, incluso con la autocorrección apagada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis se développent instantanément, même avec la correction auto désactivée"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rövidítések azonnal kibővülnek, még kikapcsolt automatikus javítással is"
          }
        },
        "it": {
          "stringUnit": {
