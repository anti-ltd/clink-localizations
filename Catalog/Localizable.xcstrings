    "Panel replaces the keyboard with a full translator. Paste text, pick a language, read and insert the result. Big and easy to reach.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneel vervang die sleutelbord met 'n volledige vertaler. Plak teks, kies 'n taal, lees en voeg die resultaat in. Groot en maklik bereikbaar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Panel ersetzt die Tastatur durch einen vollen Übersetzer. Text einfügen, Sprache wählen, Ergebnis lesen und einfügen. Groß und gut erreichbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El panel cambia el teclado por un traductor a pantalla completa. Pega texto, elige un idioma, lee el resultado e insértalo. Grande y fácil de alcanzar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneel asendab klaviatuuri täistõlkijaga. Kleebi tekst, vali keel, loe ja sisesta tulemus. Suur ja hõlpsasti kättesaadav."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le panneau remplace le clavier par un traducteur plein écran. Colle du texte, choisis une langue, lis et insère le résultat. Grand et facile à atteindre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A panel a billentyűzetet egy teljes fordítóra cseréli. Illessz be szöveget, válassz nyelvet, olvasd el és illeszd be az eredményt. Nagy és könnyen elérhető."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pannello sostituisce la tastiera con un traduttore a tutto schermo. Incolla il testo, scegli una lingua, leggi e inserisci il risultato. Grande e comodo da usare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルはキーボードを丸ごと翻訳ツールに切り替えます。テキストを貼って、言語を選び、結果を読んで挿入できます。大きくて使いやすいです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널은 키보드를 통째로 번역기로 바꿔줘요. 텍스트를 붙여넣고, 언어를 고르고, 결과를 읽고 넣어보세요. 크고 쓰기 편해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel gantikan papan kekunci dengan penterjemah penuh. Tampal teks, pilih bahasa, baca dan masukkan hasilnya. Besar dan senang dicapai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O painel troca o teclado por um tradutor completo. Cola o texto, escolhe uma língua, lê e insere o resultado. Grande e fácil de alcançar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Панель» заменяет клавиатуру полноценным переводчиком. Вставьте текст, выберите язык, прочитайте и вставьте результат. Крупно и удобно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个面板会把键盘换成一个完整的翻译器。粘上文本、选好语言，看结果再插入。又大又好用。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Panoul înlocuiește tastatura cu un traducător complet. Lipiți text, alegeți o limbă, citiți și introduceți rezultatul. Mare și ușor de ajuns."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneel vervangt het toetsenbord door een volledige vertaler. Plak tekst, kies een taal, lees en voeg het resultaat in. Groot en gemakkelijk te bereiken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個面板會把鍵盤換成一個完整的翻譯器。粘上文字、選好語言，看結果再插入。又大又好用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel zastępuje klawiaturę pełnym tłumaczem. Wklej tekst, wybierz język, przeczytaj i wstaw wynik. Duży i łatwo dostępny."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель замінює клавіатуру на повноцінний перекладач. Вставте текст, виберіть мову, прочитайте та вставте результат. Великий і легкодоступний."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel, klavyeyi tam bir tercümanla değiştirir. Metni yapıştırın, bir dil seçin, okuyun ve sonucu ekleyin. Büyük ve ulaşılması kolay."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel nahrazuje klávesnici plnohodnotným překladačem. Vložte text, vyberte jazyk, přečtěte si a vložte výsledek. Velké a snadno dosažitelné."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel nahrádza klávesnicu plnohodnotným prekladačom. Prilepte text, vyberte jazyk, prečítajte si a vložte výsledok. Veľký a ľahko dosiahnuteľný."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο πίνακας αντικαθιστά το πληκτρολόγιο με έναν πλήρη μεταφραστή. Επικολλήστε κείμενο, επιλέξτε μια γλώσσα, διαβάστε και εισαγάγετε το αποτέλεσμα. Μεγάλο και εύκολο στην πρόσβαση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel ersätter tangentbordet med en komplett översättare. Klistra in text, välj ett språk, läs och infoga resultatet. Stor och lätt att nå."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel erstatter tastaturet med en fuld oversætter. Indsæt tekst, vælg et sprog, læs og indsæt resultatet. Stor og nem at nå."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel erstatter tastaturet med en full oversetter. Lim inn tekst, velg et språk, les og sett inn resultatet. Stor og lett tilgjengelig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneeli korvaa näppäimistön täydellä kääntäjällä. Liitä tekstiä, valitse kieli, lue ja lisää tulos. Iso ja helposti tavoitettavissa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel menggantikan keyboard dengan penerjemah lengkap. Tempel teks, pilih bahasa, baca dan masukkan hasilnya. Besar dan mudah dijangkau."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảng điều khiển thay thế bàn phím bằng một trình dịch đầy đủ. Dán văn bản, chọn ngôn ngữ, đọc và chèn kết quả. Lớn và dễ dàng tiếp cận."
          }
        }
      }
    },
