    "Split keyboard, just below it, pulls the keys out to both edges for thumbs instead.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesplete sleutelbord, net onder dit, trek die sleutels uit na albei kante vir duime in plaas daarvan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die geteilte Tastatur direkt darunter zieht die Tasten stattdessen an beide Ränder, für die Daumen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado dividido, justo debajo, lleva las teclas a los dos bordes para los pulgares."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jagatud klaviatuur vahetult allpool tõmbab klahvid hoopis mõlema serva poole pöidlaste jaoks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier scindé, juste en dessous, écarte au contraire les touches vers les deux bords, pour les pouces."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alatta lévő osztott billentyűzet ehelyett mindkét szélre húzza a billentyűket, a hüvelykujjaknak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera divisa, subito sotto, porta invece i tasti verso i due bordi, per i pollici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐ下の分割キーボードは逆に、キーを左右の端に寄せて親指で打てるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 아래의 분할 키보드는 반대로 키를 양쪽 가장자리로 벌려 엄지로 치게 해 줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci berpecah, tepat di bawahnya, sebaliknya menarik kekunci ke kedua-dua tepi untuk ibu jari."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado dividido, mesmo por baixo, puxa antes as teclas para as duas margens, para os polegares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Разделённая клавиатура» чуть ниже, наоборот, разводит клавиши к обоим краям — под большие пальцы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紧挨着的分离键盘则相反，把按键分到左右两边，方便双拇指。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastatura împărțită, chiar sub ea, trage tastele spre ambele margini pentru degetele mari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gesplitste toetsenbord, net eronder, trekt de toetsen naar beide randen uit voor de duimen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "緊挨著的分離鍵盤則相反，把按鍵分到左右兩邊，方便雙拇指。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzielona klawiatura, tuż pod nią, wyciąga klawisze do obu krawędzi, zamiast tego służą kciuki."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розділена клавіатура, трохи нижче, витягує клавіші з обох країв замість великих пальців."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen altındaki bölünmüş klavye, başparmak yerine tuşları her iki kenara doğru çeker."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozdělená klávesnice, těsně pod ní, vytahuje klávesy k oběma okrajům pro palce."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozdelená klávesnica, hneď pod ňou, vytiahne klávesy k obom okrajom pre palce."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το χωρισμένο πληκτρολόγιο, ακριβώς από κάτω του, τραβάει τα πλήκτρα προς τα έξω και στις δύο άκρες για αντίχειρες."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Delat tangentbord, precis under det, drar ut tangenterna till båda kanterna för tummar istället."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdelt tastatur, lige under det, trækker tasterne ud til begge kanter for tommelfingre i stedet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Delt tastatur, rett under det, trekker tastene ut til begge kanter for tomler i stedet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaettu näppäimistö, juuri sen alapuolella, vetää näppäimet ulos molemmista reunoista peukaloita varten."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard terpisah, tepat di bawahnya, menarik tombol ke kedua tepinya sebagai ibu jari."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bàn phím chia đôi, ngay bên dưới, thay vào đó kéo các phím ra cả hai cạnh để dành cho ngón tay cái."
          }
        }
      }
    },
