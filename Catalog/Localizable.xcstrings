    "Your typing stats are computed locally and never leave your phone. Nothing is uploaded, shared, or sold.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou tikstatistieke word plaaslik bereken en verlaat nooit jou foon nie. Niks word opgelaai, gedeel of verkoop nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tippstatistiken werden lokal berechnet und verlassen nie dein iPhone. Nichts wird hochgeladen, geteilt oder verkauft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus estadísticas de escritura se calculan en el dispositivo y nunca salen de tu iPhone. No se sube, comparte ni vende nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu tipimisstatistika arvutatakse lokaalselt ega lahku kunagi sinu telefonist. Midagi ei laadita üles, ei jagata ega müüda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes statistiques de frappe sont calculées sur l'appareil et ne quittent jamais ton iPhone. Rien n'est envoyé, partagé ou vendu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gépelési statisztikák helyben készülnek, és sosem hagyják el az iPhone-odat. Semmit sem töltünk fel, osztunk meg vagy adunk el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le statistiche di scrittura vengono calcolate sul dispositivo e non lasciano mai il tuo iPhone. Nulla viene caricato, condiviso o venduto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力統計はデバイス上で計算され、iPhoneの外に出ることはありません。アップロード、共有、販売は一切行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 통계는 기기에서 계산되며 iPhone 밖으로 나가지 않아요. 업로드하거나 공유하거나 판매하지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik menaip dikira secara setempat dan tidak pernah keluar daripada iPhone anda. Tiada apa-apa dimuat naik, dikongsi atau dijual."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As estatísticas de escrita são calculadas no dispositivo e nunca saem do teu iPhone. Nada é enviado, partilhado ou vendido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша статистика набора вычисляется локально и никогда не покидает телефон. Ничего не загружается, не передаётся и не продаётся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入统计数据在设备本地计算，绝不会离开你的 iPhone。不会上传、共享或出售任何内容。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Statisticile de tastare sunt calculate local și nu părăsesc telefonul. Nimic nu este încărcat, distribuit sau vândut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw typstatistieken worden lokaal berekend en verlaten uw telefoon nooit. Er wordt niets geüpload, gedeeld of verkocht."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入統計資料在裝置本地計算，絕不會離開你的 iPhone。不會上傳、共享或出售任何內容。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Statystyki pisania są obliczane lokalnie i nigdy nie opuszczają telefonu. Nic nie jest przesyłane, udostępniane ani sprzedawane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша статистика набору тексту обчислюється локально й ніколи не залишає ваш телефон. Нічого не завантажується, не ділиться та не продається."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazma istatistikleriniz yerel olarak hesaplanır ve asla telefonunuzdan ayrılmaz. Hiçbir şey yüklenmez, paylaşılmaz veya satılmaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše statistiky psaní se počítají místně a nikdy neopouštějí telefon. Nic se nenahrává, nesdílí ani neprodává."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše štatistiky písania sa vypočítavajú lokálne a nikdy neopúšťajú telefón. Nič sa nenahráva, nezdieľa ani nepredáva."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα στατιστικά στοιχεία πληκτρολόγησης υπολογίζονται τοπικά και δεν αφήνετε ποτέ το τηλέφωνό σας. Τίποτα δεν μεταφορτώνεται, κοινοποιείται ή πωλείται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din skrivstatistik beräknas lokalt och lämnar aldrig din telefon. Ingenting laddas upp, delas eller säljs."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine indtastningsstatistikker beregnes lokalt og forlader aldrig din telefon. Intet bliver uploadet, delt eller solgt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivestatistikken din beregnes lokalt og forlater aldri telefonen. Ingenting blir lastet opp, delt eller solgt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoitustilastot lasketaan paikallisesti, äläkä koskaan poistu puhelimesta. Mitään ei ladata, jaeta tai myydä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik pengetikan Anda dihitung secara lokal dan tidak pernah keluar dari ponsel Anda. Tidak ada yang diunggah, dibagikan, atau dijual."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số liệu thống kê đánh máy của bạn được tính toán cục bộ và không bao giờ rời khỏi điện thoại của bạn. Không có gì được tải lên, chia sẻ hoặc bán."
          }
        }
      }
    },
    "Your whole setup travels as one file. Save it, share it, bring it back anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou hele opstelling reis as een lêer. Stoor dit, deel dit, bring dit enige plek terug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine ganze Einrichtung reist als eine Datei. Sichern, teilen und überall wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda tu configuración viaja en un solo archivo: guárdala, compártela y recupérala donde quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu terve seadistus reisib ühe failina. Salvesta, jaga ja too kusagil tagasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute ta config tient dans un seul fichier. Enregistre-le, partage-le, restaure-le où tu veux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egész beállításod egyetlen fájlban utazik. Mentsd el, oszd meg, és állítsd vissza bárhol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutta la tua configurazione viaggia in un unico file. Salvalo, condividilo, ripristinalo ovunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定はまるごと1つのファイルに。保存して、共有して、どこでも元どおりにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 전체가 파일 하나로 움직여요. 저장하고, 공유하고, 어디서든 다시 불러오세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh persediaan anda bergerak sebagai satu fail. Simpan, kongsi, dan pulihkan di mana-mana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda a tua configuração viaja num único ficheiro. Guarda-o, partilha-o e recupera-o em qualquer lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вся ваша настройка переезжает одним файлом. Сохраните его, поделитесь им, верните где угодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的整套设置就是一个文件，保存、分享，随处找回。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întreaga dvs. configurație se deplasează ca un singur fișier. Salvați-l, distribuiți-l, aduceți-l înapoi oriunde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw hele installatie reist als één bestand. Bewaar het, deel het en breng het overal terug."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的整套設定就是一個檔案，儲存、分享，隨處找回。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cała konfiguracja jest przesyłana jako jeden plik. Zapisz, udostępnij i przynieś gdziekolwiek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі ваші налаштування переміщуються як один файл. Зберігайте, діліться, повертайте куди завгодно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm kurulumunuz tek bir dosya olarak hareket eder. Kaydedin, paylaşın, istediğiniz yere geri getirin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celé vaše nastavení putuje jako jeden soubor. Uložte to, sdílejte to, přineste to kamkoli."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Celé vaše nastavenie putuje ako jeden súbor. Uložte to, zdieľajte to, prineste to späť kamkoľvek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ολόκληρη η εγκατάσταση σας ταξιδεύει ως ένα αρχείο. Αποθηκεύστε το, μοιραστείτε το, φέρτε το οπουδήποτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hela din installation går som en fil. Spara den, dela den, ta tillbaka den var som helst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele din opsætning kører som én fil. Gem det, del det, bring det tilbage hvor som helst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele oppsettet ditt går som én fil. Lagre den, del den, ta den tilbake hvor som helst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koko asetuksesi kulkee yhtenä tiedostona. Tallenna se, jaa se, tuo se takaisin minne tahansa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh pengaturan Anda dikirimkan sebagai satu file. Simpan, bagikan, bawa kembali ke mana saja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toàn bộ thiết lập của bạn di chuyển dưới dạng một tệp. Lưu nó, chia sẻ nó, mang nó trở lại bất cứ nơi nào."
          }
        }
      }
    },
    "Your words": {
