    "Turn on analytics to see your streak, your speed, and your week. It stays on this phone.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel analise aan om jou streep, jou spoed en jou week te sien. Dit bly op hierdie foon."
          }
        },
        "de": {
          "stringUnit": {
