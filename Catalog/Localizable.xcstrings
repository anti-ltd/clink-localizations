    },
    "The label is just what's drawn. The key still types the text above.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die etiket is net wat geteken is. Die sleutel tik steeds die teks hierbo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beschriftung ist nur das, was gezeichnet wird. Die Taste tippt weiterhin den Text oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La etiqueta es solo lo que se dibuja: la tecla sigue escribiendo el texto de arriba."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pealdis on ainult see, mis joonistatakse. Klahv sisestab endiselt ülaltoodud teksti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'étiquette n'est que le dessin. La touche tape toujours le texte ci-dessus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A címke csak a rajzolat. A billentyű továbbra is a fenti szöveget írja be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'etichetta è solo ciò che viene disegnato: il tasto digita comunque il testo qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベルは見た目だけで、キーは引き続き上のテキストを入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이블은 그려지는 모양일 뿐이에요. 키는 여전히 위의 텍스트를 입력해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Label hanyalah apa yang dilukis. Kekunci tetap menaip teks di atas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta é apenas o que é desenhado. A tecla continua a escrever o texto acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подпись — это только то, что нарисовано. Клавиша всё равно вводит текст, указанный выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签只是画出来的样子，按键仍然输入上面的文本。"
          }
        }
      }
    },
