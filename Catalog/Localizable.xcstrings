        }
      }
    },
    "A control id is the anchor a plugin names in section(). A page id is what a clink:// link opens.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bedienelement-ID ist der Anker, den ein Plugin in section() nennt. Eine Seiten-ID ist das, was ein clink://-Link öffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ID de un control es el ancla que un plugin indica en section(). El ID de una página es lo que abre un enlace clink://."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Juhtelemendi ID on ankur, mida pistikprogramm section() sees nimetab. Lehe ID on see, mida clink://-link avab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identifiant d'une commande est l'ancre qu'un plugin nomme dans section(). L'identifiant d'une page est ce qu'ouvre un lien clink://."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vezérlő azonosítója az a horgony, amelyet egy bővítmény a section() hívásban megnevez. Az oldal azonosítója az, amit egy clink:// hivatkozás megnyit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ID di un controllo è l'ancora che un plugin indica in section(). L'ID di una pagina è ciò che apre un link clink://."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントロール ID はプラグインが section() で指定するアンカーです。ページ ID は clink:// リンクが開くものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨트롤 ID는 플러그인이 section()에서 지정하는 앵커입니다. 페이지 ID는 clink:// 링크가 여는 대상입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "ID kawalan ialah sauh yang dinamakan plugin dalam section(). ID halaman ialah apa yang dibuka oleh pautan clink://."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ID de um controlo é a âncora que um plugin indica em section(). O ID de uma página é o que uma ligação clink:// abre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор элемента это якорь, который плагин называет в section(). Идентификатор страницы это то, что открывает ссылка clink://."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控件 ID 是插件在 section() 中指定的锚点。页面 ID 是 clink:// 链接打开的目标。"
          }
        }
      }
    },
    "A couple taps in Settings and you're typing with Clink everywhere.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Paar tik in Instellings en jy tik oral met Clink."
