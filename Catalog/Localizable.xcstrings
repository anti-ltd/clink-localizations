        }
      }
    },
    "These stay put on every layout and in every language.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie bly op elke uitleg en in elke taal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bleiben auf jedem Layout und in jeder Sprache an ihrem Platz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quedan en su sitio en todas las disposiciones y en todos los idiomas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Need jäävad paigale igas paigutuses ja igas keeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles restent en place sur toutes les dispositions et dans toutes les langues."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek minden elrendezésen és minden nyelven a helyükön maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restano al loro posto su ogni disposizione e in ogni lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの配列でも、どの言語でもそのままの位置に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 배열, 모든 언어에서 그 자리에 그대로 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini kekal di tempatnya pada setiap susunan dan dalam setiap bahasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficam no lugar em todas as disposições e em todos os idiomas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они остаются на месте в любой раскладке и на любом языке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有排列和所有语言下都保持原位。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acestea rămân pe fiecare aspect și în fiecare limbă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze blijven op elke lay-out en in elke taal staan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有排列和所有語言下都保持原位。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostają one umieszczone w każdym układzie i w każdym języku."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вони залишаються на кожному макеті та на будь-якій мові."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar her düzende ve her dilde takılı kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ty zůstanou na každém rozvržení a v každém jazyce."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostanú umiestnené na každom rozložení a v každom jazyku."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτά παραμένουν τοποθετημένα σε κάθε διάταξη και σε κάθε γλώσσα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessa stannar kvar på varje layout och på alla språk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse forbliver på ethvert layout og på alle sprog."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse holder seg på alle layouter og på alle språk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pysyvät kaikissa asetteluissa ja kaikilla kielillä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tetap diterapkan pada setiap tata letak dan dalam setiap bahasa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những điều này luôn được đặt trên mọi bố cục và trong mọi ngôn ngữ."
          }
        }
      }
    },
    "These tools live in the keyboard. Add it in Settings to use them while you type.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie gereedskap woon in die sleutelbord. Voeg dit by Instellings om dit te gebruik terwyl jy tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Werkzeuge stecken in der Tastatur. Füge sie in den Einstellungen hinzu, um sie beim Tippen zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas herramientas están en el teclado. Añádelo en Ajustes para usarlas mientras escribes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Need tööriistad elavad klaviatuuril. Lisa ta seadetes, et neid tipimise ajal kasutada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces outils vivent dans le clavier. Ajoute-le dans Réglages pour t'en servir pendant que tu écris."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek az eszközök a billentyűzetben laknak. Add hozzá a Beállításokban, hogy gépelés közben is használhasd őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi strumenti stanno nella tastiera. Aggiungila in Impostazioni per usarli mentre scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのツールはキーボードの中にあります。「設定」でキーボードを追加すると、入力しながら使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 도구들은 키보드 안에 있습니다. 설정에서 키보드를 추가하면 입력하면서 쓸 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat ini berada dalam papan kekunci. Tambahkannya dalam Tetapan untuk menggunakannya sambil menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas ferramentas vivem no teclado. Adiciona-o nas Definições para as usares enquanto escreves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти инструменты живут в клавиатуре. Добавьте её в «Настройках», чтобы пользоваться ими прямо при наборе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些工具都在键盘里。在“设置”中把键盘加上，打字时就能用。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste instrumente trăiesc în tastatură. Adăugați-l în Configurări pentru a le folosi în timp ce introduceți text."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze tools bevinden zich in het toetsenbord. Voeg het toe in Instellingen om ze te gebruiken terwijl u typt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些工具都在鍵盤裡。在“設定”中把鍵盤加上，打字時就能用。"
          }
