    "Build one word across both thumbs. Glide, tap, switch hands, and lift without ending it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Bou een woord oor albei duime. Gly, tik, wissel hande en lig sonder om dit te beëindig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wort mit beiden Daumen bilden: gleiten, tippen, die Hand wechseln und einen Daumen heben, ohne das Wort zu beenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construye una palabra con ambos pulgares: desliza, toca, cambia de mano y levanta uno sin terminarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Koosta üks sõna mõlema pöidlaga: libista, toksa, vaheta kätt ja tõsta üks pöial üles ilma sõna lõpetamata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose un mot avec les deux pouces : glisse, touche, change de main et relève un pouce sans le terminer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Építs egy szót mindkét hüvelykujjal: húzz, koppints, válts kezet, és emeld fel az egyiket a szó befejezése nélkül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Componi una parola con entrambi i pollici: scorri, tocca, cambia mano e sollevane uno senza terminarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の親指で1語を作れます。滑らせる、タップする、手を替える、片方を離す操作でも単語は終わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양쪽 엄지로 한 단어를 만드세요. 밀기, 탭하기, 손 바꾸기, 한쪽 엄지를 떼어도 단어는 끝나지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bina satu perkataan dengan kedua-dua ibu jari: leret, ketik, tukar tangan dan angkat satu ibu jari tanpa menamatkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Constrói uma palavra com os dois polegares: desliza, toca, troca de mão e levanta um sem a terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Составляйте одно слово двумя большими пальцами: скользите, нажимайте, меняйте руку и поднимайте один палец, не завершая слово."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用两个拇指组成一个词：滑动、轻点、换手或抬起一个拇指，都不会结束这个词。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Construiți un cuvânt peste ambele degete mari. Glisați, atingeți, schimbați mâinile și ridicați fără a o opri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouw één woord over beide duimen. Glijden, tikken, van hand wisselen en tillen zonder het te beëindigen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用兩個拇指組成一個詞：滑動、輕點、換手或抬起一個拇指，都不會結束這個詞。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbuduj jedno słowo na obu kciukach. Przesuwaj się, stukaj, zmieniaj ręce i podnoś, nie kończąc tego."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Складіть одне слово на обох великих пальцях. Ковзайте, торкайтеся, змінюйте руки та піднімайте, не закінчуючи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her iki başparmak arasında bir kelime oluşturun. Kaydırın, dokunun, ellerinizi değiştirin ve bitirmeden kaldırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořte jedno slovo přes oba palce. Klouzejte, klepejte, měňte ruce a zvedněte, aniž byste to ukončili."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvorte jedno slovo na oboch palcoch. Kĺzte, ťuknite, vymeňte ruky a zdvíhajte bez toho, aby ste to ukončili."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε μία λέξη και στους δύο αντίχειρες. Γλιστρήστε, χτυπήστε, αλλάξτε τα χέρια και σηκώστε το χωρίς να το τερματίσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygg ett ord över båda tummarna. Glid, knacka, byt händer och lyft utan att ta slut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Byg ét ord på tværs af begge tommelfingre. Glid, bank, skift hænder, og løft uden at afslutte det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygg ett ord over begge tomlene. Gli, trykk, bytt hender og løft uten å avslutte det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakenna yksi sana molempiin peukaloihin. Liu'uta, napauta, vaihda kättä ja nosta lopettamatta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangun satu kata di kedua ibu jari. Meluncur, mengetuk, berpindah tangan, dan mengangkat tanpa mengakhirinya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xây dựng một từ trên cả hai ngón tay cái. Lướt, chạm, đổi tay và nhấc lên không ngừng."
          }
        }
      }
    },
