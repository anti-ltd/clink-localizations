    "Translation runs entirely on this device, so nothing is uploaded either way. Pick the engine above. Language packs may download on first use.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertaling loop geheel en al op hierdie toestel, so niks word in elk geval opgelaai nie. Kies die enjin hierbo. Taalpakke kan afgelaai word met die eerste gebruik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Übersetzen läuft komplett auf diesem Gerät, es wird also so oder so nichts hochgeladen. Wähl oben die Engine. Sprachpakete werden vielleicht bei der ersten Nutzung geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción se hace del todo en este dispositivo, así que en ningún caso se sube nada. Elige el motor de arriba. Los paquetes de idioma pueden descargarse la primera vez que los uses."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlge toimub täielikult selles seadmes, seega ei laadita midagi üles kummalgi juhul. Vali ülal mootor. Keelepaketid võivad esmakordsel kasutamisel alla laadida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction tourne entièrement sur cet appareil, donc rien n'est envoyé dans un sens ou dans l'autre. Choisis le moteur ci-dessus. Les modules linguistiques peuvent se télécharger à la première utilisation."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fordítás teljesen ezen az eszközön fut, így sehogy sem tölt fel semmit. Válaszd ki a motort fent. A nyelvi csomagok az első használatkor letöltődhetnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione gira tutta su questo dispositivo, quindi in nessun caso viene caricato niente. Scegli il motore qui sopra. I pacchetti lingua potrebbero scaricarsi al primo uso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳はすべてこのデバイスの中で行うので、どちらの場合も何もアップロードされません。上でエンジンを選んでください。言語パックは初回に使うときダウンロードされることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역은 전부 이 기기에서 돌아가서, 어느 쪽이든 아무것도 올라가지 않아요. 위에서 엔진을 골라주세요. 언어 팩은 처음 쓸 때 다운로드될 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan berjalan sepenuhnya pada peranti ini, jadi tiada apa dimuat naik walau apa pun. Pilih enjin di atas. Pek bahasa mungkin dimuat turun pada kali pertama guna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução corre toda neste dispositivo, por isso nada é enviado em nenhum dos casos. Escolhe o motor acima. Os pacotes de idioma podem ser transferidos na primeira utilização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод целиком идёт на этом устройстве, так что ничего не загружается в любом случае. Движок выбирается выше. При первом использовании языковые пакеты могут загрузиться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译完全在这台设备上进行，所以哪种方式都不会上传任何内容。在上面选引擎。语言包可能会在第一次用时下载。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducerea rulează în întregime pe acest dispozitiv, așa că nimic nu este încărcat în niciun caz. Alege motorul de mai sus. Pachetele lingvistice se pot descărca la prima utilizare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vertaling draait volledig op dit apparaat, dus er wordt hoe dan ook niets geüpload. Kies de motor hierboven. Taalpakketten kunnen bij het eerste gebruik worden gedownload."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻譯完全在這臺裝置上進行，所以哪種方式都不會上傳任何內容。在上面選引擎。語言包可能會在第一次用時下載。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tłumaczenie odbywa się w całości na tym urządzeniu, więc nic nie jest przesyłane w żaden sposób. Wybierz silnik powyżej. Pakiety językowe mogą zostać pobrane przy pierwszym użyciu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переклад повністю виконується на цьому пристрої, тому нічого не завантажується в жодному разі. Виберіть двигун вище. Мовні пакети можна завантажити під час першого використання."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri tamamen bu cihazda çalışır, dolayısıyla her iki durumda da hiçbir şey yüklenmez. Yukarıdaki motoru seçin. Dil paketleri ilk kullanımda indirilebilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překlad běží výhradně na tomto zařízení, takže se nic nenahrává ani v jednom případě. Vyberte motor výše. Jazykové balíčky lze stáhnout při prvním použití."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Preklad prebieha výlučne na tomto zariadení, takže sa nič neodovzdáva ani v jednom prípade. Vyberte motor vyššie. Jazykové balíčky je možné stiahnuť pri prvom použití."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μετάφραση εκτελείται εξ ολοκλήρου σε αυτήν τη συσκευή, επομένως τίποτα δεν μεταφορτώνεται σε καμία περίπτωση. Επιλέξτε τον κινητήρα παραπάνω. Τα πακέτα γλωσσών μπορούν να ληφθούν κατά την πρώτη χρήση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Översättningen körs helt och hållet på den här enheten, så ingenting laddas upp på något sätt. Välj motorn ovan. Språkpaket kan laddas ned vid första användningen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oversættelse kører udelukkende på denne enhed, så intet uploades på nogen måde. Vælg motoren ovenfor. Sprogpakker kan downloades ved første brug."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oversettelse kjører utelukkende på denne enheten, så ingenting blir lastet opp uansett. Velg motoren ovenfor. Språkpakker kan lastes ned ved første gangs bruk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käännös toimii kokonaan tällä laitteella, joten mitään ei ladata kummallakaan tavalla. Valitse moottori ylhäältä. Kielipaketit voidaan ladata ensimmäisellä käyttökerralla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan sepenuhnya berjalan di perangkat ini, jadi tidak ada yang diunggah. Pilih mesin di atas. Paket bahasa dapat diunduh pada penggunaan pertama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dịch chạy hoàn toàn trên thiết bị này nên không có gì được tải lên cả. Chọn động cơ ở trên. Gói ngôn ngữ có thể tải xuống trong lần sử dụng đầu tiên."
          }
        }
      }
    },
