    "The file couldn't be read, or its sounds were missing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ließ sich nicht lesen, oder ihre Töne fehlten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer el archivo, o le faltaban los sonidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n'a pas pu être lu, ou ses sons manquaient."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlt nem sikerült beolvasni, vagy hiányoztak belőle a hangok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere il file, oppure i suoni mancavano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを読み込めなかったか、中のサウンドが見つかりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 읽지 못했거나, 안에 사운드가 없었어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail itu tidak dapat dibaca, atau bunyinya tiada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o ficheiro, ou faltavam-lhe os sons."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл не удалось прочитать, или в нём не оказалось звуков."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件读不出来，或者里面的声音缺失了。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili ei saanud lugeda või selle helid puudusid."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die lêer kon nie gelees word nie, of sy klanke het ontbreek."
          }
        }
      }
    },
    "The full spectrum, running along the swipe.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ganze Farbspektrum, entlang der Wischbewegung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el espectro, a lo largo del deslizamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le spectre, le long de ton geste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes színskála a húzás mentén."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto lo spettro, lungo lo swipe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプに沿って虹色が流れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스와이프를 따라 흐르는 무지개색."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh spektrum, mengikut leretan anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o espetro, ao longo do deslize."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный спектр, бегущий вдоль движения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整条彩虹，顺着滑动铺开。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Terve spekter, kulgedes pühkimise suunas."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die volle spektrum, loop langs die swipe."
          }
        }
      }
    },
    "The full toolbox": {
      "extractionState": "stale",
      "localizations": {
