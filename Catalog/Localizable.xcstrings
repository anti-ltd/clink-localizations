    "Scale saved value": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escalar valor guardado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuster la valeur enregistrée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherten Wert skalieren"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scala il valore salvato"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar o valor guardado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Масштабировать сохранённое значение"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Skalakan nilai tersimpan"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentett érték arányosítása"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存値を倍率で調整"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按比例调整保存值"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 값 비율 조정"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuda salvestatud väärtust suhteliselt"
          }
        }
      }
    },
    "Scales every key's touch target. Raise it if taps sometimes don't register, like with a thick screen protector.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skaal elke sleutel se raakteiken. Lig dit op as krane soms nie registreer nie, soos met 'n dik skermbeskermer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaliert die Berührungsfläche jeder Taste. Erhöhe sie, wenn deine Tipps manchmal nicht ankommen, etwa bei einer dicken Schutzfolie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el área táctil de cada tecla. Súbelo si a veces los toques no se registran, por ejemplo con un protector de pantalla grueso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaleerib iga klahvi puudutussihti. Suurenda, kui vajutused mõnikord ei registreeru, nt. paksu ekraanikaitsega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste la zone tactile de chaque touche. Augmente-la si tes appuis ne passent pas toujours, par exemple avec une protection d'écran épaisse."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítja minden gomb érintési területének méretét. Növeld, ha néha nem érzékeli a koppintást, például vastag képernyővédő fóliánál."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridimensiona l'area tattile di ogni tasto. Aumentala se a volte i tocchi non vengono rilevati, ad esempio con una pellicola protettiva spessa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーのタッチ範囲を広げたり狭めたりします。厚めの保護フィルムなどでタップがときどき反応しないなら、上げてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키마다 터치 영역 크기를 조절해요. 두꺼운 화면 보호 필름처럼 탭이 가끔 안 먹히면 높여 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Skala sasaran sentuh setiap kekunci. Naikkan kalau ketikan kadang tak masuk, macam bila guna pelindung skrin tebal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta a área de toque de cada tecla. Aumenta-a se os toques às vezes não forem registados, por exemplo com uma película grossa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняет размер зоны нажатия у всех клавиш. Увеличьте, если нажатия иногда не срабатывают — например, из-за толстой защитной плёнки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整每个按键的触控范围。要是有时点了没反应，比如贴了厚屏幕膜，就调大一点。"
          }
        }
      }
    },
