        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필과 테마는 이 기기에 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil dan tema anda kekal pada peranti ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus perfis e temas ficam neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши профили и темы остаются на этом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的配置文件和主题保留在此设备上。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilurile și temele dvs. rămân pe acest dispozitiv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je profielen en thema's blijven op dit apparaat staan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的配置檔案和主題保留在此裝置上。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje profile i motywy pozostaną na tym urządzeniu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші профілі та теми залишаються на цьому пристрої."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilleriniz ve temalarınız bu cihazda kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše profily a motivy zůstanou v tomto zařízení."
          }
        },
        "sk": {
          "stringUnit": {
