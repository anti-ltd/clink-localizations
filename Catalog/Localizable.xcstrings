          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バネの跳ね具合です。低いほど強く跳ね、1.0できれいに収まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스프링이 얼마나 튀는지예요. 낮으면 더 튀고, 1.0이면 깔끔하게 멈춰요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak spring melantun. Lagi rendah lagi banyak lantun, 1.0 mengendap kemas."
          }
        },
        "pt": {
