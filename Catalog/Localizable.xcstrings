          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фотографія заповнює клавіатуру позаду клавіш і перекриває градієнт."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir fotoğraf, tuşların arkasındaki klavyeyi dolduruyor ve degradeyi geçersiz kılıyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
