    "%@ of saved value": {
      "comment": "Android-only: an automation's Scale action, e.g. \"120 % of saved value\"; %@ is a locale-formatted percentage (iOS formats \"%g%% of saved value\"). Translations drafted for the Android port; native-speaker review required before release.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ van gestoorde waarde"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uložené hodnoty"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ af gemt værdi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ des gespeicherten Werts"
          }
        },
        "el": {
