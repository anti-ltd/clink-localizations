    "You're unlocked. Thanks for supporting Clink.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jy is ontsluit. Dankie dat jy Clink ondersteun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles freigeschaltet. Danke, dass du Clink unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo desbloqueado. Gracias por apoyar Clink."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul on kõik avatud. Aitäh, et toetad Clinki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est déverrouillé. Merci de soutenir Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden feloldva. Köszönöm, hogy támogatod a Clinket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto sbloccato. Grazie per sostenere Clink."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてアンロックされました。Clinkを応援してくれてありがとう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기능이 잠금 해제됐어요. Clink를 응원해 주셔서 고마워요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya dibuka. Terima kasih kerana menyokong Clink."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Está tudo desbloqueado. Obrigado por apoiares o Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы разблокированы. Спасибо, что поддерживаете Clink."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有功能已解锁。感谢你支持 Clink。"
          }
        }
      }
    },
    "You've tweaked some settings since you applied %@.": {
