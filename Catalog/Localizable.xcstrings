    "Correctly punctuate what I say and make it more formal.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teken reg wat ek sê en maak dit meer formeel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz meine Zeichensetzung richtig und formuliere es förmlicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntúa bien lo que digo y hazlo más formal."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pane kirjavahemärgid õigesti ja tee see ametlikumaks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponctue correctement ce que je dis et rends-le plus formel."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tedd helyesen a központozást, és fogalmazd hivatalosabbra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punteggia bene quello che dico e rendilo più formale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容に正しく句読点をつけて、より丁寧な表現にして。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 말한 내용에 문장부호를 제대로 넣고 더 격식 있게 다듬어 줘."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Letak tanda baca yang betul pada apa yang saya sebut dan jadikan lebih formal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontua bem o que digo e torna-o mais formal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расставить знаки препинания и сделать сказанное более официальным."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把我说的正确加上标点，并写得更正式。"
          }
        }
      }
    },
