    "Instant highlight on · no linger · no min highlight · bloom off. Stock-keyboard snap.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iluminación instantánea · sin persistencia ni duración mínima · resplandor desactivado. Respuesta como el teclado del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éclairage instantané · sans maintien ni durée minimale · halo désactivé. Réactivité du clavier système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofortiges Aufleuchten · kein Nachleuchten · keine Mindestdauer · Bloom aus. Direkt wie die Systemtastatur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Illuminazione istantanea · nessuna persistenza o durata minima · bagliore disattivato. Reattività da tastiera di sistema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iluminação instantânea · sem persistência nem duração mínima · brilho difuso desligado. Resposta do teclado do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мгновенная подсветка · без задержки и минимальной длительности · свечение выключено. Отклик как у системной клавиатуры."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorotan serta-merta · tiada pengekalan atau tempoh minimum · cahaya kembang dimatikan. Respons seperti papan kekunci sistem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azonnali kiemelés · nincs késleltetés vagy minimális időtartam · ragyogás kikapcsolva. A rendszerbillentyűzet közvetlen reakciója."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "即時ハイライト・余韻なし・最短表示時間なし・ブルームオフ。標準キーボードのような素早い反応です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即时高亮开启，无停留、无最短高亮时间，泛光关闭。响应如系统键盘般利落。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 강조 켜짐 · 잔상 및 최소 표시 시간 없음 · 블룸 꺼짐. 기본 키보드처럼 즉각 반응합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohene esiletõst · järelhelenduseta · miinimumkestuseta · kuma väljas. Vahetu nagu süsteemiklaviatuur."
          }
        }
      }
    },
