    "Reads better, especially on idioms. Off is faster and covers more languages.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees beter, veral oor idiome. Af is vinniger en dek meer tale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest sich besser, vor allem bei Redewendungen. Aus ist schneller und kann mehr Sprachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lee mejor, sobre todo con modismos. Desactivado es más rápido y cubre más idiomas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loeb paremini, eriti väljendite puhul. Väljas on kiirem ja hõlmab rohkem keeli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lit mieux, surtout pour les expressions. Désactivé, c'est plus rapide et il y a plus de langues."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jobban olvasható, főleg a szólásoknál. Kikapcsolva gyorsabb, és több nyelvet tud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si legge meglio, soprattutto con i modi di dire. Disattivata è più veloce e copre più lingue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特に慣用句が自然になります。オフのほうが速く、対応言語も多めです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특히 관용구가 자연스러워요. 끄면 더 빠르고 지원 언어도 더 많아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih sedap dibaca, terutama simpulan bahasa. Jika dimatikan, lebih laju dan lebih banyak bahasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê-se melhor, sobretudo nas expressões. Desligado é mais rápido e abrange mais idiomas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читается лучше, особенно на устойчивых выражениях. Выключено — быстрее и охватывает больше языков."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读起来更自然，尤其是习惯用语。关掉会更快，支持的语言也更多。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citește mai bine, mai ales pe idiomuri. Oprit este mai rapid și acoperă mai multe limbi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest beter, vooral over idiomen. Uit is sneller en bestrijkt meer talen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀起來更自然，尤其是習慣用語。關掉會更快，支援的語言也更多。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyta się lepiej, zwłaszcza idiomami. Opcja Wyłącz jest szybsza i obejmuje więcej języków."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає краще, особливо на ідіомах. Off працює швидше та охоплює більше мов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özellikle deyimleri daha iyi okur. Kapalı seçeneği daha hızlıdır ve daha fazla dili kapsar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čte se lépe, zvláště na idiomech. Vypnuto je rychlejší a pokrývá více jazyků."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepšie sa číta, najmä na idiómoch. Vypnuté je rýchlejšie a pokrýva viac jazykov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάζει καλύτερα, ειδικά σε ιδιωματισμούς. Η απενεργοποίηση είναι πιο γρήγορη και καλύπτει περισσότερες γλώσσες."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läser bättre, speciellt på idiom. Av är snabbare och täcker fler språk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læser bedre, især på idiomer. Off er hurtigere og dækker flere sprog."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leser bedre, spesielt på idiomer. Av er raskere og dekker flere språk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukee paremmin, varsinkin idioomeilla. Off on nopeampi ja kattaa useampia kieliä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca lebih baik, terutama pada idiom. Mati lebih cepat dan mencakup lebih banyak bahasa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc tốt hơn, đặc biệt là về thành ngữ. Tắt nhanh hơn và bao gồm nhiều ngôn ngữ hơn."
          }
        }
      }
    },
