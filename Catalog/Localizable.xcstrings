    "Set its height and text size with the two sliders underneath.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel sy hoogte en teksgrootte in met die twee skuifknoppies onder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell Höhe und Textgröße mit den zwei Reglern darunter ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta su altura y el tamaño del texto con los dos deslizadores de debajo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Määra selle kõrgus ja teksti suurus kahe allpool oleva liuguriga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle sa hauteur et la taille du texte avec les deux curseurs en dessous."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A magasságát és a szövegméretét az alatta lévő két csúszkával állítsd be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola altezza e dimensione del testo con i due cursori sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その下の2つのスライダーで、高さと文字サイズを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래의 슬라이더 두 개로 높이와 글자 크기를 정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan tingginya dan saiz teks dengan dua peluncur di bawahnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Define a altura e o tamanho do texto com os dois cursores por baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте его высоту и размер текста двумя регуляторами ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用下面两个滑块设定它的高度和字号。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setați-i înălțimea și dimensiunea textului cu cele două glisoare de dedesubt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel de hoogte en tekstgrootte in met de twee schuifregelaars eronder."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用下面兩個滑塊設定它的高度和字號。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw jego wysokość i rozmiar tekstu za pomocą dwóch suwaków poniżej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановіть його висоту та розмір тексту за допомогою двох повзунків внизу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altındaki iki kaydırıcıyı kullanarak yüksekliğini ve metin boyutunu ayarlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte jeho výšku a velikost textu pomocí dvou posuvníků pod ním."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte jeho výšku a veľkosť textu pomocou dvoch posúvačov pod ním."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορίστε το ύψος και το μέγεθος του κειμένου με τα δύο ρυθμιστικά από κάτω."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in dess höjd och textstorlek med de två reglagen under."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstil dens højde og tekststørrelse med de to skydere nedenunder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Still inn høyden og tekststørrelsen med de to glidebryterne under."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta sen korkeus ja tekstin koko kahdella alla olevalla liukusäätimellä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur tinggi dan ukuran teksnya dengan dua bilah geser di bawahnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt chiều cao và kích thước văn bản của nó bằng hai thanh trượt bên dưới."
          }
        }
      }
    },
