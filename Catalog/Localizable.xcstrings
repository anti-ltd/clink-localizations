    "Tap Default (or pick Liquid if you liked the old soft spring).": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Standard oder wähle Flüssig, wenn dir die frühere sanfte Federbewegung gefallen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Predeterminado o elige Líquido si te gustaba el rebote suave anterior."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta „Vaikimisi” või vali „Voolav”, kui sulle meeldis varasem pehme vetruv liikumine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Par défaut, ou choisis Liquide si tu aimais l’ancien rebond souple."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints az Alapértelmezett lehetőségre, vagy válaszd a Folyékony módot, ha a korábbi lágy rugózást kedvelted."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Predefinito oppure scegli Liquido se ti piaceva il vecchio rimbalzo morbido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「デフォルト」をタップします。以前の柔らかな弾みが好みなら、「リキッド」を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘기본값’을 탭하세요. 예전의 부드럽게 튕기는 느낌이 좋았다면 ‘리퀴드’를 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik Lalai atau pilih Cecair jika anda menyukai lantunan lembut yang lama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em Predefinição ou escolhe Líquido se gostavas do efeito de mola suave anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «По умолчанию» или выберите «Жидкий», если вам нравилась прежняя мягкая пружинная анимация."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点“默认”；如果喜欢以前那种柔和的回弹感，可以选择“液态”。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți Implicit (sau alegeți Liquid dacă v-a plăcut vechiul arc moale)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Standaard (of kies Vloeistof als je de oude zachte veer leuk vond)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點“預設”；如果喜歡以前那種柔和的回彈感，可以選擇“液態”。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Verstek (of kies Vloeibaar as jy van die ou sagte veer gehou het)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij Domyślne (lub wybierz Płyn, jeśli podobała Ci się stara miękka sprężyna)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться «За замовчуванням» (або виберіть «Рідина», якщо вам сподобалася стара м’яка пружина)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan'a dokunun (veya eski yumuşak yayı beğendiyseniz Sıvı'yı seçin)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na Výchozí (nebo vyberte Liquid, pokud se vám líbila stará měkká pružina)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnite na Predvolené (alebo vyberte Liquid, ak sa vám páčil starý mäkký prameň)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε Προεπιλογή (ή επιλέξτε Υγρό αν σας άρεσε το παλιό μαλακό ελατήριο)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på Standard (eller välj Flytande om du gillade den gamla mjuka fjädern)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Standard (eller vælg Flydende, hvis du kunne lide den gamle bløde fjeder)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på Standard (eller velg Væske hvis du likte den gamle myke fjæren)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta Oletus (tai valitse Liquid, jos pidit vanhasta pehmeästä jousesta)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Default (atau pilih Liquid jika Anda menyukai pegas lembut yang lama)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào Mặc định (hoặc chọn Chất lỏng nếu bạn thích lò xo mềm cũ)."
          }
        }
      }
    },
    "Tap Restore Purchases, signed in with the Apple Account you bought it on.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Herstel aankope, aangemeld met die Apple-rekening waarop jy dit gekoop het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Käufe wiederherstellen“ — angemeldet mit dem Apple-Account, mit dem du gekauft hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Restaurar compras, con la sesión iniciada en la cuenta de Apple con la que lo compraste."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta Taasta ostud, logitud Apple’i kontosse, millega ostsid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Restaurer les achats, connecté avec le compte Apple utilisé pour l'achat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a Vásárlások visszaállítása gombra, azzal az Apple-fiókkal bejelentkezve, amelyikkel vetted."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Ripristina acquisti, con l'account Apple da cui hai comprato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入に使ったApple アカウントでサインインした状態で、「購入を復元」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구입할 때 쓴 Apple 계정으로 로그인한 상태에서 구매 복원을 누르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik Pulihkan Pembelian, sambil log masuk dengan Akaun Apple yang anda gunakan semasa membeli."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em Restaurar compras, com sessão iniciada na conta Apple onde o compraste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Восстановить покупки», войдя в тот аккаунт Apple, на который покупали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用当初购买的那个 Apple 账户登录，然后点“恢复购买”。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți Restabiliți achizițiile, conectați-vă cu contul Apple pe care l-ați cumpărat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Aankopen herstellen, ingelogd met het Apple-account waarmee je het hebt gekocht."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用當初購買的那個 Apple 賬戶登入，然後點“恢復購買”。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij opcję Przywróć zakupy, zaloguj się na konto Apple, na którym dokonałeś zakupu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться «Відновити покупки», увійшовши в обліковий запис Apple, у якому ви його придбали."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın aldığınız Apple Hesabı ile oturum açarak Satın Alma İşlemlerini Geri Yükle'ye dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na Obnovit nákupy, přihlaste se pomocí účtu Apple, na kterém jste si koupili."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnite na Obnoviť nákupy, prihláste sa pomocou účtu Apple, na ktorom ste si to kúpili."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε Επαναφορά αγορών, συνδέθηκε με τον λογαριασμό Apple στον οποίο το αγοράσατε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på Återställ köp, inloggad med Apple-kontot du köpte den på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Gendan køb, logget ind med den Apple-konto, du købte den på."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på Gjenopprett kjøp, logget på med Apple-kontoen du kjøpte den på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta Palauta ostokset kirjautuneena Apple-tilille, jolla ostit sen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Pulihkan Pembelian, masuk dengan Akun Apple tempat Anda membelinya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào Khôi phục giao dịch mua, đăng nhập bằng Tài khoản Apple mà bạn đã mua."
          }
        }
      }
    },
    "Tap Share if you want to send it to us.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Teilen, wenn du ihn uns senden möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Compartir si quieres enviárnoslo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui soovid selle meile saata, puuduta „Jaga”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Partager si tu veux nous l’envoyer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha el szeretnéd küldeni nekünk, koppints a Megosztás gombra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Condividi se vuoi inviarcelo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私たちに送る場合は、「共有」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저희에게 보내려면 ‘공유’를 탭하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik Kongsi jika anda mahu menghantarnya kepada kami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em Partilhar se quiseres enviar-nos o relatório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Поделиться», если хотите отправить отчёт нам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需发送给我们，请轻点“共享”。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge Partajare dacă vrei să ni-l trimiți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Delen als je het naar ons wilt sturen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如需傳送給我們，請輕點“共享”。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Deel as jy dit vir ons wil stuur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij Udostępnij, jeśli chcesz nam to wysłać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть «Поділитися», якщо хочете надіслати його нам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bize göndermek istiyorsanız Paylaş'a dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li nám jej poslat, klepněte na Sdílet."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak nám ho chcete poslať, klepnite na Zdieľať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε Κοινή χρήση εάν θέλετε να μας το στείλετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på Dela om du vill skicka den till oss."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Del, hvis du vil sende det til os."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på Del hvis du vil sende den til oss."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta Jaa, jos haluat lähettää sen meille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Bagikan jika Anda ingin mengirimkannya kepada kami."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào Chia sẻ nếu bạn muốn gửi nó cho chúng tôi."
          }
        }
      }
    },
    "Tap Share report if you want to send it to us.": {
      "extractionState": "manual",
