    "Hide this sticker without deleting it — its place stays saved.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blende diesen Sticker aus, ohne ihn zu löschen – seine Position bleibt gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta esta pegatina sin borrarla: su posición se conserva."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peida see kleeps ilma seda kustutamata – tema asukoht jääb alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquez cet autocollant sans le supprimer : sa position reste enregistrée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejtsd el ezt a matricát törlés nélkül – a helye megmarad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi questo adesivo senza eliminarlo: la sua posizione resta salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除せずにステッカーを隠します。位置は保存されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하지 않고 이 스티커를 숨깁니다. 위치는 그대로 저장됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan pelekat ini tanpa memadamkannya — kedudukannya kekal disimpan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculte este adesivo sem excluí-lo: a posição dele permanece salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть стикер, не удаляя его — его позиция сохранится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏此贴纸而不删除它——其位置会保留。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Versteek hierdie plakker sonder om dit uit te vee – sy plek bly gestoor."
          }
        }
      }
    },
