        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersamaan %@ sebulan. Diperbaharui setiap tahun. Batal bila-bila masa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá para %@ por mês. Renova anualmente. Cancela quando quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выходит %@ в месяц. Продлевается раз в год. Отменить можно в любой момент."
