    "Dictation is off. Turn it on to use and customize it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktat ist aus. Schalte es ein, um es zu nutzen und anzupassen."
