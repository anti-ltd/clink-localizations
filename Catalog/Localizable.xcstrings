    "Fast, full and bright. The loudest it gets.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vinnig, vol en helder. Die hardste wat dit word."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnell, voll und hell. Lauter geht es nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido, lleno y brillante. Todo lo llamativo que puede ser."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiire, täis ja ere. Valjem ei saa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapide, dense et lumineux. Le maximum."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyors, telt és fényes. Ennél harsányabb nem lesz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Veloce, pieno e luminoso. Più vistoso di così non si può."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "速く、びっしり、明るく。いちばん派手な設定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠르고 가득하고 밝게. 가장 화려한 설정입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantas, penuh dan terang. Paling menyerlah setakat ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido, cheio e brilhante. O mais vistoso que fica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстро, полно и ярко. Громче не бывает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快、满、亮。最张扬的一档。"
          }
        }
      }
    },
    "Faster still: type what you're after into the search bar at the top of any tab.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog vinniger: tik waarna jy soek in die soekbalk boaan enige oortjie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch schneller: tippe in der Suchleiste oben in jedem Tab ein, was du suchst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más rápido aún: escribe lo que buscas en la barra de búsqueda de cualquier pestaña."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Veelim kiirem: tipi see, mida otsid, mis tahes kaardi ülaosas olevasse otsinguribale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus rapide encore : tape ce que tu cherches dans la barre de recherche en haut de n'importe quel onglet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még gyorsabb: írd be, amit keresel, bármelyik lap tetején lévő keresőbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora più rapido: scrivi quello che cerchi nella barra di ricerca in cima a qualsiasi scheda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さらに早いのは、どのタブでも上部の検索バーに探しているものを入力する方法です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 빠른 방법은 어느 탭에서든 위쪽 검색창에 찾는 것을 입력하는 것입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih pantas lagi: taip apa yang anda cari dalam bar carian di atas mana-mana tab."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda mais rápido: escreve o que procuras na barra de pesquisa no topo de qualquer separador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё быстрее: наберите то, что ищете, в строке поиска наверху любой вкладки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更快的办法：在任意标签页顶部的搜索框里输入你要找的东西。"
          }
        }
      }
    },
    "Fastest deletion rate after the key fully accelerates. Lower is faster.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vinnigste uitveetempo nadat die sleutel ten volle versnel het. Laer is vinniger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnellste Löschrate, wenn die Taste voll beschleunigt hat. Niedriger heißt schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocidad de borrado máxima cuando la tecla ya va a tope. Cuanto más bajo, más rápido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiireim kustutamiskiirus pärast seda, kui klahv on täielikult kiirendunud. Madalam on kiirem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitesse de suppression max une fois la touche à plein régime. Plus bas, plus rapide."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A leggyorsabb törlési tempó, miután a gomb teljesen felgyorsult. Az alacsonyabb a gyorsabb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocità massima di cancellazione dopo che il tasto accelera del tutto. Più basso è più veloce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーが完全に加速したあとの、いちばん速い削除スピードです。低いほど速くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 완전히 빨라진 뒤의 최고 삭제 속도예요. 낮을수록 빨라요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadar padam paling laju selepas kekunci memecut penuh. Lagi rendah, lagi laju."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocidade máxima de apagar depois de a tecla acelerar por completo. Mais baixo é mais rápido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальная скорость удаления после полного разгона клавиши. Меньше — быстрее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键完全加速后的最快删除速度。数值越低越快。"
          }
        }
      }
    },
