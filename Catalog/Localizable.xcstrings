        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor stor hver partikel vokser. Større former fylder flere af tasterne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor stor hver partikkel vokser. Større former fyller flere av nøklene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka suureksi kukin hiukkanen kasvaa. Suuremmat muodot täyttävät enemmän avaimia."
