            "value": "La vitesse à laquelle le ressort de la barre d'espace se stabilise. Plus bas, plus vif."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Milyen gyorsan ül el a szóköz rugója. Az alacsonyabb pattanósabb."
          }
        },
        "it": {
