    "Type several languages at once. A word is only corrected when it's wrong in all of them.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik verskeie tale gelyktydig. 'n Woord word net reggestel wanneer dit in almal verkeerd is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in mehreren Sprachen gleichzeitig. Ein Wort wird nur korrigiert, wenn es in allen falsch ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe en varios idiomas a la vez: una palabra solo se corrige si está mal en todos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipi mitut keelt korraga. Sõna parandatakse ainult siis, kui see on kõigis vale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris en plusieurs langues à la fois. Un mot n'est corrigé que s'il est faux dans toutes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írj több nyelven egyszerre. Egy szót csak akkor javít, ha mindegyikben hibás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi in più lingue contemporaneamente. Una parola viene corretta solo se è sbagliata in tutte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の言語を同時に入力できます。どの言語でも間違っている時だけ修正されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 언어를 한꺼번에 입력하세요. 모든 언어에서 틀린 단어만 고쳐요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip beberapa bahasa serentak. Perkataan hanya dibetulkan jika salah dalam semuanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve em vários idiomas ao mesmo tempo. Uma palavra só é corrigida quando está errada em todos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Печатайте на нескольких языках сразу. Слово исправляется, только если оно неверно во всех."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时输入多种语言，只有在所有语言里都拼错的词才会被纠正。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastați mai multe limbi deodată. Un cuvânt este corectat numai atunci când este greșit în toate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ meerdere talen tegelijk. Een woord wordt alleen gecorrigeerd als het in alle woorden fout is."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同時輸入多種語言，只有在所有語言裡都拼錯的詞才會被糾正。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz kilka języków jednocześnie. Słowo można poprawić tylko wtedy, gdy we wszystkich jest błędne."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть кілька мов одночасно. Слово виправляється лише тоді, коли воно неправильне в усіх."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı anda birden fazla dil yazın. Bir kelime ancak hepsinde yanlış olduğunda düzeltilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte několik jazyků najednou. Slovo je opraveno pouze tehdy, když je ve všech chybné."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíšte niekoľko jazykov naraz. Slovo je opravené len vtedy, keď je nesprávne vo všetkých."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολογήστε πολλές γλώσσες ταυτόχρονα. Μια λέξη διορθώνεται μόνο όταν είναι λάθος σε όλες."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv flera språk samtidigt. Ett ord korrigeras bara när det är fel i dem alla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast flere sprog på én gang. Et ord bliver kun rettet, når det er forkert i dem alle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn flere språk samtidig. Et ord blir bare rettet når det er feil i dem alle."
          }
        },
        "fi": {
