    "iOS won't let keyboards use the mic, so Clink listens instead. It opens once, then dictation starts right here.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS laat nie toe dat sleutelborde die mikrofoon gebruik nie, so Clink luister eerder. Dit maak een keer oop, dan begin diktasie net hier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS erlaubt Tastaturen kein Mikrofon, deshalb hört Clink zu. Es öffnet sich einmal, danach startet das Diktat direkt hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no permite que los teclados usen el micrófono, así que escucha Clink. Se abre una vez y el dictado empieza aquí mismo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ei lase klaviatuuridel mikrofoni kasutada, seega kuulab Clink. Ta avaneb üks kord, seejärel algab dikteerimine otse siin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS interdit le micro aux claviers, alors Clink écoute à leur place. Il s'ouvre une fois, puis la dictée démarre directement ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iOS nem engedi a billentyűzeteknek a mikrofont, ezért a Clink figyel helyette. Egyszer megnyílik, utána a diktálás már itt indul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS non permette alle tastiere di usare il microfono, così ascolta Clink. Si apre una volta, poi la dettatura parte direttamente qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSではキーボードがマイクを使えないため、代わりにClinkが聞き取ります。一度開くと、そのあとはここで音声入力が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 키보드는 마이크를 쓸 수 없어서 Clink가 대신 듣습니다. 한 번 열리면 그 다음부터는 여기서 바로 받아쓰기가 시작됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS tidak membenarkan papan kekunci menggunakan mikrofon, jadi Clink yang mendengar. Ia dibuka sekali, kemudian imlak bermula terus di sini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS não deixa os teclados usarem o microfone, por isso quem ouve é o Clink. Ele abre uma vez e o ditado começa aqui mesmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS не позволяет клавиатурам пользоваться микрофоном, поэтому слушает сам Clink. Он открывается один раз, а дальше диктовка идёт прямо здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 键盘无法使用麦克风，因此改由 Clink 聆听。它会打开一次，之后就能直接在这里开始语音输入。"
          }
        }
      }
    },
