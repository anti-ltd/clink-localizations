    },
    "Turn on to add an AI panel to the keyboard. Proofread, rewrite, change the tone, shorten, reply and more, all on device.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel aan om 'n KI-paneel by die sleutelbord te voeg. Proeflees, herskryf, verander die toon, verkort, antwoord en meer, alles op toestel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalt es ein, um der Tastatur ein KI-Panel hinzuzufügen. Korrigieren, umschreiben, den Ton ändern, kürzen, antworten und mehr, alles auf dem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo para añadir un panel de IA al teclado. Corrige, reescribe, cambia el tono, acorta, responde y mucho más, todo en el dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita see sisse, et lisada klaviatuurile TI-paneel. Loe üle, kirjuta ümber, muuda tooni, lühenda, vasta ja palju muud, kõik seadmes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ça pour ajouter un panneau IA au clavier. Relis, réécris, change le ton, raccourcis, réponds et plus encore, le tout sur l'appareil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be, hogy MI-panelt tegyél a billentyűzethez. Lektorálás, átírás, hangnem-váltás, rövidítés, válasz és sok más, mind az eszközön."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva per aggiungere un pannello AI alla tastiera. Correggi, riscrivi, cambia tono, accorcia, rispondi e altro, tutto sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにするとキーボードにAIパネルが付きます。校正、書き直し、トーン変更、短縮、返信など、すべてデバイス内でできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 키보드에 AI 패널이 붙어요. 교정, 다시 쓰기, 어조 바꾸기, 줄이기, 답장까지 전부 기기 안에서 해줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan untuk tambah panel AI pada papan kekunci. Semak, tulis semula, tukar nada, pendekkan, balas dan banyak lagi, semuanya dalam peranti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa para juntar um painel de IA ao teclado. Revê, reescreve, muda o tom, resume, responde e muito mais, tudo no dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите, чтобы добавить панель ИИ на клавиатуру. Проверка текста, переписывание, смена тона, сокращение, ответ и не только — всё на устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开后会给键盘加一个 AI 面板。校对、改写、换语气、缩短、回复等等，全在设备上完成。"
          }
        }
      }
    },
    "Turn on typing analytics above to see your stats. Until then, nothing is collected.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel tikanalise hierbo aan om jou statistieke te sien. Tot dan word niks ingesamel nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte oben die Tippstatistiken ein, um deine Werte zu sehen. Bis dahin wird nichts erfasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa arriba las estadísticas de escritura para ver tus datos. Hasta entonces, no se recopilará nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita ülal sisse tipimisstatistika, et oma näitajaid näha. Seni ei koguta midagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active les statistiques de frappe ci-dessus pour voir tes données. D'ici là, rien n'est collecté."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be fent a gépelési statisztikákat az adataid megtekintéséhez. Addig semmit sem gyűjtünk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le statistiche di scrittura qui sopra per vedere i tuoi dati. Fino ad allora non viene raccolto nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の入力統計をオンにするとデータを確認できます。それまでは何も記録されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위에서 입력 통계를 켜면 내 통계를 볼 수 있어요. 그전까지는 아무것도 수집하지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan statistik menaip di atas untuk melihat statistik anda. Sehingga itu, tiada apa-apa dikumpulkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa acima as estatísticas de escrita para veres os teus dados. Até lá, não é recolhido nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите аналитику набора выше, чтобы увидеть статистику. Пока она не включена, ничего не собирается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启上方的输入统计即可查看数据。在此之前不会收集任何内容。"
          }
        }
      }
    },
