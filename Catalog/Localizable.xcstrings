    "Share shortcuts only run when you tap them.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deelkortpaaie loop net wanneer jy daarop tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen-Verknüpfungen laufen nur, wenn du sie antippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de compartir solo se ejecutan cuando los tocas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jagamise otseteed töötavad ainult siis, kui sa neid puudutad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis de partage ne se lancent que quand tu les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megosztási parancsikonok csak akkor futnak, ha rájuk koppintasz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scorciatoie di condivisione partono solo quando le tocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有ショートカットは、タップしたときだけ動きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 바로가기는 눌렀을 때만 실행돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan kongsi cuma berjalan bila anda ketiknya."
          }
        },
        "pt": {
