          "stringUnit": {
            "state": "translated",
            "value": "Válaszd az „Engedélyezés” lehetőséget, és az iOS nem kérdez többet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli «Consenti» e iOS smette di chiedere."
