            "value": "Vises bare med to eller flere språk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkyy vain kahdella tai useammalla kielellä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya muncul dengan dua bahasa atau lebih."
          }
        },
        "vi": {
