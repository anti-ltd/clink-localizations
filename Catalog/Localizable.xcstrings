    "The bar suggests as you type, and misspellings fix themselves on the next space.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die balk stel voor terwyl jy tik, en spelfoute maak hulself reg op die volgende spasie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leiste schlägt beim Tippen vor, und Tippfehler korrigieren sich beim nächsten Leerzeichen von selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra sugiere mientras escribes y los errores se corrigen solos en el siguiente espacio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Riba soovitab tipimise ajal ja eksitused parandavad end järgmise tühiku juures."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre propose des mots pendant que tu écris, et les fautes se corrigent toutes seules à l'espace suivant."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sáv gépelés közben javasol, az elgépelések pedig a következő szóköznél maguktól kijavulnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra suggerisce mentre scrivi e gli errori si correggono da soli allo spazio successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力に合わせてバーが候補を出し、打ち間違いは次のスペースで自動的に直ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력하는 동안 바가 단어를 추천하고, 오타는 다음 띄어쓰기에서 저절로 고쳐져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bar mencadangkan semasa anda menaip, dan kesilapan ejaan membetulkan diri pada ruang seterusnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra sugere enquanto escreves e os erros corrigem-se sozinhos no espaço seguinte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка подсказывает по ходу печати, а опечатки исправляются сами на следующем пробеле."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打字时建议栏会给出候选，拼错的词在下一个空格时自动改正。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara sugerează pe măsură ce tastați, iar greșelile de ortografie se remediază în spațiul următor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De balk suggereert terwijl u typt, en spelfouten worden automatisch in de volgende spatie weergegeven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打字時建議欄會給出候選，拼錯的詞在下一個空格時自動改正。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasek sugeruje w trakcie pisania, a błędy ortograficzne są naprawiane w następnym miejscu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Смуга підказує, коли ви вводите, а орфографічні помилки виправляються на наступному місці."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çubuk siz yazarken önerilerde bulunur ve yazım hataları bir sonraki alanda kendiliğinden düzeltilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lišta se při psaní navrhuje a překlepy se opraví na další místo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lišta navrhuje počas písania a preklepy sa opravujú na ďalšom mieste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή προτείνει καθώς πληκτρολογείτε και τα ορθογραφικά λάθη διορθώνονται στο επόμενο διάστημα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stapeln föreslår när du skriver, och felstavningar fixar sig på nästa blanksteg."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linjen foreslår, mens du skriver, og stavefejl ordner sig selv på det næste felt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Linjen foreslår mens du skriver, og stavefeil fikser seg på neste plass."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palkki ehdottaa kirjoittaessasi, ja kirjoitusvirheet korjaantuvat seuraavaan välilyöntiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah menyarankan saat Anda mengetik, dan kesalahan ejaan muncul di spasi berikutnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh gợi ý khi bạn nhập và lỗi chính tả sẽ tự sửa ở khoảng trống tiếp theo."
          }
        }
      }
    },
