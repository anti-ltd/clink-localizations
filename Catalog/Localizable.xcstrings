    "Sync is off. These copies stay in iCloud until you delete them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung ist aus. Diese Kopien bleiben in iCloud, bis du sie löschst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización está desactivada. Estas copias seguirán en iCloud hasta que las borres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation est désactivée. Ces copies restent dans iCloud jusqu’à ce que tu les supprimes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szinkronizálás ki van kapcsolva. Ezek a másolatok az iCloudban maradnak, amíg nem törlöd őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione è disattivata. Queste copie restano su iCloud finché non le elimini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期はオフです。これらのコピーは削除するまでiCloudに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화가 꺼져 있습니다. 이 사본은 삭제할 때까지 iCloud에 남아 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyegerakan dimatikan. Salinan ini kekal dalam iCloud sehingga anda memadamnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização está desligada. Estas cópias ficam no iCloud até as apagares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация выключена. Эти копии останутся в iCloud, пока вы их не удалите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步已关闭。这些副本会一直留在 iCloud 中，直到你删除。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sünkroonimine on väljas. Need koopiad jäävad iCloudi, kuni sa need kustutad."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sinkronisering is af. Hierdie kopieë bly in iCloud totdat jy dit uitvee."
          }
        }
      }
    },
