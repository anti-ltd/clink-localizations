    "Overwrite your current settings with this file, or save it as a new profile. Your themes are kept either way.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oorskryf jou huidige instellings met hierdie lêer, of stoor dit as 'n nuwe profiel. Jou temas word op enige manier gehou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschreib deine aktuellen Einstellungen mit dieser Datei oder speicher sie als neues Profil. Deine Themes bleiben so oder so erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrescribe tus ajustes actuales con este archivo, o guárdalo como perfil nuevo. Tus temas se conservan de todos modos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjuta oma praegused seaded selle failiga üle või salvesta see uue profiilina. Sinu teemad jäävad mõlemal juhul alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrase tes réglages actuels avec ce fichier, ou enregistre-le comme nouveau profil. Tes thèmes sont gardés dans les deux cas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd felül a mostani beállításaidat ezzel a fájllal, vagy mentsd új profilként. A témáid így is, úgy is megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovrascrivi le impostazioni attuali con questo file, o salvalo come nuovo profilo. I tuoi temi restano al loro posto in ogni caso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルで今の設定を上書きするか、新しいプロファイルとして保存できます。どちらを選んでもテーマはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일로 지금 설정을 덮어쓰거나 새 프로필로 저장해 주세요. 어느 쪽이든 테마는 그대로 남아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti tetapan semasa anda dengan fail ini, atau simpan sebagai profil baharu. Tema anda dikekalkan macam mana pun."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui as tuas definições atuais por este ficheiro, ou guarda-o como um novo perfil. Os teus temas ficam guardados de qualquer forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезаписать текущие настройки этим файлом или сохранить его как новый профиль. Темы сохранятся в любом случае."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用这个文件覆盖你现在的设置，或者另存成一个新配置。不管选哪种，你的主题都会留着。"
          }
        }
      }
    },
