    "The plugin draws this element. Its own settings are on the Plugins tab.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Plugin zeichnet dieses Element. Seine eigenen Einstellungen stehen im Tab Plugins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plugin dibuja este elemento. Sus ajustes están en la pestaña Plugins."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle elemendi joonistab pistikprogramm. Selle enda seaded on vahekaardil Pistikprogrammid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plugin dessine cet élément. Ses propres réglages sont dans l'onglet Plugins."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt az elemet a bővítmény rajzolja. A saját beállításai a Bővítmények lapon vannak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elemento lo disegna il plugin. Le sue impostazioni sono nella scheda Plugin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエレメントはプラグインが描きます。プラグイン自体の設定はプラグインタブにあります。"
