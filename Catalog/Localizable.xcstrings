          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij wynik, aby otworzyć jego stronę i wyświetlić pasujące elementy sterujące."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться результату, щоб відкрити його сторінку та відкрити відповідні елементи керування."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
