    "One-time purchase. Payment charged to your Apple Account. Restore anytime from this screen.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. El pago se carga a tu cuenta de Apple. Puedes restaurarlo cuando quieras desde esta pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achat unique. Le paiement est débité de ton compte Apple. Tu peux le restaurer à tout moment depuis cet écran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmaliger Kauf. Die Zahlung wird deinem Apple Account belastet. Du kannst den Kauf jederzeit auf diesem Bildschirm wiederherstellen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisto una tantum. Il pagamento viene addebitato sul tuo Apple Account. Puoi ripristinarlo quando vuoi da questa schermata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. O pagamento é cobrado na tua Conta Apple. Podes restaurar a compra quando quiseres neste ecrã."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian sekali sahaja. Bayaran dikenakan pada Akaun Apple anda. Pulihkan pada bila-bila masa daripada skrin ini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyszeri vásárlás. A fizetést az Apple-fiókodra terheljük. Erről a képernyőről bármikor visszaállíthatod."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度だけの購入です。Apple Accountに請求されます。この画面からいつでも復元できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性购买。费用将从你的 Apple 账户扣除。你可以随时在此页面恢复购买。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일회성 구매예요. Apple 계정으로 결제되며, 언제든 이 화면에서 복원할 수 있어요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühekordne ost. Makse võetakse sinu Apple’i kontolt. Taasta igal ajal sellelt ekraanilt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разовая покупка. Оплата списывается с вашего Apple Account. Восстановить можно в любой момент с этого экрана."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "One-time purchase. Betaling gehef teen jou Apple-rekening. Herstel enige tyd vanaf hierdie skerm."
          }
        }
      }
    },
    "Only affects keys that switch on, like Shift.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt nur für Tasten, die sich einschalten lassen, etwa Umschalt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo afecta a las teclas que se encienden, como Mayúsculas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne concerne que les touches qui peuvent s’activer, comme Majuscules."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a bekapcsolható billentyűkre vonatkozik, például a Shiftre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale solo per i tasti che possono accendersi, come Maiuscole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにできるキーだけが対象です。Shift などです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜고 끌 수 있는 키에만 적용돼요. Shift 같은 키요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya melibatkan kekunci yang boleh dihidupkan, seperti Shift."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só afeta as teclas que podem acender, como Maiúsculas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действует только на клавиши-переключатели вроде Shift."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只影响可以开启的按键，比如 Shift。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mõjutab ainult klahve, mida saab sisse lülitada, nagu tõstuklahv."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Affekteer slegs sleutels wat aanskakel, soos Shift."
          }
        }
      }
    },
    "Only marks edits to your own text. Replies, drafts, and translations are new writing, so they're left plain.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiert nur Änderungen an deinem eigenen Text. Antworten, Entwürfe und Übersetzungen sind neu geschrieben und bleiben daher unmarkiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo marca las ediciones de tu propio texto. Las respuestas, los borradores y las traducciones son texto nuevo, así que se dejan sin marcar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque uniquement les modifications de ton propre texte. Les réponses, brouillons et traductions sont de nouveaux écrits, donc ils restent bruts."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a saját szöveged szerkesztéseit jelöli. A válaszok, piszkozatok és fordítások új írások, ezért jelöletlenül maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna solo le modifiche al tuo testo. Risposte, bozze e traduzioni sono scrittura nuova, quindi restano semplici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の文章への手直しだけに印を付けます。返信、下書き、翻訳は新しく書いたものなので、そのままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 쓴 텍스트를 고친 것만 표시해요. 답장, 초안, 번역은 새로 쓰는 거라 그대로 둬요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya tandakan suntingan pada teks anda sendiri. Balasan, draf, dan terjemahan ialah tulisan baharu, jadi ia dibiarkan biasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só marca edições ao teu próprio texto. Respostas, rascunhos e traduções são texto novo, por isso ficam sem marca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помечает правки только в вашем собственном тексте. Ответы, черновики и переводы — это новый текст, поэтому они остаются без пометок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只标记对你自己文本的修改。回复、草稿和翻译是全新写作，所以不做标记。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märgib ainult muudatused sinu enda tekstis. Vastused, mustandid ja tõlked on uus kirjutis, seega jäetakse need lihtsaks."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merk slegs wysigings aan jou eie teks. Antwoorde, konsepte en vertalings is nuwe skrif, so dit word eenvoudig gelaat."
          }
        }
      }
    },
    "Only needed for haptics, clipboard history and custom sounds. Everything else works without it, and Clink never sends your typing anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für Haptik, Zwischenablage-Verlauf und eigene Sounds nötig. Alles andere funktioniert auch ohne — und Clink sendet deine Eingaben nirgendwohin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo hace falta para la vibración, el historial del portapapeles y los sonidos propios. Todo lo demás funciona sin ella, y Clink nunca envía lo que escribes a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire uniquement pour le retour haptique, l'historique du presse-papiers et les sons personnalisés. Tout le reste fonctionne sans, et Clink n'envoie jamais ce que tu tapes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a rezgéshez, a vágólap-előzményekhez és a saját hangokhoz kell. Minden más enélkül is működik, és a Clink soha nem küldi el sehová, amit gépelsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve solo per l'aptica, la cronologia degli appunti e i suoni personalizzati. Tutto il resto funziona senza, e Clink non invia mai ciò che scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "触覚フィードバック、クリップボード履歴、カスタムサウンドにのみ必要です。それ以外はなくても動作し、入力内容が送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "햅틱, 클립보드 기록, 사용자 지정 사운드에만 필요합니다. 나머지는 없어도 작동하며, Clink는 입력 내용을 어디로도 보내지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya diperlukan untuk haptik, sejarah papan keratan dan bunyi tersuai. Semua yang lain berfungsi tanpanya, dan Clink tidak pernah menghantar taipan anda ke mana-mana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só é necessário para o retorno tátil, o histórico da área de transferência e os sons personalizados. Todo o resto funciona sem ele, e o Clink nunca envia o que escreves para lado nenhum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен только для тактильной отдачи, истории буфера обмена и своих звуков. Всё остальное работает без него, и Clink никогда никуда не отправляет то, что вы печатаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于触感反馈、剪贴板历史和自定义音效。其余功能无需它也能使用，Clink 绝不会把你输入的内容发送到任何地方。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajalik ainult haptika, lõikelaua ajaloo ja kohandatud helide jaoks. Kõik muu töötab ilma selleta ja Clink ei saada sinu tipimist kuhugi."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slegs nodig vir haptics, knipbordgeskiedenis en pasgemaakte klanke. Al die ander werk daarsonder, en Clink stuur nooit jou tikwerk êrens heen nie."
          }
        }
      }
    },
    "Only one language is active at a time. Swipe up on the Return key to switch it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist immer nur eine Sprache aktiv. Wisch auf der Eingabetaste nach oben, um sie zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo hay un idioma activo a la vez. Desliza hacia arriba en la tecla Intro para cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule langue est active à la fois. Balaie la touche Retour vers le haut pour en changer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyszerre csak egy nyelv aktív. Húzd felfelé az Enter billentyűt, hogy váltsd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È attiva una sola lingua alla volta. Scorri verso l’alto sul tasto Invio per cambiarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度にアクティブなのは1言語だけです。Returnキーを上にスワイプすると切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 한 언어만 켜져 있어요. Return 키를 위로 밀면 바뀌어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuma satu bahasa aktif pada satu masa. Leret ke atas pada kekunci Return untuk tukar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só uma língua está ativa de cada vez. Desliza para cima na tecla Return para a trocar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активен только один язык за раз. Смахните вверх по клавише Return, чтобы его сменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次只启用一种语言。在回车键上往上滑就能切换。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Korraga on aktiivne ainult üks keel. Viipa sisestusklahvil üles, et see vahetada."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slegs een taal is op 'n slag aktief. Swiep op op die Return-sleutel om dit te verander."
          }
        }
      }
    },
    "Only the board's edge glows.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo brilla el borde del teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le bord du clavier s'illumine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Rand der Tastatur leuchtet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si illumina solo il bordo della tastiera."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a borda do teclado brilha."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya tepi papan kekunci bercahaya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a billentyűzet széle világít."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの縁だけが光ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有键盘边缘发光。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 가장자리만 빛납니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätab ainult klaviatuuri serv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светится только край клавиатуры."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Net die bord se rand gloei."
          }
        }
      }
    },
    "Only the last stretch stays lit. The tail fades out as you move, like a comet streak instead of a full line.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der letzte Abschnitt bleibt beleuchtet. Der Schwanz verblasst, während du dich bewegst, wie ein Kometenschweif statt einer durchgehenden Linie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el último tramo se queda iluminado. La cola se desvanece a medida que te mueves, como la estela de un cometa en vez de una línea entera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la dernière portion reste allumée. La queue s'estompe à mesure que tu bouges, comme une traînée de comète plutôt qu'une ligne entière."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az utolsó szakasz marad megvilágítva. A farok elhalványul, ahogy mozogsz, mint egy üstökös csóvája egy teljes vonal helyett."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta illuminato solo l'ultimo tratto. La coda svanisce mentre ti muovi, come la scia di una cometa invece di una linea intera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の部分だけが光ります。動くにつれて尾がフェードアウトし、線全体ではなく彗星の尾のようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 구간만 켜진 채로 있어요. 움직이면 꼬리가 흐려져서, 선 전체가 아니라 혜성 꼬리처럼 보여요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya bahagian terakhir kekal menyala. Ekornya pudar semasa anda bergerak, macam jejak komet, bukan garisan penuh."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o último troço fica aceso. A cauda desvanece-se enquanto te moves, como o rasto de um cometa em vez de uma linha completa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светится только последний отрезок. Хвост гаснет по мере движения — это скорее след кометы, чем целая линия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有最后一段保持点亮，尾巴随你移动淡出，像彗星拖尾，而不是一整条线。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgus jääb ainult viimasele lõigule. Saba tuhmub liikumisel, nagu komeedi saba täisrea asemel."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slegs die laaste stuk bly verlig. Die stert verdof soos jy beweeg, soos 'n komeetstreep in plaas van 'n vol lyn."
          }
        }
      }
    },
    "Only the text you selected. Empty if you didn't select any.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el texto que seleccionaste. Vacío si no seleccionaste nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement le texte que vous avez sélectionné. Vide si vous n'avez rien sélectionné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der von Ihnen ausgewählte Text. Leer, wenn Sie nichts ausgewählt haben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo il testo che hai selezionato. Vuoto se non hai selezionato nulla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o texto que selecionou. Vazio se não selecionou nada."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya teks yang anda pilih. Kosong jika anda tidak memilih apa-apa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a kijelölt szöveg. Üres, ha nem jelölt ki semmit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したテキストのみ。何も選択していない場合は空。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅你选中的文本。未选择任何内容时为空。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 텍스트만. 아무것도 선택하지 않으면 비어 있음."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainult tekst, mille valisid. Tühi, kui sa midagi ei valinud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только выделенный вами текст. Пусто, если вы ничего не выделили."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slegs die teks wat jy gekies het. Leeg as jy nie een gekies het nie."
          }
        }
      }
    },
