    "Keys grow and drift toward where you actually land.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleutels groei en dryf na waar jy eintlik land."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasten wachsen und wandern dorthin, wo du wirklich landest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas crecen y se desplazan hacia donde caen tus dedos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvid kasvavad ja triivivad sinna, kuhu sa tegelikult maandud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches s’agrandissent et se déplacent là où tu appuies vraiment."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk megnőnek, és arra vándorolnak, ahová valójában esel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti si ingrandiscono e si spostano dove atterri davvero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーが大きくなり、実際に触れている位置へ寄っていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 커지면서 실제로 누르는 자리 쪽으로 옮겨 갑니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci membesar dan beralih ke tempat ketikan anda benar-benar mendarat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas crescem e deslocam-se para onde de facto tocas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши растут и сдвигаются туда, куда вы на самом деле попадаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键会变大，并朝你真正落指的位置偏移。"
          }
        }
      }
    },
