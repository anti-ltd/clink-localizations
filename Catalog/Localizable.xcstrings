    "Inline composes on the suggestion bar while the keys stay up. Type to translate, then the result drops in.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Inlyn skryf op die voorstelbalk terwyl die sleutels op bly. Tik om te vertaal, dan val die resultaat in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline schreibt in der Vorschlagsleiste, die Tasten bleiben oben. Tipp los zum Übersetzen, dann landet das Ergebnis im Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redacta en línea, en la barra de sugerencias, con las teclas a la vista. Escribe para traducir y el resultado se inserta solo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Reasisene koostab soovituseribal, kui klahvid jäävad üles. Hakka tipitama, et tõlkida, siis tulemus langeb teksti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode intégré compose dans la barre de suggestions pendant que les touches restent affichées. Tape pour traduire, puis le résultat s'insère."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A javaslatsávon írhatsz, miközben a billentyűk fent maradnak. Írd be, mit fordítson, és megjelenik az eredmény."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità in linea scrive sulla barra dei suggerimenti mentre i tasti restano su. Digita per tradurre, poi il risultato scende nel campo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを出したまま、候補バーで文章を作ります。入力して翻訳すると、結果がそのまま入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 그대로 둔 채 추천 바에서 바로 작성해요. 입력해서 번역하면 결과가 들어가요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Karang terus pada bar cadangan sementara kekunci kekal naik. Taip untuk terjemah, kemudian hasilnya masuk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo em linha escreve na barra de sugestões enquanto as teclas ficam à mostra. Escreve para traduzir e o resultado entra logo a seguir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«В строке» собирает текст прямо в строке подсказок, не убирая клавиши. Печатаете для перевода — результат подставляется на место."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在建议栏里就地打字，按键不收起。输入就能翻译，结果直接填进去。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Compune în linie pe bara de sugestii în timp ce tastele rămân sus. Tastați pentru a traduce, apoi apare rezultatul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline componeert op de suggestiebalk terwijl de toetsen omhoog blijven. Typ om te vertalen en het resultaat komt binnen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在建議欄裡就地打字，按鍵不收起。輸入就能翻譯，結果直接填進去。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline komponuje na pasku sugestii, gdy klawisze pozostają w górze. Wpisz, aby przetłumaczyć, a wynik pojawi się."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вбудоване створення на панелі пропозицій, поки клавіші залишаються натиснутими. Введіть для перекладу, тоді з’явиться результат."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşlar açık durumdayken öneri çubuğuna satır içi yazı yazılır. Çevirmek için yazın, ardından sonuç ortaya çıkar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline se skládá na liště návrhů, zatímco klávesy zůstávají nahoře. Napište, co chcete přeložit, a výsledek se zobrazí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline sa skladá na paneli návrhov, zatiaľ čo klávesy zostávajú hore. Ak chcete preložiť, zadajte, potom sa zobrazí výsledok."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Inline συνθέτει στη γραμμή προτάσεων ενώ τα πλήκτρα παραμένουν ανοιχτά. Πληκτρολογήστε για μετάφραση και, στη συνέχεια, εμφανίζεται το αποτέλεσμα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline komponerar på förslagsfältet medan tangenterna stannar uppe. Skriv för att översätta, så faller resultatet in."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline komponerer på forslagslinjen, mens tasterne bliver oppe. Type to translate, then the result drops in."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline komponerer på forslagslinjen mens tastene forblir oppe. Skriv for å oversette, så faller resultatet inn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotettu säveltää ehdotuspalkissa, kun näppäimet pysyvät ylhäällä. Kirjoita kääntääksesi, sitten tulos putoaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penulisan sebaris di bilah saran sementara tombol tetap aktif. Ketik untuk menerjemahkan, lalu hasilnya muncul."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soạn nội tuyến trên thanh gợi ý trong khi các phím vẫn giữ nguyên. Gõ để dịch thì kết quả hiện ra."
          }
        }
      }
    },
