    "Smaller keys and tighter gaps, leaving more of the screen for your app.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinere Tasten und engere Abstände – mehr Bildschirm für deine App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas más pequeñas y espacios más estrechos, con más pantalla para tu app."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Väiksemad klahvid ja kitsamad vahed, rohkem ekraani sinu rakendusele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des touches plus petites et plus serrées, pour laisser plus d’écran à votre app."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kisebb billentyűk és szűkebb közök, több képernyő az alkalmazásodnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasti più piccoli e spazi più stretti, lasciando più schermo alla tua app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さめのキーと狭い間隔で、アプリの表示領域を広く取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 작은 키와 좁은 간격으로 앱 화면을 더 넓게 써요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci lebih kecil dan jarak lebih rapat, memberi lebih banyak skrin untuk apl anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas mais pequenas e espaços mais apertados, deixando mais ecrã para a tua app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши меньше, промежутки уже — больше места на экране для приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更小的按键、更紧凑的间距，为应用留出更多屏幕空间。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Taste mai mici și spații mai strânse, lăsând mai mult ecran pentru aplicația dvs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinere toetsen en kleinere openingen, waardoor er meer schermruimte overblijft voor uw app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更小的按鍵、更緊湊的間距，為應用留出更多螢幕空間。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleiner sleutels en nouer gapings, wat meer skermruimte vir jou toepassing laat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mniejsze klawisze i węższe odstępy, pozostawiając więcej ekranu dla Twojej aplikacji."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Менші клавіші та вузькі проміжки, залишаючи більше екрана для вашої програми."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha küçük tuşlar ve daha dar boşluklar, uygulamanız için ekranda daha fazla alan bırakır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Menší klávesy a užší mezery, takže pro vaši aplikaci zůstává více obrazovky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Menšie klávesy a užšie medzery, čím ponecháva viac obrazovky pre vašu aplikáciu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μικρότερα πλήκτρα και στενότερα κενά, αφήνοντας περισσότερο χώρο στην οθόνη για την εφαρμογή σας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindre nycklar och snävare luckor, vilket ger mer av skärmen för din app."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindre taster og mindre mellemrum, hvilket giver mere af skærmen til din app."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindre taster og tettere mellomrom, noe som gir mer av skjermen til appen din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pienemmät näppäimet ja tiukemmat välit jättävät enemmän näyttöä sovelluksellesi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol yang lebih kecil dan celah yang lebih rapat, sehingga menyisakan lebih banyak ruang untuk aplikasi Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím nhỏ hơn và khoảng cách hẹp hơn, để lại nhiều màn hình hơn cho ứng dụng của bạn."
          }
        }
      }
    },
