          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik butang dalam pratonton. Teks yang disisipkannya muncul di sini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca nos botões da pré-visualização. O texto que inserem aparece aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
