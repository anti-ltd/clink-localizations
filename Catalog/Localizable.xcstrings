    "Ask in your own words and Apple Intelligence answers from this FAQ, on your phone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag in eigenen Worten — Apple Intelligence antwortet aus dieser FAQ, auf deinem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta con tus palabras y Apple Intelligence responde a partir de estas preguntas, en tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose ta question avec tes mots : Apple Intelligence répond à partir de cette FAQ, sur ton téléphone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérdezz a saját szavaiddal, az Apple Intelligence pedig ebből a GYIK-ből válaszol, a telefonodon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi con parole tue e Apple Intelligence risponde partendo da queste FAQ, sul tuo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の言葉で質問すると、Apple IntelligenceがこのFAQをもとに端末内で答えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 말로 물어보면 Apple Intelligence가 이 FAQ를 바탕으로 기기 안에서 답해 줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanya dengan kata-kata sendiri dan Apple Intelligence menjawab daripada FAQ ini, dalam telefon anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunta pelas tuas palavras e a Apple Intelligence responde a partir destas perguntas, no teu telemóvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросите своими словами — Apple Intelligence ответит по этому FAQ прямо на вашем телефоне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你自己的话提问，Apple Intelligence 会依据这份常见问题，在你的手机上作答。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Küsi oma sõnadega ja Apple Intelligence vastab sellest KKK-st sinu telefonis."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vra in jou eie woorde en Apple Intelligence-antwoorde uit hierdie Gereelde Vrae, op jou foon."
          }
        }
      }
    },
