    "Clink pulls from your contacts, system text replacements, and its own custom iCloud-synced store.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Klink trek uit jou kontakte, stelselteksvervangings en sy eie persoonlike iCloud-gesinkroniseerde winkel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink greift auf deine Kontakte, die System-Textersetzungen und seinen eigenen, über iCloud synchronisierten Speicher zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink toma datos de tus contactos, las sustituciones de texto del sistema y su propio almacén personalizado sincronizado con iCloud."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ammutab sinu kontaktidest, süsteemi tekstiasendustest ja oma kohandatud iCloudi sünkroonitud salvestist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink puise dans tes contacts, les remplacements de texte du système et son propre stockage perso synchronisé via iCloud."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink a kapcsolataidból, a rendszer szövegcseréiből és a saját, iCloudon szinkronizált tárából merít."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink attinge dai tuoi contatti, dalle sostituzioni di testo del sistema e dal suo archivio personale sincronizzato via iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink は連絡先、システムのテキスト置換、そして iCloud で同期される独自のカスタム辞書から取り込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink는 연락처, 시스템 텍스트 대체어, 그리고 iCloud로 동기화되는 자체 저장소에서 가져와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ambil daripada kenalan anda, penggantian teks sistem, dan simpanan tersuai tersegerak iCloud sendiri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink recorre aos teus contactos, às substituições de texto do sistema e ao seu próprio arquivo sincronizado com o iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink берёт их из ваших контактов, системных замен текста и собственного хранилища, синхронизируемого через iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 会从你的联系人、系统文本替换，以及它自己那个 iCloud 同步的自定义库里取词。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink extrage din contactele dvs., înlocuiri de text de sistem și propriul magazin personalizat sincronizat cu iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink haalt uit uw contacten, systeemtekstvervangingen en zijn eigen aangepaste iCloud-gesynchroniseerde winkel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 會從你的聯絡人、系統文字替換，以及它自己那個 iCloud 同步的自定義庫裡取詞。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink pobiera dane z Twoich kontaktów, zamiany tekstów systemowych i własny, niestandardowy sklep zsynchronizowany z iCloud."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink отримує дані з ваших контактів, системних замін текстів і власного спеціального магазину, синхронізованого з iCloud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink, kişilerinizden, sistem metni değişimlerinden ve kendi özel iCloud ile senkronize edilmiş deposundan çekim yapar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink stahuje z vašich kontaktů, systémových náhrad textů a vlastního vlastního úložiště synchronizovaného se iCloud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink získava z vašich kontaktov, systémových náhrad textov a vlastného vlastného úložiska synchronizovaného so iCloud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Clink αντλεί από τις επαφές σας, αντικαταστάσεις κειμένου συστήματος και το δικό του προσαρμοσμένο κατάστημα συγχρονισμένο με iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink hämtar från dina kontakter, systemtextersättningar och sin egen anpassade iCloud-synkroniserade butik."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink henter fra dine kontakter, systemteksterstatninger og sin egen tilpassede iCloud-synkroniserede butik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink henter fra kontaktene dine, systemteksterstatninger og sin egen tilpassede iCloud-synkroniserte butikk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink hakee yhteystiedoistasi, järjestelmätekstin korvauksista ja omasta mukautetusta iCloud-synkronoidusta myymälästään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink diambil dari kontak Anda, penggantian teks sistem, dan penyimpanan khusus yang disinkronkan iCloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink lấy từ danh bạ của bạn, thay thế văn bản hệ thống và cửa hàng được đồng bộ hóa iCloud tùy chỉnh của riêng nó."
          }
        }
      }
    },
