        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색 타일을 탭하면 그 도구가 열립니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta värvilist plaati, et see tööriist avada."
          }
        },
        "ru": {
          "stringUnit": {
