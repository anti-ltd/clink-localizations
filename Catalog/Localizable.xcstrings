    "Type for a few days, then come back. It needs something to average.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik vir 'n paar dae en kom dan terug. Dit het iets nodig om te gemiddeld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp ein paar Tage und komm dann wieder — irgendwas muss es ja mitteln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe unos días y vuelve: necesita algo sobre lo que hacer la media."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipi mõni päev ja tule siis tagasi. Tal on vaja midagi, mida keskmistada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tape pendant quelques jours puis reviens : il lui faut de quoi faire une moyenne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gépelj pár napig, aztán nézz vissza — kell neki valami, amiből átlagot számol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi per qualche giorno e poi torna: gli serve qualcosa su cui fare la media."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数日使ってから戻ってきてください。平均を出すにはある程度の量が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "며칠 써 본 뒤에 다시 오세요. 평균을 내려면 어느 정도 쌓여야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menaip selama beberapa hari, kemudian kembali — ia perlukan sesuatu untuk dipuratakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve durante uns dias e volta cá — precisa de alguma coisa para fazer médias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попечатайте несколько дней и возвращайтесь — нужно что-то, что можно усреднить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先用几天再回来看：它得有点数据才能算平均。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastați câteva zile, apoi reveniți. Are nevoie de ceva la medie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ een paar dagen en kom dan terug. Er is iets nodig om te kunnen gemiddelde."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先用幾天再回來看：它得有點資料才能算平均。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisz przez kilka dni, a potem wróć. Potrzebuje czegoś do średniej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Набирайте кілька днів, потім повертайтеся. Треба щось усереднювати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç gün yaz, sonra geri gel. Ortalama bir şeye ihtiyacı var."
          }
        },
        "cs": {
