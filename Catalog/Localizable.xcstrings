            "state": "translated",
            "value": "そのバックアップからは何も復元できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 백업에서 복원할 수 있는 것이 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa dalam sandaran itu yang dapat dipulihkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível restaurar nada dessa cópia de segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
