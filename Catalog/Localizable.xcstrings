        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restabilește pachetul, volumul și reglajul implicit. Pachetele tale personalizate rămân."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelt het standaardpakket, volume en afstemming. Je aangepaste pakketten blijven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復預設聲音包、音量和聲音調節。自定義聲音包會保留。"
