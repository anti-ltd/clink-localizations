    "This plugin has no settings. It works from its hooks while you type.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Plugin hat keine Einstellungen. Es arbeitet beim Tippen über seine Hooks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plugin no tiene ajustes. Funciona con sus hooks mientras escribes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellel pistikprogrammil pole seadeid. See töötab tippimise ajal oma haakide kaudu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce plugin n’a pas de réglages. Ses fonctions se déclenchent pendant que tu tapes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek a bővítménynek nincsenek beállításai. Gépelés közben a horogpontjain keresztül működik."
          }
        },
        "it": {
          "stringUnit": {
