    "The full spectrum, running along the swipe.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die volle spektrum, loop langs die swipe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ganze Farbspektrum, entlang der Wischbewegung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el espectro, a lo largo del deslizamiento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Terve spekter, kulgedes pühkimise suunas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le spectre, le long de ton geste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes színskála a húzás mentén."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto lo spettro, lungo lo swipe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプに沿って虹色が流れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스와이프를 따라 흐르는 무지개색."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh spektrum, mengikut leretan anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o espetro, ao longo do deslize."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный спектр, бегущий вдоль движения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整条彩虹，顺着滑动铺开。"
          }
        }
      }
    },
    "The full toolbox": {
