    "Stands in for a flag. An emoji, a rune, a letter of the script.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Staan in vir 'n vlag. 'n Emoji, 'n rune, 'n letter van die skrif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steht anstelle einer Flagge: ein Emoji, eine Rune, ein Buchstabe der Schrift."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocupa el lugar de la bandera: un emoji, una runa, una letra del alfabeto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Asendab lippu. Emoji, ruun või kirja täht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace le drapeau : un émoji, une rune, une lettre de l’écriture."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A zászló helyén áll: egy emodzsi, egy rúna, az írás egy betűje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta al posto della bandiera: un’emoji, una runa, una lettera della scrittura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国旗の代わりに表示します。絵文字でも、ルーン文字でも、その文字体系の一文字でも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국기 자리에 들어갑니다. 이모지, 룬 문자, 그 문자 체계의 글자 하나 모두 좋습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggantikan bendera: emoji, rune, atau satu huruf tulisan itu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica no lugar da bandeira: um emoji, uma runa, uma letra da escrita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменяет флаг. Эмодзи, руна или буква нужной письменности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代替国旗显示：一个表情符号、一个符文，或这套文字里的一个字母。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înlocuiește un steag. Un emoji, o rună, o literă a scenariului."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat in voor een vlag. Een emoji, een rune, een letter van het script."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代替國旗顯示：一個表情符號、一個符文，或這套文字裡的一個字母。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastępuje flagę. Emoji, runa, litera scenariusza."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замінює прапор. Емодзі, руна, буква сценарію."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayrağı temsil ediyor. Bir emoji, bir rün, senaryonun bir harfi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastupuje vlajku. Emoji, runa, písmeno skriptu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastupuje vlajku. Emoji, runa, písmeno zo skriptu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στέκεται για μια σημαία. Ένα emoji, ένας ρούνος, ένα γράμμα του σεναρίου."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Står för en flagga. En emoji, en runa, en bokstav i manuset."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Står for et flag. En emoji, en rune, et bogstav i manuskriptet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Står for et flagg. En emoji, en rune, en bokstav i manuset."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seittää lippua. Emoji, riimu, käsikirjoituksen kirjain."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdiri untuk sebuah bendera. Emoji, rune, huruf naskah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đứng chờ một lá cờ. Một biểu tượng cảm xúc, một chữ rune, một chữ cái trong kịch bản."
          }
        }
      }
    },
