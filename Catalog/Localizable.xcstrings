    "Your edits since you applied %@ will be discarded.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Änderungen seit dem Anwenden von %@ werden verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descartarán los cambios que hayas hecho desde que aplicaste %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes modifications depuis l'application de %@ seront annulées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ alkalmazása óta végzett módosításaid elvesznek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche apportate da quando hai applicato %@ verranno scartate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を適用してから行った変更は破棄されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 적용한 이후의 변경 사항은 사라져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Suntingan anda sejak anda menggunakan %@ akan dibuang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações que fizeste desde que aplicaste %@ vão ser descartadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правки, сделанные после применения «%@», будут отменены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自从应用 %@ 之后的更改都会被放弃。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu muudatused pärast %@ rakendamist hüljatakse."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou wysigings sedert jy %@ toegepas het, sal weggegooi word."
          }
        }
      }
    },
    "Your edits to this action will be discarded.": {
      "extractionState": "manual",
      "localizations": {
