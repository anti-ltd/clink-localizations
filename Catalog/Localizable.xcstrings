    "This action requires a user tap.": {
      "comment": "Android-only: why an automation action cannot run automatically (iOS adds \"or Full Access\"; Android has no Full Access switch). Translations drafted for the Android port; native-speaker review required before release.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie aksie vereis dat jy tik."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato akce vyžaduje vaše klepnutí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne handling kræver et tryk fra dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion erfordert dein Antippen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η ενέργεια απαιτεί πάτημα από εσάς."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción requiere un toque del usuario."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See toiming nõuab kasutaja puudutust."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä toiminto vaatii napautuksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action nécessite un toucher de ta part."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a művelet felhasználói koppintást igényel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini memerlukan ketukan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione richiede un tocco dell’utente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアクションにはユーザーのタップが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동작에는 사용자 탭이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini memerlukan ketikan pengguna."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne handlingen krever et trykk fra deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor deze actie moet je tikken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta czynność wymaga Twojego dotknięcia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação requer um toque do utilizador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această acțiune necesită o atingere din partea ta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для действия требуется нажатие пользователя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto akcia vyžaduje vaše ťuknutie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här åtgärden kräver ett tryck från dig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem için dokunmanız gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця дія потребує вашого дотику."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này cần bạn chạm vào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作需要用户轻点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此動作需要你輕觸。"
          }
        }
      }
    },
    "Yes. Tools only swaps the whole app for one screen with the tools you've turned on.": {
      "comment": "Android-only: the FAQ's Tools only answer (Android's Tools mode shows the enabled tools; no dictation pad or AI tools). Translations drafted for the Android port; native-speaker review required before release.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja. Slegs gereedskap vervang die hele app met een skerm met die gereedskap wat jy aangeskakel het."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano. Režim Jen nástroje nahradí celou aplikaci jednou obrazovkou s nástroji, které jste zapnuli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja. Kun værktøjer erstatter hele appen med én skærm med de værktøjer, du har slået til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja. „Nur Werkzeuge“ ersetzt die ganze App durch einen Bildschirm mit den Werkzeugen, die du eingeschaltet hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ναι. Η λειτουργία Μόνο εργαλεία αντικαθιστά όλη την εφαρμογή με μία οθόνη με τα εργαλεία που έχετε ενεργοποιήσει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí. Solo herramientas cambia toda la app por una pantalla con las herramientas que hayas activado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jah. Ainult tööriistad asendab kogu rakenduse ühe ekraaniga, kus on sinu sisse lülitatud tööriistad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kyllä. Vain työkalut korvaa koko sovelluksen yhdellä näkymällä, jossa ovat käyttöön ottamasi työkalut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui. Outils seulement remplace toute l’app par un seul écran avec les outils que tu as activés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Igen. A Csak eszközök az egész appot egyetlen képernyőre cseréli a bekapcsolt eszközeiddel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya. Hanya alat mengganti seluruh aplikasi dengan satu layar berisi alat yang Anda aktifkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sì. Solo strumenti sostituisce l’intera app con una schermata con gli strumenti che hai attivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はい。「ツールのみ」にすると、アプリ全体がオンにしたツールだけの1画面になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네. 도구만 모드는 앱 전체를 켜 둔 도구만 있는 한 화면으로 바꿉니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya. Alat sahaja menggantikan seluruh apl dengan satu skrin berisi alat yang telah anda hidupkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja. Bare verktøy bytter ut hele appen med én skjerm med verktøyene du har slått på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja. Alleen tools vervangt de hele app door één scherm met de tools die je hebt aangezet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak. Tryb Tylko narzędzia zastępuje całą aplikację jednym ekranem z włączonymi narzędziami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sim. Só ferramentas troca o app inteiro por uma tela com as ferramentas que você ativou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Da. Doar instrumente înlocuiește toată aplicația cu un singur ecran cu instrumentele pe care le-ai activat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да. Режим «Только инструменты» заменяет всё приложение одним экраном с включёнными вами инструментами."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Áno. Režim Len nástroje nahradí celú aplikáciu jednou obrazovkou s nástrojmi, ktoré ste zapli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja. Endast verktyg byter ut hela appen mot en skärm med verktygen du har slagit på."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evet. Yalnızca araçlar, uygulamanın tamamını açtığınız araçların bulunduğu tek bir ekranla değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так. Режим «Лише інструменти» замінює весь застосунок одним екраном з увімкненими інструментами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có. Chỉ công cụ thay toàn bộ ứng dụng bằng một màn hình chứa các công cụ bạn đã bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以。“仅工具”会把整个应用换成一个屏幕，只显示你打开的工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以。「僅限工具」會把整個 App 換成單一畫面，只顯示你已開啟的工具。"
          }
        }
      }
    },
    "The keyboard follows: it opens on your tools, with the keys one tap away. Nothing is switched off.": {
      "comment": "Android-only: the FAQ's Tools only tip (the Android keyboard opens on the tools grid, not the mic). Translations drafted for the Android port; native-speaker review required before release.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sleutelbord volg: dit maak op jou gereedskap oop, met die sleutels een tik weg. Niks word afgeskakel nie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesnice se přizpůsobí: otevře se na vašich nástrojích a klávesy máte na jedno klepnutí. Nic se nevypíná."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturet følger med: det åbner på dine værktøjer, med tasterne ét tryk væk. Intet slås fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastatur folgt: Sie öffnet sich bei deinen Werkzeugen, die Tasten sind einen Tipp entfernt. Nichts wird ausgeschaltet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πληκτρολόγιο ακολουθεί: ανοίγει στα εργαλεία σας, με τα πλήκτρα ένα πάτημα μακριά. Τίποτα δεν απενεργοποιείται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado lo sigue: se abre en tus herramientas, con las teclas a un toque. No se desactiva nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuur järgib: see avaneb sinu tööriistadel ja klahvid on ühe puudutuse kaugusel. Midagi ei lülitata välja."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäimistö seuraa: se avautuu työkaluihisi, ja näppäimet ovat yhden napautuksen päässä. Mitään ei kytketä pois."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier suit : il s’ouvre sur tes outils, avec les touches à un toucher. Rien n’est désactivé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzet követi: az eszközeidnél nyílik meg, a billentyűk egy koppintásnyira vannak. Semmi sem kapcsol ki."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard ikut menyesuaikan: terbuka di alat Anda, dengan tombol hanya satu ketukan jauhnya. Tidak ada yang dimatikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera si adegua: si apre sui tuoi strumenti, con i tasti a un tocco. Non viene disattivato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードも連動します。ツールの画面で開き、キーはワンタップで出せます。何もオフにはなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드도 따라갑니다. 도구 화면으로 열리고, 키는 한 번 탭하면 나옵니다. 꺼지는 것은 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci menyusul: ia dibuka pada alat anda, dengan kekunci hanya satu ketikan. Tiada apa yang dimatikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturet følger etter: det åpner på verktøyene dine, med tastene ett trykk unna. Ingenting slås av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het toetsenbord volgt: het opent op je tools, met de toetsen één tik verderop. Er wordt niets uitgeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawiatura się dostosowuje: otwiera się na Twoich narzędziach, a klawisze są o jedno dotknięcie. Nic nie jest wyłączane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado acompanha: ele abre nas suas ferramentas, com as teclas a um toque. Nada é desligado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastatura urmează: se deschide pe instrumentele tale, cu tastele la o atingere distanță. Nimic nu este dezactivat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура следует за этим: она открывается на ваших инструментах, а клавиши — в одно касание. Ничего не отключается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesnica sa prispôsobí: otvorí sa na vašich nástrojoch a klávesy máte na jedno ťuknutie. Nič sa nevypína."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangentbordet följer med: det öppnas på dina verktyg, med tangenterna ett tryck bort. Inget stängs av."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye de uyum sağlar: araçlarınızla açılır, tuşlar bir dokunuş uzaklıktadır. Hiçbir şey kapatılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіатура підлаштовується: вона відкривається на ваших інструментах, а клавіші — за один дотик. Нічого не вимикається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bàn phím cũng theo đó: mở ra ở các công cụ của bạn, còn phím chỉ cách một lần chạm. Không có gì bị tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘也会跟着变：它会打开在你的工具上，按键一点即出。没有任何功能被关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤也會跟著調整：開啟時顯示你的工具，按鍵只需輕觸一下即可叫出。不會關閉任何功能。"
          }
        }
      }
    },
    "Return to keys": {
      "comment": "iOS copy missing from the shared catalog (the Handwriting and Calculator panels' keyboard button; iOS reads it in English). The Android Translate and Handwriting panels label their keyboard button with it. Translations drafted for the Android port; native-speaker review required before release. Add to clink-index.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Terug na sleutels"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zpět na klávesy"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbage til tasterne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück zu den Tasten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιστροφή στα πλήκτρα"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a las teclas"
          }
        },
        "et": {
          "stringUnit": {
