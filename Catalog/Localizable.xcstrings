    "Light up the key you hit on top of the moving light.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lig die sleutel wat jy slaan bo-op die bewegende lig aan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gedrückte Taste leuchtet zusätzlich zum bewegten Licht auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina la tecla que pulsas además de la luz en movimiento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Süüta vajutatud klahv lisaks liikuvale valgusele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éclairez la touche frappée en plus de la lumière en mouvement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lenyomott gomb a mozgó fény mellett is felvillan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Illumina il tasto premuto oltre alla luce in movimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動く光に加えて、押したキーも光らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흐르는 조명 위에, 누른 키도 함께 켭니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terangi kekunci yang anda tekan selain cahaya yang bergerak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina a tecla premida além da luz em movimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсвечивать нажатую клавишу поверх движущегося света."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在流动的灯光之外，再点亮你按下的按键。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprindeți tasta pe care ați apăsat deasupra luminii în mișcare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlicht de toets die je indrukt bovenop het bewegende licht."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在流動的燈光之外，再點亮你按下的按鍵。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozświetl klawisz, który naciśniesz na ruchomym świetle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Засвітіть ключ, по якому ви натискаєте, поверх рухомого світла."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketli ışığın üzerinde bastığınız tuşu aydınlatın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozsviťte klíč, který stisknete na horní části pohybujícího se světla."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozsvieťte kľúč, ktorý ste stlačili na hornú časť pohybujúceho sa svetla."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανάψτε το πλήκτρο που χτυπάτε πάνω από το κινούμενο φως."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lys upp tangenten du trycker på ovanpå det rörliga ljuset."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tænd den tast, du trykker på, oven på det bevægelige lys."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lys opp tasten du treffer på toppen av det bevegelige lyset."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sytytä näppäin, jonka painat liikkuvan valon päällä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan kunci yang Anda tekan di atas lampu bergerak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thắp sáng phím bạn nhấn trên đầu đèn chuyển động."
          }
        }
      }
    },
