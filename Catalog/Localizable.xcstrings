          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite prepínač profilov a môžete vymieňať profily zo samotnej klávesnice."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε τον διακόπτη προφίλ και μπορείτε να ανταλλάξετε προφίλ από το ίδιο το πληκτρολόγιο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på profilväxeln så kan du byta profiler från själva tangentbordet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tænd for Profile Switcher, og du kan bytte profiler fra selve tastaturet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på profilbytteren og du kan bytte profiler fra selve tastaturet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kytke profiilinvaihto päälle ja voit vaihtaa profiileja itse näppäimistöstä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
