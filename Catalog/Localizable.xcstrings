    "Open Clink, go to General, and tap Unlock the Keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak Clink oop, gaan na Algemeen en tik Ontsluit die sleutelbord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Clink, geh auf „Allgemein“ und tippe auf „Tastatur freischalten“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Clink, ve a General y toca Desbloquear el teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava Clink, mine Üldisesse ja puuduta Klaviatuuri avamine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Clink, va dans Général et touche Débloquer le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Clinket, menj az Általános fülre, és koppints a Billentyűzet feloldása elemre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Clink, vai su Generali e tocca Sblocca la tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkを開き、「一般」から「キーボードのロックを解除」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink을 열고 일반으로 가서 키보드 잠금 해제를 누르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Clink, pergi ke Umum, dan ketik Buka Kunci Papan Kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Clink, vai a Geral e toca em Desbloquear o teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Clink, зайдите в «Общие» и нажмите «Разблокировать клавиатуру»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Clink，进“通用”，点“解锁键盘”。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți Clink, accesați General și atingeți Deblocați tastatura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Clink, ga naar Algemeen en tik op Het toetsenbord ontgrendelen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Clink，進“通用”，點“解鎖鍵盤”。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Clink, przejdź do Ogólne i dotknij Odblokuj klawiaturę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Clink, перейдіть до «Загальні» та торкніться «Розблокувати клавіатуру»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink'i açın, Genel'e gidin ve Klavyenin Kilidini Aç'a dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete Clink, přejděte na Obecné a klepněte na Odemknout klávesnici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte Clink, prejdite na Všeobecné a klepnite na Odomknúť klávesnicu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το Clink, μεταβείτε στα Γενικά και πατήστε Ξεκλείδωμα του πληκτρολογίου."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Clink, gå till Allmänt och tryck på Lås upp tangentbordet."
          }
        },
        "da": {
