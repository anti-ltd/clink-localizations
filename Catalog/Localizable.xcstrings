    "Answered on your phone, from this FAQ.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beantwoord op jou foon, uit hierdie algemene vrae."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auf deinem Handy beantwortet, aus diesen FAQ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se responde en tu teléfono, a partir de estas preguntas."
          }
        },
