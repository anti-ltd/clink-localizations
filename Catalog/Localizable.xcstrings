    "No counts in the file, so Clink is treating the list’s order as most-common-first.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen tellings in die lêer nie, so Clink behandel die lys se volgorde as mees-algemene-eerste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Häufigkeiten in der Datei – Clink nimmt die Reihenfolge der Liste als „häufigste zuerst“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no trae frecuencias, así que Clink toma el orden de la lista como «más comunes primero»."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Failis sagedusi pole, seega Clink käsitleb loendi järjekorda kui „kõige sagedasemad esimesena\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de fréquences dans le fichier : Clink considère l’ordre de la liste comme « les plus courants d’abord »."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlban nincsenek gyakoriságok, ezért a Clink a lista sorrendjét veszi „leggyakoribb elöl” sorrendnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna frequenza nel file: Clink interpreta l’ordine dell’elenco come «prima le più comuni»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルに出現数がないため、リストの並び順を「よく使う順」として扱います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에 빈도가 없어, Clink는 목록 순서를 자주 쓰는 순서로 봅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada kiraan dalam fail, jadi Clink menganggap susunan senarai sebagai paling biasa dahulu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro não traz frequências, por isso o Clink assume a ordem da lista como «mais comuns primeiro»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В файле нет частот, поэтому Clink считает, что список отсортирован от самых частых слов к редким."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件中没有词频，Clink 会把词表顺序当作从常用到少用。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu se numără în fișier, așa că Clink tratează ordinea listei ca fiind cea mai comună-întâi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen tellingen in het bestand, dus Clink behandelt de volgorde van de lijst als meest voorkomende eerst."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案中沒有詞頻，Clink 會把詞表順序當作從常用到少用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W pliku nie ma żadnych liczników, więc Clink traktuje kolejność na liście jako najczęstsza-pierwsza."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У файлі немає підрахунків, тому Clink обробляє порядок списку як найпоширеніший спочатку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyada sayım olmadığından Clink listenin sırasını en yaygın olan ilk sırayı alacak şekilde ele alır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V souboru nejsou žádné počty, takže Clink zachází s pořadím seznamu jako s nejčastějším prvním."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V súbore nie sú žiadne počty, takže Clink považuje poradie zoznamu za najčastejšie prvé."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μετράει στο αρχείο, επομένως το Clink αντιμετωπίζει τη σειρά της λίστας ως την πιο κοινή-πρώτη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga räkningar i filen, så Clink behandlar listans ordning som vanligast-först."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tæller i filen, så Clink behandler listens rækkefølge som den mest almindelige-først."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tellinger i filen, så Clink behandler listens rekkefølge som mest-vanlig-først."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostossa ei ole laskelmia, joten Clink käsittelee luettelon järjestystä yleisin-ensimmäisenä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada hitungan dalam file, jadi Clink memperlakukan urutan daftar sebagai yang paling umum-pertama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có số lượng nào trong tệp, vì vậy Clink đang xử lý thứ tự của danh sách là phổ biến nhất trước tiên."
          }
        }
      }
    },
