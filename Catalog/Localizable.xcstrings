    "Search this page for whatever's wrong, in a full sentence if you like.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Soek hierdie bladsy vir wat ook al fout is, in 'n volsin as jy wil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Such auf dieser Seite nach dem, was klemmt — ruhig als ganzen Satz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en esta página lo que te pasa, en una frase entera si quieres."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsi sellelt lehelt seda, mis valesti on, vajadusel tervelausena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherche sur cette page ce qui cloche, en une phrase complète si tu veux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Keress rá ezen az oldalon arra, ami nem stimmel — akár egész mondatban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca in questa pagina quello che non va, anche con una frase intera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "困っていることを、このページの検索欄に入力します。文章のままで構いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이 문제인지 이 페이지 검색란에 적으세요. 문장 그대로도 괜찮습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari pada halaman ini apa yang tidak kena, dalam ayat penuh pun boleh."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Procura nesta página o que está a correr mal, numa frase inteira se quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поищите на этой странице то, что не так, — можно целым предложением."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把出问题的地方打进本页搜索框，写成一整句也行。"
          }
        }
      }
    },
