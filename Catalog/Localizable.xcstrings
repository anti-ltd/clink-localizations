    "Bigger, rounder keys with more room around them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größere, rundere Tasten mit mehr Platz drumherum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas más grandes y redondeadas, con más espacio alrededor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Suuremad, ümaramad klahvid, mille ümber on rohkem ruumi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des touches plus grandes et plus arrondies, avec plus d’espace autour."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagyobb, kerekebb billentyűk, több hellyel körülöttük."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasti più grandi e arrotondati, con più spazio intorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きく丸みのあるキーで、周りに余裕を持たせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 크고 둥근 키에 주변 여백도 넉넉해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci lebih besar dan bulat dengan lebih banyak ruang di sekelilingnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas maiores e mais redondas, com mais espaço à volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши крупнее и круглее, с большим простором вокруг."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更大、更圆润的按键，周围留有更多空间。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Chei mai mari, mai rotunde, cu mai mult spațiu în jurul lor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grotere, rondere toetsen met meer ruimte eromheen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更大、更圓潤的按鍵，周圍留有更多空間。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Groter, meer afgeronde toetse met meer ruimte rondom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Większe, bardziej okrągłe klawisze i więcej miejsca wokół nich."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більші круглі клавіші з більшим простором навколо них."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etraflarında daha fazla yer bulunan daha büyük, daha yuvarlak tuşlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Větší, kulatější klávesy s větším prostorem kolem nich."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Väčšie, okrúhle klávesy s väčším priestorom okolo nich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεγαλύτερα, πιο στρογγυλά πλήκτρα με περισσότερο χώρο γύρω τους."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Större, rundare nycklar med mer utrymme runt dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Større, rundere nøgler med mere plads omkring dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Større, rundere nøkler med mer plass rundt dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suuremmat, pyöreämmät avaimet, joissa on enemmän tilaa niiden ympärillä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci yang lebih besar dan bulat dengan lebih banyak ruang di sekelilingnya."
