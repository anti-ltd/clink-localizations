    "Notes in this group become ungrouped.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas in hierdie groep raak ongegroepeer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen in dieser Gruppe werden aus der Gruppe entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas de este grupo quedarán sin grupo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selles grupis olevad märkmed muutuvad grupita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes de ce groupe ne seront plus classées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csoport jegyzetei csoport nélkül maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note in questo gruppo non apparterranno più a nessun gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループのメモはグループなしになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹의 메모는 그룹 없음으로 이동합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota dalam kumpulan ini akan menjadi tanpa kumpulan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas deste grupo ficarão sem grupo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметки из этой группы останутся без группы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此组中的笔记将变为未分组。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notele din acest grup devin negrupate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities in deze groep worden gedegroepeerd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此組中的筆記將變為未分組。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatki w tej grupie zostaną rozgrupowane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нотатки в цій групі розгруповуються."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gruptaki notların grubu çözülür."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámky v této skupině budou seskupeny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámky v tejto skupine sa rozdelia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σημειώσεις σε αυτήν την ομάδα δεν ομαδοποιούνται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteckningar i denna grupp blir ogrupperade."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter i denne gruppe bliver ugrupperet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notater i denne gruppen blir deaktivert."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän ryhmän muistiinpanot poistetaan ryhmittelystä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan dalam grup ini menjadi tidak dikelompokkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ghi chú trong nhóm này sẽ được tách nhóm."
          }
        }
      }
    },
    "Notes keeps what you jot, to browse and load later.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas hou wat jy aanteken, om later te blaai en te laai."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen behält, was du notierst — zum Durchsehen und späteren Einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas guarda lo que apuntas para consultarlo y usarlo después."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märkmed hoiab seda, mida märgid, et hiljem sirvida ja laadida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes garde ce que tu écris, pour le retrouver et l'insérer plus tard."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Jegyzetek megőrzi, amit leírsz, hogy később átnézd és beszúrd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Note conserva quello che scrivi, per rileggerlo e inserirlo dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「メモ」は書いたものを残し、後から見て呼び出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘메모’는 적어 둔 걸 남겨서 나중에 보고 불러올 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota menyimpan apa yang anda catat, untuk dilihat dan dimuatkan kemudian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As Notas guardam o que escreves, para veres e inserires depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Заметки» хранят то, что вы записали, — чтобы потом просмотреть и вставить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“笔记”会留住你写下的内容，之后可以翻看再插入。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes păstrează ceea ce notați, pentru a naviga și a încărca mai târziu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes bewaart wat u noteert, zodat u er later doorheen kunt bladeren en laden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“筆記”會留住你寫下的內容，之後可以翻看再插入。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatki przechowują to, co zanotujesz, aby przeglądać i wczytywać je później."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нотатки зберігають те, що ви записуєте, щоб потім переглядати та завантажувати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notlar, notlarınızı daha sonra göz atmak ve yüklemek için saklar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámky ukládají, co jste si poznamenali, abyste je mohli procházet a načítat později."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácia Notes uchováva to, čo si zaznamenáte, na neskoršie prehliadanie a načítanie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Notes κρατά αυτό που σημειώνετε, για περιήγηση και φόρτωση αργότερα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes sparar det du skriver, för att bläddra och ladda senare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes gemmer det, du noterer, for at gennemse og indlæse senere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes beholder det du skriver, for å bla gjennom og laste inn senere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes säilyttää kirjoittamasi tekstin, jotta voit selata ja ladata myöhemmin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan menyimpan apa yang Anda catat, untuk dijelajahi dan dimuat nanti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú lưu giữ những gì bạn ghi để duyệt và tải sau."
          }
        }
      }
    },
