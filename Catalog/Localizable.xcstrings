    "Helps with corrections the keyboard isn't sure about.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilft bei Korrekturen, bei denen sich die Tastatur unsicher ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda con las correcciones de las que el teclado no está seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide sur les corrections dont le clavier n'est pas sûr."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Segít azoknál a javításoknál, amikben a billentyűzet nem biztos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta con le correzioni di cui la tastiera non è sicura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードが迷っている修正を手助けします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 긴가민가하는 수정을 도와줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membantu dengan pembetulan yang papan kekunci tak pasti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda nas correções sobre as quais o teclado não tem a certeza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогает там, где клавиатура не уверена в исправлении."
          }
