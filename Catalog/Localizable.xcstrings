          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd lenyomva a szóközt, és a billentyűk trackpaddé válnak. Csúsztass bárhová."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
