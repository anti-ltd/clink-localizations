    "Off hides the shift key and stops Clink capitalising anything, the way Arabic works. Turn it off for a script with one case.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Off versteek die shift-sleutel en stop Clink om enigiets te kapitaliseer, soos Arabies werk. Skakel dit af vir 'n skrif met een kassie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus blendet die Umschalttaste aus und Clink schreibt nichts mehr groß, so wie bei Arabisch. Schalte es aus, wenn deine Schrift nur eine Form kennt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado oculta la tecla de mayúsculas y Clink deja de poner nada en mayúscula, igual que en árabe. Desactívalo si tu escritura solo tiene una forma."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Väljas peidab tõstuklahvi ja Clink ei kirjuta enam midagi suureks, nagu araabia puhul. Lülita see välja kirjaviisi jaoks, millel on ainult üks tähekuju."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, la touche majuscule disparaît et Clink ne met plus rien en capitale, comme pour l’arabe. À désactiver pour une écriture sans casse."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikapcsolva eltűnik a shift, és a Clink semmit nem ír nagybetűvel, ahogy az arabnál. Kapcsold ki, ha az írásodnak csak egy alakja van."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, il tasto maiuscolo sparisce e Clink non mette più nulla in maiuscolo, come per l’arabo. Disattivalo per una scrittura con una sola forma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると Shift キーが消え、Clink は何も大文字にしません（アラビア語と同じ挙動です）。大小の区別がない文字体系ではオフに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 Shift 키가 사라지고 Clink가 아무것도 대문자로 바꾸지 않습니다. 아랍어와 같은 방식이며, 대소문자 구분이 없는 문자 체계라면 끄세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika dimatikan, kekunci shift disembunyikan dan Clink tidak membesarkan sebarang huruf, sama seperti bahasa Arab. Matikan untuk tulisan yang hanya ada satu bentuk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado, a tecla shift desaparece e o Clink deixa de pôr seja o que for em maiúscula, como no árabe. Desliga-o para uma escrita sem maiúsculas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено — клавиша Shift скрыта, и Clink ничего не переводит в заглавные, как в арабском. Выключайте для письменностей без деления на регистры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后会隐藏 Shift 键，Clink 也不再把任何字母变成大写，阿拉伯语就是这样。文字若不分大小写，就关掉它。"
          }
        }
      }
    },
    "Off in Settings": {
      "extractionState": "manual",
      "localizations": {
        "af": {
