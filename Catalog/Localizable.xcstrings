    "Hit space and Clink applies its best guess. Text shortcuts always win. Tap the bar to undo.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik spasie en Clink pas sy beste raaiskoot toe. Tekskortpaaie wen altyd. Tik die balk om te ontdoen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück die Leertaste und Clink wendet seine beste Vermutung an. Textkürzel gewinnen immer. Tipp auf die Leiste zum Rückgängigmachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa espacio y Clink aplica su mejor conjetura. Los atajos de texto siempre ganan. Toca la barra para deshacer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajuta tühikut ja Clink rakendab oma parima pakkumise. Teksti otseteed võidavad alati. Puuduta riba, et tagasi võtta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur espace et Clink applique sa meilleure proposition. Les raccourcis de texte l'emportent toujours. Touche la barre pour annuler."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomj szóközt, és a Clink alkalmazza a legjobb tippjét. A szövegrövidítések mindig nyernek. Koppints a sávra a visszavonáshoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi spazio e Clink applica la sua ipotesi migliore. Le scorciatoie di testo vincono sempre. Tocca la barra per annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースを押すと、Clink がいちばんの予測を適用します。テキストショートカットが常に優先されます。バーをタップすると取り消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스를 누르면 Clink가 가장 그럴듯한 추측을 적용해요. 텍스트 단축어가 항상 우선이에요. 바를 탭하면 되돌려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan ruang dan Clink guna tekaan terbaiknya. Pintasan teks sentiasa menang. Ketik bar untuk buat asal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega no espaço e o Clink aplica o seu melhor palpite. Os atalhos de texto ganham sempre. Toca na barra para desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите пробел — и Clink применит лучший вариант. Сокращения текста всегда в приоритете. Нажмите на строку, чтобы отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按空格，Clink 就用它最好的猜测。文本快捷替换总是优先。点候选栏可以撤销。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați spațiu și Clink își aplică cea mai bună estimare. Comenzile rapide de text câștigă întotdeauna. Atingeți bara pentru a anula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raak de spatiebalk aan en Clink past de beste gok toe. Tekstsnelkoppelingen winnen altijd. Tik op de balk om ongedaan te maken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按空格，Clink 就用它最好的猜測。文字快捷替換總是優先。點候選欄可以撤銷。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij spację, a Clink zastosuje najlepsze przypuszczenie. Skróty tekstowe zawsze wygrywają. Kliknij pasek, aby cofnąć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть пробіл, і Clink застосовує найкраще припущення. Текстові ярлики завжди виграють. Торкніться панелі, щоб скасувати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluk tuşuna bastığınızda Clink en iyi tahminini uygular. Metin kısayolları her zaman kazanır. Geri almak için çubuğa dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hit prostor a Clink použije svůj nejlepší odhad. Textové zkratky vždy vyhrávají. Klepnutím na lištu akci vrátíte zpět."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasiahnite priestor a Clink použije svoj najlepší odhad. Textové skratky vždy vyhrávajú. Klepnutím na panel akciu vrátite späť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Hit space και το Clink εφαρμόζει την καλύτερη εικασία του. Οι συντομεύσεις κειμένου πάντα κερδίζουν. Πατήστε τη γραμμή για αναίρεση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hit space och Clink tillämpar sin bästa gissning. Textgenvägar vinner alltid. Tryck på fältet för att ångra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hit space og Clink anvender sit bedste gæt. Tekstgenveje vinder altid. Tryk på bjælken for at fortryde."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Treff mellomrom og Clink bruker sin beste gjetning. Tekstsnarveier vinner alltid. Trykk på linjen for å angre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina tilaa ja Clink käyttää parasta arvaustaan. Tekstin pikanäppäimet voittaa aina. Kumoa napauttamalla palkkia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan spasi dan Clink menerapkan tebakan terbaiknya. Pintasan teks selalu menang. Ketuk bilah untuk membatalkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn dấu cách và Clink áp dụng dự đoán tốt nhất của nó. Phím tắt văn bản luôn giành chiến thắng. Nhấn vào thanh để hoàn tác."
          }
        }
      }
    },
