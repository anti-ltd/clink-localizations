          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta soovitusel, et seda kasutada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь подсказки, чтобы использовать её"
          }
        },
        "af": {
          "stringUnit": {
