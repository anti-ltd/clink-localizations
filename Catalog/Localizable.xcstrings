        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvid on minu jaoks liiga ümarad"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die sleutels is te rond vir my"
          }
        }
      }
    },
    "The keys you use most stay the warmest.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas que más usas se mantienen más cálidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches les plus utilisées restent les plus chaudes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tasten, die du am häufigsten nutzt, bleiben am wärmsten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti che usi di più restano i più caldi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas que usas mais ficam mais quentes."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci yang paling anda guna kekal paling panas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legtöbbet használt gombok maradnak a legmelegebbek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使うキーがいちばん暖かい色のままになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你用得最多的按键会一直最热。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 많이 쓰는 키가 가장 뜨겁게 남습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvid, mida sa kõige rohkem kasutad, püsivad kõige soojemad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самые используемые клавиши остаются самыми тёплыми."
          }
        },
        "af": {
