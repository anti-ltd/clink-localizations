        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar pictograma, felul în care bara a desenat-o întotdeauna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen het pictogram, zoals de balk het altijd heeft getekend."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有圖示，和工具欄一直以來的樣子一樣。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko ikona, tak jak zawsze rysował ją pasek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Просто ікона, як завжди малювала панель."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece çubuğun her zaman çizdiği simge."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen ikona, tak jak ji panel vždy kreslil."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Len ikona, tak ako ju panel vždy kreslil."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο το εικονίδιο, όπως το σχεδίαζε πάντα η μπάρα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara ikonen, så som stapeln alltid har ritat den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare ikonet, sådan som bjælken altid har tegnet det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare ikonet, slik linjen alltid har tegnet det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain kuvake, kuten palkki on aina piirtänyt sen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya ikonnya, seperti yang selalu digambar bilahnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ là biểu tượng, cách mà thanh vẫn luôn vẽ."
          }
        }
      }
    },
