    "Turn Apple Intelligence on in Clink to look words up.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Apple Intelligence en Clink para consultar palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Apple Intelligence dans Clink pour chercher des mots."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Apple Intelligence in Clink, um Wörter nachzuschlagen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Apple Intelligence in Clink per cercare le parole."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a Apple Intelligence no Clink para consultar palavras."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Apple Intelligence dalam Clink untuk mencari perkataan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be az Apple Intelligence-t a Clinkben a szavak kikereséséhez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語を調べるには Clink で Apple Intelligence をオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Clink 中开启 Apple Intelligence 以查询单词。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어를 찾으려면 Clink에서 Apple Intelligence를 켜세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sõnade otsimiseks lülita Apple Intelligence Clinkis sisse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Apple Intelligence в Clink, чтобы искать слова."
          }
        }
      }
    },
    "Turn Auto-correction off, and leave Suggestion bar on if you still want the three suggestions.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel outo-korreksie af en laat die voorstelbalk aan as jy steeds die drie voorstelle wil hê."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte die Autokorrektur aus und lass die Vorschlagsleiste an, wenn du die drei Vorschläge behalten willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva la Corrección automática y deja la Barra de sugerencias activada si aún quieres las tres sugerencias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita Automaatparandus välja ja jäta Soovituseriba sisse, kui soovid kolm soovitust ikka."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive la Correction automatique, et laisse la Barre de suggestions active si tu veux garder les trois suggestions."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold ki az Automatikus javítást, és hagyd bekapcsolva a Javaslatsávot, ha kellenek a javaslatok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva la Correzione automatica e lascia attiva la Barra dei suggerimenti se vuoi ancora i tre suggerimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動修正」をオフにします。3つの候補を残したいときは「候補バー」はオンのままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 수정을 끄고, 추천 세 개는 계속 보고 싶다면 추천 바는 켠 채로 두세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan Pembetulan automatik, dan biarkan Bar cadangan hidup jika anda masih mahukan tiga cadangan itu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga a Correção automática e deixa a Barra de sugestões ligada se ainda quiseres as três sugestões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите автокоррекцию, а «Строку подсказок» оставьте включённой, если хотите сохранить три варианта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关掉“自动更正”；如果还想要那三个建议，就把“建议栏”留着。"
          }
        }
      }
    },
    "Turn Auto-correction off. Leave the Suggestion bar on if you still want the three suggestions.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere Autokorrektur. Lass Vorschlagsleiste aktiviert, wenn du die drei Vorschläge weiterhin sehen möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva Corrección automática. Deja activada Barra de sugerencias si quieres seguir viendo las tres sugerencias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita „Automaatparandus” välja. Kui soovid endiselt näha kolme soovitust, jäta „Soovituseriba” sisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive Correction automatique. Laisse Barre de suggestions activée si tu veux toujours voir les trois suggestions."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold ki az Automatikus javítás beállítást. Ha továbbra is szeretnéd látni a három javaslatot, hagyd bekapcsolva a Javaslatsávot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva Correzione automatica. Lascia attiva Barra dei suggerimenti se vuoi continuare a vedere i tre suggerimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動修正」をオフにします。3つの候補を引き続き表示したい場合は、「候補バー」をオンのままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘자동 수정’을 끄세요. 추천 단어 세 개를 계속 보고 싶다면 ‘추천 바’는 켜 두세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan Pembetulan automatik. Biarkan Bar cadangan hidup jika anda masih mahukan tiga cadangan itu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativa Correção automática. Deixa Barra de sugestões ativa se quiseres continuar a ver as três sugestões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите «Автокоррекция». Оставьте «Строка подсказок» включённой, если хотите видеть три подсказки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭“自动更正”。如果仍想看到三个候选词，请保持“建议栏”开启。"
          }
        }
      }
    },
    "Turn Backdrop off to let the app you're typing in show through.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere Hintergrund, damit die App durchscheint, in der du gerade tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva Fondo para dejar ver la app en la que estás escribiendo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita „Taust” välja, et rakendus, milles tipid, läbi paistaks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive Arrière-plan pour laisser apparaître l’app dans laquelle tu écris."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold ki a Háttér beállítást, hogy átlátsszon az app, amelyben gépelsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva Sfondo per lasciare intravedere l’app in cui stai scrivendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「背景」をオフにすると、入力中のアプリが透けて見えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘배경’을 끄면 입력 중인 앱이 키보드 뒤로 비쳐 보입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan Latar belakang supaya app yang anda gunakan untuk menaip kelihatan di sebaliknya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativa Fundo para deixar ver a app em que estás a escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите «Задний план», чтобы сквозь клавиатуру было видно приложение, в котором вы печатаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭“背景”，即可透过键盘看到正在输入的 App。"
          }
        }
      }
    },
