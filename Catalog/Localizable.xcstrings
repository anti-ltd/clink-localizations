    "Backspace the line away before the next one": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rugspasieer die reël weg voor die volgende een"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeile mit der Rücktaste löschen, bevor die nächste kommt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra la línea con retroceso antes de la siguiente"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustuta rida ära enne järgmist"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer la ligne au retour arrière avant la suivante"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törlöd a sort, mielőtt jön a következő"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella la riga col backspace prima della successiva"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の行に進む前に、その行を消します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 줄로 가기 전에 백스페이스로 줄을 지워요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam baris itu dulu sebelum yang seterusnya"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga a linha com o backspace antes da próxima"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стирать строку перед следующей"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打下一行之前，用退格把这一行删掉"
