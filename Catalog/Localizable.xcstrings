        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz to. Jest od razu dostępny w menu narzędzi klawiatury."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть його. Це відразу в меню інструментів клавіатури."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açın. Hemen klavyenin araçlar menüsündedir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte to. Je to hned v nabídce nástrojů klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite ho. Je to hneď v ponuke nástrojov klávesnice."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε το. Βρίσκεται αμέσως στο μενού εργαλείων του πληκτρολογίου."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på den. Det finns i tangentbordets verktygsmeny direkt."
