    "Camera unavailable. Choose From Photo or allow camera access in Settings.": {
      "extractionState": "manual",
      "comment": "Photo theme import: camera capture and local processing.",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kamera is nie beskikbaar nie. Kies Van foto of laat kameratoegang in Instellings toe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoaparát není dostupný. Vyberte Z fotky nebo povolte přístup k fotoaparátu v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraet er ikke tilgængeligt. Vælg Fra foto, eller tillad kameraadgang i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera ist nicht verfügbar. Wähle Aus Foto oder erlaube den Kamerazugriff in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κάμερα δεν είναι διαθέσιμη. Επίλεξε Από φωτογραφία ή επίτρεψε την πρόσβαση στην κάμερα στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no está disponible. Elige Desde una foto o permite el acceso a la cámara en Ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaamera pole saadaval. Vali Fotost või luba seadetes juurdepääs kaamerale."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera ei ole käytettävissä. Valitse Kuvasta tai salli kameran käyttö asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra est indisponible. Choisis À partir d’une photo ou autorise l’accès à la caméra dans les réglages."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kamera nem érhető el. Válaszd a Fotóból lehetőséget, vagy engedélyezd a kamera használatát a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera tidak tersedia. Pilih Dari Foto atau izinkan akses kamera di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera non è disponibile. Scegli Da foto oppure consenti l’accesso alla fotocamera nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを利用できません。「写真から」を選ぶか、設定でカメラへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 사용할 수 없습니다. 사진에서를 선택하거나 설정에서 카메라 접근을 허용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera tidak tersedia. Pilih Daripada Foto atau benarkan akses kamera dalam Tetapan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraet er ikke tilgjengelig. Velg Fra bilde, eller tillat kameratilgang i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De camera is niet beschikbaar. Kies Van foto of geef Clink toegang tot de camera in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparat jest niedostępny. Wybierz Ze zdjęcia lub zezwól na dostęp do aparatu w Ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmara não está disponível. Escolhe A partir de uma fotografia ou permite o acesso à câmara nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera nu este disponibilă. Alege Din fotografie sau permite accesul la cameră în Configurări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна. Выберите «Из фото» или разрешите доступ к камере в настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoaparát nie je dostupný. Vyberte Z fotky alebo povoľte prístup k fotoaparátu v Nastaveniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameran är inte tillgänglig. Välj Från foto eller tillåt kameraåtkomst i Inställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera kullanılamıyor. Fotoğraftan seçeneğini kullanın veya Ayarlar’da kamera erişimine izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна. Виберіть «Із фото» або дозвольте доступ до камери в параметрах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể sử dụng camera. Chọn Từ ảnh hoặc cho phép truy cập camera trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机不可用。请选择“从照片”，或在设置中允许访问相机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用相機。請選擇「從照片」，或在設定中允許取用相機。"
          }
        }
      }
    },
    "Clink uses the camera to scan shared theme QR codes and take photos for themes. Images are processed on-device and are not uploaded.": {
      "extractionState": "manual",
      "comment": "Photo theme import: camera capture and local processing.",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink gebruik die kamera om gedeelde temas se QR-kodes te skandeer en foto’s vir temas te neem. Beelde word op die toestel verwerk en nie opgelaai nie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink používá fotoaparát ke skenování QR kódů sdílených motivů a pořizování fotek pro motivy. Obrázky se zpracovávají v zařízení a nikam se neodesílají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink bruger kameraet til at scanne QR-koder for delte temaer og tage fotos til temaer. Billeder behandles på enheden og uploades ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink verwendet die Kamera, um QR-Codes geteilter Themes zu scannen und Fotos für Themes aufzunehmen. Bilder werden auf dem Gerät verarbeitet und nicht hochgeladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Clink χρησιμοποιεί την κάμερα για σάρωση κωδικών QR κοινόχρηστων θεμάτων και λήψη φωτογραφιών για θέματα. Οι εικόνες υποβάλλονται σε επεξεργασία στη συσκευή και δεν μεταφορτώνονται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink usa la cámara para escanear códigos QR de temas compartidos y hacer fotos para temas. Las imágenes se procesan en el dispositivo y no se suben a internet."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kasutab kaamerat jagatud teemade QR-koodide skannimiseks ja teemade jaoks fotode tegemiseks. Pilte töödeldakse seadmes ja neid ei laadita üles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink käyttää kameraa jaettujen teemojen QR-koodien skannaamiseen ja kuvien ottamiseen teemoja varten. Kuvat käsitellään laitteessa eikä niitä lähetetä verkkoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink utilise la caméra pour scanner les codes QR des thèmes partagés et prendre des photos pour les thèmes. Les images sont traitées sur l’appareil et ne sont pas envoyées en ligne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink a kamerával megosztott témák QR-kódjait olvassa be, és fényképeket készít témákhoz. A képeket az eszközön dolgozza fel, és nem tölti fel őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink menggunakan kamera untuk memindai kode QR tema yang dibagikan dan mengambil foto untuk tema. Gambar diproses di perangkat dan tidak diunggah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink usa la fotocamera per scansionare i codici QR dei temi condivisi e scattare foto per i temi. Le immagini vengono elaborate sul dispositivo e non vengono caricate online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkはカメラを使って共有テーマのQRコードを読み取り、テーマ用の写真を撮影します。画像はデバイス内で処理され、アップロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink는 공유된 테마의 QR 코드를 스캔하고 테마용 사진을 촬영할 때 카메라를 사용합니다. 이미지는 기기에서 처리되며 업로드되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink menggunakan kamera untuk mengimbas kod QR tema yang dikongsi dan mengambil foto untuk tema. Imej diproses pada peranti dan tidak dimuat naik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink bruker kameraet til å skanne QR-koder for delte temaer og ta bilder til temaer. Bildene behandles på enheten og lastes ikke opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink gebruikt de camera om QR-codes van gedeelde thema’s te scannen en foto’s voor thema’s te maken. Afbeeldingen worden op je apparaat verwerkt en niet geüpload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink używa aparatu do skanowania kodów QR udostępnionych motywów i robienia zdjęć do motywów. Obrazy są przetwarzane na urządzeniu i nie są wysyłane na serwer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink utiliza a câmara para ler códigos QR de temas partilhados e tirar fotografias para temas. As imagens são processadas no dispositivo e não são enviadas para a internet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink folosește camera pentru a scana coduri QR ale temelor partajate și a face fotografii pentru teme. Imaginile sunt procesate pe dispozitiv și nu sunt încărcate pe un server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink использует камеру для сканирования QR-кодов общих тем и съёмки фотографий для тем. Изображения обрабатываются на устройстве и никуда не отправляются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink používa fotoaparát na skenovanie QR kódov zdieľaných motívov a fotenie pre motívy. Obrázky sa spracúvajú v zariadení a nikam sa neodosielajú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink använder kameran för att skanna QR-koder för delade teman och ta foton till teman. Bilderna behandlas på enheten och laddas inte upp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink, paylaşılan temaların QR kodlarını taramak ve temalar için fotoğraf çekmek amacıyla kamerayı kullanır. Görseller cihazda işlenir ve bir sunucuya yüklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink використовує камеру для сканування QR-кодів поширених тем і знімання фотографій для тем. Зображення обробляються на пристрої й нікуди не надсилаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink dùng camera để quét mã QR của giao diện được chia sẻ và chụp ảnh tạo giao diện. Hình ảnh được xử lý trên thiết bị và không được tải lên mạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 使用相机扫描分享的主题二维码，以及拍摄用于创建主题的照片。图像在设备上处理，不会上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 使用相機掃描分享的主題 QR 碼，以及拍攝用來建立主題的照片。影像在裝置上處理，不會上傳。"
          }
        }
      }
    },
