    "A hue wave rolls across the keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "’n Tintgolf rol oor die sleutels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Farbwelle rollt über die Tasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una onda de color recorre las teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Toonilaine veereb üle klahvide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vague de couleur traverse les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Színhullám fut végig a gombokon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'onda di colore attraversa i tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色の波がキーを流れていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색의 물결이 키 위를 흘러갑니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelombang warna bergerak melintasi kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma onda de cor atravessa as teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Волна цвета прокатывается по клавишам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一道色彩波浪掠过按键。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un val de nuanță se rostogolește peste taste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tintgolf rolt over de toetsen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一道色彩波浪掠過按鍵。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fala odcieni przepływa przez klawisze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хвиля відтінку котиться по клавішах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşların üzerinde bir renk dalgası dolaşıyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po klávesách se valí barevná vlna."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po klávesoch sa valí farebná vlna."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα κύμα απόχρωσης κυλάει στα πλήκτρα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En nyansvåg rullar över tangenterna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En farvetone bølge ruller hen over tasterne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En fargetonebølge ruller over tastene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäinten poikki pyörii sävyaalto."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelombang warna bergulir melintasi tuts."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một làn sóng màu sắc cuộn qua các phím."
          }
        }
      }
    },
    "A keyboard you can make your own. Here's the quick tour.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Sleutelbord wat jy jou eie kan maak. Hier is die vinnige toer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Tastatur, die du zu deiner eigenen machen kannst. Hier der kurze Rundgang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un teclado que puedes hacer tuyo. Aquí tienes el recorrido rápido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuur, mida saad enda omaks teha. Siin on kiire ülevaade."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clavier que tu peux t'approprier. Voici la visite éclair."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy billentyűzet, amit a magadévá tehetsz. Íme a gyors bemutató."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tastiera che puoi rendere tua. Ecco il giro veloce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分好みにできるキーボードです。かんたんに一巡り紹介します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만의 것으로 만들 수 있는 키보드예요. 간단히 둘러볼게요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci yang boleh anda jadikan milik anda. Ini lawatan pantasnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um teclado que podes fazer teu. Aqui vai a visita rápida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура, которую можно сделать своей. Вот короткая экскурсия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个能打造成你自己的键盘。来快速逛一圈。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O tastatură pe care o poți face singur. Iată turul rapid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een toetsenbord dat u zelf kunt maken. Hier is de korte rondleiding."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個能打造成你自己的鍵盤。來快速逛一圈。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawiatura, którą możesz stworzyć własną. Oto krótka wycieczka."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіатура, яку ви можете зробити самостійно. Ось короткий огляд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi klavyenizi oluşturabileceğiniz bir klavye. İşte hızlı tur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesnice, kterou si můžete vyrobit sami. Zde je rychlá prohlídka."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesnica, ktorú si môžete vytvoriť sami. Tu je rýchla prehliadka."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα πληκτρολόγιο που μπορείτε να φτιάξετε μόνοι σας. Εδώ είναι η γρήγορη περιήγηση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett tangentbord du kan göra ditt eget. Här är den snabba rundturen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et tastatur du kan lave dit eget. Her er den hurtige tur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et tastatur du kan lage ditt eget. Her er en rask omvisning."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäimistö, jonka voit tehdä itse. Tässä pikakierros."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan ketik yang dapat Anda buat sendiri. Berikut tur singkatnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một bàn phím bạn có thể tự làm. Đây là chuyến tham quan nhanh."
          }
        }
      }
