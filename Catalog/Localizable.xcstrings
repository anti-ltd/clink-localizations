    "Sure, I'll have it over by then.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seker, ek sal dit dan klaar hê."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar, bis dahin ist es bei dir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claro, para entonces lo tienes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindel, siis see sinuni jõuab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien sûr, tu l'auras d'ici là."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Persze, addigra átküldöm."
          }
        },
        "it": {
          "stringUnit": {
