            "state": "translated",
            "value": "En række af cifre over bogstaverne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En rad med sifre over bokstavene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Numerorivi kirjainten yläpuolella."
          }
        },
        "id": {
