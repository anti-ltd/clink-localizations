          }
        }
      }
    },
    "How much the key spring bounces. Lower bounces more, 1.0 settles cleanly.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoeveel die sleutelveer bons. Laer bons meer, 1.0 sit skoon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark die Tastenfeder nachfedert. Niedriger federt mehr, 1.0 kommt sauber zur Ruhe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto rebota el resorte de la tecla. Más bajo rebota más, 1.0 se asienta sin más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui palju klahvi vedru põrkab. Madalam põrkab rohkem, 1.0 raugab puhtalt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De combien le ressort de la touche rebondit. Plus bas rebondit plus, 1.0 se stabilise net."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyit pattog a billentyű rugója. Az alacsonyabb többet pattog, az 1.0 szépen elül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto rimbalza la molla del tasto. Più basso rimbalza di più, 1.0 si assesta netto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーのばねの跳ね具合です。低いほど強く跳ね、1.0 できれいに収まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스프링이 얼마나 튀는지예요. 낮으면 더 튀고, 1.0이면 깔끔하게 멈춰요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak spring kekunci melantun. Lagi rendah lagi banyak lantun, 1.0 mengendap kemas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto a mola da tecla ressalta. Mais baixo ressalta mais, 1.0 assenta de forma limpa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько пружинит клавиша. Меньше — сильнее отскок, 1,0 — чистая остановка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键弹簧弹跳多少。越低弹得越厉害，1.0 干干净净停稳。"
          }
        }
      }
    },
    "How much the popup bounces as it emerges. Lower bounces more, 1.0 settles cleanly.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoeveel die opspringer weerkaats soos dit na vore kom. Laer bons meer, 1.0 sit skoon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark das Popup beim Erscheinen federt. Niedrigere Werte federn mehr, 1,0 setzt sauber auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto rebota la ventana emergente al aparecer. Los valores más bajos rebotan más; 1,0 se asienta con suavidad."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui palju hüpikaknana kuvatav klahv selle ilmumisel põrkab. Madalam väärtus põrkab rohkem, 1,0 settib puhtalt."
          }
        },
        "fr": {
