        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thanh trượt đệm bên dưới đặt diện tích tổng thể của bàn phím."
          }
        }
      }
    },
    "The page opens the rest of its controls, and stays open.": {
