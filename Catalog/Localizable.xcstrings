    },
    "Define view(state) to return a tree from vstack / hstack / grid / text / button / field. Optionally define initial().": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Definieer aansig (staat) om 'n boom terug te keer vanaf vstack / hstack / rooster / teks / knoppie / veld. Definieer opsioneel initial()."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Definier view(state), das einen Baum aus vstack / hstack / grid / text / button / field zurückgibt. Optional kannst du initial() definieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define view(state) para devolver un árbol de vstack / hstack / grid / text / button / field. Si quieres, define también initial()."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Defineeri view(state), et tagastada puu vstack / hstack / grid / text / button / field põhjal. Valikuliselt defineeri initial()."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définis view(state) pour renvoyer un arbre de vstack / hstack / grid / text / button / field. Tu peux aussi définir initial()."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írj egy view(state) függvényt, ami fát ad vissza ezekből: vstack / hstack / grid / text / button / field. A initial() megadása nem kötelező."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Definisci view(state) per restituire un albero di vstack / hstack / grid / text / button / field. Se vuoi, definisci anche initial()."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "view(state) を定義して、vstack / hstack / grid / text / button / field のツリーを返します。initial() は必要なら定義してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "view(state)를 정의해서 vstack / hstack / grid / text / button / field로 된 트리를 반환하세요. initial()은 원하면 정의해도 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Takrifkan view(state) untuk pulangkan pokok daripada vstack / hstack / grid / text / button / field. Boleh juga takrifkan initial()."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Define view(state) para devolver uma árvore de vstack / hstack / grid / text / button / field. Se quiseres, define também initial()."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определите view(state), чтобы вернуть дерево из vstack / hstack / grid / text / button / field. При желании определите initial()."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定义 view(state)，返回一棵由 vstack / hstack / grid / text / button / field 组成的树。也可以顺便定义 initial()。"
          }
        }
      }
    },
