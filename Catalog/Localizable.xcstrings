          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordítási nyelvek sorrendje"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳言語の順序"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译语言顺序"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역 언어 순서"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlkekeelte järjestus"
          }
        }
      }
    },
    "Translation runs entirely on this device, so nothing is uploaded either way. Pick the engine above. Language packs may download on first use.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vertaling loop geheel en al op hierdie toestel, so niks word in elk geval opgelaai nie. Kies die enjin hierbo. Taalpakke kan afgelaai word met die eerste gebruik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Übersetzen läuft komplett auf diesem Gerät, es wird also so oder so nichts hochgeladen. Wähl oben die Engine. Sprachpakete werden vielleicht bei der ersten Nutzung geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción se hace del todo en este dispositivo, así que en ningún caso se sube nada. Elige el motor de arriba. Los paquetes de idioma pueden descargarse la primera vez que los uses."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlge toimub täielikult selles seadmes, seega ei laadita midagi üles kummalgi juhul. Vali ülal mootor. Keelepaketid võivad esmakordsel kasutamisel alla laadida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction tourne entièrement sur cet appareil, donc rien n'est envoyé dans un sens ou dans l'autre. Choisis le moteur ci-dessus. Les modules linguistiques peuvent se télécharger à la première utilisation."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fordítás teljesen ezen az eszközön fut, így sehogy sem tölt fel semmit. Válaszd ki a motort fent. A nyelvi csomagok az első használatkor letöltődhetnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione gira tutta su questo dispositivo, quindi in nessun caso viene caricato niente. Scegli il motore qui sopra. I pacchetti lingua potrebbero scaricarsi al primo uso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳はすべてこのデバイスの中で行うので、どちらの場合も何もアップロードされません。上でエンジンを選んでください。言語パックは初回に使うときダウンロードされることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역은 전부 이 기기에서 돌아가서, 어느 쪽이든 아무것도 올라가지 않아요. 위에서 엔진을 골라주세요. 언어 팩은 처음 쓸 때 다운로드될 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan berjalan sepenuhnya pada peranti ini, jadi tiada apa dimuat naik walau apa pun. Pilih enjin di atas. Pek bahasa mungkin dimuat turun pada kali pertama guna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução corre toda neste dispositivo, por isso nada é enviado em nenhum dos casos. Escolhe o motor acima. Os pacotes de idioma podem ser transferidos na primeira utilização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод целиком идёт на этом устройстве, так что ничего не загружается в любом случае. Движок выбирается выше. При первом использовании языковые пакеты могут загрузиться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译完全在这台设备上进行，所以哪种方式都不会上传任何内容。在上面选引擎。语言包可能会在第一次用时下载。"
          }
        }
      }
    },
