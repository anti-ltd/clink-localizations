        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink można używać bezpłatnie w tej aplikacji. Wybierz plan, aby ustawić klawiaturę także w każdej innej aplikacji."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink можна безкоштовно використовувати в цій програмі. Виберіть план, щоб зробити його вашою клавіатурою в усіх інших програмах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink'in bu uygulamada kullanımı ücretsizdir. Bunu diğer tüm uygulamalarda da klavyeniz haline getirmek için bir plan seçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink je v této aplikaci zdarma k použití. Vyberte si plán, jak z něj udělat klávesnici v každé jiné aplikaci."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink je v tejto aplikácii zadarmo. Vyberte si plán, podľa ktorého bude klávesnica aj v každej inej aplikácii."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Clink είναι δωρεάν για χρήση μέσα σε αυτήν την εφαρμογή. Επιλέξτε ένα σχέδιο για να το κάνετε το πληκτρολόγιό σας και σε κάθε άλλη εφαρμογή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink är gratis att använda i denna app. Välj en plan för att göra det till ditt tangentbord i alla andra appar också."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink er gratis at bruge i denne app. Vælg en plan for at gøre det til dit tastatur i alle andre apper."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink is free to use inside this app. Velg en plan for å gjøre det til ditt tastatur i alle andre apper også."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink on ilmainen käyttää tämän sovelluksen sisällä. Valitse suunnitelma tehdäksesi siitä näppäimistösi myös kaikissa muissa sovelluksissa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink gratis untuk digunakan di dalam aplikasi ini. Pilih rencana untuk menjadikannya keyboard Anda di setiap aplikasi lainnya juga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink được sử dụng miễn phí trong ứng dụng này. Chọn một kế hoạch để biến nó thành bàn phím của bạn trong mọi ứng dụng khác."
          }
        }
      }
    },
    "Clink is fully offline. Nothing you type is uploaded, and you don't need an account.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink is heeltemal vanlyn. Niks wat jy tik word opgelaai nie, en jy het nie 'n rekening nodig nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink läuft komplett offline. Nichts, was du tippst, wird hochgeladen, und du brauchst kein Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink funciona sin conexión. Nada de lo que escribes se sube, y no hace falta cuenta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink töötab täielikult ühenduseta. Midagi, mida tipid, ei laadita üles ja sul pole vaja kontot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink marche entièrement hors ligne. Rien de ce que tu tapes n'est envoyé, et tu n'as pas besoin de compte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink teljesen offline. Amit beírsz, azt semmi nem tölti fel, és fiók sem kell hozzá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink funziona tutto offline. Niente di quello che scrivi viene caricato, e non ti serve un account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink は完全オフラインです。入力した文字はどこにもアップロードされませんし、アカウントもいりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink는 완전히 오프라인으로 동작해요. 입력한 건 어디에도 올라가지 않고, 계정도 필요 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink berfungsi sepenuhnya luar talian. Apa yang anda taip tidak dimuat naik, dan anda tak perlukan akaun."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink funciona todo offline. Nada do que escreves é enviado e não precisas de conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink работает полностью офлайн. Ничего из напечатанного не загружается, и аккаунт не нужен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 完全离线。你打的字不会上传，也不用注册账户。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink este complet offline. Nimic din ceea ce tastați nu este încărcat și nu aveți nevoie de un cont."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink is volledig offline. Niets wat u typt, wordt geüpload en u heeft geen account nodig."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 完全離線。你打的字不會上傳，也不用註冊賬戶。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink jest całkowicie offline. Nic, co wpiszesz, nie zostanie przesłane i nie potrzebujesz konta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink повністю офлайн. Ніщо, що ви вводите, не завантажується, і вам не потрібен обліковий запис."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink tamamen çevrimdışı. Yazdığınız hiçbir şey yüklenmez ve bir hesaba ihtiyacınız yoktur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink je plně offline. Nic, co zadáte, se nenahrává a nepotřebujete účet."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink je plne offline. Nič, čo zadáte, sa neodovzdáva a nepotrebujete účet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Clink είναι πλήρως εκτός σύνδεσης. Τίποτα που πληκτρολογείτε δεν μεταφορτώνεται και δεν χρειάζεστε λογαριασμό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink är helt offline. Inget du skriver laddas upp och du behöver inget konto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink er helt offline. Intet du skriver bliver uploadet, og du behøver ikke en konto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink er helt offline. Ingenting du skriver blir lastet opp, og du trenger ikke en konto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink on täysin offline-tilassa. Mitään kirjoittamaasi ei ladata, etkä tarvitse tiliä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink sepenuhnya offline. Tidak ada yang Anda ketik yang diunggah, dan Anda tidak memerlukan akun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink hoàn toàn ngoại tuyến. Không có gì bạn nhập được tải lên và bạn không cần có tài khoản."
          }
        }
      }
    },
    "Clink is in your keyboard list. Tap 🌐 in any app to switch to it.": {
