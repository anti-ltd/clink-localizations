    "An @ key right of the space bar": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n @-sleutel regs van die spasiebalk"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine @-Taste rechts von der Leertaste"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tecla @ a la derecha de la barra espaciadora"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "@-klahv tühikuklahvi paremal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une touche @ à droite de la barre d'espace"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy @ billentyű a szóköztől jobbra"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tasto @ a destra della barra spaziatrice"
          }
        },
        "ja": {
