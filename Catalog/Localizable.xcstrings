    "Mini tools grid. Tap a tile to open that tool.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini cuadrícula de herramientas. Toca una baldosa para abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini grille d’outils. Touchez une tuile pour l’ouvrir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini-Werkzeugraster. Tippe eine Kachel, um das Tool zu öffnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini griglia strumenti. Tocca una piastrella per aprirlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini grelha de ferramentas. Toca num mosaico para abrir."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Grid alat mini. Ketik jubin untuk buka alat itu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini eszközrács. Koppints egy csempére a megnyitáshoz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミニツールグリッド。タイルをタップしてツールを開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "迷你工具网格。点瓷砖即可打开该工具。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미니 도구 격자. 타일을 탭하면 그 도구가 열립니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini-tööriistade ruudustik. Puuduta plaati, et avada see tööriist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мини-сетка инструментов. Коснитесь плитки, чтобы открыть инструмент."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mini gereedskap rooster. Tik 'n teël om daardie instrument oop te maak."
          }
        }
      }
    },
    "Tap a coloured tile to open that tool.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una baldosa de color para abrir esa herramienta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une tuile colorée pour ouvrir cet outil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe eine farbige Kachel, um dieses Tool zu öffnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una piastrella colorata per aprire quello strumento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca um mosaico colorido para abrir essa ferramenta."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik jubin berwarna untuk buka alat itu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy színes csempére az eszköz megnyitásához."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色付きタイルをタップしてそのツールを開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点彩色瓷砖即可打开该工具。"
