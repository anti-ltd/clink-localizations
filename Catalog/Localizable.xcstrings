    "Thanks. The team has the report, with this build and iPhone model attached.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias. El equipo ya tiene el informe, junto con esta versión y el modelo de iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci. L’équipe a reçu le rapport, avec cette version et le modèle d’iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke. Das Team hat den Bericht, zusammen mit diesem Build und dem iPhone-Modell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie. Il team ha ricevuto il rapporto, insieme a questa build e al modello di iPhone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado. A equipa já tem o relatório, com esta versão e o modelo de iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо. Команда получила отчёт вместе с номером сборки и моделью iPhone."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih. Pasukan telah menerima laporan ini bersama binaan ini dan model iPhone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Köszönjük. A csapat megkapta a jelentést, ezzel a buildszámmal és az iPhone típusával együtt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます。レポートはこのビルドと iPhone の機種情報とともにチームに届きました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谢谢。团队已收到报告，并附有此版本号和 iPhone 型号。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감사합니다. 이 빌드 정보와 iPhone 모델과 함께 보고서가 팀에 전달되었습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aitäh. Meeskond sai raporti koos selle järgu ja iPhone’i mudeliga."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Multumesc. Echipa are raportul, cu această versiune și modelul de iPhone atașate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt. Het team heeft het rapport, met dit build- en iPhone-model als bijlage."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "謝謝。團隊已收到報告，並附有此版本號和 iPhone 型號。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dankie. Die span het die verslag ontvang, tesame met hierdie bouweergawe en iPhone-model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzięki. Zespół ma raport z załączoną wersją i modelem iPhone'a."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "дякую Команда має звіт, до якого додається ця збірка та модель iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teşekkürler. Ekip, bu yapıyı ve iPhone modelini içeren bir rapora sahip."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "děkuji. Tým má zprávu s připojenou touto sestavou a modelem iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "dakujem. Tím má správu s priloženou zostavou a modelom iPhone."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ευχαριστώ. Η ομάδα έχει την αναφορά, με συνημμένα αυτήν την κατασκευή και το μοντέλο iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack. Teamet har rapporten, med denna konstruktion och iPhone-modell bifogad."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak. Holdet har rapporten med denne build og iPhone-model vedhæftet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk. Teamet har rapporten, med denne versjonen og iPhone-modellen vedlagt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiitos. Tiimillä on raportti, johon on liitetty tämä rakenne ja iPhone-malli."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih. Tim memiliki laporannya, dengan build dan model iPhone ini terpasang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn. Nhóm có báo cáo, có đính kèm bản dựng này và mẫu iPhone."
          }
        }
      }
    },
