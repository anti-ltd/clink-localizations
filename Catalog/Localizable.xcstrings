    "Type several languages at once. A word is only corrected when it's wrong in all of them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in mehreren Sprachen gleichzeitig. Ein Wort wird nur korrigiert, wenn es in allen falsch ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe en varios idiomas a la vez: una palabra solo se corrige si está mal en todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris en plusieurs langues à la fois. Un mot n'est corrigé que s'il est faux dans toutes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írj több nyelven egyszerre. Egy szót csak akkor javít, ha mindegyikben hibás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi in più lingue contemporaneamente. Una parola viene corretta solo se è sbagliata in tutte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の言語を同時に入力できます。どの言語でも間違っている時だけ修正されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 언어를 한꺼번에 입력하세요. 모든 언어에서 틀린 단어만 고쳐요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip beberapa bahasa serentak. Perkataan hanya dibetulkan jika salah dalam semuanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve em vários idiomas ao mesmo tempo. Uma palavra só é corrigida quando está errada em todos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Печатайте на нескольких языках сразу. Слово исправляется, только если оно неверно во всех."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时输入多种语言，只有在所有语言里都拼错的词才会被纠正。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipi mitut keelt korraga. Sõna parandatakse ainult siis, kui see on kõigis vale."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik verskeie tale gelyktydig. 'n Woord word net reggestel wanneer dit in almal verkeerd is."
          }
        }
      }
    },
