    "Allow the microphone to dictate. Clink listens only while this panel is open.": {
      "comment": "Android-only dictation copy (the IME asks for the microphone itself). Translations drafted for the Android port; native-speaker review required before release. Add to clink-index.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat die mikrofoon toe om te dikteer. Clink luister net terwyl hierdie paneel oop is."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte mikrofon pro diktování. Clink poslouchá jen tehdy, když je tento panel otevřený."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad mikrofonen for at diktere. Clink lytter kun, mens dette panel er åbent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf das Mikrofon, um zu diktieren. Clink hört nur zu, solange dieses Feld geöffnet ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε το μικρόφωνο για υπαγόρευση. Το Clink ακούει μόνο όσο είναι ανοιχτός αυτός ο πίνακας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el micrófono para dictar. Clink solo escucha mientras este panel está abierto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteerimiseks luba mikrofon. Clink kuulab ainult siis, kui see paneel on avatud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli mikrofoni sanelua varten. Clink kuuntelee vain, kun tämä paneeli on auki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise l’accès au micro pour dicter. Clink n’écoute que lorsque ce panneau est ouvert."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktáláshoz engedélyezd a mikrofont. A Clink csak akkor figyel, amikor ez a panel nyitva van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan mikrofon untuk mendikte. Clink hanya mendengarkan saat panel ini terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso al microfono per dettare. Clink ascolta solo mentre questo pannello è aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力するにはマイクを許可してください。Clink が音声を聞くのは、このパネルが開いている間だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기를 하려면 마이크를 허용하세요. Clink는 이 패널이 열려 있는 동안에만 듣습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan mikrofon untuk merencana. Clink hanya mendengar semasa panel ini dibuka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat mikrofonen for å diktere. Clink lytter bare mens dette panelet er åpent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta de microfoon toe om te dicteren. Clink luistert alleen terwijl dit paneel open is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na mikrofon, aby dyktować. Clink słucha tylko wtedy, gdy ten panel jest otwarty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite o microfone para ditar. O Clink só ouve enquanto este painel está aberto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite microfonul pentru a dicta. Clink ascultă doar cât timp acest panou este deschis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к микрофону, чтобы диктовать. Clink слушает, только пока эта панель открыта."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte mikrofón na diktovanie. Clink počúva, len keď je tento panel otvorený."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt mikrofonen för att diktera. Clink lyssnar bara medan den här panelen är öppen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte etmek için mikrofona izin verin. Clink yalnızca bu panel açıkken dinler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте мікрофон для диктування. Clink слухає лише тоді, коли ця панель відкрита."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép micrô để đọc chính tả. Clink chỉ nghe khi bảng này đang mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许使用麦克风以进行听写。Clink 只会在此面板打开时收听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許使用麥克風以聽寫。Clink 只會在此面板開啟時聆聽。"
          }
        }
      }
    },
    "Allow mic & speech access in Settings": {
