            "value": "按键的尺寸、形状和点击区域"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvi suurus, kuju ja tabamissiidid"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleutelgrootte, vorm en tikteikens"
          }
        }
      }
    },
    "Key sounds": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastentöne"
          }
        },
        "es": {
