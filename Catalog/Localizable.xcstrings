    "Add a second keyboard language in Localization for the switcher to have anything to switch between.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge unter Sprache eine zweite Tastatursprache hinzu, damit der Umschalter überhaupt etwas zum Wechseln hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un segundo idioma de teclado en Idioma para que el interruptor tenga entre qué cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une deuxième langue de clavier dans Langue pour que le bouton de bascule ait de quoi basculer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá egy második billentyűzetnyelvet a Nyelv beállításnál, hogy a váltógombnak legyen mi között váltania."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una seconda lingua della tastiera in Lingua, così il selettore ha tra cosa passare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語設定でもう一つキーボード言語を追加してください。切り替えボタンには切り替え先が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 설정에서 키보드 언어를 하나 더 추가하세요. 전환 버튼이 작동하려면 바꿀 대상이 있어야 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah bahasa papan kekunci kedua dalam Bahasa supaya suis ada sesuatu untuk ditukar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um segundo idioma de teclado em Idioma para o alternador ter entre que trocar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте второй язык клавиатуры в «Локализации», чтобы переключателю было между чем переключаться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在语言设置里再加一种键盘语言，切换按钮才有得切换。"
