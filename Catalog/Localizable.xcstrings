        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AI είναι ενεργοποιημένο, αλλά οι προτάσεις εκτός σύνδεσης %@ συνεχίζονται κανονικά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AI är på, men %@ Offline-förslag fortsätter som vanligt."
