          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lățimea liniei traseului desenată sub deget în timp ce glisați."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breedte van de spoorlijn die tijdens het swipen onder uw vinger wordt getekend."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑動時手指下方那條軌跡線的寬度。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szerokość linii szlaku narysowanej pod palcem podczas przesuwania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ширина лінії сліду, проведеної під вашим пальцем під час проведення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırırken parmağınızın altında çizilen iz çizgisinin genişliği."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šířka čáry stopy nakreslené pod vaším prstem při přejíždění."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Šírka čiary stopy nakreslenej pod prstom pri posúvaní."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πλάτος της γραμμής διαδρομής που τραβιέται κάτω από το δάχτυλό σας κατά το σάρωση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
