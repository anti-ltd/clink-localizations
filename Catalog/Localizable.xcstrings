    "Quick accents, in Gestures, sets how long the hold takes and how far the swipe has to travel.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinnige aksent, in Gebare, stel hoe lank die hou neem en hoe ver die swiep moet beweeg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Schnelle Akzente“ in den Gesten legt fest, wie lange das Halten dauert und wie weit der Wisch gehen muss."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acentos rápidos, en Gestos, ajusta cuánto dura la pulsación y cuánto hay que deslizar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiired aksendid, jaotises Žestid, sätestab, kui kaua kestab hoidmine ja kui kaugele peab pühkima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accents rapides, dans Gestes, règle la durée de l'appui et la distance du balayage."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gesztusok között a Gyors ékezetek állítja be, meddig kell nyomva tartani és mennyit húzni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accenti rapidi, in Gesti, imposta quanto dura la pressione e quanto deve essere lungo lo scorrimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ジェスチャ」の「クイックアクセント」で、長押しの時間とスワイプの距離を調整できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제스처의 빠른 악센트에서 길게 누르는 시간과 쓸어내리는 거리를 정할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksen pantas, dalam Gerak isyarat, menetapkan tempoh tahanan dan jarak leretan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acentos rápidos, em Gestos, define quanto dura o toque e quanto tens de deslizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Быстрые акценты» в «Жестах» задают длительность удержания и то, как далеко нужно провести пальцем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“手势”里的“快速重音”能设定长按多久、下滑多远才触发。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accente rapide, în Gesturi, stabilesc cât de mult durează menținerea și cât de departe trebuie să parcurgă glisarea."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snelle accenten in Gebaren bepalen hoe lang het vasthouden duurt en hoe ver de veegbeweging moet reizen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“手勢”裡的“快速重音”能設定長按多久、下滑多遠才觸發。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybkie akcenty w Gesty określają czas trwania przytrzymania i odległość, jaką musi pokonać przesunięcie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Швидкі акценти в Жестах встановлюють тривалість утримання та відстань, яку потрібно провести."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketler'deki hızlı vurgular, tutmanın ne kadar süreceğini ve kaydırmanın ne kadar uzağa gitmesi gerektiğini ayarlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychlé akcenty v Gesta nastavují, jak dlouho trvá přidržení a jak daleko musí přejet prstem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rýchle akcenty v časti Gestá nastavujú, ako dlho trvá podržanie a ako ďaleko musí prejsť potiahnutie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι γρήγοροι τόνοι, στις χειρονομίες, ορίζουν πόσο χρόνο διαρκεί το κράτημα και πόσο μακριά πρέπει να διανύσει το σάρωση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snabba accenter, i gester, ställer in hur lång tid hållningen tar och hur långt svepet måste färdas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtige accenter, i Gestures, angiver, hvor lang tid holdet tager, og hvor langt stryget skal rejse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Raske aksenter, i bevegelser, angir hvor lang tid holdingen tar og hvor langt sveipet må reise."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nopeat korostukset eleissä määrittävät, kuinka kauan pito kestää ja kuinka pitkälle pyyhkäisyn on kuljettava."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksen cepat, di Gestur, mengatur berapa lama waktu yang dibutuhkan untuk menahan dan seberapa jauh gesekan harus dilakukan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dấu nhanh, trong Cử chỉ, đặt thời gian giữ và khoảng cách vuốt phải di chuyển."
          }
        }
      }
    },
