    "Switch Clink on, tap it again, and allow Full Access.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel Clink aan, tik dit weer en laat volle toegang toe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Clink ein, tippe es noch einmal an und erlaube den Vollzugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Clink, vuelve a tocarlo y concédele acceso completo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita Clink sisse, puuduta seda uuesti ja luba täisjuurdepääs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active Clink, touche-le à nouveau et autorise l'accès complet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a Clinket, koppints rá újra, és engedélyezd a teljes hozzáférést."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Clink, toccalo di nuovo e consenti l'accesso completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkをオンにし、もう一度タップしてフルアクセスを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink을 켜고 다시 눌러 전체 접근을 허용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Clink, ketik sekali lagi, dan benarkan akses penuh."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga o Clink, toca nele outra vez e permite o acesso total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Clink, нажмите на него ещё раз и разрешите полный доступ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Clink，再点一次它，允许完全访问。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează Clink, atinge-l din nou și permite accesul complet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Clink in, tik er nogmaals op en sta volledige toegang toe."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Clink，再點一次它，允許完整取用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Clink, dotknij go ponownie i zezwól na pełny dostęp."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Clink, торкніться його ще раз і дозвольте повний доступ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink'i açın, tekrar dokunun ve Tam Erişime izin verin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte Clink, znovu na něj klepněte a povolte úplný přístup."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite Clink, znova naň klepnite a povoľte úplný prístup."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε το Clink, πατήστε το ξανά και επιτρέψτε την πλήρη πρόσβαση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Clink, tryck på den igen och tillåt full åtkomst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tænd for Clink, tryk på den igen, og tillad fuld adgang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Clink, trykk på den igjen og gi full tilgang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kytke Clink päälle, napauta sitä uudelleen ja salli täysi käyttö."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan Clink, ketuk lagi, dan izinkan Akses Penuh."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Clink, chạm lại vào nó và cho phép Truy cập đầy đủ."
          }
        }
      }
    },
