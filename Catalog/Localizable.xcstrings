            "state": "translated",
            "value": "Erlaube Clink in den Einstellungen Zugriff auf Mikrofon & Spracherkennung, um zu diktieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso al micrófono y al reconocimiento de voz para Clink en Ajustes para poder dictar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Luba seadetes Clinkile mikrofoni ja kõne juurdepääs, et dikteerida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise l'accès au micro et à la reconnaissance vocale pour Clink dans Réglages pour dicter."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktáláshoz engedélyezd a Clinknek a mikrofon- és beszédfelismerés-hozzáférést a Beállításokban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Clink l'accesso a microfono e riconoscimento vocale in Impostazioni per dettare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力するには、設定でClinkにマイクと音声認識のアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기를 하려면 설정에서 Clink에 마이크 및 음성 인식 접근을 허용해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan akses mikrofon & pertuturan untuk Clink dalam Seting untuk mengimlak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite o acesso ao microfone e à fala para o Clink em Definições para ditar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Clink доступ к микрофону и распознаванию речи в Настройках, чтобы диктовать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许 Clink 访问麦克风与语音识别，才能听写。"
          }
        }
      }
    },
    "Allow notifications in Settings to receive language-pack update alerts.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
