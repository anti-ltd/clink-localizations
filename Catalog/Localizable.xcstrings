    "Shift lights up when it's on, Return in Go and Send fields.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umschalt leuchtet, wenn es aktiv ist, die Eingabetaste in Los- und Senden-Feldern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayúsculas se enciende cuando está activa, y Retorno en los campos Ir y Enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Majuscules s’allume quand elle est active, et Retour dans les champs Aller et Envoyer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Shift akkor világít, ha be van kapcsolva, az Enter pedig az Ugrás és Küldés mezőkben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Maiuscole si accende quando è attivo, Invio nei campi Vai e Invia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift はオンのときに、リターンは「開く」や「送信」になる入力欄で光ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift는 켜졌을 때, Return은 ‘이동’이나 ‘보내기’ 입력란에서 켜져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift menyala apabila dihidupkan, Return pula dalam medan Pergi dan Hantar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Maiúsculas acende quando está ativo, e Return nos campos Ir e Enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift подсвечивается, когда включён, а Return — в полях «Вперёд» и «Отправить»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 开启时会亮起，Return 则在“前往”和“发送”输入框里亮。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõstuklahv süttib, kui on sees, sisestusklahv Mine ja Saada väljades."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Shift lig op wanneer dit aan is, Return in Go en Send velde."
          }
        }
      }
