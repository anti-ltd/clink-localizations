            "state": "translated",
            "value": "Uprzejmy i profesjonalny, do pracy i nieznajomych."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ввічливі та професійні, для роботи та незнайомих людей."
