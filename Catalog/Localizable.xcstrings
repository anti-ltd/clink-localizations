            "state": "translated",
            "value": "A választ a telefonod állítja össze ebből a GYIK-ból."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risposta sul tuo telefono, a partire da queste FAQ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末で、このFAQをもとにお答えします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폰에서 이 FAQ를 바탕으로 답해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijawab pada telefon anda, daripada FAQ ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Respondido no teu telemóvel, a partir destas FAQ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ формируется на вашем телефоне по этому FAQ."
          }
        },
