    "Inline composes on the suggestion bar while the keys stay up. Type to translate, then the result drops in.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inlyn skryf op die voorstelbalk terwyl die sleutels op bly. Tik om te vertaal, dan val die resultaat in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline schreibt in der Vorschlagsleiste, die Tasten bleiben oben. Tipp los zum Übersetzen, dann landet das Ergebnis im Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redacta en línea, en la barra de sugerencias, con las teclas a la vista. Escribe para traducir y el resultado se inserta solo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Reasisene koostab soovituseribal, kui klahvid jäävad üles. Hakka tipitama, et tõlkida, siis tulemus langeb teksti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode intégré compose dans la barre de suggestions pendant que les touches restent affichées. Tape pour traduire, puis le résultat s'insère."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A javaslatsávon írhatsz, miközben a billentyűk fent maradnak. Írd be, mit fordítson, és megjelenik az eredmény."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità in linea scrive sulla barra dei suggerimenti mentre i tasti restano su. Digita per tradurre, poi il risultato scende nel campo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを出したまま、候補バーで文章を作ります。入力して翻訳すると、結果がそのまま入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 그대로 둔 채 추천 바에서 바로 작성해요. 입력해서 번역하면 결과가 들어가요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Karang terus pada bar cadangan sementara kekunci kekal naik. Taip untuk terjemah, kemudian hasilnya masuk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo em linha escreve na barra de sugestões enquanto as teclas ficam à mostra. Escreve para traduzir e o resultado entra logo a seguir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«В строке» собирает текст прямо в строке подсказок, не убирая клавиши. Печатаете для перевода — результат подставляется на место."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在建议栏里就地打字，按键不收起。输入就能翻译，结果直接填进去。"
          }
        }
      }
    },
