    "Full Access is optional. Clink works offline and your keystrokes never leave your phone.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso total es opcional. Clink funciona sin conexión y tus pulsaciones nunca salen de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès complet est facultatif. Clink fonctionne hors ligne et tes frappes ne quittent jamais ton iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollzugriff ist optional. Clink funktioniert offline und deine Tastenanschläge verlassen nie dein iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso completo è facoltativo. Clink funziona offline e ciò che digiti non lascia mai il tuo iPhone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso total é opcional. O Clink funciona offline e o que escreves nunca sai do teu iPhone."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses Penuh tidak wajib. Clink berfungsi di luar talian dan ketukan kekunci tidak pernah keluar daripada iPhone anda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Teljes hozzáférés nem kötelező. A Clink offline működik, és a leütéseid sosem hagyják el az iPhone-odat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルアクセスは任意です。Clinkはオフラインで動作し、キー入力がiPhoneの外に出ることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全访问是可选的。Clink 可离线运行，你的按键内容绝不会离开 iPhone。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 접근 허용은 선택 사항이에요. Clink는 오프라인으로 작동하며 키 입력은 iPhone 밖으로 나가지 않아요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Täisjuurdepääs on valikuline. Clink töötab ühenduseta ja sinu klahvivajutused ei lahku kunagi telefonist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный доступ необязателен. Clink работает офлайн, и ваши нажатия никогда не покидают телефон."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volledige toegang is opsioneel. Clink werk vanlyn en jou toetsaanslagen verlaat nooit jou foon nie."
          }
        }
      }
    },
