            "value": "Maintenez un sticker, puis faites-le glisser sur le clavier pour le placer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarts lenyomva egy matricát, majd húzd a billentyűzetre az elhelyezéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto uno sticker, poi trascinalo sulla tastiera per posizionarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステッカーを長押しして、キーボードへドラッグすると配置できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스티커를 길게 누른 뒤 키보드로 끌어 놓으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan pelekat, kemudian seret ke papan kekunci untuk meletakkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém um autocolante premido e arrasta-o para o teclado para o colocar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте стикер и перетащите его на клавиатуру, чтобы разместить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住贴纸，然后拖到键盘上放置。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți un autocolant, apoi trageți-l pe tastatură pentru a-l plasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een sticker vast en sleep deze naar het toetsenbord om deze te plaatsen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住貼紙，然後拖到鍵盤上放置。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou 'n plakker in en sleep dit dan na die sleutelbord om dit te plaas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj naklejkę, a następnie przeciągnij ją na klawiaturę, aby ją umieścić."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте наклейку, а потім перетягніть її на клавіатуру, щоб розмістити."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir çıkartmayı tutun ve yerleştirmek için klavyeye sürükleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte nálepku a přetáhněte ji na klávesnici, abyste ji umístili."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte nálepku a potom ju potiahnite na klávesnicu, aby ste ju umiestnili."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε ένα αυτοκόλλητο και μετά σύρετέ το στο πληκτρολόγιο για να το τοποθετήσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll ett klistermärke och dra det sedan till tangentbordet för att placera det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold et klistermærke, og træk det derefter over på tastaturet for at placere det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold et klistremerke, og dra det deretter til tastaturet for å plassere det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä tarraa kiinni ja aseta se vetämällä se näppäimistölle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegang stiker, lalu seret ke keyboard untuk meletakkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ nhãn dán rồi kéo nhãn dán đó lên bàn phím để đặt."
          }
        }
      }
    },
