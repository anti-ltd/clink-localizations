          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld u aan bij iCloud om op al uw apparaten te synchroniseren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入 iCloud 以在裝置間同步。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się do iCloud, aby zsynchronizować swoje urządzenia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть у iCloud, щоб синхронізувати свої пристрої."
          }
        },
        "tr": {
