    "Every fine-tune control is shown inside each page, plus the Lab.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke fynverstellingskontrole word binne elke bladsy gewys, plus die Lab."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Regler zur Feinabstimmung sind auf jeder Seite zu sehen, dazu das Labor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los controles de ajuste fino aparecen dentro de cada página, además del Laboratorio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
