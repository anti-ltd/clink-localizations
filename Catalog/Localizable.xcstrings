            "state": "translated",
            "value": "スペースバーの右に @ キー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 바 오른쪽에 @ 키"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci @ di sebelah kanan bar ruang"
          }
        },
        "pt": {
