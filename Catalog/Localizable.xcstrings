            "value": "键盘为什么重启了"
          }
        }
      }
    },
    "Width": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Breedte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancho"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Laius"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szélesség"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Larghezza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너비"
          }
        },
        "ms": {
          "stringUnit": {
