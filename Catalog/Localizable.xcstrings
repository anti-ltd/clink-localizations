    "Switch Clink on, tap it again, and allow Full Access.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel Clink aan, tik dit weer en laat volle toegang toe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Clink ein, tippe es noch einmal an und erlaube den Vollzugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Clink, vuelve a tocarlo y concédele acceso completo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita Clink sisse, puuduta seda uuesti ja luba täisjuurdepääs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active Clink, touche-le à nouveau et autorise l'accès complet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a Clinket, koppints rá újra, és engedélyezd a teljes hozzáférést."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Clink, toccalo di nuovo e consenti l'accesso completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkをオンにし、もう一度タップしてフルアクセスを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink을 켜고 다시 눌러 전체 접근을 허용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Clink, ketik sekali lagi, dan benarkan akses penuh."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga o Clink, toca nele outra vez e permite o acesso total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Clink, нажмите на него ещё раз и разрешите полный доступ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Clink，再点一次它，允许完全访问。"
          }
        }
      }
    },
