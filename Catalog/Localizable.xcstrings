    "Key height and key width resize the keys themselves.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenhöhe und Tastenbreite ändern die Tasten selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El alto y el ancho de tecla cambian las teclas en sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La hauteur et la largeur de touche redimensionnent les touches elles-mêmes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűmagasság és -szélesség magukat a billentyűket méretezi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altezza e larghezza dei tasti ridimensionano i tasti stessi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キーの高さ」と「キーの幅」はキーそのものの大きさを変えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 높이와 키 너비는 키 자체의 크기를 바꿉니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinggi dan lebar kekunci mengubah saiz kekunci itu sendiri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A altura e a largura de tecla redimensionam as próprias teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Высота клавиши» и «Ширина клавиши» меняют размер самих клавиш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“按键高度”和“按键宽度”改的是按键本身。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvi kõrgus ja klahvi laius muudavad klahve eneseid."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleutelhoogte en sleutelwydte verander die grootte van die sleutels self."
          }
        }
      }
    },
