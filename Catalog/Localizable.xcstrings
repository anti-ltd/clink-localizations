    "Half a key tall, 14pt digits. Takes the least room from the letters.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Halwe sleutel hoog, 14pt syfers. Neem die minste ruimte van die letters."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halb so hoch wie eine Taste, Ziffern in 14 pt. Nimmt den Buchstaben am wenigsten Platz weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mitad de alto que una tecla, dígitos de 14 pt. Es la que menos espacio quita a las letras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pool klahvi kõrge, 14 pt numbrid. Võtab tähtedelt kõige vähem ruumi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moitié moins haute qu'une touche, chiffres en 14 pt. C'est celle qui prend le moins de place aux lettres."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fél billentyű magas, 14 pt-os számjegyek. Ez veszi el a legkevesebb helyet a betűktől."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alta metà di un tasto, cifre da 14 pt. È quella che toglie meno spazio alle lettere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの半分の高さ、数字は14pt。文字のスペースをいちばん減らしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 높이의 절반, 숫자는 14pt입니다. 글자 영역을 가장 적게 차지합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setinggi separuh kekunci, digit 14 pt. Paling sedikit mengambil ruang huruf."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Metade da altura de uma tecla, dígitos de 14 pt. É a que rouba menos espaço às letras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В половину высоты клавиши, цифры 14pt. Отнимает у букв меньше всего места."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高度为按键的一半，数字 14pt。占用字母的空间最少。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înălțime de jumătate de cheie, cifre de 14 puncte. Ocupă cel mai puțin spațiu din litere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een halve sleutel hoog, 14pt cijfers. Neemt de minste ruimte uit de letters."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高度為按鍵的一半，數字 14pt。佔用字母的空間最少。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysokość połowy klawisza, cyfry 14 pkt. Zajmuje najmniej miejsca z liter."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Висота в половину ключа, цифри 14pt. Найменше місця займає букви."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarım anahtar uzunluğunda, 14 puntoluk rakamlar. Harflerden en az yer kaplar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výška půl klíče, 14pt číslic. Zabere nejméně místa z dopisů."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Polovica kľúča vysoká, 14pt číslic. Zaberá najmenej miesta z písmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ύψος μισού κλειδιού, ψηφία 14 pt. Αφαιρεί το λιγότερο χώρο από τα γράμματα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En halv nyckel hög, 14 pkt siffror. Tar minst utrymme från bokstäverna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En halv nøgle høj, 14 pkt cifre. Tager mindst plads fra bogstaverne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En halv nøkkel høy, 14 pkt sifre. Tar minst plass fra bokstavene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoli avainta korkea, 14 pt numeroa. Vie vähiten tilaa kirjaimista."
