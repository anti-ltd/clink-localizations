    "Tint the real touch UIView frame to see what the surface covers": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tint die regte aanraking UIView-raam om te sien wat die oppervlak bedek"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbt den echten Touch-UIView-Rahmen ein, um zu sehen, was die Fläche abdeckt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiñe el marco real UIView del táctil: mira qué cubre la superficie"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tooni päris puudutuse UIView raam, et näha, mida pind katab"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teinte le vrai cadre UIView tactile pour voir ce que la surface couvre"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Színezi a valódi érintési UIView keretet, hogy lásd, mit fed le a felület"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colora il frame reale della UIView touch per vedere cosa copre la superficie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際のタッチ UIView フレームを色付けして、サーフェスがどこを覆っているか見られます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 터치 UIView 프레임에 색을 입혀서 표면이 어디를 덮는지 봐요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnakan bingkai UIView sentuh sebenar untuk lihat apa yang diliputi permukaan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore o frame real da UIView de toque para ver o que a superfície cobre"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подкрашивать настоящий UIView для касаний, чтобы видеть, что покрывает поверхность"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给真实触摸 UIView 的框染色，看看这个表面覆盖了哪里"
          }
        }
      }
    },
    "Tints the status bar to match and sets the Liquid Glass fallback.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tint die statusbalk om te pas en stel die Liquid Glass-terugval."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbt die Statusleiste passend ein und legt den Fallback für Liquid Glass fest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiñe la barra de estado para que combine y ajusta el respaldo de Liquid Glass."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Toonib olekuriba vastavaks ja määrab Liquid Glassi varufalli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teinte la barre d'état pour l'assortir et définit la solution de repli Liquid Glass."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A színéhez igazítja az állapotsávot, és beállítja a Liquid Glass tartalékot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colora la barra di stato in tinta e imposta il ripiego di Liquid Glass."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスバーを合わせて色付けし、Liquid Glass のフォールバックを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태 막대를 어울리게 색을 입히고 Liquid Glass 대체 설정을 정해줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mewarnakan bar status supaya sepadan dan menetapkan sandaran Liquid Glass."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinge a barra de estado para condizer e define o recurso Liquid Glass."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подкрашивает строку состояния в тон и задаёт запасной вариант для Liquid Glass."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给状态栏染上相配的颜色，并设置 Liquid Glass 的备用方案。"
          }
        }
      }
    },
    "Tired of “Allow Paste?”": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moeg vir \"Laat plak toe?\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genug von „Einsetzen erlauben“?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cansado de «Permitir pegar»?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüdinud „Luba kleepimine?”-st"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marre de « Autoriser le collage » ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleged van a „Beillesztés engedélyezése” kérdésből?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stufo di «Consenti incolla»?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ペーストを許可」にうんざり？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘붙여넣기 허용’이 지겨우신가요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penat dengan “Benarkan Tampal”?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Farto de «Permitir colar»?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надоело «Разрешить вставку?»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不想再看到“允许粘贴”？"
          }
        }
      }
    },
