    "This device can't run Apple Intelligence.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann Apple Intelligence nicht ausführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
