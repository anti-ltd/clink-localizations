          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir karakter seçmek veya Gboard tarzı bir paneli açmak için tuşu basılı tutun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržením klávesy vyberete postavu nebo otevřete panel ve stylu Gboardu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržaním klávesu vyberiete znak alebo otvoríte panel v štýle Gboard."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
