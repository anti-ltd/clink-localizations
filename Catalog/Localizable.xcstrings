            "state": "translated",
            "value": "As ferramentas ocupam a barra como ícones compactos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструменты занимают строку компактными значками."
          }
        },
        "zh-Hans": {
