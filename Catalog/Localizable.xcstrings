          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть рисунки этого шрифта."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukisan fon ini tidak dapat dibuka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A betűtípus rajzai nem nyithatók meg."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォントの描画データを開けませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开此字体的绘制数据。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 글꼴의 그림을 열 수 없습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle fondi joonistusi ei õnnestunud avada."
          }
        }
      }
    },
    "This is an event action. Closing a panel or running a command does not create an undo rule.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una acción de evento. Cerrar un panel o ejecutar un comando no crea una regla para deshacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est une action d’événement. Fermer un panneau ou exécuter une commande ne crée pas de règle d’annulation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine Ereignisaktion. Das Schließen eines Panels oder Ausführen eines Befehls erstellt keine Rückgängig-Regel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è un’azione su evento. Chiudere un pannello o eseguire un comando non crea una regola di annullamento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma ação de evento. Fechar um painel ou executar um comando não cria uma regra para anular a ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это действие по событию. Закрытие панели или выполнение команды не создаёт правило отмены."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tindakan peristiwa. Menutup panel atau menjalankan arahan tidak mencipta peraturan buat asal."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez egy eseményművelet. A panel bezárása vagy parancs futtatása nem hoz létre visszavonási szabályt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはイベントアクションです。パネルを閉じたりコマンドを実行したりしても、元に戻すルールは作成されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是事件操作。关闭面板或运行命令不会创建撤销规则。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트 동작입니다. 패널을 닫거나 명령을 실행해도 되돌리기 규칙이 생성되지는 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on sündmuse toiming. Paneeli sulgemine või käsu käivitamine ei loo tagasivõtmisreeglit."
          }
        }
      }
    },
    "This is the instruction handed to the on-device model. Edit it to change how this action behaves.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit is die instruksie wat aan die model op die toestel gegee word. Wysig dit om te verander hoe hierdie handeling optree."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist die Anweisung, die an das Modell auf dem Gerät geht. Bearbeite sie, um zu ändern, wie sich diese Aktion verhält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es la instrucción que recibe el modelo del dispositivo. Edítala para cambiar cómo se comporta esta acción."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on juhis, mis antakse seadmesisesele mudelile. Muuda seda, et muuta selle tegevuse käitumist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est l'instruction envoyée au modèle sur l'appareil. Modifie-la pour changer le comportement de cette action."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt az utasítást kapja az eszközön futó modell. Szerkeszd, ha meg akarod változtatni, hogyan működik ez a művelet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è l’istruzione che passi al modello sul dispositivo. Modificala per cambiare il comportamento di questa azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはデバイス内のモデルに渡す指示です。編集するとこのアクションの動きが変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이건 기기 안의 모델에 전달되는 지시문이에요. 이 동작이 어떻게 작동할지 바꾸려면 여기를 고치세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini arahan yang diberi kepada model dalam peranti. Edit untuk ubah cara tindakan ini berfungsi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a instrução dada ao modelo no dispositivo. Edita-a para mudar como esta ação se comporta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это указание, которое передаётся модели на устройстве. Измените его, чтобы поменять поведение действия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是给设备上模型的指令。改一改，就能改变这个操作的行为。"
          }
        }
      }
    },
    "This is the real thing": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit is die regte ding"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist die echte Tastatur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el teclado de verdad"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on päris asi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est le vrai clavier"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az igazi billentyűzet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è la tastiera vera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは本物のキーボードです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 키보드예요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini papan kekunci sebenar"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o teclado a sério"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё по-настоящему"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这就是真正的键盘"
          }
        }
      }
    },
    "This key draws its own label live (shift state, the field's return action, the globe, or a blank space bar), so there's nothing to set here.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hierdie sleutel teken sy eie etiket regstreeks (skuifstatus, die veld se terugkeeraksie, die aardbol of 'n leë spasiebalk), so daar is niks om hier te stel nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Taste zeichnet ihr Label selbst und live (Umschaltzustand, Rückgabeaktion des Felds, Globus oder leere Leertaste), hier gibt es also nichts einzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tecla dibuja su propia etiqueta al vuelo (mayúsculas, la acción de retorno del campo, el globo o una barra espaciadora en blanco), así que aquí no hay nada que tocar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See klahv joonistab oma pealdise reaalajas (tõstuolek, välja sisestustegevus, gloobus või tühi tühikuklahv), seega pole siin midagi määrata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette touche affiche son propre libellé en direct (majuscules, action retour du champ, globe ou barre d'espace vide), donc rien à régler ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a billentyű élőben rajzolja a saját feliratát (shift állapot, a mező return művelete, a földgömb vagy üres szóköz), úgyhogy itt nincs mit beállítani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo tasto disegna la sua etichetta al volo (stato Maiuscole, azione Invio del campo, globo o barra spaziatrice vuota), quindi qui non c'è niente da impostare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーはラベルを自分でその場で描きます（シフトの状態、フィールドのリターン動作、地球儀、または何もないスペースバー）。なのでここで設定することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키는 라벨을 그때그때 직접 그려요(시프트 상태, 필드의 Return 동작, 지구본, 또는 빈 스페이스 바). 그래서 여기서 따로 설정할 건 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci ini lukis labelnya sendiri secara langsung (shift, tindakan return medan, glob, atau bar ruang kosong), jadi tak ada apa nak tetapkan di sini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tecla desenha a sua própria etiqueta ao vivo (estado de maiúsculas, ação de retorno do campo, globo ou barra de espaço em branco), por isso não há nada para definir aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта клавиша рисует свою подпись на лету (состояние Shift, действие Return для поля, глобус или пустой пробел), поэтому задавать здесь нечего."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个键会自己实时画出标签（Shift 状态、字段的 Return 操作、地球键，或是空白的空格键），所以这里没什么好设的。"
          }
        }
      }
    },
    "This key draws its own label live based on context. Nothing to set here.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hierdie sleutel teken sy eie etiket lewendig op grond van konteks. Niks om hier te stel nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Taste zeigt ihre Beschriftung je nach Kontext live an. Hier gibt es nichts einzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tecla dibuja su propia etiqueta en tiempo real según el contexto. Aquí no hay nada que configurar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See klahv joonistab oma pealdise reaalajas konteksti põhjal. Siin pole midagi määrata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette touche affiche son libellé en direct selon le contexte. Il n'y a rien à régler ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a billentyű a helyzet alapján élőben rajzolja ki a saját feliratát. Itt nincs mit beállítani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa tecla mostra la propria etichetta in tempo reale in base al contesto. Qui non c'è nulla da impostare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーの表示は状況に合わせて自動で変わります。ここでの設定はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키는 상황에 맞춰 라벨을 실시간으로 표시해요. 여기서 설정할 내용은 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci ini memaparkan label sendiri secara langsung mengikut konteks. Tiada apa-apa untuk ditetapkan di sini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tecla apresenta o próprio texto em tempo real consoante o contexto. Não há nada para configurar aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта клавиша сама рисует свою подпись в зависимости от контекста. Здесь настраивать нечего."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此按键会根据当前情境实时显示自己的标签，无需在这里设置。"
          }
        }
      }
    },
    "This model couldn't create a valid draft. Try another model or a simpler request.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model couldn't create a valid draft. Try another model or a simpler request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo no ha podido crear un borrador válido. Prueba con otro modelo o una solicitud más sencilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle n’a pas pu créer un brouillon valide. Essaie un autre modèle ou une demande plus simple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell konnte keinen gültigen Entwurf erstellen. Versuche ein anderes Modell oder eine einfachere Anfrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo modello non è riuscito a creare una bozza valida. Prova un altro modello o una richiesta più semplice."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo não conseguiu criar um rascunho válido. Experimenta outro modelo ou um pedido mais simples."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта модель не смогла создать корректный черновик. Попробуйте другую модель или более простой запрос."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ini tidak dapat menghasilkan draf yang sah. Cuba model lain atau permintaan yang lebih ringkas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a modell nem tudott érvényes piszkozatot létrehozni. Próbálj másik modellt vagy egyszerűbb kérést."
