        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下的按键如何回弹复位，由上方的触感设置决定。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cum o tastă apăsată revine la odihnă, modelată de senzația de mai sus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe een ingedrukte toets terugveert tot rust, gevormd door het gevoel erboven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下的按鍵如何回彈復位，由上方的觸感設定決定。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposób, w jaki naciśnięty klawisz powraca do stanu spoczynku, ukształtowany przez powyższe odczucie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як натиснута клавіша повертається назад, сформована відчуттям вище."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basılan bir tuşun yukarıdaki hisle şekillenerek nasıl geri yaylandığı."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak se stisknutá klávesa vrátí do klidu, tvarovaná podle výše uvedeného pocitu."
