          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει ένα αποτέλεσμα στη γραμμή προτάσεων καθώς πληκτρολογείτε μια έκφραση, ακόμα και όταν η Αριθμομηχανή είναι απενεργοποιημένη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar ett resultat i förslagsfältet när du skriver ett uttryck, även när Kalkylatorn är avstängd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser et resultat i forslagslinjen, mens du skriver et udtryk, selv når Lommeregner er slukket."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser et resultat i forslagslinjen mens du skriver et uttrykk, selv når Kalkulator er av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää tuloksen ehdotuspalkissa, kun kirjoitat lauseketta, vaikka Laskin on pois päältä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
