    "Curated presets and the controls that matter most.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samegestelde voorafinstellings en die kontroles wat die meeste saak maak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Voreinstellungen und die wichtigsten Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preajustes seleccionados y los controles más importantes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitud eelseadistused ja kõige olulisemad juhtelemendid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des préréglages soignés et les commandes qui comptent le plus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válogatott előbeállítások és a legfontosabb vezérlők."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preset curati e i controlli che contano di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厳選したプリセットと、いちばん大切なコントロール"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엄선한 프리셋과 가장 중요한 설정만 모았어요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Praset terpilih dan kawalan yang paling penting."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinições selecionadas e os controlos mais importantes."
          }
        },
        "ru": {
