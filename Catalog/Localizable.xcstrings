        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå av Bakteppe for å la appen du skriver inn vises gjennom."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota tausta pois päältä, jotta kirjoittamasi sovellus näkyy."
