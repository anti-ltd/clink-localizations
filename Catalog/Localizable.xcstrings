    "Turn off “Pick up where you left off” to always open on one category.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel \"Gaan aan waar jy opgehou het\" af om altyd op een kategorie oop te maak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte „Da weitermachen, wo du warst“ aus, um immer dieselbe Kategorie zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva «Seguir donde lo dejaste» para abrir siempre en la misma categoría."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita välja „Jätka sealt, kus pooleli jäid”, et avada alati ühes kategoorias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive « Reprendre où tu t'es arrêté » pour toujours ouvrir sur la même catégorie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold ki a „Ott folytasd, ahol abbahagytad” opciót, ha mindig ugyanazzal a kategóriával szeretnéd kezdeni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva «Riprendi da dove eri» per aprire sempre sulla stessa categoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に同じカテゴリで開きたいときは「前の続きから開く」をオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 같은 카테고리로 열려면 ‘마지막에 보던 곳부터’를 꺼주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan “Sambung dari tempat terakhir” untuk sentiasa buka pada satu kategori."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga «Continuar onde ficaste» para abrir sempre na mesma categoria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите «Продолжить с того места, где остановились», чтобы всегда открываться на одной категории."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想每次都从同一个分类打开，就关掉「从上次的位置继续」。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivați „Reluați de unde ați rămas” pentru a deschide întotdeauna pe o categorie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel 'Ga verder waar je was gebleven' uit om altijd in één categorie te openen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想每次都從同一個分類開啟，就關掉「從上次的位置繼續」。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz opcję „Rozpocznij od miejsca, w którym przerwałeś”, aby zawsze otwierać w jednej kategorii."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкніть опцію «Продовжити з місця, де зупинилися», щоб завжди відкривати в одній категорії."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman tek bir kategoride açmak için \"Kaldığınız yerden devam edin\" seçeneğini kapatın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypněte „Navázat, kde jste skončili“, aby se vždy otevíralo v jedné kategorii."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnite možnosť „Pokračovať tam, kde ste prestali“, aby sa vždy otvárala v jednej kategórii."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιήστε το \"Συνεχίστε από εκεί που σταματήσατε\" για να ανοίγετε πάντα σε μία κατηγορία."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stäng av \"Fortsätt där du slutade\" för att alltid öppna i en kategori."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiver \"Fortsæt, hvor du slap\" for altid at åbne på én kategori."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå av «Fortsett der du slapp» for alltid å åpne i én kategori."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista \"Jatka siitä, mihin jäit\" pois päältä avataksesi aina yhden luokan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonaktifkan “Lanjutkan dari bagian terakhir yang Anda tinggalkan” agar selalu terbuka pada satu kategori."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt “Tiếp tục từ nơi bạn đã dừng lại” để luôn mở trên một danh mục."
          }
        }
      }
    },
