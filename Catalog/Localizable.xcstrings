    "Mark every control, page and tab with the id a plugin can use. Tap a badge to copy it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiert jedes Bedienelement, jede Seite und jeden Tab mit der ID, die ein Plugin verwenden kann. Tippe auf ein Symbol, um sie zu kopieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca cada control, página y pestaña con el ID que puede usar un plugin. Toca una insignia para copiarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märgib iga juhtelemendi, lehe ja vahekaardi ID-ga, mida pistikprogramm saab kasutada. Kopeerimiseks puuduta märki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque chaque commande, page et onglet avec l'identifiant qu'un plugin peut utiliser. Touchez un badge pour le copier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden vezérlőt, oldalt és lapot megjelöl azzal az azonosítóval, amelyet egy bővítmény használhat. Koppints egy jelvényre a másoláshoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrassegna ogni controllo, pagina e scheda con l'ID che un plugin può usare. Tocca un badge per copiarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのコントロール、ページ、タブに、プラグインが使える ID を表示します。バッジをタップするとコピーできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 컨트롤, 페이지, 탭에 플러그인이 사용할 수 있는 ID를 표시합니다. 배지를 탭하면 복사됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandakan setiap kawalan, halaman dan tab dengan ID yang boleh digunakan plugin. Ketik lencana untuk menyalinnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca cada controlo, página e separador com o ID que um plugin pode usar. Toque num distintivo para o copiar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помечает каждый элемент, страницу и вкладку идентификатором, который может использовать плагин. Нажмите на значок, чтобы скопировать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个控件、页面和标签页标出插件可用的 ID。点按标记即可复制。"
          }
        }
      }
    },
