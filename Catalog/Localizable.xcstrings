            "state": "translated",
            "value": "ツールが小さなアイコンになってバーを占めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구가 작은 아이콘으로 바를 채워요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alatan mengambil alih bar sebagai ikon padat."
          }
        },
        "pt": {
