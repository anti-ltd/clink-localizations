    "Extra marks that finish a sentence, on top of . ! and ?": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstra punte wat 'n sin voltooi, bo-op . ! en ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weitere Zeichen, die einen Satz abschließen – zusätzlich zu . ! und ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Signos adicionales que cierran una frase, además de . ! y ?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Täiendavad märgid, mis lõpetavad lause, lisaks . ! ja ?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signes supplémentaires qui achèvent une phrase, en plus de . ! et ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "További jelek, amik lezárnak egy mondatot a . ! és ? mellett."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altri segni che chiudono una frase, oltre a . ! e ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「. ! ?」に加えて文を終える記号。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ". ! ? 외에 문장을 끝내는 기호."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda tambahan yang menamatkan ayat, selain . ! dan ?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinais adicionais que fecham uma frase, além de . ! e ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнительные знаки, завершающие предложение, помимо . ! и ?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除 . ! ? 之外，还能结束句子的符号。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Semne suplimentare care termină o propoziție, deasupra . ! si ?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra punten die een zin afmaken, bovenop . ! En ?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除 . ! ? 之外，還能結束句子的符號。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatkowe znaki kończące zdanie, nad .! I ?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додаткові позначки, які закінчують речення, поверх . ! і ?"
          }
