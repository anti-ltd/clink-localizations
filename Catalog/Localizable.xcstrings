    "Leans each key away from the centre of its row.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclina cada tecla alejándola del centro de su fila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Incline chaque touche vers l’extérieur, à partir du centre de sa rangée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neigt jede Taste von der Mitte ihrer Reihe nach außen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclina ogni tasto allontanandolo dal centro della sua riga."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclina cada tecla para fora do centro da sua fila."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклоняет каждую клавишу от центра её ряда."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Melencongkan setiap kekunci menjauhi tengah barisnya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden billentyűt a sora közepétől kifelé dönt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーを列の中心から外側へ傾けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让每个按键从所在行的中心向外倾斜。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 키를 해당 행의 중심에서 바깥쪽으로 기울입니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kallutab iga klahvi oma rea keskpunktist eemale."
          }
        }
      }
    },
