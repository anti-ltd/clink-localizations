    "No ripple. Cleanest.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin ondas. Lo más sencillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans ondulation. Le plus épuré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Wellen. Am schlichtesten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna increspatura. Il più essenziale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ondulação. O mais simples."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без волн. Максимально просто."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada riak. Paling ringkas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs fodrozódás. A legletisztultabb."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "波紋なし。最もシンプルです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无波纹，最简洁。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파동 없음. 가장 깔끔합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilma lainetuseta. Kõige lihtsam."
          }
        }
      }
    },
    "No samples yet. Type on the real keyboard and come back.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog geen monsters nie. Tik op die regte sleutelbord en kom terug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Beispiele. Tippe auf der echten Tastatur und komm wieder vorbei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay muestras. Escribe en el teclado real y vuelve luego."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Näidiseid veel pole. Tipi päris klaviatuuril ja tule tagasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'échantillons. Tape sur le vrai clavier et reviens."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs minta. Gépelj a valódi billentyűzeten, aztán gyere vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun campione. Scrivi sulla tastiera vera e torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだサンプルがありません。実際のキーボードで入力してから戻ってきてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 샘플이 없어요. 실제 키보드로 입력해보고 다시 오세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada sampel. Taip pada papan kekunci sebenar dan kembali semula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem amostras. Escreve no teclado real e volta depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Образцов пока нет. Попечатайте на настоящей клавиатуре и возвращайтесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有样本，先用实际键盘打几下字，再回来看看。"
          }
        }
      }
    },
