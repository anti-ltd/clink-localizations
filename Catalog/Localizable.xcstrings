          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehetőségek"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Opzioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オプション"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옵션"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opções"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметры"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选项"
          }
        }
      }
    },
    "Or swipe down on it to take the accent it offers first.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Of swiep daarop af om eers die aksent te neem wat dit bied."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder wisch darauf nach unten und nimm den Akzent, der zuerst vorgeschlagen wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O desliza hacia abajo sobre ella para coger el primer acento que ofrece."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Või viipa sellel alla, et võtta aksent, mida ta kõigepealt pakub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou balaie vers le bas dessus pour prendre l'accent proposé en premier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vagy húzd lefelé rajta, és megkapod az elsőként kínált ékezetet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure scorri verso il basso sulla lettera per prendere il primo accento proposto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "または、そのキーを下にスワイプすると最初の候補のアクセント記号が入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또는 그 키를 아래로 쓸어내리면 가장 먼저 제안되는 악센트가 입력됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Atau leret ke bawah padanya untuk mengambil aksen pertama yang ditawarkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou desliza para baixo sobre ela para apanhares o primeiro acento que aparece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или смахните по ней вниз, чтобы взять первый предложенный акцент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或者在这个键上往下滑，直接取它给出的第一个重音字母。"
          }
        }
      }
    },
    "Or swipe up on the Return key, and choose from the list that floats up.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Of swiep op op die Return-sleutel, en kies uit die lys wat opsweef."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder streich auf der Eingabetaste nach oben und wähl aus der Liste, die aufklappt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O desliza hacia arriba en la tecla de retorno y elige de la lista que aparece flotando."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Või viipa sisestusklahvil üles ja vali hõljuvast loendist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou balaie vers le haut sur la touche Retour et choisis dans la liste qui apparaît."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vagy húzd felfelé az Enteren, és válassz a felúszó listából."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure scorri verso l'alto sul tasto Invio e scegli dall'elenco che compare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "または、リターンキーを上にスワイプして、浮かび上がるリストから選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또는 Return 키를 위로 쓸어올린 뒤, 떠오르는 목록에서 고르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Atau leret ke atas pada kekunci Return, dan pilih daripada senarai yang timbul."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou desliza para cima na tecla Return e escolhe na lista que aparece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или смахните вверх по клавише Return и выберите из всплывшего списка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或者在 Return 键上向上轻扫，从浮出来的列表里选。"
          }
        }
      }
    },
    "Or turn off Lighting and the animated background in Theme, which are the two big ones.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Of skakel Beligting en die geanimeerde agtergrond in Tema af, wat die twee grotes is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder schalte die Beleuchtung und den animierten Hintergrund im Design aus — das sind die beiden großen Posten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O desactiva la Iluminación y el fondo animado en Tema, que son los dos grandes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Või lülita teemas välja Valgustus ja animeeritud taust — need on kaks suurt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou coupe l'Éclairage et le fond animé dans Thème : ce sont les deux plus gourmands."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vagy kapcsold ki a Világítást és a Témában az animált hátteret — ez a kettő a nagy fogyasztó."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure disattiva l'Illuminazione e lo sfondo animato in Tema: sono i due più pesanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "または「ライティング」と、「テーマ」の動く背景をオフにします。この2つが特に大きいです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또는 조명과 테마의 움직이는 배경을 끄세요. 이 둘이 가장 큽니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Atau matikan Pencahayaan dan latar beranimasi dalam Tema, dua itulah yang paling berat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou desliga a Iluminação e o fundo animado no Tema, que são os dois grandes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или выключите «Подсветку» и анимированный фон в «Темах» — это два главных потребителя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或者关掉“灯光”和“主题”里的动态背景，这两个最耗。"
          }
        }
      }
    },
    "Or turn off the lighting in Effects and the animated background in Theme, which are the two big ones.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Of skakel die beligting af in Effekte en die geanimeerde agtergrond in Tema, wat die twee grotes is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder schalte die Beleuchtung unter „Effekte“ und den animierten Hintergrund im Design aus — das sind die beiden großen Posten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O desactiva la iluminación en Efectos y el fondo animado en Tema, que son los dos grandes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Või lülita Efektide all valgustus ja teemas animeeritud taust välja — need on kaks suurt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou coupe l'éclairage dans Effets et le fond animé dans Thème : ce sont les deux plus gourmands."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vagy kapcsold ki a világítást a Hatások oldalon, és a Témában az animált hátteret — ez a kettő a nagy fogyasztó."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure disattiva l'illuminazione in Effetti e lo sfondo animato in Tema: sono i due più pesanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "または「エフェクト」のライティングと、「テーマ」の動く背景をオフにします。この2つが特に大きいです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또는 효과에서 조명을, 테마에서 움직이는 배경을 끄세요. 이 둘이 가장 큽니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Atau matikan pencahayaan dalam Kesan dan latar beranimasi dalam Tema, dua itulah yang paling berat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou desliga a iluminação em Efeitos e o fundo animado no Tema, que são os dois grandes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или выключите подсветку в «Эффектах» и анимированный фон в «Темах» — это два главных потребителя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或者关掉“效果”里的灯光和“主题”里的动态背景，这两个最耗。"
          }
        }
      }
    },
    "Or turn off the lighting in Effects and the effect in Background, which are the two big ones.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Of skakel die beligting af in Effekte en die effek in Agtergrond, wat die twee grotes is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder schalte die Beleuchtung unter „Effekte“ und den Effekt unter „Hintergrund“ aus — das sind die beiden großen Posten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O desactiva la iluminación en Efectos y el efecto en Fondo, que son los dos grandes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
