    "Drag Press linger down to nothing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh das Druck-Verweilen ganz auf null."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja la Permanencia de pulsación a cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramène le Maintien de l'appui à zéro."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd a Nyomás késlekedését nullára."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta la Permanenza della pressione a zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「押下の保持」をゼロまで下げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누름 유지를 0까지 내리세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Turunkan Lengah tekanan ke sifar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa a Permanência do toque até zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сведите «Задержку нажатия» к нулю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把“按压停留”拖到零。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista vajutuse viivitus täiesti nullini."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep Druk bly tot niks."
          }
        }
      }
    },
    "Drag it down for squarer keys, up for rounder ones.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach unten ziehen macht sie kantiger, nach oben runder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bájalo para teclas más cuadradas, súbelo para más redondeadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baisse-le pour des touches plus carrées, monte-le pour plus rondes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd lejjebb a szögletesebb, feljebb a kerekebb billentyűkért."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbassalo per tasti più squadrati, alzalo per averli più tondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下げると角ばり、上げると丸くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내리면 각지고, 올리면 둥글어집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Turunkan untuk kekunci lebih bersegi, naikkan untuk lebih bulat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa-o para teclas mais quadradas, sobe-o para mais redondas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведите вниз — клавиши квадратнее, вверх — круглее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调低更方正，调高更圆润。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista alla kandilisemate klahvide jaoks, üles ümaramate jaoks."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep dit af vir vierkantige sleutels, op vir ronder sleutels."
          }
        }
      }
    },
    "Drag the handle to resize the strip, or turn the dials. Double-tap the strip to start over.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh am Griff, um den Streifen zu ändern, oder dreh an den Reglern. Doppeltippen auf den Streifen setzt alles zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el tirador para cambiar el tamaño de la tira o gira los diales. Toca dos veces la tira para empezar de cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser la poignée pour redimensionner la bande, ou tourne les molettes. Double-tape la bande pour tout remettre à zéro."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd a fogantyút a sáv átméretezéséhez, vagy tekerd a tárcsákat. A sávra duplán koppintva minden visszaáll."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina la maniglia per ridimensionare la striscia oppure gira le manopole. Tocca due volte la striscia per ricominciare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つまみをドラッグすると帯の大きさが変わります。ダイヤルでも調整でき、帯をダブルタップすると元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손잡이를 끌어 띠 크기를 바꾸거나 다이얼을 돌려 조절하세요. 띠를 두 번 탭하면 처음 상태로 돌아갑니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret pemegang untuk mengubah saiz jalur, atau putar dailnya. Ketik dua kali pada jalur untuk kembali asal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta a pega para redimensionar a faixa ou roda os seletores. Toca duas vezes na faixa para recomeçar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяните за ручку, чтобы изменить размер полосы, или покрутите регуляторы. Двойное нажатие по полосе начинает заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动手柄即可调整数字带大小，也可以转动旋钮。双击数字带即可恢复原状。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista käepidet riba suuruse muutmiseks või keera ratast. Topelt-puuduta riba, et alustada uuesti."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep die handvatsel om die grootte van die strook te verander, of draai die draaiknoppe. Dubbeltik op die strook om oor te begin."
          }
        }
      }
    },
    "Drag through the rest of the letters without lifting.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh ohne abzusetzen durch die restlichen Buchstaben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra por el resto de las letras sin levantar el dedo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser sur les autres lettres sans lever le doigt."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd végig a többi betűn felemelés nélkül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina sulle altre lettere senza staccare il dito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指を離さずに、残りの文字をなぞります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손가락을 떼지 말고 나머지 글자들을 지나가세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret melalui huruf yang lain tanpa mengangkat jari."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta pelas restantes letras sem levantar o dedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите по остальным буквам, не отрывая палец."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手指不抬起，划过其余的字母。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista läbi ülejäänud tähtede ilma sõrge tõstmata."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep deur die res van die letters sonder om op te lig."
          }
        }
      }
    },
    "Drag to reorder the languages in the keyboard's Translate menu, and switch off any you don't want to see there.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para ordenar los idiomas del menú Traducir del teclado y desactiva los que no quieras ver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser les langues pour les réorganiser dans le menu Traduire du clavier, et désactive celles que tu ne veux pas voir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
