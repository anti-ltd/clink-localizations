          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik of sleep om sleutels te kies. Tik weer om die keuse op te hef."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij lub przeciągnij, aby wybrać klawisze. Stuknij ponownie, aby odznaczyć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться або перетягніть, щоб вибрати клавіші. Натисніть знову, щоб скасувати вибір."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşları seçmek için dokunun veya sürükleyin. Seçimi kaldırmak için tekrar dokunun."
