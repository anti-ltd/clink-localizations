    "Run a different action when the key is swiped instead of tapped.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt eine andere Aktion aus, wenn die Taste gewischt statt getippt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta una acción distinta cuando deslizas la tecla en vez de tocarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance une action différente quand la touche est balayée au lieu d'être touchée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Más műveletet futtat, ha a billentyűt húzod, nem pedig koppintod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui un'azione diversa quando il tasto viene scorso invece che toccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーをタップではなくスワイプしたときに、別のアクションを実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 탭하는 대신 스와이프할 때 다른 동작을 실행해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan tindakan berbeza bila kekunci dileret dan bukannya diketik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa uma ação diferente quando a tecla é deslizada em vez de tocada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполнять другое действие, когда по клавише проводят, а не нажимают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键被滑动（而不是点按）时执行另一个操作。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Käivita teine tegevus, kui klahvi pühitakse vajutamise asemel."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voer 'n ander aksie uit wanneer die sleutel gevee word in plaas van getik word."
          }
        }
      }
    },
    "Run a different action while shift or caps-lock is on, e.g. 🙂 becomes 123.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt eine andere Aktion aus, während Shift oder die Feststelltaste an ist, z. B. 🙂 wird zu 123."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta una acción distinta mientras están activados mayúsculas o bloq mayús; por ejemplo, 🙂 pasa a ser 123."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance une action différente quand la majuscule ou le verrouillage est actif, par ex. 🙂 devient 123."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Más műveletet futtat, amíg a shift vagy a caps lock be van kapcsolva, pl. a 🙂 helyett 123 lesz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegue un'azione diversa quando il maiuscolo o il blocco maiuscole è attivo, ad es. 🙂 diventa 123."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフトまたは Caps Lock がオンのあいだ、別のアクションを実行します。例: 🙂 が 123 になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시프트나 캡스록이 켜져 있는 동안 다른 동작을 실행해요. 예: 🙂이 123으로 바뀌어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan tindakan berbeza semasa shift atau caps lock hidup, cth. 🙂 jadi 123."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa uma ação diferente enquanto o shift ou o caps lock está ativo, ex.: 🙂 passa a 123."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполнять другое действие при включённом Shift или Caps Lock — например, 🙂 становится 123."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Shift 或大写锁定开启时执行另一个操作，比如 🙂 变成 123。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Käivita teine tegevus, kui tõstuklahv või Caps Lock on all, nt. 🙂 muutub 123-ks."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voer 'n ander aksie uit terwyl shift of caps-lock aan is, bv. 🙂 word 123."
          }
        }
      }
    },
    "Run a different action while the key is held, e.g. tap 🙂 for emoji, hold for 123.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
