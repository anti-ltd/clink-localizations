    "How a pressed key springs back to rest after each press.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe 'n gedrukte sleutel na elke druk terugspring om te rus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie eine gedrückte Taste nach jedem Tastendruck in ihre Ruheposition zurückspringt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo vuelve una tecla a su posición de reposo tras cada pulsación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuidas vajutatud klahv pärast iga vajutust tagasi puhkeasendisse hüppab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment une touche enfoncée revient au repos après chaque pression."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogyan pattan vissza egy megnyomott billentyű nyugalmi állapotába minden lenyomás után."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come un tasto premuto torna a riposo dopo ogni pressione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押したキーが毎回の押下後にどのように元の位置に戻るかを示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누른 키가 매번 누를 때마다 원래 상태로 돌아오는 방식을 설정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cara kekunci yang ditekan kembali ke kedudukan asal selepas setiap tekanan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como uma tecla premida volta ao repouso após cada pressão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как нажатая клавиша возвращается в исходное положение после каждого нажатия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下按键后，按键如何弹回原位。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cum o tastă apăsată revine în repaus după fiecare apăsare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe een ingedrukte toets na elke druk weer tot rust komt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下按鍵後，按鍵如何彈回原位。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak naciśnięty klawisz powraca do stanu spoczynku po każdym naciśnięciu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як натиснута клавіша повертається назад після кожного натискання."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basılan bir tuşun, her basıştan sonra nasıl eski konumuna geri döndüğü."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak se stisknutá klávesa po každém stisknutí vrátí do klidu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako sa stlačený kláves po každom stlačení vráti do pokoja."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πώς ένα πατημένο πλήκτρο επανέρχεται για να ξεκουραστεί μετά από κάθε πάτημα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur en intryckt nyckel fjädrar tillbaka till vila efter varje tryck."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan en trykket tast springer tilbage til hvile efter hvert tryk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan en trykket tast springer tilbake til hvile etter hvert trykk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka painettu näppäin pomppaa takaisin lepoon jokaisen painalluksen jälkeen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimana tombol yang ditekan akan kembali berhenti setelah setiap kali ditekan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm thế nào một phím được nhấn sẽ quay trở lại trạng thái nghỉ sau mỗi lần nhấn."
          }
        }
      }
    },
    "How a pressed key springs back to rest, shaped by the feel above.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe 'n ingedrukte sleutel terugspring om te rus, gevorm deur die gevoel hierbo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie eine gedrückte Taste in die Ruhelage zurückfedert, geprägt vom Gefühl oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo una tecla pulsada vuelve a su posición de reposo, según el tacto elegido arriba."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuidas vajutatud klahv tagasi raugeb, kujundatuna ülaloleva tunnetuse poolt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment une touche pressée revient à sa place, selon le ressenti choisi ci-dessus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Így ugrik vissza a lenyomott gomb nyugalmi helyzetébe, a fent választott érzés alakítja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come un tasto premuto torna a riposo, modellato dalla sensazione scelta sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押したキーが元に戻るときのばねの動き。上で選んだ雰囲気に合わせて変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눌린 키가 제자리로 되돌아오는 방식으로, 위의 느낌 설정에 따라 달라집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cara kekunci yang ditekan melantun kembali ke kedudukan asal, dibentuk oleh rasa di atas."
