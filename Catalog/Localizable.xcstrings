    "Half a key tall, 14pt digits. Takes the least room from the letters.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halb so hoch wie eine Taste, Ziffern in 14 pt. Nimmt den Buchstaben am wenigsten Platz weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mitad de alto que una tecla, dígitos de 14 pt. Es la que menos espacio quita a las letras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moitié moins haute qu'une touche, chiffres en 14 pt. C'est celle qui prend le moins de place aux lettres."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fél billentyű magas, 14 pt-os számjegyek. Ez veszi el a legkevesebb helyet a betűktől."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alta metà di un tasto, cifre da 14 pt. È quella che toglie meno spazio alle lettere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの半分の高さ、数字は14pt。文字のスペースをいちばん減らしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 높이의 절반, 숫자는 14pt입니다. 글자 영역을 가장 적게 차지합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setinggi separuh kekunci, digit 14 pt. Paling sedikit mengambil ruang huruf."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Metade da altura de uma tecla, dígitos de 14 pt. É a que rouba menos espaço às letras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В половину высоты клавиши, цифры 14pt. Отнимает у букв меньше всего места."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高度为按键的一半，数字 14pt。占用字母的空间最少。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pool klahvi kõrge, 14 pt numbrid. Võtab tähtedelt kõige vähem ruumi."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Halwe sleutel hoog, 14pt syfers. Neem die minste ruimte van die letters."
          }
        }
      }
    },
    "Hand-tuned springs. Tap Custom again to adjust every knob.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handjustierte Federn. Tippe erneut auf „Benutzerdefiniert“, um jeden Regler anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resortes ajustados a mano. Vuelve a tocar Personalizado para ajustar cada control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ressorts réglés à la main. Touche à nouveau Personnalisé pour ajuster chaque paramètre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kézzel hangolt rugók. Koppints újra a Szokás lehetőségre minden gomb beállításához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Molle regolate a mano. Tocca di nuovo Personalizzato per regolare ogni parametro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動調整されたばね。カスタムをもう一度タップすると細かく調整できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 조정한 스프링입니다. 사용자 설정을 다시 탭하면 모든 값을 조정할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Spring dilaras sendiri. Ketik Tersuai sekali lagi untuk melaraskan setiap tombol."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Molas ajustadas à mão. Toque novamente em Personalizado para ajustar todos os controlos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пружины, настроенные вручную. Нажмите «Свой» ещё раз, чтобы добраться до всех регуляторов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已手动调校弹簧参数。再次点按“自定义”可调整每个选项。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Käsitsi häälestatud vedrud. Puuduta uuesti Kohandatud, et reguleerida iga nuppu."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Handgestemde vere. Tik weer Pasgemaak om elke knop te verstel."
          }
        }
      }
    },
    "Hand-tuned values. Tap Custom to open every control.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Hand abgestimmte Werte. Tippe auf „Benutzerdefiniert“, um alle Regler zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores ajustados a mano. Toca Personalizado para abrir todos los controles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeurs réglées à la main. Touche Personnalisé pour ouvrir tous les réglages."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kézzel hangolt értékek. Koppints a Szokás lehetőségre az összes vezérlő megnyitásához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valori regolati a mano. Tocca Personalizzato per aprire tutti i controlli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動調整された値。カスタムをタップするとすべての設定を開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 조정한 값입니다. 사용자 설정을 탭하면 모든 컨트롤을 열 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai dilaras sendiri. Ketik Tersuai untuk membuka setiap kawalan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores ajustados à mão. Toque em Personalizado para abrir todos os controlos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения, настроенные вручную. Нажмите «Свой», чтобы открыть все регуляторы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已手动调校数值。点按“自定义”可打开所有控制项。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Käsitsi häälestatud väärtused. Puuduta Kohandatud, et avada kõik juhtelemendid."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Handgestemde waardes. Tik Pasgemaak om elke kontrole oop te maak."
          }
        }
      }
    },
