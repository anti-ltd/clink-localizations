    "Add a tab of your recently used emoji at the start of the emoji keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz am Anfang der Emoji-Tastatur einen Tab mit deinen zuletzt benutzten Emojis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una pestaña con los emoji que usaste hace poco al principio del teclado de emoji."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un onglet avec tes emoji récents au début du clavier emoji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tedd a nemrég használt emojijaid egy fülre az emoji-billentyűzet elejére."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una scheda con le emoji usate di recente all'inizio della tastiera emoji."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵文字キーボードの先頭に、最近使った絵文字のタブを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이모지 키보드 맨 앞에 최근 쓴 이모지 탭을 넣어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah tab emoji yang baru anda guna di awal papan kekunci emoji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um separador com os teus emoji recentes no início do teclado de emoji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить вкладку недавних эмодзи в начало клавиатуры эмодзи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在表情键盘最前面加一栏你最近用过的表情。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa emoji-klaviatuuri algusesse kaart sinu viimati kasutatud emojidega."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg 'n oortjie van jou onlangs gebruikte emoji by die begin van die emoji-sleutelbord."
          }
        }
      }
    },
    "Add a tab of your recently used emoji to the emoji keyboard. Drag it anywhere you like on the Categories tab.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz einen Tab mit deinen zuletzt benutzten Emojis auf die Emoji-Tastatur. Unter „Kategorien“ ziehst du ihn dorthin, wo du ihn haben willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade al teclado de emoji una pestaña con los que usaste hace poco. En «Categorías» puedes arrastrarla donde quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute au clavier emoji un onglet avec tes emoji récents. Dans « Catégories », fais-le glisser où tu veux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tedd a nemrég használt emojijaidat egy fülre az emoji-billentyűzeten. A „Kategóriák” fülön oda húzod, ahová szeretnéd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi alla tastiera emoji una scheda con quelle usate di recente. In «Categorie» la trascini dove vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近使った絵文字のタブを絵文字キーボードに追加します。「カテゴリ」タブで好きな位置にドラッグできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근에 쓴 이모지 탭을 이모지 키보드에 넣어요. ‘카테고리’ 탭에서 원하는 자리로 끌어다 놓을 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah tab emoji yang baru anda guna pada papan kekunci emoji. Seret ke mana-mana yang anda suka di tab Kategori."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona ao teclado de emoji um separador com os que usaste há pouco. Em «Categorias», arrasta-o para onde quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить вкладку недавних эмодзи на клавиатуру эмодзи. Перетащите её куда угодно на вкладке «Категории»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在表情键盘里加一栏你最近用过的表情。可以在「分类」里拖到你想要的位置。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa emoji-klaviatuurile kaart oma viimati kasutatud emojidega. Lohista see kaardile „Kategooriad\" sinna, kuhu soovid."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg 'n oortjie van jou onlangs gebruikte emoji by die emoji-sleutelbord. Sleep dit enige plek waar jy wil op die Kategorieë-oortjie."
          }
        }
      }
    },
    "Add a word once and Clink stops fighting it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füg ein Wort einmal hinzu, und Clink hört auf, dagegen anzukämpfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una palabra una vez y Clink deja de pelear con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un mot une fois et Clink arrête de le combattre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add hozzá a szót egyszer, és a Clink többé nem harcol ellene."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una parola una volta e Clink smette di combatterla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語を一度追加すれば、Clinkはもう直そうとしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어를 한 번만 추가하면 Clink가 더는 고치려 하지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah perkataan sekali dan Clink berhenti melawannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona uma palavra uma vez e o Clink deixa de lutar contra ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте слово один раз — и Clink перестанет с ним спорить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把词添加一次，Clink 就不再和它较劲。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa sõna üks kord ja Clink lõpetab selle vastu võitlemise."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg een keer 'n woord by en Clink hou op om daarmee te veg."
          }
        }
      }
    },
    "Add an AI panel behind the keyboard's panel button. Proofread, rewrite, change tone, shorten, reply and more.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge hinter dem Panel-Button der Tastatur ein KI-Panel hinzu. Korrekturlesen, umschreiben, Ton ändern, kürzen, antworten und mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un panel de IA detrás del botón de panel del teclado. Corrige, reescribe, cambia el tono, acorta, responde y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un panneau IA derrière le bouton de panneau du clavier. Relis, réécris, change le ton, raccourcis, réponds et plus encore."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá egy AI-panelt a billentyűzet panel gombja mögé. Helyesírás-ellenőrzés, átírás, hangnemváltás, rövidítés, válaszírás és még sok más."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un pannello IA dietro il pulsante pannelli della tastiera. Correggi, riscrivi, cambia tono, accorcia, rispondi e altro ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードのパネルボタンの奥に AI パネルを足します。校正、書き直し、トーン変更、短縮、返信などができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드의 패널 버튼 뒤에 AI 패널을 넣어줘요. 교정, 다시 쓰기, 어조 바꾸기, 줄이기, 답장 등을 할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah panel AI di sebalik butang panel papan kekunci. Semak ejaan, tulis semula, ubah nada, pendekkan, balas dan banyak lagi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um painel de IA atrás do botão de painel do teclado. Revê, reescreve, muda o tom, encurta, responde e mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить панель ИИ за кнопкой панелей на клавиатуре. Проверка, переписывание, смена тона, сокращение, ответ и не только."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘面板按钮后面加一个 AI 面板。校对、改写、换语气、缩短、回复等等。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa klaviatuuri paneelinupu taha TI-paneel. Loe üle, kirjuta ümber, muuda tooni, lühenda, vasta ja palju muud."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg 'n AI-paneel agter die sleutelbord se paneelknoppie. Proeflees, herskryf, verander toon, verkort, antwoord en meer."
          }
        }
      }
    },
