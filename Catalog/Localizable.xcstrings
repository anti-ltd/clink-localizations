    "Give each panel its own button in the picker instead of nesting them behind one Panels button. Individual panels can override this in their editor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib jedem Panel einen eigenen Button im Picker, statt sie alle hinter einem Panels-Button zu verschachteln. Einzelne Panels können das in ihrem Editor überschreiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da a cada panel su propio botón en el selector, en lugar de anidarlos todos detrás de un único botón Paneles. Cada panel puede anular esto en su editor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne à chaque panneau son propre bouton dans le sélecteur, plutôt que de les imbriquer derrière un seul bouton Panneaux. Chaque panneau peut modifier ce réglage dans son éditeur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj minden panelnek saját gombot a választóban, ahelyett hogy egy Panelek gomb mögé zsúfolnád őket. Az egyes panelek felülírhatják ezt a saját szerkesztőjükben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna a ogni pannello un proprio pulsante nel selettore, invece di annidarli tutti dietro un unico pulsante Pannelli. I singoli pannelli possono sovrascrivere questa impostazione nel proprio editor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各パネルに専用ボタンをピッカー内に用意し、1つのパネルボタンの奥にまとめないようにします。個々のパネルはエディタでこの設定を上書きできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널마다 피커에 각자의 버튼을 주고, 하나의 패널 버튼 안에 몰아넣지 않아요. 개별 패널은 자신의 에디터에서 이 설정을 덮어쓸 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri setiap panel butangnya sendiri dalam pemilih, bukannya menyarangkan semuanya di sebalik satu butang Panel. Panel individu boleh menggantikan ini dalam editornya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá a cada painel o seu próprio botão no seletor, em vez de os aninhar todos atrás de um único botão Painéis. Cada painel pode substituir isto no seu editor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дать каждой панели свою кнопку в выборе вместо того, чтобы прятать их за одной кнопкой «Панели». Отдельная панель может переопределить это в своём редакторе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给每个面板在选择器里单独一个按钮，不再全塞进一个“面板”按钮里。单个面板可以在自己的编辑器里覆盖这个设置。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna igale paneelile valijas oma nupp, selle asemel et neid ühe Paneelid-nupu taha peita. Üksikud paneelid saavad seda oma redaktoris üle kirjutada."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gee elke paneel sy eie knoppie in die kieser in plaas daarvan om hulle agter een Panele-knoppie te nes. Individuele panele kan dit in hul redigeerder ignoreer."
          }
        }
      }
    },
    "Give it a name so you can tell it apart in the panel.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ihm einen Namen, damit du es im Panel wiedererkennst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale un nombre para poder distinguirlo en el panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne-lui un nom pour pouvoir le reconnaître dans le panneau."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj neki nevet, hogy meg tudd különböztetni a panelen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagli un nome così puoi riconoscerlo nel pannello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルで見分けられるように名前を付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널에서 구분할 수 있도록 이름을 붙여주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berikan nama supaya anda dapat kenal pasti dalam panel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá-lhe um nome para conseguires distingui-lo no painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте ей имя, чтобы отличать её в панели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给它起个名字，这样在面板里能一眼认出来。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna sellele nimi, et saaksid paneelil ära tunda."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gee dit 'n naam sodat jy dit in die paneel van mekaar kan onderskei."
          }
        }
      }
    },
