        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또는 효과에서 조명을, 배경에서 효과를 끄세요. 이 둘이 가장 큽니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
