        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolor, gradient lub zdjęcie samo w sobie należy do motywu, więc ustawiasz je w kreatorze motywów."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сам колір, градієнт або фотографія належать до теми, тому ви встановлюєте їх у конструкторі тем."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rengin, degradenin veya fotoğrafın kendisi temaya aittir, dolayısıyla onu tema oluşturucuda siz ayarlarsınız."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samotná barva, přechod nebo fotka patří k tématu, takže si je nastavíte v nástroji theme builder."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Samotná farba, prechod alebo fotografia patria k téme, takže ju nastavíte v nástroji na vytváranie tém."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το χρώμα, η διαβάθμιση ή η ίδια η φωτογραφία ανήκουν στο θέμα, επομένως το ορίζετε στο πρόγραμμα δημιουργίας θεμάτων."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Själva färgen, gradienten eller fotot tillhör temat, så du ställer in det i temabyggaren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Selve farven, gradienten eller billedet hører til temaet, så du indstiller det i temabyggeren."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Selve fargen, gradienten eller bildet tilhører temaet, så du setter det i temabyggeren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Itse väri, liukuväri tai valokuva kuuluu teemaan, joten aseta se teeman rakennusohjelmassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna, gradien, atau foto itu sendiri adalah milik tema, jadi Anda mengaturnya di pembuat tema."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản thân màu sắc, độ dốc hoặc ảnh thuộc về chủ đề nên bạn đặt nó trong trình tạo chủ đề."
          }
        }
      }
    },
    "The copy on this device stays. Syncing for this one switches off, so it isn't sent back up.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kopie op hierdie toestel bly. Sinkronisering vir hierdie een skakel af, so dit word nie teruggestuur nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie auf diesem Gerät bleibt. Die Synchronisierung dafür wird ausgeschaltet, damit sie nicht gleich wieder hochgeht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de este dispositivo se queda. Se desactiva su sincronización para que no vuelva a subir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle seadme koopia jääb alles. Selle sünkroonimine lülitub välja, nii et seda tagasi üles ei saadeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie sur cet appareil reste. Sa synchronisation est désactivée pour qu’elle ne remonte pas aussitôt."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközön lévő másolat megmarad. Ehhez a szinkronizálás kikapcsol, hogy ne kerüljön vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia su questo dispositivo resta. La sincronizzazione per questa voce si disattiva, così non torna su."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末のコピーは残ります。再びアップロードされないよう、この項目の同期はオフになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 사본은 그대로 남습니다. 다시 올라가지 않도록 해당 항목의 동기화는 꺼집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan pada peranti ini kekal. Penyegerakan untuk yang satu ini dimatikan supaya ia tidak dihantar semula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia neste dispositivo fica. A sincronização deste item é desligada, para não voltar a subir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия на этом устройстве остаётся. Синхронизация для неё выключается, поэтому обратно она не отправляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备上的副本会保留。该项的同步会关闭，以免再次上传。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia de pe acest dispozitiv rămâne. Sincronizarea pentru aceasta se dezactivează, deci nu este trimisă înapoi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kopie op dit apparaat blijft staan. De synchronisatie hiervoor wordt uitgeschakeld, dus er wordt geen back-up van gemaakt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這臺裝置上的副本會保留。該項的同步會關閉，以免再次上傳。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia na tym urządzeniu pozostaje. Synchronizacja tego elementu zostaje wyłączona, więc nie jest on wysyłany z powrotem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія на цьому пристрої залишається. Синхронізацію для цього вимикається, тому він не надсилається назад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki kopya kalır. Bunun için senkronizasyon kapatılır, dolayısıyla geri gönderilmez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie v tomto zařízení zůstane. Synchronizace pro tento se vypne, takže se neposílá zpět."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kópia na tomto zariadení zostane. Synchronizácia tohto sa vypne, takže sa neodošle späť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αντίγραφο σε αυτήν τη συσκευή παραμένει. Ο συγχρονισμός για αυτό απενεργοποιείται, επομένως δεν αποστέλλεται αντίγραφα ασφαλείας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopian på den här enheten finns kvar. Synkronisering för den här stängs av, så den skickas inte tillbaka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopien på denne enhed forbliver. Synkronisering for denne slår fra, så den sendes ikke op igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopien på denne enheten forblir. Synkronisering for denne slås av, så den sendes ikke opp igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän laitteen kopio säilyy. Tämän synkronointi kytkeytyy pois päältä, joten sitä ei lähetetä takaisin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan di perangkat ini tetap ada. Sinkronisasi untuk yang ini dimatikan, sehingga tidak dikirim kembali."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao trên thiết bị này vẫn còn. Đồng bộ hóa cho cái này sẽ tắt nên nó không được gửi sao lưu."
          }
        }
      }
    },
