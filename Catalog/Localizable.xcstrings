    "Reinstall starts clean. We hold nothing on a server.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinstalleer begin skoon. Ons hou niks op 'n bediener nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Neuinstallation ist alles sauber. Wir speichern nichts auf einem Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al reinstalar empiezas de cero. No guardamos nada en ningún servidor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Uuesti paigaldamine algab puhtalt. Me ei hoia serveris midagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinstaller repart de zéro. On ne garde rien sur un serveur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az újratelepítés tiszta lappal indul. Semmit nem tartunk szerveren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reinstalli riparti da zero. Non teniamo niente su un server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入れ直すとまっさらな状態から始まります。サーバー側には何も残していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 설치하면 처음부터 깨끗하게 시작해요. 서버에는 아무것도 안 남겨요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang semula bermula bersih. Kami tak simpan apa-apa pada pelayan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstalar começa do zero. Não guardamos nada num servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переустановка начинается с чистого листа. На сервере мы ничего не храним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重装就是干干净净从头开始。我们在服务器上什么都不留。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstalarea începe curat. Nu păstrăm nimic pe un server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnieuw installeren begint schoon. Wij bewaren niets op een server."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重灌就是乾乾淨淨從頭開始。我們在伺服器上什麼都不留。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponowna instalacja zaczyna się od czystego. Nie trzymamy niczego na serwerze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевстановлення починається чисто. Ми нічого не тримаємо на сервері."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden yükleme temiz başlar. Hiçbir şeyi sunucuda tutmuyoruz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstalace začne čistě. Na serveru nic nedržíme."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Preinštalovanie začne čisté. Na serveri nič nedržíme."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επανεγκατάσταση ξεκινά καθαρά. Δεν κρατάμε τίποτα σε διακομιστή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ominstallationen startar ren. Vi har ingenting på en server."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Geninstallation starter ren. Vi har intet på en server."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstallering starter ren. Vi har ingenting på en server."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uudelleenasennus alkaa puhtaasti. Meillä ei ole mitään palvelimella."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal ulang dimulai dengan bersih. Kami tidak menyimpan apa pun di server."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt lại bắt đầu sạch sẽ. Chúng tôi không giữ gì trên máy chủ."
          }
        }
      }
    },
