    "The generated draft couldn't be validated. Try describing it differently.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido validar el borrador generado. Prueba a describirlo de otra forma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de valider le brouillon généré. Essaie de le décrire autrement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erstellte Entwurf konnte nicht validiert werden. Versuche eine andere Beschreibung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile convalidare la bozza generata. Prova a descriverla diversamente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível validar o rascunho gerado. Tente descrevê-lo de outra forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить созданный черновик. Попробуйте описать его иначе."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Draf yang dijana tidak dapat disahkan. Cuba terangkannya dengan cara lain."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A létrehozott vázlat ellenőrzése sikertelen. Próbáld másképp leírni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成した下書きを検証できませんでした。説明を変えてお試しください。"
