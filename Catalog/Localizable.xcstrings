    "Notes in this group become ungrouped.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen in dieser Gruppe werden aus der Gruppe entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas de este grupo quedarán sin grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes de ce groupe ne seront plus classées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csoport jegyzetei csoport nélkül maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note in questo gruppo non apparterranno più a nessun gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループのメモはグループなしになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹의 메모는 그룹 없음으로 이동합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota dalam kumpulan ini akan menjadi tanpa kumpulan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas deste grupo ficarão sem grupo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметки из этой группы останутся без группы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此组中的笔记将变为未分组。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selles grupis olevad märkmed muutuvad grupita."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Notas in hierdie groep raak ongegroepeer."
          }
        }
      }
    },
    "Notes keeps what you jot, to browse and load later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen behält, was du notierst — zum Durchsehen und späteren Einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas guarda lo que apuntas para consultarlo y usarlo después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes garde ce que tu écris, pour le retrouver et l'insérer plus tard."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Jegyzetek megőrzi, amit leírsz, hogy később átnézd és beszúrd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Note conserva quello che scrivi, per rileggerlo e inserirlo dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「メモ」は書いたものを残し、後から見て呼び出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘메모’는 적어 둔 걸 남겨서 나중에 보고 불러올 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota menyimpan apa yang anda catat, untuk dilihat dan dimuatkan kemudian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As Notas guardam o que escreves, para veres e inserires depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Заметки» хранят то, что вы записали, — чтобы потом просмотреть и вставить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“笔记”会留住你写下的内容，之后可以翻看再插入。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märkmed hoiab seda, mida märgid, et hiljem sirvida ja laadida."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Notas hou wat jy aanteken, om later te blaai en te laai."
          }
        }
      }
    },
    "Notes, and any background photos behind your themes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
