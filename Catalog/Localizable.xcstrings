            "state": "translated",
            "value": "No se pudo restaurar nada de esa copia de seguridad."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellest varukoopiast ei õnnestunud midagi taastada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a pu être restauré depuis cette sauvegarde."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebből a biztonsági mentésből semmit sem sikerült visszaállítani."
          }
        },
        "it": {
