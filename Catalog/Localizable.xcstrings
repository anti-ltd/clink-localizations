    "Tint the real touch UIView frame to see what the surface covers": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tint die regte aanraking UIView-raam om te sien wat die oppervlak bedek"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbt den echten Touch-UIView-Rahmen ein, um zu sehen, was die Fläche abdeckt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiñe el marco real UIView del táctil: mira qué cubre la superficie"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tooni päris puudutuse UIView raam, et näha, mida pind katab"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teinte le vrai cadre UIView tactile pour voir ce que la surface couvre"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Színezi a valódi érintési UIView keretet, hogy lásd, mit fed le a felület"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colora il frame reale della UIView touch per vedere cosa copre la superficie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際のタッチ UIView フレームを色付けして、サーフェスがどこを覆っているか見られます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 터치 UIView 프레임에 색을 입혀서 표면이 어디를 덮는지 봐요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnakan bingkai UIView sentuh sebenar untuk lihat apa yang diliputi permukaan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore o frame real da UIView de toque para ver o que a superfície cobre"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подкрашивать настоящий UIView для касаний, чтобы видеть, что покрывает поверхность"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给真实触摸 UIView 的框染色，看看这个表面覆盖了哪里"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuanțați cadrul UIView cu atingere reală pentru a vedea ce acoperă suprafața"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleur het real-touch UIView-frame om te zien wat het oppervlak bedekt"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給真實觸控 UIView 的框染色，看看這個表面覆蓋了哪裡"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odcień prawdziwą dotykową ramkę UIView, aby zobaczyć, co pokrywa powierzchnia"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтініть реальну сенсорну рамку UIView, щоб побачити, що покриває поверхня"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzeyin neyi kapladığını görmek için gerçek dokunmatik UIView çerçevesini renklendirin"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbarvujte skutečný dotykový rámeček UIView, abyste viděli, co povrch pokrývá"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zafarbite skutočný dotykový rám UIView, aby ste videli, čo pokrýva povrch"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρωματίστε το πραγματικό πλαίσιο UIView αφής για να δείτε τι καλύπτει η επιφάνεια"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Färga den verkliga UIView-ramen för att se vad ytan täcker"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Farv den ægte touch UIView-ramme for at se, hvad overfladen dækker"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Farge den ekte touch UIView-rammen for å se hva overflaten dekker"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sävytä todellinen kosketusnäyttö UIView-kehys nähdäksesi, mitä pinta peittää"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnai bingkai UIView dengan sentuhan nyata untuk melihat apa yang ditutupi permukaannya"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tô màu khung UIView cảm ứng thực để xem bề mặt bao phủ những gì"
          }
        }
      }
    },
    "Tints the status bar to match and sets the Liquid Glass fallback.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tint die statusbalk om te pas en stel die Liquid Glass-terugval."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbt die Statusleiste passend ein und legt den Fallback für Liquid Glass fest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiñe la barra de estado para que combine y ajusta el respaldo de Liquid Glass."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Toonib olekuriba vastavaks ja määrab Liquid Glassi varufalli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teinte la barre d'état pour l'assortir et définit la solution de repli Liquid Glass."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A színéhez igazítja az állapotsávot, és beállítja a Liquid Glass tartalékot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colora la barra di stato in tinta e imposta il ripiego di Liquid Glass."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスバーを合わせて色付けし、Liquid Glass のフォールバックを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태 막대를 어울리게 색을 입히고 Liquid Glass 대체 설정을 정해줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mewarnakan bar status supaya sepadan dan menetapkan sandaran Liquid Glass."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinge a barra de estado para condizer e define o recurso Liquid Glass."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подкрашивает строку состояния в тон и задаёт запасной вариант для Liquid Glass."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给状态栏染上相配的颜色，并设置 Liquid Glass 的备用方案。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuanță bara de stare pentru a se potrivi și setează soluția de rezervă Liquid Glass."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleurt de statusbalk zodat deze overeenkomt en stelt de terugval van Liquid Glass in."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給狀態列染上相配的顏色，並設定 Liquid Glass 的備用方案。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyciemnia pasek stanu i ustawia opcję zastępczą Liquid Glass."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтінює рядок стану, щоб він відповідав, і встановлює резервний варіант рідкого скла."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durum çubuğunu eşleşecek şekilde renklendirir ve Liquid Glass geri dönüşünü ayarlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tónuje stavový řádek tak, aby odpovídal, a nastavuje nouzový režim Tekuté sklo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tónuje stavový riadok tak, aby zodpovedal, a nastavuje záložný režim Tekuté sklo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρωματίζει τη γραμμή κατάστασης ώστε να ταιριάζει και ρυθμίζει το εναλλακτικό Liquid Glass."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Färgar statusfältet så att det matchar och ställer in Liquid Glass reserv."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Farver statuslinjen, så den matcher, og indstiller Liquid Glass-tilbagestilling."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Farger statuslinjen slik at den matcher og setter Liquid Glass-reserven."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sävyttää tilapalkin vastaamaan sitä ja asettaa nestelasin varavaihtoehdon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memberi warna pada bilah status agar sesuai dan mengatur penggantian Liquid Glass."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tô màu thanh trạng thái cho phù hợp và đặt dự phòng cho Liquid Glass."
          }
        }
      }
    },
    "Tired of “Allow Paste?”": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Moeg vir \"Laat plak toe?\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genug von „Einsetzen erlauben“?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cansado de «Permitir pegar»?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüdinud „Luba kleepimine?”-st"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marre de « Autoriser le collage » ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleged van a „Beillesztés engedélyezése” kérdésből?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stufo di «Consenti incolla»?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ペーストを許可」にうんざり？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘붙여넣기 허용’이 지겨우신가요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penat dengan “Benarkan Tampal”?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Farto de «Permitir colar»?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надоело «Разрешить вставку?»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不想再看到“允许粘贴”？"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "V-ați săturat de „Permiteți lipirea?”"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ben je het “Plakken toestaan?” beu?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不想再看到“允許貼上”？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz dość opcji „Zezwalaj na wklejanie?”"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Набридло «Дозволити вставлення?»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Yapıştırmaya İzin Ver\" seçeneğinden bıktınız mı?"
          }
        },
        "cs": {
          "stringUnit": {
