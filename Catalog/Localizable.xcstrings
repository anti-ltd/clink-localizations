            "state": "translated",
            "value": "Mengalih keluar semua tema tersuai dan foto latarnya secara kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove permanentemente todos os temas personalizados e as respetivas fotos de fundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратно удаляет все пользовательские темы и их фоновые фотографии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将永久移除所有自定主题及其背景照片。"
          }
        }
      }
    },
    "Permanently removes every installed plugin, what it remembered, and any control it was driving.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt dauerhaft jedes installierte Plugin, was es sich gemerkt hat und jedes Bedienelement, das es gesteuert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina de forma permanente todos los plugins instalados, lo que recordaban y cualquier control que estuvieran manejando."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemaldab jäädavalt iga paigaldatud pistikprogrammi, selle meelespeetu ja iga juhtelemendi, mida see juhtis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement chaque plugin installé, ce qu'il avait mémorisé et toute commande qu'il pilotait."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Véglegesen eltávolít minden telepített bővítményt, amit megjegyzett, és minden vezérlőt, amelyet irányított."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove definitivamente ogni plugin installato, ciò che ricordava e qualsiasi controllo che stava guidando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのプラグインすべてと、その記憶していた内容、動かしていたコントロールを完全に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 모든 플러그인과 플러그인이 기억하던 내용, 제어하던 컨트롤을 영구히 제거합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuang secara kekal setiap plugin yang dipasang, apa yang diingatinya, dan sebarang kawalan yang dikendalikannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove permanentemente todos os plugins instalados, o que cada um recordava e qualquer controlo que estivesse a conduzir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Навсегда удаляет все установленные плагины, то, что они запомнили, и все элементы, которыми они управляли."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久移除所有已安装的插件、它们记住的内容，以及它们正在驱动的控件。"
          }
        }
      }
    },
