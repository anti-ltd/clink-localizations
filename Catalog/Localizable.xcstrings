    "e.g. Correctly punctuate and formalize what I say": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "bv. Teken en formaliseer wat ek sê korrek"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Setz meine Zeichensetzung richtig und formuliere es förmlicher"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej. Puntúa bien lo que digo y hazlo más formal"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "nt. Pane kirjavahemärgid õigesti ja tee ametlikumaks see, mida ütlen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ex. Ponctue correctement ce que je dis et rends-le plus formel"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "pl. Tedd helyesen a központozást, és fogalmazd hivatalosabbra"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "es. Punteggia bene quello che dico e rendilo più formale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：話した内容に正しく句読点をつけて、丁寧な表現にして"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 내가 말한 내용에 문장부호를 제대로 넣고 격식 있게 다듬어 줘"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "cth. Letak tanda baca yang betul dan jadikan lebih formal"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "ex. Pontua bem o que digo e torna-o mais formal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "например: расставить знаки препинания и сделать сказанное официальным"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：把我说的正确加上标点，并写得更正式"
          }
        }
      }
    },
