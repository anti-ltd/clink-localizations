    "Open Cling once so it can share what you've saved.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak Cling een keer oop sodat dit kan deel wat jy gestoor het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Cling einmal, damit es teilen kann, was du gespeichert hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Cling una vez para que pueda compartir lo que has guardado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava Cling üks kord, et see saaks jagada seda, mida salvestasid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Cling une fois pour qu’il puisse partager ce que tu as enregistré."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg egyszer a Clinget, hogy megoszthassa, amit elmentettél."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Cling una volta perché possa condividere quello che hai salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したものを共有できるよう、Cling を一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 것을 공유할 수 있도록 Cling을 한 번 열어 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Cling sekali supaya ia boleh berkongsi simpanan anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Cling uma vez para que possa partilhar o que guardou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Cling один раз, чтобы он поделился сохранённым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开一次 Cling，它才能共享你保存的内容。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți Cling o dată pentru a putea partaja ceea ce ați salvat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Cling één keer zodat het kan delen wat je hebt opgeslagen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟一次 Cling，它才能共享你儲存的內容。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz raz Cling, aby mógł udostępnić zapisane dane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Cling один раз, щоб він міг поділитися тим, що ви зберегли."
          }
        },
        "tr": {
