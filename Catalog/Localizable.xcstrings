    "The vector country flags on the language key and across the app.": {
      "comment": "Android-only copy for the companion app (batch B3: FAQ, Home, Tools mode, Feedback), replacing iOS settings paths and services. Translations drafted for the Android port; native-speaker review required before release. Add to clink-index.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vektor-landsvlae op die taalsleutel en regdeur die app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vektorové vlajky zemí na klávese jazyka a v celé aplikaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vektorflagene for lande på sprogtasten og i hele appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vektor-Länderflaggen auf der Sprachtaste und in der ganzen App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι διανυσματικές σημαίες χωρών στο πλήκτρο γλώσσας και σε όλη την εφαρμογή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las banderas vectoriales de países en la tecla de idioma y en toda la app."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vektorkujul riigilipud keeleklahvil ja kogu rakenduses."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vektorimuotoiset maaliput kielinäppäimessä ja kaikkialla sovelluksessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les drapeaux vectoriels des pays sur la touche de langue et dans toute l'app."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vektoros országzászlók a nyelvgombon és az egész appban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bendera negara vektor pada tombol bahasa dan di seluruh aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bandiere vettoriali dei paesi sul tasto della lingua e in tutta l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語キーやアプリ全体で使われているベクター形式の国旗。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 키와 앱 곳곳에 쓰이는 벡터 국기."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bendera negara vektor pada kekunci bahasa dan di seluruh app."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vektorflaggene for land på språktasten og i hele appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vectorvlaggen van landen op de taaltoets en in de hele app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wektorowe flagi krajów na klawiszu języka i w całej aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As bandeiras vetoriais dos países na tecla de idioma e em toda a app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Steagurile vectoriale ale țărilor de pe tasta de limbă și din toată aplicația."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Векторные флаги стран на клавише языка и по всему приложению."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vektorové vlajky krajín na klávese jazyka a v celej aplikácii."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vektorflaggorna för länder på språktangenten och i hela appen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil tuşundaki ve uygulamanın her yerindeki vektör ülke bayrakları."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Векторні прапори країн на клавіші мови та в усьому застосунку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cờ quốc gia dạng vector trên phím ngôn ngữ và khắp ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言键和整个 App 里用到的矢量国旗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語言鍵及整個 App 中使用的向量國旗。"
          }
        }
      }
    },
