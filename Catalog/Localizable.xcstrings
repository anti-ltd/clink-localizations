    "Layers that move the color travel through these, in order. Hold a color to remove it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebenen, die die Farbe bewegen, laufen der Reihe nach durch diese Farben. Halte eine Farbe gedrückt, um sie zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capas que mueven el color recorren estos colores en orden. Mantén pulsado un color para quitarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Värvi liigutavad kihid läbivad need järjest. Hoia värvi all, et see eemaldada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les calques qui font varier la couleur parcourent celles-ci dans l’ordre. Maintiens une couleur pour la retirer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A színt mozgató rétegek sorban végighaladnak ezeken. Tartsd lenyomva a színt az eltávolításhoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I livelli che muovono il colore scorrono questi colori in ordine. Tieni premuto un colore per rimuoverlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色を動かすレイヤーはこれらの色を順番に巡ります。色を長押しすると削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상을 움직이는 레이어는 이 색상들을 순서대로 지나갑니다. 색상을 길게 눌러 제거하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapisan yang menggerakkan warna melalui warna-warna ini mengikut urutan. Tahan warna untuk membuangnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As camadas que movem a cor percorrem estas cores por ordem. Mantenha premida uma cor para a remover."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слои, меняющие цвет, проходят эти цвета по порядку. Удерживайте цвет, чтобы удалить его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改变颜色的图层会依次经过这些颜色。长按某个颜色可将其移除。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Straturile care mișcă culoarea călătoresc prin acestea, în ordine. Țineți o culoare pentru a o îndepărta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagen die de kleur verplaatsen, reizen hier in volgorde doorheen. Houd een kleur vast om deze te verwijderen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改變顏色的圖層會依次經過這些顏色。長按某個顏色可將其移除。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lae wat die kleur beweeg; die kleur beweeg in volgorde daardeur. Hou 'n kleur in om dit te verwyder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warstwy przesuwające kolor przechodzą przez nie w określonej kolejności. Przytrzymaj kolor, aby go usunąć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шари, які переміщують колір, проходять через них по порядку. Утримуйте колір, щоб видалити його."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rengi hareket ettiren katmanlar bunların içinden sırayla geçer. Kaldırmak için bir rengi basılı tutun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrstvy, které pohybují barvou, jimi procházejí v pořadí. Chcete-li barvu odstranit, podržte ji."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrstvy, ktoré posúvajú farbu, cez ne prechádzajú v poradí. Podržaním farby ju odstránite."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα στρώματα που μετακινούν το χρώμα ταξιδεύουν μέσα από αυτά, με τη σειρά. Κρατήστε ένα χρώμα για να το αφαιρέσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lager som flyttar färgen går genom dessa, i ordning. Håll en färg för att ta bort den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lag, der flytter farven, rejser gennem disse i rækkefølge. Hold en farve for at fjerne den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lag som beveger fargen går gjennom disse, i rekkefølge. Hold en farge for å fjerne den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Väriä liikuttavat kerrokset kulkevat näiden läpi järjestyksessä. Pidä väriä poistaaksesi sen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapisan yang menggerakkan warna melewatinya secara berurutan. Pegang warna untuk menghilangkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lớp di chuyển màu sẽ di chuyển qua các lớp này theo thứ tự. Giữ một màu để loại bỏ nó."
          }
        }
      }
    },
