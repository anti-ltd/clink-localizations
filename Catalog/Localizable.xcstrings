            "value": "Trageți butonul în sus sau la dreapta pentru a-l ridica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de knop omhoog of naar rechts om deze hoger te zetten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向上或向右拖動旋鈕即可調高。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep die knop op of regs om dit op te draai."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij pokrętło w górę lub w prawo, aby je zwiększyć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть ручку вгору або вправо, щоб збільшити її."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi açmak için düğmeyi yukarı veya sağa sürükleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetažením knoflíku nahoru nebo doprava jej otočte nahoru."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnutím gombíka nahor alebo doprava ho otočíte nahor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε το κουμπί προς τα πάνω ή προς τα δεξιά για να το ενεργοποιήσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra ratten uppåt eller åt höger för att vrida upp den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk knappen op eller til højre for at skrue op."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra knappen opp eller til høyre for å skru den opp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä nuppia ylös tai oikealle kääntääksesi se ylös."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret kenop ke atas atau ke kanan untuk menaikkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo núm lên hoặc sang phải để bật lên."
          }
        }
      }
    },
    "Drag the padding handles on the preview to set how much room the keyboard takes.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die Abstandsgriffe in der Vorschau, um festzulegen, wie viel Platz die Tastatur einnimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los tiradores de los márgenes en la vista previa para ajustar cuánto espacio ocupa el teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista eelvaates veeriste pidemeid, et määrata, kui palju ruumi klaviatuur võtab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser les poignées des marges dans l’aperçu pour régler la place occupée par le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előnézet térközállító fogantyúival beállíthatod, mekkora helyet foglaljon a billentyűzet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le maniglie dei margini nell’anteprima per regolare lo spazio occupato dalla tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューの余白ハンドルをドラッグして、キーボードが占める範囲を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 보기의 여백 조절점을 드래그해 키보드가 차지하는 공간을 조절하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret pemegang jarak tepi pada pratonton untuk menetapkan ruang yang digunakan oleh papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta as pegas das margens na pré-visualização para ajustar o espaço ocupado pelo teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте маркеры отступов на предпросмотре, чтобы настроить, сколько места занимает клавиатура."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动预览中的边距控制点，调整键盘占用的空间。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trageți mânerele de umplutură pe previzualizare pentru a seta cât spațiu ocupă tastatura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versleep de opvulgrepen in het voorbeeld om in te stellen hoeveel ruimte het toetsenbord in beslag neemt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動預覽中的邊距控制點，調整鍵盤佔用的空間。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
