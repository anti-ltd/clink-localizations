    "Swipe works fully offline. The first letter shows right away, then gets replaced by the full word once the glide is read.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiep werk ten volle vanlyn. Die eerste letter wys dadelik en word dan vervang deur die volle woord sodra die gly gelees is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wischen funktioniert komplett offline. Der erste Buchstabe erscheint sofort und wird dann durch das ganze Wort ersetzt, sobald die Bewegung gelesen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El deslizamiento funciona del todo sin conexión. La primera letra aparece enseguida y luego la reemplaza la palabra completa en cuanto se lee el trazo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pühkimine töötab täielikult ühenduseta. Esimene tähe ilmub kohe ja asendatakse seejärel tervelt sõnaga, kui liug on loetud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le balayage marche entièrement hors ligne. La première lettre s'affiche tout de suite, puis elle est remplacée par le mot complet une fois le tracé lu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A húzás teljesen offline működik. Az első betű azonnal megjelenik, majd a húzás beolvasása után lecserélődik a teljes szóra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scorrimento funziona del tutto offline. La prima lettera compare subito, poi viene sostituita dalla parola completa una volta letto lo scorrimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプは完全にオフラインで動きます。最初の文字がすぐに表示され、なぞりを読み取ると単語全体に置き換わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스와이프는 완전히 오프라인으로 돼요. 첫 글자가 바로 나오고, 궤적을 다 읽으면 완전한 단어로 바뀌어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret berfungsi sepenuhnya luar talian. Huruf pertama muncul serta-merta, kemudian diganti dengan perkataan penuh sebaik luncuran dibaca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O deslize funciona totalmente offline. A primeira letra aparece logo e depois é substituída pela palavra completa assim que o traço é lido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скольжение работает полностью офлайн. Первая буква появляется сразу, а потом заменяется целым словом, когда движение прочитано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动完全离线工作。首字母立刻显示，等看完滑动轨迹，再换成完整的词。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisarea funcționează complet offline. Prima literă este afișată imediat, apoi este înlocuită cu cuvântul complet odată ce glisarea este citită."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe werkt volledig offline. De eerste letter wordt meteen weergegeven en wordt vervolgens vervangen door het volledige woord zodra de glide is gelezen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑動完全離線工作。首字母立刻顯示，等看完滑動軌跡，再換成完整的詞。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe działa w pełni offline. Pierwsza litera pojawia się od razu, a po przeczytaniu poślizgu zostaje zastąpiona pełnym słowem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe працює повністю в автономному режимі. Перша літера відображається відразу, а потім її замінює повне слово, коли прочитано слайд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırma tamamen çevrimdışı çalışır. İlk harf hemen gösterilir, ardından kaydırma okunduğunda yerini tam kelime alır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejetí funguje plně offline. První písmeno se zobrazí okamžitě, poté je po přečtení klouzání nahrazeno celým slovem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe funguje plne offline. Prvé písmeno sa zobrazí ihneď, potom sa po prečítaní klzu nahradí celým slovom."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σάρωση λειτουργεί πλήρως εκτός σύνδεσης. Το πρώτο γράμμα εμφανίζεται αμέσως και μετά αντικαθίσταται από την πλήρη λέξη μόλις διαβαστεί η ολίσθηση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep fungerar helt offline. Den första bokstaven visas direkt och ersätts sedan av hela ordet när glidningen har lästs."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe fungerer fuldt ud offline. Det første bogstav vises med det samme, og bliver derefter erstattet af det fulde ord, når glidningen er læst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip fungerer helt offline. Den første bokstaven vises med en gang, og blir deretter erstattet av hele ordet når glidningen er lest."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhkäisy toimii täysin offline-tilassa. Ensimmäinen kirjain näkyy heti, sitten se korvataan koko sanalla, kun liuku on luettu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesek berfungsi sepenuhnya offline. Huruf pertama langsung muncul, lalu diganti dengan kata lengkap setelah luncurannya terbaca."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt hoạt động hoàn toàn ngoại tuyến. Chữ cái đầu tiên hiển thị ngay lập tức, sau đó được thay thế bằng từ đầy đủ sau khi đọc lướt."
          }
        }
      }
    },
