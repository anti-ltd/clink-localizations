    "Renews yearly. Cancel anytime.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich jährlich. Jederzeit kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva cada año. Cancela cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvelé chaque année. Annulable à tout moment."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Évente megújul. Bármikor lemondhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova ogni anno. Annulla quando vuoi."
