    "While you drag the cursor, tap anywhere with another finger to start highlighting.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Terwyl jy die wyser sleep, tik enige plek met 'n ander vinger om te begin uitlig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während du den Cursor ziehst, tippe mit einem anderen Finger irgendwo hin, um zu markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras arrastras el cursor, toca en cualquier parte con otro dedo para empezar a marcar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui sa kursorit lohistad, puuduta teise sõrmega kuskil, et alustada esiletõstmist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant que tu déplaces le curseur, touche l’écran avec un autre doigt pour commencer à sélectionner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amíg a kurzort húzod, koppints máshova a másik ujjaddal, és onnan jelöl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre trascini il cursore, tocca ovunque con un altro dito per iniziare a selezionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルをドラッグ中に、もう一方の指でキーボードをタップすると選択が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서를 끄는 동안 다른 손가락으로 아무 곳이나 탭하면 선택을 시작합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semasa anda seret kursor, ketik di mana-mana dengan jari lain untuk mula menonjolkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto arrastas o cursor, toca em qualquer lado com outro dedo para começar a destacar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивая курсор, коснитесь в любом месте другим пальцем, чтобы начать выделение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动光标时，用另一根手指点按键盘任意处即可开始选中。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În timp ce trageți cursorul, atingeți oriunde cu un alt deget pentru a începe evidențierea."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terwijl u de cursor sleept, tikt u met een andere vinger ergens om te beginnen met markeren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動游標時，用另一根手指點按鍵盤任意處即可開始選中。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas przeciągania kursora dotknij dowolnego miejsca innym palcem, aby rozpocząć wyróżnianie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки ви перетягуєте курсор, торкніться будь-де іншим пальцем, щоб почати виділення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmleci sürüklerken, vurgulamaya başlamak için başka bir parmağınızla herhangi bir yere dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při tažení kurzoru začněte zvýrazňovat klepnutím kamkoli jiným prstem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počas ťahania kurzora klepnite na ľubovoľné miesto iným prstom, aby ste začali zvýrazňovať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενώ σύρετε τον κέρσορα, πατήστε οπουδήποτε με ένα άλλο δάχτυλο για να ξεκινήσετε την επισήμανση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Medan du drar markören, tryck var som helst med ett annat finger för att börja markera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mens du trækker markøren, skal du trykke hvor som helst med en anden finger for at begynde at fremhæve."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mens du drar markøren, trykk hvor som helst med en annen finger for å begynne å utheve."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun vedät kohdistinta, aloita korostaminen napauttamalla mitä tahansa toisella sormella."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Anda menyeret kursor, ketuk di mana saja dengan jari lainnya untuk mulai menyorot."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong khi bạn kéo con trỏ, hãy nhấn vào bất kỳ đâu bằng ngón tay khác để bắt đầu đánh dấu."
          }
        }
      }
    },
