            "value": "Båda hastigheterna är i Gester, under Key repeat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge hastigheder er i Bevægelser, under Tastegentagelse."
          }
        },
        "nb": {
