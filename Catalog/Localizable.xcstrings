        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI đang bật nhưng các đề xuất Ngoại tuyến của %@ vẫn tiếp tục như bình thường."
          }
        }
      }
    },
    "AI is on, but %@ You won't see AI suggestions, corrections, or translation until that's sorted. Your offline suggestions carry on as normal.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "KI is aan, maar %@ Jy sal nie KI-voorstelle, regstellings of vertaling sien voordat dit gesorteer is nie. Jou vanlyn voorstelle gaan voort soos gewoonlik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI ist an, aber %@ Du bekommst keine KI-Vorschläge, -Korrekturen oder Übersetzungen, bis das erledigt ist. Deine Offline-Vorschläge laufen ganz normal weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA está activada, pero %@ No verás sugerencias, correcciones ni traducción de la IA hasta que lo arregles. Tus sugerencias sin conexión siguen funcionando con normalidad."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "TI on sees, aga %@ Sa ei näe TI-soovitusi, -parandusi ega -tõlget enne, kui see on korda seatud. Sinu ühenduseta soovitused töötavad nagu tavaliselt edasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA est activée, mais %@ Tu ne verras pas de suggestions, corrections ou traductions par IA tant que ce n'est pas réglé. Tes suggestions hors ligne continuent normalement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AI be van kapcsolva, de %@ Nem fogsz AI-javaslatokat, javításokat vagy fordítást látni, amíg ez nincs elrendezve. Az offline javaslataid a szokásos módon mennek tovább."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA è attiva, ma %@ Non vedrai suggerimenti, correzioni o traduzioni IA finché non lo risolvi. I tuoi suggerimenti offline vanno avanti come sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIはオンですが、%@ これが解決するまで、AIの候補や修正、翻訳は表示されません。オフラインの候補はこれまでどおり使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI는 켜져 있는데, %@ 그게 해결될 때까지 AI 제안이나 수정, 번역은 안 보여요. 오프라인 제안은 평소대로 계속돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "AI dihidupkan, tapi %@ Anda takkan nampak cadangan, pembetulan, atau terjemahan AI sampai itu selesai. Cadangan luar talian anda jalan macam biasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA está ligada, mas %@ Não vais ver sugestões, correções ou tradução da IA até resolveres isso. As tuas sugestões offline continuam na mesma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ включён, но %@ Пока это не исправлено, подсказок, исправлений и перевода от ИИ не будет. Офлайн-подсказки работают как всегда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 开着，不过 %@ 这个弄好之前，你看不到 AI 建议、更正或翻译。离线建议照常给你。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "AI este activat, dar %@ Nu veți vedea sugestii, corecții sau traduceri AI până când nu sunt sortate. Sugestiile dvs. offline continuă ca de obicei."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI staat aan, maar %@ Je ziet geen AI-suggesties, correcties of vertalingen totdat dat is opgelost. Uw offline suggesties gaan gewoon door."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 開著，不過 %@ 這個弄好之前，你看不到 AI 建議、更正或翻譯。離線建議照常給你。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sztuczna inteligencja jest włączona, ale %@ Nie zobaczysz sugestii, poprawek ani tłumaczeń AI, dopóki nie zostanie to posortowane. Twoje sugestie offline będą działać normalnie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AI увімкнено, але %@ Ви не побачите пропозиції AI, виправлення чи переклад, доки це не буде відсортовано. Ваші офлайн-пропозиції працюють у звичному режимі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI açık ancak %@ Sıralanana kadar AI önerilerini, düzeltmelerini veya çevirilerini görmezsiniz. Çevrimdışı önerileriniz normal şekilde devam ediyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umělá inteligence je zapnutá, ale %@ Neuvidíte návrhy, opravy ani překlad, dokud to nevyřešíte. Vaše návrhy offline pokračují jako obvykle."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umelá inteligencia je zapnutá, ale %@ Neuvidíte návrhy, opravy ani preklad, kým to nevyriešite. Vaše návrhy offline pokračujú ako zvyčajne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τεχνητή νοημοσύνη είναι ενεργοποιημένη, αλλά το %@ Δεν θα δείτε προτάσεις, διορθώσεις ή μετάφραση τεχνητής νοημοσύνης μέχρι να τακτοποιηθεί. Οι προτάσεις σας εκτός σύνδεσης συνεχίζονται κανονικά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AI är på, men %@ Du kommer inte att se AI-förslag, korrigeringar eller översättning förrän det är sorterat. Dina offlineförslag fortsätter som vanligt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI er tændt, men %@ Du vil ikke se AI-forslag, rettelser eller oversættelse, før det er sorteret. Dine offline forslag fortsætter som normalt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI er på, men %@ Du vil ikke se AI-forslag, rettelser eller oversettelse før det er sortert. Forslagene dine uten nett fortsetter som normalt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoäly on päällä, mutta %@ Et näe tekoälyehdotuksia, korjauksia tai käännöksiä, ennen kuin ne on järjestetty. Offline-ehdotuksesi jatkuvat normaalisti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AI aktif, tetapi %@ Anda tidak akan melihat saran, koreksi, atau terjemahan AI sampai semuanya selesai. Saran offline Anda berjalan seperti biasa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI đang bật nhưng %@ Bạn sẽ không thấy các đề xuất, chỉnh sửa hoặc dịch thuật của AI cho đến khi nội dung đó được sắp xếp. Đề xuất ngoại tuyến của bạn vẫn tiếp tục như bình thường."
          }
        }
      }
    },
