        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "淡淡一条线，上面有星星在闪。"
          }
        }
      }
    },
    "A flat knob that turns as the menu opens.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mando plano que gira al abrir el menú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une molette plate qui tourne à l’ouverture du menu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein flacher Drehregler, der sich beim Öffnen des Menüs dreht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una manopola piatta che ruota all’apertura del menu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um botão plano que roda ao abrir o menu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плоская ручка, которая поворачивается при открытии меню."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol rata yang berputar apabila menu dibuka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapos tekerő, amely a menü megnyitásakor elfordul."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューを開くと回転するフラットなノブです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开菜单时会旋转的扁平旋钮。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴를 열면 회전하는 평평한 노브입니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lame pöördnupp, mis pöördub menüü avamisel."
          }
        }
      }
    },
    "A full key tall, 20pt digits. The strip becomes a proper row.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Vol sleutel hoog, 20pt syfers. Die strook word 'n behoorlike ry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So hoch wie eine ganze Taste, Ziffern in 20 pt. Aus dem Streifen wird eine richtige Reihe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tan alta como una tecla, dígitos de 20 pt. La tira se convierte en una fila de verdad."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Terve klahvi kõrgune, 20 pt numbrid. Ribast saab korralik rida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aussi haute qu'une touche, chiffres en 20 pt. La bande devient une vraie rangée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Teljes billentyűmagasság, 20 pt-os számjegyek. A sáv igazi sorrá válik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alta quanto un tasto, cifre da 20 pt. La striscia diventa una riga vera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーと同じ高さ、数字は20pt。細い帯ではなく1行分の列になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키와 같은 높이, 숫자는 20pt입니다. 얇은 띠가 아니라 온전한 한 줄이 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setinggi satu kekunci penuh, digit 20 pt. Jalur ini menjadi baris penuh."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Da altura de uma tecla, dígitos de 20 pt. A faixa passa a ser uma linha a sério."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во всю высоту клавиши, цифры 20pt. Полоса становится полноценным рядом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与按键等高，数字 20pt。这条数字带变成真正的一行。"
          }
        }
      }
    },
    "A glowing line with a bright, even core.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Gloeiende lyn met 'n helder, egalige kern."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine leuchtende Linie mit einem hellen, gleichmäßigen Kern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea brillante con un núcleo luminoso y uniforme."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Särav joon heleda, ühtlase tuumaga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trait lumineux avec un cœur brillant et régulier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fénylő vonal, ragyogó, egyenletes maggal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una linea luminosa con un nucleo brillante e uniforme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るく均一な輝きを放つ芯を持つ線。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밝고 균일한 코어를 가진 빛나는 선."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Garis bercahaya dengan teras yang terang dan sekata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha brilhante com um núcleo luminoso e uniforme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светящаяся линия с яркой ровной сердцевиной."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一条发光线条，中心明亮均匀。"
          }
        }
      }
    },
    "A gradient fills behind the keys, refracted through the glass.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Gradiënt vul agter die sleutels, gebreek deur die glas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinter den Tasten liegt ein Farbverlauf, gebrochen durch das Glas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un degradado llena el fondo de las teclas, refractado por el cristal."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvide taga täidab üleminek, mis murdub läbi klaasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dégradé remplit l'arrière des touches, réfracté à travers le verre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk mögött színátmenet húzódik, az üvegen megtörve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gradiente riempie lo sfondo dei tasti, rifratto dal vetro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラデーションがキーの後ろに広がり、ガラス越しに屈折します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 뒤로 그라데이션이 깔리고, 유리를 지나면서 굴절돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradien mengisi belakang kekunci, dibiaskan melalui kaca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um gradiente enche o fundo das teclas, refratado pelo vidro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За клавишами разливается градиент, преломлённый стеклом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "渐变在按键后面铺开，透过玻璃折射出来。"
          }
        }
      }
    },
    "A gradient fills the keyboard behind the keys, overriding the color.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Gradiënt vul die sleutelbord agter die sleutels, wat die kleur oorheers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Farbverlauf füllt die Tastatur hinter den Tasten und überschreibt die Farbe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un degradado llena el teclado detrás de las teclas y reemplaza el color."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üleminek täidab klaviatuuri klahvide taga ja asendab värvi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dégradé remplit le clavier derrière les touches et remplace la couleur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk mögött színátmenet tölti ki a billentyűzetet, felülírva a színt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gradiente riempie la tastiera dietro i tasti e sostituisce il colore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラデーションがキーの後ろのキーボードを覆い、色を上書きします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 뒤 키보드를 그라데이션이 채우면서 색을 덮어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradien mengisi papan kekunci di belakang kekunci, dan mengatasi warna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um gradiente enche o teclado por trás das teclas e substitui a cor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Градиент заливает клавиатуру за клавишами и заменяет цвет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "渐变铺满按键后面的键盘，盖过颜色。"
          }
        }
      }
    },
