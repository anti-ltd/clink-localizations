          }
        }
      }
    },
    "Show a small glyph on each key previewing its first long-press alternate.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt auf jeder Taste ein kleines Zeichen, das die erste Alternative beim langen Drücken vorschaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un pequeño glifo en cada tecla con su primera alternativa de pulsación larga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un petit symbole sur chaque touche pour prévisualiser sa première alternative en appui long."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kis jelet mutat minden gombon, ami előre megmutatja az első hosszan nyomott változatát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra su ogni tasto un piccolo simbolo che anticipa la prima alternativa della pressione prolungata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーに、長押しで出てくる最初の代替文字を小さく表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 눌렀을 때 나오는 첫 번째 대체 문자를 키마다 작게 미리 보여줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjuk glif kecil pada setiap kekunci untuk pratonton alternatif tekan lama pertamanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra um pequeno glifo em cada tecla com a primeira alternativa de toque prolongado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать на клавише маленький значок с её первым вариантом из долгого нажатия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每个按键上显示一个小字符，预览长按后的第一个备选。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
