    "Suggestions and translate assist use Apple's model when it's available.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voorstelle en vertaalhulp gebruik Apple se model wanneer dit beskikbaar is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge und Übersetzungshilfe nutzen Apples Modell, wenn es verfügbar ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias y la ayuda para traducir usan el modelo de Apple cuando está disponible."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soovitused ja tõlgiabi kasutavad Apple’i mudelit, kui see on saadaval."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suggestions et l'aide à la traduction utilisent le modèle d'Apple quand il est dispo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A javaslatok és a fordítási segítség az Apple modelljét használja, ha épp elérhető."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suggerimenti e l'aiuto alla traduzione usano il modello di Apple quando è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提案と翻訳アシストは、使えるときは Apple のモデルを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안과 번역 도움은 쓸 수 있을 때 Apple 모델을 써요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan dan bantuan terjemah guna model Apple apabila ia tersedia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As sugestões e a ajuda a traduzir usam o modelo da Apple quando está disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
