    "Render key popups as glass on Liquid Glass themes.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gee sleutel-opspringers as glas op Liquid Glass-temas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Tasten-Pop-ups bei Liquid Glass-Designs als Glas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las ventanas de teclas como cristal en los temas Liquid Glass."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvab klahvihüpikud Liquid Glass teemadel klaasina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les pop-ups de touches en verre sur les thèmes Liquid Glass."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gombok előugró ablakait üvegként jeleníti meg a Liquid Glass témáknál."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i pop-up dei tasti come vetro nei temi Liquid Glass."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glassテーマでは、キーのポップアップをガラス調で表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass 테마에서는 키 팝업을 유리처럼 보여줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papar pop timbul kekunci sebagai kaca pada tema Liquid Glass."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra os pop-ups das teclas em vidro nos temas Liquid Glass."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисовать всплывающие клавиши стеклянными в темах Liquid Glass."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Liquid Glass 主题下，把按键弹窗做成玻璃效果。"
          }
        }
      }
    },
