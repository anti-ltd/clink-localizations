          }
        }
      }
    },
    "Curl straight quotes (“'” → ’, “\"” → “”). Turn off for languages that need straight apostrophes.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Krul reguit aanhalingstekens (“'” → ’, “”” → “”). Skakel af vir tale wat reguit apostrof benodig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandelt gerade Anführungszeichen in typografische um (“'” → ’, “\"” → “”). Schalt es für Sprachen aus, die gerade Apostrophe brauchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte las comillas rectas (“'” → ’, “\"” → “”). Desactívalo para los idiomas que necesitan apóstrofos rectos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muundab sirged ülakoma- ja jutumärgid tüpograafilisteks (' → ’, \" → “”). Lülita välja keelte jaoks, mis vajavad sirgeid ülakomasid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme les guillemets droits (« ' » → ’, « \" » → « »). Désactive-le pour les langues qui ont besoin d'apostrophes droites."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megformálja az egyenes idézőjeleket („'” → ’, „\"” → „”). Kapcsold ki azoknál a nyelveknél, amelyeknek egyenes aposztróf kell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrotonda le virgolette dritte (“'” → ’, “\"” → “”). Disattivalo per le lingue che hanno bisogno di apostrofi dritti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まっすぐな引用符を丸めます（“'” → ’、“\"” → “”）。まっすぐなアポストロフィが必要な言語ではオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곧은 따옴표를 둥글게 바꿔요 (“'” → ’, “\"” → “”). 곧은 아포스트로피가 필요한 언어에서는 꺼주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengkukkan tanda kutip lurus (“'” → ’, “\"” → “”). Matikan untuk bahasa yang perlukan tanda kutip lurus."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva as aspas retas (“'” → ’, “\"” → “”). Desliga para idiomas que precisam de apóstrofos retos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменять прямые кавычки на типографские (“'” → ’, “\"” → “”). Выключите для языков, где нужны прямые апострофы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把直引号弯化（“'” → ’，“\"” → “”）。需要直撇号的语言请关掉。"
          }
        }
      }
    },
