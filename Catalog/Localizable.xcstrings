    "Scroll down the page to the cards with a dashed outline, and tap one.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Rollees op die bladsy af na die kaarte met 'n stippellyn, en tik op een."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll auf der Seite nach unten zu den Karten mit gestricheltem Rand und tippe eine an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja por la página hasta las tarjetas de contorno discontinuo y toca una."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Keri lehel alla kaartideni katkendjoonelise äärisega ja puuduta üht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Descends la page jusqu'aux cartes au contour en pointillés et touches-en une."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Görgess lejjebb a szaggatott keretű kártyákig, és koppints az egyikre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri la pagina fino alle schede con il bordo tratteggiato e toccane una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページを下にスクロールし、破線の枠のカードをタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지를 내려 점선 테두리 카드까지 간 다음, 하나를 누르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatal ke bawah halaman sehingga kad bergaris putus, dan ketik satu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desce a página até aos cartões de contorno tracejado e toca num."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутите страницу до карточек с пунктирной рамкой и нажмите на любую."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "往下滚到有虚线边框的卡片，点一下。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Derulați în jos în pagină până la cardurile cu un contur întrerupt și atingeți unul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blader omlaag op de pagina naar de kaarten met een stippellijn en tik erop."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "往下滾到有虛線邊框的卡片，點一下。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przewiń stronę w dół do kart z przerywanym konturem i dotknij jednej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутіть сторінку вниз до карток із пунктирним контуром і торкніться однієї."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfayı kesik çizgili kartlara doğru kaydırın ve bir tanesine dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuňte stránku dolů ke kartám s přerušovaným obrysem a klepněte na jednu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuňte stránku nadol na karty s prerušovaným obrysom a klepnite na jednu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κύλιση προς τα κάτω στη σελίδα στις κάρτες με διακεκομμένο περίγραμμα και πατήστε μία."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulla ner på sidan till korten med en streckad kontur och tryck på ett."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rul ned på siden til kortene med en stiplet omrids, og tryk på et."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rull nedover siden til kortene med en stiplet omriss, og trykk på ett."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vieritä sivua alaspäin katkoviivapiirrettyihin kortteihin ja napauta yhtä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gulir ke bawah halaman ke kartu dengan garis putus-putus, lalu ketuk salah satu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộn trang xuống các thẻ có đường viền nét đứt và nhấn vào một thẻ."
          }
        }
      }
    },
