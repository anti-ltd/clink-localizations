    "Blue into cyan, ending in white.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blou in siaan, eindig in wit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Blau über Cyan zu Weiß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De azul a cian, terminando en blanco."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinisest tsüaani, lõpeb valgena."
          }
        },
        "fr": {
