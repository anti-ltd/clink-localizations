        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ei ole vielä näyttönäppäimistöjen luettelossasi. Vaihe 1 kestää noin kaksikymmentä sekuntia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink n’est pas encore dans ta liste de claviers à l’écran. L’étape 1 prend environ vingt secondes."
