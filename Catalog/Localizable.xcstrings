        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv dine egne tastaturhandlinger i Python. Aktiverede handlinger vises bag tastaturets handlingsknap. Tryk på en handling for at redigere den, træk for at omarrangere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv dine egne tastaturhandlinger i Python. Aktiverte handlinger vises bak tastaturets handlingsknapp. Trykk på en handling for å redigere den, dra for å endre rekkefølgen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita omat näppäimistötoiminnot Pythonissa. Käytössä olevat toiminnot näkyvät näppäimistön toimintopainikkeen takana. Muokkaa toimintoa napauttamalla sitä ja järjestä uudelleen vetämällä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis tindakan keyboard Anda sendiri dengan Python. Tindakan yang diaktifkan muncul di belakang tombol tindakan keyboard. Ketuk tindakan untuk mengeditnya, seret untuk menyusun ulang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết các thao tác bàn phím của riêng bạn bằng Python. Các hành động được kích hoạt sẽ xuất hiện phía sau nút hành động của bàn phím. Nhấn vào một hành động để chỉnh sửa, kéo để sắp xếp lại."
          }
        }
