    "Type a few words, then open AI to rewrite, proofread, or change the tone.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik 'n paar woorde en maak dan KI oop om te herskryf, proeflees of die toon te verander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp ein paar Wörter, dann öffne die KI, um sie umzuschreiben, zu prüfen oder den Ton zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe unas palabras y abre la IA para reescribir, corregir o cambiar el tono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipi mõned sõnad ja ava TI, et ümber kirjutada, üle lugeda või tooni muuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tape quelques mots, puis ouvre l'IA pour réécrire, relire ou changer le ton."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írj be pár szót, aztán nyisd meg az MI-t átíráshoz, lektoráláshoz vagy a hangnem módosításához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi qualche parola, poi apri l'IA per riscrivere, correggere o cambiare tono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何か少し打ってから AI を開くと、書き直し、校正、トーン変更ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 마디 입력한 다음 AI를 열어서 다시 쓰거나, 교정하거나, 말투를 바꿔보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip beberapa perkataan, kemudian buka AI untuk tulis semula, semak atau tukar nada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve umas palavras e abre a IA para reescrever, rever ou mudar o tom."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напечатайте несколько слов, а затем откройте ИИ, чтобы переписать текст, проверить его или сменить тон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先打几个字，再打开 AI 来改写、校对或换个语气。"
          }
        }
      }
    },
