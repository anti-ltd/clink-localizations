    "Quicker and busier, in smaller pieces.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinniger en besiger, in kleiner stukke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schneller und dichter, in kleineren Teilchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más rápido y con más movimiento, en piezas más pequeñas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiirem ja tihedam, väiksemates osades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus rapide et plus chargé, en éléments plus petits."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyorsabb és mozgalmasabb, apróbb darabokban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più rapido e movimentato, in pezzi più piccoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "速く、にぎやかに。粒は小さめ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 빠르고 분주하게, 더 작은 조각으로."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih pantas dan sibuk, dalam cebisan lebih kecil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais rápido e movimentado, em peças mais pequenas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрее и живее, мелкими кусочками."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更快更热闹，颗粒更小。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai rapid și mai ocupat, în bucăți mai mici."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sneller en drukker, in kleinere stukjes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更快更熱鬧，顆粒更小。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybciej i bardziej zajęte, w mniejszych kawałkach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Швидше та активніше, меншими частинами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha küçük parçalar halinde, daha hızlı ve daha yoğun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychlejší a rušnější, po menších kouscích."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rýchlejšie a rušnejšie, v menších kúskoch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πιο γρήγορο και απασχολημένο, σε μικρότερα κομμάτια."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snabbare och jobbigare, i mindre bitar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtigere og mere travlt, i mindre stykker."
          }
        },
        "nb": {
          "stringUnit": {
