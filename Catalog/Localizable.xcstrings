    "What the action runs on: your selection, or everything if nothing is selected.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarop die aksie loop: jou keuse, of alles as niks gekies is nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Worauf die Aktion läuft: deine Auswahl, oder alles, wenn nichts ausgewählt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre qué se ejecuta la acción: tu selección, o todo si no hay nada seleccionado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Millel tegevus töötab: sinu valik või kõik, kui midagi pole valitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sur quoi l'action s'applique : ta sélection, ou tout si rien n'est sélectionné."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amin a művelet fut: a kijelölésed, vagy minden, ha nincs kijelölve semmi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su cosa lavora l'azione: la tua selezione, o tutto se non c'è nulla di selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションの対象: 選択範囲、何も選んでいなければ全体です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액션이 처리할 대상: 선택한 부분, 아무것도 선택하지 않았다면 전체예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang tindakan ini kendalikan: pilihan anda, atau semuanya jika tiada yang dipilih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquilo sobre o que a ação corre: a tua seleção, ou tudo se nada estiver selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На чём работает действие: на выделении, а если ничего не выделено — на всём тексте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作作用的内容：你选中的部分；没有选中时就是全部。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe ce se execută acțiunea: selecția dvs. sau totul dacă nu este selectat nimic."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar de actie op draait: uw selectie, of alles als er niets is geselecteerd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作作用的內容：你選中的部分；沒有選中時就是全部。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na czym polega akcja: Twój wybór lub wszystko, jeśli nic nie zostało wybrane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На чому виконується дія: ваш вибір або все, якщо нічого не вибрано."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eylemin ne üzerinde çalıştığı: seçiminiz veya hiçbir şey seçili değilse her şey."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na čem akce běží: váš výběr nebo vše, pokud není vybráno nic."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na čom akcia beží: váš výber alebo všetko, ak nie je vybraté nič."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με ποιον τρόπο εκτελείται η ενέργεια: η επιλογή σας ή τα πάντα εάν δεν έχει επιλεγεί τίποτα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad åtgärden körs på: ditt val, eller allt om ingenting är valt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad handlingen kører på: dit valg, eller alt, hvis intet er valgt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva handlingen kjører på: ditt valg, eller alt hvis ingenting er valgt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mihin toiminto suoritetaan: valintasi tai kaikki, jos mitään ei ole valittu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan yang dijalankan: pilihan Anda, atau semuanya jika tidak ada yang dipilih."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hành động sẽ diễn ra trên đâu: lựa chọn của bạn hoặc mọi thứ nếu không có gì được chọn."
          }
        }
      }
    },
    "What the language calls itself. Shown as you type it, never translated.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat die taal homself noem. Getoon terwyl jy dit tik, nooit vertaal nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie die Sprache sich selbst nennt. Wird genau so angezeigt, wie du sie eingibst – nie übersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como se llama el idioma a sí mismo. Se muestra tal cual lo escribes, nunca traducido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuidas keel ennast nimetab. Kuvatakse nii, nagu sa ta sisestad, mitte kunagi tõlgituna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom que la langue se donne. Affiché tel que tu le saisis, jamais traduit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahogy a nyelv nevezi magát. Pontosan úgy jelenik meg, ahogy beírod – sosem fordítjuk le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come la lingua chiama se stessa. Appare esattamente come lo scrivi, mai tradotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その言語自身での呼び名です。入力したままの形で表示し、翻訳はしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 언어가 스스로를 부르는 이름입니다. 입력한 그대로 표시하며 번역하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama yang digunakan oleh bahasa itu sendiri. Dipaparkan seperti yang anda taip, tidak pernah diterjemah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como o idioma se chama a si próprio. Aparece tal como o escreves, nunca traduzido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как язык называет сам себя. Показывается ровно так, как вы это ввели, и никогда не переводится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这门语言对自己的称呼。按你输入的样子显示，绝不翻译。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce se numește limba în sine. Afișat pe măsură ce îl tastați, nu a fost tradus niciodată."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe de taal zichzelf noemt. Getoond terwijl u het typt, nooit vertaald."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這門語言對自己的稱呼。按你輸入的樣子顯示，絕不翻譯。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak język sam siebie nazywa. Wyświetlane podczas pisania, nigdy nie tłumaczone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як сама себе називає мова. Відображається під час введення, ніколи не перекладається."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilin kendisine verdiği isim. Siz yazarken gösterilir, asla tercüme edilmez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak si jazyk říká. Zobrazuje se při psaní, nikdy nepřeloženo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako sa jazyk nazýva. Zobrazuje sa pri písaní, nikdy neprekladá."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό που αποκαλεί τον εαυτό της η γλώσσα. Εμφανίζεται καθώς το πληκτρολογείτε, δεν μεταφράζεται ποτέ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad språket kallar sig. Visas när du skriver det, aldrig översatt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad sproget kalder sig selv. Vises, mens du skriver det, aldrig oversat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva språket kaller seg selv. Vises mens du skriver det, aldri oversatt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä kieli kutsuu itsekseen. Näkyy kirjoittaessasi, ei koskaan käännetty."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang disebut bahasa itu sendiri. Ditampilkan saat Anda mengetiknya, tidak pernah diterjemahkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì ngôn ngữ gọi chính nó. Hiển thị khi bạn gõ nó, không bao giờ được dịch."
          }
        }
      }
    },
