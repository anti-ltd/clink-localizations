    "Set the key, text and background colors, and give light and dark separate looks.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel die sleutel-, teks- en agtergrondkleure, en gee lig en donker aparte voorkoms."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg die Farben für Tasten, Text und Hintergrund fest und gib Hell und Dunkel jeweils ein eigenes Aussehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define los colores de teclas, texto y fondo, y dale a claro y oscuro aspectos distintos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Määra klahvi, teksti ja tausta värvid ning anna heledale ja tumedale eraldi ilme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définis les couleurs des touches, du texte et de l'arrière-plan, et donne au clair et au sombre un rendu distinct."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsd be a billentyűk, a szöveg és a háttér színét, és adj a világosnak és a sötétnek külön megjelenést."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta i colori di tasti, testo e sfondo, e dai a chiaro e scuro un aspetto ciascuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー、文字、背景の色を決め、ライトとダークにそれぞれの見た目を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키와 글자, 배경 색을 정하고, 밝은 모드와 어두운 모드에 각각 다른 모습을 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan warna kekunci, teks dan latar belakang, dan berikan mod cerah serta gelap rupa masing-masing."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Define as cores das teclas, do texto e do fundo, e dá ao claro e ao escuro aspetos separados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте цвета клавиш, текста и фона и сделайте светлому и тёмному виду разное оформление."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定按键、文字和背景的颜色，再给浅色和深色各配一套样子。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setați cheia, textul și culorile de fundal și dați un aspect distinct deschis și întunecat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel de sleutel-, tekst- en achtergrondkleuren in en geef licht en donker een apart uiterlijk."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定按鍵、文字和背景的顏色，再給淺色和深色各配一套樣子。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw kolory klucza, tekstu i tła oraz nadaj jasnym i ciemnym osobny wygląd."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановіть ключ, кольори тексту та фону, а також надайте роздільний вигляд світлим і темним."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarı, metni ve arka plan renklerini ayarlayın ve açık ve koyuya ayrı görünümler kazandırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte barvu klíče, textu a pozadí a dejte světlý a tmavý vzhled odděleně."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte farby kľúča, textu a pozadia a vytvorte oddelený svetlý a tmavý vzhľad."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρυθμίστε τα χρώματα πλήκτρων, κειμένου και φόντου και δώστε ξεχωριστές φωτεινές και σκούρες εμφανίσεις."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in nyckel-, text- och bakgrundsfärger och ge ljusa och mörka separata utseenden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstil nøgle-, tekst- og baggrundsfarver, og giv lyse og mørke separate udseende."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi nøkkel-, tekst- og bakgrunnsfarger, og gi lyse og mørke separate utseende."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta näppäin-, teksti- ja taustavärit ja anna vaaleat ja tummat erilliset ilmeet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur warna kunci, teks dan latar belakang, dan berikan tampilan terang dan gelap secara terpisah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt khóa, màu văn bản và màu nền, đồng thời tạo giao diện sáng và tối riêng biệt."
          }
        }
      }
    },
