    "Your tweaks since you applied %@ will be lost.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou aanpassings sedert jy %@ toegepas het, sal verlore gaan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Anpassungen seit dem Anwenden von %@ gehen verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perderán los ajustes que hayas hecho desde que aplicaste %@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu kohandused pärast %@ rakendamist lähevad kaotsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes ajustements depuis l'application de %@ seront perdus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ alkalmazása óta végzett finomhangolásaid elvesznek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche apportate da quando hai applicato %@ andranno perse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を適用してから行った調整は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 적용한 이후의 조정 내용이 사라져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelarasan anda sejak anda menggunakan %@ akan hilang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus ajustes desde que aplicaste %@ vão perder-se."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения, сделанные после применения «%@», будут потеряны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自从应用 %@ 之后做的调整都会丢失。"
          }
        }
      }
    },
