    "150ms hold, 16pt per character. Fewer accidental scrolls.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "150 ms halten, 16 pt pro Zeichen. Weniger versehentliches Scrollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "150ms de pulsación, 16pt por carácter. Menos desplazamientos sin querer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "150 ms d'appui, 16 pt par caractère. Moins de défilements par erreur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "150 ms tartás, 16 pt karakterenként. Kevesebb véletlen görgetés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "150ms di pressione, 16pt per carattere. Meno scorrimenti per sbaglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "150ms長押し、1文字あたり16pt。うっかりスクロールが減ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "150ms 누르고, 글자당 16pt. 실수로 스크롤되는 일이 줄어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan 150ms, 16pt setiap aksara. Kurang tatal tak sengaja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "150ms de toque, 16pt por caráter. Menos deslizes acidentais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержание 150 мс, 16pt на символ. Меньше случайной прокрутки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按150ms，每字符16pt。少一点误滚动。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "150 ms hoidmine, 16 pt märk kohta. Vähem juhuslikke kerimisi."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "150ms hou, 16pt per karakter. Minder toevallige rolle."
          }
        }
      }
    },
    "1pt key · 2pt row. Densest layout, no gaps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taste 1 pt · Reihe 2 pt. Dichtestes Layout, keine Lücken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecla 1pt · fila 2pt. La distribución más densa, sin huecos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche 1 pt · rangée 2 pt. La disposition la plus dense, sans espaces."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "1 pt billentyű · 2 pt sor. A legsűrűbb elrendezés, rések nélkül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasto 1pt · riga 2pt. Il layout più fitto, senza spazi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー1pt · 行2pt。いちばん詰まったレイアウトで、隙間なし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 1pt · 행 2pt. 가장 빽빽하고 틈이 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci 1pt · baris 2pt. Susun atur paling padat, tiada jurang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecla 1pt · linha 2pt. O esquema mais denso, sem espaços."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиша 1pt · ряд 2pt. Самая плотная раскладка, без зазоров."
