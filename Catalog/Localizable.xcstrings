    "Offline autocomplete above the keys, fully on device. Set the space above it under Keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanlyn outovoltooi bokant die sleutels, volledig op toestel. Stel die spasie daarbo onder Sleutels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-Autovervollständigung über den Tasten, komplett auf dem Gerät. Den Abstand darüber stellst du unter Tasten ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autocompletado sin conexión sobre las teclas, todo en el dispositivo. Ajusta el espacio superior en Teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühenduseta automaatlõpetus klahvide kohal, täielikult seadmel. Määra ruum selle kohal jaotises Klahvid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autocomplétion hors ligne au-dessus des touches, entièrement sur l'appareil. Règle l'espace au-dessus dans Touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline automatikus kiegészítés a billentyűk fölött, teljesen az eszközön. A fölötte lévő helyet a Billentyűk alatt állíthatod be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completamento automatico offline sopra i tasti, tutto sul dispositivo. Imposta lo spazio sopra in Tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの上に表示される、すべて端末内で動くオフラインの自動補完です。上の余白は「キー」で設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 위에 뜨는 오프라인 자동 완성으로, 전부 기기 안에서 처리돼요. 위쪽 간격은 '키'에서 설정해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Autolengkap luar talian di atas kekunci, sepenuhnya pada peranti. Tetapkan ruang di atasnya dalam Kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenchimento automático offline sobre as teclas, tudo no dispositivo. Define o espaço acima em Teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Офлайн-автодополнение над клавишами, целиком на устройстве. Отступ над ним задаётся в разделе «Клавиши»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键上方的离线自动补全，全部在设备本地完成。上方间距可在“按键”里设置。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Completare automată offline deasupra tastelor, complet pe dispozitiv. Setați spațiul de deasupra acestuia sub Chei."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline automatisch aanvullen boven de toetsen, volledig op apparaat. Stel de ruimte erboven in onder Sleutels."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵上方的離線自動補全，全部在裝置本地完成。上方間距可在“按鍵”裡設定。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Autouzupełnianie offline nad klawiszami, w pełni na urządzeniu. Ustaw spację nad nim w obszarze Klawisze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Офлайн-автозаповнення над клавішами, повністю на пристрої. Встановіть простір над ним під ключами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamen cihazda, tuşların üzerinde çevrimdışı otomatik tamamlama. Üstündeki alanı Tuşlar altında ayarlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline automatické doplňování nad klávesami, plně na zařízení. Nastavte prostor nad ním pod Keys."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline automatické dopĺňanie nad klávesmi, plne na zariadení. Nastavte priestor nad ním pod Keys."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτόματη συμπλήρωση εκτός σύνδεσης πάνω από τα πλήκτρα, πλήρως στη συσκευή. Ορίστε το χώρο πάνω από αυτό κάτω από τα πλήκτρα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline autoslutförande ovanför tangenterna, helt på enheten. Ställ in utrymmet ovanför under tangenter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline autofuldførelse over tasterne, fuldt ud på enheden. Indstil mellemrummet over det under Taster."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frakoblet autofullføring over tastene, fullstendig på enheten. Sett plassen over den under Taster."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-automaattinen täydennys näppäinten yläpuolella, täysin laitteella. Aseta sen yläpuolella oleva tila Avaimet-kohdassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelengkapan otomatis offline di atas tombol, sepenuhnya di perangkat. Atur ruang di atasnya di bawah Tombol."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động hoàn thành ngoại tuyến phía trên các phím, hoàn toàn trên thiết bị. Đặt khoảng trắng phía trên nó dưới Phím."
          }
        }
      }
    },
    "Offline translation needs iOS 18. Choose an AI provider under Integrations to translate on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline translation needs iOS 18. Choose an AI provider under Integrations to translate on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción sin conexión requiere iOS 18. Elige un proveedor de IA en Integraciones para traducir en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction hors ligne nécessite iOS 18. Choisis un fournisseur d’IA dans Intégrations pour traduire sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-Übersetzung erfordert iOS 18. Wähle unter Integrationen einen KI-Anbieter, um auf diesem Gerät zu übersetzen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione offline richiede iOS 18. Scegli un fornitore IA in Integrazioni per tradurre su questo dispositivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução offline requer o iOS 18. Escolhe um fornecedor de IA em Integrações para traduzir neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для перевода без интернета нужна iOS 18. Выберите провайдера ИИ в разделе «Интеграции», чтобы переводить на этом устройстве."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan luar talian memerlukan iOS 18. Pilih penyedia AI di bawah Integrasi untuk menterjemah pada peranti ini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az offline fordításhoz iOS 18 szükséges. A készüléken való fordításhoz válassz AI-szolgáltatót az Integrációk alatt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン翻訳にはiOS 18が必要です。このデバイスで翻訳するには、「連携」でAIプロバイダーを選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线翻译需要 iOS 18。请在“集成”中选择 AI 提供商，以在此设备上使用翻译。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 번역에는 iOS 18이 필요합니다. 이 기기에서 번역하려면 통합에서 AI 제공업체를 선택하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võrguühenduseta tõlge vajab iOS 18. Selles seadmes tõlkimiseks vali jaotises Integratsioonid AI-teenusepakkuja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducerea offline necesită iOS 18. Alegeți un furnizor de inteligență artificială sub Integrații pentru a traduce pe acest dispozitiv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor offline vertaling is iOS nodig 18. Kies een AI-provider onder Integraties om op dit apparaat te vertalen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離線翻譯需要 iOS 18。請在“整合”中選擇 AI 提供商，以在此裝置上使用翻譯。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanlyn vertaling vereis iOS 18. Kies 'n KI-verskaffer onder Integrasies om op hierdie toestel te vertaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tłumaczenie offline wymaga iOS 18. Wybierz dostawcę AI w obszarze Integracje, aby tłumaczyć na tym urządzeniu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Офлайн-переклад потребує iOS 18. Виберіть постачальника штучного інтелекту в розділі «Інтеграції», щоб перекладати на цьому пристрої."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı çeviri iOS 18 gerektirir. Bu cihazda çeviri yapmak için Entegrasyonlar altında bir yapay zeka sağlayıcısı seçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline překlad vyžaduje iOS 18. Chcete-li překládat na tomto zařízení, vyberte poskytovatele AI v části Integrace."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline preklad vyžaduje iOS 18. Ak chcete prekladať na tomto zariadení, v časti Integrácie vyberte poskytovateľa AI."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μετάφραση εκτός σύνδεσης χρειάζεται iOS 18. Επιλέξτε έναν πάροχο τεχνητής νοημοσύνης στην ενότητα Ενσωματώσεις για μετάφραση σε αυτήν τη συσκευή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Offlineöversättning behöver iOS 18. Välj en AI-leverantör under Integrationer för att översätta på den här enheten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline oversættelse kræver iOS 18. Vælg en AI-udbyder under Integrationer for at oversætte på denne enhed."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frakoblet oversettelse trenger iOS 18. Velg en AI-leverandør under Integrasjoner for å oversette på denne enheten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-käännös vaatii iOS 18. Valitse AI-toimittaja kohdasta Integraatiot, jos haluat kääntää tällä laitteella."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan offline memerlukan iOS 18. Pilih penyedia AI di bawah Integrasi untuk menerjemahkan di perangkat ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch ngoại tuyến cần iOS 18. Chọn nhà cung cấp AI trong Tích hợp để dịch trên thiết bị này."
          }
        }
      }
    },
