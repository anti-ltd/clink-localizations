    "Browse clips in a grid. Tap one to paste.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchstöbere Clips im Raster. Tippe einen zum Einfügen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora los clips en una cuadrícula: toca uno para pegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcours tes clips dans une grille. Touche l'un d'eux pour coller."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Böngészd az elemeket rácsban. Koppints egyre a beillesztéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfoglia le clip in una griglia: toccane una per incollare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップをグリッドで一覧。タップで貼り付け。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립을 그리드로 살펴보세요. 하나를 탭하면 붙여넣기돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak imbas klip dalam grid. Ketik satu untuk tampal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegue pelos clips numa grade. Toque num para colar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте фрагменты сеткой. Нажмите на любой, чтобы вставить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以网格浏览剪贴内容，点按其中一条即可粘贴。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirvi klippe ruudustikus. Puuduta üht kleepimiseks."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blaai deur snitte in 'n rooster. Tik een om te plak."
          }
        }
      }
    },
    "Browse everything you've saved in Cling and tap to type it wherever you are.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchstöbere alles, was du in Cling gespeichert hast, und tippe darauf, um es überall einzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora todo lo que has guardado en Cling y toca para escribirlo donde estés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcours tout ce que tu as enregistré dans Cling et touche pour l’écrire où que tu sois."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Böngészd végig, amit a Clingbe mentettél, és koppints rá, hogy bárhol beírd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfoglia tutto quello che hai salvato in Cling e tocca per scriverlo ovunque ti trovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling に保存したものを見て、タップすればどこでも入力できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling에 저장한 것을 둘러보고 탭하면 어디서든 입력됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak imbas semua yang anda simpan dalam Cling dan ketik untuk menaipnya di mana sahaja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja tudo o que guardou no Cling e toque para escrever onde estiver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте всё, что сохранили в Cling, и одним нажатием вставляйте это где угодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览你在 Cling 里保存的一切，轻点即可输入到任何地方。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirvi kõike, mida oled Clingi salvestanud, ja puuduta, et see kuskil tipida."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blaai deur alles wat jy in Cling gestoor het en tik om dit te tik waar jy ook al is."
          }
        }
      }
    },
