    "Draw an arrow and spread ellipse per key, showing where your taps tend to land.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken 'n pyl en versprei ellips per sleutel, wat wys waar jou krane geneig is om te land."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnet pro Taste einen Pfeil und eine Streuungsellipse, die zeigen, wo deine Tipper meist landen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja una flecha y una elipse de dispersión por tecla, mostrando dónde suelen caer tus toques."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Joonistab igale klahvile noole ja hajuvusellipsi, näidates, kuhu su vajutused tavaliselt maanduvad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une flèche et une ellipse d'étalement par touche, montrant où tes appuis atterrissent généralement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Billentyűnként rajzol egy nyilat és egy szórásellipszist, megmutatva, hová esnek általában a koppintásaid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna una freccia e un'ellisse di dispersione per tasto, mostrando dove atterrano di solito i tuoi tocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーに矢印と広がり楕円を描き、タップがどこに着地しがちかを示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키마다 화살표와 분포 타원을 그려 탭이 주로 닿는 위치를 보여 줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukis anak panah dan elips sebaran bagi setiap kekunci, menunjukkan tempat ketikan anda biasanya mendarat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenha uma seta e uma elipse de dispersão por tecla, mostrando onde os teus toques costumam cair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисует стрелку и эллипс разброса для каждой клавиши, показывая, куда обычно попадают нажатия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个按键绘制箭头和扩散椭圆，显示你的点按通常落在哪里。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenați o săgeată și răspândiți elipsa pe tastă, arătând unde tind să aterizeze atingerile dvs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken een pijl en verspreid een ellips per toets, om aan te geven waar uw tikken de neiging hebben te landen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為每個按鍵繪製箭頭和擴散橢圓，顯示你的點按通常落在哪裡。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narysuj strzałkę i rozłóż elipsę na każdym klawiszu, pokazując, gdzie zwykle lądują Twoje dotknięcia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Намалюйте стрілку та розведіть еліпс для кожної клавіші, показуючи, куди зазвичай потрапляють ваші натискання."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ok çizin ve her tuşa elips yayarak dokunuşlarınızın nereye ineceğini gösterin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakreslete šipku a rozprostřete elipsu na klávesu, která ukazuje, kam vaše klepnutí obvykle dopadá."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakreslite šípku a roztiahnite elipsu na kláves, ktorá ukazuje, kam vaše klepnutia zvyknú dopadnúť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδιάστε ένα βέλος και απλώστε την έλλειψη ανά κλειδί, δείχνοντας πού τείνουν να προσγειώνονται οι βρύσες σας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rita en pil och sprid ellips per nyckel, som visar var dina kranar tenderar att landa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn en pil og spred ellipse for hver tast, som viser, hvor dine tryk har tendens til at lande."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn en pil og spre ellipse per tast, som viser hvor kranene dine pleier å lande."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirrä nuoli ja levitä ellipsi näppäintä kohden, mikä osoittaa, mihin napauksesi yleensä laskeutuvat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambarlah panah dan sebarkan elips per tombol, yang menunjukkan di mana ketukan Anda cenderung mendarat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẽ một mũi tên và trải rộng hình elip cho mỗi phím, cho biết vị trí các thao tác nhấn của bạn có xu hướng chạm tới."
          }
        }
      }
    },
