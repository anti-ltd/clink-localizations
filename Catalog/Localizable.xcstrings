    "Hold a clip and drag it to reorder. Pinned clips stay on top.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou 'n snit vas en sleep dit om te herrangskik. Vasgespelde snitte bly bo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen Clip gedrückt und zieh ihn an eine neue Stelle. Angeheftete Clips bleiben oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un clip y arrástralo para cambiar el orden. Los fijados se quedan arriba."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia klippi ja lohista see ümber. Kinnitatud klipid jäävad üles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens un élément et fais-le glisser pour le déplacer. Les éléments épinglés restent en haut."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarts nyomva egy klipet, és húzd a helyére. A rögzítettek felül maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta una clip e trascinala per cambiare l’ordine. Quelle bloccate restano in alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップを長押しして動かすと、並び順を変えられます。ピン留めしたクリップは上のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립을 길게 눌러 끌면 순서를 바꿀 수 있어요. 고정한 클립은 계속 맨 위에 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan satu klip dan seret untuk menyusun semula. Klip yang dipin kekal di atas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha um clip premido e arraste-o para mudar a ordem. Os fixados ficam no topo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержите фрагмент и перетащите, чтобы изменить порядок. Закреплённые остаются наверху."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按剪贴内容再拖动即可调整顺序，固定的始终排在最上面。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți un clip și trageți-l pentru a reordona. Clipurile fixate rămân în partea de sus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een fragment vast en sleep het om de volgorde te wijzigen. Vastgezette clips blijven bovenaan staan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按剪貼內容再拖動即可調整順序，固定的始終排在最上面。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj klip i przeciągnij go, aby zmienić kolejność. Przypięte klipy pozostają na górze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте кліп і перетягуйте його, щоб змінити порядок. Закріплені кліпи залишаються зверху."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir klibi tutun ve yeniden sıralamak için sürükleyin. Sabitlenen klipler üstte kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte klip a přetažením změňte pořadí. Připnuté klipy zůstávají nahoře."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte klip a presuňte ho, aby ste zmenili poradie. Pripnuté klipy zostávajú navrchu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε ένα κλιπ και σύρετέ το για αναδιάταξη. Τα καρφιτσωμένα κλιπ παραμένουν στην κορυφή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll ett klipp och dra det för att ändra ordning. Nålade klipp stannar på toppen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold et klip, og træk det for at omarrangere. Fastgjorte klip bliver på toppen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold et klipp og dra det for å omorganisere. Festede klipp forblir på toppen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä leikettä ja järjestä se uudelleen vetämällä. Kiinnitetyt klipsit pysyvät päällä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegang klip dan seret untuk menyusun ulang. Klip yang disematkan tetap berada di atas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ một clip và kéo nó để sắp xếp lại. Các clip đã ghim luôn ở trên cùng."
          }
        }
      }
    },
    "Hold a clip and drag it to reorder. Swipe left for copy, pin, or delete; swipe right to assign a group.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou 'n snit vas en sleep dit om te herrangskik. Swiep links vir kopieer, speld vas of vee uit; swiep regs om 'n groep toe te wys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen Clip und zieh ihn zum Umsortieren. Wisch nach links für Kopieren, Anheften oder Löschen; nach rechts, um eine Gruppe zuzuweisen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén un recorte y arrástralo para reordenar. Desliza a la izquierda para copiar, fijar o borrar; a la derecha para asignar un grupo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia klippi ja lohista see ümber. Viipa vasakule kopeerimiseks, kinnitamiseks või kustutamiseks; viipa paremale grupi määramiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens un extrait et glisse-le pour réordonner. Balaye à gauche pour copier, épingler ou supprimer ; à droite pour l’assigner à un groupe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd a klipet, és húzd az átrendezéshez. Balra húzás: másolás, kitűzés, törlés; jobbra: csoportba sorolás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un clip e trascinalo per riordinare. Scorri a sinistra per copiare, fissare o eliminare; a destra per assegnare un gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップを長押ししてドラッグすると並べ替え。左スワイプでコピー・ピン・削除、右スワイプでグループ分け。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립을 길게 눌러 끌어 순서를 바꿉니다. 왼쪽 쓸면 복사·고정·삭제, 오른쪽 쓸면 그룹에 넣습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan klip dan seret untuk susun semula. Leret kiri untuk salin, semat atau padam; leret kanan untuk tetapkan kumpulan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém um clip e arrasta-o para reordenar. Desliza para a esquerda para copiar, afixar ou apagar; para a direita para atribuir um grupo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержите фрагмент и перетащите, чтобы изменить порядок. Свайп влево — копировать, закрепить или удалить; свайп вправо — назначить группу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住一条再拖动即可重排。左滑复制、钉住或删除；右滑分到一组。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți un clip și trageți-l pentru a reordona. Glisați spre stânga pentru copiere, fixare sau ștergere; glisați spre dreapta pentru a atribui un grup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een fragment vast en sleep het om de volgorde te wijzigen. Veeg naar links om te kopiëren, vast te zetten of te verwijderen; veeg naar rechts om een ​​groep toe te wijzen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住一條再拖動即可重排。左滑複製、釘住或刪除；右滑分到一組。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj klip i przeciągnij go, aby zmienić kolejność. Przesuń w lewo, aby skopiować, przypiąć lub usunąć; przesuń palcem w prawo, aby przypisać grupę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте кліп і перетягуйте його, щоб змінити порядок. Проведіть пальцем ліворуч, щоб скопіювати, закріпити або видалити; проведіть праворуч, щоб призначити групу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir klibi tutun ve yeniden sıralamak için sürükleyin. Kopyalamak, sabitlemek veya silmek için sola kaydırın; Bir gruba atamak için sağa kaydırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte klip a přetažením změňte pořadí. Přejetím doleva můžete zkopírovat, připnout nebo odstranit; přejetím prstem doprava přiřadíte skupinu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte klip a presuňte ho, aby ste zmenili poradie. Potiahnutím doľava môžete kopírovať, pripnúť alebo odstrániť; potiahnutím prstom doprava priradíte skupinu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε ένα κλιπ και σύρετέ το για αναδιάταξη. Σύρετε προς τα αριστερά για αντιγραφή, καρφίτσωμα ή διαγραφή. σύρετε προς τα δεξιά για να εκχωρήσετε μια ομάδα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll ett klipp och dra det för att ändra ordning. Svep åt vänster för att kopiera, fästa eller ta bort; svep åt höger för att tilldela en grupp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold et klip, og træk det for at omarrangere. Stryg til venstre for at kopiere, fastgøre eller slette; stryg til højre for at tildele en gruppe."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold et klipp og dra det for å omorganisere. Sveip til venstre for å kopiere, feste eller slette; sveip til høyre for å tilordne en gruppe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä leikettä ja järjestä se uudelleen vetämällä. Pyyhkäise vasemmalle kopioidaksesi, kiinnittääksesi tai poistaaksesi. pyyhkäise oikealle määrittääksesi ryhmän."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegang klip dan seret untuk menyusun ulang. Gesek ke kiri untuk menyalin, menyematkan, atau menghapus; geser ke kanan untuk menetapkan grup."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ một clip và kéo nó để sắp xếp lại. Vuốt sang trái để sao chép, ghim hoặc xóa; vuốt sang phải để chỉ định một nhóm."
          }
        }
      }
    },
