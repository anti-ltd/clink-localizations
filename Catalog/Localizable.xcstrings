            "value": "Le parole che aggiungi tu valgono sempre e sopravvivono a una cancellazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で追加した単語は常に有効で、消去しても残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
