          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina a sessão de microfone do Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершает сеанс работы Clink с микрофоном."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止 Clink 的麦克风会话。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprește sesiunea de microfon a lui Clink."
          }
        },
        "nl": {
