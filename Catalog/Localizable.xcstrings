    "Old words struck out, new ones right after. Clearest, but it stops reading as a sentence.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou woorde het deurgehaal, nuwes direk daarna. Duidelikste, maar dit hou op om as 'n sin te lees."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte Wörter durchgestrichen, neue direkt dahinter. Am deutlichsten, aber nicht mehr flüssig lesbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Palabras antiguas tachadas y nuevas justo después. Es lo más claro, pero deja de leerse como una frase."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanad sõnad läbikriipsutatud, uued kohe pärast. Kõige selgem, aga ei loe enam lausena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anciens mots barrés, nouveaux juste après. Très clair, mais la phrase devient moins lisible."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A régi szavak áthúzva, az újak közvetlenül utánuk. Ez a legtisztább, de már nem olvasható folyamatos mondatként."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parole vecchie barrate e nuove subito dopo. È chiarissimo, ma non si legge più come una frase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古い単語を取り消し線で残し、その直後に新しい単語を表示します。違いは明確ですが、文章としては読みにくくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 단어에 취소선을 긋고 바로 뒤에 새 단어를 표시해요. 가장 명확하지만 문장처럼 읽히지는 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataan lama dipotong dan perkataan baharu selepasnya. Paling jelas, tetapi ayat jadi sukar dibaca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palavras antigas riscadas e novas logo a seguir. É mais claro, mas deixa de se ler como uma frase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старые слова зачёркнуты, новые — сразу после. Понятнее всего, но перестаёт читаться как предложение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "划掉旧词，并紧接着显示新词。变化最清楚，但读起来不再像完整句子。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuvintele vechi au trecut, altele noi imediat după. Cel mai clar, dar nu mai citește ca o propoziție."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oude woorden geschrapt, nieuwe meteen daarna. Het duidelijkst, maar het leest niet meer als een zin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "劃掉舊詞，並緊接著顯示新詞。變化最清楚，但讀起來不再像完整句子。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykreślono stare słowa, zaraz potem nowe. Najjaśniejszy, ale przestaje być czytany jako zdanie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Старі слова викреслені, нові відразу після. Найчіткіше, але воно перестає читатися як речення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski sözler ortaya çıktı, hemen ardından yenileri. En net ama cümle olarak okumayı bırakıyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stará slova škrtla, nová hned potom. Nejjasnější, ale přestane se číst jako věta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Staré slová škrtli, nové hneď potom. Najjasnejšie, ale prestane sa čítať ako veta."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παλιές λέξεις βγήκαν έξω, καινούριες αμέσως μετά. Το πιο σαφές, αλλά σταματά να διαβάζεται ως πρόταση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamla ord slog ut, nya direkt efter. Tydligast, men den slutar läsas som en mening."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamle ord slog ud, nye lige efter. Klarest, men den holder op med at læse som en sætning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamle ord slo ut, nye rett etter. Klarest, men den slutter å lese som en setning."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanhat sanat iski pois, uudet heti perään. Selkein, mutta se lakkaa lukemasta lauseena."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata-kata lama muncul, kata-kata baru muncul setelahnya. Paling jelas, tetapi berhenti dibaca sebagai sebuah kalimat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời cũ nói ra, lời mới nói ngay sau. Rõ ràng nhất, nhưng nó dừng đọc như một câu."
          }
        }
      }
    },
