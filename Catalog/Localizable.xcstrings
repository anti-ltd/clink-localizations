    "Create groups to sort clips in the keyboard panel. Swipe a clip right to assign it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skep groepe om snitte in die sleutelbordpaneel te sorteer. Swiep 'n snit regs om dit toe te wys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg Gruppen an, um Clips im Tastaturpanel zu sortieren. Wisch einen Clip nach rechts, um ihn zuzuordnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea grupos para ordenar los clips en el panel del teclado. Desliza un clip a la derecha para asignarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loo gruppe, et klaviatuuri paneelil klippe sortida. Viipa klippi paremale, et see määrata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée des groupes pour trier les clips dans le panneau du clavier. Balaie un clip vers la droite pour l'assigner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozz létre csoportokat, hogy rendezd a vágólap-elemeket a billentyűzet panelén. Húzz egy elemet jobbra a hozzárendeléshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea gruppi per ordinare le clip nel pannello della tastiera. Scorri una clip verso destra per assegnarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループを作るとキーボードパネルのクリップを整理できます。クリップを右にスワイプすると割り当てられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹을 만들어서 키보드 패널의 클립을 정리해보세요. 클립을 오른쪽으로 밀면 그룹에 넣을 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipta kumpulan untuk susun klip dalam panel papan kekunci. Leret klip ke kanan untuk masukkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria grupos para organizar clipes no painel do teclado. Desliza um clipe para a direita para o atribuíres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавайте группы, чтобы разложить фрагменты в панели клавиатуры. Смахните фрагмент вправо, чтобы отнести его к группе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建分组，把键盘面板里的剪贴内容整理好。把剪贴内容向右滑就能分到组里。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creați grupuri pentru a sorta clipurile în panoul de tastatură. Glisați un clip spre dreapta pentru a-l atribui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak groepen om clips in het toetsenbordpaneel te sorteren. Veeg een fragment naar rechts om het toe te wijzen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立分組，把鍵盤面板裡的剪貼內容整理好。把剪貼內容向右滑就能分到組裡。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twórz grupy, aby sortować klipy na panelu klawiatury. Przesuń klip w prawo, aby go przypisać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створюйте групи для сортування кліпів на панелі клавіатури. Проведіть пальцем по кліпу вправо, щоб призначити його."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipleri klavye panelinde sıralamak için gruplar oluşturun. Bir klibi atamak için sağa kaydırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořte skupiny pro třídění klipů na panelu klávesnice. Chcete-li klip přiřadit, přejeďte prstem doprava."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvorte skupiny na triedenie klipov na paneli klávesnice. Potiahnutím prstom doprava ho priradíte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε ομάδες για να ταξινομήσετε κλιπ στον πίνακα πληκτρολογίου. Σύρετε ένα κλιπ προς τα δεξιά για να το εκχωρήσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa grupper för att sortera klipp på tangentbordspanelen. Svep ett klipp åt höger för att tilldela det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret grupper for at sortere klip i tastaturpanelet. Stryg et klip til højre for at tildele det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett grupper for å sortere klipp i tastaturpanelet. Sveip et klipp til høyre for å tilordne det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo ryhmiä leikkeiden lajittelemiseksi näppäimistöpaneelissa. Määritä leike pyyhkäisemällä oikealle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat grup untuk mengurutkan klip di panel keyboard. Geser klip ke kanan untuk menetapkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo nhóm để sắp xếp các clip trong bảng bàn phím. Vuốt một clip sang phải để gán nó."
          }
        }
      }
    },
