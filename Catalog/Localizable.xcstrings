    "Sticks close to the original wording, phrase by phrase.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bly naby die oorspronklike bewoording, frase vir frase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt nah am Original, Wendung für Wendung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ciñe a la redacción original, frase por frase."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Püsib originaali sõnastuse lähedal, fraasi kaupa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste au plus près du texte d'origine, expression par expression."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szorosan követi az eredeti megfogalmazást, fordulatról fordulatra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta fedele al testo originale, frase per frase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原文の言い回しを一語一句そのままたどります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원문의 표현을 구절 단위로 그대로 따릅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengekalkan susunan kata asal, rangkai kata demi rangkai kata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém-se fiel à redação original, expressão a expressão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держится близко к исходным формулировкам, фраза за фразой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐句贴合原文的措辞。"
          }
        }
      }
    },
    "Still missing? Raise Prediction strength a notch.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog steeds vermis? Verhoog voorspellingssterkte 'n kerf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer noch daneben? Dreh die Vorhersagestärke eine Stufe hoch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sigues fallando? Sube un punto la Fuerza de predicción."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Endiselt puudu? Tõsta Ennustuse tugevust ühe astme võrra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours à côté ? Monte la Force de prédiction d'un cran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még mindig mellémegy? Told feljebb egy fokkal az Előrejelzés erősségét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbagli ancora? Alza di un gradino l'Intensità della previsione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それでも外れる場合は、「予測の強さ」を一段上げてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래도 빗나가면 예측 강도를 한 단계 올려 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih tersasar? Naikkan Kekuatan ramalan satu takuk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuas a falhar? Sobe a Força da previsão um ponto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё равно не хватает? Поднимите «Силу предсказаний» на ступень."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还是按不准？把“预测强度”往上调一档。"
          }
        }
      }
    },
