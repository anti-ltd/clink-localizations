    "Springy and playful. Keys bounce as they settle.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Federnd und verspielt. Tasten schwingen beim Zurückkehren nach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elástico y juguetón. Las teclas rebotan al asentarse."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetruv ja mänguline. Klahvid põrkavad paigale jäädes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souple et ludique. Les touches rebondissent en se stabilisant."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rugalmas és játékos. A billentyűk megállás közben pattognak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elastico e giocoso. I tasti rimbalzano mentre si fermano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弾むような遊び心。キーが跳ねながら止まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통통 튀고 경쾌하게. 키가 멈추며 튕겨요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anjal dan ceria. Kekunci melantun semasa berhenti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Elástico e divertido. As teclas ressaltam ao assentar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упруго и игриво. Клавиши подпрыгивают, прежде чем остановиться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹性十足、俏皮活泼，按键停下时会回弹。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevator și jucăuș. Tastele sar pe măsură ce se instalează."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veerkrachtig en speels. Sleutels stuiteren terwijl ze vastzitten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "彈性十足、俏皮活潑，按鍵停下時會回彈。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Veerkragtig en speels. Sleutels bons wanneer hulle in posisie kom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiosenny i zabawny. Klawisze podskakują, gdy się osadzają."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пружинний і грайливий. Ключі підстрибують, коли вони осідають."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Esnek ve eğlenceli. Anahtarlar yerleştikçe zıplıyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pružný a hravý. Klíče při usazování odskakují."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pružný a hravý. Pri usadzovaní kľúče odskakujú."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοιξιάτικο και παιχνιδιάρικο. Τα κλειδιά αναπηδούν καθώς εγκαθίστανται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vårigt och lekfullt. Nycklar studsar när de sätter sig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Springende og legende. Nøgler hopper, når de sætter sig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjærende og leken. Nøkler spretter når de legger seg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Springy and playful. Avaimet pomppivat asettuessaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenyal dan menyenangkan. Kunci memantul saat menetap."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trẻ trung và vui tươi. Phím nảy khi chúng ổn định."
          }
        }
      }
    },
