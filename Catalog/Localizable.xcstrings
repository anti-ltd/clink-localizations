    "Emoji is off. Turn it on to use and customize it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Emoji is af. Skakel dit aan om dit te gebruik en aan te pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji ist aus. Schalte es ein, um es zu nutzen und anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los emojis están desactivados. Actívalos para usarlos y personalizarlos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji on väljas. Lülita need sisse, et kasutada ja kohandada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
