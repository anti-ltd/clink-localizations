        }
      }
    },
    "The list came with word counts, so common words will be suggested first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste bringt Häufigkeiten mit – häufige Wörter werden zuerst vorgeschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista trae frecuencias, así que las palabras comunes se sugerirán primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste contient des fréquences : les mots courants seront proposés en premier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista tartalmaz gyakorisági számokat, így a gyakori szavak kerülnek előre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elenco include le frequenze, quindi le parole comuni verranno suggerite per prime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストに出現数が付いているので、よく使う語から候補に出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에 빈도 수치가 있어 자주 쓰는 단어가 먼저 추천됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai ini disertakan kiraan perkataan, jadi perkataan biasa akan dicadangkan dahulu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista traz frequências, por isso as palavras comuns aparecem primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В списке были частоты слов, поэтому частые слова будут предлагаться первыми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词表自带词频，常用词会优先出现在候选中。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loendis olid sõnade arvud, seega tavasõnu soovitatakse esimesena."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die lys het met woordtellings gekom, so algemene woorde sal eerste voorgestel word."
          }
        }
      }
    },
    "The list is alphabetical with no counts, so every word carries equal weight. A list with counts after each word ranks better.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste ist alphabetisch und ohne Häufigkeiten, also wiegt jedes Wort gleich. Eine Liste mit Zahlen hinter den Wörtern sortiert besser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista está en orden alfabético y sin frecuencias, así que todas las palabras pesan igual. Una lista con un número tras cada palabra ordena mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste est alphabétique et sans fréquences : tous les mots ont le même poids. Une liste avec un nombre après chaque mot donne un meilleur classement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista ábécérendben van, gyakoriságok nélkül, így minden szó azonos súlyú. A szavak után írt számokkal jobb lenne a sorrend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elenco è in ordine alfabetico e senza frequenze, quindi ogni parola pesa uguale. Un elenco con un numero dopo ogni parola ordina meglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストは五十音・アルファベット順で出現数がないため、すべての語が同じ重みになります。語の後ろに数値があるリストなら候補順が良くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록이 사전순이고 빈도가 없어 모든 단어의 가중치가 같습니다. 단어 뒤에 숫자가 있는 목록이 순서가 더 좋습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai ini mengikut abjad tanpa kiraan, jadi semua perkataan sama berat. Senarai dengan nombor selepas setiap perkataan menyusun lebih baik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista está por ordem alfabética e sem frequências, por isso todas as palavras pesam o mesmo. Uma lista com um número depois de cada palavra ordena melhor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список отсортирован по алфавиту и без частот, поэтому все слова равнозначны. Список с числом после каждого слова ранжируется лучше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词表按字母顺序排列且没有词频，因此每个词权重相同。词后带数字的词表排序更好。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loend on tähestikuline, ilma arvudeta, seega iga sõna kaalub võrdselt. Loend sõna järel olevate arvudega järjestab paremini."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die lys is alfabeties met geen tellings nie, so elke woord dra ewe veel gewig. 'n Lys met tellings na elke woord is beter."
          }
        }
      }
    },
    "The mark the double-space shortcut writes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zeichen, das die Leertasten-Abkürzung schreibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
