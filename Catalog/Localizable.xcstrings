          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegevused sisaldavad piiratud teisendusloogikat. Luba ainult hoidlaid, mida usaldad."
          }
        },
        "fr": {
          "stringUnit": {
