      }
    },
    "The button turns this on and off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Taste schaltet dies ein und aus."
          }
        },
        "es": {
