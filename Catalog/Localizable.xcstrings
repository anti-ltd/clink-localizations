        }
      }
    },
    "There's nothing readable in here. Either it's empty, or a newer version of Clink wrote it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier is niks leesbaars nie. Óf dit is leeg, óf 'n nuwer weergawe van Clink het dit geskryf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier ist nichts zu lesen. Entweder ist der Eintrag leer, oder eine neuere Clink-Version hat ihn geschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay nada legible. O está vacío, o lo escribió una versión más reciente de Clink."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Siin pole midagi loetavat. See on kas tühi või kirjutas selle uuem Clinki versioon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de lisible ici. Soit c’est vide, soit une version plus récente de Clink l’a écrit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt nincs olvasható tartalom. Vagy üres, vagy a Clink egy újabb verziója írta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non c’è nulla di leggibile. O è vuoto, oppure l’ha scritto una versione più recente di Clink."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取れる内容がありません。空であるか、より新しいバージョンのClinkが書き込んだものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽을 수 있는 내용이 없습니다. 비어 있거나, 더 새로운 버전의 Clink가 기록한 것입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa yang boleh dibaca di sini. Sama ada ia kosong, atau ditulis oleh versi Clink yang lebih baharu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nada legível aqui. Ou está vazio, ou foi escrito por uma versão mais recente do Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь нечего прочитать. Либо файл пуст, либо его записала более новая версия Clink."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里没有可读内容。要么是空的，要么是由更新版本的 Clink 写入的。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu se poate citi nimic aici. Fie este gol, fie o versiune mai nouă de Clink a scris-o."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is hier niets leesbaars. Of het is leeg, of een nieuwere versie van Clink heeft het geschreven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡沒有可讀內容。要麼是空的，要麼是由更新版本的 Clink 寫入的。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma tu nic czytelnego. Albo jest pusty, albo napisała go nowsza wersja Clink."
