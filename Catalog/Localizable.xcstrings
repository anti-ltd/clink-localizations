    "Deletes this private account and disconnects its devices. This does not cancel store subscriptions.": {
      "comment": "Optional private app account and purchase sharing. No email or typing data. Recovery key and pairing codes are secrets.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina esta cuenta privada y desconecta sus dispositivos. No cancela las suscripciones de la tienda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime ce compte privé et déconnecte ses appareils. Les abonnements souscrits en boutique ne sont pas résiliés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht dieses private Konto und trennt seine Geräte. Abonnements im Store werden dadurch nicht gekündigt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina questo account privato e disconnette i suoi dispositivi. Non annulla gli abbonamenti dello store."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina esta conta privada e desliga os respetivos dispositivos. Não cancela subscrições na loja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватный аккаунт будет удалён, а его устройства отключены. Подписки в магазине отменены не будут."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memadam akaun peribadi ini dan memutuskan sambungan perantinya. Langganan gedung tidak dibatalkan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törli ezt a privát fiókot, és leválasztja az eszközeit. Az áruházi előfizetéseket nem mondja le."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプライベートアカウントを削除し、デバイスの接続を解除します。ストアのサブスクリプションは解約されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此私密账户并断开其设备连接。这不会取消商店订阅。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 비공개 계정을 삭제하고 기기 연결을 해제합니다. 스토어 구독은 취소되지 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutab selle privaatse konto ja katkestab seadmete ühenduse. Poe tellimusi ei tühistata."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge acest cont privat și îi deconectează dispozitivele. Abonamentele din magazin nu sunt anulate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert dit privéaccount en ontkoppelt de apparaten. Abonnementen in de winkel worden niet opgezegd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除此私人帳號並中斷其裝置連線。這不會取消商店訂閱。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vee hierdie private rekening uit en ontkoppel sy toestelle. Winkelintekeninge word nie gekanselleer nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa to prywatne konto i odłącza jego urządzenia. Nie anuluje subskrypcji w sklepie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє цей приватний обліковий запис і від’єднує його пристрої. Підписки в магазині не скасовуються."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu özel hesabı siler ve cihazlarının bağlantısını keser. Mağaza aboneliklerini iptal etmez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaže tento soukromý účet a odpojí jeho zařízení. Předplatné v obchodě se tím nezruší."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymaže tento súkromný účet a odpojí jeho zariadenia. Predplatné v obchode sa tým nezruší."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφει αυτόν τον ιδιωτικό λογαριασμό και αποσυνδέει τις συσκευές του. Δεν ακυρώνει συνδρομές στο κατάστημα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderar det här privata kontot och kopplar bort dess enheter. Prenumerationer i butiken avslutas inte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter denne private konto og afbryder forbindelsen til dens enheder. Abonnementer i butikken annulleres ikke."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter denne private kontoen og kobler fra enhetene. Abonnementer i butikken blir ikke avsluttet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa tämän yksityisen tilin ja katkaisee sen laitteiden yhteydet. Kaupan tilauksia ei peruuteta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus akun privat ini dan memutus koneksi perangkatnya. Langganan di toko tidak dibatalkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa tài khoản riêng tư này và ngắt kết nối các thiết bị của tài khoản. Thao tác này không hủy gói đăng ký tại cửa hàng."
          }
        }
      }
    },
