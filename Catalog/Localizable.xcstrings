    "Set Width to how far in you want the keys to come.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stel die breedte in op hoe ver jy wil hê die sleutels moet kom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell die Breite darauf ein, wie weit die Tasten hereinrücken sollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el Ancho a lo que quieras que se acerquen las teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Määra Laius sellele, kui kaugele klahvid sisse tuleksid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle la Largeur selon la distance dont tu veux rapprocher les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Szélességgel add meg, mennyire húzódjanak beljebb a billentyűk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la Larghezza a quanto vuoi che i tasti si avvicinino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「幅」で、キーをどこまで内側に寄せるかを決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너비로 키를 얼마나 안쪽으로 당길지 정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan Lebar mengikut sejauh mana anda mahu kekunci masuk ke dalam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta a Largura conforme queiras as teclas mais para dentro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте «Ширину» — насколько клавиши должны сдвинуться внутрь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用“宽度”决定按键往里收多少。"
          }
        }
      }
    },
