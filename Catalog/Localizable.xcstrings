    "Hold A to select all, C to copy, X to cut and V to paste": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou A in om alles te kies, C om te kopieer, X om te knip en V om te plak"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržením A vyberete vše, C zkopírujete, X vyjmete a V vložíte"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold A nede for at vælge alt, C for at kopiere, X for at klippe og V for at indsætte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A zum Auswählen von allem, C zum Kopieren, X zum Ausschneiden und V zum Einfügen gedrückt halten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτησε πατημένο το A για επιλογή όλων, το C για αντιγραφή, το X για αποκοπή και το V για επικόλληση"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado A para seleccionar todo, C para copiar, X para cortar y V para pegar"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõige valimiseks hoia all A, kopeerimiseks C, lõikamiseks X ja kleepimiseks V"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kaikki pitämällä A:ta painettuna, kopioi C:llä, leikkaa X:llä ja liitä V:llä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez A pour tout sélectionner, C pour copier, X pour couper et V pour coller"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd nyomva az A-t az összes kijelöléséhez, a C-t a másoláshoz, az X-et a kivágáshoz és a V-t a beillesztéshez"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan A untuk memilih semua, C untuk menyalin, X untuk memotong, dan V untuk menempel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto A per selezionare tutto, C per copiare, X per tagliare e V per incollare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aを長押しですべて選択、Cでコピー、Xでカット、Vでペースト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "A를 길게 눌러 전체 선택, C로 복사, X로 잘라내기, V로 붙여넣기"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lama A untuk memilih semua, C untuk menyalin, X untuk memotong dan V untuk menampal"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold A for å markere alt, C for å kopiere, X for å klippe ut og V for å lime inn"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd A ingedrukt om alles te selecteren, C om te kopiëren, X om te knippen en V om te plakken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj A, aby zaznaczyć wszystko, C, aby skopiować, X, aby wyciąć, lub V, aby wkleić"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha A pressionado para selecionar tudo, C para copiar, X para recortar e V para colar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține apăsat A pentru a selecta tot, C pentru a copia, X pentru a decupa și V pentru a lipi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте A для выбора всего текста, C для копирования, X для вырезания и V для вставки"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
