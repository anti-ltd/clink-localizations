    "%@ Only while Vietnamese is the one language being checked.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Slegs terwyl Viëtnamees die een taal is wat nagegaan word."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Nur solange Vietnamesisch die einzige geprüfte Sprache ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Solo mientras el vietnamita sea el único idioma comprobado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ainult siis, kui vietnami on ainus kontrollitav keel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Uniquement tant que le vietnamien est la seule langue vérifiée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Csak amíg a vietnami az egyetlen ellenőrzött nyelv."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Solo finché il vietnamita è l’unica lingua controllata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ベトナム語だけをチェック対象にしているあいだのみ有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 베트남어만 검사 대상일 때에만 적용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Hanya selagi bahasa Vietnam ialah satu-satunya bahasa yang disemak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Só enquanto o vietnamita for o único idioma a ser verificado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Только пока вьетнамский — единственный проверяемый язык."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仅在越南语是唯一被检查的语言时生效。"
          }
        }
      }
    },
    "%@ Only while Vietnamese is your sole active language.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Slegs terwyl Viëtnamees jou enigste aktiewe taal is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Nur solange Vietnamesisch deine einzige aktive Sprache ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Solo mientras el vietnamita sea tu único idioma activo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ainult siis, kui vietnami on sinu ainus aktiivne keel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Seulement quand le vietnamien est ta seule langue active."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Csak akkor, ha a vietnami az egyetlen aktív nyelved."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Solo quando il vietnamita è la tua unica lingua attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ベトナム語だけをオンにしているときに使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 베트남어만 켜 두었을 때만 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Cuma bila bahasa Vietnam satu-satunya bahasa aktif anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Só enquanto o vietnamita for a tua única língua ativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Только пока вьетнамский — ваш единственный активный язык."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 只在越南语是你唯一启用的语言时才生效。"
          }
        }
      }
    },
