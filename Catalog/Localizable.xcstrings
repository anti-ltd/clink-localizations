            "value": "Éclaire"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beleuchtet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Illumina"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menerangi"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megvilágítja"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光らせる対象"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照亮"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비추는 대상"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Värvib"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Краски"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verf"
          }
        }
      }
    },
    "Park the light after a pause and wake it on your next keystroke, the way a real board sleeps. Nothing runs while you're not typing.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparca la luz tras una pausa y la despierta con la siguiente tecla, como duerme un teclado de verdad. No se ejecuta nada mientras no escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met la lumière en veille après une pause et la réveille à la prochaine frappe, comme un vrai clavier. Rien ne tourne quand vous n'écrivez pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt das Licht nach einer Pause schlafen und weckt es beim nächsten Anschlag – wie eine echte Tastatur. Solange du nicht tippst, läuft nichts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mette la luce in pausa dopo un momento e la risveglia al tasto successivo, come fa una tastiera vera. Quando non scrivi, non gira nulla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adormece a luz após uma pausa e acorda-a na próxima tecla, como um teclado a sério. Nada corre enquanto não escreves."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentikan cahaya selepas seketika dan bangunkannya pada ketukan seterusnya, seperti papan kekunci sebenar tidur. Tiada apa berjalan ketika anda tidak menaip."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy szünet után elalszik a fény, és a következő leütésre felébred, ahogy egy igazi billentyűzet. Amíg nem írsz, semmi nem fut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し止まると光もお休みして、次の打鍵で目を覚まします。入力していない間は何も動きません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停下一会儿灯光就休眠，下一次按键再唤醒，像真正的键盘一样。不打字时什么都不运行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 멈추면 조명도 잠들고, 다음 타이핑에 다시 깨어납니다. 입력하지 않는 동안에는 아무것도 돌지 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pargib pärast pausi valguse ja äratab selle järgmisel klahvivajutusel, nagu päris klaviatuur magab. Kui sa ei tipi, ei tööta midagi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гасите свет после паузы и будите его следующим нажатием — как засыпает настоящая клавиатура. Пока вы не печатаете, ничего не работает."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parkeer die lig na 'n pouse en maak dit wakker met jou volgende toetsaanslag, soos 'n regte bord slaap. Niks loop terwyl jy nie tik nie."
          }
        }
      }
    },
    "Stops the light getting bright enough to swallow the letter on the key. Turn off for the boldest colour.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que la luz sea tan intensa que se coma la letra de la tecla. Desactívalo para el color más intenso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche la lumière de devenir si vive qu'elle avale la lettre sur la touche. Désactivez pour la couleur la plus intense."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass das Licht so hell wird, dass es den Buchstaben auf der Taste verschluckt. Aus für die kräftigste Farbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita che la luce diventi così intensa da inghiottire la lettera sul tasto. Disattiva per il colore più intenso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede que a luz fique tão intensa que engula a letra da tecla. Desliga para a cor mais intensa."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghalang cahaya menjadi terlalu terang sehingga menelan huruf pada kekunci. Matikan untuk warna paling berani."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megakadályozza, hogy a fény elnyomja a gombon lévő betűt. Kapcsold ki a legerősebb színért."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの文字が光に飲まれない明るさに抑えます。オフにすると最も鮮やかな色になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免灯光亮到吞掉按键上的字母。关闭可获得最浓的色彩。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛이 키의 글자를 삼킬 만큼 밝아지지 않게 합니다. 끄면 색이 가장 진해집니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoiab ära, et valgus muutuks nii eredaks, et see neelaks klahvil oleva tähe. Lülita välja kõige julgema värvi jaoks."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не даёт свету стать настолько ярким, чтобы поглотить букву на клавише. Выключите для самого насыщенного цвета."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keer dat die lig helder genoeg word om die letter op die sleutel te sluk. Skakel af vir die sterkste kleur."
          }
        }
      }
    },
    "The full hue wheel, ignoring the theme's colours.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el círculo de color, sin tener en cuenta los colores del tema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La roue des couleurs complète, sans tenir compte des couleurs du thème."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ganze Farbkreis, unabhängig von den Farben des Themes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'intera ruota dei colori, ignorando i colori del tema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O círculo de cores completo, ignorando as cores do tema."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Roda warna penuh, tanpa mengira warna tema."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes színkör, a téma színeit figyelmen kívül hagyva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマの色に関係なく、色相環をすべて使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用完整色环，不参考主题配色。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마 색과 무관하게 전체 색상환을 사용합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Terve värviratas, teema värve eirates."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный цветовой круг, игнорируя цвета темы."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die volkleurwiel, ignoreer die tema se kleure."
          }
        }
      }
    },
    "The light takes the cap. Boldest look, and it overrules the theme.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz se queda con la tecla. El look más intenso, y manda sobre el tema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière prend la touche. Le rendu le plus marqué, et il l'emporte sur le thème."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Licht übernimmt die Taste. Der kräftigste Look – und er setzt sich über das Theme hinweg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La luce prende il tasto. L'effetto più deciso, e ha la meglio sul tema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A luz fica com a tecla. O aspeto mais forte, e sobrepõe-se ao tema."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya mengambil alih kekunci. Rupa paling berani, dan ia mengatasi tema."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fény átveszi a gombot. A legerősebb hatás, és felülírja a témát."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光がキー面を占めます。もっとも大胆で、テーマより優先されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
