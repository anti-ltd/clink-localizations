            "state": "translated",
            "value": "Stellt die Eingangsanimation auf „Keine“ zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece la animación de entrada a ninguna."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taastab sisenemisanimatsiooni puudumise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit l'absence d'animation d'entrée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítja a belépési animáció hiányát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina nessuna animazione di ingresso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始アニメーションを「なし」に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등장 효과를 '없음'으로 되돌립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulihkan tiada animasi kemunculan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura a ausência de animação de entrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает отсутствие анимации появления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复为无进场动画。"
          }
        }
      }
    },
    "Restores no letter pop animation.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
