            "value": "칩을 탭하면 그 클립을 붙여넣습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik cip untuk tampal klip itu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca um chip para colar esse clip."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь чипа, чтобы вставить этот фрагмент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点碎片即可粘贴那段内容。"
          }
        }
      }
    },
    "Tap a colored tile to open that tool.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik 'n gekleurde teël om daardie instrument oop te maak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe eine farbige Kachel, um dieses Tool zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una baldosa de color para abrir esa herramienta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta värvilist plaati, et see tööriist avada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une tuile colorée pour ouvrir cet outil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy színes csempére az eszköz megnyitásához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una piastrella colorata per aprire quello strumento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色付きタイルをタップしてそのツールを開きます。"
