    "Switches the wall to the opposite side for keys on the right half of the keyboard.": {
      "comment": "Explanation of the Berry mirror toggle. Horizontal walls switch left/right based on each key's physical midpoint; top/bottom walls are unaffected.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En las teclas de la mitad derecha del teclado, coloca el borde elevado en el lado opuesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Place le rebord du côté opposé sur les touches de la moitié droite du clavier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Tastenflanke bei Tasten auf der rechten Tastaturhälfte auf der gegenüberliegenden Seite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta il bordo sul lato opposto dei tasti nella metà destra della tastiera."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca o rebordo no lado oposto nas teclas da metade direita do teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переносит бортик на противоположную сторону у клавиш в правой половине клавиатуры."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengalihkan dinding kekunci ke sisi bertentangan untuk kekunci di separuh kanan papan kekunci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzet jobb felén lévő billentyűk oldalfalát az ellenkező oldalra helyezi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの右半分にあるキーでは、側面の位置を反対側に切り替えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将键盘右半部分按键的侧壁切换到另一侧。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 오른쪽 절반에 있는 키의 측면을 반대쪽으로 전환합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viib klaviatuuri paremal poolel olevate klahvide külgseina vastasküljele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comută peretele în partea opusă pentru tastele din jumătatea dreaptă a tastaturii."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakelt de muur naar de andere kant voor toetsen op de rechterhelft van het toetsenbord."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將鍵盤右半部分按鍵的側壁切換到另一側。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skuif die grens na die teenoorgestelde kant vir sleutels aan die regterkant van die sleutelbord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełącza ścianę na przeciwną stronę dla klawiszy po prawej stronie klawiatury."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемикає стіну на протилежну сторону для клавіш на правій половині клавіатури."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyenin sağ yarısındaki tuşlar için duvarı karşı tarafa geçirir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepne zeď na opačnou stranu pro klávesy na pravé polovině klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepne stenu na opačnú stranu pre klávesy na pravej polovici klávesnice."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάζει τον τοίχο στην αντίθετη πλευρά για πλήκτρα στο δεξί μισό του πληκτρολογίου."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växlar väggen till motsatt sida för tangenter på tangentbordets högra halva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skifter væggen til den modsatte side for taster på højre halvdel af tastaturet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytter veggen til motsatt side for taster på høyre halvdel av tastaturet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuttaa seinän vastakkaiselle puolelle näppäimistön oikean puolen näppäimiä varten."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengalihkan dinding ke sisi berlawanan untuk tombol di bagian kanan keyboard."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển bức tường sang phía đối diện cho các phím ở nửa bên phải của bàn phím."
          }
        }
      }
    },
    "Switches theme automatically with the system light/dark mode.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel tema outomaties met die stelsel lig/donker modus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselt das Design automatisch mit dem Hell-/Dunkelmodus des Systems."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el tema solo según el modo claro u oscuro del sistema."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahetab teemat automaatselt süsteemi heleda/tumedaga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change de thème tout seul selon le mode clair/sombre du système."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatikusan témát vált a rendszer világos vagy sötét módjával együtt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia tema in automatico seguendo la modalità chiara o scura del sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのライト/ダークモードに合わせて、テーマを自動で切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
