    "This plugin can read and change your keyboard settings and edit text. Choose which additional data it may access.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plugin puede leer y cambiar los ajustes del teclado y editar texto. Elige a qué otros datos puede acceder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce plugin peut lire et modifier les réglages du clavier et le texte. Choisis les autres données auxquelles il peut accéder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Plugin kann deine Tastatureinstellungen lesen und ändern sowie Text bearbeiten. Wähle, auf welche weiteren Daten es zugreifen darf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo plugin può leggere e modificare le impostazioni della tastiera e il testo. Scegli a quali altri dati può accedere."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plugin pode ler e alterar as definições do teclado e editar texto. Escolha a que outros dados pode aceder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот плагин может читать и менять настройки клавиатуры и редактировать текст. Выберите, к каким дополнительным данным разрешить доступ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemalam ini boleh membaca dan mengubah tetapan papan kekunci serta menyunting teks. Pilih data tambahan yang boleh diaksesnya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bővítmény olvashatja és módosíthatja a billentyűzet beállításait, valamint szöveget szerkeszthet. Válaszd ki, milyen további adatokhoz férhet hozzá."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプラグインはキーボード設定の読み取りと変更、テキストの編集ができます。追加でアクセスを許可するデータを選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此插件可以读取和更改键盘设置，并编辑文本。请选择它还可以访问哪些数据。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 플러그인은 키보드 설정을 읽고 변경하며 텍스트를 편집할 수 있습니다. 추가로 접근을 허용할 데이터를 선택하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See pistikprogramm saab lugeda ja muuta klaviatuuri seadeid ning teksti redigeerida. Vali, millistele lisaandmetele see ligi pääseb."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plugin can read and change your keyboard settings and edit text. Choose which additional data it may access."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest plugin poate citi și modifica setările tastaturii și poate edita textul. Alegeți ce date suplimentare poate accesa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze plug-in kan uw toetsenbordinstellingen lezen en wijzigen en tekst bewerken. Kies tot welke aanvullende gegevens het toegang heeft."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此外掛可以讀取和更改鍵盤設定，並編輯文字。請選擇它還可以訪問哪些資料。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie inprop kan jou sleutelbordinstellings lees en verander, asook teks wysig. Kies tot watter bykomende data dit toegang mag hê."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wtyczka może czytać i zmieniać ustawienia klawiatury oraz edytować tekst. Wybierz, do jakich dodatkowych danych może uzyskać dostęp."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей плагін може читати та змінювати налаштування клавіатури та редагувати текст. Виберіть, до яких додаткових даних він матиме доступ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu eklenti klavye ayarlarınızı okuyabilir, değiştirebilir ve metni düzenleyebilir. Hangi ek verilere erişebileceğini seçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento plugin může číst a měnit nastavení klávesnice a upravovat text. Vyberte, ke kterým dalším datům bude mít přístup."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento doplnok dokáže čítať a meniť nastavenia klávesnice a upravovať text. Vyberte, ku ktorým dodatočným údajom môže pristupovať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η προσθήκη μπορεί να διαβάσει και να αλλάξει τις ρυθμίσεις του πληκτρολογίου σας και να επεξεργαστεί κείμενο. Επιλέξτε σε ποια πρόσθετα δεδομένα μπορεί να έχει πρόσβαση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna plugin kan läsa och ändra dina tangentbordsinställningar och redigera text. Välj vilken ytterligare data den kan komma åt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette plugin kan læse og ændre dine tastaturindstillinger og redigere tekst. Vælg, hvilke yderligere data den må få adgang til."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne plugin-en kan lese og endre tastaturinnstillingene dine og redigere tekst. Velg hvilke tilleggsdata den får tilgang til."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä laajennus voi lukea ja muuttaa näppäimistöasetuksiasi ja muokata tekstiä. Valitse, mitä lisätietoja se voi käyttää."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugin ini dapat membaca dan mengubah pengaturan keyboard Anda serta mengedit teks. Pilih data tambahan mana yang dapat diakses."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugin này có thể đọc và thay đổi cài đặt bàn phím cũng như chỉnh sửa văn bản. Chọn dữ liệu bổ sung mà nó có thể truy cập."
          }
        }
      }
    },
