    "Uses your keyboard’s letter size. Turn off to set a size just for this theme.": {
      "comment": "Theme editor toggle: enabled inherits the keyboard-wide letter size; disabled allows a theme-specific override.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik jou sleutelbord se lettergrootte. Skakel af om ’n grootte net vir hierdie tema te kies."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používá velikost písmen klávesnice. Vypnutím nastavíš velikost jen pro tento motiv."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruger tastaturets bogstavstørrelse. Slå fra for at vælge en størrelse kun til dette tema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet die Buchstabengröße deiner Tastatur. Deaktiviere die Option, um eine eigene Größe für dieses Design festzulegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιεί το μέγεθος γραμμάτων του πληκτρολογίου. Απενεργοποίησέ το για να ορίσεις μέγεθος μόνο για αυτό το θέμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el tamaño de las letras del teclado. Desactívalo para elegir un tamaño solo para este tema."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasutab klaviatuuri tähesuurust. Lülita välja, et määrata suurus ainult sellele teemale."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttää näppäimistön kirjainkokoa. Poista käytöstä, jos haluat määrittää koon vain tälle teemalle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la taille des lettres de ton clavier. Désactive cette option pour choisir une taille propre à ce thème."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzet betűméretét használja. Kikapcsolva külön betűméretet adhatsz meg ehhez a témához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan ukuran huruf keyboard. Nonaktifkan untuk mengatur ukuran khusus tema ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la dimensione delle lettere della tastiera. Disattiva per impostare una dimensione solo per questo tema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの文字サイズを使用します。オフにすると、このテーマ専用のサイズを設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드의 글자 크기를 사용합니다. 끄면 이 테마에만 적용할 크기를 설정할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan saiz huruf papan kekunci. Matikan untuk menetapkan saiz khusus bagi tema ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruker tastaturets bokstavstørrelse. Slå av for å velge en størrelse bare for dette temaet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt de lettergrootte van je toetsenbord. Zet dit uit om alleen voor dit thema een grootte in te stellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa rozmiaru liter klawiatury. Wyłącz, aby ustawić rozmiar tylko dla tego motywu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o tamanho das letras do teclado. Desativa para definir um tamanho só para este tema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește dimensiunea literelor tastaturii. Dezactivează pentru a seta o dimensiune doar pentru această temă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует размер букв клавиатуры. Отключите, чтобы задать размер только для этой темы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používa veľkosť písmen klávesnice. Vypnutím nastavíš veľkosť len pre tento motív."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använder tangentbordets bokstavsstorlek. Stäng av för att välja en storlek bara för det här temat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyenin harf boyutunu kullanır. Yalnızca bu tema için boyut ayarlamak istiyorsanız kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує розмір літер клавіатури. Вимкніть, щоб задати розмір лише для цієї теми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng cỡ chữ của bàn phím. Tắt để đặt cỡ chữ riêng cho giao diện này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用键盘的字号。关闭后可为此主题单独设置字号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用鍵盤的字級。關閉後可為此主題單獨設定字級。"
          }
        }
      }
    },
