    "Slow, sparse and soft. Barely there behind the keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stadig, yl en sag. Skaars daar agter die sleutels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsam, spärlich und weich. Hinter den Tasten kaum zu bemerken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lento, disperso y suave. Casi no se nota detrás de las teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aeglane, hõre ja pehme. Klahvide taga vaevu märgatav."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lent, clairsemé et doux. À peine perceptible derrière les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassú, ritka és lágy. Alig észrevehető a billentyűk mögött."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lento, rado e morbido. Dietro i tasti si nota appena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり、控えめ、やわらかく。キーの後ろでほとんど目立ちません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "느리고 성기고 부드럽게. 키 뒤에서 거의 눈에 띄지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlahan, jarang dan lembut. Hampir tidak kelihatan di belakang kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lento, disperso e suave. Quase não se nota por trás das teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленно, редко и мягко. За клавишами почти незаметно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢、疏、柔。在按键后方几乎察觉不到。"
          }
        }
      }
    },
    "Slowly moves keys to where you actually tap": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beweeg sleutels stadig na waar jy werklik tik"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegt die Tasten langsam dorthin, wo du tatsächlich tippst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve poco a poco las teclas hacia donde tocas de verdad"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Liigutab klahvid aeglaselt sinna, kuhu sa tegelikult vajutad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace lentement les touches vers l'endroit où tu appuies vraiment"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassan oda mozgatja a billentyűket, ahová valójában koppintasz"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta lentamente i tasti verso dove tocchi davvero"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際にタップする場所へ、キーを少しずつ動かします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 실제로 누르는 곳으로 천천히 옮겨요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlahan-lahan mengalihkan kekunci ke tempat anda sebenarnya ketik"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Move as teclas devagar para onde realmente tocas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постепенно смещает клавиши туда, куда вы на самом деле нажимаете"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢慢把键移到你实际点按的位置"
          }
        }
      }
    },
