          }
        }
      }
    },
    "I only want the dictation and the tools. Can I hide the rest?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich will nur das Diktat und die Werkzeuge. Kann ich den Rest ausblenden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quiero el dictado y las herramientas. ¿Puedo ocultar lo demás?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je veux seulement la dictée et les outils. Puis-je masquer le reste ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a diktálás és az eszközök kellenek. El tudom rejteni a többit?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Voglio solo la dettatura e gli strumenti. Posso nascondere il resto?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力とツールだけ使いたいのですが、ほかは隠せますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기와 도구만 쓰고 싶어요. 나머지는 숨길 수 있나요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya mahu imlak dan alat sahaja. Boleh sembunyikan yang lain?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só quero o ditado e as ferramentas. Posso esconder o resto?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мне нужны только диктовка и инструменты. Можно спрятать остальное?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我只想要口述输入和工具，其他能藏起来吗？"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma tahan ainult dikteerimist ja tööriistu. Kas ma saan ülejäänu peita?"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ek wil net die diktee en die gereedskap hê. Kan ek die res wegsteek?"
          }
        }
      }
    },
