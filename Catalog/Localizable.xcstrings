            "value": "Baris angka di atas huruf."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma fileira de números acima das letras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ряд цифр над буквами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字母上方的一排数字。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rând de cifre deasupra literelor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een rij cijfers boven de letters."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "字母上方的一排數字。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "‘n Ry syfers bo die letters."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rząd cyfr nad literami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ряд цифр над літерами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harflerin üstünde bir rakam dizisi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řada číslic nad písmeny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rad číslic nad písmenami."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια σειρά από ψηφία πάνω από τα γράμματα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En rad med siffror ovanför bokstäverna."
          }
        },
        "da": {
