    "A language key beside the space bar: tap to switch, hold to pick (separate mode)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sprachtaste neben der Leertaste: tippen zum Wechseln, halten zum Auswählen (getrennter Modus)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tecla de idioma junto a la barra espaciadora: toca para cambiar, mantén pulsado para elegir (modo aparte)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une touche de langue à côté de la barre d'espace : touche pour changer, maintiens pour choisir (mode séparé)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy nyelvbillentyű a szóköz mellett: koppints a váltáshoz, tartsd nyomva a választáshoz (külön mód)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tasto lingua accanto alla barra spaziatrice: tocca per cambiare, tieni premuto per scegliere (modalità separata)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースバーの横に言語キー。タップで切り替え、長押しで選択（別モード）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 바 옆의 언어 키: 탭하면 전환, 길게 누르면 선택(별도 모드)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci bahasa di sebelah bar ruang: ketik untuk tukar, tahan untuk pilih (mod berasingan)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tecla de idioma ao lado da barra de espaços: toca para trocar, mantém premida para escolher (modo separado)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиша языка рядом с пробелом: нажатие — переключить, удержание — выбрать (раздельный режим)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空格键旁边一个语言键：点一下切换，长按挑选（独立模式）"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeleklahv tühikuklahvi kõrval: puuduta vahetamiseks, hoia valimiseks (eraldi režiim)"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Taalsleutel langs die spasiebalk: tik om te wissel, hou om te kies (afsonderlike modus)"
          }
        }
      }
    },
    "A layout belongs to the language that types on it, so you change it inside the language.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Layout gehört zu der Sprache, die darauf tippt, du änderst es also in der Sprache selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una distribución pertenece al idioma que escribe con ella, así que se cambia dentro del idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une disposition appartient à la langue qui écrit dessus : tu la changes donc dans la langue."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elrendezés ahhoz a nyelvhez tartozik, amelyik rajta gépel, ezért a nyelven belül változtatod meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una disposizione appartiene alla lingua che ci scrive, quindi la cambi dentro la lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配列は、それで入力する言語に属しています。そのため言語の中で変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배열은 그 위에서 입력하는 언어에 속하므로, 언어 안에서 바꿉니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun atur milik bahasa yang menaip padanya, jadi anda menukarnya di dalam bahasa itu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma disposição pertence ao idioma que escreve nela, por isso mudas dentro do idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раскладка принадлежит языку, на котором печатают, поэтому меняется внутри языка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排列方式属于在它上面打字的那种语言，所以要进到语言里改。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paigutus kuulub keelele, mis sellega tipitakse, seega muudad seda keele seest."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Uitleg behoort aan die taal wat daarop tik, so jy verander dit binne die taal."
          }
        }
      }
    },
