    "Messages, mail, notes, search bars. Anywhere you type.": {
      "extractionState": "stale",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Boodskappe, pos, notas, soekbalke. Enige plek waar jy tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten, Mail, Notizen, Suchfelder. Überall, wo du tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensajes, correo, notas, barras de búsqueda. Donde sea que escribas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sõnumid, e-post, märkmed, otsinguribad. Kus iganes sa tipid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages, mail, notes, barres de recherche. Partout où tu écris."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzenetek, levelek, jegyzetek, keresőmezők. Bárhol, ahol gépelsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Messaggi, mail, note, barre di ricerca. Ovunque tu scriva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ、メール、メモ、検索バー。入力する場所ならどこでも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지, 메일, 메모, 검색창까지. 입력하는 곳이라면 어디든."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesej, mel, nota, bar carian. Di mana-mana sahaja anda menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensagens, mail, notas, barras de pesquisa. Onde quer que escrevas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщения, почта, заметки, строки поиска. Везде, где вы печатаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信息、邮件、备忘录、搜索栏。任何输入的地方。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaje, e-mail, note, bare de căutare. Oriunde tastezi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichten, e-mail, notities, zoekbalken. Waar u ook typt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資訊、郵件、備忘錄、搜尋欄。任何輸入的地方。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomości, poczta, notatki, paski wyszukiwania. Gdziekolwiek piszesz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення, пошта, нотатки, панелі пошуку. Будь-де, де ви вводите."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlar, postalar, notlar, arama çubukları. Yazdığınız her yerde."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zprávy, pošta, poznámky, vyhledávací lišty. Kdekoli napíšete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Správy, pošta, poznámky, vyhľadávacie lišty. Kdekoľvek napíšete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μηνύματα, αλληλογραφία, σημειώσεις, γραμμές αναζήτησης. Όπου πληκτρολογείτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddelanden, e-post, anteckningar, sökfält. Var du än skriver."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskeder, mail, noter, søgelinjer. Hvor som helst du skriver."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldinger, e-post, notater, søkefelt. Uansett hvor du skriver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viestit, sähköpostit, muistiinpanot, hakupalkit. Missä tahansa kirjoitat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan, surat, catatan, bilah pencarian. Di mana pun Anda mengetik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn, thư, ghi chú, thanh tìm kiếm. Bất cứ nơi nào bạn gõ."
          }
        }
      }
    },
