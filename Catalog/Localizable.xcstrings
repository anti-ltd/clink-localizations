    "Open Cling once so it can share what you've saved.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maak Cling een keer oop sodat dit kan deel wat jy gestoor het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Cling einmal, damit es teilen kann, was du gespeichert hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Cling una vez para que pueda compartir lo que has guardado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava Cling üks kord, et see saaks jagada seda, mida salvestasid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Cling une fois pour qu’il puisse partager ce que tu as enregistré."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg egyszer a Clinget, hogy megoszthassa, amit elmentettél."
          }
        },
        "it": {
