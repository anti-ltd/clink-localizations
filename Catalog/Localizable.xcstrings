    "Shown on the category tab. Set the tab style to Emoji on the Layout tab to use the set’s first emoji instead.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Getoon op die kategorie-oortjie. Stel die oortjiestyl na Emoji op die Uitleg-oortjie om eerder die stel se eerste emoji te gebruik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint auf dem Kategorie-Tab. Stell den Tab-Stil unter „Layout“ auf Emoji, damit stattdessen das erste Emoji des Sets zu sehen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ve en la pestaña de la categoría. Pon el estilo de las pestañas en Emoji, en la pestaña Diseño, para que salga el primer emoji del conjunto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvatakse kategooriakaardil. Määra kaardi stiiliks Emoji kaardil Paigutus, et kasutada hoopis komplekti esimest emojisid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichée sur l'onglet de la catégorie. Passe le style des onglets sur Emoji dans « Disposition » pour montrer plutôt le premier emoji du set."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kategóriafülön látszik. Állítsd a fülstílust Emojira az „Elrendezés” fülön, ha inkább a készlet első emojija jelenjen meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare sulla scheda della categoria. Imposta lo stile delle schede su Emoji in «Layout» per mostrare invece la prima emoji del set."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリタブに表示されます。「レイアウト」タブでタブのスタイルを絵文字にすると、代わりにセットの最初の絵文字が出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카테고리 탭에 보여요. ‘레이아웃’ 탭에서 탭 스타일을 이모지로 바꾸면 세트의 첫 이모지가 대신 나와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditunjukkan pada tab kategori. Tetapkan gaya tab kepada Emoji di tab Susun Atur untuk guna emoji pertama set itu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece no separador da categoria. Muda o estilo dos separadores para Emoji no separador Esquema, para mostrar o primeiro emoji do conjunto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывается на вкладке категории. Задайте вкладкам стиль «Эмодзи» на вкладке «Раскладка», чтобы вместо этого использовался первый эмодзи набора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在分类栏上。想改用合集里的第一个表情，就到「布局」里把分类栏样式设为表情。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișat în fila categorie. Setați stilul filei la Emoji din fila Aspect pentru a utiliza în schimb primul emoji al setului."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Getoond op het categorietabblad. Stel de tabbladstijl in op Emoji op het tabblad Indeling om in plaats daarvan de eerste emoji van de set te gebruiken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示在分類欄上。想改用合集裡的第一個表情，就到「佈局」裡把分類欄樣式設為表情。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlane na karcie kategorii. Ustaw styl karty na Emoji na karcie Układ, aby zamiast tego użyć pierwszego emoji z zestawu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відображається на вкладці категорії. Встановіть стиль вкладки Emoji на вкладці Layout, щоб замість цього використовувати перший emoji набору."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategori sekmesinde gösterilir. Bunun yerine setin ilk emojisini kullanmak için Düzen sekmesinde sekme stilini Emoji olarak ayarlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazeno na kartě kategorie. Nastavte styl karty na Emoji na kartě Rozvržení, abyste místo toho použili první emotikon sady."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje sa na karte kategórie. Nastavte štýl karty na Emoji na karte Rozloženie, aby ste namiesto toho použili prvé emotikony sady."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζεται στην καρτέλα κατηγορία. Ορίστε το στυλ καρτέλας σε Emoji στην καρτέλα Διάταξη για να χρησιμοποιήσετε το πρώτο emoji του συνόλου."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas på kategorifliken. Ställ in flikstilen till Emoji på fliken Layout för att använda setets första emoji istället."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises på kategorifanen. Indstil fanestilen til Emoji på fanen Layout for at bruge sættets første emoji i stedet for."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises på kategorifanen. Sett fanestilen til Emoji på Layout-fanen for å bruke settets første emoji i stedet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkyy luokkavälilehdellä. Aseta välilehden tyyliksi Emoji Asettelu-välilehdellä, jos haluat käyttää joukon ensimmäistä emojia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditampilkan di tab kategori. Atur gaya tab ke Emoji pada tab Tata Letak untuk menggunakan emoji pertama dari kumpulan tersebut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị trên tab danh mục. Đặt kiểu tab thành Biểu tượng cảm xúc trên tab Bố cục để sử dụng biểu tượng cảm xúc đầu tiên của bộ thay thế."
          }
        }
      }
    },
    "Shows a converted value in the suggestion bar as you type, even when Conversion is off.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wys ’n omgeskakelde waarde in die voorstelbalk terwyl jy tik, selfs wanneer Omskakeling afgeskakel is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt beim Tippen einen umgerechneten Wert in der Vorschlagsleiste, auch wenn Umrechnung deaktiviert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un valor convertido en la barra de sugerencias mientras escribes, incluso con la conversión desactivada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Näitab tippimise ajal soovitusribal teisendatud väärtust ka siis, kui teisendus on väljas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une valeur convertie dans la barre de suggestions pendant la saisie, même si la conversion est désactivée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइप करते समय सुझाव बार में बदला हुआ मान दिखाता है, भले ही रूपांतरण बंद हो।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gépelés közben átváltott értéket jelenít meg a javaslatsávban akkor is, ha az átváltás ki van kapcsolva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un valore convertito nella barra dei suggerimenti mentre scrivi, anche quando la conversione è disattivata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換がオフでも、入力中に変換後の値を候補バーに表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환을 끈 상태에서도 입력할 때 변환된 값을 제안 막대에 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memaparkan nilai yang ditukar dalam bar cadangan semasa anda menaip, walaupun Penukaran dimatikan."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "रूपान्तरण बन्द भए पनि टाइप गर्दा सुझाव पट्टीमा रूपान्तरण गरिएको मान देखाउँछ।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra um valor convertido na barra de sugestões enquanto escreve, mesmo quando a conversão está desativada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает преобразованное значение в строке подсказок во время ввода, даже если преобразование отключено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dönüştürme kapalı olsa bile yazarken öneri çubuğunda dönüştürülmüş bir değer gösterir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使关闭“转换”，输入时也会在建议栏中显示转换后的值。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează o valoare convertită în bara de sugestii pe măsură ce introduceți text, chiar și atunci când Conversia este dezactivată."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont een geconverteerde waarde in de suggestiebalk terwijl u typt, zelfs als Conversie is uitgeschakeld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使關閉“轉換”，輸入時也會在建議欄中顯示轉換後的值。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje przekonwertowaną wartość na pasku sugestii podczas pisania, nawet jeśli konwersja jest wyłączona."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує конвертоване значення на панелі пропозицій під час введення тексту, навіть якщо перетворення вимкнено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje převedenou hodnotu na panelu návrhů během psaní, i když je převod vypnutý."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje prevedenú hodnotu na paneli návrhov počas písania, aj keď je Konverzia vypnutá."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει μια τιμή μετατροπής στη γραμμή προτάσεων καθώς πληκτρολογείτε, ακόμα και όταν η Μετατροπή είναι απενεργοποιημένη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar ett konverterat värde i förslagsfältet medan du skriver, även när konvertering är avstängd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser en konverteret værdi i forslagslinjen, mens du skriver, selv når Konvertering er slået fra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser en konvertert verdi i forslagslinjen mens du skriver, selv når konvertering er av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää muunnetun arvon ehdotuspalkissa kirjoittaessasi, vaikka muunnos olisi pois päältä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan nilai yang dikonversi di bilah saran saat Anda mengetik, meskipun Konversi tidak aktif."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị giá trị được chuyển đổi trong thanh gợi ý khi bạn nhập, ngay cả khi Chuyển đổi bị tắt."
          }
        }
      }
    },
    "Shows a result in the suggestion bar as you type an expression, even when Calculator is off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt beim Eingeben eines Ausdrucks ein Ergebnis in der Vorschlagsleiste, auch wenn der Rechner ausgeschaltet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un resultado en la barra de sugerencias mientras escribes una expresión, incluso cuando la Calculadora está desactivada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvab avaldise sisestamisel soovitusribal tulemuse ka siis, kui kalkulaator on välja lülitatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un résultat dans la barre de suggestions quand tu saisis une expression, même si la calculatrice est désactivée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifejezés írásakor eredményt jelenít meg a javaslatsávban, még akkor is, ha a Számológép ki van kapcsolva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un risultato nella barra dei suggerimenti mentre digiti un'espressione, anche quando la calcolatrice è disattivata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算機がオフでも、式の入力中に候補バーへ結果を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산기가 꺼져 있어도 수식을 입력하면 제안 막대에 결과를 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memaparkan hasil dalam bar cadangan semasa anda menaip ungkapan, walaupun Kalkulator dimatikan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra um resultado na barra de sugestões enquanto escreve uma expressão, mesmo quando a Calculadora está desativada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает результат в строке подсказок при вводе выражения, даже если Калькулятор выключен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使计算器已关闭，输入表达式时也会在建议栏中显示结果。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează un rezultat în bara de sugestii pe măsură ce tastați o expresie, chiar și atunci când Calculatorul este dezactivat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont een resultaat in de suggestiebalk terwijl u een uitdrukking typt, zelfs als de Rekenmachine is uitgeschakeld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使計算器已關閉，輸入表示式時也會在建議欄中顯示結果。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wys 'n resultaat in die voorstelbalk terwyl jy 'n uitdrukking tik, selfs wanneer die Sakrekenaar af is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje wynik na pasku sugestii podczas wpisywania wyrażenia, nawet gdy Kalkulator jest wyłączony."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує результат на панелі пропозицій, коли ви вводите вираз, навіть якщо калькулятор вимкнено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap Makinesi kapalı olsa bile, siz bir ifade yazarken öneri çubuğunda bir sonuç gösterir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje výsledek na liště návrhů při psaní výrazu, i když je Kalkulačka vypnutá."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
