    "Renews monthly. Cancel anytime.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hernu maandeliks. Kanselleer enige tyd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich monatlich. Jederzeit kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva cada mes. Cancela cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Uueneb igakuiselt. Tühista igal ajal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvelé chaque mois. Annulable à tout moment."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Havonta megújul. Bármikor lemondhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova ogni mese. Annulla quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月自動更新。いつでもキャンセルできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매월 갱신됩니다. 언제든 해지할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperbaharui setiap bulan. Batal bila-bila masa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova-se mensalmente. Cancela quando quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продлевается раз в месяц. Отменить можно в любой момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月续订。随时可取消。"
          }
        }
      }
    },
    "Renews yearly. Cancel anytime.": {
      "localizations": {
