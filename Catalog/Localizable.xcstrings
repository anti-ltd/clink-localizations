            "state": "translated",
            "value": "Thêm một chút chi tiết: một hoặc hai câu là đủ."
          }
        }
      }
    },
    "Leave links out of the contact line. An email or a handle is enough.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pongas enlaces en el contacto. Basta con un correo o un nombre de usuario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de liens dans le contact : une adresse e-mail ou un pseudo suffit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte keine Links in der Kontaktzeile. Eine E-Mail-Adresse oder ein Name reicht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente link nel contatto: basta un’email o un nome utente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não ponhas ligações no contacto. Basta um e-mail ou um nome de utilizador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не указывайте ссылки в контактах. Достаточно почты или имени пользователя."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan letak pautan dalam baris hubungan. E-mel atau nama pengguna sudah memadai."
