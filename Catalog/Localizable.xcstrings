    "Recolor one key, or every letter at once.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkleur een sleutel, of elke letter op een slag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbe eine Taste um oder gleich alle Buchstaben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el color de una tecla o de todas las letras a la vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Värvi üks klahv ümber või kõik tähed korraga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change la couleur d’une touche ou de toutes les lettres d’un coup."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Színezz át egy billentyűt, vagy az összes betűt egyszerre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia colore a un tasto o a tutte le lettere insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー1つでも、文字キー全部でも色を変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 하나만, 또는 글자 키 전부를 한 번에 바꿔요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar warna satu kekunci, atau semua huruf sekali gus."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda a cor de uma tecla ou de todas as letras de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекрасьте одну клавишу или все буквы разом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改一个按键的颜色，或者一次改完所有字母。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Recolorează o tastă sau fiecare literă deodată."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleur één toets opnieuw in, of elke letter in één keer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改一個按鍵的顏色，或者一次改完所有字母。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokoloruj ponownie jeden klawisz lub każdą literę na raz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перефарбуйте одну клавішу або кожну букву відразу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tuşu veya her harfi aynı anda yeniden renklendirin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přebarvit jeden klíč nebo každé písmeno najednou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefarbite jeden kľúč alebo každé písmeno naraz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρωματίστε ξανά ένα πλήκτρο ή κάθε γράμμα ταυτόχρονα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändra färg på en tangent eller varje bokstav på en gång."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omfarv én tast eller hvert bogstav på én gang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Farg én tast på nytt, eller hver bokstav samtidig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Väritä yksi avain tai jokainen kirjain kerralla uudelleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnai ulang satu kunci, atau setiap huruf sekaligus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi màu một phím hoặc mỗi chữ cái cùng một lúc."
          }
        }
      }
    },
