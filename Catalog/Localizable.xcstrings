    "The light is holding still to protect performance. Presses still light up.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz permanece fija para mantener el rendimiento. Las pulsaciones siguen iluminándose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière reste fixe pour préserver les performances. Les touches s’allument toujours à l’appui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Licht bleibt unbewegt, um die Leistung zu schonen. Tastendrücke leuchten weiterhin auf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La luce resta ferma per preservare le prestazioni. I tasti si illuminano ancora alla pressione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A luz fica estática para preservar o desempenho. As teclas continuam a iluminar-se ao premir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсветка неподвижна для сохранения производительности. Нажатия по-прежнему подсвечиваются."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya tidak bergerak untuk mengekalkan prestasi. Kekunci masih menyala apabila ditekan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljesítmény megőrzése érdekében a fény nem mozog. A leütések továbbra is felvillannak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パフォーマンスを保つため、光の動きを止めています。キーを押したときの点灯は続きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为保持性能，灯光保持静止。按键按下时仍会亮起。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성능을 유지하기 위해 빛이 움직이지 않습니다. 키를 누르면 계속 빛납니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jõudluse hoidmiseks valgus ei liigu. Vajutused süütavad endiselt valguse."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumina rămâne nemișcată pentru a proteja performanța. Presele încă se aprind."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het licht blijft stil staan om de prestaties te beschermen. Drukken lichten nog steeds op."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為保持效能，燈光保持靜止。按鍵按下時仍會亮起。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lig bly konstant aan om werkverrigting te beskerm. Sleuteldrukke laat dit steeds lig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Światło pozostaje nieruchome, aby chronić wydajność. Prasy nadal się świecą."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Світло тримається нерухомо, щоб захистити продуктивність. Преси ще світяться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Performansı korumak için ışık sabit duruyor. Presler hala yanıyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Světlo nehybně drží, aby chránilo výkon. Lisy stále svítí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Svetlo nehybne drží, aby sa chránil výkon. Lisy stále svietia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το φως παραμένει ακίνητο για προστασία της απόδοσης. Τα πατήματα συνεχίζουν να ανάβουν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljuset håller stilla för att skydda prestanda. Pressar lyser fortfarande."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyset holder stille for at beskytte ydeevnen. Pressene lyser stadig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyset holder stille for å beskytte ytelsen. Trykkene lyser fortsatt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valo pysyy paikallaan suojatakseen suorituskykyä. Painekkeet palavat edelleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu tetap diam untuk melindungi kinerja. Mesin press masih menyala."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đèn được giữ yên để bảo vệ hiệu suất. Máy ép vẫn sáng."
          }
        }
      }
    },
    "The light takes the cap. Boldest look, and it overrules the theme.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lig vat die pet. Die sterkste voorkoms, en dit oorheers die tema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Licht übernimmt die Taste. Der kräftigste Look – und er setzt sich über das Theme hinweg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz se queda con la tecla. El look más intenso, y manda sobre el tema."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgus võtab kate endale. Kõige julgem ilme ja ta alistab teema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière prend la touche. Le rendu le plus marqué, et il l'emporte sur le thème."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fény átveszi a gombot. A legerősebb hatás, és felülírja a témát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La luce prende il tasto. L'effetto più deciso, e ha la meglio sul tema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光がキー面を占めます。もっとも大胆で、テーマより優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛이 키캡을 차지합니다. 가장 과감하고, 테마보다 우선합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya mengambil alih kekunci. Rupa paling berani, dan ia mengatasi tema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A luz fica com a tecla. O aspeto mais forte, e sobrepõe-se ao tema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свет заливает всю клавишу. Самый смелый вид — он перекрывает тему."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯光占据键帽。最张扬的效果，并会盖过主题。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumina ia capacul. Cel mai îndrăzneț aspect și anulează tema."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het licht neemt de dop over. De meest gedurfde look, en het overheerst het thema."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "燈光佔據鍵帽。最張揚的效果，並會蓋過主題。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Światło przejmuje czapkę. Najodważniejszy wygląd i unieważnia temat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Світло бере шапку. Найсміливіший вигляд, і він переважає над темою."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işık kapağı alır. En cesur görünüm, temayı geçersiz kılar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Světlo bere čepici. Nejodvážnější pohled a převažuje nad tématem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Svetlo berie čiapku. Najodvážnejší pohľad a prevažuje nad témou."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το φως παίρνει το καπάκι. Η πιο τολμηρή εμφάνιση και υπερισχύει του θέματος."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljuset tar kepsen. Djärvast utseende, och det åsidosätter temat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyset tager hætten. Det fedeste udseende, og det overstyrer temaet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyset tar hetten. Det dristigeste utseendet, og det overstyrer temaet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valo ottaa korkin. Rohkein ilme, ja se ohittaa teeman."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya mengambil alih. Tampilan paling berani, dan mengesampingkan tema."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ánh sáng lấy nắp. Cái nhìn táo bạo nhất và nó lấn át chủ đề."
          }
        }
      }
    },
    "The list came with word counts, so common words will be suggested first.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lys het met woordtellings gekom, so algemene woorde sal eerste voorgestel word."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste bringt Häufigkeiten mit – häufige Wörter werden zuerst vorgeschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista trae frecuencias, así que las palabras comunes se sugerirán primero."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loendis olid sõnade arvud, seega tavasõnu soovitatakse esimesena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste contient des fréquences : les mots courants seront proposés en premier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista tartalmaz gyakorisági számokat, így a gyakori szavak kerülnek előre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elenco include le frequenze, quindi le parole comuni verranno suggerite per prime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストに出現数が付いているので、よく使う語から候補に出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에 빈도 수치가 있어 자주 쓰는 단어가 먼저 추천됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai ini disertakan kiraan perkataan, jadi perkataan biasa akan dicadangkan dahulu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista traz frequências, por isso as palavras comuns aparecem primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В списке были частоты слов, поэтому частые слова будут предлагаться первыми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词表自带词频，常用词会优先出现在候选中。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista a venit cu un număr de cuvinte, astfel încât cuvintele comune vor fi sugerate mai întâi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lijst werd geleverd met het aantal woorden, dus algemene woorden worden eerst voorgesteld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詞表自帶詞頻，常用詞會優先出現在候選中。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista zawiera liczbę słów, więc w pierwszej kolejności zostaną zasugerowane popularne słowa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список містить кількість слів, тому загальні слова будуть запропоновані першими."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste kelime sayımlarıyla birlikte geldiğinden, ilk önce ortak kelimeler önerilecektir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seznam je dodáván s počty slov, takže běžná slova budou navržena jako první."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoznam je dodávaný s počtom slov, takže bežné slová budú navrhnuté ako prvé."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λίστα συνοδεύεται από πλήθος λέξεων, επομένως θα προταθούν πρώτα κοινές λέξεις."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Listan kom med ordräkningar, så vanliga ord kommer att föreslås först."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen kom med ordtælling, så almindelige ord vil blive foreslået først."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen kom med ordtelling, så vanlige ord vil bli foreslått først."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Listassa oli sanamäärät, joten yleisiä sanoja ehdotetaan ensin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar ini dilengkapi dengan jumlah kata, jadi kata-kata umum akan disarankan terlebih dahulu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách có kèm theo số từ nên những từ thông dụng sẽ được gợi ý trước."
          }
        }
      }
    },
    "The list is alphabetical with no counts, so every word carries equal weight. A list with counts after each word ranks better.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lys is alfabeties met geen tellings nie, so elke woord dra ewe veel gewig. 'n Lys met tellings na elke woord is beter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste ist alphabetisch und ohne Häufigkeiten, also wiegt jedes Wort gleich. Eine Liste mit Zahlen hinter den Wörtern sortiert besser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista está en orden alfabético y sin frecuencias, así que todas las palabras pesan igual. Una lista con un número tras cada palabra ordena mejor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loend on tähestikuline, ilma arvudeta, seega iga sõna kaalub võrdselt. Loend sõna järel olevate arvudega järjestab paremini."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste est alphabétique et sans fréquences : tous les mots ont le même poids. Une liste avec un nombre après chaque mot donne un meilleur classement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista ábécérendben van, gyakoriságok nélkül, így minden szó azonos súlyú. A szavak után írt számokkal jobb lenne a sorrend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elenco è in ordine alfabetico e senza frequenze, quindi ogni parola pesa uguale. Un elenco con un numero dopo ogni parola ordina meglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストは五十音・アルファベット順で出現数がないため、すべての語が同じ重みになります。語の後ろに数値があるリストなら候補順が良くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록이 사전순이고 빈도가 없어 모든 단어의 가중치가 같습니다. 단어 뒤에 숫자가 있는 목록이 순서가 더 좋습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai ini mengikut abjad tanpa kiraan, jadi semua perkataan sama berat. Senarai dengan nombor selepas setiap perkataan menyusun lebih baik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista está por ordem alfabética e sem frequências, por isso todas as palavras pesam o mesmo. Uma lista com um número depois de cada palavra ordena melhor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список отсортирован по алфавиту и без частот, поэтому все слова равнозначны. Список с числом после каждого слова ранжируется лучше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词表按字母顺序排列且没有词频，因此每个词权重相同。词后带数字的词表排序更好。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista este alfabetică, fără numărătoare, astfel încât fiecare cuvânt are o greutate egală. O listă cu numărătoare după fiecare cuvânt se clasează mai bine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lijst is alfabetisch en telt niet mee, zodat elk woord even zwaar weegt. Een lijst met tellingen na elk woord scoort beter."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詞表按字母順序排列且沒有詞頻，因此每個詞權重相同。詞後帶數字的詞表排序更好。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista jest alfabetyczna, bez liczników, więc każde słowo ma taką samą wagę. Lista z licznikiem po każdym słowie ma lepszą pozycję w rankingu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список складається за алфавітом без підрахунку, тому кожне слово має однакову вагу. Список із підрахунками після кожного слова має кращий рейтинг."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste alfabetik olup sayım yapılmamaktadır, dolayısıyla her kelime eşit ağırlıktadır. Her kelimeden sonra sayıların yer aldığı bir liste daha iyi sıralanır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seznam je abecedně bez počítání, takže každé slovo má stejnou váhu. Seznam s počty za každým slovem má lepší hodnocení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoznam je abecedný bez počtu, takže každé slovo má rovnakú váhu. Zoznam s počtami po každom slove má lepšie hodnotenie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λίστα είναι αλφαβητική χωρίς μετρήσεις, επομένως κάθε λέξη έχει την ίδια βαρύτητα. Μια λίστα με μετρήσεις μετά από κάθε λέξη κατατάσσεται καλύτερα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Listan är alfabetisk utan räkningar, så varje ord väger lika mycket. En lista med antal efter varje ord rankas bättre."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen er alfabetisk uden tæller, så hvert ord vejer lige meget. En liste med tæller efter hvert ord rangerer bedre."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen er alfabetisk uten tellinger, så hvert ord har lik vekt. En liste med tellinger etter hvert ord rangerer bedre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luettelo on aakkosellinen, eikä siinä ole lukuja, joten jokaisella sanalla on yhtä suuri painoarvo. Luettelo, jossa lukemat jokaisen sanan jälkeen on parempi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftarnya disusun berdasarkan abjad tanpa hitungan, sehingga setiap kata memiliki bobot yang sama. Daftar dengan jumlah setelah setiap kata memiliki peringkat yang lebih baik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách này được sắp xếp theo thứ tự bảng chữ cái và không có số đếm nên mỗi từ đều có trọng lượng như nhau. Một danh sách có số đếm sau mỗi từ sẽ xếp hạng tốt hơn."
          }
        }
      }
    },
    "The list of installed plugins lives in Clink's shared storage, and the keyboard can only reach it with Full Access. Until it's on, the switcher stays out of the Tools menu.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de plugins instalados vive en el almacenamiento compartido de Clink, y el teclado solo llega a ella con acceso completo. Hasta que lo actives, el cambio de plugins no aparece en el menú Herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des plugins installés vit dans le stockage partagé de Clink, et le clavier n'y accède qu'avec l'accès complet. Tant qu'il est désactivé, le changeur reste hors du menu Outils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste der installierten Plugins liegt in Clinks gemeinsamem Speicher, und die Tastatur kommt nur mit Vollzugriff daran. Bis der an ist, bleibt der Umschalter aus dem Werkzeuge-Menü draußen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco dei plugin installati vive nella memoria condivisa di Clink, e la tastiera ci arriva solo con l'accesso completo. Finché è spento, il cambio plugin resta fuori dal menu Strumenti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de plugins instalados vive no armazenamento partilhado do Clink, e o teclado só lhe chega com acesso total. Enquanto estiver desligado, a troca de plugins fica fora do menu Ferramentas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список установленных плагинов лежит в общем хранилище Clink, а клавиатура добирается до него только при полном доступе. Пока он выключен, переключателя в меню инструментов не будет."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai plugin yang dipasang berada dalam storan kongsi Clink, dan papan kekunci hanya boleh mencapainya dengan akses penuh. Selagi ia belum dihidupkan, penukar itu tak muncul dalam menu Alat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telepített bővítmények listája a Clink megosztott tárhelyén van, és a billentyűzet csak teljes hozzáféréssel fér hozzá. Amíg ez ki van kapcsolva, a váltó nem kerül be az Eszközök menübe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みプラグインの一覧は Clink の共有ストレージにあり、キーボードはフルアクセスがないとそこに届きません。オンにするまで、切り替えはツールメニューに出てきません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装插件的列表存在 Clink 的共享存储里，而键盘只有拿到完全访问才够得着。没打开之前，切换器不会出现在工具菜单里。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 플러그인 목록은 Clink의 공유 저장소에 있어서, 키보드는 전체 접근이 있어야 닿을 수 있습니다. 켜기 전까지는 전환 도구가 도구 메뉴에 나오지 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paigaldatud pistikprogrammide loend asub Clinki jagatud salvestusruumis ja klaviatuur jõuab sinna ainult täisjuurdepääsuga. Enne kui see on sees, jääb vahetaja Tööriistade menüüst välja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista pluginurilor instalate se află în spațiul de stocare partajat al lui Clink, iar tastatura o poate accesa doar cu Acces complet. Până când este pornit, comutatorul rămâne în afara meniului Instrumente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lijst met geïnstalleerde plug-ins bevindt zich in de gedeelde opslag van Clink en het toetsenbord kan deze alleen bereiken met volledige toegang. Zolang deze niet is ingeschakeld, blijft de switcher buiten het menu Extra."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝外掛的列表存在 Clink 的共享儲存裡，而鍵盤只有拿到完整取用才夠得著。沒開啟之前，切換器不會出現在工具選單裡。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lys geïnstalleerde inproppe word in Clink se gedeelde berging gehou, en die sleutelbord kan slegs toegang daartoe verkry met volle toegang. Totdat dit geaktiveer is, verskyn die skakelaar nie in die Gereedskap-kieslys nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista zainstalowanych wtyczek znajduje się we współdzielonej pamięci Clink, a klawiatura może do niej dotrzeć tylko przy pełnym dostępie. Dopóki nie jest włączony, przełącznik pozostaje poza menu Narzędzia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список встановлених плагінів знаходиться у спільному сховищі Clink, і клавіатура може отримати доступ до нього лише за допомогою повного доступу. Поки його не ввімкнено, перемикач залишається поза меню «Інструменти»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü eklentilerin listesi Clink'in paylaşılan depolama alanında bulunur ve klavye buna yalnızca Tam Erişim ile erişebilir. Açılana kadar değiştirici Araçlar menüsünün dışında kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seznam nainstalovaných pluginů žije ve sdíleném úložišti Clink a klávesnice se k němu dostane pouze s Full Access. Dokud přepínač není zapnutý, zůstane mimo nabídku Nástroje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoznam nainštalovaných doplnkov žije v zdieľanom úložisku Clink a klávesnica sa k nemu dostane iba s úplným prístupom. Kým nie je zapnutý, prepínač zostane mimo ponuky Nástroje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λίστα των εγκατεστημένων προσθηκών βρίσκεται στον κοινόχρηστο χώρο αποθήκευσης του Clink και το πληκτρολόγιο μπορεί να φτάσει σε αυτόν μόνο με πλήρη πρόσβαση. Μέχρι να ενεργοποιηθεί, ο διακόπτης παραμένει εκτός του μενού Εργαλεία."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Listan över installerade plugins finns i Clink:s delade lagring, och tangentbordet kan bara nå den med Full Access. Omkopplaren förblir borta från menyn Verktyg tills den är på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen over installerede plugins findes i Clink's delte lager, og tastaturet kan kun nå det med fuld adgang. Indtil den er tændt, forbliver switcheren ude af menuen Værktøjer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen over installerte plugins finnes i Clinks delte lagring, og tastaturet kan bare nå den med full tilgang. Inntil den er på, forblir bryteren utenfor Verktøy-menyen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luettelo asennetuista laajennuksista on Clink:n jaetussa tallennustilassa, ja näppäimistö pääsee siihen vain Full Accessilla. Kunnes se on päällä, kytkin pysyy pois Työkalut-valikosta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar plugin yang diinstal ada di penyimpanan bersama Clink, dan keyboard hanya dapat menjangkaunya dengan Akses Penuh. Hingga aktif, pengalih tetap berada di luar menu Alat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách các plugin đã cài đặt nằm trong bộ nhớ dùng chung của Clink và bàn phím chỉ có thể truy cập nó bằng Quyền truy cập đầy đủ. Cho đến khi nó được bật, trình chuyển đổi vẫn nằm ngoài menu Công cụ."
          }
        }
      }
    },
    "The mark the double-space shortcut writes.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die merk wat die dubbelspasie-kortpad skryf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zeichen, das die Leertasten-Abkürzung schreibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El signo que escribe el atajo del doble espacio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märk, mille topelttühiku otsetee sisestab."
          }
        },
        "fr": {
