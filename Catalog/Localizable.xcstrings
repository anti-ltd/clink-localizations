    "Your cursor demo, shown live. Swipe it to change movement style.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou wyser-demo, regstreeks gewys. Swiep dit om bewegingstyl te verander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Cursor-Demo, live. Wisch darüber, um die Bewegungsart zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu demo del cursor, en directo. Deslízala para cambiar el modo de movimiento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu kursori demo, reaalajas. Viipa sellel, et liikumisstiili vahetada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta démo du curseur, en direct. Balaie-la pour changer le mode de déplacement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kurzor demó élőben. Húzd el az ujjad rajta a mozgatás módjának váltásához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La demo del cursore, dal vivo. Scorrila per cambiare modalità di movimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルのデモです。スワイプすると移動方式を変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서 데모를 실시간으로 보여 줍니다. 밀어서 이동 방식을 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo kursor anda, secara langsung. Leret untuk tukar cara pergerakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua demo do cursor, ao vivo. Desliza-a para mudar o modo de movimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Демо курсора вживую. Смахните, чтобы сменить способ перемещения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标演示实时展示。左右滑动即可切换移动方式。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Demostrația cursorului dvs., afișată în direct. Glisați-l pentru a schimba stilul de mișcare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw cursordemo, live getoond. Veeg erover om de bewegingsstijl te wijzigen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "游標演示實時展示。左右滑動即可切換移動方式。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prezentacja kursora pokazana na żywo. Przesuń, aby zmienić styl ruchu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Демонстрація вашого курсору, показана в реальному часі. Проведіть по ньому, щоб змінити стиль руху."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmleç demonuz canlı olarak gösterilir. Hareket stilini değiştirmek için kaydırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše ukázka kurzoru zobrazená živě. Přejetím prstem změníte styl pohybu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukážka vášho kurzora zobrazená naživo. Potiahnutím prstom zmeníte štýl pohybu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επίδειξη του δρομέα σας, εμφανίζεται ζωντανά. Σύρετε το για να αλλάξετε το στυλ κίνησης."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din markördemo visas live. Svep den för att ändra rörelsestil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din markørdemo, vist live. Stryg den for at ændre bevægelsesstil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din markørdemo, vist live. Sveip den for å endre bevegelsesstil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursorisi demo, näytetään livenä. Pyyhkäise sitä vaihtaaksesi liiketyyliä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo kursor Anda, ditampilkan secara langsung. Gesek untuk mengubah gaya gerakan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản demo con trỏ của bạn, được hiển thị trực tiếp. Vuốt nó để thay đổi phong cách chuyển động."
          }
        }
      }
    },
