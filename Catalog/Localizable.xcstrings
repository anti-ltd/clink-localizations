          "stringUnit": {
            "state": "translated",
            "value": "Kalkulačka sedí na klávesnici a dává výsledek přímo do toho, co píšete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkulačka sedí na klávesnici a vkladá výsledok priamo do toho, čo píšete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αριθμομηχανή κάθεται στο πληκτρολόγιο και ρίχνει το αποτέλεσμα κατευθείαν σε αυτό που γράφετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Miniräknare sitter i tangentbordet och släpper resultatet rakt in i det du skriver."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lommeregner sidder på tastaturet og sætter resultatet direkte ind i det, du skriver."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkulator sitter på tastaturet og slipper resultatet rett inn i det du skriver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laskin on näppäimistössä ja pudottaa tuloksen suoraan kirjoittamaasi tekstiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkulator berada di keyboard dan memasukkan hasilnya langsung ke apa yang Anda tulis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy tính nằm trong bàn phím và đưa kết quả thẳng vào nội dung bạn đang viết."
          }
        }
      }
    },
    "Calculators, snippet boards, pickers: your panels appear behind the keyboard's panel button.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakrekenaars, brokkieborde, kiesers: jou panele verskyn agter die sleutelbord se paneelknoppie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taschenrechner, Snippet-Boards, Picker: deine Panels erscheinen hinter der Panel-Taste der Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculadoras, tableros de fragmentos, selectores: tus paneles aparecen detrás del botón de panel del teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkulaatorid, nippide tahvlid, valijad: sinu paneelid ilmuvad klaviatuuri paneelinupu taha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculatrices, tableaux de snippets, sélecteurs : tes panneaux apparaissent derrière le bouton de panneau du clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Számológépek, snippet-táblák, választók: a paneljeid a billentyűzet panel gombja mögött jelennek meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolatrici, bacheche di snippet, selettori: i tuoi pannelli compaiono dietro il pulsante pannelli della tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電卓、スニペット集、ピッカー。あなたのパネルはキーボードのパネルボタンの奥に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산기, 스니펫 모음, 피커: 내가 만든 패널은 키보드의 패널 버튼 뒤에 나타나요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkulator, papan snippet, pemilih: panel anda muncul di sebalik butang panel papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculadoras, quadros de snippets, seletores: os teus painéis aparecem atrás do botão de painel do teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Калькуляторы, доски заготовок, списки выбора — ваши панели появляются за кнопкой панелей на клавиатуре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算器、代码片段板、选择器：你的面板会出现在键盘面板按钮后面。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculatoare, panouri de fragmente, selectoare: panourile dvs. apar în spatele butonului panoului de pe tastatură."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekenmachines, fragmentborden, pickers: uw panelen verschijnen achter de paneelknop van het toetsenbord."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算器、程式碼片段板、選擇器：你的面板會出現在鍵盤面板按鈕後面。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkulatory, tablice fragmentów, selektory: Twoje panele pojawiają się za przyciskiem panelu klawiatury."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Калькулятори, панелі фрагментів, засоби вибору: ваші панелі відображаються за кнопкою панелі клавіатури."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap makineleri, snippet panoları, seçiciler: Panelleriniz klavyenin panel düğmesinin arkasında görünür."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkulačky, nástěnky úryvků, výběry: vaše panely se zobrazují za tlačítkem panelu klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkulačky, tabule s úryvkami, výbery: vaše panely sa zobrazujú za tlačidlom panela klávesnice."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αριθμομηχανές, πίνακες αποσπασμάτων, επιλογείς: τα πάνελ σας εμφανίζονται πίσω από το κουμπί του πίνακα του πληκτρολογίου."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Miniräknare, utdragstavlor, väljare: dina paneler visas bakom tangentbordets panelknapp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Regnemaskiner, uddragstavler, vælgere: dine paneler vises bag tastaturets panelknap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkulatorer, utdragstavler, velgere: panelene dine vises bak panelknappen på tastaturet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laskimet, katkelmataulut, poimijat: paneelisi näkyvät näppäimistön paneelipainikkeen takana."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkulator, papan cuplikan, pemilih: panel Anda muncul di belakang tombol panel keyboard."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy tính, bảng đoạn mã, bộ chọn: bảng của bạn xuất hiện phía sau nút bảng điều khiển của bàn phím."
          }
        }
      }
    },
