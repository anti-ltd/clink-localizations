    "Open Themes and tap one. The preview above changes as you go.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Themes und tippe auf eines. Die Vorschau darüber zeigt deine Auswahl sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Temas y toca uno. La vista previa de arriba cambia con cada selección."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava „Teemad” ja puuduta üht teemat. Ülal olev eelvaade muutub koos sinu valikuga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Thèmes et touche un thème. L’aperçu au-dessus change à chaque sélection."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Témák oldalt, és koppints egy témára. A fenti előnézet rögtön követi a választásodat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Temi e toccane uno. L’anteprima in alto cambia a ogni scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「テーマ」を開き、使いたいテーマをタップします。選ぶたびに上のプレビューが変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘테마’를 열고 원하는 테마를 탭하세요. 선택할 때마다 위쪽 미리 보기가 바뀝니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Tema dan ketik satu tema. Pratonton di atas berubah mengikut pilihan anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Temas e toca num tema. A pré-visualização acima muda a cada seleção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Темы» и нажмите на одну из них. Предпросмотр сверху сразу покажет изменения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“主题”，轻点一个主题。上方的预览会随选择即时更新。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide Teme și atinge una. Previzualizarea de mai sus se schimbă pe măsură ce mergeți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Thema's en tik op één. Het bovenstaande voorbeeld verandert gaandeweg."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟“主題”，輕點一個主題。上方的預覽會隨選擇即時更新。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak Temas oop en tik een. Die voorskou hierbo verander soos jy aangaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Motywy i dotknij jednego. Powyższy podgląd zmienia się w miarę upływu czasu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Теми та торкніться однієї. Попередній перегляд вище змінюється по ходу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temalar'ı açın ve bir tanesine dokunun. Yukarıdaki önizleme siz ilerledikçe değişir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete Motivy a klepněte na jeden. Náhled výše se průběžně mění."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte Témy a klepnite na jednu. Vyššie uvedený náhľad sa priebežne mení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε τα Θέματα και πατήστε ένα. Η παραπάνω προεπισκόπηση αλλάζει καθώς προχωράτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna teman och tryck på ett. Förhandsvisningen ovan ändras allt eftersom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn temaer, og tryk på et. Forhåndsvisningen ovenfor ændres, mens du går."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne temaer og trykk på ett. Forhåndsvisningen ovenfor endres mens du går."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Teemat ja napauta yhtä. Yllä oleva esikatselu muuttuu edetessäsi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Tema dan ketuk salah satu. Pratinjau di atas berubah seiring berjalannya waktu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Chủ đề và nhấn vào một chủ đề. Bản xem trước ở trên sẽ thay đổi khi bạn thực hiện."
          }
        }
      }
    },
