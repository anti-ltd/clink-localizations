        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trageți pentru a reordona sau atingeți minusul pentru a scoate ceva."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om de volgorde te wijzigen, of tik op het minteken om iets eruit te halen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動以重新排序，或輕點減號移除專案。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om te herskik, of tik die min om iets uit te haal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zmienić kolejność, lub dotknij minusa, aby coś wyjąć."
