    "Choose Allow, and iOS stops asking.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies Laat toe, en iOS hou op vra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf „Erlauben“ stellen, dann fragt iOS nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige «Permitir» y iOS deja de preguntar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali Luba ja iOS lõpetab küsimise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis « Autoriser » et iOS arrête de demander."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd az „Engedélyezés” lehetőséget, és az iOS nem kérdez többet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli «Consenti» e iOS smette di chiedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「許可」を選べば、iOSは確認しなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘허용’을 선택하면 iOS가 더 이상 묻지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih “Benarkan”, dan iOS berhenti bertanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
