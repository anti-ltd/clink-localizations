    "Stops the light getting bright enough to swallow the letter on the key. Turn off for the boldest color.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Keer dat die lig helder genoeg word om die letter op die sleutel te sluk. Skakel af vir die sterkste kleur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass das Licht so hell wird, dass es den Buchstaben auf der Taste verschluckt. Aus für die kräftigste Farbe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que la luz sea tan intensa que se coma la letra de la tecla. Desactívalo para el color más intenso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoiab ära, et valgus muutuks nii eredaks, et see neelaks klahvil oleva tähe. Lülita välja kõige julgema värvi jaoks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche la lumière de devenir si vive qu'elle avale la lettre sur la touche. Désactivez pour la couleur la plus intense."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megakadályozza, hogy a fény elnyomja a gombon lévő betűt. Kapcsold ki a legerősebb színért."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita che la luce diventi così intensa da inghiottire la lettera sul tasto. Disattiva per il colore più intenso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの文字が光に飲まれない明るさに抑えます。オフにすると最も鮮やかな色になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛이 키의 글자를 삼킬 만큼 밝아지지 않게 합니다. 끄면 색이 가장 진해집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghalang cahaya menjadi terlalu terang sehingga menelan huruf pada kekunci. Matikan untuk warna paling berani."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede que a luz fique tão intensa que engula a letra da tecla. Desliga para a cor mais intensa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не даёт свету стать настолько ярким, чтобы поглотить букву на клавише. Выключите для самого насыщенного цвета."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免灯光亮到吞掉按键上的字母。关闭可获得最浓的色彩。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprește lumina să devină suficient de strălucitoare pentru a înghiți litera de pe cheie. Opriți pentru cea mai îndrăzneață culoare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorgt ervoor dat het licht niet helder genoeg wordt om de letter op de sleutel in te slikken. Schakel uit voor de meest opvallende kleur."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "避免燈光亮到吞掉按鍵上的字母。關閉可獲得最濃的色彩。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymuje światło, które staje się wystarczająco jasne, aby połknąć literę na klawiszu. Wyłącz, aby uzyskać najodważniejszy kolor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиняє світло яскравим, щоб проковтнути літеру на ключі. Вимкніть для найсміливішого кольору."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işığın, anahtarın üzerindeki harfi yutacak kadar parlak olmasını engeller. En koyu renk için kapatın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví světlo dostatečně jasné, aby spolklo písmeno na klíči. Vypněte pro nejvýraznější barvu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops the light getting bright enough to swallow the letter on the key. Vypnite pre najvýraznejšiu farbu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σταματά το φως να γίνεται αρκετά φωτεινό ώστε να καταπιεί το γράμμα στο κλειδί. Απενεργοποιήστε το για το πιο τολμηρό χρώμα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindrar att ljuset blir tillräckligt starkt för att svälja bokstaven på nyckeln. Stäng av för den djärvaste färgen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopper lyset med at blive skarpt nok til at sluge bogstavet på nøglen. Sluk for den fedeste farve."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindrer at lyset blir sterkt nok til å svelge bokstaven på nøkkelen. Slå av for den dristigeste fargen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Estää valon tulemasta tarpeeksi kirkkaaksi nielemään avaimen kirjaimen. Kytke pois päältä saadaksesi rohkeimman värin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghentikan cahaya menjadi cukup terang untuk menelan huruf pada kunci. Matikan untuk warna paling berani."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngăn ánh sáng đủ sáng để nuốt chữ cái trên phím. Tắt để có màu đậm nhất."
          }
        }
      }
    },
