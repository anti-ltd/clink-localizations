    "Anon tap data makes accuracy better over time": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Anon tap-data maak akkuraatheid mettertyd beter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme Tippdaten machen die Genauigkeit mit der Zeit besser"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos anónimos de toques mejoran la precisión con el tiempo"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonüümsed vajutusandmed parandavad täpsust aja jooksul"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des données de frappe anonymes améliorent la précision avec le temps"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A névtelen koppintási adatok idővel javítják a pontosságot"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati anonimi sui tocchi migliorano la precisione col tempo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名のタップデータで、精度がだんだん良くなります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "익명 탭 데이터로 시간이 지날수록 정확도가 좋아져요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data ketikan tanpa nama buat ketepatan lebih baik dari masa ke masa"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados de toque anónimos melhoram a precisão ao longo do tempo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анонимные данные о нажатиях со временем повышают точность"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名点按数据让准确度随时间变好"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele Anon de la atingere îmbunătățesc precizia în timp"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anon-tapgegevens zorgen ervoor dat de nauwkeurigheid in de loop van de tijd verbetert"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名點按資料讓準確度隨時間變好"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane z dotknięcia Anon zwiększają dokładność w miarę upływu czasu"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Анональні дані кранів з часом покращують точність"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anon musluk verileri zaman içinde doğruluğu daha iyi hale getirir"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Anon tap data zvyšují přesnost v průběhu času"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vďaka anonovým údajom je presnosť postupom času lepšia"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δεδομένα Anon Tap βελτιώνουν την ακρίβεια με την πάροδο του χρόνου"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anon tap-data gör noggrannheten bättre över tid"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anon tap-data gør nøjagtigheden bedre over tid"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anon tap-data gjør nøyaktigheten bedre over tid"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonin napautustiedot parantavat tarkkuutta ajan myötä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data ketukan langsung membuat akurasi menjadi lebih baik dari waktu ke waktu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu nhấn của Anon giúp độ chính xác tốt hơn theo thời gian"
          }
        }
      }
    },
    "Another keyboard keeps coming up instead": {
