    "Teach it the word once and it stops.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer dit die woord een keer en dit stop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring ihm das Wort einmal bei, dann hört es auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enséñale la palabra una vez y dejará de hacerlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Õpeta talle see sõna üks kord ja ta lõpetab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprends-lui le mot une fois et ça s'arrête."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanítsd meg neki egyszer a szót, és abbahagyja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Insegnagli la parola una volta e smette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その単語を一度覚えさせれば、直されなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 단어를 한 번 알려 주면 더는 고치지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajar perkataan itu sekali dan ia akan berhenti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensina-lhe a palavra uma vez e deixa de acontecer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Научите его этому слову один раз — и он перестанет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教它一次这个词，就不会再改了。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Învață-i cuvântul o dată și se oprește."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer hem het woord één keer en hij stopt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "教它一次這個詞，就不會再改了。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naucz go raz tego słowa, a przestanie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навчіть його слова один раз, і воно зупиниться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ona bu kelimeyi bir kez öğrettiğinizde durur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naučte to slovo jednou a přestane to."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naučte to slovo raz a prestane to."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διδάξτε του τη λέξη μια φορά και σταματά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lär den ordet en gång och det slutar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lær det ordet én gang, og det stopper."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lær det ordet én gang, og det stopper."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Opettele sille sana kerran ja se pysähtyy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajari dia kata itu sekali dan dia akan berhenti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dạy nó từ đó một lần và nó dừng lại."
          }
        }
      }
    },
