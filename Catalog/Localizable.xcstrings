    "Bring a word list for a language Clink doesn’t ship, or add extra vocabulary to one it does. The file stays on this device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring eine Wortliste für eine Sprache mit, die Clink nicht mitliefert – oder ergänze den Wortschatz einer vorhandenen. Die Datei bleibt auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae una lista de palabras para un idioma que Clink no incluye, o añade vocabulario a uno que sí. El archivo se queda en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apporte une liste de mots pour une langue que Clink ne fournit pas, ou enrichis le vocabulaire d’une langue existante. Le fichier reste sur cet appareil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozz szólistát olyan nyelvhez, amit a Clink nem tartalmaz, vagy bővítsd egy meglévő nyelv szókincsét. A fájl ezen az eszközön marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta un elenco di parole per una lingua che Clink non include, o aggiungi vocaboli a una che c’è già. Il file resta su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink に入っていない言語の単語リストを読み込んだり、入っている言語に語彙を足したりできます。ファイルはこの端末から出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink에 없는 언어의 단어 목록을 가져오거나, 이미 있는 언어에 어휘를 더할 수 있습니다. 파일은 이 기기에만 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawa senarai perkataan untuk bahasa yang tiada dalam Clink, atau tambah kosa kata pada bahasa sedia ada. Fail itu kekal pada peranti ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traz uma lista de palavras para um idioma que o Clink não inclui, ou acrescenta vocabulário a um que já existe. O ficheiro fica neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принесите список слов для языка, которого нет в Clink, или добавьте лексику к уже имеющемуся. Файл остаётся на этом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Clink 未收录的语言导入词表，或给已有语言补充词汇。文件只留在这台设备上。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Too kaasa sõnaloend keele jaoks, mida Clink ei paku, või lisa täiendav sõnavara keelele, mida ta pakub. Fail jääb sellesse seadmesse."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bring 'n woordelys vir 'n taal wat Clink nie stuur nie, of voeg ekstra woordeskat by een wat dit wel doen. Die lêer bly op hierdie toestel."
          }
        }
      }
    },
