    "Your typing stats are computed locally and never leave your phone. Nothing is uploaded, shared, or sold.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus estadísticas de escritura se calculan en el dispositivo y nunca salen de tu iPhone. No se sube, comparte ni vende nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes statistiques de frappe sont calculées sur l'appareil et ne quittent jamais ton iPhone. Rien n'est envoyé, partagé ou vendu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tippstatistiken werden lokal berechnet und verlassen nie dein iPhone. Nichts wird hochgeladen, geteilt oder verkauft."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le statistiche di scrittura vengono calcolate sul dispositivo e non lasciano mai il tuo iPhone. Nulla viene caricato, condiviso o venduto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As estatísticas de escrita são calculadas no dispositivo e nunca saem do teu iPhone. Nada é enviado, partilhado ou vendido."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik menaip dikira secara setempat dan tidak pernah keluar daripada iPhone anda. Tiada apa-apa dimuat naik, dikongsi atau dijual."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gépelési statisztikák helyben készülnek, és sosem hagyják el az iPhone-odat. Semmit sem töltünk fel, osztunk meg vagy adunk el."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力統計はデバイス上で計算され、iPhoneの外に出ることはありません。アップロード、共有、販売は一切行いません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入统计数据在设备本地计算，绝不会离开你的 iPhone。不会上传、共享或出售任何内容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 통계는 기기에서 계산되며 iPhone 밖으로 나가지 않아요. 업로드하거나 공유하거나 판매하지 않아요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu tipimisstatistika arvutatakse lokaalselt ega lahku kunagi sinu telefonist. Midagi ei laadita üles, ei jagata ega müüda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша статистика набора вычисляется локально и никогда не покидает телефон. Ничего не загружается, не передаётся и не продаётся."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou tikstatistieke word plaaslik bereken en verlaat nooit jou foon nie. Niks word opgelaai, gedeel of verkoop nie."
          }
        }
      }
    },
    "Your whole setup travels as one file. Save it, share it, bring it back anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine ganze Einrichtung reist als eine Datei. Sichern, teilen und überall wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda tu configuración viaja en un solo archivo: guárdala, compártela y recupérala donde quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute ta config tient dans un seul fichier. Enregistre-le, partage-le, restaure-le où tu veux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egész beállításod egyetlen fájlban utazik. Mentsd el, oszd meg, és állítsd vissza bárhol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutta la tua configurazione viaggia in un unico file. Salvalo, condividilo, ripristinalo ovunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定はまるごと1つのファイルに。保存して、共有して、どこでも元どおりにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 전체가 파일 하나로 움직여요. 저장하고, 공유하고, 어디서든 다시 불러오세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh persediaan anda bergerak sebagai satu fail. Simpan, kongsi, dan pulihkan di mana-mana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda a tua configuração viaja num único ficheiro. Guarda-o, partilha-o e recupera-o em qualquer lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вся ваша настройка переезжает одним файлом. Сохраните его, поделитесь им, верните где угодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的整套设置就是一个文件，保存、分享，随处找回。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu terve seadistus reisib ühe failina. Salvesta, jaga ja too kusagil tagasi."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou hele opstelling reis as een lêer. Stoor dit, deel dit, bring dit enige plek terug."
          }
        }
      }
    },
