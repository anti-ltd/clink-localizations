        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随上方的全局设置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위의 전체 설정을 따라요."
          }
