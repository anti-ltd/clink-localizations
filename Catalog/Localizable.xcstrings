    "Gboard and SwiftKey exports work too, zipped or not.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte aus Gboard und SwiftKey funktionieren auch, gezippt oder nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También sirven las exportaciones de Gboard y SwiftKey, comprimidas o no."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka Gboardi ja SwiftKey eksportfailid sobivad, pakitud või mitte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exports Gboard et SwiftKey fonctionnent aussi, compressés ou non."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gboard és a SwiftKey exportjai is működnek, tömörítve vagy anélkül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funzionano anche le esportazioni di Gboard e SwiftKey, compresse o no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gboard や SwiftKey の書き出しファイルも使えます（zip でも可）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gboard와 SwiftKey에서 내보낸 파일도 압축 여부와 관계없이 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksport Gboard dan SwiftKey juga berfungsi, dizip atau tidak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As exportações do Gboard e do SwiftKey também funcionam, comprimidas ou não."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспорт из Gboard и SwiftKey тоже подойдёт, в архиве или без."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gboard 和 SwiftKey 的导出文件也可以，压缩与否均可。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporturile Gboard și SwiftKey funcționează și ele, arhivate sau nu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gboard- en SwiftKey-exports werken ook, gezipt of niet."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Gboard 和 SwiftKey 的匯出檔案也可以，壓縮與否均可。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gboard en SwiftKey-uitvoere werk ook, saamgepers of nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksport z Gboard i SwiftKey też działa, niezależnie od tego, czy jest spakowany, czy nie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експорт Gboard і SwiftKey також працює, заархівовано чи ні."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
