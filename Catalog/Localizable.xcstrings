        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть 40pt, щоб видалити, 60pt на слово. Важко викликати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silmek için 40pt, kelime başına 60pt sürükleyin. Tetiklenmesi zor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetažením 40 bodů smažete, 60 bodů na slovo. Těžko spustitelný."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnutím 40 bodov odstránite, 60 bodov na slovo. Ťažko sa spúšťa."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε 40 pt για διαγραφή, 60 pt ανά λέξη. Δύσκολο να πυροδοτηθεί."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra 40 pkt för att radera, 60 pkt per ord. Svårt att trigga."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk 40 pt for at slette, 60 pkt pr. ord. Svært at udløse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra 40 pkt for å slette, 60 pkt per ord. Vanskelig å utløse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista vetämällä 40 pt, 60 pt per sana. Vaikea laukaista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret 40pt untuk menghapus, 60pt per kata. Sulit untuk dipicu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo 40pt để xóa, 60pt mỗi từ. Khó kích hoạt."
          }
        }
      }
    },
    "Drag Press linger down to nothing.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep Druk bly tot niks."
          }
        },
        "de": {
