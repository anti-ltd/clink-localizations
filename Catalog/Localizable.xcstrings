            "value": "Der blev ikke fundet nogen brugbare ord i den fil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen brukbare ord i den filen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tästä tiedostosta ei löytynyt käyttökelpoisia sanoja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ditemukan kata-kata yang dapat digunakan dalam file itu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy từ nào có thể sử dụng được trong tập tin đó."
          }
        }
      }
    },
    "No way in yet. Switch on the Tools button, or add a Tools key to your layout.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen pad in nie. Skakel die Tools-knoppie aan, of voeg 'n Tools-sleutel by jou uitleg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Zugang. Aktiviere die Werkzeug-Taste in der Leiste oder füge deinem Layout eine Werkzeug-Taste hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso: activa el botón de herramientas o añade una tecla de herramientas a tu diseño."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisenemist veel pole. Lülita sisse tööriistade nupp või lisa oma paigutusse tööriistaklahv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun accès pour l’instant. Active le bouton Outils ou ajoute une touche Outils à ta disposition."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyelőre nincs bejárat. Kapcsold be az Eszközök gombot, vagy tegyél egy Eszközök gombot az elrendezésedbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso: attiva il pulsante Strumenti o aggiungi un tasto Strumenti al tuo layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開く手段がありません。ツールボタンをオンにするか、レイアウトにツールキーを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들어갈 방법이 없습니다. 도구 버튼을 켜거나 레이아웃에 도구 키를 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada cara masuk. Hidupkan butang Alatan, atau tambah kekunci Alatan pada susun atur anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem forma de entrar. Ative o botão de ferramentas ou adicione uma tecla de ferramentas ao seu esquema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет способа туда попасть. Включите кнопку инструментов или добавьте клавишу инструментов в раскладку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有入口。请打开工具按钮，或在布局中添加一个工具键。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu intra. Activați butonul Instrumente sau adăugați o cheie Instrumente la aspectul dvs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen toegang. Schakel de knop Extra in of voeg een toets Tools toe aan uw lay-out."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有入口。請開啟工具按鈕，或在佈局中新增一個工具鍵。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze możliwości wejścia. Włącz przycisk Narzędzia lub dodaj klawisz Narzędzia do swojego układu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще немає шляху. Увімкніть кнопку Інструменти або додайте клавішу Інструменти до свого макета."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz giriş yok. Araçlar düğmesini açın veya düzeninize bir Araçlar tuşu ekleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nikam. Zapněte tlačítko Nástroje nebo přidejte do rozvržení klávesu Nástroje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ niet cesty dnu. Zapnite tlačidlo Nástroje alebo pridajte do rozloženia kláves Nástroje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει τρόπος ακόμα. Ενεργοποιήστε το κουμπί Εργαλεία ή προσθέστε ένα κλειδί Εργαλεία στη διάταξή σας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen väg in ännu. Slå på knappen Verktyg eller lägg till en Verktygsnyckel till din layout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen vej ind endnu. Slå knappen Værktøjer til, eller tilføj en Værktøjsnøgle til dit layout."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen vei inn ennå. Slå på Verktøy-knappen, eller legg til en Verktøy-nøkkel i oppsettet ditt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä sisäänpääsyä. Kytke Työkalut-painike päälle tai lisää asetteluun Työkalut-näppäin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada jalan masuk. Aktifkan tombol Alat, atau tambahkan tombol Alat ke tata letak Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có đường vào. Bật nút Công cụ hoặc thêm phím Công cụ vào bố cục của bạn."
          }
        }
      }
    },
