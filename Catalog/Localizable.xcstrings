    "Predictions, autocorrect, and swipe decoding all run in the app. No server.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorspellings, outokorreksie en vee-dekodering word alles in die toepassing uitgevoer. Geen bediener nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhersagen, Autokorrektur und Wischeingabe laufen alle in der App. Kein Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predicciones, autocorrección y deslizamiento van dentro de la app. Sin servidor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennustused, automaatparandus ja pühkimise dekodeerimine töötavad kõik rakenduses. Serverit pole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prédictions, la correction auto et le décodage par glissement marchent tous dans l'app. Pas de serveur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A javaslatok, az automatikus javítás és a csúsztatásos gépelés mind az appban fut. Nincs szerver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsioni, correzione automatica e swipe girano tutti nell'app. Nessun server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測も自動修正も、スワイプ入力の解析も、すべてアプリの中で動きます。サーバーは使いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예측, 자동 수정, 스와이프 인식이 전부 앱 안에서 돌아가요. 서버는 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramalan, autobetul dan penyahkodan leret, semuanya berjalan dalam app. Tiada pelayan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsões, correção automática e descodificação por deslize correm todas na app. Sem servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предсказания, автокоррекция и разбор скольжения — всё работает внутри приложения. Без сервера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联想、自动更正和滑动识别都在应用里跑，不走服务器。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Predicțiile, corectarea automată și decodarea prin glisare sunt toate rulate în aplicație. Fără server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorspellingen, autocorrectie en swipe-decodering worden allemaal in de app uitgevoerd. Geen server."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聯想、自動更正和滑動識別都在應用裡跑，不走伺服器。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przewidywania, autokorekta i dekodowanie machnięcia działają w aplikacji. Brak serwera."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогнози, автовиправлення та декодування пальцем – усе це працює в додатку. Немає сервера."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahminler, otomatik düzeltme ve kaydırarak kod çözme işlemlerinin tümü uygulamada çalışır. Sunucu yok."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V aplikaci běží předpovědi, automatické opravy a dekódování přejetím prstem. Žádný server."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V aplikácii sa spúšťajú predpovede, automatické opravy a dekódovanie potiahnutím prstom. Žiadny server."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προβλέψεις, η αυτόματη διόρθωση και η αποκωδικοποίηση με σάρωση εκτελούνται όλα στην εφαρμογή. Κανένας διακομιστής."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förutsägelser, autokorrigering och svepavkodning körs allt i appen. Ingen server."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forudsigelser, autokorrektur og swipe-afkodning kører alt sammen i appen. Ingen server."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forslag, autokorrektur og sveipekoding kjøres i appen. Ingen server."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennusteet, automaattinen korjaus ja pyyhkäisydekoodaus toimivat kaikki sovelluksessa. Ei palvelinta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prediksi, koreksi otomatis, dan penguraian kode gesek semuanya berjalan di aplikasi. Tidak ada pelayan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả các dự đoán, tự động sửa và giải mã thao tác vuốt đều chạy trong ứng dụng. Không có máy chủ."
          }
        }
      }
    },
