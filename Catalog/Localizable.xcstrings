            "value": "Transcrierea rulează pe dispozitivul dvs. Vocea ta nu este trimisă nicăieri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transcriptie wordt uitgevoerd op uw apparaat. Je stem wordt nergens heen gestuurd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
