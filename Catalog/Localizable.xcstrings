          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan pemberitahuan dalam Tetapan untuk menerima amaran kemas kini pek bahasa."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषा प्याक अद्यावधिक सूचना पाउन सेटिङमा सूचनालाई अनुमति दिनुहोस्।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita notificações nas Definições para receber alertas de atualizações dos pacotes de idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите уведомления в Настройках, чтобы получать сообщения об обновлениях языковых пакетов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil paketi güncelleme uyarılarını almak için Ayarlar'dan bildirimlere izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许通知，以接收语言包更新提醒。"
          }
        }
      }
    },
    "Allow panel logic from anti-ltd/clink-panels?": {
