    "No search field, no category tabs. Swipe the grid to change category.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geen soekveld, geen kategorie-oortjies nie. Swiep die rooster om kategorie te verander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Suchfeld, keine Kategorie-Tabs. Kategorie wechselst du per Wisch über das Raster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin campo de búsqueda ni pestañas de categorías. Desliza por la cuadrícula para cambiar de categoría."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsinguvälja ega kategooriakaarte pole. Viipa ruudustikku, et kategooriat vahetada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni champ de recherche ni onglets de catégories. Balaye la grille pour changer de catégorie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Se keresőmező, se kategóriafülek. A rácson húzva váltasz kategóriát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente campo di ricerca né schede delle categorie. Scorri sulla griglia per cambiare categoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索欄もカテゴリタブもなし。グリッドをスワイプしてカテゴリを切り替えます。"
          }
        },
