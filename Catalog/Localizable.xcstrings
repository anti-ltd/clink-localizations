        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или выключите подсветку в «Эффектах» и эффект в «Фоне» — это два главных потребителя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
