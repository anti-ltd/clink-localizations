    },
    "What the action runs on: your selection, or everything if nothing is selected.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Waarop die aksie loop: jou keuse, of alles as niks gekies is nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Worauf die Aktion läuft: deine Auswahl, oder alles, wenn nichts ausgewählt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre qué se ejecuta la acción: tu selección, o todo si no hay nada seleccionado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Millel tegevus töötab: sinu valik või kõik, kui midagi pole valitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sur quoi l'action s'applique : ta sélection, ou tout si rien n'est sélectionné."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amin a művelet fut: a kijelölésed, vagy minden, ha nincs kijelölve semmi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su cosa lavora l'azione: la tua selezione, o tutto se non c'è nulla di selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションの対象: 選択範囲、何も選んでいなければ全体です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액션이 처리할 대상: 선택한 부분, 아무것도 선택하지 않았다면 전체예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang tindakan ini kendalikan: pilihan anda, atau semuanya jika tiada yang dipilih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquilo sobre o que a ação corre: a tua seleção, ou tudo se nada estiver selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На чём работает действие: на выделении, а если ничего не выделено — на всём тексте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作作用的内容：你选中的部分；没有选中时就是全部。"
          }
        }
      }
    },
    "What the language calls itself. Shown as you type it, never translated.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wat die taal homself noem. Getoon terwyl jy dit tik, nooit vertaal nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie die Sprache sich selbst nennt. Wird genau so angezeigt, wie du sie eingibst – nie übersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como se llama el idioma a sí mismo. Se muestra tal cual lo escribes, nunca traducido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuidas keel ennast nimetab. Kuvatakse nii, nagu sa ta sisestad, mitte kunagi tõlgituna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom que la langue se donne. Affiché tel que tu le saisis, jamais traduit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahogy a nyelv nevezi magát. Pontosan úgy jelenik meg, ahogy beírod – sosem fordítjuk le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come la lingua chiama se stessa. Appare esattamente come lo scrivi, mai tradotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その言語自身での呼び名です。入力したままの形で表示し、翻訳はしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 언어가 스스로를 부르는 이름입니다. 입력한 그대로 표시하며 번역하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama yang digunakan oleh bahasa itu sendiri. Dipaparkan seperti yang anda taip, tidak pernah diterjemah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como o idioma se chama a si próprio. Aparece tal como o escreves, nunca traduzido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как язык называет сам себя. Показывается ровно так, как вы это ввели, и никогда не переводится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
