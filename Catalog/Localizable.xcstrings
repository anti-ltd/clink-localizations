    "Mark every control, page and tab with the id a plugin can use. Tap a badge to copy it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiert jedes Bedienelement, jede Seite und jeden Tab mit der ID, die ein Plugin verwenden kann. Tippe auf ein Symbol, um sie zu kopieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca cada control, página y pestaña con el ID que puede usar un plugin. Toca una insignia para copiarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märgib iga juhtelemendi, lehe ja vahekaardi ID-ga, mida pistikprogramm saab kasutada. Kopeerimiseks puuduta märki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque chaque commande, page et onglet avec l'identifiant qu'un plugin peut utiliser. Touchez un badge pour le copier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden vezérlőt, oldalt és lapot megjelöl azzal az azonosítóval, amelyet egy bővítmény használhat. Koppints egy jelvényre a másoláshoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrassegna ogni controllo, pagina e scheda con l'ID che un plugin può usare. Tocca un badge per copiarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのコントロール、ページ、タブに、プラグインが使える ID を表示します。バッジをタップするとコピーできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 컨트롤, 페이지, 탭에 플러그인이 사용할 수 있는 ID를 표시합니다. 배지를 탭하면 복사됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandakan setiap kawalan, halaman dan tab dengan ID yang boleh digunakan plugin. Ketik lencana untuk menyalinnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca cada controlo, página e separador com o ID que um plugin pode usar. Toque num distintivo para o copiar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помечает каждый элемент, страницу и вкладку идентификатором, который может использовать плагин. Нажмите на значок, чтобы скопировать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个控件、页面和标签页标出插件可用的 ID。点按标记即可复制。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcați fiecare control, pagină și filă cu id-ul pe care un plugin îl poate folosi. Atingeți o insignă pentru a o copia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer elk besturingselement, elke pagina en elk tabblad met de ID die een plug-in kan gebruiken. Tik op een badge om deze te kopiëren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為每個控制元件、頁面和標籤頁標出外掛可用的 ID。點按標記即可複製。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Merk elke kontrole, bladsy en oortjie met die ID wat 'n inprop kan gebruik. Tik op 'n kenteken om dit te kopieer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz każdą kontrolkę, stronę i kartę identyfikatorem, którego może używać wtyczka. Kliknij plakietkę, aby ją skopiować."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте кожен елемент керування, сторінку та вкладку ідентифікатором, який може використовувати плагін. Торкніться значка, щоб скопіювати його."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kontrolü, sayfayı ve sekmeyi bir eklentinin kullanabileceği kimlikle işaretleyin. Kopyalamak için bir rozete dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte každý ovládací prvek, stránku a kartu ID, které může plugin použít. Klepnutím na odznak zkopírujte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte každý ovládací prvok, stránku a kartu ID, ktoré môže doplnok použiť. Klepnutím na odznak ho skopírujte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επισημάνετε κάθε στοιχείο ελέγχου, σελίδα και καρτέλα με το αναγνωριστικό που μπορεί να χρησιμοποιήσει ένα πρόσθετο. Πατήστε ένα σήμα για να το αντιγράψετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera varje kontroll, sida och flik med det id som ett plugin kan använda. Tryck på ett märke för att kopiera det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Marker hver kontrol, side og fane med det id et plugin kan bruge. Tryk på et badge for at kopiere det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Merk hver kontroll, side og fane med IDen en plugin kan bruke. Trykk på et merke for å kopiere det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkitse jokainen ohjausobjekti, sivu ja välilehti tunnisteella, jota laajennus voi käyttää. Kopioi merkki napauttamalla sitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandai setiap kontrol, halaman, dan tab dengan id yang dapat digunakan plugin. Ketuk lencana untuk menyalinnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu mọi điều khiển, trang và tab bằng id mà plugin có thể sử dụng. Nhấn vào một huy hiệu để sao chép nó."
          }
        }
      }
    },
