        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți spațiu pentru a trage. Cheile rămân vizibile, dar devin inerte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd ruimte vast om te slepen. Toetsen blijven zichtbaar, maar worden inert."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按空格就能拖動。按鍵還看得見，但點不動了。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj spację, aby przeciągnąć. Klawisze pozostają widoczne, ale stają się obojętne."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
