          "stringUnit": {
            "state": "translated",
            "value": "Tastele se aprind în momentul în care le atingeți, fără arc. Viteza și elasticitatea apoi odihnește-te."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toetsen lichten op zodra je ze aanraakt, zonder veer. Snelheid en veerkracht rusten dan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵一經觸碰立即亮起，不帶彈簧效果。此時速度與彈性不起作用。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutels lig op sodra jy daaraan raak, sonder 'n veereffek. Spoed en veerkragtigheid word dan nie toegepas nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisze świecą w momencie ich dotknięcia, bez sprężyny. Szybkość i sprężystość, potem odpoczynek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіші підсвічуються, коли ви до них торкаєтеся, без пружини. Швидкість і пружність, потім відпочинок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşlar yaysız olarak dokunduğunuz anda aydınlanır. Hız ve Esneklik daha sonra dinlenin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesy se rozsvítí, jakmile se jich dotknete, bez pružiny. Rychlost a pružnost pak odpočívejte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesy sa rozsvietia hneď, ako sa ich dotknete, bez pružiny. Rýchlosť a pružnosť potom odpočívajte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πλήκτρα ανάβουν τη στιγμή που τα αγγίζετε, χωρίς ελατήριο. Ταχύτητα και άνοιξη στη συνέχεια ξεκουραστείτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangenterna lyser upp när du rör dem, utan fjäder. Snabbhet och vårighet vila sedan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Taster lyser i det øjeblik, du rører ved dem, uden fjeder. Fart og fjedrende hvile så."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Taster lyser opp i det øyeblikket du berører dem, uten fjær. Hurtighet og fjæring så hvile."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäimet syttyvät heti, kun kosketat niitä, ilman jousta. Nopeus ja joustavuus sitten lepää."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol menyala saat Anda menyentuhnya, tanpa pegas. Kecepatan dan Kekenyalan lalu istirahat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím sẽ sáng lên ngay khi bạn chạm vào mà không cần lò xo. Tốc độ và độ đàn hồi sau đó nghỉ ngơi."
          }
        }
      }
    },
