    "Could not update your account. Please try again.": {
      "comment": "Optional private app account and purchase sharing. No email or typing data. Recovery key and pairing codes are secrets.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido actualizar tu cuenta. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de mettre à jour ton compte. Réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto konnte nicht aktualisiert werden. Versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aggiornare l’account. Riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar a tua conta. Tenta novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить аккаунт. Повторите попытку."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun anda tidak dapat dikemas kini. Sila cuba lagi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült frissíteni a fiókodat. Próbáld újra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを更新できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新账户。请重试。"
