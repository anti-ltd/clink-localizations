    },
    "Tap a key in the preview to paint it. Anything you leave unset stays the theme's color.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in der Vorschau auf eine Taste, um sie zu färben. Was du nicht setzt, behält die Farbe des Designs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una tecla en la vista previa para pintarla. Lo que no ajustes conserva el color del tema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche une touche dans l’aperçu pour la colorer. Ce que tu ne définis pas garde la couleur du thème."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy billentyűre az előnézetben, és színezd ki. Amit nem állítasz be, megtartja a téma színét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un tasto nell’anteprima per colorarlo. Quello che non imposti mantiene il colore del tema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューのキーをタップすると色を塗れます。設定しなかった部分はテーマの色のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기에서 키를 탭하면 칠할 수 있어요. 설정하지 않은 부분은 테마 색상 그대로예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kekunci dalam pratonton untuk mewarnakannya. Apa yang tidak ditetapkan kekal warna tema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca numa tecla na pré-visualização para pintá-la. O que não definires fica com a cor do tema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на клавишу в предпросмотре, чтобы покрасить её. Всё, что вы не тронете, останется цвета темы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按预览里的按键就能上色。没有设置的地方保持主题颜色。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta eelvaates klahvi, et see värvida. Määratlemata jäänud jäävad teema värvi."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik 'n sleutel in die voorskou om dit te verf. Enigiets wat jy ongesteld laat bly die tema se kleur."
          }
        }
      }
    },
    "Tap a suggestion to use it": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una sugerencia para usarla"
