        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wychodzi do %@ miesięcznie. Odnawia się co roku. Anuluj w dowolnym momencie."
          }
        },
        "uk": {
          "stringUnit": {
