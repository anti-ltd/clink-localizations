    "Accept similar Pinyin sounds, such as z/zh and an/ang.": {
      "comment": "Pinyin input-method setting or candidate-panel accessibility control. Keep Pinyin letter pairs unchanged.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akzeptiert ähnlich klingende Pinyin-Laute wie z/zh und an/ang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept similar Pinyin sounds, such as z/zh and an/ang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepta sonidos similares en pinyin, como z/zh y an/ang."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lubab sarnaseid pinyin’i häälikuid, näiteks z/zh ja an/ang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepte les sons proches en pinyin, comme z/zh et an/ang."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elfogadja a hasonló pinjinhangokat, például a z/zh és az an/ang párokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetta suoni simili in pinyin, come z/zh e an/ang."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "z/zh や an/ang など、似た発音のピンインも入力できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "z/zh, an/ang처럼 발음이 비슷한 병음도 허용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima bunyi Pinyin yang hampir sama, seperti z/zh dan an/ang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceita sons semelhantes em pinyin, como z/zh e an/ang."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Допускает похожие звуки пиньиня, например z/zh и an/ang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许混用 z/zh、an/ang 等相近的拼音。"
          }
        }
      }
    },
