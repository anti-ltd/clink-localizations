    "Trail thickness at the start of the glide, as a multiple of the base thickness. Set below End width for a tapering tail.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Roetdikte aan die begin van die gly, as 'n veelvoud van die basisdikte. Stel onder Eindwydte vir 'n tapse stert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spurdicke am Anfang der Bewegung, als Vielfaches der Grunddicke. Setz sie unter die Endbreite für einen spitz zulaufenden Schweif."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grosor del trazo al principio del deslizamiento, como múltiplo del grosor base. Ponlo por debajo del Ancho final para una cola que se estrecha."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jälje paksus libisemise algul, baaspaksuse kordsena. Määra lõpulaiusest väiksemaks aheneva saba jaoks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épaisseur de la trace au début du glissé, en multiple de l'épaisseur de base. Mets-la sous Largeur de fin pour une queue qui s'affine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyom vastagsága a húzás elején, az alapvastagság többszöröseként. Állítsd a Végszélesség alá egy elkeskenyedő farokért."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spessore della scia all'inizio dello scorrimento, come multiplo dello spessore di base. Impostalo sotto la Larghezza finale per una coda che si assottiglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グライド開始時の軌跡の太さで、基本の太さに対する倍率です。終端の幅より小さくすると尾が細くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "궤적이 시작될 때의 굵기예요, 기본 굵기의 배수로요. 끝 너비보다 작게 하면 꼬리가 가늘어져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketebalan jejak pada permulaan luncuran, sebagai gandaan ketebalan asas. Tetapkan di bawah Lebar hujung untuk ekor yang meruncing."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Espessura do rasto no início do deslize, como múltiplo da espessura base. Define abaixo da Largura final para uma cauda afunilada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Толщина следа в начале движения, кратно базовой толщине. Задайте меньше «Ширины в конце», чтобы хвост сужался."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动起点处的轨迹粗细，是基础粗细的倍数。设得比末端宽度小，就有一条渐细的尾巴。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Grosimea traseului la începutul alunecării, ca multiplu al grosimii bazei. Setați sub Lățimea de capăt pentru o coadă conică."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dikte van het spoor aan het begin van de glijbeweging, als een veelvoud van de basisdikte. Stel hieronder de Eindbreedte in voor een taps toelopende staart."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑動起點處的軌跡粗細，是基礎粗細的倍數。設得比末端寬度小，就有一條漸細的尾巴。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grubość szlaku na początku ślizgu, jako wielokrotność grubości podstawy. Ustaw poniżej Szerokość końcową dla zwężającego się ogona."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Товщина сліду на початку ковзання, кратна товщині основи. Встановіть нижче End width для звужуваного хвоста."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaymanın başlangıcındaki iz kalınlığı, taban kalınlığının katıdır. İncelen bir kuyruk için Uç genişliğinin altında ayarlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tloušťka stopy na začátku klouzání jako násobek základní tloušťky. Nastavte níže Koncová šířka pro zužující se ocas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hrúbka stopy na začiatku kĺzania ako násobok základnej hrúbky. Nastavte nižšie Koncová šírka pre zužujúci sa chvost."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάχος διαδρομής στην αρχή της ολίσθησης, πολλαπλάσιο του πάχους της βάσης. Ρυθμίστε κάτω από το πλάτος τέλους για μια κωνική ουρά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spårtjocklek i början av glidet, som en multipel av bastjockleken. Ställ in under ändbredd för en avsmalnande svans."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sportykkelse ved starten af glidet, som et multiplum af basistykkelsen. Sæt under endebredden for en tilspidsende hale."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løypetykkelse ved starten av glidet, som et multiplum av grunntykkelsen. Sett under endebredde for en avsmalnende hale."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Polun paksuus liukumisen alussa, peruspaksuuden kerrannaisena. Aseta alle Päätyleveyden kapenevaa häntää varten."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketebalan jejak pada awal luncuran, sebagai kelipatan dari ketebalan dasar. Atur di bawah Lebar ujung untuk ekor yang meruncing."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ dày của vệt khi bắt đầu lướt, là bội số của độ dày nền. Đặt bên dưới Chiều rộng cuối để có phần đuôi thuôn nhọn."
          }
        }
      }
    },
