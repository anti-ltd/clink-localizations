          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델이 유효한 초안을 만들지 못했습니다. 다른 모델을 선택하거나 더 간단한 요청으로 시도해 주세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See mudel ei suutnud luua nõuetele vastavat mustandit. Proovi teist mudelit või lihtsamat päringut."
          }
        }
      }
    },
