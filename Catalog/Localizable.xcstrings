    "Suggestions and translate assist use Apple's model when it's available.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorstelle en vertaalhulp gebruik Apple se model wanneer dit beskikbaar is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge und Übersetzungshilfe nutzen Apples Modell, wenn es verfügbar ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias y la ayuda para traducir usan el modelo de Apple cuando está disponible."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soovitused ja tõlgiabi kasutavad Apple’i mudelit, kui see on saadaval."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suggestions et l'aide à la traduction utilisent le modèle d'Apple quand il est dispo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A javaslatok és a fordítási segítség az Apple modelljét használja, ha épp elérhető."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suggerimenti e l'aiuto alla traduzione usano il modello di Apple quando è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提案と翻訳アシストは、使えるときは Apple のモデルを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안과 번역 도움은 쓸 수 있을 때 Apple 모델을 써요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan dan bantuan terjemah guna model Apple apabila ia tersedia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As sugestões e a ajuda a traduzir usam o modelo da Apple quando está disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказки и помощь с переводом используют модель Apple, когда она доступна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 Apple 的模型时，建议和翻译辅助就用它。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugestiile și asistența pentru traducere folosesc modelul Apple atunci când este disponibil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggesties en vertaalhulp gebruiken het model van Apple wanneer dit beschikbaar is."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 Apple 的模型時，建議和翻譯輔助就用它。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugestie i pomoc w tłumaczeniu korzystają z modelu Apple, jeśli jest on dostępny."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропозиції та допомога при перекладі використовують модель Apple, якщо вона доступна."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öneriler ve çeviri yardımı, mevcut olduğunda Apple'ın modelini kullanır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Návrhy a překlad pomáhají používat model společnosti Apple, pokud je k dispozici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Návrhy a pomoc pri preklade používajú model spoločnosti Apple, keď je k dispozícii."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προτάσεις και η υποβοήθηση μετάφρασης χρησιμοποιούν το μοντέλο της Apple όταν είναι διαθέσιμο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förslag och översättningshjälp använder Apples modell när den är tillgänglig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forslag og oversættelseshjælp bruger Apples model, når den er tilgængelig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forslag og oversettelseshjelp bruker Apples modell når den er tilgjengelig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehdotukset ja käännösapu käyttävät Applen mallia, kun se on saatavilla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saran dan bantuan terjemahan menggunakan model Apple jika tersedia."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các gợi ý và hỗ trợ dịch thuật sẽ sử dụng mô hình của Apple khi có sẵn."
          }
        }
      }
