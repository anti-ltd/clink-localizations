    "Suggest names from your Contacts as you type.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugiere nombres de tus contactos mientras escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggère des noms de tes contacts pendant la saisie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlägt beim Tippen Namen aus deinen Kontakten vor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerisce nomi dai tuoi contatti mentre scrivi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugere nomes dos seus contactos enquanto escreve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предлагает имена из контактов при вводе."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangkan nama daripada kenalan anda semasa menaip."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gépelés közben neveket javasol a kontaktjaidból."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力中に連絡先の名前を候補として表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入时推荐通讯录中的姓名。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력할 때 연락처의 이름을 추천합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soovitab kirjutamise ajal nimesid sinu kontaktidest."
          }
        }
      }
    },
    "Suggest names from your Contacts as you type. Off by default; text replacements are unaffected.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stel name uit jou kontakte voor terwyl jy tik. Af by verstek; teksvervangings word nie geraak nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlägt beim Tippen Namen aus deinen Kontakten vor. Standardmäßig aus; Textersetzungen bleiben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugiere nombres de tus Contactos mientras escribes. Desactivado por defecto; las sustituciones de texto no se ven afectadas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soovita tipimise ajal nimesid sinu Kontaktidest. Vaikimisi väljas; tekstiasendusi ei mõjutata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggère des noms de tes contacts pendant que tu tapes. Désactivé par défaut ; les remplacements de texte ne sont pas touchés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Neveket javasol a Kapcsolataidból gépelés közben. Alapból ki van kapcsolva; a szövegcserékre nincs hatással."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerisce nomi dai tuoi Contatti mentre scrivi. Disattivato per impostazione predefinita; le sostituzioni di testo non ne risentono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力中に連絡先の名前を候補に出します。デフォルトはオフで、テキスト置換には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력하는 동안 연락처에서 이름을 추천해요. 기본은 꺼져 있고, 텍스트 대체어에는 영향 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangkan nama dari Kenalan anda semasa anda menaip. Mati secara lalai; penggantian teks tak terjejas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugere nomes dos teus Contactos enquanto escreves. Desligado por predefinição; as substituições de texto não são afetadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказывать имена из ваших контактов по ходу печати. По умолчанию выключено; на замены текста не влияет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打字时从你的通讯录里建议名字。默认关闭；文本替换不受影响。"
          }
        }
      }
    },
