        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstatter placeringen af dine klistermærker."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstatter plasseringen av klistremerkene dine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korvaa tarrojesi nykyisen asettelun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengganti susunan stiker Anda."
