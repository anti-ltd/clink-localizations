    "How long to hold a letter key before the accent picker appears.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange du eine Buchstabentaste halten musst, bis die Akzentauswahl kommt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto hay que mantener pulsada una letra antes de que aparezca el selector de acentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de temps maintenir une touche de lettre avant que le sélecteur d'accents s'affiche."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddig kell nyomva tartani egy betűt, mielőtt megjelenik az ékezetválasztó."
          }
        },
        "it": {
