    "Retune the selected switch. Drag the pad for pitch and tone.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el sonido del interruptor seleccionado. Arrastra sobre el panel para cambiar la altura y el timbre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste le son du mécanisme sélectionné. Fais glisser sur le pavé pour régler la hauteur et le timbre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe den Klang des gewählten Schalters an. Zieh auf dem Feld, um Tonhöhe und Klangfarbe zu ändern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola il suono dell’interruttore selezionato. Trascina sul riquadro per modificare altezza e timbro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste o som do interruptor selecionado. Arraste no painel para alterar a altura e o timbre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте звук выбранного переключателя. Перетаскивайте по полю, чтобы менять высоту и тембр."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laraskan bunyi suis yang dipilih. Seret pada pad untuk mengubah pic dan warna nada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangold át a kiválasztott kapcsolót. A felületen húzva állíthatod a hangmagasságot és a hangszínt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したスイッチの音を調整します。パッドをドラッグして音の高さと音色を変えられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调节所选轴体的声音。拖动面板可调整音高和音色。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 스위치의 소리를 조정합니다. 패드를 드래그하여 음높이와 음색을 바꿔 보세요."
          }
        },
        "et": {
