    "Fast, full and bright. The loudest it gets.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinnig, vol en helder. Die hardste wat dit word."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnell, voll und hell. Lauter geht es nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido, lleno y brillante. Todo lo llamativo que puede ser."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiire, täis ja ere. Valjem ei saa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapide, dense et lumineux. Le maximum."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyors, telt és fényes. Ennél harsányabb nem lesz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Veloce, pieno e luminoso. Più vistoso di così non si può."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "速く、びっしり、明るく。いちばん派手な設定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠르고 가득하고 밝게. 가장 화려한 설정입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantas, penuh dan terang. Paling menyerlah setakat ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido, cheio e brilhante. O mais vistoso que fica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстро, полно и ярко. Громче не бывает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快、满、亮。最张扬的一档。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapid, plin și luminos. Cu cât se face cel mai tare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snel, vol en helder. Het luidste dat het wordt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快、滿、亮。最張揚的一檔。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybki, pełny i jasny. Najgłośniej, jak się da."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Швидко, повно і яскраво. Найгучніше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı, dolu ve parlak. En gürültülü olanı."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychlý, plný a jasný. Nejhlasitější."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rýchly, plný a jasný. Najhlasnejšie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γρήγορο, γεμάτο και φωτεινό. Όσο πιο δυνατά γίνεται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snabb, fyllig och ljus. Det mest högljudda det blir."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtig, fuld og lys. Det højeste det bliver."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rask, full og lys. Det høyeste det blir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nopea, täyteläinen ja kirkas. Mitä äänekkäin se saa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cepat, penuh dan cerah. Yang paling keras."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhanh chóng, đầy đủ và tươi sáng. Nó ồn ào nhất."
          }
        }
      }
    },
    "Faster still: type what you're after into the search bar at the top of any tab.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog vinniger: tik waarna jy soek in die soekbalk boaan enige oortjie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch schneller: tippe in der Suchleiste oben in jedem Tab ein, was du suchst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más rápido aún: escribe lo que buscas en la barra de búsqueda de cualquier pestaña."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Veelim kiirem: tipi see, mida otsid, mis tahes kaardi ülaosas olevasse otsinguribale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus rapide encore : tape ce que tu cherches dans la barre de recherche en haut de n'importe quel onglet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még gyorsabb: írd be, amit keresel, bármelyik lap tetején lévő keresőbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora più rapido: scrivi quello che cerchi nella barra di ricerca in cima a qualsiasi scheda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さらに早いのは、どのタブでも上部の検索バーに探しているものを入力する方法です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 빠른 방법은 어느 탭에서든 위쪽 검색창에 찾는 것을 입력하는 것입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih pantas lagi: taip apa yang anda cari dalam bar carian di atas mana-mana tab."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda mais rápido: escreve o que procuras na barra de pesquisa no topo de qualquer separador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё быстрее: наберите то, что ищете, в строке поиска наверху любой вкладки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更快的办法：在任意标签页顶部的搜索框里输入你要找的东西。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Și mai rapid: introduceți ceea ce căutați în bara de căutare din partea de sus a oricărei file."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog sneller: typ wat u zoekt in de zoekbalk bovenaan elk tabblad."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更快的辦法：在任意標籤頁頂部的搜尋框裡輸入你要找的東西。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze szybciej: wpisz, czego szukasz, w pasku wyszukiwania u góry dowolnej karty."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще швидше: введіть те, що ви шукаєте, у рядок пошуку у верхній частині будь-якої вкладки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha da hızlı: İstediğiniz şeyi herhangi bir sekmenin üst kısmındaki arama çubuğuna yazın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ještě rychleji: zadejte, co hledáte, do vyhledávacího pole v horní části libovolné karty."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ešte rýchlejšie: do vyhľadávacieho panela v hornej časti ľubovoľnej karty zadajte, čo hľadáte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πιο γρήγορα ακόμα: πληκτρολογήστε αυτό που αναζητάτε στη γραμμή αναζήτησης στο επάνω μέρος οποιασδήποτε καρτέλας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortfarande snabbare: skriv vad du är ute efter i sökfältet högst upp på valfri flik."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Endnu hurtigere: Indtast, hvad du leder efter, i søgefeltet øverst på en hvilken som helst fane."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsatt raskere: skriv inn hva du er ute etter i søkefeltet øverst på en hvilken som helst fane."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielä nopeammin: kirjoita etsimäsi minkä tahansa välilehden yläreunassa olevaan hakupalkkiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih cepat lagi: ketik apa yang Anda cari ke dalam bilah pencarian di bagian atas tab mana pun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn nhanh hơn: nhập nội dung bạn đang tìm kiếm vào thanh tìm kiếm ở đầu bất kỳ tab nào."
          }
        }
      }
    },
    "Fastest deletion rate after the key fully accelerates. Lower is faster.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinnigste uitveetempo nadat die sleutel ten volle versnel het. Laer is vinniger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnellste Löschrate, wenn die Taste voll beschleunigt hat. Niedriger heißt schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocidad de borrado máxima cuando la tecla ya va a tope. Cuanto más bajo, más rápido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiireim kustutamiskiirus pärast seda, kui klahv on täielikult kiirendunud. Madalam on kiirem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitesse de suppression max une fois la touche à plein régime. Plus bas, plus rapide."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A leggyorsabb törlési tempó, miután a gomb teljesen felgyorsult. Az alacsonyabb a gyorsabb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocità massima di cancellazione dopo che il tasto accelera del tutto. Più basso è più veloce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーが完全に加速したあとの、いちばん速い削除スピードです。低いほど速くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 완전히 빨라진 뒤의 최고 삭제 속도예요. 낮을수록 빨라요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadar padam paling laju selepas kekunci memecut penuh. Lagi rendah, lagi laju."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocidade máxima de apagar depois de a tecla acelerar por completo. Mais baixo é mais rápido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальная скорость удаления после полного разгона клавиши. Меньше — быстрее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键完全加速后的最快删除速度。数值越低越快。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cea mai rapidă rată de ștergere după ce cheia se accelerează complet. Mai jos este mai rapid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snelste verwijderingssnelheid nadat de sleutel volledig is versneld. Lager is sneller."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵完全加速後的最快刪除速度。數值越低越快。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najszybszy współczynnik usuwania po pełnym przyspieszeniu klucza. Niżej jest szybciej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найшвидша швидкість видалення після повного прискорення ключа. Нижче – швидше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar tamamen hızlandıktan sonra en hızlı silme oranı. Daha düşük daha hızlıdır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejrychlejší rychlost mazání po úplném zrychlení klíče. Nižší je rychlejší."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najvyššia rýchlosť odstraňovania po úplnom zrýchlení klávesu. Nižšie je rýchlejšie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ταχύτερος ρυθμός διαγραφής μετά την πλήρη επιτάχυνση του κλειδιού. Το χαμηλότερο είναι πιο γρήγορο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snabbaste raderingshastigheten efter att nyckeln accelererar helt. Lägre är snabbare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtigste sletningshastighed, efter at nøglen accelererer fuldt ud. Lavere er hurtigere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Raskeste slettingshastighet etter at nøkkelen akselererer fullt. Lavere er raskere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nopein poistonopeus avaimen kiihtymisen jälkeen. Alempi on nopeampi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingkat penghapusan tercepat setelah kunci berakselerasi penuh. Lebih rendah lebih cepat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tốc độ xóa nhanh nhất sau khi phím tăng tốc hoàn toàn. Thấp hơn là nhanh hơn."
          }
        }
      }
    },
