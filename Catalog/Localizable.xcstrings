    "Helps with corrections the keyboard isn't sure about.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Help met regstellings waaroor die sleutelbord nie seker is nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilft bei Korrekturen, bei denen sich die Tastatur unsicher ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda con las correcciones de las que el teclado no está seguro."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aitab parandustega, mille suhtes klaviatuur pole kindel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide sur les corrections dont le clavier n'est pas sûr."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Segít azoknál a javításoknál, amikben a billentyűzet nem biztos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta con le correzioni di cui la tastiera non è sicura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードが迷っている修正を手助けします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 긴가민가하는 수정을 도와줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membantu dengan pembetulan yang papan kekunci tak pasti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda nas correções sobre as quais o teclado não tem a certeza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогает там, где клавиатура не уверена в исправлении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘拿不准的更正上帮一把。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajută cu corecțiile despre care tastatura nu este sigură."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Helpt bij correcties waar het toetsenbord niet zeker van is."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鍵盤拿不準的更正上幫一把。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomaga w przypadku poprawek, co do których klawiatura nie jest pewna."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допомагає з виправленнями, щодо яких клавіатура не впевнена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyenin emin olmadığı düzeltmelere yardımcı olur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomáhá s opravami, kterými si klávesnice není jistá."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomáha s opravami, ktorými si klávesnica nie je istá."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βοηθά με διορθώσεις για τις οποίες το πληκτρολόγιο δεν είναι σίγουρο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälper till med korrigeringar som tangentbordet inte är säker på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjælper med rettelser, som tastaturet ikke er sikker på."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelper med rettelser tastaturet ikke er sikker på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Auttaa korjauksissa, joista näppäimistö ei ole varma."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membantu dengan koreksi yang keyboardnya tidak yakin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giúp sửa các lỗi mà bàn phím không chắc chắn."
          }
        }
      }
    },
