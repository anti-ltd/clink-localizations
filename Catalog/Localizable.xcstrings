          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een resultaat om de bijbehorende pagina te openen en de bijbehorende besturingselementen weer te geven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點搜尋結果，即可開啟對應頁面並顯示相關設定。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
