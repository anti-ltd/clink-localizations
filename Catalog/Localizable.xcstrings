    "The file couldn't be read, or its sounds were missing.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lêer kon nie gelees word nie, of sy klanke het ontbreek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ließ sich nicht lesen, oder ihre Töne fehlten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer el archivo, o le faltaban los sonidos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili ei saanud lugeda või selle helid puudusid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n'a pas pu être lu, ou ses sons manquaient."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlt nem sikerült beolvasni, vagy hiányoztak belőle a hangok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere il file, oppure i suoni mancavano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを読み込めなかったか、中のサウンドが見つかりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 읽지 못했거나, 안에 사운드가 없었어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail itu tidak dapat dibaca, atau bunyinya tiada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o ficheiro, ou faltavam-lhe os sons."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл не удалось прочитать, или в нём не оказалось звуков."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件读不出来，或者里面的声音缺失了。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul nu a putut fi citit sau sunetele lui lipseau."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand kon niet worden gelezen of de geluiden ontbraken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案讀不出來，或者裡面的聲音缺失了。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać pliku lub brakowało jego dźwięków."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати файл або відсутні звуки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya okunamadı veya sesleri eksikti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor nelze přečíst nebo jeho zvuky chyběly."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbor sa nedal prečítať alebo jeho zvuky chýbali."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ανάγνωση του αρχείου ή έλειπαν οι ήχοι του."
