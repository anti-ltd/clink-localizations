          }
        }
      }
    },
    "Optional. No email required. ANTI receives your account ID and purchase details, never your typing.": {
      "comment": "Optional private app account and purchase sharing. No email or typing data. Recovery key and pairing codes are secrets.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. No necesitas correo electrónico. ANTI recibe tu ID de cuenta y los datos de compra, nunca lo que escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Aucune adresse e-mail requise. ANTI reçoit ton identifiant et les détails de tes achats, jamais ce que tu tapes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freiwillig. Keine E-Mail erforderlich. ANTI erhält deine Konto-ID und Kaufdetails, niemals deine Eingaben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Non serve un indirizzo email. ANTI riceve l’ID account e i dettagli degli acquisti, mai ciò che digiti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Não precisas de email. A ANTI recebe o ID da tua conta e os detalhes das compras, nunca o que escreves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно. Электронная почта не нужна. ANTI получает ID аккаунта и сведения о покупках, но не вводимый вами текст."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan sahaja. E-mel tidak diperlukan. ANTI menerima ID akaun dan butiran pembelian anda, bukan teks yang anda taip."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem kötelező. Nem kell e-mail-cím. Az ANTI a fiókazonosítódat és a vásárlásaid adatait kapja meg, a begépelt szöveget soha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意の機能です。メールアドレスは不要です。ANTIが受け取るのはアカウントIDと購入情報だけで、入力内容は受け取りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能可选，无需邮箱。ANTI 仅接收账户 ID 和购买详情，不会接收你的输入内容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이며 이메일은 필요하지 않습니다. ANTI는 계정 ID와 구매 정보만 받으며, 입력한 내용은 받지 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vabatahtlik. E-posti pole vaja. ANTI saab su konto ID ja ostuandmed, mitte kunagi sinu sisestatud teksti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțional. Nu este necesar un e-mail. ANTI primește ID-ul contului și detaliile achizițiilor, niciodată textul tastat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel. Geen e-mailadres nodig. ANTI ontvangt je account-ID en aankoopgegevens, nooit wat je typt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能為選用，無需電子郵件。ANTI 只會收到帳號 ID 和購買詳情，不會收到你的輸入內容。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsioneel. Geen e-posadres nodig nie. ANTI ontvang jou rekening-ID en aankoopbesonderhede, nooit wat jy tik nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. E-mail nie jest wymagany. ANTI otrzymuje ID konta i dane zakupów, nigdy wpisywany tekst."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов’язково. Електронна пошта не потрібна. ANTI отримує ID облікового запису й дані покупок, але ніколи не отримує введений вами текст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlıdır. E-posta gerekmez. ANTI hesap kimliğinizi ve satın alım bilgilerinizi alır; yazdıklarınızı asla almaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volitelné. E-mail není potřeba. ANTI získá ID účtu a údaje o nákupech, nikdy to, co píšeš."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Voliteľné. E-mail nie je potrebný. ANTI získa ID účtu a údaje o nákupoch, nikdy to, čo píšeš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προαιρετικό. Δεν χρειάζεται email. Η ANTI λαμβάνει το αναγνωριστικό λογαριασμού και τα στοιχεία αγορών, ποτέ όσα πληκτρολογείς."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfritt. Ingen e-post krävs. ANTI får ditt konto-ID och dina köpuppgifter, aldrig det du skriver."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfrit. Ingen e-mail kræves. ANTI modtager dit konto-id og dine købsoplysninger, aldrig det, du skriver."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt. Ingen e-post kreves. ANTI mottar konto-ID og kjøpsopplysninger, aldri det du skriver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vapaaehtoinen. Sähköpostia ei tarvita. ANTI saa tilisi tunnuksen ja ostotiedot, ei koskaan kirjoittamaasi tekstiä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional. Tidak perlu email. ANTI menerima ID akun dan detail pembelian, bukan teks yang Anda ketik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bắt buộc, không cần email. ANTI nhận ID tài khoản và chi tiết giao dịch mua, không bao giờ nhận nội dung bạn gõ."
          }
        }
      }
    },
