    "clinkkeys.app has the longer guides, and a way to write to us. A real person reads it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "clinkkeys.app het die langer gidse, en 'n manier om aan ons te skryf. ’n Regte mens lees dit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf clinkkeys.app stehen die ausführlichen Anleitungen, und von dort kannst du uns schreiben. Es liest ein echter Mensch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En clinkkeys.app están las guías largas y un sitio para escribirnos. Lo lee una persona de verdad."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app-il on pikemad juhendid ja võimalus meile kirjutada. Ehtsat inimest loeb seda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app rassemble les guides détaillés et un moyen de nous écrire. C'est une vraie personne qui lit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A clinkkeys.app oldalon vannak a hosszabb útmutatók, és onnan írhatsz nekünk. Egy valódi ember olvassa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su clinkkeys.app trovi le guide più lunghe e un modo per scriverci. Legge una persona vera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.appには詳しいガイドと、ご連絡いただける窓口があります。実際の担当者が読んでいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app에는 더 자세한 가이드와 문의 방법이 있습니다. 실제 담당자가 읽습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app ada panduan yang lebih panjang dan cara untuk menulis kepada kami. Orang sebenar yang membacanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em clinkkeys.app estão os guias mais longos e uma forma de nos escreveres. É lido por uma pessoa a sério."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На clinkkeys.app есть подробные руководства и способ нам написать. Читает живой человек."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app 上有更详细的指南，也能从那里写信给我们。看信的是真人。"
          }
        }
      }
    },
