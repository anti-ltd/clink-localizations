    "One character puts the letter on that key. Longer spellings are a hold on the key of their first letter.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un solo carácter, la letra va en esa tecla. Las grafías más largas se obtienen manteniendo pulsada la tecla de su primera letra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul caractère place la lettre sur cette touche. Les graphies plus longues s’obtiennent par un appui prolongé sur la touche de leur première lettre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einzelnes Zeichen legt den Buchstaben auf diese Taste. Längere Schreibweisen erreichst du durch langes Drücken auf die Taste ihres ersten Buchstabens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo carattere mette la lettera su quel tasto. Le grafie più lunghe si ottengono tenendo premuto il tasto della loro prima lettera."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um único caractere coloca a letra nessa tecla. Grafias mais longas ficam num toque longo na tecla da primeira letra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один символ помещает букву на эту клавишу. Более длинные записи вводятся долгим нажатием на клавишу их первой буквы."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu aksara meletakkan huruf pada kekunci itu. Ejaan yang lebih panjang dicapai dengan tekan lama pada kekunci huruf pertamanya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen karakter esetén a betű arra a billentyűre kerül. A hosszabb átírások az első betűjük billentyűjének nyomva tartásával érhetők el."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1文字ならそのキーに配置されます。長い表記は最初の文字のキーを長押しして入力します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单个字符会让字母放在该按键上。较长的拼写可长按其首字母所在的按键输入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 글자이면 해당 키에 배치됩니다. 더 긴 표기는 첫 글자의 키를 길게 눌러 입력합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üks märk paneb tähe sellele klahvile. Pikemad kirjapildid saab kätte oma esimese tähe klahvi pikalt vajutades."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un caracter pune litera pe acea cheie. Ortografiile mai lungi sunt o reținere a tastei primei litere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén personage plaatst de letter op die sleutel. Langere spellingen houden de sleutel van hun eerste letter in."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單個字元會讓字母放在該按鍵上。較長的拼寫可長按其首字母所在的按鍵輸入。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Enkelkarakter plaas die letter op daardie sleutel. Vir langer spellings hou jy die sleutel van die eerste letter in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden znak umieszcza literę na tym klawiszu. Dłuższa pisownia polega na trzymaniu tonacji pierwszej litery."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один символ ставить літеру на цій клавіші. Довші написання — це утримання ключа першої літери."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir karakter mektubu o tuşa koyar. Daha uzun yazımlar, ilk harflerinin anahtarının tutulmasıdır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna postava umístí písmeno na tuto klávesu. Delší hláskování je držením klíče jejich prvního písmene."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden znak umiestni písmeno na tento kláves. Dlhšie hláskovanie je držaním kľúča ich prvého písmena."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας χαρακτήρας βάζει το γράμμα σε αυτό το κλειδί. Μεγαλύτερη ορθογραφία κρατούν το κλειδί του πρώτου τους γράμματος."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett tecken sätter bokstaven på den tangenten. Längre stavningar är ett grepp om nyckeln till deras första bokstav."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et tegn sætter bogstavet på den tast. Længere stavemåder er et hold på tasten til deres første bogstav."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett tegn setter bokstaven på den tasten. Lengre stavemåter er et hold på nøkkelen til den første bokstaven."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi merkki asettaa kirjaimen tälle näppäimelle. Pidemmät kirjoitusasut pitävät kiinni ensimmäisen kirjaimen avaimesta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu karakter menaruh huruf pada kunci itu. Ejaan yang lebih panjang menahan kunci huruf pertamanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ký tự đặt chữ cái trên phím đó. Cách viết dài hơn là sự giữ lại phím của chữ cái đầu tiên."
          }
        }
      }
    },
