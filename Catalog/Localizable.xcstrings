    "Animation sets how long the hold takes and how far a slide travels.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Animasie stel hoe lank die hou neem en hoe ver 'n skyfie beweeg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter „Animation“ stellst du ein, wie lange das Halten dauert und wie weit ein Zug reicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Animación se ajusta cuánto hay que mantener pulsado y cuánto recorre un deslizamiento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Animatsioon sätestab, kui kaua kestab hoidmine ja kui kaugele liug liigub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation règle la durée de l'appui et la distance parcourue par un glissement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Animáció alatt állítható, mennyi ideig kell nyomni, és milyen messzire visz egy húzás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Animazione imposti quanto dura la pressione e quanto lontano arriva uno scorrimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しの時間とスライドの移動量は「アニメーション」で設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 누르는 시간과 미는 거리는 애니메이션에서 정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Animasi menetapkan berapa lama tahanan itu dan sejauh mana lerekan bergerak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Animação defines quanto tempo dura a pressão e a distância que um deslize percorre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анимация задаёт, сколько длится удержание и как далеко уходит скольжение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按需要多久、滑动走多远，都在“动画”里设。"
          }
        }
      }
    },
