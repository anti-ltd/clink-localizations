    "Add an AI panel behind the keyboard's panel button. Proofread, rewrite, change tone, shorten, reply and more.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg 'n AI-paneel agter die sleutelbord se paneelknoppie. Proeflees, herskryf, verander toon, verkort, antwoord en meer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge hinter dem Panel-Button der Tastatur ein KI-Panel hinzu. Korrekturlesen, umschreiben, Ton ändern, kürzen, antworten und mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un panel de IA detrás del botón de panel del teclado. Corrige, reescribe, cambia el tono, acorta, responde y más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa klaviatuuri paneelinupu taha TI-paneel. Loe üle, kirjuta ümber, muuda tooni, lühenda, vasta ja palju muud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un panneau IA derrière le bouton de panneau du clavier. Relis, réécris, change le ton, raccourcis, réponds et plus encore."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá egy AI-panelt a billentyűzet panel gombja mögé. Helyesírás-ellenőrzés, átírás, hangnemváltás, rövidítés, válaszírás és még sok más."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un pannello IA dietro il pulsante pannelli della tastiera. Correggi, riscrivi, cambia tono, accorcia, rispondi e altro ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードのパネルボタンの奥に AI パネルを足します。校正、書き直し、トーン変更、短縮、返信などができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드의 패널 버튼 뒤에 AI 패널을 넣어줘요. 교정, 다시 쓰기, 어조 바꾸기, 줄이기, 답장 등을 할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah panel AI di sebalik butang panel papan kekunci. Semak ejaan, tulis semula, ubah nada, pendekkan, balas dan banyak lagi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um painel de IA atrás do botão de painel do teclado. Revê, reescreve, muda o tom, encurta, responde e mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить панель ИИ за кнопкой панелей на клавиатуре. Проверка, переписывание, смена тона, сокращение, ответ и не только."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘面板按钮后面加一个 AI 面板。校对、改写、换语气、缩短、回复等等。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați un panou AI în spatele butonului panoului tastaturii. Verificați, rescrieți, schimbați tonul, scurtați, răspundeți și multe altele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een AI-paneel toe achter de paneelknop van het toetsenbord. Proeflezen, herschrijven, van toon veranderen, inkorten, antwoorden en meer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鍵盤面板按鈕後面加一個 AI 面板。校對、改寫、換語氣、縮短、回覆等等。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj panel AI za przyciskiem panelu klawiatury. Korekta, przepisywanie, zmiana tonu, skracanie, odpowiadanie i nie tylko."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте панель AI позаду кнопки панелі клавіатури. Перечитуйте, переписуйте, змінюйте тон, скорочуйте, відповідайте тощо."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyenin panel düğmesinin arkasına bir AI paneli ekleyin. Düzeltme yapın, yeniden yazın, tonu değiştirin, kısaltın, yanıtlayın ve daha fazlasını yapın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte panel AI za tlačítko panelu klávesnice. Zkorigovat, přepsat, změnit tón, zkrátit, odpovědět a další."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte panel AI za tlačidlo panela klávesnice. Skontrolujte, prepíšte, zmeňte tón, skráťte, odpovedajte a ďalšie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ένα πλαίσιο AI πίσω από το κουμπί του πίνακα του πληκτρολογίου. Διορθώστε, ξαναγράψτε, αλλάξτε τόνο, συντομεύστε, απαντήστε και πολλά άλλα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en AI-panel bakom tangentbordets panelknapp. Korrekturläsa, skriva om, ändra ton, förkorta, svara med mera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj et AI-panel bag tastaturets panelknap. Læs korrektur, omskriv, skift tone, forkort, svar og mere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til et AI-panel bak panelknappen på tastaturet. Korrekturlese, skrive om, endre tone, forkorte, svare og mer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää AI-paneeli näppäimistön paneelipainikkeen taakse. Oikolue, kirjoita uudelleen, muuta ääntä, lyhennä, vastaa ja paljon muuta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan panel AI di belakang tombol panel keyboard. Mengoreksi, menulis ulang, mengubah nada, mempersingkat, membalas, dan banyak lagi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm bảng điều khiển AI phía sau nút bảng điều khiển của bàn phím. Hiệu đính, viết lại, thay đổi giọng điệu, rút ​​ngắn, trả lời và hơn thế nữa."
          }
        }
      }
    },
