    "Size controls adjust the keys, while spacing controls adjust the gaps around them.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Größenregler passen die Tasten an, die Abstandsregler die Zwischenräume um sie herum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los controles de tamaño ajustan las teclas y los de espaciado ajustan los huecos que las rodean."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Suuruse seaded muudavad klahve, vahede seaded aga nende ümber olevat ruumi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes de taille règlent les dimensions des touches, et celles d’espacement règlent les espaces autour."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A méretbeállításokkal a billentyűket, a térközbeállításokkal pedig a körülöttük lévő helyet módosíthatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I controlli delle dimensioni regolano i tasti, mentre quelli della spaziatura regolano gli spazi intorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「サイズ」ではキーの大きさを、「間隔」ではキーの周囲のすき間を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘크기’에서는 키의 크기를, ‘간격’에서는 키 주변의 빈 공간을 조절합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kawalan saiz melaraskan kekunci, manakala kawalan jarak melaraskan ruang di sekelilingnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os controlos de tamanho ajustam as teclas, enquanto os de espaçamento ajustam os espaços à sua volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки размера меняют сами клавиши, а настройки интервалов — расстояния между ними."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“大小”用于调整按键尺寸，“间距”用于调整按键周围的空隙。"
          }
        }
      }
    },
