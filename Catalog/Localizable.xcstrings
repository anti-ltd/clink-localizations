          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λειτουργεί σε %@ το μήνα. Ανανεώνεται ετησίως. Ακύρωση ανά πάσα στιγμή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
