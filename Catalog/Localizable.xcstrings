          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci Clink ditambah"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclado Clink adicionado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура Clink добавлена"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已添加 Clink 键盘"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinki klaviatuur lisatud"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klink-sleutelbord bygevoeg"
          }
        }
      }
    },
    "Clink only reads your clipboard when you ask it to, and clips stay on the device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink liest die Zwischenablage nur, wenn du es willst, und die Clips bleiben auf dem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink solo lee el portapapeles cuando se lo pides, y los clips se quedan en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ne lit le presse-papiers que quand tu le demandes, et les clips restent sur l'appareil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink csak akkor olvassa a vágólapot, ha kéred, és a másolatok a készüléken maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink legge gli appunti solo quando glielo chiedi, e i contenuti restano sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkはあなたが求めたときだけクリップボードを読み、コピーした内容は端末に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink는 요청할 때만 클립보드를 읽고, 복사한 내용은 기기에 남아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink hanya membaca papan keratan bila anda minta, dan klip kekal pada peranti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink só lê a área de transferência quando lhe pedes, e os clips ficam no dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink читает буфер обмена, только когда вы попросите, и фрагменты остаются на устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 只在你需要时读取剪贴板，复制的内容都留在设备上。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink loeb sinu lõikelauda ainult siis, kui sa seda palud, ja klipid jäävad seadmesse."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink lees net jou knipbord wanneer jy dit vra, en snitte bly op die toestel."
          }
        }
      }
    },
    "Clink pulls from your contacts, system text replacements, and its own custom iCloud-synced store.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink greift auf deine Kontakte, die System-Textersetzungen und seinen eigenen, über iCloud synchronisierten Speicher zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink toma datos de tus contactos, las sustituciones de texto del sistema y su propio almacén personalizado sincronizado con iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink puise dans tes contacts, les remplacements de texte du système et son propre stockage perso synchronisé via iCloud."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink a kapcsolataidból, a rendszer szövegcseréiből és a saját, iCloudon szinkronizált tárából merít."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink attinge dai tuoi contatti, dalle sostituzioni di testo del sistema e dal suo archivio personale sincronizzato via iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink は連絡先、システムのテキスト置換、そして iCloud で同期される独自のカスタム辞書から取り込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink는 연락처, 시스템 텍스트 대체어, 그리고 iCloud로 동기화되는 자체 저장소에서 가져와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ambil daripada kenalan anda, penggantian teks sistem, dan simpanan tersuai tersegerak iCloud sendiri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink recorre aos teus contactos, às substituições de texto do sistema e ao seu próprio arquivo sincronizado com o iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink берёт их из ваших контактов, системных замен текста и собственного хранилища, синхронизируемого через iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 会从你的联系人、系统文本替换，以及它自己那个 iCloud 同步的自定义库里取词。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ammutab sinu kontaktidest, süsteemi tekstiasendustest ja oma kohandatud iCloudi sünkroonitud salvestist."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klink trek uit jou kontakte, stelselteksvervangings en sy eie persoonlike iCloud-gesinkroniseerde winkel."
          }
        }
      }
    },
    "Clink taps into Apple Intelligence when available for smarter completions as you type.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink nutzt Apple Intelligence, wenn es verfügbar ist, für klügere Vervollständigungen beim Tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink recurre a Apple Intelligence cuando está disponible para completar con más inteligencia mientras escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink fait appel à Apple Intelligence quand c'est dispo pour des complétions plus malines pendant que tu tapes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink igénybe veszi az Apple Intelligence-t, ha elérhető, hogy okosabb kiegészítéseket adjon gépelés közben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink sfrutta Apple Intelligence, quando disponibile, per completamenti più intelligenti mentre scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink は使えるときに Apple Intelligence を活用して、入力中によりスマートな補完を出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink는 쓸 수 있을 때 Apple Intelligence를 활용해서 입력하는 동안 더 똑똑하게 자동 완성해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink guna Apple Intelligence apabila tersedia untuk pelengkapan lebih pintar semasa anda menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink usa a Apple Intelligence quando está disponível para conclusões mais espertas enquanto escreves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда Apple Intelligence доступен, Clink обращается к нему за более умными продолжениями по ходу печати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 Apple Intelligence 时，Clink 会用它，在你打字时给出更聪明的补全。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kasutab võimalusel Apple Intelligence'i nutikamate lõpetuste jaoks tipimise ajal."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink tik by Apple Intelligence wanneer dit beskikbaar is vir slimmer voltooiings terwyl jy tik."
          }
        }
      }
    },
    "Clink turns this on as a typing language once the dictionary is added.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink schaltet diese Sprache zum Tippen ein, sobald das Wörterbuch hinzugefügt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink activará este idioma para escribir en cuanto se añada el diccionario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink activera cette langue de saisie dès que le dictionnaire sera ajouté."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink bekapcsolja ezt gépelési nyelvként, amint a szótár bekerült."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink attiverà questa lingua di scrittura appena il dizionario è aggiunto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書を追加すると、この言語が入力言語としてオンになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전을 추가하면 이 언어가 입력 언어로 켜집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink akan menghidupkan bahasa ini untuk menaip sebaik kamus ditambah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink liga este idioma de escrita assim que o dicionário for adicionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После добавления словаря Clink включит это как язык печати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加词典后，Clink 会把这个语言设为输入语言。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink lubab selle sisestuskeelena, niipea kui sõnaraamat on lisatud."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink skakel dit aan as 'n tiktaal sodra die woordeboek bygevoeg is."
          }
        }
      }
    },
    "Clink works fully without Full Access. You still get the standard system click. Flip it on if you want custom **clink** sound packs and haptics.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink läuft komplett ohne Vollzugriff. Den normalen Systemklick bekommst du trotzdem. Schalt ihn ein, wenn du eigene **clink**-Soundpakete und Haptik willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink funciona del todo sin acceso completo. Sigues teniendo el clic normal del sistema. Actívalo si quieres packs de sonido **clink** propios y vibración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink marche très bien sans accès complet. Tu gardes le clic système habituel. Active-le si tu veux des packs de sons **clink** perso et le retour haptique."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink Teljes hozzáférés nélkül is tökéletesen működik. A megszokott rendszerkattanást így is megkapod. Kapcsold be, ha saját **clink** hangcsomagokat és rezgést szeretnél."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink funziona benissimo anche senza accesso completo. Hai comunque il clic standard del sistema. Attivalo se vuoi i pacchetti sonori **clink** e i feedback tuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkはフルアクセスがなくてもちゃんと動きます。標準のシステムクリック音はそのまま使えます。カスタムの **clink** サウンドパックやハプティクスを使いたいときだけオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink은 전체 접근 없이도 다 잘 돼요. 기본 시스템 클릭음은 그대로 나와요. 나만의 **clink** 사운드 팩과 햅틱을 쓰고 싶으면 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink berfungsi penuh tanpa Akses Penuh. Anda tetap dapat klik sistem biasa. Hidupkan kalau anda nak pek bunyi **clink** dan haptik sendiri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink funciona lindamente sem acesso total. Continuas a ter o clique normal do sistema. Liga-o se quiseres pacotes de som **clink** à tua medida e vibração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink полностью работает и без полного доступа — стандартный системный щелчок остаётся. Включайте его, если хотите свои наборы звуков **clink** и тактильную отдачу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有完全访问权限，Clink 也能完整用。你照样有系统自带的点击声。想要自定义的 **clink** 音效包和触感，就把它打开。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink töötab täielikult ka ilma täisjuurdepääsuta. Tavalise süsteemi klõpsu saad niikuinii. Lülita see sisse, kui tahad kohandatud **clink** helipakette ja haptilist tagasisidet."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink werk ten volle sonder volle toegang. Jy kry steeds die standaard stelsel klik. Skakel dit aan as jy gepasmaakte **clink**-klankpakkette en haptics wil hê."
          }
        }
      }
    },
    "Clipboard": {
      "extractionState": "manual",
      "localizations": {
