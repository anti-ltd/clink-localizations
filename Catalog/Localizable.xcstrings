    "Turn off Auto-capitalize or Auto punctuation. Smart quotes is one card down, under Punctuation.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Automatische Großschreibung oder Automatische Zeichensetzung aus. Intelligente Anführungszeichen findest du eine Karte tiefer, unter Zeichensetzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva Mayúsculas automáticas o Puntuación automática. Las Comillas tipográficas están una tarjeta más abajo, en Puntuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive Majuscules automatiques ou Ponctuation automatique. Les Guillemets typographiques sont une carte plus bas, dans Ponctuation."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold ki az Automatikus nagybetűs írást vagy az Automatikus írásjeleket. Az Okos idézőjelek egy kártyával lejjebb, a Központozás alatt vannak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva Maiuscole automatiche o Punteggiatura automatica. Le Virgolette intelligenti sono una scheda più in basso, in Punteggiatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動大文字入力」または「自動句読点」をオフにします。「スマート引用符」は一つ下の「句読点」カードにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 대문자 또는 자동 문장 부호를 끄세요. 스마트 따옴표는 한 카드 아래 구두점에 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan Huruf besar automatik atau Tanda baca automatik. Tanda kutip pintar berada satu kad di bawah, dalam Tanda baca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga Maiúsculas automáticas ou Pontuação automática. As Aspas inteligentes ficam um cartão abaixo, em Pontuação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите «Автозаглавные» или «Автопунктуацию». «Типографские кавычки» — карточкой ниже, в «Знаках препинания»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭“自动大写”或“自动标点”。“智能引号”在下面一张卡片“标点”里。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita välja Automaatne suurtäht või Automaatsed kirjavahemärgid. Nutikad jutumärgid on kaardi võrra allpool jaotises Kirjavahemärgistus."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel Outo-hoofletter of Outo-leestekens af. Slim aanhalingstekens is een kaart onder, onder Leestekens."
          }
        }
      }
    },
