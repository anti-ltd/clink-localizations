    "Install Cling and open it once, then your saved things show up here.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Installeer Cling en maak dit een keer oop, dan verskyn jou gestoorde goed hier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Cling und öffne es einmal, danach erscheint hier, was du gespeichert hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala Cling y ábrelo una vez; entonces lo que hayas guardado aparecerá aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paigalda Cling ja ava see üks kord, siis ilmuvad sinu salvestatud asjad siia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe Cling et ouvre-le une fois : tes éléments enregistrés apparaîtront ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Telepítsd a Clinget, és nyisd meg egyszer, utána itt jelenik meg, amit elmentettél."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa Cling e aprilo una volta: quello che hai salvato comparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling をインストールして一度開くと、保存したものがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling을 설치하고 한 번 열면 저장한 것이 여기에 나타납니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang Cling dan buka sekali, kemudian simpanan anda muncul di sini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o Cling e abra-o uma vez; depois o que guardou aparece aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите Cling и откройте его один раз — сохранённое появится здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 Cling 并打开一次，你保存的内容就会出现在这里。"
          }
        }
      }
    },
    "Install Cling and your saved things show up in the keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Installeer Cling en jou gestoorde goed verskyn in die sleutelbord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Cling, und was du gespeichert hast, erscheint in der Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala Cling y lo que guardes aparecerá en el teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paigalda Cling ja sinu salvestatud asjad ilmuvad klaviatuurile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe Cling et tes éléments enregistrés apparaîtront dans le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Telepítsd a Clinget, és amit elmentettél, megjelenik a billentyűzeten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa Cling e quello che hai salvato comparirà nella tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling をインストールすると、保存したものがキーボードに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling을 설치하면 저장한 것이 키보드에 나타납니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang Cling dan simpanan anda muncul dalam papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o Cling e o que guardar aparece no teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите Cling — и сохранённое появится на клавиатуре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 Cling，你保存的内容就会出现在键盘里。"
          }
        }
      }
    },
    "Install one and it shows up in the keyboard's switcher, ready to turn on and off as you type.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala uno y aparecerá en el cambio de plugins del teclado, listo para activarlo y desactivarlo mientras escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installes-en un et il apparaît dans le changeur du clavier, prêt à être activé ou désactivé pendant que tu écris."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installier eins, und es taucht im Umschalter der Tastatur auf, bereit zum Ein- und Ausschalten beim Tippen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installane uno e comparirà nel cambio plugin della tastiera, pronto da attivare e disattivare mentre scrivi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala um e aparece na troca de plugins do teclado, pronto a ligar e desligar enquanto escreves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите плагин, и он появится в переключателе на клавиатуре, готовый включаться и выключаться прямо во время набора."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang satu dan ia muncul dalam penukar pada papan kekunci, sedia dihidupkan dan dimatikan semasa anda menaip."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Telepíts egyet, és megjelenik a billentyűzet váltójában, hogy gépelés közben be- és kikapcsolhasd."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールすると、キーボードの切り替えに出てきて、入力しながらオン/オフできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装一个之后，它会出现在键盘的切换器里，打字时随时开关。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나 설치하면 키보드의 전환 목록에 나타나, 입력하는 중에도 켜고 끌 수 있습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paigalda üks ja see ilmub klaviatuuri vahetajasse, valmis kirjutamise ajal sisse ja välja lülitamiseks."
          }
        }
      }
    },
