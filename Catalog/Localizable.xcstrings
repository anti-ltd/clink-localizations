          "stringUnit": {
            "state": "translated",
            "value": "Πόσο έντονα χρωματίζουν τα χρώματα του θέματος τα πλήκτρα Liquid Glass. Το χαμηλότερο είναι πιο καθαρό, το υψηλότερο είναι πιο παγωμένο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur starkt färgar Liquid Glass-tangenterna temats färger. Lägre är klarare, högre är frostigare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor stærkt toner Liquid Glass-tasterne temaets farver. Lower is clearer, higher is frostier."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor sterkt Liquid Glass-tastene toner temaets farger. Lavere er klarere, høyere er frostigere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka voimakkaasti Liquid Glass -näppäimet sävyttävät teeman värejä. Alempi on kirkkaampaa, korkeampi on pakkasta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa kuat tombol Liquid Glass mewarnai warna tema. Lebih rendah lebih jelas, lebih tinggi lebih dingin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím của Liquid Glass nhuộm màu chủ đề mạnh đến mức nào. Thấp hơn là rõ ràng hơn, cao hơn là băng giá."
          }
        }
      }
    },
    "How strongly the backdrop responds to each key press.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe sterk die agtergrond reageer op elke sleuteldruk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark der Hintergrund auf jeden Tastendruck reagiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con qué intensidad reacciona el fondo a cada pulsación de tecla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui tugevalt taust igale klahvivajutusele reageerib."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quel point l'arrière-plan réagit à chaque pression de touche."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Milyen erősen reagál a háttér minden billentyűlenyomásra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto fortemente lo sfondo reagisce a ogni pressione di un tasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景が各キー押下にどれだけ強く反応するか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경이 각 키 입력에 얼마나 강하게 반응하는지 설정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Betapa kuat latar belakang bertindak balas terhadap setiap tekanan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O quão fortemente o fundo reage a cada pressão de tecla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько сильно фон реагирует на каждое нажатие клавиши."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景对每次按键的响应强度。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de puternic răspunde fundalul la fiecare apăsare de tastă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe sterk de achtergrond reageert op elke toetsaanslag."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景對每次按鍵的響應強度。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak mocno tło reaguje na każde naciśnięcie klawisza."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскільки сильно фон реагує на кожне натискання клавіш."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka planın her tuşa basıldığında ne kadar güçlü tepki verdiği."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak silně pozadí reaguje na každé stisknutí klávesy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako silno kulisa reaguje na každé stlačenie klávesu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο έντονα ανταποκρίνεται το φόντο σε κάθε πάτημα πλήκτρου."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur starkt bakgrunden reagerar på varje knapptryckning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor kraftigt baggrunden reagerer på hvert tastetryk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor sterkt bakteppet reagerer på hvert tastetrykk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka voimakkaasti tausta reagoi jokaiseen näppäinpainallukseen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa kuat respons latar belakang terhadap setiap penekanan tombol."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phông nền phản ứng mạnh mẽ như thế nào với mỗi lần nhấn phím."
          }
        }
      }
    },
    "How strongly the effect's colors glow over the keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe sterk gloei die effek se kleure oor die sleutels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark die Farben des Effekts über den Tasten leuchten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con qué intensidad brillan los colores del efecto sobre las teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui tugevalt efekti värvid klahvide kohal helendavad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quel point les couleurs de l'effet rayonnent sur les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Milyen erősen izzanak az effektus színei a billentyűk fölött."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto intensamente i colori dell'effetto brillano sopra i tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エフェクトの色がキーの上でどれだけ強く発光するか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "효과의 색상이 키 위에서 얼마나 강하게 빛나는지 설정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Betapa kuat warna kesan menyala di atas kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O quão intensamente as cores do efeito brilham sobre as teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько ярко цвета эффекта светятся над клавишами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "效果色彩在按键上发光的强度。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de puternic strălucesc culorile efectului peste taste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe sterk de kleuren van het effect over de toetsen schijnen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "效果色彩在按鍵上發光的強度。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak mocno kolory efektu świecą nad klawiszami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскільки сильно кольори ефекту світяться над клавішами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efektin renklerinin tuşlar üzerinde ne kadar güçlü parladığı."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak silně barvy efektu září nad klávesami."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako silno žiaria farby efektu nad klávesmi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο έντονα λάμπουν τα χρώματα του εφέ πάνω από τα πλήκτρα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur starkt lyser effektens färger över tangenterna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor stærkt lyser effektens farver hen over tangenterne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor sterkt lyser effektens farger over tastene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka voimakkaasti efektin värit hehkuvat näppäinten päällä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa kuat warna efeknya bersinar di atas tombol."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màu sắc của hiệu ứng phát sáng mạnh mẽ như thế nào trên các phím."
          }
        }
      }
    },
