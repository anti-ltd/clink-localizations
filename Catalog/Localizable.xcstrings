          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžete ho kedykoľvek odvolať v Nastavenia → Všeobecné → Klávesnica → Clink."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανακαλέστε το ανά πάσα στιγμή στις Ρυθμίσεις → Γενικά → Πληκτρολόγιο → Clink."
          }
        },
        "sv": {
