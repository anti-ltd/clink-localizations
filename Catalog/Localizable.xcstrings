            "value": "Clink mette maiuscole e punteggiatura da solo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkが勝手に大文字にしたり句読点を入れたりします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
