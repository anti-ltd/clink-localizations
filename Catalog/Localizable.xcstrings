    "Remove a clip from history after pasting it. Pinned clips are never deleted.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwyder 'n snit uit die geskiedenis nadat jy dit geplak het. Vasgespelde snitte word nooit uitgevee nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt einen Eintrag nach dem Einfügen aus dem Verlauf. Angeheftete Einträge werden nie gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita un fragmento del historial al pegarlo. Los fragmentos fijados no se borran nunca."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemaldab klipi ajaloost pärast selle kleepimist. Kinnitatud klippe ei kustutata kunagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire un élément de l'historique après l'avoir collé. Les éléments épinglés ne sont jamais supprimés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beillesztés után törli a klipet az előzményekből. A rögzített klipek soha nem törlődnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toglie un elemento dalla cronologia dopo che l'hai incollato. Quelli fissati non vengono mai eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼り付けたクリップは履歴から消します。ピン留めしたクリップは消えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붙여넣은 클립은 기록에서 지워요. 고정한 클립은 지워지지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buang keratan dari sejarah selepas anda tampal. Keratan yang dipin tak akan dipadam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira um item do histórico depois de o colares. Os itens fixados nunca são apagados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убирать фрагмент из истории после вставки. Закреплённые не удаляются никогда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴后把这条从历史里移除。固定的条目不会删。"
          }
        }
      }
    },
