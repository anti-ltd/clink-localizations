    "Add a second keyboard language in Localization for the switcher to have anything to switch between.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg 'n tweede sleutelbordtaal in Lokalisering by sodat die skakelaar enigiets het om tussen te wissel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge unter Sprache eine zweite Tastatursprache hinzu, damit der Umschalter überhaupt etwas zum Wechseln hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un segundo idioma de teclado en Idioma para que el interruptor tenga entre qué cambiar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa lehel Keeled teine klaviatuurikeel, et lülitajal oleks midagi, mille vahel lülitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une deuxième langue de clavier dans Langue pour que le bouton de bascule ait de quoi basculer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá egy második billentyűzetnyelvet a Nyelv beállításnál, hogy a váltógombnak legyen mi között váltania."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una seconda lingua della tastiera in Lingua, così il selettore ha tra cosa passare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語設定でもう一つキーボード言語を追加してください。切り替えボタンには切り替え先が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 설정에서 키보드 언어를 하나 더 추가하세요. 전환 버튼이 작동하려면 바꿀 대상이 있어야 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah bahasa papan kekunci kedua dalam Bahasa supaya suis ada sesuatu untuk ditukar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um segundo idioma de teclado em Idioma para o alternador ter entre que trocar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте второй язык клавиатуры в «Локализации», чтобы переключателю было между чем переключаться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在语言设置里再加一种键盘语言，切换按钮才有得切换。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați o a doua limbă de tastatură în Localizare pentru ca comutatorul să aibă orice între care să comute."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een tweede toetsenbordtaal toe in Lokalisatie zodat de switcher alles heeft om tussen te schakelen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在語言設定裡再加一種鍵盤語言，切換按鈕才有得切換。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj drugi język klawiatury w lokalizacji, aby przełącznik mógł się między sobą przełączać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте другу мову клавіатури в локалізацію, щоб перемикач мав будь-що для перемикання."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarlayıcının herhangi bir şey arasında geçiş yapabilmesi için Yerelleştirme'ye ikinci bir klavye dili ekleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte druhý jazyk klávesnice v lokalizaci, aby přepínač mohl přepínat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte druhý jazyk klávesnice v lokalizácii, aby mal prepínač možnosť prepínať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε μια δεύτερη γλώσσα πληκτρολογίου στο Localization για να μπορεί ο εναλλαγής να μπορεί να κάνει εναλλαγή μεταξύ τους."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till ett andra tangentbordsspråk i lokalisering för att växlaren ska ha något att växla mellan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj et andet tastatursprog i lokalisering, så switcheren har noget at skifte imellem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til et ekstra tastaturspråk i lokalisering for at veksleren skal ha noe å bytte mellom."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää lokalisointiin toinen näppäimistökieli, jotta vaihtaja voi vaihtaa mitä tahansa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan bahasa keyboard kedua di Lokalisasi agar pengalih dapat beralih antara apa pun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm ngôn ngữ bàn phím thứ hai trong Bản địa hóa để trình chuyển đổi có mọi thứ để chuyển đổi."
          }
        }
      }
    },
