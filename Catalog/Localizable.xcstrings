          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a barra de espaços premida e o teclado passa a ser um trackpad para o texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
