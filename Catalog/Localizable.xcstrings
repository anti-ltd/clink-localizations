    "On an Apple Intelligence phone it can also punctuate what you said and drop the ums.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Op 'n Apple Intelligence-foon kan dit ook lees wat jy gesê het en die ums laat val."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem Gerät mit Apple Intelligence setzt es außerdem die Satzzeichen und lässt das Ähm weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un iPhone con Apple Intelligence también puede poner la puntuación y quitar las muletillas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence’iga telefonil saab see ka lisada kirjavahemärgid sellele, mida ütlesid, ja eemaldada ummardused."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un iPhone compatible Apple Intelligence, elle peut aussi ponctuer ce que tu as dit et retirer les hésitations."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence-képes telefonon a központozást is elhelyezi, és elhagyja a hümmögést."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su un iPhone con Apple Intelligence può anche mettere la punteggiatura e togliere gli intercalari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence対応の端末では、句読点を補い、「えーと」なども省いてくれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence를 지원하는 기기에서는 문장 부호까지 넣고 군더더기도 덜어 줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada telefon dengan Apple Intelligence, ia juga boleh meletakkan tanda baca dan membuang bunyi teragak-agak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Num iPhone com Apple Intelligence também pontua o que disseste e deixa cair os hesitos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На телефоне с Apple Intelligence он ещё и расставит знаки препинания и уберёт все «эээ»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在支持 Apple Intelligence 的手机上，它还能补上标点、去掉语气词。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe un telefon Apple Intelligence poate, de asemenea, să puncteze ceea ce ați spus și să arunce mesajele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op een Apple Intelligence-telefoon kan het ook onderstrepen wat u zei en de ums laten vallen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在支援 Apple Intelligence 的手機上，它還能補上標點、去掉語氣詞。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W telefonie Apple Intelligence może także interpunkować to, co mówisz i pomijać um."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На телефоні Apple Intelligence він також може поставити розділові знаки на те, що ви сказали, і відкинути помилку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Apple Intelligence telefonda aynı zamanda söylediklerinizi noktalayabilir ve um'ları bırakabilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na telefonu Apple Intelligence může také přerušit to, co jste řekli, a vypustit um."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na telefóne Apple Intelligence môže tiež prerušiť to, čo ste povedali, a vynechať um."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε ένα τηλέφωνο Apple Intelligence μπορεί επίσης να σημειώνει στίξη σε αυτό που είπατε και να ρίξει τα ums."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På en Apple Intelligence-telefon kan den också markera det du sa och släppa ums."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På en Apple Intelligence-telefon kan den også sætte tegn på, hvad du sagde, og slippe ums."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På en Apple Intelligence-telefon kan den også sette tegn på det du sa og slippe ums."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence-puhelimessa se voi myös välitellä sanomasi ja pudottaa ummia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada ponsel Apple Intelligence, ini juga dapat memberi tanda baca pada apa yang Anda katakan dan menghilangkan ums."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên điện thoại Apple Intelligence, nó cũng có thể chấm câu những gì bạn nói và bỏ qua ừm."
          }
        }
      }
    },
