    "New words underlined, old ones dropped. Stays readable.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nuwe woorde onderstreep, oues laat val. Bly leesbaar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Wörter unterstrichen, alte entfernt. Bleibt gut lesbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Palabras nuevas subrayadas y antiguas eliminadas. Sigue siendo fácil de leer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Uued sõnad allajoonitud, vanad eemaldatud. Jääb loetavaks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouveaux mots soulignés, anciens supprimés. Le texte reste lisible."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az új szavak aláhúzva, a régiek elhagyva. Jól olvasható marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parole nuove sottolineate e vecchie rimosse. Resta leggibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい単語に下線を引き、古い単語は表示しません。読みやすさを保てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 단어에 밑줄을 긋고 이전 단어는 빼요. 읽기 쉬운 상태를 유지해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataan baharu digaris bawah, yang lama dibuang. Kekal mudah dibaca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palavras novas sublinhadas e antigas removidas. Continua fácil de ler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые слова подчёркнуты, старые убраны. Остаётся читаемым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给新词加下划线并移除旧词，保持易读。"
          }
        }
      }
    },
