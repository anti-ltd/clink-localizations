    "Light laid over the keys. Your theme's colors stay put underneath.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lig oor die sleutels gelê. Jou tema se kleure bly onder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht über den Tasten. Die Farben deines Themes bleiben darunter erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz sobre las teclas. Los colores de tu tema se mantienen debajo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgus laotatakse klahvidele. Sinu teema värvid jäävad all hoituks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une lumière posée sur les touches. Les couleurs du thème restent en dessous."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fény a gombok fölött. A téma színei alatta maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Luce sopra i tasti. I colori del tema restano sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの上に光を重ねます。テーマの色はその下に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 위에 빛을 덮습니다. 테마 색은 그 아래 그대로 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya di atas kekunci. Warna tema anda kekal di bawahnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz por cima das teclas. As cores do teu tema ficam por baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свет поверх клавиш. Цвета вашей темы остаются под ним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯光叠在按键上，主题的颜色仍留在下面。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumină pusă peste chei. Culorile temei tale rămân dedesubt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht over de toetsen gelegd. De kleuren van je thema blijven eronder staan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "燈光疊在按鍵上，主題的顏色仍留在下面。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Światło nałożone na klawisze. Kolory Twojego motywu pozostają umieszczone pod spodem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Світло прокладене над клавішами. Кольори вашої теми залишаються знизу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işık tuşların üzerine düştü. Temanızın renkleri altta kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nad klávesami bylo světlo. Barvy vašeho motivu zůstanou vespod."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Svetlo ležalo nad kľúčmi. Farby vášho motívu zostanú umiestnené pod nimi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φως πάνω από τα κλειδιά. Τα χρώματα του θέματός σας παραμένουν τοποθετημένα από κάτω."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljus lagt över nycklarna. Ditt temas färger stannar kvar under."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lys lagt over tasterne. Dit temas farver bliver siddende nedenunder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lys lagt over nøklene. Temaets farger forblir plassert under."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valo asetettu avainten päälle. Teemasi värit pysyvät alla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya diletakkan di atas kunci. Warna tema Anda tetap berada di bawahnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ánh sáng phủ lên phím đàn. Màu sắc chủ đề của bạn vẫn được đặt bên dưới."
          }
        }
      }
    },
