    "The haptic strength is Clink's own, so it works even where the system click is off.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die haptiese sterkte is Clink se eie, so dit werk selfs waar die stelselklik af is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Haptikstärke ist Clinks eigene, sie wirkt also auch dann, wenn der System-Tastenton aus ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La intensidad de la vibración es propia de Clink, así que funciona aunque el clic del sistema esté desactivado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Haptika tugevus on Clinki oma, seega töötab ta isegi seal, kus süsteemne klõps on väljas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'intensité haptique est propre à Clink : elle fonctionne même si le clic du système est désactivé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A haptika erőssége a Clink sajátja, így akkor is működik, ha a rendszer billentyűhangja ki van kapcsolva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'intensità aptica è quella di Clink, quindi funziona anche con il clic di sistema disattivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "触覚の強さはClink独自の設定なので、システムのキークリックがオフでも効きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "햅틱 세기는 Clink 자체 설정이라, 시스템 키 소리가 꺼져 있어도 작동합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekuatan haptik ialah milik Clink sendiri, jadi ia berfungsi walaupun klik sistem dimatikan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A intensidade da vibração é do próprio Clink, por isso funciona mesmo com o clique do sistema desligado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сила тактильной отдачи — своя, у Clink, поэтому она работает даже там, где системный щелчок выключен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触感强度是 Clink 自己的设置，系统按键音关着也照样有效。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puterea haptică este a lui Clink, așa că funcționează chiar și acolo unde clicul sistemului este dezactivat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De haptische kracht is die van Clink, dus hij werkt zelfs als de systeemklik is uitgeschakeld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觸感強度是 Clink 自己的設定，系統按鍵音關著也照樣有效。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siła dotyku jest charakterystyczna dla Clink, więc działa nawet wtedy, gdy kliknięcie systemowe jest wyłączone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink володіє тактильною силою, тому він працює, навіть якщо системне клацання вимкнено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokunsal güç Clink'in kendisine aittir, bu nedenle sistem tıklamasının kapalı olduğu durumlarda bile çalışır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Haptická síla je vlastní Clink, takže funguje i tam, kde je vypnuté kliknutí systému."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hmatová sila je vlastná Clink, takže funguje aj tam, kde je vypnuté kliknutie systému."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απτική ισχύς είναι δική του Clink, επομένως λειτουργεί ακόμα και όταν το κλικ του συστήματος είναι απενεργοποιημένο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den haptiska styrkan är Clink:s egen, så den fungerar även där systemklicket är avstängt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den haptiske styrke er Clink's egen, så den virker selv hvor systemklikket er slået fra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den haptiske styrken er Clink sin egen, så den fungerer selv der systemklikket er av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haptinen voimakkuus on Clink:n oma, joten se toimii myös silloin, kun järjestelmän napsautus on pois päältä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekuatan haptiknya adalah milik Clink, sehingga ia tetap berfungsi meskipun klik sistem dimatikan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cường độ xúc giác là của riêng Clink nên nó hoạt động ngay cả khi hệ thống tắt nhấp chuột."
          }
        }
      }
    },
    "The heavy ones do: lighting, the swipe trail, animated backgrounds. Low Power Mode already drops them, and you can take them down yourself.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die swaars doen: beligting, die swiep-roete, geanimeerde agtergronde. Laekragmodus laat hulle reeds val, en jy kan hulle self afneem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aufwendigen schon: Beleuchtung, die Wischspur, animierte Hintergründe. Im Stromsparmodus fallen sie ohnehin weg, und du kannst sie auch selbst zurückdrehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pesadas sí: la iluminación, el rastro del deslizamiento, los fondos animados. El modo de bajo consumo ya las quita, y tú también puedes bajarlas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasked küll: valgustus, pühkimise jälg, animeeritud taustad. Energiasäästurežiim juba eemaldab need ja sa võid need ise ka maha võtta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plus lourdes, oui : l'éclairage, la traînée de glissement, les fonds animés. Le mode économie d'énergie les coupe déjà, et tu peux les réduire toi-même."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nehezebbek igen: a világítás, a csúsztatás nyoma, az animált háttér. Energiatakarékos módban ezek amúgy is kimaradnak, de magad is visszavehetsz belőlük."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle pesanti sì: l'illuminazione, la scia dello scorrimento, gli sfondi animati. Il risparmio energetico le toglie già, e puoi ridurle anche tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重いものは消費します。ライティング、スワイプの軌跡、動く背景などです。低電力モードでは自動的に止まりますし、自分で下げることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무거운 것들은 그렇습니다. 조명, 스와이프 궤적, 움직이는 배경이요. 저전력 모드에서는 이미 꺼지고, 직접 줄일 수도 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang berat memang ya: pencahayaan, jejak leretan, latar beranimasi. Mod Kuasa Rendah sudah menggugurkannya, dan anda juga boleh menurunkannya sendiri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As pesadas gastam: a iluminação, o rasto do deslize, os fundos animados. O modo de baixo consumo já as corta, e tu também as podes reduzir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяжёлые — да: подсветка, след скольжения, анимированные фоны. Режим энергосбережения их и так отключает, а вы можете убавить их сами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重的确实费：灯光、滑行轨迹、动态背景。低电量模式下它们本来就会停，你也可以自己调低。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cele grele fac: iluminare, traseul de glisare, fundaluri animate. Modul de putere redusă le scapă deja și le puteți elimina singur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zware wel: verlichting, het veegspoor, geanimeerde achtergronden. De Low Power-modus laat ze al vallen, en je kunt ze zelf verwijderen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重的確實費：燈光、滑行軌跡、動態背景。低電量模式下它們本來就會停，你也可以自己調低。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te ciężkie: oświetlenie, przesuwany ślad, animowane tła. Tryb niskiego zużycia energii już je upuszcza i możesz je zdjąć samodzielnie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Важкі роблять: освітлення, слід проведення, анімовані фони. Режим низького енергоспоживання вже скидає їх, і ви можете зняти їх самостійно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağır olanlar bunu yapar: aydınlatma, kaydırma izi, hareketli arka planlar. Düşük Güç Modu bunları zaten düşürüyor ve bunları kendiniz de kaldırabilirsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ty těžké ano: osvětlení, swipe trail, animované pozadí. Režim nízké spotřeby je již zahodí a můžete je sundat sami."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Robia to tie ťažké: osvetlenie, swipe trail, animované pozadia. Režim nízkej spotreby ich už zahodí a môžete ich zložiť sami."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα βαριά κάνουν: φωτισμός, ίχνος σάρωσης, κινούμενα φόντο. Η λειτουργία χαμηλής κατανάλωσης τα απορρίπτει ήδη και μπορείτε να τα καταργήσετε μόνοι σας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De tunga gör det: belysning, svepspåret, animerade bakgrunder. Low Power Mode tappar dem redan och du kan ta ner dem själv."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De tunge gør det: belysning, swipe-sporet, animerede baggrunde. Low Power Mode taber dem allerede, og du kan selv tage dem ned."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De tunge gjør det: belysning, sveipesporet, animerte bakgrunner. Low Power Mode slipper dem allerede, og du kan ta dem ned selv."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Raskaat tekevät: valaistus, pyyhkäisypolku, animoidut taustat. Low Power Mode -tila pudottaa ne jo, ja voit poistaa ne itse."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang berat bisa: pencahayaan, jejak gesek, latar belakang animasi. Mode Daya Rendah sudah menjatuhkannya, dan Anda dapat mematikannya sendiri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những cái nặng làm: ánh sáng, đường vuốt, hình nền động. Chế độ năng lượng thấp đã đánh rơi chúng và bạn có thể tự mình gỡ chúng xuống."
          }
        }
      }
    },
    "The input text is deleted and replaced with the output.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die invoerteks word uitgevee en vervang met die uitvoer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der eingegebene Text wird gelöscht und durch die Ausgabe ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto que escribes se borra y se cambia por el resultado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisendtekst kustutatakse ja asendatakse väljundiga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte saisi est supprimé et remplacé par le résultat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bemeneti szöveg törlődik, és a kimenet lép a helyére."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo che scrivi viene cancellato e sostituito con il risultato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力したテキストは消えて、出力に置き換わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력한 텍스트는 지워지고 결과로 바뀌어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang anda taip dipadam dan digantikan dengan hasilnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto que escreveste é apagado e substituído pelo resultado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный текст удаляется и заменяется результатом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入的文本会被删掉，换成输出的内容。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Textul introdus este șters și înlocuit cu rezultatul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De invoertekst wordt verwijderd en vervangen door de uitvoer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入的文字會被刪掉，換成輸出的內容。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst wejściowy jest usuwany i zastępowany danymi wyjściowymi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхідний текст буде видалено та замінено вихідним."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş metni silinir ve çıktıyla değiştirilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vstupní text je odstraněn a nahrazen výstupem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vstupný text sa vymaže a nahradí výstupom."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κείμενο εισαγωγής διαγράφεται και αντικαθίσταται από το αποτέλεσμα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inmatningstexten raderas och ersätts med utdata."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtastningsteksten slettes og erstattes med outputtet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Inndatateksten slettes og erstattes med utdata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötetty teksti poistetaan ja korvataan tulosteella."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks masukan dihapus dan diganti dengan keluaran."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản đầu vào sẽ bị xóa và thay thế bằng đầu ra."
          }
        }
      }
    },
    "The instruction handed to the on-device model. Edit it to change how this action behaves. Write it as a direction, like \"Rewrite the text to be…\".": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die instruksie oorhandig aan die model op die toestel. Wysig dit om te verander hoe hierdie handeling optree. Skryf dit as 'n rigting, soos \"Herskryf die teks om te wees ...\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anweisung, die an das On-Device-Modell übergeben wird. Bearbeite sie, um das Verhalten dieser Aktion zu ändern. Formuliere sie als Anweisung, etwa \"Formuliere den Text so um, dass er …\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instrucción que se envía al modelo en el dispositivo. Edítala para cambiar cómo se comporta esta acción. Escríbela como una instrucción, como \"Reescribe el texto para que sea…\"."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Juhis, mis antakse seadmesisesele mudelile. Muuda seda, et muuta selle tegevuse käitumist. Sõnasta see juhisena, nagu „Kirjuta tekst ümber nii, et see oleks…\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'instruction transmise au modèle sur l'appareil. Modifie-la pour changer le comportement de cette action. Formule-la comme une consigne, du genre \"Réécris le texte pour qu'il soit…\"."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utasítás, amit a készüléken futó modell kap. Szerkeszd, hogy megváltoztasd a művelet viselkedését. Fogalmazd meg utasításként, például \"Írd át a szöveget úgy, hogy…\"."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'istruzione inviata al modello sul dispositivo. Modificala per cambiare il comportamento di questa azione. Scrivila come un'istruzione, tipo \"Riscrivi il testo in modo che sia…\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末上のモデルに渡す指示です。編集するとこのアクションの動作を変えられます。「テキストを次のように書き直す…」のように指示として書いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 안의 모델에게 전달되는 지시문이에요. 수정하면 이 액션의 동작이 바뀌어요. \"텍스트를 이렇게 다시 써줘…\"처럼 지시문으로 작성하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahan yang diberikan kepada model pada peranti. Edit untuk ubah cara tindakan ini berfungsi. Tulis sebagai arahan, seperti \"Tulis semula teks supaya…\"."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A instrução dada ao modelo no dispositivo. Edita-a para mudares o comportamento desta ação. Escreve como uma instrução, tipo \"Reescreve o texto para ficar…\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Указание, которое передаётся модели на устройстве. Измените его, чтобы поменять поведение действия. Пишите как указание — например, «Перепиши текст так, чтобы он был…»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是发给本机模型的指令。修改它可以改变这个操作的行为，把它写成一句指令，比如“把这段文字改写成……”。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrucțiunea transmisă modelului de pe dispozitiv. Editați-l pentru a schimba modul în care se comportă această acțiune. Scrieți-o ca o direcție, cum ar fi „Rescrieți textul care urmează să fie...”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De instructie die wordt doorgegeven aan het model op het apparaat. Bewerk het om te wijzigen hoe deze actie zich gedraagt. Schrijf het als een richting, zoals 'Herschrijf de tekst zodat...'."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是發給本機模型的指令。修改它可以改變這個操作的行為，把它寫成一句指令，比如“把這段文字改寫成……”。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrukcja przekazana do modelu na urządzeniu. Edytuj go, aby zmienić sposób działania tej akcji. Napisz to jako wskazówkę, np. „Przepisz tekst tak, aby był…”."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інструкція, передана моделі пристрою. Відредагуйте його, щоб змінити спосіб поведінки цієї дії. Напишіть це як вказівку, наприклад «Перепишіть текст, щоб бути…»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Talimat cihazdaki modele iletildi. Bu eylemin nasıl davranacağını değiştirmek için düzenleyin. \"Metni yeniden yaz...\" gibi bir yön olarak yazın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokyn předán modelu na zařízení. Upravte jej, abyste změnili chování této akce. Napište to jako směr, například „Přepište text tak, aby byl…“."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokyny odovzdané modelu na zariadení. Upravte ho, aby ste zmenili správanie tejto akcie. Napíšte to ako smer, napríklad „Prepíšte text tak, aby bol…“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η οδηγία παραδόθηκε στο μοντέλο της συσκευής. Επεξεργαστείτε το για να αλλάξετε τον τρόπο συμπεριφοράς αυτής της ενέργειας. Γράψτε το ως κατεύθυνση, όπως \"Ξαναγράψτε το κείμενο για να…\"."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Instruktionen överlämnas till modellen på enheten. Redigera den för att ändra hur den här åtgärden beter sig. Skriv det som en riktning, som \"Skriv om texten till att vara...\"."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Instruktionen afleveret til modellen på enheden. Rediger den for at ændre, hvordan denne handling opfører sig. Skriv det som en retning, som \"Omskriv teksten til at være...\"."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Instruksjonen overlevert til modellen på enheten. Rediger den for å endre hvordan denne handlingen oppfører seg. Skriv det som en retning, som \"Skriv om teksten til å være ...\"."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohje annettiin laitteen mallille. Muokkaa sitä muuttaaksesi tämän toiminnon toimintaa. Kirjoita se ohjeeksi, kuten \"Kirjoita teksti uudelleen…\"."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instruksi diserahkan ke model pada perangkat. Edit untuk mengubah perilaku tindakan ini. Tuliskan sebagai petunjuk, seperti \"Tulis ulang teks menjadi...\"."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hướng dẫn được chuyển đến mô hình trên thiết bị. Chỉnh sửa nó để thay đổi cách hành động này hoạt động. Hãy viết theo hướng dẫn, chẳng hạn như \"Viết lại văn bản thành...\"."
          }
        }
      }
    },
    "The key for this hasn't reached this device yet. It arrives through iCloud Keychain, so check that iCloud Keychain is on in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sleutel hiervoor het nog nie hierdie toestel bereik nie. Dit kom deur iCloud Sleutelhanger, so maak seker dat iCloud Sleutelhanger aan is in Instellings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel dafür ist noch nicht auf diesem Gerät. Er kommt über den iCloud-Schlüsselbund, prüf also in den Einstellungen, ob der aktiv ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave todavía no ha llegado a este dispositivo. Llega por el llavero de iCloud, así que comprueba que esté activado en Ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle võti ei ole veel sellesse seadmesse jõudnud. Ta tuleb iCloudi võtmehoidja kaudu, seega kontrolli, et võtmehoidja oleks seadetes sees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé n’est pas encore arrivée sur cet appareil. Elle passe par le trousseau iCloud, vérifie donc qu’il est activé dans Réglages."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kulcs még nem érkezett meg erre az eszközre. Az iCloud-kulcskarikán át jön, ezért nézd meg a Beállításokban, hogy be van-e kapcsolva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave non è ancora arrivata su questo dispositivo. Passa dal portachiavi iCloud, quindi controlla che sia attivo in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目の鍵はまだこの端末に届いていません。鍵はiCloudキーチェーン経由で届くため、「設定」でオンになっているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목의 키가 아직 이 기기에 도착하지 않았습니다. 키는 iCloud 키체인을 통해 전달되니 설정에서 켜져 있는지 확인해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci untuk ini belum sampai ke peranti ini. Ia tiba melalui Rantai Kunci iCloud, jadi pastikan ia dihidupkan dalam Tetapan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave disto ainda não chegou a este dispositivo. Vem pelo porta-chaves do iCloud, por isso confirma nas Definições que está ligado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ для этого пока не добрался до устройства. Он приходит через Связку ключей iCloud, так что проверьте, включена ли она в Настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项的密钥尚未送达这台设备。密钥通过 iCloud 钥匙串传递，请在“设置”中确认已开启。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia pentru aceasta nu a ajuns încă pe acest dispozitiv. Sosește prin brelocul iCloud, așa că verificați dacă brelocul iCloud este activat în Configurări."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutel hiervoor heeft dit apparaat nog niet bereikt. Het komt binnen via de iCloud-sleutelhanger, dus controleer of de iCloud-sleutelhanger is ingeschakeld in Instellingen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此項的金鑰尚未送達這臺裝置。金鑰透過 iCloud 鑰匙串傳遞，請在“設定”中確認已開啟。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz do tego nie dotarł jeszcze do tego urządzenia. Dociera poprzez pęk kluczy iCloud, więc sprawdź, czy pęk kluczy iCloud jest włączony w Ustawieniach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ для цього ще не надійшов на цей пристрій. Він надходить через iCloud Keychain, тому переконайтеся, що iCloud Keychain увімкнено в налаштуваннях."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun anahtarı henüz bu cihaza ulaşmadı. iCloud Anahtarlık aracılığıyla ulaştığından Ayarlar'da iCloud Anahtarlık'ın açık olup olmadığını kontrol edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíč k tomuto zařízení ještě nedorazil. Doručuje se prostřednictvím klíčenky iCloud, takže v Nastavení zkontrolujte, zda je klíčenka iCloud zapnutá."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kľúč na to ešte nedorazil do tohto zariadenia. Doručuje sa prostredníctvom kľúčenky iCloud, takže v nastaveniach skontrolujte, či je kľúčenka iCloud zapnutá."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κλειδί για αυτό δεν έχει φτάσει ακόμα σε αυτήν τη συσκευή. Φτάνει μέσω του iCloud Keychain, επομένως βεβαιωθείτε ότι το iCloud Keychain είναι ενεργοποιημένο στις Ρυθμίσεις."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckeln till detta har inte nått den här enheten än. Den kommer via iCloud Keychain, så kontrollera att iCloud Keychain är på i Inställningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøglen til dette har ikke nået denne enhed endnu. Den ankommer gennem iCloud Nøglering, så tjek at iCloud Nøglering er aktiveret i Indstillinger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøkkelen til dette har ikke nådd denne enheten ennå. Den kommer gjennom iCloud nøkkelring, så sjekk at iCloud nøkkelring er på i Innstillinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän avain ei ole vielä saavuttanut tätä laitetta. Se saapuu iCloud Keychainin kautta, joten tarkista, että iCloud Keychain on päällä asetuksista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuncinya belum sampai ke perangkat ini. Itu datang melalui Gantungan Kunci iCloud, jadi periksa apakah Gantungan Kunci iCloud aktif di Pengaturan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chìa khóa cho việc này vẫn chưa đến được thiết bị này. Nó đến thông qua Chuỗi khóa iCloud, vì vậy hãy kiểm tra xem Chuỗi khóa iCloud có bật trong Cài đặt hay không."
          }
        }
      }
    },
    "The key lighting color and brightness from this theme.": {
      "extractionState": "manual",
      "localizations": {
