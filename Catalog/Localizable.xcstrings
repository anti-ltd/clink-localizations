    "Test interrupted. Try again when you’re ready.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Test unterbrochen. Versuch es erneut, wenn du bereit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test interrupted. Try again when you’re ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba interrumpida. Inténtalo de nuevo cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Test katkes. Proovi uuesti, kui oled valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test interrompu. Réessaie quand tu veux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teszt megszakadt. Próbáld újra, amikor készen állsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Test interrotto. Riprova quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストが中断されました。準備ができたら、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트가 중단되었습니다. 준비되면 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujian terganggu. Cuba lagi apabila anda bersedia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste interrompido. Tenta novamente quando quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тест прерван. Попробуйте снова, когда будете готовы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试已中断。准备好后，可以重新开始。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Testul a fost întrerupt. Încercați din nou când sunteți gata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Test onderbroken. Probeer het opnieuw als je er klaar voor bent."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測試已中斷。準備好後，可以重新開始。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Toets onderbreek. Probeer weer wanneer jy gereed is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Test przerwany. Spróbuj ponownie, gdy będziesz gotowy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тест перервано. Спробуйте ще раз, коли будете готові."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test kesintiye uğradı. Hazır olduğunuzda tekrar deneyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Test přerušen. Zkuste to znovu, až budete připraveni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Test prerušený. Skúste to znova, keď budete pripravení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δοκιμή διακόπηκε. Δοκιμάστε ξανά όταν είστε έτοιμοι."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Testet avbröts. Försök igen när du är redo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Test afbrudt. Prøv igen, når du er klar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Testen ble avbrutt. Prøv igjen når du er klar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Testi keskeytetty. Yritä uudelleen, kun olet valmis."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes terhenti. Coba lagi jika Anda sudah siap."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra bị gián đoạn. Hãy thử lại khi bạn đã sẵn sàng."
          }
        }
      }
    },
