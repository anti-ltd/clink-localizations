    "A .com key right of the space bar": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n .com-sleutel regs van die spasiebalk"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine .com-Taste rechts von der Leertaste"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tecla .com a la derecha de la barra espaciadora"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": ".com-klahv tühikuklahvi paremal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une touche .com à droite de la barre d'espace"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy .com billentyű a szóköztől jobbra"
          }
        },
        "it": {
