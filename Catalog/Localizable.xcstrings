    "Symbol on every letter’s long-press (A → @, S → #, …), no accents": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simbool op elke letter se langdruk (A → @, S → #, …), geen aksent nie"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbol beim langen Drücken jedes Buchstabens (A → @, S → #, …), keine Akzente"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un símbolo en cada pulsación larga de letra (A → @, S → #, …), sin acentos"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sümbol iga tähe pikkvajutusel (A → @, S → #, …), aksentideta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un symbole sur l'appui long de chaque lettre (A → @, S → #, …), sans accents"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szimbólum minden betű hosszú lenyomásán (A → @, S → #, …), ékezetek nélkül"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un simbolo sulla pressione prolungata di ogni lettera (A → @, S → #, …), senza accenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての文字の長押しで記号 (A → @, S → #, …)、アクセントなし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 글자를 길게 누르면 기호 (A → @, S → #, …), 악센트는 없어요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simbol pada tekan lama setiap huruf (A → @, S → #, …), tiada aksen"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Símbolo no toque prolongado de cada letra (A → @, S → #, …), sem acentos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Символ по долгому нажатию на каждой букве (A → @, S → #, …), без акцентов"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个字母长按都有一个符号（A → @, S → #, …），不带重音"
          }
        }
      }
    },
