    "Offline autocomplete above the keys, fully on device. Set the space above it under Keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vanlyn outovoltooi bokant die sleutels, volledig op toestel. Stel die spasie daarbo onder Sleutels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-Autovervollständigung über den Tasten, komplett auf dem Gerät. Den Abstand darüber stellst du unter Tasten ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autocompletado sin conexión sobre las teclas, todo en el dispositivo. Ajusta el espacio superior en Teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühenduseta automaatlõpetus klahvide kohal, täielikult seadmel. Määra ruum selle kohal jaotises Klahvid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autocomplétion hors ligne au-dessus des touches, entièrement sur l'appareil. Règle l'espace au-dessus dans Touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline automatikus kiegészítés a billentyűk fölött, teljesen az eszközön. A fölötte lévő helyet a Billentyűk alatt állíthatod be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completamento automatico offline sopra i tasti, tutto sul dispositivo. Imposta lo spazio sopra in Tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの上に表示される、すべて端末内で動くオフラインの自動補完です。上の余白は「キー」で設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 위에 뜨는 오프라인 자동 완성으로, 전부 기기 안에서 처리돼요. 위쪽 간격은 '키'에서 설정해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Autolengkap luar talian di atas kekunci, sepenuhnya pada peranti. Tetapkan ruang di atasnya dalam Kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenchimento automático offline sobre as teclas, tudo no dispositivo. Define o espaço acima em Teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Офлайн-автодополнение над клавишами, целиком на устройстве. Отступ над ним задаётся в разделе «Клавиши»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键上方的离线自动补全，全部在设备本地完成。上方间距可在“按键”里设置。"
          }
        }
      }
    },
    "Offline translation needs iOS 18. Choose an AI provider under Integrations to translate on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline translation needs iOS 18. Choose an AI provider under Integrations to translate on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción sin conexión requiere iOS 18. Elige un proveedor de IA en Integraciones para traducir en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction hors ligne nécessite iOS 18. Choisis un fournisseur d’IA dans Intégrations pour traduire sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-Übersetzung erfordert iOS 18. Wähle unter Integrationen einen KI-Anbieter, um auf diesem Gerät zu übersetzen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione offline richiede iOS 18. Scegli un fornitore IA in Integrazioni per tradurre su questo dispositivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução offline requer o iOS 18. Escolhe um fornecedor de IA em Integrações para traduzir neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для перевода без интернета нужна iOS 18. Выберите провайдера ИИ в разделе «Интеграции», чтобы переводить на этом устройстве."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan luar talian memerlukan iOS 18. Pilih penyedia AI di bawah Integrasi untuk menterjemah pada peranti ini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az offline fordításhoz iOS 18 szükséges. A készüléken való fordításhoz válassz AI-szolgáltatót az Integrációk alatt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン翻訳にはiOS 18が必要です。このデバイスで翻訳するには、「連携」でAIプロバイダーを選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线翻译需要 iOS 18。请在“集成”中选择 AI 提供商，以在此设备上使用翻译。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 번역에는 iOS 18이 필요합니다. 이 기기에서 번역하려면 통합에서 AI 제공업체를 선택하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võrguühenduseta tõlge vajab iOS 18. Selles seadmes tõlkimiseks vali jaotises Integratsioonid AI-teenusepakkuja."
          }
        }
      }
    },
    "Offline translation needs iOS 18. Turn on Apple Intelligence under Integrations to translate on this device.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vanlyn vertaling benodig iOS 18. Skakel Apple Intelligence onder Integrasies aan om op hierdie toestel te vertaal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Offline-Übersetzung benötigt iOS 18. Schalte Apple Intelligence unter Integrationen ein, um auf diesem Gerät zu übersetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción sin conexión requiere iOS 18. Activa Apple Intelligence en Integraciones para traducir en este dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühenduseta tõlge vajab iOS 18. Lülita Apple Intelligence sisse jaotises Integratsioonid, et selles seadmes tõlkida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction hors ligne nécessite iOS 18. Active Apple Intelligence dans Intégrations pour traduire sur cet appareil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az offline fordításhoz iOS 18 kell. Az eszközön végzett fordításhoz kapcsold be az Apple Intelligence-t az Integrációk alatt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione offline richiede iOS 18. Attiva Apple Intelligence in Integrazioni per tradurre su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン翻訳にはiOS 18が必要です。このデバイスで翻訳するには、連携でApple Intelligenceをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 번역에는 iOS 18이 필요해요. 이 기기에서 번역하려면 연동에서 Apple Intelligence를 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan luar talian memerlukan iOS 18. Hidupkan Apple Intelligence dalam Integrasi untuk menterjemah pada peranti ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução offline requer iOS 18. Ativa o Apple Intelligence em Integrações para traduzir neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для офлайн-перевода нужен iOS 18. Включите Apple Intelligence в разделе «Интеграции», чтобы переводить на этом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线翻译需要 iOS 18。请在“集成”中开启 Apple Intelligence，以便在此设备上翻译。"
          }
        }
      }
    },
