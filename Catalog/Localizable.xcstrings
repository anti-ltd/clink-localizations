    "The light is holding still to protect performance. Presses still light up.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz permanece fija para mantener el rendimiento. Las pulsaciones siguen iluminándose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière reste fixe pour préserver les performances. Les touches s’allument toujours à l’appui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Licht bleibt unbewegt, um die Leistung zu schonen. Tastendrücke leuchten weiterhin auf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La luce resta ferma per preservare le prestazioni. I tasti si illuminano ancora alla pressione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A luz fica estática para preservar o desempenho. As teclas continuam a iluminar-se ao premir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсветка неподвижна для сохранения производительности. Нажатия по-прежнему подсвечиваются."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya tidak bergerak untuk mengekalkan prestasi. Kekunci masih menyala apabila ditekan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljesítmény megőrzése érdekében a fény nem mozog. A leütések továbbra is felvillannak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パフォーマンスを保つため、光の動きを止めています。キーを押したときの点灯は続きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为保持性能，灯光保持静止。按键按下时仍会亮起。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성능을 유지하기 위해 빛이 움직이지 않습니다. 키를 누르면 계속 빛납니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jõudluse hoidmiseks valgus ei liigu. Vajutused süütavad endiselt valguse."
          }
        }
      }
    },
    "The light takes the cap. Boldest look, and it overrules the theme.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die lig vat die pet. Die sterkste voorkoms, en dit oorheers die tema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Licht übernimmt die Taste. Der kräftigste Look – und er setzt sich über das Theme hinweg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz se queda con la tecla. El look más intenso, y manda sobre el tema."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgus võtab kate endale. Kõige julgem ilme ja ta alistab teema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière prend la touche. Le rendu le plus marqué, et il l'emporte sur le thème."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fény átveszi a gombot. A legerősebb hatás, és felülírja a témát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La luce prende il tasto. L'effetto più deciso, e ha la meglio sul tema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光がキー面を占めます。もっとも大胆で、テーマより優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛이 키캡을 차지합니다. 가장 과감하고, 테마보다 우선합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya mengambil alih kekunci. Rupa paling berani, dan ia mengatasi tema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A luz fica com a tecla. O aspeto mais forte, e sobrepõe-se ao tema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свет заливает всю клавишу. Самый смелый вид — он перекрывает тему."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯光占据键帽。最张扬的效果，并会盖过主题。"
          }
        }
      }
    },
    "The list came with word counts, so common words will be suggested first.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die lys het met woordtellings gekom, so algemene woorde sal eerste voorgestel word."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste bringt Häufigkeiten mit – häufige Wörter werden zuerst vorgeschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista trae frecuencias, así que las palabras comunes se sugerirán primero."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loendis olid sõnade arvud, seega tavasõnu soovitatakse esimesena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste contient des fréquences : les mots courants seront proposés en premier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista tartalmaz gyakorisági számokat, így a gyakori szavak kerülnek előre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elenco include le frequenze, quindi le parole comuni verranno suggerite per prime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストに出現数が付いているので、よく使う語から候補に出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에 빈도 수치가 있어 자주 쓰는 단어가 먼저 추천됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai ini disertakan kiraan perkataan, jadi perkataan biasa akan dicadangkan dahulu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista traz frequências, por isso as palavras comuns aparecem primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В списке были частоты слов, поэтому частые слова будут предлагаться первыми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词表自带词频，常用词会优先出现在候选中。"
          }
        }
      }
    },
    "The list is alphabetical with no counts, so every word carries equal weight. A list with counts after each word ranks better.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die lys is alfabeties met geen tellings nie, so elke woord dra ewe veel gewig. 'n Lys met tellings na elke woord is beter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste ist alphabetisch und ohne Häufigkeiten, also wiegt jedes Wort gleich. Eine Liste mit Zahlen hinter den Wörtern sortiert besser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista está en orden alfabético y sin frecuencias, así que todas las palabras pesan igual. Una lista con un número tras cada palabra ordena mejor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loend on tähestikuline, ilma arvudeta, seega iga sõna kaalub võrdselt. Loend sõna järel olevate arvudega järjestab paremini."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste est alphabétique et sans fréquences : tous les mots ont le même poids. Une liste avec un nombre après chaque mot donne un meilleur classement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista ábécérendben van, gyakoriságok nélkül, így minden szó azonos súlyú. A szavak után írt számokkal jobb lenne a sorrend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elenco è in ordine alfabetico e senza frequenze, quindi ogni parola pesa uguale. Un elenco con un numero dopo ogni parola ordina meglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストは五十音・アルファベット順で出現数がないため、すべての語が同じ重みになります。語の後ろに数値があるリストなら候補順が良くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록이 사전순이고 빈도가 없어 모든 단어의 가중치가 같습니다. 단어 뒤에 숫자가 있는 목록이 순서가 더 좋습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai ini mengikut abjad tanpa kiraan, jadi semua perkataan sama berat. Senarai dengan nombor selepas setiap perkataan menyusun lebih baik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista está por ordem alfabética e sem frequências, por isso todas as palavras pesam o mesmo. Uma lista com um número depois de cada palavra ordena melhor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список отсортирован по алфавиту и без частот, поэтому все слова равнозначны. Список с числом после каждого слова ранжируется лучше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词表按字母顺序排列且没有词频，因此每个词权重相同。词后带数字的词表排序更好。"
          }
        }
      }
    },
    "The list of installed plugins lives in Clink's shared storage, and the keyboard can only reach it with Full Access. Until it's on, the switcher stays out of the Tools menu.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de plugins instalados vive en el almacenamiento compartido de Clink, y el teclado solo llega a ella con acceso completo. Hasta que lo actives, el cambio de plugins no aparece en el menú Herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des plugins installés vit dans le stockage partagé de Clink, et le clavier n'y accède qu'avec l'accès complet. Tant qu'il est désactivé, le changeur reste hors du menu Outils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste der installierten Plugins liegt in Clinks gemeinsamem Speicher, und die Tastatur kommt nur mit Vollzugriff daran. Bis der an ist, bleibt der Umschalter aus dem Werkzeuge-Menü draußen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco dei plugin installati vive nella memoria condivisa di Clink, e la tastiera ci arriva solo con l'accesso completo. Finché è spento, il cambio plugin resta fuori dal menu Strumenti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de plugins instalados vive no armazenamento partilhado do Clink, e o teclado só lhe chega com acesso total. Enquanto estiver desligado, a troca de plugins fica fora do menu Ferramentas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список установленных плагинов лежит в общем хранилище Clink, а клавиатура добирается до него только при полном доступе. Пока он выключен, переключателя в меню инструментов не будет."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai plugin yang dipasang berada dalam storan kongsi Clink, dan papan kekunci hanya boleh mencapainya dengan akses penuh. Selagi ia belum dihidupkan, penukar itu tak muncul dalam menu Alat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telepített bővítmények listája a Clink megosztott tárhelyén van, és a billentyűzet csak teljes hozzáféréssel fér hozzá. Amíg ez ki van kapcsolva, a váltó nem kerül be az Eszközök menübe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みプラグインの一覧は Clink の共有ストレージにあり、キーボードはフルアクセスがないとそこに届きません。オンにするまで、切り替えはツールメニューに出てきません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装插件的列表存在 Clink 的共享存储里，而键盘只有拿到完全访问才够得着。没打开之前，切换器不会出现在工具菜单里。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 플러그인 목록은 Clink의 공유 저장소에 있어서, 키보드는 전체 접근이 있어야 닿을 수 있습니다. 켜기 전까지는 전환 도구가 도구 메뉴에 나오지 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paigaldatud pistikprogrammide loend asub Clinki jagatud salvestusruumis ja klaviatuur jõuab sinna ainult täisjuurdepääsuga. Enne kui see on sees, jääb vahetaja Tööriistade menüüst välja."
          }
        }
      }
    },
    "The mark the double-space shortcut writes.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die merk wat die dubbelspasie-kortpad skryf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zeichen, das die Leertasten-Abkürzung schreibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El signo que escribe el atajo del doble espacio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märk, mille topelttühiku otsetee sisestab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le signe que produit le raccourci de la double espace."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jel, amit a dupla szóköz beír."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il segno prodotto dalla scorciatoia del doppio spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースを 2 回押したときに入る記号です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스를 두 번 눌렀을 때 입력되는 기호입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda yang ditulis oleh pintasan ruang dua kali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O sinal que o atalho do espaço duplo escreve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знак, который ставит двойной пробел."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连按两次空格时输入的符号。"
          }
        }
      }
    },
    "The model couldn't finish that one. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo no ha podido completar la tarea. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle n’a pas pu terminer. Réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell konnte die Aufgabe nicht abschließen. Versuch es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello non è riuscito a completare l’operazione. Riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo não conseguiu concluir a tarefa. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель не смогла завершить задачу. Попробуйте ещё раз."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Model tidak dapat menyelesaikan tugas itu. Cuba lagi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A modell nem tudta befejezni a feladatot. Próbáld újra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが処理を完了できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型未能完成处理，请重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 작업을 완료하지 못했습니다. 다시 시도해 주세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudel ei suutnud toimingut lõpetada. Proovi uuesti."
          }
        }
      }
    },
    "The model couldn't finish this request. See Details for more information.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model couldn't finish this request. See Details for more information."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell konnte diese Anfrage nicht abschließen. Mehr dazu unter „Details“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo no pudo completar esta solicitud. Consulta los detalles para obtener más información."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudel ei saanud seda päringut lõpule viia. Lisateavet leiad üksikasjadest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle n’a pas pu terminer cette demande. Consulte les détails pour en savoir plus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A modell nem tudta befejezni ezt a kérést. További információ a részleteknél."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello non è riuscito a completare la richiesta. Consulta i dettagli per saperne di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルがこのリクエストを完了できませんでした。「詳細」で詳しい情報を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 요청을 완료하지 못했습니다. 자세한 내용은 세부사항을 확인해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Model tidak dapat menyelesaikan permintaan ini. Lihat Butiran untuk maklumat lanjut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo não conseguiu concluir este pedido. Consulta os detalhes para saberes mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель не смогла выполнить запрос. Подробная информация доступна в разделе «Подробности»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型未能完成此请求。请查看详情了解更多信息。"
          }
        }
      }
    },
    "The model is still getting ready. Try again in a bit.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die model maak nog gereed. Probeer oor 'n rukkie weer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell wird noch vorbereitet. Versuch es gleich nochmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo aún se está preparando. Inténtalo otra vez en un momento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudel on veel ettevalmistamisel. Proovi pisut hiljem uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle se prépare encore. Réessaie dans un instant."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A modell még készül. Próbáld újra egy kicsit később."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello si sta ancora preparando. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルはまだ準備中です。少し待ってからもう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 아직 준비 중이에요. 잠시 후에 다시 해보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Model masih bersiap. Cuba lagi sekejap."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo ainda se está a preparar. Tenta outra vez daqui a bocado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель ещё готовится. Попробуйте чуть позже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型还在准备中，过一会儿再试试。"
          }
        }
      }
    },
    "The model's API id, not the name in the provider's chat app. A paid API account is separate from a chat subscription.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El id de API del modelo, no el nombre que aparece en la app de chat del proveedor. Una cuenta de API de pago es independiente de una suscripción de chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identifiant d’API du modèle, pas le nom affiché dans l’app de conversation du fournisseur. Un compte d’API payant est distinct d’un abonnement de conversation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die API-ID des Modells, nicht der Name in der Chat-App des Anbieters. Ein kostenpflichtiges API-Konto ist unabhängig von einem Chat-Abo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’id API del modello, non il nome mostrato nell’app di chat del provider. Un account API a pagamento è separato da un abbonamento alla chat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O id de API do modelo, não o nome que aparece no app de chat do provedor. Uma conta de API paga é separada de uma assinatura de chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор модели в API, а не название в чат-приложении провайдера. Платный аккаунт API не связан с подпиской на чат."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Id API model, bukan nama dalam apl sembang pembekal. Akaun API berbayar adalah berasingan daripada langganan sembang."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A modell API-azonosítója, nem a szolgáltató csevegőappjában látható név. A fizetős API-fiók külön van a csevegő-előfizetéstől."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルのAPI IDです。プロバイダのチャットアプリに表示される名前ではありません。有料のAPIアカウントはチャットの購読とは別です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型的 API id，不是服务商聊天应用中显示的名称。付费 API 账户与聊天订阅是两回事。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자의 챗 앱에 표시되는 이름이 아니라 모델의 API id입니다. 유료 API 계정은 챗 구독과 별개입니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudeli API-id, mitte nimi, mida teenusepakkuja vestlusrakendus näitab. Tasuline API-konto on vestluse tellimusest eraldi."
          }
        }
      }
    },
    "The original dark and gold icon": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die oorspronklike donker en goue ikoon"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ursprüngliche dunkle Symbol mit Gold"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El icono original en oscuro y dorado"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Algne tume ja kuldne ikoon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icône d'origine, sombre et dorée"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredeti sötét, aranyozott ikon"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icona originale scura e dorata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のダークとゴールドのアイコン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래의 다크 골드 아이콘"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikon gelap dan emas yang asal"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone original em escuro e dourado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изначальная тёмно-золотая иконка"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最初的深色与金色图标"
          }
        }
      }
    },
    "The other keys in the row give way to make space. You can also drag a key's edge in the preview.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die ander sleutels in die ry maak plek om plek te maak. Jy kan ook 'n sleutel se rand in die voorskou sleep."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die anderen Tasten der Reihe machen Platz. Du kannst auch in der Vorschau am Rand einer Taste ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las demás teclas de la fila se apartan para hacer sitio. También puedes arrastrar el borde de una tecla en la vista previa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülejäänud klahvid reas teevad ruumi. Sa võid ka eelvaates klahvi serva lohistada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres touches de la rangée s'écartent pour faire de la place. Tu peux aussi tirer le bord d'une touche dans l'aperçu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sor többi billentyűje helyet ad neki. Az előnézetben a billentyű szélét is húzhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli altri tasti della riga si stringono per fare spazio. Puoi anche trascinare il bordo di un tasto nell'anteprima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ行のほかのキーが縮んで場所を空けます。プレビューでキーの端をドラッグしても変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 행의 다른 키들이 자리를 내줘요. 미리보기에서 키의 가장자리를 끌어도 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci lain dalam baris itu beralah untuk beri ruang. Anda juga boleh seret tepi kekunci dalam pratonton."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As outras teclas da linha abrem espaço. Também podes puxar a extremidade de uma tecla na pré-visualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остальные клавиши в ряду подвинутся, освобождая место. Можно также потянуть за край клавиши в предпросмотре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一行的其他按键会让出空间。你也可以在预览里拖按键的边缘。"
          }
        }
      }
    },
    "The output is inserted at the cursor, keeping the input.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die afvoer word by die wyser ingevoeg, en behou die invoer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgabe wird an der Cursorposition eingefügt, deine Eingabe bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado se inserta donde tengas el cursor y se conserva lo que escribiste."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Väljund sisestatakse kursori kohale, sisend jääb alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat s'insère au niveau du curseur, sans toucher au texte d'origine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kimenet a kurzorhoz kerül be, a bevitt szöveg megmarad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'output viene inserito al cursore, tenendo l'input."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力はそのままに、カーソル位置に結果を挿入します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력한 내용은 그대로 두고 커서 위치에 결과가 들어가요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasilnya dimasukkan pada kursor, input anda kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado é inserido no cursor, mantendo o que escreveste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат вставляется у курсора, а исходный текст остаётся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果会插入到光标处，输入的内容还留着。"
          }
        }
      }
    },
    "The padding sliders below set how much room the keyboard takes overall.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die opvulling-glyers hieronder bepaal hoeveel spasie die sleutelbord in die algemeen neem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abstands-Regler darunter bestimmen, wie viel Platz die Tastatur insgesamt einnimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los deslizadores de margen de debajo fijan cuánto espacio ocupa el teclado en total."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Allpool olevad äärise liugurid määravad, kui palju ruumi klaviatuur kokku võtab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les curseurs de marge en dessous fixent la place que prend le clavier au total."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alattuk lévő térköz-csúszkák szabják meg, mennyi helyet foglal összesen a billentyűzet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I cursori dei margini sotto stabiliscono quanto spazio occupa la tastiera in tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その下の余白スライダーで、キーボード全体が占める広さを決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 아래 여백 슬라이더는 키보드 전체가 차지하는 공간을 정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peluncur pelapik di bawah menetapkan berapa banyak ruang yang papan kekunci ambil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cursores de margem por baixo definem o espaço que o teclado ocupa no total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регуляторы отступов ниже задают, сколько места занимает клавиатура целиком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下面的边距滑块决定整个键盘占多大地方。"
          }
        }
      }
    },
    "The page opens the rest of its controls, and stays open.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die bladsy maak die res van sy kontroles oop en bly oop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite klappt ihre restlichen Einstellungen auf und bleibt so."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página despliega el resto de sus controles y se queda así."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Leht avab oma ülejäänud juhtelemendid ja jääb avatuks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page déplie le reste de ses réglages et reste ouverte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az oldal kinyitja a maradék vezérlőt, és nyitva is marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pagina apre il resto dei suoi controlli e resta così."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのページの残りの設定が開き、以後は開いたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 페이지의 나머지 설정이 열리고, 계속 열린 채로 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman itu membuka baki kawalannya, dan kekal terbuka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A página abre o resto dos controlos e fica assim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страница раскрывает остальные регуляторы и остаётся раскрытой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一页剩下的设置会展开，并保持展开。"
          }
        }
      }
    },
    "The panel-pack download could not be verified.": {
      "extractionState": "manual",
