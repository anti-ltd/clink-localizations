    "Reorder the keyboard's Translate menu, switch off any you don't want, and download a language to use it offline.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Herrangskik die sleutelbord se Vertaal-kieslys, skakel enige wat jy nie wil hê nie, en laai 'n taal af om dit vanlyn te gebruik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordne das Übersetzen-Menü der Tastatur, schalte ungewollte Sprachen ab und lade eine Sprache herunter, um sie offline zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordena el menú de Traducir del teclado, desactiva las que no quieras y descarga un idioma para usarlo sin conexión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrasta klaviatuuri Tõlgi menüü, lülita välja need, mida ei taha, ja laadi keel alla, et seda ühenduseta kasutada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réorganise le menu Traduire du clavier, désactive celles que tu ne veux pas et télécharge une langue pour l'utiliser hors ligne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendezd át a billentyűzet Fordítás menüjét, kapcsold ki a nem kívántakat, és tölts le egy nyelvet az offline használathoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riordina il menu Traduci della tastiera, disattiva quelle che non vuoi e scarica una lingua per usarla offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの翻訳メニューを並べ替え、不要な言語をオフにし、オフラインで使う言語をダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 번역 메뉴를 재정렬하고, 원치 않는 언어는 끄고, 오프라인으로 쓸 언어를 내려받아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun semula menu Terjemah papan kekunci, matikan yang anda tak mahu, dan muat turun bahasa untuk guna luar talian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordena o menu Traduzir do teclado, desliga as que não queres e transfere um idioma para o usares offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняйте порядок в меню перевода на клавиатуре, выключайте ненужное и загружайте язык, чтобы пользоваться им офлайн."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新排序键盘的翻译菜单，关掉不想要的语言，并下载语言以便离线使用。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordonați meniul Traducere al tastaturii, dezactivați pe orice nu doriți și descărcați o limbă pentru a o folosi offline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herschik het Vertaalmenu van het toetsenbord, schakel alle ongewenste functies uit en download een taal om deze offline te gebruiken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新排序鍵盤的翻譯選單，關掉不想要的語言，並下載語言以便離線使用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmień kolejność menu Tłumacz na klawiaturze, wyłącz te, których nie chcesz, i pobierz język, aby używać go w trybie offline."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змініть порядок меню перекладу на клавіатурі, вимкніть непотрібні та завантажте мову, щоб використовувати її в режимі офлайн."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyenin Çeviri menüsünü yeniden sıralayın, istemediklerinizi kapatın ve çevrimdışı kullanmak için bir dil indirin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změňte uspořádání nabídky Překladač na klávesnici, vypněte to, co nechcete, a stáhněte si jazyk, abyste jej mohli používat offline."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmeňte poradie ponuky Preložiť na klávesnici, vypnite všetky, ktoré nechcete, a stiahnite si jazyk, aby ste ho mohli používať offline."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναδιάταξη του μενού Μετάφραση του πληκτρολογίου, απενεργοποιήστε όποια δεν θέλετε και κατεβάστε μια γλώσσα για να τη χρησιμοποιήσετε εκτός σύνδεσης."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordna om tangentbordets Översätt-meny, stäng av alla du inte vill ha och ladda ner ett språk för att använda det offline."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omarranger tastaturets Oversæt-menu, sluk alt, du ikke vil have, og download et sprog for at bruge det offline."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Omorganiser tastaturets Oversett-meny, slå av alle du ikke vil ha, og last ned et språk for å bruke det offline."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestä näppäimistön Kääntäjä-valikko uudelleen, poista käytöstä kaikki, joita et halua, ja lataa kieli käyttääksesi sitä offline-tilassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun ulang menu Terjemahan keyboard, nonaktifkan bahasa yang tidak Anda inginkan, dan unduh bahasa untuk digunakan secara offline."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắp xếp lại menu Dịch của bàn phím, tắt bất kỳ ngôn ngữ nào bạn không muốn và tải xuống ngôn ngữ để sử dụng ngoại tuyến."
          }
        }
      }
    },
