    "Unlock the tools and customization that turn Clink into your personal keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ontsluit die gereedskap en aanpassing wat Clink in jou persoonlike sleutelbord verander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte die Werkzeuge und Anpassungen frei, die Clink zu deiner persönlichen Tastatur machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea las herramientas y la personalización que hacen de Clink tu teclado personal."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava tööriistad ja kohandused, mis teevad Clinkist sinu isikliku klaviatuuri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquez les outils et la personnalisation qui font de Clink votre clavier personnel."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldd fel az eszközöket és testreszabást, amelyek a Clinket a személyes billentyűzeteddé teszik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca gli strumenti e la personalizzazione che rendono Clink la tua tastiera personale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkを自分だけのキーボードにするツールとカスタマイズを使えるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink을 나만의 키보드로 만드는 도구와 사용자화 기능을 잠금 해제하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kunci alat dan penyesuaian yang menjadikan Clink papan kekunci peribadi anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueia as ferramentas e a personalização que fazem do Clink o teu teclado pessoal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте инструменты и настройку, которые превратят Clink в вашу личную клавиатуру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁工具和自定义功能，让 Clink 成为你的专属键盘。"
          }
        }
      }
    },
    "Unlocked for life. Thanks for being here early": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lewens lank ontsluit. Dankie dat jy vroeg hier was"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für immer freigeschaltet. Danke, dass du so früh dabei warst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueado para siempre. Gracias por estar aquí desde el principio"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Avatud eluaegselt. Aitäh, et olid nii vara siin"
          }
        },
        "fr": {
          "stringUnit": {
