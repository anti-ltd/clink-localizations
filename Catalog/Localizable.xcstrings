        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 단어 예측을 뒷받침하는 단어 쌍 빈도입니다. Clink의 바이그램 형식으로 변환했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
