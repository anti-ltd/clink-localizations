    "Knows what you'll type before you finish": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet wat jy sal tik voordat jy klaar is"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiß, was du tippst, bevor du fertig bist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabe lo que vas a escribir antes de que termines"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teab, mida tipid, enne kui lõpetad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sait ce que tu vas taper avant que tu finisses"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudja, mit fogsz gépelni, mielőtt befejeznéd"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa cosa scriverai prima che tu finisca"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "打ち終わる前に、何を打つか予測します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다 치기 전에 무엇을 칠지 알아요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahu apa yang anda akan taip sebelum anda selesai"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabe o que vais escrever antes de acabares"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знает, что вы напечатаете, ещё до того, как вы закончите"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没打完就知道你要打什么"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Știe ce vei scrie înainte de a termina"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet wat u typt voordat u klaar bent"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒打完就知道你要打什麼"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie, co napiszesz, zanim skończysz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знає, що ви будете вводити, перш ніж закінчите"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitirmeden önce ne yazacağınızı bilir"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví, co budete psát, než skončíte"
