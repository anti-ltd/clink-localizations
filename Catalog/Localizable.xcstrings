    "Sources include FrequencyWords, Tatoeba, and similar projects. See Dictionaries in Extras for licenses.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Bronne sluit FrequencyWords, Tatoeba en soortgelyke projekte in. Sien Woordeboeke in Ekstras vir lisensies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu den Quellen zählen FrequencyWords, Tatoeba und ähnliche Projekte. Lizenzen findest du unter Wörterbücher in Extras."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre las fuentes están FrequencyWords, Tatoeba y proyectos parecidos. Mira Diccionarios en Extras para ver las licencias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Allikate hulka kuuluvad FrequencyWords, Tatoeba ja sarnased projektid. Litsentsid leiad jaotisest Sõnaraamatud all Lisad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sources incluent FrequencyWords, Tatoeba et des projets similaires. Va voir Dictionnaires dans Extras pour les licences."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A források közt van a FrequencyWords, a Tatoeba és hasonló projektek. A licenceket az Extrák Szótárak részében találod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tra le fonti ci sono FrequencyWords, Tatoeba e progetti simili. Guarda Dizionari in Extra per le licenze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FrequencyWords や Tatoeba などが元になっています。ライセンスは「その他」の辞書をご覧ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출처는 FrequencyWords, Tatoeba 같은 프로젝트예요. 라이선스는 추가 기능의 사전에서 볼 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumbernya termasuk FrequencyWords, Tatoeba dan projek serupa. Lihat Kamus dalam Tambahan untuk lesen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As fontes incluem FrequencyWords, Tatoeba e projetos parecidos. Vê Dicionários em Extras para as licenças."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Среди источников — FrequencyWords, Tatoeba и подобные проекты. Лицензии — в разделе «Словари» в «Дополнительном»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源有 FrequencyWords、Tatoeba 这类项目。许可证在扩展功能的词典里看。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sursele includ FrequencyWords, Tatoeba și proiecte similare. Consultați dicționarele din Suplimente pentru licențe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bronnen zijn onder meer FrequencyWords, Tatoeba en soortgelijke projecten. Zie Woordenboeken in Extra's voor licenties."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源有 FrequencyWords、Tatoeba 這類專案。許可證在擴充套件功能的詞典裡看。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Źródła obejmują FrequencyWords, Tatoeba i podobne projekty. Aby zapoznać się z licencjami, zobacz Słowniki w Dodatkach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Джерела включають FrequencyWords, Tatoeba та подібні проекти. Ліцензії див. у розділі «Словники» у розділі «Додатково»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynaklar arasında FrekansWords, Tatoeba ve benzer projeler yer almaktadır. Lisanslar için Ekstralar'daki Sözlüklere bakın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezi zdroje patří FrequencyWords, Tatoeba a podobné projekty. Licence naleznete v části Slovníky v Extras."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Medzi zdroje patria FrequencyWords, Tatoeba a podobné projekty. Licencie nájdete v časti Slovníky v Extras."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πηγές περιλαμβάνουν τα FrequencyWords, Tatoeba και παρόμοια έργα. Ανατρέξτε στα Λεξικά στα Πρόσθετα για άδειες."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Källor inkluderar FrequencyWords, Tatoeba och liknande projekt. Se Ordböcker i Extramaterial för licenser."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilder omfatter FrequencyWords, Tatoeba og lignende projekter. Se Ordbøger i ekstramateriale for licenser."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilder inkluderer FrequencyWords, Tatoeba og lignende prosjekter. Se Ordbøker i tillegg for lisenser."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähteitä ovat FrequencyWords, Tatoeba ja vastaavat projektit. Katso lisenssit Lisätietojen sanakirjat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumbernya termasuk FrekuensiWords, Tatoeba, dan proyek serupa. Lihat Kamus di Ekstra untuk mengetahui lisensi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nguồn bao gồm FrequencyWords, Tatoeba và các dự án tương tự. Xem Từ điển trong Phần bổ sung để biết giấy phép."
          }
        }
      }
