    "Swipe a clip and tap the pin to keep it, while the rest ages out.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Swiep 'n skeersel en tik op die pen om dit te hou, terwyl die res verouder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wisch über einen Eintrag und tipp auf die Nadel, damit er bleibt, während der Rest altert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza un elemento y toca el pin para conservarlo mientras el resto caduca."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viipa klipi üle ja puuduta nõela, et see hoida, samal ajal kui ülejäänud aeguvad välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaie un élément et touche l'épingle pour le garder pendant que le reste s'efface avec le temps."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd el az elemet, és koppints a gombostűre, hogy megmaradjon, míg a többi idővel kikopik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri un elemento e tocca la puntina per tenerlo, mentre il resto scade col tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目をスワイプしてピンをタップすると、その項目だけ残り、ほかは古いものから消えていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 쓸어 핀을 누르면 그 항목만 남고, 나머지는 오래된 순으로 사라집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret satu item dan ketik pin untuk mengekalkannya, sementara yang lain luput mengikut masa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza um item e toca no pino para o manteres, enquanto os outros vão saindo com o tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните фрагмент и нажмите на булавку, чтобы оставить его, пока остальные устаревают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把某条划开、点一下图钉就能留住它，其余的会随时间被挤掉。"
          }
        }
      }
    },
    "Swipe a saved note right to pin it in Cling. Requires Full Access.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Swiep 'n gestoorde nota regs om dit in Cling vas te pen. Vereis volle toegang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische eine gespeicherte Notiz nach rechts, um sie in Cling anzupinnen. Erfordert Vollzugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza una nota guardada a la derecha para fijarla en Cling. Requiere acceso completo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viipa salvestatud märge paremale, et see Clingis kinnitada. Vajab täisjuurdepääsu."
