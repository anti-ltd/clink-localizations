          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你按下的按键扩散出一圈光环。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누른 키에서 고리가 퍼져 나갑니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajutatud klahvist levib rõngas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От нажатой клавиши расходится кольцо."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "’n Ring sprei uit van die sleutel wat jy slaan."
          }
        }
      }
    },
    "A smooth ribbon with a travelling glint of light.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cinta suave con un destello de luz que viaja por ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ruban lisse avec un éclat de lumière qui se déplace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein glattes Band mit einem wandernden Lichtschimmer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nastro liscio con un bagliore di luce che viaggia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma fita suave com um brilho de luz viajante."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Riben licin dengan kilauan cahaya yang bergerak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sima szalag, utazó fénycsillámmal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "滑らかなリボンを光が走る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一条平滑的丝带，有流光掠过。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러운 리본 위로 흐르는 빛의 글린트."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sile pabel üleliikuva valgussäramusega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гладкая лента с бегущим бликом света."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Gladde lint met 'n reisende glinster van lig."
          }
        }
      }
    },
    "A soft accent-coloured halo behind each key while it's held. 0% turns it off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sanfter, akzentfarbener Schein hinter jeder Taste, solange sie gehalten wird. 0 % schaltet ihn aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un halo suave del color de acento detrás de cada tecla mientras la mantienes pulsada. Al 0% se apaga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un halo doux de la couleur d'accent derrière chaque touche quand elle est maintenue. 0 % le désactive."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lágy, kiemelőszínű ragyogás minden billentyű mögött, amíg nyomva tartod. A 0% kikapcsolja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un morbido alone del colore d'accento dietro ogni tasto mentre lo tieni premuto. Con 0% è disattivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押ししているあいだ、各キーの後ろにアクセントカラーのやわらかな光が出ます。0% でオフになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누르고 있는 동안 키 뒤에 은은한 강조색 후광이 떠요. 0%면 꺼져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halo lembut berwarna aksen di belakang setiap kekunci semasa ia ditahan. 0% matikannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um halo suave na cor de destaque por trás de cada tecla enquanto está premida. 0% desliga-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мягкий ореол акцентного цвета за клавишей, пока её удерживают. 0% выключает его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住按键时，键后面有一圈柔和的强调色光晕。0% 关闭。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pehme aktsendiväriline halo iga klahvi taga, kuni seda hoitakse. 0% lülitab selle välja."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Sagte aksentkleurige stralekrans agter elke sleutel terwyl dit vasgehou word. 0% t skakel dit af."
          }
        }
      }
    },
    "A spacer is invisible. It reserves width to push keys apart but draws nothing and ignores taps. Only its width matters.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Abstandshalter ist unsichtbar. Er reserviert Breite, um Tasten auseinanderzuschieben, zeichnet aber nichts und ignoriert Tipps. Nur seine Breite zählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espaciador es invisible: reserva ancho para separar las teclas, pero no dibuja nada ni responde a los toques. Solo importa su ancho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espaceur est invisible : il réserve de la largeur pour écarter les touches mais ne dessine rien et ignore les appuis. Seule sa largeur compte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A távtartó láthatatlan. Helyet foglal, hogy széthúzza a billentyűket, de nem látszik és nem reagál az érintésre. Csak a szélessége számít."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno spaziatore è invisibile, tiene lo spazio per allontanare i tasti ma non mostra nulla e ignora i tocchi. Conta solo la sua larghezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペーサーは見えません。幅だけ確保してキーを離しますが、何も表示せずタップも反応しません。大事なのは幅だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이서는 눈에 안 보여요. 자리만 차지해서 키를 밀어낼 뿐, 그려지지도 않고 탭도 안 먹어요. 너비만 중요해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengisi ruang tak kelihatan. Ia simpan lebar untuk jarakkan kekunci tapi tak lukis apa-apa dan abaikan ketukan. Cuma lebarnya yang penting."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um espaçador é invisível. Reserva largura para afastar as teclas, mas não desenha nada e ignora toques. Só a largura conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделитель невидим. Он занимает ширину, чтобы раздвинуть клавиши, но ничего не рисует и не реагирует на нажатия. Важна только его ширина."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "占位符是看不见的，它只占出宽度把按键撑开，什么都不画，也不理会点击。只有它的宽度有用。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eraldaja on nähtamatu. See reserveerib laiust, et klahve lahutada, aga ei joonista midagi ja eirab puudutusi. Loeb ainult selle laius."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Spasieerder is onsigbaar. Dit behou breedte om sleutels uitmekaar te druk, maar trek niks en ignoreer krane. Net sy breedte maak saak."
          }
        }
      }
    },
    "A subtle tap on each keypress.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein leichter Tap bei jedem Tastendruck."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vibración suave en cada pulsación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une légère vibration à chaque appui."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy finom koppintás minden gombnyomásnál."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una leggera vibrazione a ogni tasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを押すたびに、そっと軽く振動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누를 때마다 은은하게 톡."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketikan halus setiap kali anda tekan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vibração subtil a cada toque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лёгкий отклик на каждое нажатие."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次按键都轻轻震一下。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerge kopinus iga klahvivajutusega."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Subtiele tik op elke sleuteldruk."
          }
        }
      }
    },
    "A tab of the emoji you actually use. Drag it anywhere on Categories.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tab mit den Emoji, die du wirklich nutzt. Verschieb ihn unter „Kategorien“ wohin du willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pestaña con los emojis que de verdad usas. Muévela donde quieras en Categorías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un onglet avec les emoji que tu utilises vraiment. Place-le où tu veux dans Catégories."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy fül a tényleg használt emodzsikkal. A Kategóriák fülön bárhová húzhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scheda con gli emoji che usi davvero. Spostala dove vuoi in Categorie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う絵文字だけのタブです。「カテゴリ」で好きな位置に動かせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 쓰는 이모지만 모은 탭이에요. 카테고리에서 원하는 자리로 옮길 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab berisi emoji yang anda betul-betul guna. Seret ke mana-mana dalam Kategori."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um separador com os emojis que usas mesmo. Move-o para onde quiseres em Categorias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка с эмодзи, которыми вы действительно пользуетесь. Перетащите её в любое место в «Категориях»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个只放你常用表情的标签页。在“分类”里可以随意挪位置。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
