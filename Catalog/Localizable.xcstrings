            "state": "translated",
            "value": "Наша самая низкая годовая цена. Продлевается ежегодно."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga tahunan terendah kami. Diperbaharui setiap tahun."
