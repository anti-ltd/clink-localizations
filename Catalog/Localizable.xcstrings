            "value": "Nulstil %@?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbakestille %@?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nollataanko %@?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset %@?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt lại %@?"
          }
        }
      }
    },
    "Optional 2.5 GB download for AI Tools and translation. Runs on this device and uses several GB of memory. Results may be slow or inaccurate. Review before using. Gemma terms apply.": {
      "comment": "Android: optional shared on-device Gemma model; GB download and RAM, AI writing and translation, terms.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional 2.5 GB download for AI Tools and translation. Runs on this device and uses several GB of memory. Results may be slow or inaccurate. Review before using. Gemma terms apply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga opcional de 2,5 GB para las herramientas de IA y la traducción. Se ejecuta en este dispositivo y utiliza varios GB de memoria. Puede tardar y dar resultados incorrectos. Revísalos antes de usarlos. Se aplican las condiciones de Gemma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement facultatif de 2,5 Go pour les outils d’IA et la traduction. Fonctionne sur cet appareil et utilise plusieurs Go de mémoire. Les résultats peuvent être lents ou inexacts. Vérifiez-les avant de les utiliser. Les conditions de Gemma s’appliquent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionaler Download von 2,5 GB für KI-Werkzeuge und Übersetzungen. Läuft auf diesem Gerät und benötigt mehrere GB Arbeitsspeicher. Ergebnisse können auf sich warten lassen oder fehlerhaft sein. Prüfe sie vor der Verwendung. Es gelten die Gemma-Bedingungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download facoltativo di 2,5 GB per gli strumenti IA e la traduzione. Funziona su questo dispositivo e utilizza diversi GB di memoria. I risultati possono richiedere tempo o essere imprecisi. Controllali prima di usarli. Si applicano i termini di Gemma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Download opcional de 2,5 GB para ferramentas de IA e tradução. Funciona neste dispositivo e usa vários GB de memória. Os resultados podem demorar ou conter erros. Reveja-os antes de os utilizar. Aplicam-se os termos do Gemma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательная загрузка объёмом 2,5 ГБ для ИИ-инструментов и перевода. Работает на этом устройстве и использует несколько ГБ памяти. Результаты могут появляться медленно или содержать ошибки. Проверяйте их перед использованием. Действуют условия Gemma."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat turun pilihan bersaiz 2.5 GB untuk Alat AI dan terjemahan. Berjalan pada peranti ini dan menggunakan beberapa GB memori. Hasil mungkin lambat atau tidak tepat. Semak sebelum digunakan. Terma Gemma terpakai."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionális, 2,5 GB-os letöltés az MI-eszközökhöz és a fordításhoz. Ezen az eszközön fut, és több GB memóriát használ. Az eredmények lassan készülhetnek el vagy pontatlanok lehetnek. Használat előtt ellenőrizd őket. A Gemma feltételei érvényesek."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsionele aflaai van 2,5 GB vir KI-nutsgoed en vertaling. Werk op hierdie toestel en gebruik verskeie GB geheue. Resultate kan lank neem of onakkuraat wees. Gaan dit na voordat jy dit gebruik. Gemma se bepalings geld."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volitelné stažení 2,5 GB pro nástroje AI a překlad. Běží na tomto zařízení a využívá několik GB paměti. Výsledky mohou trvat déle nebo být nepřesné. Před použitím je zkontrolujte. Platí podmínky Gemma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfri download på 2,5 GB til AI-værktøjer og oversættelse. Kører på denne enhed og bruger flere GB hukommelse. Resultaterne kan tage tid eller være unøjagtige. Kontrollér dem før brug. Gemmas vilkår gælder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προαιρετική λήψη 2,5 GB για εργαλεία AI και μετάφραση. Εκτελείται σε αυτή τη συσκευή και χρησιμοποιεί αρκετά GB μνήμης. Τα αποτελέσματα μπορεί να καθυστερούν ή να είναι ανακριβή. Ελέγξτε τα πριν τα χρησιμοποιήσετε. Ισχύουν οι όροι του Gemma."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valikuline 2,5 GB allalaadimine tehisintellekti tööriistade ja tõlkimise jaoks. Töötab selles seadmes ja kasutab mitu GB mälu. Tulemuste saamine võib võtta aega ja need võivad olla ebatäpsed. Kontrolli neid enne kasutamist. Kehtivad Gemma tingimused."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinnainen 2,5 Gt:n lataus tekoälytyökaluille ja kääntämiseen. Toimii tällä laitteella ja käyttää useita gigatavuja muistia. Tulosten saaminen voi kestää, ja niissä voi olla virheitä. Tarkista ne ennen käyttöä. Gemman ehdot ovat voimassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduhan opsional 2,5 GB untuk Alat AI dan terjemahan. Berjalan di perangkat ini dan menggunakan beberapa GB memori. Hasil mungkin lambat atau tidak akurat. Periksa sebelum digunakan. Persyaratan Gemma berlaku."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIツールと翻訳向けの任意の2.5 GBダウンロードです。このデバイス上で動作し、数GBのメモリを使用します。結果が出るまで時間がかかったり、不正確な結果が出たりすることがあります。使用前に確認してください。Gemmaの利用規約が適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 도구 및 번역을 위한 선택 사항인 2.5GB 다운로드입니다. 이 기기에서 실행되며 수 GB의 메모리를 사용합니다. 결과가 늦게 나오거나 부정확할 수 있습니다. 사용 전에 확인하세요. Gemma 약관이 적용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfri nedlasting på 2,5 GB for KI-verktøy og oversettelse. Kjører på denne enheten og bruker flere GB minne. Resultatene kan ta tid eller være unøyaktige. Kontroller dem før bruk. Gemmas vilkår gjelder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionele download van 2,5 GB voor AI-tools en vertaling. Werkt op dit apparaat en gebruikt meerdere GB geheugen. Resultaten kunnen lang op zich laten wachten of onjuist zijn. Controleer ze voor gebruik. De voorwaarden van Gemma zijn van toepassing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne pobranie 2,5 GB dla narzędzi AI i tłumaczenia. Działa na tym urządzeniu i wykorzystuje kilka GB pamięci. Wyniki mogą pojawiać się z opóźnieniem lub zawierać błędy. Sprawdź je przed użyciem. Obowiązują warunki Gemma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descărcare opțională de 2,5 GB pentru instrumentele AI și traducere. Rulează pe acest dispozitiv și folosește câțiva GB de memorie. Rezultatele pot întârzia sau pot fi inexacte. Verifică-le înainte de utilizare. Se aplică termenii Gemma."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Voliteľné stiahnutie 2,5 GB pre nástroje AI a preklad. Beží na tomto zariadení a využíva niekoľko GB pamäte. Výsledky môžu trvať dlhšie alebo byť nepresné. Pred použitím ich skontrolujte. Platia podmienky Gemma."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfri nedladdning på 2,5 GB för AI-verktyg och översättning. Körs på den här enheten och använder flera GB minne. Resultaten kan ta tid eller vara felaktiga. Kontrollera dem före användning. Gemmas villkor gäller."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zekâ araçları ve çeviri için isteğe bağlı 2,5 GB indirme. Bu cihazda çalışır ve birkaç GB bellek kullanır. Sonuçlar gecikebilir veya hatalı olabilir. Kullanmadan önce kontrol edin. Gemma koşulları geçerlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов’язкове завантаження обсягом 2,5 ГБ для інструментів ШІ та перекладу. Працює на цьому пристрої та використовує кілька ГБ пам’яті. Результати можуть з’являтися повільно або містити помилки. Перевіряйте їх перед використанням. Діють умови Gemma."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản tải xuống tùy chọn 2,5 GB cho Công cụ AI và dịch thuật. Chạy trên thiết bị này và sử dụng vài GB bộ nhớ. Kết quả có thể chậm hoặc không chính xác. Hãy kiểm tra trước khi sử dụng. Áp dụng điều khoản của Gemma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选下载，大小为 2.5 GB，用于 AI 工具和翻译。在此设备上运行，占用数 GB 内存。生成结果可能较慢，也可能不准确。使用前请核对。适用 Gemma 条款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選下載，大小為 2.5 GB，供 AI 工具與翻譯使用。在此裝置上執行，佔用數 GB 記憶體。產生結果可能較慢，也可能不準確。使用前請核對。適用 Gemma 條款。"
          }
        }
      }
    },
    "One press of delete removes the word you just swiped. Turn off to delete one letter at a time.": {
      "comment": "Swipe typing option hint. Delete immediately after a swipe removes its committed word; switching this off deletes one character.",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk een keer op die uitveesleutel om die woord wat jy pas gevee het, te verwyder. Skakel dit af om een letter op ’n slag uit te vee."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke einmal die Löschtaste, um das gerade gewischte Wort zu löschen. Schalte diese Option aus, um Buchstabe für Buchstabe zu löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa borrar una vez para eliminar la palabra que acabas de escribir deslizando el dedo. Desactívalo para borrar letra por letra."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üks kustutusklahvi vajutus eemaldab äsja libistades sisestatud sõna. Lülita välja, et kustutada ühe tähe kaupa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie une fois sur la touche de suppression pour effacer le mot que tu viens de saisir en glissant. Désactive cette option pour effacer lettre par lettre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A törlés gomb egyszeri megnyomása törli az imént húzással beírt szót. Kikapcsolva betűnként törölhetsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi una volta il tasto di cancellazione per eliminare la parola appena scritta scorrendo il dito. Disattiva per cancellare una lettera alla volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除キーを1回押すと、直前にスワイプ入力した単語全体を削除します。オフにすると、1文字ずつ削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 키를 한 번 누르면 방금 스와이프로 입력한 단어가 삭제됩니다. 끄면 한 글자씩 삭제됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan kekunci padam sekali untuk memadam perkataan yang baru ditaip dengan leretan. Matikan untuk memadam satu huruf pada satu masa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca uma vez na tecla de apagar para remover a palavra que acabaste de escrever ao deslizar o dedo. Desativa para apagar uma letra de cada vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно нажатие клавиши удаления стирает слово, только что введённое свайпом. Выключите, чтобы удалять по одной букве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按一次删除键即可删除刚刚滑行输入的整个词。关闭后，每次只删除一个字符。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apasă o dată tasta de ștergere pentru a elimina cuvântul tocmai introdus prin glisare. Dezactivează pentru a șterge câte o literă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk één keer op de wistoets om het woord te verwijderen dat je net hebt geswipet. Zet dit uit om letter voor letter te wissen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一次刪除鍵即可刪除剛剛滑行輸入的整個詞。關閉後，每次只刪除一個字元。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno naciśnięcie klawisza usuwania kasuje słowo właśnie wpisane przeciągnięciem. Wyłącz, aby usuwać po jednej literze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне натискання клавіші видалення стирає слово, щойно введене свайпом. Вимкніть, щоб видаляти по одній літері."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silme tuşuna bir kez basmak, kaydırarak yazdığın son kelimeyi siler. Harf harf silmek için kapat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedním stisknutím klávesy pro mazání odstraníš právě napsané slovo tahem. Vypni pro mazání po jednotlivých písmenech."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedným stlačením klávesu na mazanie odstrániš slovo práve napísané ťahom. Vypni pre mazanie po jednotlivých písmenách."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε μία φορά το πλήκτρο διαγραφής για να σβήσεις τη λέξη που μόλις έγραψες με σύρσιμο. Απενεργοποίησέ το για να σβήνεις ένα γράμμα κάθε φορά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck en gång på raderingstangenten för att ta bort ordet du just svepte in. Stäng av för att radera en bokstav i taget."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk én gang på slettetasten for at fjerne det ord, du lige har skrevet ved at stryge. Slå fra for at slette ét bogstav ad gangen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk én gang på slettetasten for å fjerne ordet du nettopp skrev ved å sveipe. Slå av for å slette én bokstav om gangen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista juuri pyyhkäisemäsi sana painamalla poistonäppäintä kerran. Poista asetus käytöstä, jos haluat poistaa kirjaimen kerrallaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan tombol hapus sekali untuk menghapus kata yang baru diketik dengan geser. Nonaktifkan untuk menghapus satu huruf setiap kali."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn phím xóa một lần để xóa cả từ vừa nhập bằng cách vuốt. Tắt để xóa từng ký tự."
          }
        }
      }
    },
    "Feel a light tick as you move the cursor through text.": {
      "comment": "Gestures option hint, shared by iOS and Android. Cursor feedback refers to moving the insertion cursor, not typing keys.",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voel ’n ligte trilling wanneer jy die wyser deur die teks beweeg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spüre eine leichte Vibration, während du den Cursor durch den Text bewegst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siente una vibración suave al mover el cursor por el texto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunne kerget vibratsiooni, kui liigutad kursorit tekstis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ressens une légère vibration quand tu déplaces le curseur dans le texte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Finom rezgést érezhetsz, miközben a kurzort mozgatod a szövegben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senti una lieve vibrazione mentre sposti il cursore nel testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキスト内でカーソルを動かすと、軽い振動でフィードバックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트에서 커서를 움직일 때 가벼운 진동이 느껴집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasakan getaran ringan semasa menggerakkan kursor dalam teks."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sente uma vibração ligeira ao moveres o cursor pelo texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лёгкая вибрация при перемещении курсора по тексту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在文本中移动光标时，感受轻微的振动反馈。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Simte o vibrație ușoară când deplasezi cursorul prin text."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voel een lichte trilling wanneer je de cursor door de tekst beweegt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在文字中移動游標時，感受輕微的震動回饋。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczuj delikatną wibrację podczas przesuwania kursora po tekście."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Легка вібрація під час переміщення курсора текстом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmleci metinde hareket ettirirken hafif bir titreşim hisset."
          }
        },
        "cs": {
          "stringUnit": {
