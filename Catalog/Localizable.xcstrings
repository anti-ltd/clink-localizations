    "Dictation is off. Turn it on to use and customize it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diktee is af. Skakel dit aan om dit te gebruik en aan te pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktat ist aus. Schalte es ein, um es zu nutzen und anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado está desactivado. Actívalo para usarlo y personalizarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteerimine on väljas. Lülita see sisse, et kasutada ja kohandada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée est désactivée. Active-la pour l'utiliser et la personnaliser."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktálás ki van kapcsolva. Kapcsold be, hogy használhasd és beállíthasd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura è disattivata. Attivala per usarla e personalizzarla."
          }
