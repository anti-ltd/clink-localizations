        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα άλλο πλαίσιο χρησιμοποιεί ήδη αυτό το αναγνωριστικό. Ένα πρόσθετο ανοίγει όποιο συμβεί πρώτο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En annan panel använder redan detta ID. En plugin öppnas beroende på vad som kommer först."
          }
        },
        "da": {
