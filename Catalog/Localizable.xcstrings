    "Sideways pages of 5 rows, search on top, tabs underneath.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sywaarts bladsye van 5 rye, soek bo-op, oortjies onder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seitliche Seiten mit 5 Reihen, Suche oben, Tabs unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Páginas laterales de 5 filas, búsqueda arriba y pestañas abajo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rõhtsad lehed 5 reaga, otsing peal, kaardid all."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des pages de 5 rangées qui défilent sur le côté, recherche en haut, onglets en bas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldalra lapozható, 5 soros oldalak, fent a keresés, lent a fülek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagine di 5 righe che scorrono di lato, ricerca in alto e schede in basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5 行ずつ横にめくるページ。上に検索、下にタブ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5줄씩 옆으로 넘기는 방식. 위에 검색, 아래에 탭."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman 5 baris yang ditatal ke sisi, carian di atas, tab di bawah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Páginas de 5 linhas que passam de lado, pesquisa em cima e separadores em baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Горизонтальные страницы по 5 рядов, поиск сверху, вкладки снизу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每页 5 行、左右翻页，搜索在上、分类在下。"
          }
        }
      }
    },
