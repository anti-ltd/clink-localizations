    "Quicker and busier, in smaller pieces.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vinniger en besiger, in kleiner stukke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schneller und dichter, in kleineren Teilchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más rápido y con más movimiento, en piezas más pequeñas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiirem ja tihedam, väiksemates osades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus rapide et plus chargé, en éléments plus petits."
