          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürükle Basın, hiçbir şeye kadar oyalanmayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Táhněte Stisknutím setrvejte dolů k ničemu."
