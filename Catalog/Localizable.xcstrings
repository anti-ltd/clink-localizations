            "value": "Questo plugin non ha impostazioni. Funziona tramite i suoi hook mentre scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプラグインには設定がありません。入力中にフックで動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 플러그인에는 설정이 없습니다. 입력하는 동안 훅으로 동작합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugin ini tiada tetapan. Ia berfungsi melalui cangkuknya semasa anda menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plugin não tem definições. Funciona através dos seus hooks enquanto escreve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
