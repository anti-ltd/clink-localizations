    "Sizes suggestions to fit each word, so more can fit in the bar.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas elke voorstel se breedte by die woord aan, sodat meer in die balk pas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přizpůsobí šířku návrhů jednotlivým slovům, aby se jich do lišty vešlo více."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpasser bredden på forslagene til hvert ord, så der er plads til flere i linjen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt die Breite der Vorschläge an die Wörter an, damit mehr in die Leiste passen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσαρμόζει το πλάτος κάθε πρότασης στη λέξη, ώστε να χωρούν περισσότερες στη γραμμή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el ancho de las sugerencias a cada palabra para que quepan más en la barra."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohandab soovituste laiust iga sõna järgi, et ribale mahuks rohkem soovitusi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovittaa ehdotusten leveyden kunkin sanan mukaan, jotta palkkiin mahtuu enemmän ehdotuksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapte la largeur des suggestions à chaque mot pour en afficher davantage dans la barre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A javaslatok szélességét a szavakhoz igazítja, így több fér el a sávban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyesuaikan lebar saran dengan setiap kata agar lebih banyak saran muat di bilah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Adatta la larghezza dei suggerimenti a ogni parola, così nella barra ne entrano di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各単語に合わせて候補の幅を調整し、バーにより多くの候補を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 단어에 맞게 추천 단어의 너비를 조절하여 추천 막대에 더 많이 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Melaraskan lebar cadangan mengikut setiap perkataan supaya lebih banyak cadangan muat dalam bar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpasser bredden på forslagene til hvert ord, slik at det blir plass til flere i linjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Past de breedte van suggesties aan elk woord aan, zodat er meer in de balk passen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopasowuje szerokość podpowiedzi do każdego słowa, aby więcej zmieściło się na pasku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta a largura das sugestões a cada palavra para caberem mais na barra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptează lățimea sugestiilor la fiecare cuvânt, astfel încât să încapă mai multe în bară."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подстраивает ширину подсказок под каждое слово, чтобы на панели помещалось больше вариантов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prispôsobí šírku návrhov jednotlivým slovám, aby sa ich do lišty zmestilo viac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassar förslagens bredd efter varje ord så att fler får plats i raden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önerilerin genişliğini her kelimeye göre ayarlar, böylece çubuğa daha fazla öneri sığar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підлаштовує ширину підказок під кожне слово, щоб на панелі вміщувалося більше варіантів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều chỉnh độ rộng của gợi ý theo từng từ để thanh gợi ý chứa được nhiều từ hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据每个词的长度调整候选项宽度，让候选栏容纳更多候选词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依照每個詞的長度調整候選項寬度，讓候選列容納更多候選詞。"
          }
        }
      }
    },
