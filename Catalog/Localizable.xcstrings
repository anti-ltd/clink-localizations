    "Accent 300ms · tone 180ms · slide-up 16pt. Gestures fire sooner.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aksent 300ms · toon 180ms · opskuif 16pt. Gebare brand gouer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akzent 300 ms · Ton 180 ms · Slide-up 16 pt. Gesten lösen früher aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acento 300ms · tono 180ms · deslizamiento 16pt. Los gestos saltan antes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksent 300 ms · toon 180 ms · liuglemine 16 pt üles. Žestid käivituvad varem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accent 300 ms · tonalité 180 ms · glissé 16 pt. Les gestes se déclenchent plus tôt."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiemelés 300 ms · hangszín 180 ms · felcsúszás 16 pt. A gesztusok hamarabb indulnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accento 300ms · tono 180ms · scorrimento 16pt. I gesti partono prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセント300ms · トーン180ms · スライドアップ16pt。ジェスチャが早めに反応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강세 300ms · 톤 180ms · 위로 밀기 16pt. 제스처가 더 빨리 걸려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksen 300ms · ton 180ms · luncur naik 16pt. Gerak isyarat cetus lebih awal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acento 300ms · tom 180ms · deslize 16pt. Os gestos disparam mais cedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Акцент 300 мс · тон 180 мс · подъём 16pt. Жесты срабатывают раньше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强调300ms · 音调180ms · 上滑16pt。手势触发更快。"
          }
        }
      }
    },
