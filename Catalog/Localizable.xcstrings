    "Heat rises and flickers from the bottom row.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hitte styg en flikker vanaf die onderste ry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitze steigt flackernd aus der unteren Reihe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calor sube y titila desde la fila inferior."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soojus tõuseb ja virvendab alumisest reast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La chaleur monte et vacille depuis la rangée du bas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hő az alsó sorból emelkedik és pislákol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il calore sale e tremola dalla riga inferiore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "熱が最下段から立ち上がり、揺らめきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맨 아랫줄에서 열이 올라와 흔들립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Panas naik dan berkelip dari baris bawah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O calor sobe e tremula a partir da fila de baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
