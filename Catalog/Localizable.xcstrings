    "Six big emoji a row, scrolling down. Easy to hit.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses groot emoji's 'n ry, blaai af. Maklik om te slaan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechs große Emojis pro Reihe, nach unten scrollend. Leicht zu treffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis emoji grandes por fila, desplazándose hacia abajo. Fáciles de acertar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuus suurt emojisid reas, keritakse alla. Lihtne tabada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Six gros emoji par rangée, défilement vers le bas. Faciles à viser."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Soronként hat nagy emoji, lefelé görgetve. Könnyű eltalálni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei emoji grandi per riga, si scorre in giù. Facili da centrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 行に大きめの絵文字が 6 個、下方向にスクロール。狙いやすい配置です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 큼직한 이모지 6개, 아래로 스크롤. 누르기 편해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Enam emoji besar satu baris, ditatal ke bawah. Senang nak tekan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis emoji grandes por linha, a deslizar para baixo. Fáceis de acertar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шесть крупных эмодзи в ряду, прокрутка вниз. Легко попасть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一行 6 个大表情，上下滚动，好点。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șase emoji mari pe rând, derulând în jos. Ușor de lovit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zes grote emoji's op een rij, naar beneden scrollend. Makkelijk te raken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一行 6 個大表情，上下滾動，好點。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sześć dużych emoji w rzędzie, przewijanie w dół. Łatwo trafić."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шість великих смайлів у рядку, прокручування вниз. Легко вдарити."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağı doğru kayan altı büyük emoji. Vurması kolay."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šest velkých emotikonů v řadě, rolování dolů. Snadno se trefit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Šesť veľkých emotikonov v rade, posúvajú sa nadol. Ľahko sa trafiť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έξι μεγάλα emoji σε μια σειρά, με κύλιση προς τα κάτω. Εύκολο στο χτύπημα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sex stora emoji i rad, scrolla ner. Lätt att slå."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Seks store emoji på række, ruller ned. Let at ramme."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Seks store emoji på rad, ruller nedover. Lett å treffe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuusi isoa emojia peräkkäin, vierittämällä alaspäin. Helppo lyödä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Enam emoji besar berturut-turut, gulir ke bawah. Mudah untuk dipukul."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sáu biểu tượng cảm xúc lớn liên tiếp, cuộn xuống. Dễ đánh."
          }
        }
      }
    },
