          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat jy tik bly op jou toestel. ’n Rekening is opsioneel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisywany tekst pozostaje na urządzeniu. Konto jest opcjonalne."
