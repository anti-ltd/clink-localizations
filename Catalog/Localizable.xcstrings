    "How large each particle grows. Bigger shapes fill more of the keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoe groot elke deeltjie groei. Groter vorms vul meer van die sleutels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie groß jedes Partikel wächst. Größere Formen bedecken mehr von den Tasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto crece cada partícula. Las formas más grandes cubren más de las teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui suureks iga osake kasvab. Suuremad kujundid katavad rohkem klahve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille de croissance de chaque particule. Les formes plus grandes couvrent davantage les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mekkorára nő minden részecske. A nagyobb alakzatok többet takarnak a billentyűkből."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto cresce ogni particella. Le forme più grandi coprono più tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各パーティクルがどれだけ大きくなるか。大きい形状ほどキーを多く覆います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 입자가 얼마나 커지는지 설정합니다. 모양이 클수록 키를 더 많이 채웁니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa besar setiap zarah membesar. Bentuk yang lebih besar memenuhi lebih banyak kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho até onde cada partícula cresce. Formas maiores preenchem mais as teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько вырастает каждая частица. Более крупные формы занимают больше клавиш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个粒子会变得多大。形状越大，覆盖按键越多。"
          }
        }
      }
    },
    "How long the key holds its pressed state before bouncing back. Adds weight.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoe lank die sleutel sy ingedrukte toestand hou voordat dit terugbons. Voeg gewig by."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange die Taste gedrückt bleibt, bevor sie zurückschnellt. Fühlt sich dadurch schwerer an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto mantiene la tecla su estado pulsado antes de rebotar. Añade peso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui kaua klahv hoiab oma vajutatud olekut, enne kui tagasi hüppab. Lisab raskust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de temps la touche reste enfoncée avant de remonter. Ajoute du poids."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddig tartja a billentyű a lenyomott állapotát, mielőtt visszapattan. Súlyt ad neki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per quanto il tasto resta premuto prima di tornare su. Aggiunge peso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーが押された状態のままでいてから戻るまでの時間です。重みが出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누른 채로 튀어 오르기까지 얼마나 머무는지예요. 묵직한 느낌이 나요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa lama kekunci kekal ditekan sebelum melantun balik. Menambah berat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto tempo a tecla mantém o estado premido antes de voltar. Dá peso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько клавиша держится нажатой, прежде чем отскочить назад. Добавляет веса."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键弹回来之前保持按下状态多久。会多一点厚重感。"
          }
        }
      }
    },
