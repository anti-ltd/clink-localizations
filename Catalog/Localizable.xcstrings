    "Replacements stay on this device and override Settings shortcuts that share the same trigger.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzungen bleiben auf diesem Gerät und gehen Einstellungen-Kürzeln mit demselben Auslöser vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sustituciones se quedan en este dispositivo y tienen prioridad sobre los atajos de Ajustes con el mismo disparador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les remplacements restent sur cet appareil et l'emportent sur les raccourcis des Réglages qui partagent le même déclencheur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyettesítések ezen az eszközön maradnak, és felülírják a Beállítások azonos rövidítéseit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sostituzioni restano su questo dispositivo e hanno la precedenza sulle scorciatoie di Impostazioni con lo stesso attivatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置き換えはこの端末に留まり、同じきっかけを持つ「設定」のショートカットより優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대체어는 이 기기에만 저장되고, 같은 단축어를 쓰는 설정 항목보다 우선합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penggantian kekal pada peranti ini dan mengatasi pintasan Tetapan yang menggunakan pencetus sama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As substituições ficam neste dispositivo e prevalecem sobre os atalhos dos Ajustes com o mesmo gatilho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замены остаются на этом устройстве и перебивают системные сокращения с тем же триггером."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换项只保存在这台设备上，与“设置”里同名的快捷方式冲突时以它为准。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Asendused jäävad sellesse seadmesse ja alistavad Seadete otseteed, millel on sama päästik."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vervangings bly op hierdie toestel en ignoreer Instellingskortpaaie wat dieselfde sneller deel."
          }
        }
      }
    },
