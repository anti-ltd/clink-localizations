    "Clink checks every language on your list as you type, so two languages can share a sentence without you switching.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kontroleer elke taal op jou lys terwyl jy tik, so twee tale kan 'n sin deel sonder dat jy oorskakel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink prüft beim Tippen jede Sprache deiner Liste, zwei Sprachen können sich also einen Satz teilen, ohne dass du umschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink comprueba todos los idiomas de tu lista mientras escribes, así que dos idiomas pueden compartir una frase sin que cambies de teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kontrollib tipimise käigus igat sinu loendis olevat keelt, nii et kaks keelt saavad lauses jagada ilma, et sa lülitaksid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink vérifie chaque langue de ta liste pendant que tu écris : deux langues peuvent partager une phrase sans que tu bascules."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink gépelés közben a listád minden nyelvét figyeli, így két nyelv megoszthat egy mondatot anélkül, hogy váltanál."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink controlla ogni lingua del tuo elenco mentre scrivi, così due lingue possono condividere una frase senza che tu cambi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkは入力中にリスト内のすべての言語を照合するので、切り替えなくても2つの言語が同じ文に混ざって大丈夫です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink은 입력하는 동안 목록의 모든 언어를 확인하므로, 전환하지 않아도 두 언어가 한 문장에 섞일 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink menyemak setiap bahasa dalam senarai anda semasa menaip, jadi dua bahasa boleh berkongsi satu ayat tanpa anda bertukar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink verifica todos os idiomas da tua lista enquanto escreves, por isso dois idiomas podem partilhar uma frase sem trocares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink проверяет все языки из вашего списка по ходу печати, так что два языка могут уживаться в одном предложении без переключения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打字时 Clink 会校对列表里的每一种语言，所以两种语言可以共处一句，不用切换。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink verifică fiecare limbă de pe listă pe măsură ce introduceți text, astfel încât două limbi să poată partaja o propoziție fără ca dvs. să comutați."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink controleert elke taal op uw lijst terwijl u typt, zodat twee talen een zin kunnen delen zonder dat u hoeft te schakelen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打字時 Clink 會校對列表裡的每一種語言，所以兩種語言可以共處一句，不用切換。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink sprawdza podczas pisania każdy język na liście, więc dwa języki mogą dzielić zdanie bez konieczności przełączania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink перевіряє кожну мову у вашому списку під час введення тексту, тож дві мови можуть спільно використовувати одне речення, не перемикаючись."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink siz yazarken listenizdeki her dili kontrol eder, böylece iki dil siz geçiş yapmadan bir cümleyi paylaşabilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink při psaní kontroluje každý jazyk na vašem seznamu, takže dva jazyky mohou sdílet větu, aniž byste museli přepínat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink pri písaní kontroluje každý jazyk vo vašom zozname, takže dva jazyky môžu zdieľať vetu bez toho, aby ste museli prepínať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Clink ελέγχει κάθε γλώσσα στη λίστα σας καθώς πληκτρολογείτε, ώστε δύο γλώσσες να μπορούν να μοιράζονται μια πρόταση χωρίς να κάνετε εναλλαγή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kontrollerar alla språk på din lista medan du skriver, så två språk kan dela en mening utan att du byter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kontrollerer hvert sprog på din liste, mens du skriver, så to sprog kan dele en sætning, uden at du skifter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink sjekker hvert språk på listen din mens du skriver, så to språk kan dele en setning uten at du bytter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink tarkistaa kaikki luettelossasi olevat kielet kirjoittaessasi, joten kaksi kieltä voivat jakaa lauseen ilman, että vaihdat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink memeriksa setiap bahasa di daftar Anda saat Anda mengetik, sehingga dua bahasa dapat berbagi kalimat tanpa Anda harus berpindah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kiểm tra mọi ngôn ngữ trong danh sách của bạn khi bạn nhập để hai ngôn ngữ có thể chia sẻ một câu mà bạn không cần chuyển đổi."
          }
        }
      }
    },
    "Clink couldn't read that file. Try a wav, m4a, or mp3.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
