    "Start with “summarize this” or “translate into Spanish,” and Clink does it to the rest of what you say.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit „fasse das zusammen“ oder „übersetze ins Spanische“, und Clink wendet es auf den Rest deiner Worte an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con «resume esto» o «traduce al inglés» y Clink lo aplica al resto de lo que digas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alusta sõnadega „tee kokkuvõte“ või „tõlgi hispaania keelde“ ja Clink teeb seda ülejäänud öelduga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par « résume ceci » ou « traduis en espagnol », et Clink l’applique au reste de ce que vous dites."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdd így: „foglald össze” vagy „fordítsd le spanyolra”, és a Clink ezt teszi a többi elmondottal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con «riassumi» o «traduci in spagnolo» e Clink lo applica al resto di ciò che dici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「要約して」や「スペイン語に翻訳して」で始めると、Clinkが残りの内容に実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“요약해 줘”나 “스페인어로 번역해 줘”로 시작하면 Clink가 나머지 말에 적용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulakan dengan “ringkaskan ini” atau “terjemah ke bahasa Sepanyol,” dan Clink melakukannya pada selebihnya yang anda katakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com “resuma isto” ou “traduza para espanhol” e o Clink aplica isso ao resto do que você disser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с «перескажи кратко» или «переведи на испанский», и Clink применит это к остальному сказанному."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以“总结一下”或“翻译成西班牙语”开头，Clink 会对其余内容照做。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începeți cu „rezumați acest lucru” sau „traduceți în spaniolă”, iar Clink face acest lucru pentru restul a ceea ce spuneți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met 'vat dit samen' of 'vertaal in het Spaans', en Clink doet het met de rest van wat u zegt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以“總結一下”或“翻譯成西班牙語”開頭，Clink 會對其餘內容照做。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met \"som dit op\" of \"vertaal in Spaans\", en Clink pas dit toe op die res van wat jy sê."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od „podsumuj to” lub „przetłumacz na hiszpański”, a Clink zrobi to z resztą tego, co powiesz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть із «резюмуйте це» або «перекладіть на іспанську», і Clink зробить це до решти сказаного вами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Bunu özetle\" veya \"İspanyolcaya çevir\" ile başlayın; Clink söylediklerinizin geri kalanını da yapar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začněte slovy „shrňte to“ nebo „přeložte do španělštiny“ a Clink to udělá se zbytkem toho, co říkáte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Začnite slovami „zhrňte to“ alebo „preložte do španielčiny“ a Clink to urobí so zvyškom toho, čo hovoríte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινήστε με \"συνοψίστε αυτό\" ή \"μετάφραση στα Ισπανικά\" και το Clink το κάνει με τα υπόλοιπα που λέτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja med \"sammanfatta detta\" eller \"översätt till spanska\", och Clink gör det med resten av det du säger."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Start med \"opsummer dette\" eller \"oversæt til spansk\", og Clink gør det til resten af det, du siger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Start med \"oppsummer dette\" eller \"oversett til spansk\", og Clink gjør det med resten av det du sier."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita sanalla \"tiivistä tämä\" tai \"käännä espanjaksi\", ja Clink tekee sen muuhun sanomaasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulailah dengan “meringkas ini” atau “terjemahkan ke dalam bahasa Spanyol”, dan Clink akan melakukannya pada keseluruhan ucapan Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu bằng “tóm tắt phần này” hoặc “dịch sang tiếng Tây Ban Nha” và Clink sẽ thực hiện phần còn lại của những gì bạn nói."
          }
        }
      }
    },
    "Running ten minutes late, save me a seat": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bin zehn Minuten später, halt mir einen Platz frei"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llego diez minutos tarde, guárdame un sitio"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jään kümme minutit hiljaks, hoia mulle koht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai dix minutes de retard, garde-moi une place"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tíz percet késem, foglalj nekem helyet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrivo con dieci minuti di ritardo, tienimi un posto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10分遅れます、席を取っておいて"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10분 늦어요, 자리 좀 맡아 줘요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lewat sepuluh minit, simpankan tempat untuk saya"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vou chegar dez minutos atrasado, guarda um lugar para mim"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опаздываю на десять минут, займи мне место"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我晚到十分钟，帮我占个座"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am întârziat zece minute, salvează-mi un loc"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je tien minuten te laat bent, bespaar me dan een stoel"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我晚到十分鐘，幫我佔個座"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ek is tien minute laat; hou 'n sitplek vir my oop"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spóźnię się dziesięć minut, zajmij mi miejsce"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запізнився на десять хвилин, збережи мені місце"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "On dakika geç kalıyorum, bana yer ayır"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přicházím o deset minut pozdě, ušetříte mi místo"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Meškám desať minút, ušetri mi miesto"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με δέκα λεπτά καθυστέρηση, φύλαξέ μου μια θέση"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blir tio minuter försenad, rädda mig en plats"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom ti minutter for sent, spar mig en plads"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blir ti minutter forsinket, spar meg et sete"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Myöhästyt kymmenen minuuttia, säästä minulle paikka"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlambat sepuluh menit, beri aku tempat duduk"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trễ mười phút, giữ cho tôi một chỗ ngồi"
          }
        }
      }
    },
