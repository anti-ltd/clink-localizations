    "Draw the finger path while you swipe.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teken die vingerpad terwyl jy swiep."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Fingerspur an, während du wischst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja el recorrido del dedo mientras deslizas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva sõrmejälg pühkimise ajal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
