    "Tap App language and pick one.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik App-taal en kies een."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „App-Sprache“ und wähle eine aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Idioma de la app y elige uno."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta Rakenduse keel ja vali üks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Langue de l'app et choisis-en une."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints az Alkalmazás nyelve elemre, és válassz egyet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Lingua dell'app e scegline una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アプリの言語」をタップして、言語を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 언어를 누르고 하나 고르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik Bahasa apl dan pilih satu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em Idioma da app e escolhe um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Язык приложения» и выберите нужный."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点“应用语言”，选一个。"
          }
        }
      }
    },
    "Tap Ask this on the card that appears.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik Vra dit op die kaart wat verskyn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf der Karte, die erscheint, auf „Das fragen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Preguntar esto en la tarjeta que aparece."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta ilmuval kaardil Küsi seda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Poser cette question sur la carte qui apparaît."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megjelenő kártyán koppints a Kérdezd ezt gombra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Chiedi questo sulla scheda che compare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示されたカードの「これを聞く」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나타난 카드에서 이걸 물어보기를 누르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik Tanya ini pada kad yang muncul."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em Perguntar isto no cartão que aparece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Спросить это» на появившейся карточке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在出现的卡片上点“问这个”。"
          }
        }
      }
    },
    "Tap Default (or pick Liquid if you liked the old soft spring).": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Standard oder wähle Flüssig, wenn dir die frühere sanfte Federbewegung gefallen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Predeterminado o elige Líquido si te gustaba el rebote suave anterior."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta „Vaikimisi” või vali „Voolav”, kui sulle meeldis varasem pehme vetruv liikumine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Par défaut, ou choisis Liquide si tu aimais l’ancien rebond souple."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints az Alapértelmezett lehetőségre, vagy válaszd a Folyékony módot, ha a korábbi lágy rugózást kedvelted."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Predefinito oppure scegli Liquido se ti piaceva il vecchio rimbalzo morbido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「デフォルト」をタップします。以前の柔らかな弾みが好みなら、「リキッド」を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘기본값’을 탭하세요. 예전의 부드럽게 튕기는 느낌이 좋았다면 ‘리퀴드’를 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik Lalai atau pilih Cecair jika anda menyukai lantunan lembut yang lama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em Predefinição ou escolhe Líquido se gostavas do efeito de mola suave anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «По умолчанию» или выберите «Жидкий», если вам нравилась прежняя мягкая пружинная анимация."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点“默认”；如果喜欢以前那种柔和的回弹感，可以选择“液态”。"
          }
        }
      }
    },
    "Tap Restore Purchases, signed in with the Apple Account you bought it on.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik op Herstel aankope, aangemeld met die Apple-rekening waarop jy dit gekoop het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Käufe wiederherstellen“ — angemeldet mit dem Apple-Account, mit dem du gekauft hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Restaurar compras, con la sesión iniciada en la cuenta de Apple con la que lo compraste."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta Taasta ostud, logitud Apple’i kontosse, millega ostsid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Restaurer les achats, connecté avec le compte Apple utilisé pour l'achat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a Vásárlások visszaállítása gombra, azzal az Apple-fiókkal bejelentkezve, amelyikkel vetted."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Ripristina acquisti, con l'account Apple da cui hai comprato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入に使ったApple アカウントでサインインした状態で、「購入を復元」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구입할 때 쓴 Apple 계정으로 로그인한 상태에서 구매 복원을 누르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik Pulihkan Pembelian, sambil log masuk dengan Akaun Apple yang anda gunakan semasa membeli."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em Restaurar compras, com sessão iniciada na conta Apple onde o compraste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Восстановить покупки», войдя в тот аккаунт Apple, на который покупали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用当初购买的那个 Apple 账户登录，然后点“恢复购买”。"
          }
        }
      }
    },
    "Tap Share if you want to send it to us.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Teilen, wenn du ihn uns senden möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Compartir si quieres enviárnoslo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui soovid selle meile saata, puuduta „Jaga”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Partager si tu veux nous l’envoyer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha el szeretnéd küldeni nekünk, koppints a Megosztás gombra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Condividi se vuoi inviarcelo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私たちに送る場合は、「共有」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저희에게 보내려면 ‘공유’를 탭하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik Kongsi jika anda mahu menghantarnya kepada kami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em Partilhar se quiseres enviar-nos o relatório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Поделиться», если хотите отправить отчёт нам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需发送给我们，请轻点“共享”。"
