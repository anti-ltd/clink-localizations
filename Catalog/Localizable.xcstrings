          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op knoppen in het voorbeeld. De tekst die ze invoegen, wordt hier weergegeven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點點預覽裡的按鈕。它們插入的文字會顯示在這裡。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij przyciski w podglądzie. Wstawiony przez nich tekst pojawia się tutaj."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
