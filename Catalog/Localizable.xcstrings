    "w → ư": {
      "comment": "Telex keystroke mapping, identical in every language: the w key produces the Vietnamese letter ư. Keep the literal key and output unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
