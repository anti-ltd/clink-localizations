    "Draw the warp grid + per-key arrows on the real keyboard, so you can see exactly how taps get nudged": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teken die warp-rooster + per-sleutel-pyltjies op die regte sleutelbord, sodat jy presies kan sien hoe krane gestamp word"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt das Verzerrungsraster + Pfeile pro Taste auf der echten Tastatur, damit du genau siehst, wie Tipps verschoben werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja la cuadrícula de deformación y las flechas de cada tecla en el teclado real, para que veas exactamente cómo se ajustan los toques"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva tegelikul klaviatuuril moonutusruudustik + klahvipõhised nooled, et sa näeksid täpselt, kuidas vajutusi nihutatakse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche la grille de déformation + les flèches par touche sur le vrai clavier, pour que tu voies exactement comment les appuis sont ajustés"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirajzolja a torzítási rácsot és a billentyűnkénti nyilakat az igazi billentyűzeten, hogy pontosan lásd, hogyan tolódnak el a koppintások"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna la griglia di deformazione + le frecce per tasto sulla tastiera vera, così vedi esattamente come vengono spostati i tocchi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際のキーボードにワープグリッドとキーごとの矢印を表示して、タップがどう補正されるかを正確に見られます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 키보드에 왜곡 격자와 키별 화살표를 그려서, 탭이 어떻게 밀리는지 정확히 볼 수 있어요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukis grid lentik + anak panah setiap kekunci pada papan kekunci sebenar, supaya anda nampak tepat bagaimana ketikan ditolak"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenha a grelha de distorção + as setas por tecla no teclado real, para veres exatamente como os toques são empurrados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисовать сетку искажения и стрелки у каждой клавиши на настоящей клавиатуре, чтобы видеть, как именно сдвигаются нажатия"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在真实键盘上画出扭曲网格和每个键的箭头，让你看清点按是怎么被微调的"
          }
        }
      }
    },
    "Draw with a finger or Apple Pencil. Two fingers move and zoom the canvas.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja con el dedo o con el Apple Pencil. Con dos dedos puedes mover y ampliar el lienzo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessine avec le doigt ou l’Apple Pencil. Utilise deux doigts pour déplacer la zone de dessin et zoomer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne mit dem Finger oder Apple Pencil. Mit zwei Fingern bewegst und zoomst du die Zeichenfläche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna con un dito o con l'Apple Pencil. Con due dita sposti e ingrandisci l'area di disegno."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe com o dedo ou com o Apple Pencil. Use dois dedos para mover a área de desenho e ampliar ou reduzir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисуйте пальцем или Apple Pencil. Двумя пальцами можно перемещать и масштабировать холст."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukis dengan jari atau Apple Pencil. Dua jari menggerakkan dan menzum kanvas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajzolj ujjal vagy Apple Pencillel. Két ujjal mozgathatod és nagyíthatod a vásznat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指またはApple Pencilで描きます。2本指でキャンバスを移動・拡大できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用手指或 Apple Pencil 绘制。双指可平移和缩放画布。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손가락이나 Apple Pencil로 그리세요. 두 손가락으로 캔버스를 이동하고 확대할 수 있습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Joonista sõrme või Apple Penciliga. Kahe sõrmega saad lõuendit liigutada ja suurendada."
          }
        }
      }
    },
