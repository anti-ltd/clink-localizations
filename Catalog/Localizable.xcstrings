          }
        }
      }
    },
    "Turn Show background off to let the app you're typing in show through.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte „Hintergrund anzeigen“ aus, damit die App durchscheint, in der du gerade tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva Mostrar fondo para que se vea la app en la que escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive Afficher l'arrière-plan pour laisser voir l'app dans laquelle tu écris."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold ki a Háttér megjelenítése beállítást, hogy átlásson rajta az app, amelybe gépelsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva Mostra sfondo per lasciar vedere l'app in cui stai scrivendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「背景を表示」をオフにすると、入力中のアプリが透けて見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경 표시를 끄면 입력 중인 앱이 비쳐 보입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan Tunjuk latar belakang supaya apl yang anda taip padanya kelihatan menembusi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga Mostrar fundo para se ver a app onde estás a escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите «Показывать фон», чтобы сквозь клавиатуру было видно приложение, в котором вы печатаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
