      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Neuinstallation ist alles sauber. Wir speichern nichts auf einem Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al reinstalar empiezas de cero. No guardamos nada en ningún servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinstaller repart de zéro. On ne garde rien sur un serveur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az újratelepítés tiszta lappal indul. Semmit nem tartunk szerveren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reinstalli riparti da zero. Non teniamo niente su un server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入れ直すとまっさらな状態から始まります。サーバー側には何も残していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 설치하면 처음부터 깨끗하게 시작해요. 서버에는 아무것도 안 남겨요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang semula bermula bersih. Kami tak simpan apa-apa pada pelayan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstalar começa do zero. Não guardamos nada num servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переустановка начинается с чистого листа. На сервере мы ничего не храним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重装就是干干净净从头开始。我们在服务器上什么都不留。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Uuesti paigaldamine algab puhtalt. Me ei hoia serveris midagi."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Herinstalleer begin skoon. Ons hou niks op 'n bediener nie."
          }
        }
      }
    },
