          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색의 물결이 키 위를 흘러갑니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Toonilaine veereb üle klahvide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Волна цвета прокатывается по клавишам."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "’n Tintgolf rol oor die sleutels."
          }
        }
      }
    },
    "A keyboard you can make your own. Here's the quick tour.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Tastatur, die du zu deiner eigenen machen kannst. Hier der kurze Rundgang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un teclado que puedes hacer tuyo. Aquí tienes el recorrido rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clavier que tu peux t'approprier. Voici la visite éclair."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy billentyűzet, amit a magadévá tehetsz. Íme a gyors bemutató."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tastiera che puoi rendere tua. Ecco il giro veloce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分好みにできるキーボードです。かんたんに一巡り紹介します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만의 것으로 만들 수 있는 키보드예요. 간단히 둘러볼게요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci yang boleh anda jadikan milik anda. Ini lawatan pantasnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um teclado que podes fazer teu. Aqui vai a visita rápida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура, которую можно сделать своей. Вот короткая экскурсия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个能打造成你自己的键盘。来快速逛一圈。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuur, mida saad enda omaks teha. Siin on kiire ülevaade."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Sleutelbord wat jy jou eie kan maak. Hier is die vinnige toer."
          }
        }
      }
    },
