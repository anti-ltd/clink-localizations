    "Review the detected keys and choose the matching letter layout.": {
      "comment": "Photo theme importer review. Recognition fits physical key geometry; the user chooses the letter layout.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaan die bespeurde sleutels na en kies die ooreenstemmende letteruitleg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die erkannten Tasten und wähle die passende Buchstabenanordnung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa las teclas detectadas y elige la distribución de letras correspondiente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaata tuvastatud klahvid üle ja vali sobiv tähepaigutus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie les touches détectées et choisis la disposition des lettres correspondante."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizd a felismert billentyűket, és válaszd ki a megfelelő betűkiosztást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla i tasti rilevati e scegli la disposizione delle lettere corrispondente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検出されたキーを確認し、写真に合う文字配列を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감지된 키를 확인하고 사진에 맞는 문자 배열을 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak kekunci yang dikesan dan pilih susun atur huruf yang sepadan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Revê as teclas detetadas e escolhe a disposição de letras correspondente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте распознанные клавиши и выберите подходящую раскладку букв."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查检测到的按键，并选择与照片相符的字母布局。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică tastele detectate și alege aranjamentul de litere corespunzător."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de herkende toetsen en kies de bijbehorende letterindeling."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查偵測到的按鍵，並選擇與照片相符的字母配置。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź wykryte klawisze i wybierz odpowiedni układ liter."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте розпізнані клавіші та виберіть відповідну розкладку літер."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Algılanan tuşları kontrol edin ve eşleşen harf düzenini seçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte rozpoznané klávesy a vyberte odpovídající rozložení písmen."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte rozpoznané klávesy a vyberte zodpovedajúce rozloženie písmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε τα πλήκτρα που εντοπίστηκαν και επιλέξτε την αντίστοιχη διάταξη γραμμάτων."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera de identifierade tangenterna och välj motsvarande bokstavslayout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollér de registrerede taster, og vælg det tilsvarende bogstavlayout."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller de gjenkjente tastene, og velg tilsvarende bokstavoppsett."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista tunnistetut näppäimet ja valitse vastaava kirjainasettelu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa tombol yang terdeteksi dan pilih tata letak huruf yang sesuai."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra các phím được nhận diện và chọn bố cục chữ cái phù hợp."
          }
        }
      }
    },
    "No keyboard detected. These colors come from the whole photo.": {
      "comment": "Photo theme importer review. Recognition fits physical key geometry; the user chooses the letter layout.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen sleutelbord bespeur nie. Hierdie kleure kom uit die hele foto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Tastatur erkannt. Diese Farben stammen aus dem gesamten Foto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha detectado ningún teclado. Estos colores se han obtenido de toda la foto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuuri ei tuvastatud. Need värvid pärinevad kogu fotolt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun clavier détecté. Ces couleurs proviennent de l’ensemble de la photo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem található billentyűzet. Ezek a színek a teljes fényképből származnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna tastiera rilevata. Questi colori sono ricavati dall’intera foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードが見つかりませんでした。写真全体から色を抽出しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드를 찾지 못했습니다. 사진 전체에서 색상을 추출했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada papan kekunci dikesan. Warna ini diambil daripada keseluruhan foto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi detetado nenhum teclado. Estas cores foram extraídas da fotografia inteira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура не найдена. Эти цвета взяты со всей фотографии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到键盘。这些颜色提取自整张照片。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a detectat nicio tastatură. Aceste culori provin din întreaga fotografie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toetsenbord gevonden. Deze kleuren zijn afkomstig uit de hele foto."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未偵測到鍵盤。這些顏色擷取自整張照片。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wykryto klawiatury. Te kolory pochodzą z całego zdjęcia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіатуру не знайдено. Ці кольори взято з усієї фотографії."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye algılanamadı. Bu renkler fotoğrafın tamamından alındı."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesnice nebyla rozpoznána. Tyto barvy pocházejí z celé fotografie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesnica sa nenašla. Tieto farby pochádzajú z celej fotografie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν εντοπίστηκε πληκτρολόγιο. Αυτά τα χρώματα προέρχονται από ολόκληρη τη φωτογραφία."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget tangentbord hittades. Färgerna har hämtats från hela fotot."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet tastatur fundet. Disse farver er hentet fra hele billedet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ikke noe tastatur. Disse fargene er hentet fra hele bildet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäimistöä ei löytynyt. Nämä värit on poimittu koko kuvasta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard tidak terdeteksi. Warna ini diambil dari seluruh foto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy bàn phím. Các màu này được lấy từ toàn bộ ảnh."
          }
        }
      }
    },
