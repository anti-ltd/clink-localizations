        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопированный текст доступен на всех устройствах. Скопированные изображения остаются на месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你复制的文字，在每台设备上随时可用。复制的图片则留在原处。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst, mida kopeerid, on valmis igas seadmes. Kopeeritud pildid jäävad paigale."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die teks wat jy kopieer, gereed op elke toestel. Gekopieerde beelde bly sit."
          }
        }
      }
    },
    "The things people ask us most. Each answer ends on the setting it's about, so you can go straight there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fragen, die uns am häufigsten erreichen. Jede Antwort endet bei der passenden Einstellung – du kommst also direkt hin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que más nos preguntáis. Cada respuesta termina en el ajuste del que habla, así que puedes ir directo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu'on nous demande le plus souvent. Chaque réponse se termine sur le réglage concerné, tu peux donc y aller directement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amit a leggyakrabban kérdeznek tőlünk. Minden válasz annál a beállításnál ér véget, amiről szól, így egyenesen odaugorhatsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le domande che ci arrivano più spesso. Ogni risposta finisce sull'impostazione di cui parla, così ci arrivi subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よくいただく質問をまとめました。答えの最後から、その設定へそのまま移動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 많이 받는 질문들입니다. 각 답변 끝에서 해당 설정으로 바로 이동할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Soalan yang paling kerap kami terima. Setiap jawapan berakhir pada tetapan yang berkenaan, jadi anda boleh terus ke sana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que mais nos perguntam. Cada resposta acaba na definição de que fala, para ires lá directamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, о чём нас спрашивают чаще всего. Каждый ответ заканчивается настройкой, о которой идёт речь, — можно перейти прямо к ней."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大家问得最多的问题。每条答案最后都能直接跳到相关设置。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mida inimesed meilt kõige sagedamini küsivad. Iga vastus lõpeb seadistusega, mis puudutab, et sa saaksid otse sinna minna."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die dinge wat mense ons die meeste vra. Elke antwoord eindig op die instelling waaroor dit gaan, so jy kan reguit soontoe gaan."
          }
        }
      }
    },
