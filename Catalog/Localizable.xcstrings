    "Themes you've made yourself. Built-in themes are already everywhere.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los temas que has creado. Los integrados ya están en todos tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les thèmes que tu as créés. Les thèmes intégrés sont déjà sur tous tes appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine selbst erstellten Themes. Integrierte Themes sind bereits auf allen Geräten vorhanden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I temi che hai creato. Quelli integrati sono già su tutti i dispositivi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os temas que criou. Os temas integrados já estão em todos os dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Созданные вами темы. Встроенные темы уже есть на всех устройствах."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema yang anda cipta sendiri. Tema terbina dalam sudah tersedia pada semua peranti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A saját készítésű témáid. A beépített témák már minden eszközön elérhetők."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で作成したテーマです。内蔵テーマはすべてのデバイスに用意されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己创建的主题。内置主题已在所有设备上提供。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 만든 테마입니다. 기본 제공 테마는 모든 기기에 이미 있습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu loodud teemad. Sisseehitatud teemad on juba kõigis seadmetes olemas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Teme pe care le-ați creat singur. Temele încorporate sunt deja peste tot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Thema's die je zelf hebt gemaakt. Ingebouwde thema's zijn al overal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己建立的主題。內建主題已在所有裝置上提供。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Temas wat jy self geskep het. Ingeboude temas is reeds oral beskikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motywy, które sam stworzyłeś. Wbudowane motywy są już wszędzie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Теми, які ви створили самі. Вбудовані теми вже всюди."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi oluşturduğunuz temalar. Yerleşik temalar zaten her yerde."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Témata, která jste sami vytvořili. Vestavěná témata jsou již všude."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Témy, ktoré ste sami vytvorili. Vstavané témy sú už všade."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέματα που έχετε φτιάξει μόνοι σας. Τα ενσωματωμένα θέματα είναι ήδη παντού."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Teman du har gjort själv. Inbyggda teman finns redan överallt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Temaer du selv har lavet. Indbyggede temaer er allerede overalt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Temaer du har laget selv. Innebygde temaer er allerede overalt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teemat, jotka olet tehnyt itse. Sisäänrakennetut teemat ovat jo kaikkialla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema yang Anda buat sendiri. Tema bawaan sudah ada dimana-mana."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ đề bạn tự làm. Các chủ đề tích hợp đã có ở khắp mọi nơi."
          }
        }
      }
    },
    "Themes, layouts, sounds, and scripts are files on your phone.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
