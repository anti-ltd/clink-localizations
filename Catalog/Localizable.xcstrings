    "Grow +20%, shrink −10%, bias 40%. A gentle nudge.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachsen +20 %, schrumpfen −10 %, Tendenz 40 %. Ein sanfter Schubs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crece +20%, encoge −10%, sesgo 40%. Un empujoncito suave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrandir +20 %, rétrécir −10 %, biais 40 %. Un léger coup de pouce."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Növelés +20%, zsugorítás −10%, torzítás 40%. Finom lökés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cresce +20%, si restringe −10%, bias 40%. Una spinta leggera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡大 +20%、縮小 −10%、バイアス 40%。控えめな補正。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확대 +20%, 축소 −10%, 편향 40%. 살짝 밀어줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Besar +20%, kecil −10%, condong 40%. Tolakan lembut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cresce +20%, encolhe −10%, tendência 40%. Um empurrãozinho suave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рост +20%, сжатие −10%, смещение 40%. Лёгкий подталкивающий эффект."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大 +20%，收缩 −10%，偏向 40%。轻轻推一下。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasv +20%, kahanemine −10%, kaldu 40%. Õrn tõuge."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Groei +20%, krimp -10%, vooroordeel 40%. 'n Sagte stoot."
          }
        }
      }
    },
