    "Some optional effects are paused to keep typing smooth. Glass itself is untouched.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige opsionele effekte word onderbreek om glad te tik. Glas self is onaangeraak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige optionale Effekte pausieren, damit das Tippen flüssig bleibt. Das Glas selbst bleibt unangetastet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos efectos opcionales están en pausa para que escribir siga siendo fluido. El cristal no cambia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mõned valikulised efektid on peatatud, et tipimine jääks sujuvaks. Klaas ise jääb puutumata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains effets facultatifs sont en pause pour garder une frappe fluide. Le verre, lui, ne change pas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány nem kötelező effekt szünetel, hogy a gépelés gördülékeny maradjon. Maga az üveg változatlan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni effetti opzionali sono in pausa per mantenere fluida la digitazione. Il vetro resta invariato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力を滑らかに保つため、一部の任意エフェクトを止めています。ガラス自体はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력이 매끄럽도록 일부 선택적인 효과를 멈췄습니다. 글래스 자체는 그대로입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebahagian kesan pilihan dijeda supaya taipan kekal lancar. Kaca itu sendiri tidak berubah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns efeitos opcionais estão em pausa para a escrita continuar fluida. O vidro em si não muda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть необязательных эффектов приостановлена, чтобы печать оставалась плавной. Само стекло не затронуто."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了保持输入流畅，部分可选特效暂停了。玻璃本身没有变化。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unele efecte opționale sunt întrerupte pentru a menține tastarea lină. Sticla în sine este neatinsă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige optionele effecten zijn gepauzeerd om het typen soepel te laten verlopen. Glas zelf is onaangeroerd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了保持輸入流暢，部分可選特效暫停了。玻璃本身沒有變化。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre opcjonalne efekty są wstrzymywane, aby zapewnić płynność pisania. Samo szkło jest nienaruszone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі додаткові ефекти призупиняються, щоб набір тексту був плавним. Саме скло недоторкане."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazmayı sorunsuz bir şekilde sürdürmek için bazı isteğe bağlı efektler duraklatılmıştır. Camın kendisine dokunulmaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé volitelné efekty jsou pozastaveny, aby bylo psaní plynulé. Samotné sklo je nedotčené."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektoré voliteľné efekty sú pozastavené, aby bolo písanie plynulé. Samotné sklo je nedotknuté."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορισμένα προαιρετικά εφέ τίθενται σε παύση για να συνεχιστεί η ομαλή πληκτρολόγηση. Το ίδιο το γυαλί είναι ανέγγιχτο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa valfria effekter pausas för att fortsätta skriva smidigt. Själva glaset är orört."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle valgfrie effekter er sat på pause for at fortsætte med at skrive glat. Selve glasset er uberørt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen valgfrie effekter settes på pause for å fortsette å skrive jevnt. Selve glasset er urørt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotkut valinnaiset tehosteet keskeytetään, jotta kirjoittaminen pysyy sujuvana. Itse lasi on koskematon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa efek opsional dijeda agar pengetikan tetap lancar. Kaca itu sendiri tidak tersentuh."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số hiệu ứng tùy chọn bị tạm dừng để tiếp tục gõ mượt mà. Bản thân kính không bị ảnh hưởng."
          }
        }
      }
    },
