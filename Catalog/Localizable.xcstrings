        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читання та заміна вмісту буфера обміну. Потрібен повний доступ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pano içeriğini okuyun ve değiştirin. Tam Erişim gerektirir."
