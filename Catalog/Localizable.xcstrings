          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkはそのファイルを読めませんでした。wav、m4a、mp3を試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink이 그 파일을 읽지 못했어요. wav, m4a, mp3를 써 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
