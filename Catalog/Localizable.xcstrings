    "Locks the keyboard and shows the paywall as if you'd never bought anything. Debug builds only.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit die sleutelbord en wys die betaalmuur asof jy nog nooit iets gekoop het nie. Ontfout slegs bouwerk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperrt die Tastatur und zeigt die Paywall an, als hättest du nie etwas gekauft. Nur in Debug-Builds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea el teclado y muestra el muro de pago como si nunca hubieras comprado nada. Solo en compilaciones de depuración."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukustab klaviatuuri ja näitab tasumüüri nii, nagu sa poleks kunagi midagi ostnud. Ainult silumise versioonides."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouille le clavier et affiche le mur payant comme si tu n'avais jamais rien acheté. Builds de débogage uniquement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lezárja a billentyűzetet, és úgy mutatja a fizetőfalat, mintha soha nem vásároltál volna semmit. Csak debug buildekben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca la tastiera e mostra il paywall come se non avessi mai comprato nulla. Solo build di debug."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードをロックし、何も購入していないかのように課金画面を表示します。デバッグビルド限定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드를 잠그고 아무것도 산 적 없는 것처럼 결제 화면을 보여줘요. 디버그 빌드 전용."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengunci papan kekunci dan memaparkan tembok bayar seolah-olah anda tidak pernah membeli apa-apa. Binaan nyahpepijat sahaja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia o teclado e mostra o ecrã de compra como se nunca tivesses comprado nada. Apenas em builds de depuração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокирует клавиатуру и показывает экран оплаты так, будто вы ничего не покупали. Только в отладочных сборках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定键盘并显示付费墙，就像你从未购买过一样。仅限调试版本。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocează tastatura și arată peretele de plată ca și cum nu ai fi cumpărat niciodată nimic. Depanare numai versiuni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrendelt het toetsenbord en toont de betaalmuur alsof je nooit iets hebt gekocht. Alleen debug-builds."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定鍵盤並顯示付費牆，就像你從未購買過一樣。僅限除錯版本。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokuje klawiaturę i wyświetla paywall tak, jakbyś nigdy niczego nie kupił. Debuguj tylko kompilacje."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокує клавіатуру та показує систему оплати так, ніби ви ніколи нічого не купували. Лише збірки для налагодження."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyeyi kilitler ve ödeme duvarını sanki hiç bir şey satın almamışsınız gibi gösterir. Yalnızca derlemelerde hata ayıklama."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamkne klávesnici a zobrazí paywall, jako byste si nikdy nic nekoupili. Pouze sestavení ladění."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamkne klávesnicu a zobrazí paywall, ako keby ste si nikdy nič nekúpili. Iba ladiace zostavy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κλειδώνει το πληκτρολόγιο και δείχνει το paywall σαν να μην είχατε αγοράσει ποτέ τίποτα. Δημιουργίες εντοπισμού σφαλμάτων μόνο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låser tangentbordet och visar betalväggen som om du aldrig hade köpt något. Endast felsökningsbyggen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Låser tastaturet og viser betalingsvæggen, som om du aldrig havde købt noget. Debug kun builds."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Låser tastaturet og viser betalingsveggen som om du aldri hadde kjøpt noe. Feilsøk kun bygg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukitsee näppäimistön ja näyttää maksumuurin kuin et olisi koskaan ostanut mitään. Vain debug builds."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengunci keyboard dan menampilkan paywall seolah-olah Anda belum pernah membeli apa pun. Hanya build debug."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa bàn phím và hiển thị tường phí như thể bạn chưa từng mua bất cứ thứ gì. Chỉ gỡ lỗi bản dựng."
          }
        }
      }
    },
