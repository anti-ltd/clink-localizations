        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что вы сделали, едет с вами"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你做的一切随身携带"
