        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink er endnu ikke på din liste over skærmtastaturer. Trin 1 tager omkring tyve sekunder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ist noch nicht in deiner Liste der Bildschirmtastaturen. Schritt 1 dauert etwa zwanzig Sekunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Clink δεν βρίσκεται ακόμη στη λίστα με τα πληκτρολόγια οθόνης. Το βήμα 1 διαρκεί περίπου είκοσι δευτερόλεπτα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink todavía no está en tu lista de teclados en pantalla. El paso 1 lleva unos veinte segundos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinki pole veel sinu ekraaniklaviatuuride loendis. 1. samm võtab umbes kakskümmend sekundit."
