    "Add apostrophes to contractions like “dont” → “don’t”.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt Apostrophe in Kontraktionen, etwa „dont“ → „don’t“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade apóstrofos a las contracciones, como “dont” → “don’t”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des apostrophes aux contractions, comme « dont » → « don’t »."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegyél aposztrófot az egybeírt szavakba, például „dont” → „don’t”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge l'apostrofo alle contrazioni, tipo “dont” → “don’t”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「dont」→「don’t」のような短縮形にアポストロフィを付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“dont” → “don’t” 처럼 축약형에 아포스트로피를 넣어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah tanda kutip pada singkatan seperti “dont” → “don’t”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona apóstrofos às contrações, como “dont” → “don’t”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставить апострофы в сокращениях: «dont» → «don’t»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给缩写补上撇号，比如 “dont” → “don’t”。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa kontraktsioonidele ülakoma, näiteks „dont\" → „don't\"."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg apostrofe by kontraksies soos \"moenie\" → \"moenie\"."
          }
        }
      }
    },
