    "While you drag the cursor, tap anywhere with another finger to start highlighting.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras arrastras el cursor, toca en cualquier parte con otro dedo para empezar a marcar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant que vous faites glisser le curseur, touchez n'importe où avec un autre doigt pour commencer à sélectionner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während du den Cursor ziehst, tippe mit einem anderen Finger irgendwo hin, um zu markieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre trascini il cursore, tocca ovunque con un altro dito per iniziare a selezionare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto arrastas o cursor, toca em qualquer lado com outro dedo para começar a destacar."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semasa anda seret kursor, ketik di mana-mana dengan jari lain untuk mula menonjolkan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amíg a kurzort húzod, koppints máshova a másik ujjaddal, és onnan jelöl."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルをドラッグ中に、もう一方の指でキーボードをタップすると選択が始まります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动光标时，用另一根手指点按键盘任意处即可开始选中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서를 끄는 동안 다른 손가락으로 아무 곳이나 탭하면 선택을 시작합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui sa kursorit lohistad, puuduta teise sõrmega kuskil, et alustada esiletõstmist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивая курсор, коснитесь в любом месте другим пальцем, чтобы начать выделение."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terwyl jy die wyser sleep, tik enige plek met 'n ander vinger om te begin uitlig."
          }
        }
      }
    },
    "Hold the space bar and slide. Tap with another finger while dragging to start highlighting.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la barra espaciadora y desliza. Toca con otro dedo mientras arrastras para empezar a marcar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la barre d'espace et faites glisser. Touchez avec un autre doigt pendant le glissement pour commencer à sélectionner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Leertaste und schiebe. Tippe mit einem anderen Finger während des Ziehens, um zu markieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta la barra spaziatrice e fai scorrere. Tocca con un altro dito mentre trascini per iniziare a selezionare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a barra de espaço e desliza. Toca com outro dedo enquanto arrastas para começar a destacar."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan bar ruang dan seret. Ketik dengan jari lain semasa menyeret untuk mula menonjolkan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd a szóközt, és csúsztasd. Koppints a másik ujjaddal húzás közben, és onnan jelöl."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースバーを押しながらスライド。ドラッグ中にもう一方の指でタップすると選択が始まります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住空格键滑动。拖动时用另一根手指点按即可开始选中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 바를 누른 채 미세요. 끄는 동안 다른 손가락으로 탭하면 선택이 시작됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia tühikuklahvi ja libise. Puuduta lohistamise ajal teise sõrmega, et alustada esiletõstmist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте пробел и ведите. Коснитесь другим пальцем во время перетаскивания, чтобы начать выделение."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou die spasiebalk vas en skuif. Tik met 'n ander vinger terwyl jy sleep om te begin uitlig."
          }
        }
      }
    },
