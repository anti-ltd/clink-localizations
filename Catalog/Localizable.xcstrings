    "Make one, then import a dictionary for it if you have a word list.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg eine an und importier ein Wörterbuch dafür, falls du eine Wortliste hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
