        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece Clink a los valores de fábrica y elimina permanentemente tu contenido personalizado y los perfiles guardados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taastab Clinki tehase vaikeseaded ning eemaldab jäädavalt sinu kohandatud sisu ja salvestatud profiilid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit les réglages d’usine de Clink et supprime définitivement ton contenu personnalisé et tes profils enregistrés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítja a Clink gyári beállításait, és végleg eltávolítja az egyéni tartalmakat és mentett profilokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina Clink alle impostazioni di fabbrica e rimuove definitivamente contenuti personalizzati e profili salvati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkを工場出荷時設定に戻し、カスタムコンテンツと保存済みプロファイルを完全に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink을 공장 기본값으로 복원하고 사용자 설정 콘텐츠와 저장된 프로필을 영구적으로 제거합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulihkan Clink kepada tetapan kilang serta mengalih keluar kandungan tersuai dan profil tersimpan anda secara kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura o Clink para as predefinições de fábrica e remove permanentemente o seu conteúdo personalizado e perfis guardados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает заводские настройки Clink и безвозвратно удаляет ваш пользовательский контент и сохранённые профили."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Clink 恢复为出厂默认设置，并永久移除你的自定内容和已保存的配置文件。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restabilește Clink la valorile implicite din fabrică și elimină definitiv conținutul personalizat și profilurile salvate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelt Clink naar de fabrieksinstellingen en verwijdert permanent uw aangepaste inhoud en opgeslagen profielen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 Clink 恢復為出廠預設設定，並永久移除你的自定內容和已儲存的配置檔案。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel Clink na fabrieksinstellings en verwyder jou pasgemaakte inhoud en gestoorde profiele permanent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca ustawienia fabryczne Clink i trwale usuwa niestandardową zawartość i zapisane profile."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлює Clink до заводських налаштувань і назавжди видаляє ваш власний вміст і збережені профілі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink'i fabrika varsayılanlarına geri yükler ve özel içeriğinizi ve kayıtlı profillerinizi kalıcı olarak kaldırır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoví Clink do továrního nastavení a trvale odstraní váš vlastní obsah a uložené profily."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoví Clink na predvolené výrobné nastavenia a natrvalo odstráni váš vlastný obsah a uložené profily."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores Clink to factory defaults and permanently removes your custom content and saved profiles."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställer Clink till fabriksinställningarna och tar permanent bort ditt anpassade innehåll och sparade profiler."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendanner Clink til fabriksindstillingerne og fjerner permanent dit brugerdefinerede indhold og gemte profiler."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenoppretter Clink til fabrikkinnstillinger og fjerner det tilpassede innholdet og lagrede profiler permanent."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palauttaa Clink:n tehdasasetuksiin ja poistaa pysyvästi mukautetun sisällön ja tallennetut profiilit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengembalikan Clink ke default pabrik dan menghapus secara permanen konten khusus dan profil tersimpan Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục Clink về mặc định ban đầu và xóa vĩnh viễn nội dung tùy chỉnh cũng như cấu hình đã lưu của bạn."
          }
        }
      }
    },
    "Restores every setting to default. Your custom themes and saved emoji skin tones are kept.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel elke instelling terug na verstek. Jou pasgemaakte temas en gestoorde emoji-velkleure word behou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt alle Einstellungen auf die Standardwerte zurück. Deine eigenen Designs und gespeicherten Emoji-Hauttöne bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Devuelve todos los ajustes a como venían. Tus temas y los tonos de piel de emoji guardados se quedan como están."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taastab iga seadistuse vaikeväärtusele. Sinu kohandatud teemad ja salvestatud emoji nahatoonid jäävad alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remet tous les réglages par défaut. Tes thèmes perso et tes teintes de peau d'emojis sont gardés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden beállítást visszaállít az alaphelyzetbe. Az egyéni témáid és a mentett emoji bőrtónusaid megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riporta tutte le impostazioni ai valori predefiniti. I tuoi temi personalizzati e le tonalità della pelle salvate per gli emoji restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての設定を初期状態に戻します。カスタムテーマと保存した絵文字の肌の色はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 설정을 기본값으로 되돌려요. 직접 만든 테마와 저장한 이모지 피부톤은 그대로 둬요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Set semula semua tetapan ke lalai. Tema tersuai dan ton kulit emoji anda dikekalkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Repõe todas as definições para os valores originais. Os teus temas personalizados e os tons de pele de emoji guardados ficam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает все настройки к стандартным. Ваши темы и сохранённые тона кожи эмодзи остаются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把所有设置还原成默认。你的自定义主题和保存的表情肤色都会留着。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restabilește fiecare setare la valoarea implicită. Temele personalizate și tonurile de piele pentru emoji salvate sunt păstrate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelt elke instelling naar de standaardwaarden. Je aangepaste thema's en opgeslagen emoji-huidtinten blijven behouden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把所有設定還原成預設。你的自定義主題和儲存的表情膚色都會留著。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca wszystkie ustawienia do wartości domyślnych. Twoje niestandardowe motywy i zapisane odcienie skóry emoji zostaną zachowane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлює всі налаштування за замовчуванням. Ваші власні теми та збережені відтінки шкіри емодзі зберігаються."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ayarı varsayılana geri yükler. Özel temalarınız ve kayıtlı emoji cilt tonlarınız korunur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoví všechna nastavení na výchozí. Vaše vlastní motivy a uložené tóny pleti emodži zůstanou zachovány."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoví všetky nastavenia na predvolené hodnoty. Vaše vlastné motívy a uložené tóny pleti emodži sa zachovajú."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφέρει κάθε ρύθμιση στην προεπιλογή. Τα προσαρμοσμένα θέματα και οι αποθηκευμένοι τόνοι δέρματος emoji διατηρούνται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställer alla inställningar till standardinställningar. Dina anpassade teman och sparade emoji-hudtoner bevaras."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendanner alle indstillinger til standard. Dine brugerdefinerede temaer og gemte emoji-hudfarver bevares."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenoppretter alle innstillinger til standard. Dine egendefinerte temaer og lagrede emoji-hudfarger beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palauttaa kaikki oletusasetukset. Mukautetut teemasi ja tallennetut emoji-ihonvärit säilyvät."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengembalikan setiap pengaturan ke default. Tema khusus dan warna kulit emoji yang disimpan akan disimpan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục mọi cài đặt về mặc định. Các chủ đề tùy chỉnh và tông màu da biểu tượng cảm xúc đã lưu của bạn sẽ được giữ lại."
          }
        }
      }
    },
    "Restores hitbox size, cursor scroll sensitivity, and all physics values. Other settings are untouched.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel trefboksgrootte, wyserrol-sensitiwiteit en alle fisikawaardes. Ander instellings is onaangeraak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt Trefferflächengröße, Cursor-Scroll-Empfindlichkeit und alle Physikwerte wieder her. Andere Einstellungen bleiben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Devuelve el tamaño del área táctil, la sensibilidad del cursor y todos los valores de física a su estado original. El resto de ajustes se quedan igual."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taastab tabamustsooni suuruse, kursorikerimise tundlikkuse ja kõik füüsikaväärtused. Muid seadeid ei puudutata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remet la taille des zones de touche, la sensibilité du défilement au curseur et toutes les valeurs physiques par défaut. Le reste ne bouge pas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítja a gombok érzékelési méretét, a kurzorgörgetés érzékenységét és az összes fizikai értéket. A többi beállításhoz nem nyúl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riporta ai valori predefiniti la dimensione dell'area attiva, la sensibilità di scorrimento del cursore e tutti i valori fisici. Le altre impostazioni non le tocca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "当たり判定の大きさ、カーソルのスクロール感度、物理の値をすべて元に戻します。ほかの設定はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치 영역 크기, 커서 스크롤 감도, 모든 물리 값을 되돌려요. 다른 설정은 건드리지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Set semula saiz kotak sentuh, kepekaan tatal kursor, dan semua nilai fizik. Tetapan lain tak berubah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Repõe o tamanho da área de toque, a sensibilidade do cursor e todos os valores de física. As outras definições ficam na mesma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает размер зон нажатия, чувствительность прокрутки курсора и все параметры физики. Остальные настройки не затрагиваются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还原触控区大小、光标滑动灵敏度和所有物理参数。其他设置不动。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restabilește dimensiunea casetei de accesare, sensibilitatea derulării cursorului și toate valorile fizice. Alte setări sunt neatinse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelt de grootte van de hitbox, de scrollgevoeligheid van de cursor en alle natuurkundige waarden. Andere instellingen blijven onaangeroerd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原觸控區大小、游標滑動靈敏度和所有物理引數。其他設定不動。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca rozmiar pola trafienia, czułość przewijania kursora i wszystkie wartości fizyczne. Pozostałe ustawienia pozostają niezmienione."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлює розмір хітбокса, чутливість прокручування курсору та всі фізичні значення. Інші налаштування не змінюються."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitbox boyutunu, imleç kaydırma hassasiyetini ve tüm fizik değerlerini geri yükler. Diğer ayarlara dokunulmaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovuje velikost hitboxu, citlivost posouvání kurzoru a všechny fyzikální hodnoty. Ostatní nastavení zůstávají nedotčena."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovuje veľkosť hitboxu, citlivosť posúvania kurzora a všetky fyzikálne hodnoty. Ostatné nastavenia zostávajú nedotknuté."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφέρει το μέγεθος του πλαισίου επισκέψεων, την ευαισθησία κύλισης του δρομέα και όλες τις τιμές φυσικής. Άλλες ρυθμίσεις είναι ανέγγιχτες."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställer hitboxstorlek, markörens rullningskänslighet och alla fysikvärden. Övriga inställningar är orörda."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendanner hitbox-størrelsen, markørens rullefølsomhed og alle fysikværdier. Andre indstillinger er uberørte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenoppretter treffboksstørrelsen, markørens rullefølsomhet og alle fysikkverdier. Andre innstillinger er urørt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palauttaa hitboxin koon, kohdistimen vieritysherkkyyden ja kaikki fysiikan arvot. Muut asetukset ovat ennallaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengembalikan ukuran kotak hit, sensitivitas gulir kursor, dan semua nilai fisika. Pengaturan lainnya tidak tersentuh."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục kích thước hitbox, độ nhạy cuộn con trỏ và tất cả các giá trị vật lý. Các cài đặt khác không bị ảnh hưởng."
          }
        }
      }
    },
    "Restores no entrance animation.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel geen ingangsanimasie nie."
          }
