            "value": "Eksporter en profilsikkerhedskopi, eller slet appen for at slette appgruppen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksporter en profilsikkerhetskopi, eller slett appen for å slette appgruppen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
