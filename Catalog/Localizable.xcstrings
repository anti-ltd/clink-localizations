    "Type a different character while shift or caps-lock is on. Off just uppercases what this key types.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe otro carácter cuando Mayús o el bloqueo de mayúsculas están activos. Si se desactiva, solo convierte en mayúscula el carácter de la tecla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisit un autre caractère quand Maj ou le verrouillage des majuscules est actif. Sinon, met simplement le caractère de cette touche en majuscule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt bei aktiver Umschalt- oder Feststelltaste ein anderes Zeichen ein. Ist dies aus, wird nur der Großbuchstabe der Taste eingegeben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita un carattere diverso con Maiusc o Bloc Maiusc attivo. Se disattivato, rende maiuscolo il carattere normale del tasto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve um caráter diferente quando Shift ou Caps Lock está ativo. Se desligado, apenas escreve a maiúscula do caráter normal da tecla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводит другой символ при включённом Shift или Caps Lock. Если выключено, вводит обычный символ клавиши в верхнем регистре."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip aksara berbeza apabila Shift atau Caps Lock dihidupkan. Jika dimatikan, hanya huruf besar bagi aksara asal akan ditaip."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Másik karaktert ír be bekapcsolt Shift vagy Caps Lock mellett. Kikapcsolva csak a billentyű szokásos karakterének nagybetűjét írja be."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ShiftやCaps Lockがオンのときに別の文字を入力します。オフの場合は、通常の文字を大文字にするだけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 或大写锁定开启时输入不同的字符。关闭后只会将此键原本输入的字符变为大写。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 또는 Caps Lock이 켜져 있을 때 다른 문자를 입력합니다. 꺼져 있으면 기본 문자를 대문자로만 바꿉니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisestab teise märgi, kui Shift või Caps Lock on sees. Väljalülitatult sisestab ainult tavapärase märgi suurtähe."
          }
        }
      }
    },
    "Type a few letters, get the whole thing.": {
