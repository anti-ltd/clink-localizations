          }
        }
      }
    },
    "Both default to the live theme, so the backdrop still looks like the keyboard it sits behind, and follows along when you switch theme.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Albei is standaard op die lewendige tema, so die agtergrond lyk steeds soos die sleutelbord waaragter dit sit, en volg saam wanneer jy van tema verander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide richten sich standardmäßig nach dem aktuellen Design, damit der Hintergrund zur Tastatur davor passt — und beim Designwechsel mitzieht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos siguen por defecto al tema activo, así el fondo sigue pareciéndose al teclado que tiene delante, y cambia con él."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mõlemad vaikimisi teema järgi, nii et taust näeb ikka välja nagu klaviatuur, mille taga ta asub, ja järgneb teema vahetamisel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux suivent par défaut le thème actif : le fond ressemble toujours au clavier qu'il accompagne, et change avec lui."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindkettő alapból az aktuális témát követi, így a háttér továbbra is illik az előtte lévő billentyűzethez — és témaváltáskor vele változik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambi seguono per impostazione predefinita il tema attivo, così lo sfondo somiglia ancora alla tastiera che ha davanti e cambia con lei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらも既定では現在のテーマに従うので、背景は手前のキーボードになじみ、テーマを変えれば一緒に変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다 기본적으로 현재 테마를 따르므로 배경이 앞의 키보드와 어울리고, 테마를 바꾸면 함께 바뀝니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua-duanya mengikut tema semasa secara lalai, jadi latar tetap sepadan dengan papan kekunci di hadapannya dan berubah bersamanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos seguem por omissão o tema ativo, por isso o fundo continua a parecer-se com o teclado à frente — e muda com ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию оба берут текущую тему, поэтому задний план выглядит заодно с клавиатурой перед ним — и меняется вместе с темой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两者默认跟随当前主题，所以背景始终配得上前面的键盘，换主题时也跟着变。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambele au în mod implicit tema live, așa că fundalul arată în continuare ca tastatura în spatele în care se află și urmează atunci când schimbați tema."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide gebruiken standaard het live-thema, dus de achtergrond ziet er nog steeds uit als het toetsenbord waar hij achter zit en volgt als je van thema verandert."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩者預設跟隨當前主題，所以背景始終配得上前面的鍵盤，換主題時也跟著變。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obydwa domyślnie korzystają z motywu aktywnego, więc tło nadal wygląda jak klawiatura, za którą się znajduje, i podąża za nim po zmianie motywu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В обох за замовчуванням використовується жива тема, тому фон усе ще виглядає як клавіатура, за якою він розташований, і повторюється, коли ви змінюєте тему."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ikisi de varsayılan olarak canlı temayı kullanır, böylece arka plan hala arkasında bulunduğu klavye gibi görünür ve temayı değiştirdiğinizde onu takip eder."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oba jsou výchozí pro živé téma, takže pozadí stále vypadá jako klávesnice, za kterou sedí, a následuje, když přepnete téma."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obe sú predvolené pre živú tému, takže pozadie stále vyzerá ako klávesnica, za ktorou je umiestnená, a nasleduje po prepnutí témy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Και τα δύο είναι προεπιλεγμένα στο ζωντανό θέμα, έτσι ώστε το φόντο να εξακολουθεί να μοιάζει με το πληκτρολόγιο που βρίσκεται πίσω του και να ακολουθεί κατά την εναλλαγή του θέματος."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Båda har som standard livetemat, så bakgrunden ser fortfarande ut som tangentbordet den sitter bakom och följer med när du byter tema."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge er standard til live-temaet, så baggrunden stadig ligner det tastatur, den sidder bagved, og følger med, når du skifter tema."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge er standard til live-temaet, så bakteppet ser fortsatt ut som tastaturet det sitter bak, og følger med når du bytter tema."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Molemmat ovat oletuksena live-teemaa, joten tausta näyttää edelleen näppäimistöltä, jonka takana se istuu, ja seuraa mukana, kun vaihdat teemaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keduanya default untuk tema langsung, sehingga latar belakangnya tetap terlihat seperti keyboard yang ada di belakangnya, dan mengikuti saat Anda mengganti tema."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả hai đều được mặc định sử dụng chủ đề trực tiếp nên phông nền vẫn trông giống như bàn phím nằm phía sau và theo sau khi bạn chuyển đổi chủ đề."
          }
        }
      }
    },
    "Both speeds are in Gestures, under Key repeat.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Albei snelhede is in Gebare, onder Sleutelherhaling."
