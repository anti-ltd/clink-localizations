    "Open Stability and tap Share report.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak Stabiliteit oop en tik Deel verslag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne „Stabilität“ und tippe auf „Bericht teilen“."
