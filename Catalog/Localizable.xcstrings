    "Just for you. Clink never reads these.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Net vir jou. Clink lees nooit hierdie nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für dich. Clink liest das nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para ti. Clink nunca lee esto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainult sinule. Clink ei loe neid kunagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour toi seul. Clink ne lit jamais ces notes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak neked. A Clink sosem olvassa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per te. Clink non le legge mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた用のメモです。Clink が読むことはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인용 메모입니다. Clink는 읽지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk anda sahaja. Clink tidak pernah membacanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para ti. O Clink nunca lê isto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для вас. Clink их не читает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只给你自己看。Clink 从不读取。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar pentru tine. Clink nu le citește niciodată."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen voor jou. Clink leest deze nooit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只給你自己看。Clink 從不讀取。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko dla ciebie. Clink nigdy ich nie czyta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тільки для вас. Clink ніколи їх не читає."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece senin için. Clink bunları asla okumaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen pro tebe. Clink je nikdy nečte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Len pre teba. Clink ich nikdy nečíta."
          }
        },
        "el": {
          "stringUnit": {
