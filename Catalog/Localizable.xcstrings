    },
    "Your edits were discarded. You can still put them back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Änderungen wurden verworfen. Du kannst sie noch zurückholen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cambios se han descartado. Todavía puedes recuperarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes modifications ont été annulées. Tu peux encore les récupérer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módosításaid törlődtek. Még visszahozhatod őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue modifiche sono state scartate. Puoi ancora recuperarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は破棄されました。まだ元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항이 취소됐어요. 아직 되돌릴 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Suntingan anda telah dibuang. Anda masih boleh kembalikannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas alterações foram descartadas. Ainda podes repô-las."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши правки отменены. Их ещё можно вернуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的更改已被放弃，但还可以恢复回来。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu muudatused hüljati. Sa saad need siiski tagasi panna."
