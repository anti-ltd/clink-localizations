    "Choose the language Clink's own screens are shown in. This is separate from the languages you type in, and it stays put when you switch profiles or import a config.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Sprache, in der Clinks eigene Bildschirme erscheinen. Sie ist unabhängig von den Sprachen, in denen du tippst, und bleibt, wenn du Profile wechselst oder eine Konfiguration importierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el idioma en el que se muestran las pantallas de Clink. Es independiente de los idiomas en los que escribes y no cambia al cambiar de perfil ni al importar una configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis la langue des écrans de Clink. Elle est indépendante des langues dans lesquelles tu tapes et ne bouge pas quand tu changes de profil ou importes une configuration."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki, milyen nyelven jelenjenek meg a Clink saját képernyői. Ez független attól, milyen nyelveken írsz, és profilváltáskor vagy konfiguráció importálásakor sem változik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la lingua in cui vengono mostrate le schermate di Clink. È indipendente dalle lingue in cui scrivi e non cambia quando passi a un altro profilo o importi una configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink の画面を表示する言語を選びます。入力する言語とは別で、プロファイルを切り替えても設定を読み込んでもそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 화면을 표시할 언어를 고릅니다. 입력하는 언어와는 별개이며, 프로필을 바꾸거나 설정을 가져와도 그대로 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih bahasa untuk skrin Clink sendiri. Ia berasingan daripada bahasa yang anda taip, dan kekal apabila anda tukar profil atau import konfigurasi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe o idioma em que os ecrãs do Clink aparecem. É independente dos idiomas em que escreves e mantém-se quando mudas de perfil ou importas uma configuração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите язык, на котором показаны экраны самого Clink. Это не связано с языками, на которых вы печатаете, и не меняется при смене профиля или импорте конфигурации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Clink 自身界面使用的语言。它和你输入的语言无关，切换配置文件或导入配置时也不会变。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali keel, milles kuvatakse Clinki enda ekraanid. See on eraldiseisev keeltest, milles sa tipid, ja jääb samaks, kui vahetad profiili või impordid seadistuse."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies die taal waarin Clink se eie skerms gewys word. Dit is apart van die tale wat jy intik, en dit bly staan ​​wanneer jy van profiele verander of 'n konfigurasie invoer."
          }
        }
      }
    },
    "Choose the language Clink's own screens are shown in. This is separate from the typing languages below, and it stays put when you switch profiles or import a config.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl die Sprache, in der dir die Clink-Bildschirme angezeigt werden. Die ist von den Eingabesprachen unten getrennt und bleibt, wenn du das Profil wechselst oder eine Konfiguration importierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el idioma en el que ves las pantallas de Clink. Es aparte de los idiomas de escritura de abajo, y no cambia aunque cambies de perfil o importes una configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis la langue dans laquelle s'affichent les écrans de Clink. C'est à part des langues de saisie ci-dessous, et ce réglage ne bouge pas quand tu changes de profil ou importes une config."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki, milyen nyelven jelenjenek meg a Clink saját képernyői. Ez független az alábbi gépelési nyelvektől, és a helyén marad, ha profilt váltasz vagy beállítást importálsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la lingua delle schermate di Clink. È diversa dalle lingue di digitazione qui sotto e non cambia quando passi da un profilo all'altro o importi una configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink自体の画面を表示する言語を選びます。下の入力言語とは別の設定で、プロファイルを切り替えたり設定を読み込んだりしても変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 화면을 어떤 언어로 볼지 골라요. 아래 입력 언어와는 따로예요. 프로필을 바꾸거나 설정을 가져와도 그대로 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih bahasa untuk skrin Clink sendiri. Ini lain daripada bahasa menaip di bawah, dan ia kekal walaupun anda tukar profil atau import konfig."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe o idioma em que aparecem os ecrãs do Clink. É independente dos idiomas de escrita abaixo e mantém-se quando trocas de perfil ou importas uma configuração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите язык, на котором показаны экраны самого Clink. Это не связано с языками печати ниже и не меняется при смене профиля или импорте конфигурации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选 Clink 自己界面用的语言。这跟下面的输入语言是两回事，你切换配置或导入设置时它也不会变。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali keel, milles Clinki ekraane näidatakse. See on allpool olevatest sisestuskeeltest eraldi ja jääb samaks, kui vahetad profiili või impordid seadistuse."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies die taal waarin Clink se eie skerms gewys word. Dit is apart van die tiktale hieronder, en dit bly staan ​​wanneer jy van profiele verander of 'n konfigurasie invoer."
          }
        }
      }
    },
    "Choose whether your clipboard travels too.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entscheide, ob die Zwischenablage mitreisen soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide si el portapapeles viaja también."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décide si le presse-papiers voyage aussi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Döntsd el, hogy a vágólap is utazzon-e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidi se far viaggiare anche gli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードも一緒に同期するかどうかを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드도 함께 옮길지 고르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih sama ada papan keratan anda turut serta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide se a área de transferência também vai."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решите, поедет ли с ними буфер обмена."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决定剪贴板要不要一起同步。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsusta, kas sinu lõikelaud reisib samuti kaasa."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies of jou knipbord ook reis."
          }
        }
      }
    },
    "Choose which AI actions show in the keyboard's AI Tools panel, and drag to reorder them. Tap an action to edit its prompt.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl, welche KI-Aktionen im KI-Werkzeuge-Panel der Tastatur erscheinen, und zieh sie, um die Reihenfolge zu ändern. Tipp eine Aktion an, um ihren Prompt zu bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué acciones de IA aparecen en el panel de Herramientas de IA del teclado y arrástralas para reordenarlas. Toca una acción para editar su instrucción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis les actions IA affichées dans le panneau Outils IA du clavier, et glisse pour les réorganiser. Touche une action pour modifier son invite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki, mely MI-műveletek jelenjenek meg a billentyűzet MI-eszközök paneljén, és húzd őket a helyükre. Koppints egy műveletre, ha szerkesztenéd a promptját."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quali azioni AI mostrare nel pannello Strumenti AI della tastiera e trascinale per riordinarle. Tocca un’azione per modificarne il prompt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードのAIツールパネルに出すAIアクションを選んで、ドラッグで並べ替えられます。アクションをタップするとプロンプトを編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드의 AI 도구 패널에 어떤 AI 동작을 보여줄지 고르고, 드래그해서 순서를 바꿔보세요. 동작을 탭하면 프롬프트를 고칠 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tindakan AI yang nak dipapar dalam panel Alat AI papan kekunci, dan seret untuk susun semula. Ketik tindakan untuk edit gesaannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe que ações de IA aparecem no painel de Ferramentas de IA do teclado e arrasta para as reordenar. Toca numa ação para editar o comando dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, какие действия ИИ показывать в панели «Инструменты ИИ», и перетаскиванием задайте порядок. Нажмите на действие, чтобы изменить его запрос."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑一挑哪些 AI 操作显示在键盘的「AI 工具」面板里，拖动就能重新排序。点一下某个操作，就能改它的提示词。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali, millised TI-toimingud kuvatakse klaviatuuri TI-tööriistade paneelil, ja lohista järjestuse muutmiseks. Puuduta toimingut, et muuta selle juhist."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies watter KI-aksies in die sleutelbord se KI-nutsgoedpaneel wys, en sleep om hulle te herrangskik. Tik 'n handeling om die aanporboodskap te wysig."
          }
        }
      }
    },
    "Choose which AI actions show in the panel. Tap one to edit its prompt, tap its check to switch it off, or hold and drag to reorder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, welche KI-Aktionen im Panel erscheinen. Tippe eine an, um ihren Prompt zu bearbeiten, tippe auf ihr Häkchen, um sie auszuschalten, oder halte und ziehe zum Umsortieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué acciones de IA aparecen en el panel. Toca una para editar su prompt, toca su marca para desactivarla, o mantén pulsado y arrastra para reordenar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis quelles actions IA apparaissent dans le panneau. Touche-en une pour modifier son prompt, touche sa coche pour la désactiver, ou maintiens et fais glisser pour réordonner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki, mely AI-műveletek jelenjenek meg a panelen. Koppints egyre a promptja szerkesztéséhez, a pipájára a kikapcsoláshoz, vagy tartsd lenyomva és húzd az átrendezéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quali azioni IA compaiono nel pannello. Tocca un'azione per modificarne il prompt, tocca il segno di spunta per disattivarla, oppure tieni premuto e trascina per riordinare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルに表示するAIアクションを選びます。タップでプロンプトを編集、チェックマークをタップでオフ、長押ししてドラッグで並べ替えできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널에 보여줄 AI 액션을 골라보세요. 탭하면 프롬프트를 수정하고, 체크 표시를 탭하면 끄고, 꾹 눌러서 드래그하면 순서를 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tindakan AI yang dipaparkan dalam panel. Ketik satu untuk edit gesaannya, ketik tanda semaknya untuk matikan, atau tahan dan seret untuk susun semula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe quais ações de IA aparecem no painel. Toca numa para editar o prompt, toca no visto para a desligar, ou mantém premido e arrasta para reordenar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, какие действия ИИ показывать в панели. Нажмите на действие, чтобы изменить запрос, нажмите на галочку, чтобы выключить, или удерживайте и перетащите, чтобы изменить порядок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择面板里显示哪些 AI 操作。点一下可以编辑提示词，点勾选可以关掉，按住拖动可以调整顺序。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali, millised TI-toimingud paneelil kuvatakse. Puuduta, et juhist muuta, puuduta linnukest, et välja lülitada, või hoia ja lohista järjestamiseks."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies watter KI-aksies in die paneel wys. Tik een om sy opdrag te wysig, tik sy tjek om dit af te skakel, of hou en sleep om te herrangskik."
          }
        }
      }
    },
    "Choose which profiles it lists, and in what order.": {
      "extractionState": "manual",
