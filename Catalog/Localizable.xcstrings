    "Finishes the word you're typing using context. AI picks show a ✨ in the suggestion bar.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooi die woord wat jy tik deur konteks te gebruik. KI-keuse wys 'n ✨ in die voorstelbalk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt das Wort, das du gerade tippst, mit Hilfe des Kontexts zu Ende. KI-Vorschläge zeigen ein ✨ in der Vorschlagsleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la palabra que estás escribiendo usando el contexto. Las sugerencias de IA llevan un ✨ en la barra de sugerencias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lõpetab konteksti põhjal sõna, mida tipid. TI-valikud näitavad soovituseribal ✨."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Complète le mot que tu es en train de taper à partir du contexte. Les suggestions de l'IA affichent un ✨ dans la barre de suggestions."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Befejezi a szót, amit épp gépelsz, a szövegkörnyezet alapján. Az MI-találatok mellett ✨ jelenik meg a javaslatsávban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa la parola che stai scrivendo usando il contesto. I suggerimenti dell'IA mostrano un ✨ nella barra dei suggerimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文脈を使って、入力中の単語を補完します。AI が選んだ候補には候補バーに ✨ が付きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문맥을 써서 치고 있는 단어를 완성해줘요. AI가 고른 건 추천 바에 ✨가 붙어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Melengkapkan perkataan yang anda tengah taip guna konteks. Pilihan AI ada ✨ dalam bar cadangan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acaba a palavra que estás a escrever a partir do contexto. As escolhas de IA mostram um ✨ na barra de sugestões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дописывает слово, которое вы печатаете, опираясь на контекст. Варианты от ИИ отмечены значком ✨ в строке подсказок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据上下文帮你把正在打的词补完。AI 给的候选会在建议栏里带个 ✨。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Termină cuvântul pe care îl tastați folosind context. Alegerile AI arată un ✨ în bara de sugestii."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt het woord dat u typt af met behulp van context. AI-keuzes tonen een ✨ in de suggestiebalk."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據上下文幫你把正在打的詞補完。AI 給的候選會在建議欄裡帶個 ✨。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kończy wpisywane słowo, korzystając z kontekstu. Wybrane przez AI wyświetlają ✨ na pasku sugestii."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершує слово, яке ви вводите, використовуючи контекст. Вибір AI показує ✨ на панелі пропозицій."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlamı kullanarak yazdığınız kelimeyi bitirir. AI seçimleri öneri çubuğunda bir ✨ işareti gösterir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokončí slovo, které píšete, pomocí kontextu. Výběr AI zobrazuje na liště návrhů ✨."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokončí slovo, ktoré píšete, pomocou kontextu. Výber AI zobrazuje ✨ na paneli návrhov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ολοκληρώνει τη λέξη που πληκτρολογείτε χρησιμοποιώντας το πλαίσιο. Οι επιλογές AI εμφανίζουν ένα ✨ στη γραμμή προτάσεων."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutar ordet du skriver med kontext. AI-val visar ett ✨ i förslagsfältet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afslutter det ord, du skriver, ved hjælp af kontekst. AI-valg viser et ✨ i forslagslinjen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fullfører ordet du skriver med kontekst. AI-valg viser en ✨ i forslagslinjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeistelee kirjoittamasi sanan kontekstin avulla. Tekoälyvalinnat näyttävät ✨ ehdotuspalkissa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyelesaikan kata yang Anda ketikkan menggunakan konteks. Pilihan AI menampilkan ✨ di bilah saran."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết thúc từ bạn đang gõ bằng ngữ cảnh. Các lựa chọn của AI hiển thị ✨ trên thanh gợi ý."
          }
        }
      }
    },
