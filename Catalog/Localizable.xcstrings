    "Two columns of cards — the whole panel at a glance.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos columnas de tarjetas para ver todo el panel de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux colonnes de cartes pour voir tout le panneau d’un coup d’œil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Kartenspalten – das ganze Panel auf einen Blick."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due colonne di schede per vedere tutto il pannello a colpo d’occhio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas colunas de cartões para ver todo o painel de relance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два столбца карточек — вся панель как на ладони."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua lajur kad untuk melihat seluruh panel sepintas lalu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Két kártyaoszlop, így az egész panel egy pillantással áttekinthető."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードを2列に並べ、パネル全体をひと目で確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双列卡片布局，整个面板一目了然。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드를 두 열로 배치해 패널 전체를 한눈에 볼 수 있습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaks kaardiveergu – kogu paneel ühe pilguga."
          }
        }
      }
    },
    "Two columns, each card as tall as its clip. Tap one to paste.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twee kolomme, elke kaart so lank soos sy clip. Tik een om te plak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Spalten, jede Karte so hoch wie ihr Clip. Tippe einen zum Einfügen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos columnas, cada tarjeta tan alta como su clip: toca uno para pegar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaks veergu, iga kaart sama kõrge kui oma klipp. Puuduta üht, et kleepida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux colonnes, chaque carte à la hauteur de son clip. Touche l'une d'elles pour coller."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Két oszlop, minden kártya akkora, mint a benne lévő elem. Koppints egyre a beillesztéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due colonne, ogni scheda alta quanto la sua clip: toccane una per incollare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2列に並び、カードの高さはクリップに合わせて伸びます。タップで貼り付け。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 열로 놓이고 카드 높이는 클립 길이에 맞춰져요. 하나를 탭하면 붙여넣기돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua lajur, setiap kad setinggi klipnya. Ketik satu untuk tampal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas colunas, cada cartão tão alto quanto o seu clip. Toque num para colar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Две колонки, высота карточки равна её фрагменту. Нажмите на любую, чтобы вставить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分成两列，卡片高度随剪贴内容伸展，点按其中一条即可粘贴。"
          }
        }
      }
    },
    "Two taps and it works in every app.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twee krane en dit werk in elke toepassing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweimal tippen und es funktioniert in jeder App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos toques y funcionará en todas las apps."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaks puudutust ja see töötab igas rakenduses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux gestes et il fonctionne dans toutes les apps."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Két koppintás, és minden appban működik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due tocchi e funziona in tutte le app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2回タップするだけで、すべてのアプリで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번만 탭하면 모든 앱에서 사용할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua ketikan dan ia berfungsi dalam semua app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois toques e funciona em todas as apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два касания — и работает в каждом приложении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点两次，即可在所有 App 中使用。"
          }
        }
      }
    },
