    "Translate can use Apple's on-device AI. Your text is not sent to us.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzen kann Apples KI direkt auf dem Gerät nutzen. Dein Text wird nicht an uns geschickt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducir puede usar la IA de Apple en el dispositivo. Tu texto no llega hasta nosotros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduire peut utiliser l'IA sur l'appareil d'Apple. Ton texte ne nous est pas envoyé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Fordítás használhatja az Apple eszközön futó MI-jét. A szöveged nem jut el hozzánk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduci può usare l'IA di Apple sul dispositivo. Il tuo testo non ci viene inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳は Apple の端末内 AI を使えます。テキストがこちらに送られることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역은 Apple 온디바이스 AI를 쓸 수 있어요. 입력한 글은 저희한테 보내지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemah boleh guna AI pada peranti Apple. Teks anda tidak dihantar kepada kami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Traduzir pode usar a IA no dispositivo da Apple. O teu texto não nos é enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод может использовать ИИ Apple на устройстве. Ваш текст нам не отправляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译可以用 Apple 设备端 AI。你的文字不会发给我们。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlke võib kasutada Apple’i seadmesisest TI-d. Sinu teksti ei saadeta meile."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Translate kan Apple se KI op die toestel gebruik. Jou teks word nie aan ons gestuur nie."
          }
        }
      }
    },
