    "Choose the language Clink's own screens are shown in. This is separate from the languages you type in, and it stays put when you switch profiles or import a config.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies die taal waarin Clink se eie skerms gewys word. Dit is apart van die tale wat jy intik, en dit bly staan ​​wanneer jy van profiele verander of 'n konfigurasie invoer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Sprache, in der Clinks eigene Bildschirme erscheinen. Sie ist unabhängig von den Sprachen, in denen du tippst, und bleibt, wenn du Profile wechselst oder eine Konfiguration importierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el idioma en el que se muestran las pantallas de Clink. Es independiente de los idiomas en los que escribes y no cambia al cambiar de perfil ni al importar una configuración."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali keel, milles kuvatakse Clinki enda ekraanid. See on eraldiseisev keeltest, milles sa tipid, ja jääb samaks, kui vahetad profiili või impordid seadistuse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis la langue des écrans de Clink. Elle est indépendante des langues dans lesquelles tu tapes et ne bouge pas quand tu changes de profil ou importes une configuration."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki, milyen nyelven jelenjenek meg a Clink saját képernyői. Ez független attól, milyen nyelveken írsz, és profilváltáskor vagy konfiguráció importálásakor sem változik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la lingua in cui vengono mostrate le schermate di Clink. È indipendente dalle lingue in cui scrivi e non cambia quando passi a un altro profilo o importi una configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink の画面を表示する言語を選びます。入力する言語とは別で、プロファイルを切り替えても設定を読み込んでもそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 화면을 표시할 언어를 고릅니다. 입력하는 언어와는 별개이며, 프로필을 바꾸거나 설정을 가져와도 그대로 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih bahasa untuk skrin Clink sendiri. Ia berasingan daripada bahasa yang anda taip, dan kekal apabila anda tukar profil atau import konfigurasi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe o idioma em que os ecrãs do Clink aparecem. É independente dos idiomas em que escreves e mantém-se quando mudas de perfil ou importas uma configuração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите язык, на котором показаны экраны самого Clink. Это не связано с языками, на которых вы печатаете, и не меняется при смене профиля или импорте конфигурации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Clink 自身界面使用的语言。它和你输入的语言无关，切换配置文件或导入配置时也不会变。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți limba în care sunt afișate propriile ecrane ale lui Clink. Aceasta este separată de limbile în care introduceți și rămâne în poziție atunci când schimbați profilurile sau importați o configurație."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de taal waarin de schermen van Clink worden weergegeven. Dit staat los van de talen waarin u typt, en blijft staan wanneer u van profiel wisselt of een configuratie importeert."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 Clink 自身介面使用的語言。它和你輸入的語言無關，切換配置檔案或匯入配置時也不會變。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz język, w jakim wyświetlane są ekrany Clink. Jest on niezależny od języków, w których piszesz i pozostaje niezmieniony, gdy przełączasz profile lub importujesz konfigurację."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть мову, якою відображатимуться власні екрани Clink. Вона не залежить від мов, якими ви вводите текст, і залишається на місці, коли ви змінюєте профілі або імпортуєте конфігурацію."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink'in kendi ekranlarının görüntüleneceği dili seçin. Bu, yazdığınız dillerden farklıdır ve profilleri değiştirdiğinizde veya bir yapılandırmayı içe aktardığınızda olduğu gibi kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte jazyk, ve kterém se zobrazují vlastní obrazovky Clink. Toto je oddělené od jazyků, které zadáváte, a zůstane zachováno, když přepnete profily nebo importujete konfiguraci."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte jazyk, v ktorom sa zobrazujú vlastné obrazovky Clink. Toto je oddelené od jazykov, ktoré zadávate, a zostane zachované, keď prepnete profily alebo importujete konfiguráciu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τη γλώσσα στην οποία εμφανίζονται οι οθόνες του Clink. Αυτό είναι ξεχωριστό από τις γλώσσες που πληκτρολογείτε και παραμένει τοποθετημένο όταν αλλάζετε προφίλ ή εισάγετε μια διαμόρφωση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj språk Clink:s egna skärmar visas i. Detta är separat från de språk du skriver i, och det förblir kvar när du byter profil eller importerar en konfiguration."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg det sprog Clink's egne skærmbilleder vises i. Dette er adskilt fra de sprog, du indtaster, og det forbliver, når du skifter profil eller importerer en konfiguration."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg språket Clink sine egne skjermer vises i. Dette er atskilt fra språkene du skriver inn, og det blir stående når du bytter profil eller importerer en konfig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kieli, jolla Clink:n omat näytöt näytetään. Tämä on erillinen kirjoittamistasi kielistä, ja se pysyy paikallaan, kun vaihdat profiilia tai tuot asetuksia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih bahasa yang digunakan untuk menampilkan layar Clink. Bahasa ini terpisah dari bahasa yang Anda ketik, dan tetap digunakan saat Anda berpindah profil atau mengimpor konfigurasi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ngôn ngữ mà màn hình riêng của Clink sẽ hiển thị. Ngôn ngữ này tách biệt với ngôn ngữ bạn nhập và nó vẫn được đặt khi bạn chuyển cấu hình hoặc nhập cấu hình."
          }
        }
      }
    },
