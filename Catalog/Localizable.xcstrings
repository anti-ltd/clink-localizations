    "Drop the space before commas and periods (“there ,” → “there,”).": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Los die spasie voor kommas en punte (\"daar,\" → \"daar\")."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt das Leerzeichen vor Kommas und Punkten (“there ,” → “there,”)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita el espacio antes de comas y puntos (“there ,” → “there,”)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemalda tühik koma ja punkti eest („seal ,\" → „seal,\")."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime l'espace avant les virgules et les points (« there , » → « there, »)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elhagyja a szóközt a vessző és a pont elől („there ,” → „there,”)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toglie lo spazio prima di virgole e punti (“there ,” → “there,”)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カンマやピリオドの前のスペースを取り除きます（「there ,」→「there,」）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉼표와 마침표 앞의 공백을 없애요 (“there ,” → “there,”)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buang ruang sebelum koma dan noktah (“there ,” → “there,”)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira o espaço antes das vírgulas e dos pontos (“there ,” → “there,”)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убирать пробел перед запятой и точкой («там ,» → «там,»)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉逗号和句号前的空格（“there ,” → “there,”）。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aruncă spațiul înainte de virgule și puncte („acolo,” → „acolo”)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de spatie vóór komma's en punten vallen (\"daar\", → \"daar\")."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉逗號和句號前的空格（“there ,” → “there,”）。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń spację przed przecinkami i kropkami („tam”, → „tam”)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити пробіл перед комами та крапками («там», → «там»)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Virgül ve noktalardan önceki boşluğu bırakın (“orada” → “orada”)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vynechejte mezeru před čárkami a tečkami („tam“, → „tam“)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vynechajte medzeru pred čiarkami a bodkami („tam“ → „tam“)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε το διάστημα πριν από κόμματα και τελείες (\"εκεί \", → \"εκεί\")."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp utrymmet före kommatecken och punkter (\"där ,\" → \"där\")."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip mellemrummet før kommaer og punktum (\"der ,\" → \"der\")."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slipp mellomrommet før komma og punktum (\"der ,\" → \"der\")."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pudota välilyönti ennen pilkkuja ja pisteitä (\"siellä ,\" → \"siellä\")."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilangkan spasi sebelum koma dan titik (“di sana,” → “di sana,”)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ dấu cách trước dấu phẩy và dấu chấm (“there ,” → “there”)."
          }
        }
      }
    },
    "Drops Liquid Glass and glow to a flat look when the device is low on battery or running hot. Off keeps the full glass look.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat vloeibare glas val en gloei tot 'n plat voorkoms wanneer die toestel min battery het of warm is. Af hou die vol glas voorkoms."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet Liquid Glass und das Leuchten auf eine flache Optik um, wenn der Akku schwach wird oder das Gerät heiß läuft. Aus behält die volle Glasoptik."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja Liquid Glass y el brillo a un aspecto plano cuando al dispositivo le queda poca batería o se calienta. Si lo apagas, mantiene el aspecto de cristal completo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülitab Liquid Glass ja sära lameda ilme peale, kui seadme aku on nõrk või see läheb kuumaks. Väljas hoiab täieliku klaasilme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe Liquid Glass et la lueur à un rendu plat quand la batterie est faible ou que l'appareil chauffe. Désactivé, tu gardes le rendu verre complet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sima megjelenésre vált a Liquid Glassről és a fényről, ha lemerülőben van vagy felmelegszik a készülék. Kikapcsolva marad a teljes üveghatás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toglie Liquid Glass e il bagliore per un aspetto piatto quando il dispositivo ha poca batteria o scotta. Se lo disattivi, resta il vetro completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーが少ないときや本体が熱くなったときに、Liquid Glass とグローをフラットな見た目に切り替えます。オフにすると、ガラスの見た目をそのまま保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 배터리가 부족하거나 뜨거워지면 Liquid Glass와 광택을 평면 느낌으로 낮춰요. 끄면 유리 느낌을 그대로 둬요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Turunkan Liquid Glass dan cahaya ke rupa rata bila bateri peranti rendah atau ia jadi panas. Kalau matikan, rupa kaca penuh kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa o Liquid Glass e o brilho para um aspeto plano quando o dispositivo tem pouca bateria ou aquece. Desligado, mantém o aspeto de vidro completo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переходит с Liquid Glass и свечения на плоский вид, когда заряд низкий или устройство греется. Выключено — стекло остаётся во всей красе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备电量低或发烫时，把 Liquid Glass 和光晕降成扁平外观。关闭就一直保持完整的玻璃质感。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Picături de sticlă lichidă și strălucește la un aspect plat atunci când dispozitivul este descărcat de baterie sau este fierbinte. Off păstrează aspectul de sticlă plină."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druppelt Liquid Glass en gloeit op tot een vlak uiterlijk wanneer de batterij van het apparaat bijna leeg is of heet wordt. Off behoudt de volledig glazen look."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置電量低或發燙時，把 Liquid Glass 和光暈降成扁平外觀。關閉就一直保持完整的玻璃質感。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upuszcza płynne szkło i świeci, nadając mu płaski wygląd, gdy urządzenie ma niski poziom naładowania baterii lub jest gorące. Opcja Wyłącz pozwala zachować wygląd pełnego szkła."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Капає рідке скло і світиться до плоского вигляду, коли пристрій розряджається або працює гарячим. Off зберігає повний скляний вигляд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazın pili azaldığında veya ısındığında Liquid Glass'ı düşürür ve düz bir görünüme kavuşur. Kapalı, tam cam görünümünü korur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapky tekutého skla a září do plochého vzhledu, když má zařízení málo baterie nebo je horké. Vypnuto zachovává vzhled celého skla."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď má zariadenie takmer vybitú batériu alebo je horúce, kvapká tekuté sklo a žiari do plochého vzhľadu. Vypnuté zachováva vzhľad celého skla."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μειώνει το Liquid Glass και λάμπει σε επίπεδη εμφάνιση όταν η μπαταρία της συσκευής είναι χαμηλή ή είναι ζεστή. Το Off διατηρεί την πλήρη γυάλινη εμφάνιση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tappar flytande glas och lyser till ett platt utseende när enheten har låg batterinivå eller är varm. Off håller hela glaslooken."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropper Liquid Glass og glød til et fladt udseende, når enheden er ved at løbe tør for batteri eller kører varm. Off holder det fulde glasudseende."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropper flytende glass og glød til et flatt utseende når enheten har lite batteri eller er varm. Off beholder det fulle glassutseendet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pudottaa nestemäisen lasin ja hehkuu tasaiseksi, kun laitteen akku on vähissä tai se on kuuma. Off säilyttää täyden lasin ilmeen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjatuhkan Kaca Cair dan bersinar hingga tampak datar saat baterai perangkat hampir habis atau dalam keadaan panas. Mati menjaga tampilan kaca penuh."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm rơi Kính lỏng và phát sáng phẳng khi thiết bị sắp hết pin hoặc nóng. Tắt giữ nguyên vẻ ngoài như kính."
          }
        }
      }
    },
