    "Sign in to iCloud to sync across your devices.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld by iCloud aan om oor jou toestelle te sinkroniseer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich bei iCloud an, um Ihre Geräte zu synchronisieren."
          }
        },
