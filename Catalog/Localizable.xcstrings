    "Touch target height for suggestion chips. Raise it if you often miss a tap.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Raak teikenhoogte vir voorstelskyfies. Lig dit op as jy dikwels 'n kraan mis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhe der Tippfläche für Vorschlags-Chips. Mach sie größer, wenn du oft danebentippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura de la zona táctil de las sugerencias. Súbela si fallas al tocar a menudo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soovituse kiipide puudutussihi kõrgus. Suurenda, kui sa tihti mööda lubad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauteur de la zone tactile des suggestions. Augmente-la si tu rates souvent un appui."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A javaslatchipek érintési magassága. Növeld, ha gyakran mellényúlsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altezza dell'area tattile dei suggerimenti. Alzala se sbagli spesso il tocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補チップのタッチ領域の高さです。タップをよく外すなら大きくしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천 칩의 터치 영역 높이예요. 자주 잘못 누르면 높여보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketinggian sasaran sentuh untuk cip cadangan. Naikkan jika anda kerap terlepas ketikan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura da zona de toque das sugestões. Aumenta-a se falhas o toque muitas vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высота зоны нажатия у плашек подсказок. Увеличьте, если часто промахиваетесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议条的点按区域高度。要是经常点不中，就调高一点。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți înălțimea țintei pentru jetoane de sugestie. Ridicați-l dacă pierdeți adesea o atingere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raak de doelhoogte aan voor suggestiechips. Verhoog hem als je vaak een tik mist."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建議條的點按區域高度。要是經常點不中，就調高一點。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij docelowej wysokości, aby wyświetlić sugestie. Podnieś go, jeśli często pomijasz dotknięcie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться цільової висоти для фішок пропозицій. Підніміть його, якщо ви часто пропускаєте натискання."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öneri çipleri için hedef yüksekliğe dokunun. Sık sık bir dokunuşu kaçırıyorsanız yükseltin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotkněte se cílové výšky pro žetony návrhů. Zvedněte ji, pokud často vynecháváte kohoutek."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknite sa cieľovej výšky pre žetóny návrhov. Zdvihnite ho, ak vám často chýba kohútik."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε το ύψος στόχου για μάρκες προτάσεων. Ανεβάστε το εάν χάνετε συχνά ένα πάτημα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på målhöjd för förslagsmarker. Höj den om du ofta missar en kran."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på målhøjde for forslagschips. Hæv den, hvis du ofte går glip af et tryk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Berør målhøyde for forslagsbrikker. Hev den hvis du ofte savner et trykk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosketa tavoitekorkeutta nähdäksesi ehdotusmerkit. Nosta sitä, jos unohdat usein kosketuksen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentuh ketinggian target untuk chip saran. Naikkan jika Anda sering melewatkan satu ketukan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào chiều cao mục tiêu để có khối gợi ý. Hãy nâng nó lên nếu bạn thường xuyên lỡ một lần nhấn."
          }
        }
      }
    },
    "Touch target size for each key relative to the visible key. Lower is more precise, higher catches more taps.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Raak teikengrootte vir elke sleutel relatief tot die sigbare sleutel. Laer is meer presies, hoër vang meer krane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch-Zielgröße jeder Taste im Verhältnis zur sichtbaren Taste. Niedriger ist präziser, höher fängt mehr Tippfehler ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño del objetivo táctil de cada tecla respecto a la tecla visible. Menor es más preciso, mayor capta más toques."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga klahvi puutepiirkond võrreldes nähtava klahviga. Väiksem on täpsem, suurem püüab rohkem puudutusi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille de la cible tactile de chaque touche par rapport à la touche visible. Plus bas est plus précis, plus haut capte plus de frappes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden billentyű érintési célterülete a látható billentyűhöz képest. Alacsonyabb pontosabb, magasabb több érintést fog meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensione del bersaglio tattile di ogni tasto rispetto al tasto visibile. Più basso è più preciso, più alto cattura più tocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見えているキーに対する各キーのタッチ判定領域のサイズ。小さいほど正確、大きいほどタップを拾いやすい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보이는 키 대비 각 키의 터치 영역 크기. 낮을수록 정밀하고 높을수록 더 많은 탭을 잡습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saiz sasaran sentuhan setiap kekunci berbanding kekunci yang kelihatan. Lebih rendah lebih tepat, lebih tinggi menangkap lebih banyak ketukan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho do alvo tátil de cada tecla em relação à tecla visível. Menor é mais preciso, maior capta mais toques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер области касания каждой клавиши относительно видимой клавиши. Меньше — точнее, больше — ловит больше нажатий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个按键的触摸目标大小相对于可见按键。较低更精确，较高能捕捉更多点击。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți dimensiunea țintă pentru fiecare tastă în raport cu cheia vizibilă. Mai jos este mai precis, mai mare prinde mai multe atingeri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanraakdoelgrootte voor elke toets relatief aan de zichtbare toets. Lager is nauwkeuriger, hoger vangt meer tikken op."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個按鍵的觸控目標大小相對於可見按鍵。較低更精確，較高能捕捉更多點選。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij docelowego rozmiaru każdego klawisza względem widocznego klawisza. Niższy oznacza większą precyzję, wyższy umożliwia wychwytywanie większej liczby uderzeń."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмір торкання для кожної клавіші відносно видимої клавіші. Нижчий – точніший, вищий – більше натискань."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünür tuşa göre her tuş için hedef boyuta dokunun. Daha düşük olan daha hassastır, daha yüksek olan daha fazla dokunuş yakalar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotkněte se cílové velikosti pro každou klávesu vzhledem k viditelné klávese. Nižší je přesnější, vyšší zachytí více klepnutí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknite sa cieľovej veľkosti každého tlačidla vzhľadom na viditeľné tlačidlo. Nižšie je presnejšie, vyššie zachytí viac klepnutí."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε το μέγεθος στόχου για κάθε κλειδί σε σχέση με το ορατό κλειδί. Το χαμηλότερο είναι πιο ακριβές, το υψηλότερο πιάνει περισσότερα χτυπήματα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på målstorlek för varje tangent i förhållande till den synliga tangenten. Lägre är mer exakt, högre fångar fler kranar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på målstørrelse for hver tast i forhold til den synlige tast. Lavere er mere præcist, højere fanger flere tryk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på målstørrelse for hver tast i forhold til den synlige nøkkelen. Lavere er mer presist, høyere fanger opp flere trykk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosketa kunkin näppäimen kohdekokoa suhteessa näkyvään näppäimeen. Alempi on tarkempi, korkeampi nappaa enemmän."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentuh ukuran target untuk setiap tombol relatif terhadap tombol yang terlihat. Lebih rendah lebih tepat, lebih tinggi menangkap lebih banyak ketukan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kích thước mục tiêu chạm vào cho mỗi phím tương ứng với phím hiển thị. Thấp hơn chính xác hơn, cao hơn bắt được nhiều vòi hơn."
          }
        }
      }
    },
    "Touch target size for the panel button. Raise it if you frequently miss it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Raak teikengrootte vir die paneelknoppie. Lig dit op as jy dit gereeld mis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größe der Tippfläche für die Bedienfeldtaste. Mach sie größer, wenn du sie oft verfehlst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño de la zona táctil del botón del panel. Súbelo si fallas al tocarlo a menudo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneelinupu puudutussihi suurus. Suurenda, kui sa teda tihti mööda lubad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille de la zone tactile du bouton du panneau. Augmente-la si tu le rates souvent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A panelgomb érintési mérete. Növeld, ha gyakran mellényúlsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensione dell'area tattile del pulsante del pannello. Alzala se lo sbagli spesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルボタンのタッチ領域の大きさです。よく外すなら大きくしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널 버튼의 터치 영역 크기예요. 자주 놓치면 높여보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saiz sasaran sentuh untuk butang panel. Naikkan jika anda kerap terlepas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho da zona de toque do botão do painel. Aumenta-o se falhas com frequência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер зоны нажатия у кнопки панелей. Увеличьте, если часто по ней промахиваетесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板按钮的点按区域大小。要是经常点不中，就调高一点。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți dimensiunea țintă pentru butonul panoului. Ridicați-l dacă îl ratați des."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de doelgrootte voor de paneelknop. Verhoog het als u het vaak mist."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面板按鈕的點按區域大小。要是經常點不中，就調高一點。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij docelowego rozmiaru przycisku panelu. Podnieś go, jeśli często go pomijasz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться цільового розміру кнопки панелі. Підніміть його, якщо ви часто пропускаєте його."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel düğmesi için hedef boyuta dokunun. Sık sık kaçırıyorsanız yükseltin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotkněte se cílové velikosti pro tlačítko panelu. Zvedněte ji, pokud ji často postrádáte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknite sa cieľovej veľkosti pre tlačidlo panela. Zvýšte ho, ak vám často chýba."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε το μέγεθος στόχου για το κουμπί του πίνακα. Ανεβάστε το αν το χάνετε συχνά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på målstorlek för panelknappen. Höj den om du ofta missar den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på målstørrelse for panelknappen. Hæv den, hvis du ofte savner den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på målstørrelse for panelknappen. Hev den hvis du ofte savner den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosketa paneelipainikkeen kohdekokoa. Nosta sitä, jos kaipaat sitä usein."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentuh ukuran target untuk tombol panel. Naikkan jika Anda sering melewatkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào kích thước mục tiêu cho nút bảng điều khiển. Hãy nâng nó lên nếu bạn thường xuyên bỏ lỡ nó."
          }
        }
      }
    },
