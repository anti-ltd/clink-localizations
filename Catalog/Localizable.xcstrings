          "stringUnit": {
            "state": "translated",
            "value": "이모지 키보드 맨 앞에 최근 쓴 이모지 탭을 넣어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah tab emoji yang baru anda guna di awal papan kekunci emoji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um separador com os teus emoji recentes no início do teclado de emoji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить вкладку недавних эмодзи в начало клавиатуры эмодзи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在表情键盘最前面加一栏你最近用过的表情。"
          }
        }
      }
    },
    "Add a tab of your recently used emoji to the emoji keyboard. Drag it anywhere you like on the Categories tab.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg 'n oortjie van jou onlangs gebruikte emoji by die emoji-sleutelbord. Sleep dit enige plek waar jy wil op die Kategorieë-oortjie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz einen Tab mit deinen zuletzt benutzten Emojis auf die Emoji-Tastatur. Unter „Kategorien“ ziehst du ihn dorthin, wo du ihn haben willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade al teclado de emoji una pestaña con los que usaste hace poco. En «Categorías» puedes arrastrarla donde quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa emoji-klaviatuurile kaart oma viimati kasutatud emojidega. Lohista see kaardile „Kategooriad\" sinna, kuhu soovid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute au clavier emoji un onglet avec tes emoji récents. Dans « Catégories », fais-le glisser où tu veux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tedd a nemrég használt emojijaidat egy fülre az emoji-billentyűzeten. A „Kategóriák” fülön oda húzod, ahová szeretnéd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi alla tastiera emoji una scheda con quelle usate di recente. In «Categorie» la trascini dove vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近使った絵文字のタブを絵文字キーボードに追加します。「カテゴリ」タブで好きな位置にドラッグできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근에 쓴 이모지 탭을 이모지 키보드에 넣어요. ‘카테고리’ 탭에서 원하는 자리로 끌어다 놓을 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah tab emoji yang baru anda guna pada papan kekunci emoji. Seret ke mana-mana yang anda suka di tab Kategori."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona ao teclado de emoji um separador com os que usaste há pouco. Em «Categorias», arrasta-o para onde quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить вкладку недавних эмодзи на клавиатуру эмодзи. Перетащите её куда угодно на вкладке «Категории»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在表情键盘里加一栏你最近用过的表情。可以在「分类」里拖到你想要的位置。"
          }
        }
      }
    },
    "Add a word once and Clink stops fighting it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg een keer 'n woord by en Clink hou op om daarmee te veg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füg ein Wort einmal hinzu, und Clink hört auf, dagegen anzukämpfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una palabra una vez y Clink deja de pelear con ella."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa sõna üks kord ja Clink lõpetab selle vastu võitlemise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un mot une fois et Clink arrête de le combattre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add hozzá a szót egyszer, és a Clink többé nem harcol ellene."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una parola una volta e Clink smette di combatterla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語を一度追加すれば、Clinkはもう直そうとしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어를 한 번만 추가하면 Clink가 더는 고치려 하지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah perkataan sekali dan Clink berhenti melawannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona uma palavra uma vez e o Clink deixa de lutar contra ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте слово один раз — и Clink перестанет с ним спорить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把词添加一次，Clink 就不再和它较劲。"
          }
        }
      }
    },
