    "Touch target height for suggestion chips. Raise it if you often miss a tap.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Raak teikenhoogte vir voorstelskyfies. Lig dit op as jy dikwels 'n kraan mis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhe der Tippfläche für Vorschlags-Chips. Mach sie größer, wenn du oft danebentippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura de la zona táctil de las sugerencias. Súbela si fallas al tocar a menudo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soovituse kiipide puudutussihi kõrgus. Suurenda, kui sa tihti mööda lubad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauteur de la zone tactile des suggestions. Augmente-la si tu rates souvent un appui."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A javaslatchipek érintési magassága. Növeld, ha gyakran mellényúlsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altezza dell'area tattile dei suggerimenti. Alzala se sbagli spesso il tocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補チップのタッチ領域の高さです。タップをよく外すなら大きくしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천 칩의 터치 영역 높이예요. 자주 잘못 누르면 높여보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketinggian sasaran sentuh untuk cip cadangan. Naikkan jika anda kerap terlepas ketikan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura da zona de toque das sugestões. Aumenta-a se falhas o toque muitas vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высота зоны нажатия у плашек подсказок. Увеличьте, если часто промахиваетесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议条的点按区域高度。要是经常点不中，就调高一点。"
          }
        }
      }
    },
    "Touch target size for each key relative to the visible key. Lower is more precise, higher catches more taps.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Raak teikengrootte vir elke sleutel relatief tot die sigbare sleutel. Laer is meer presies, hoër vang meer krane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch-Zielgröße jeder Taste im Verhältnis zur sichtbaren Taste. Niedriger ist präziser, höher fängt mehr Tippfehler ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño del objetivo táctil de cada tecla respecto a la tecla visible. Menor es más preciso, mayor capta más toques."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga klahvi puutepiirkond võrreldes nähtava klahviga. Väiksem on täpsem, suurem püüab rohkem puudutusi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille de la cible tactile de chaque touche par rapport à la touche visible. Plus bas est plus précis, plus haut capte plus de frappes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden billentyű érintési célterülete a látható billentyűhöz képest. Alacsonyabb pontosabb, magasabb több érintést fog meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensione del bersaglio tattile di ogni tasto rispetto al tasto visibile. Più basso è più preciso, più alto cattura più tocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見えているキーに対する各キーのタッチ判定領域のサイズ。小さいほど正確、大きいほどタップを拾いやすい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보이는 키 대비 각 키의 터치 영역 크기. 낮을수록 정밀하고 높을수록 더 많은 탭을 잡습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saiz sasaran sentuhan setiap kekunci berbanding kekunci yang kelihatan. Lebih rendah lebih tepat, lebih tinggi menangkap lebih banyak ketukan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho do alvo tátil de cada tecla em relação à tecla visível. Menor é mais preciso, maior capta mais toques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер области касания каждой клавиши относительно видимой клавиши. Меньше — точнее, больше — ловит больше нажатий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个按键的触摸目标大小相对于可见按键。较低更精确，较高能捕捉更多点击。"
          }
        }
      }
    },
    "Touch target size for the panel button. Raise it if you frequently miss it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Raak teikengrootte vir die paneelknoppie. Lig dit op as jy dit gereeld mis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größe der Tippfläche für die Bedienfeldtaste. Mach sie größer, wenn du sie oft verfehlst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño de la zona táctil del botón del panel. Súbelo si fallas al tocarlo a menudo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneelinupu puudutussihi suurus. Suurenda, kui sa teda tihti mööda lubad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille de la zone tactile du bouton du panneau. Augmente-la si tu le rates souvent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A panelgomb érintési mérete. Növeld, ha gyakran mellényúlsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensione dell'area tattile del pulsante del pannello. Alzala se lo sbagli spesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルボタンのタッチ領域の大きさです。よく外すなら大きくしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널 버튼의 터치 영역 크기예요. 자주 놓치면 높여보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saiz sasaran sentuh untuk butang panel. Naikkan jika anda kerap terlepas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho da zona de toque do botão do painel. Aumenta-o se falhas com frequência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер зоны нажатия у кнопки панелей. Увеличьте, если часто по ней промахиваетесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板按钮的点按区域大小。要是经常点不中，就调高一点。"
          }
        }
      }
    },
