    "Microphone or speech recognition access is turned off for Clink. Turn it back on to dictate.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot mikrofoon of spraakherkenning is afgeskakel vir Clink. Skakel dit weer aan om te dikteer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff aufs Mikrofon oder die Spracherkennung ist für Clink deaktiviert. Schalte ihn wieder ein, um zu diktieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al micrófono o al reconocimiento de voz está desactivado para Clink. Vuelve a activarlo para dictar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkil on mikrofoni või kõnetuvastuse juurdepääs välja lülitatud. Lülita see tagasi sisse, et dikteerida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au micro ou à la reconnaissance vocale est désactivé pour Clink. Réactive-le pour dicter."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofonhoz vagy a beszédfelismeréshez való hozzáférés ki van kapcsolva a Clinknél. Kapcsold vissza, hogy diktálhass."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al microfono o al riconoscimento vocale è disattivato per Clink. Riattivalo per dettare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink のマイクまたは音声認識へのアクセスがオフになっています。もう一度オンにすると音声入力を使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink의 마이크 또는 음성 인식 접근 권한이 꺼져 있어요. 다시 켜면 받아쓸 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon atau pengecaman pertuturan dimatikan untuk Clink. Hidupkannya semula untuk berimlak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone ou ao reconhecimento de voz está desligado para o Clink. Volta a ligá-lo para ditares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для Clink выключен доступ к микрофону или распознаванию речи. Включите его снова, чтобы диктовать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 的麦克风或语音识别权限被关掉了。重新打开就能口述输入。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul la microfon sau recunoașterea vorbirii este dezactivat pentru Clink. Porniți-l înapoi pentru a dicta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot microfoon of spraakherkenning is uitgeschakeld voor Clink. Schakel het weer in om te dicteren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 的麥克風或語音識別許可權被關掉了。重新開啟就能口述輸入。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do mikrofonu lub rozpoznawania mowy jest wyłączony w Clink. Włącz go ponownie, aby dyktować."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до мікрофона або розпізнавання мовлення вимкнено для Clink. Увімкніть його знову, щоб диктувати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink için mikrofon veya konuşma tanıma erişimi kapatıldı. Dikte etmek için tekrar açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup k mikrofonu nebo rozpoznávání řeči je pro Clink vypnutý. Chcete-li diktovat, znovu jej zapněte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prístup k mikrofónu alebo rozpoznávaniu reči je pre Clink vypnutý. Ak chcete diktovať, znova ho zapnite."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσβαση στο μικρόφωνο ή στην αναγνώριση ομιλίας είναι απενεργοποιημένη για το Clink. Ενεργοποιήστε το ξανά για να υπαγορεύσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtkomst till mikrofon eller taligenkänning är avstängd för Clink. Slå på den igen för att diktera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon- eller talegenkendelsesadgang er slået fra for Clink. Tænd den igen for at diktere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon- eller talegjenkjenningstilgang er slått av for Clink. Slå den på igjen for å diktere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonin tai puheentunnistuksen käyttö on poistettu käytöstä Clink:ssä. Kytke se takaisin päälle sanellaksesi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon atau pengenalan suara dimatikan untuk Clink. Aktifkan kembali untuk mendiktekan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập micrô hoặc nhận dạng giọng nói bị tắt đối với Clink. Bật lại để đọc chính tả."
          }
        }
      }
    },
