    "Set the light and dark sides separately if the built-in pairing isn't what you want.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stel die ligte en donker kante afsonderlik as die ingeboude paring nie is wat jy wil hê nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell die helle und die dunkle Seite einzeln ein, wenn dir die vorgegebene Paarung nicht passt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el lado claro y el oscuro por separado si la combinación de fábrica no te convence."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Määra heled ja tumeda poole eraldi, kui sisseehitatud paaris ei sobi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle le côté clair et le côté sombre séparément si l'association d'origine ne te convient pas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a gyári párosítás nem tetszik, állítsd be külön a világos és a sötét oldalt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il lato chiaro e quello scuro separatamente, se l'abbinamento di serie non ti convince."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定の組み合わせが好みでなければ、ライトとダークをそれぞれ個別に設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 조합이 마음에 들지 않으면 밝은 쪽과 어두운 쪽을 따로 설정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan bahagian cerah dan gelap secara berasingan jika gandingan asalnya tidak menepati citarasa anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Define o lado claro e o escuro em separado, se o par de origem não for o que queres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте светлую и тёмную стороны по отдельности, если встроенная пара вам не подходит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果自带的搭配不合口味，浅色和深色可以分别设置。"
          }
        }
      }
    },
