          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte Clink vo výbere klávesnice. Kedykoľvek môžete prepnúť späť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj Clink i tangentbordsväljaren. Du kan byta tillbaka när som helst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye seçiciden Clink’i seçin. İstediğiniz zaman geri geçebilirsiniz."
