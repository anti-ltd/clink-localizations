            "value": "Die Werkzeuge übernehmen die Leiste als beschriftete Chips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas ocupan la barra como fichas con nombre."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tööriistad võtavad riba üle nimetud kiipidena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils occupent la barre sous forme de pastilles nommées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközök feliratos gombokként veszik át a sávot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli strumenti occupano la barra come chip con etichetta."
          }
        },
