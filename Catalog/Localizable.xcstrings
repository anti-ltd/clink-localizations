    "Old words struck out, new ones right after. Clearest, but it stops reading as a sentence.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ou woorde het deurgehaal, nuwes direk daarna. Duidelikste, maar dit hou op om as 'n sin te lees."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte Wörter durchgestrichen, neue direkt dahinter. Am deutlichsten, aber nicht mehr flüssig lesbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Palabras antiguas tachadas y nuevas justo después. Es lo más claro, pero deja de leerse como una frase."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanad sõnad läbikriipsutatud, uued kohe pärast. Kõige selgem, aga ei loe enam lausena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anciens mots barrés, nouveaux juste après. Très clair, mais la phrase devient moins lisible."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A régi szavak áthúzva, az újak közvetlenül utánuk. Ez a legtisztább, de már nem olvasható folyamatos mondatként."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parole vecchie barrate e nuove subito dopo. È chiarissimo, ma non si legge più come una frase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古い単語を取り消し線で残し、その直後に新しい単語を表示します。違いは明確ですが、文章としては読みにくくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 단어에 취소선을 긋고 바로 뒤에 새 단어를 표시해요. 가장 명확하지만 문장처럼 읽히지는 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataan lama dipotong dan perkataan baharu selepasnya. Paling jelas, tetapi ayat jadi sukar dibaca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palavras antigas riscadas e novas logo a seguir. É mais claro, mas deixa de se ler como uma frase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старые слова зачёркнуты, новые — сразу после. Понятнее всего, но перестаёт читаться как предложение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "划掉旧词，并紧接着显示新词。变化最清楚，但读起来不再像完整句子。"
          }
        }
      }
    },
