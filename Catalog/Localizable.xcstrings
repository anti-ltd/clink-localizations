    "Translate typed or pasted text into another language, right inside the keyboard. Adds a translate panel to the panel button.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertaal getikte of geplakte teks in 'n ander taal, reg binne die sleutelbord. Voeg 'n vertaalpaneel by die paneelknoppie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetze getippten oder eingefügten Text direkt in der Tastatur in eine andere Sprache. Fügt der Bedienfeldtaste einen Übersetzungsbereich hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce a otro idioma el texto que escribas o pegues, ahí mismo en el teclado. Añade un panel de traducción al botón de paneles."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlgi sisestatud või kleepitud tekst teise keelde otse klaviatuuril. Lisab paneelinupule tõlkepaneeli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduis le texte saisi ou collé dans une autre langue, directement dans le clavier. Ajoute un panneau de traduction au bouton de panneaux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordítsd le a beírt vagy beillesztett szöveget másik nyelvre, egyből a billentyűzeten belül. Egy fordítópanelt tesz a panelgombra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduci il testo che digiti o incolli in un'altra lingua, direttamente nella tastiera. Aggiunge un pannello di traduzione al pulsante dei pannelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力した文字やペーストした文字を、キーボードの中でそのまま別の言語に翻訳します。パネルボタンに翻訳パネルを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력하거나 붙여넣은 텍스트를 키보드 안에서 바로 다른 언어로 번역해요. 패널 버튼에 번역 패널이 생겨요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemah teks yang ditaip atau ditampal ke bahasa lain, terus dalam papan kekunci. Menambah panel terjemah pada butang panel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduz texto escrito ou colado para outro idioma, mesmo dentro do teclado. Adiciona um painel de tradução ao botão de painéis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводите напечатанный или вставленный текст на другой язык прямо в клавиатуре. Добавляет панель перевода к кнопке панелей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘里就能把打的或粘贴的文字翻译成另一种语言。会给面板按钮加上一个翻译面板。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduceți textul tastat sau lipit într-o altă limbă, chiar în interiorul tastaturii. Adaugă un panou de traducere la butonul panoului."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertaal getypte of geplakte tekst naar een andere taal, rechtstreeks op het toetsenbord. Voegt een vertaalpaneel toe aan de paneelknop."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鍵盤裡就能把打的或貼上的文字翻譯成另一種語言。會給面板按鈕加上一個翻譯面板。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tłumaczenie wpisanego lub wklejonego tekstu na inny język bezpośrednio na klawiaturze. Dodaje panel tłumaczenia do przycisku panelu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекладайте введений або вставлений текст іншою мовою прямо на клавіатурі. Додає панель перекладу до кнопки панелі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazdığınız veya yapıştırdığınız metni doğrudan klavyenin içinden başka bir dile çevirin. Panel düğmesine bir çeviri paneli ekler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přeložte napsaný nebo vložený text do jiného jazyka přímo na klávesnici. Přidá panel překladu k tlačítku panelu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekladajte napísaný alebo prilepený text do iného jazyka priamo na klávesnici. Pridá panel prekladu k tlačidlu panela."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταφράστε πληκτρολογημένο ή επικολλημένο κείμενο σε άλλη γλώσσα, ακριβώς μέσα στο πληκτρολόγιο. Προσθέτει ένα πλαίσιο μετάφρασης στο κουμπί του πίνακα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Översätt inskriven eller inklistrad text till ett annat språk, precis inuti tangentbordet. Lägger till en översättningspanel till panelknappen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oversæt indtastet eller indsat tekst til et andet sprog lige inde på tastaturet. Tilføjer et oversæt-panel til panelknappen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oversett innskrevet eller limt tekst til et annet språk, rett inne på tastaturet. Legger til et oversettelsespanel til panelknappen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käännä kirjoitettua tai liitettyä tekstiä toiselle kielelle suoraan näppäimistön sisällä. Lisää käännöspaneelin paneelipainikkeeseen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahkan teks yang diketik atau ditempelkan ke bahasa lain, langsung di dalam keyboard. Menambahkan panel terjemahan ke tombol panel."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch văn bản đã nhập hoặc dán sang ngôn ngữ khác, ngay bên trong bàn phím. Thêm bảng dịch vào nút bảng điều khiển."
          }
        }
      }
    },
