    "From Home, open Themes, then scroll to Background.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne auf Start die Seite Themes und scrolle zu Hintergrund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde Inicio, abre Temas y baja hasta Fondo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava avalehel „Teemad” ja keri jaotiseni „Taust”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis Accueil, ouvre Thèmes, puis fais défiler jusqu’à Arrière-plan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kezdőlapon nyisd meg a Témák oldalt, majd görgess a Háttér részhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da Home, apri Temi e scorri fino a Sfondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ホーム」から「テーマ」を開き、「背景」までスクロールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘홈’에서 ‘테마’를 열고 ‘배경’까지 스크롤하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari Utama, buka Tema, kemudian tatal ke Latar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de Início, abre Temas e desloca-te até Fundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На главной странице откройте «Темы» и прокрутите до раздела «Фон»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“主页”打开“主题”，然后滚动到“背景”。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Acasă, deschide Teme, apoi derulează la Fundal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open vanuit Home Thema's en scroll vervolgens naar Achtergrond."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從“主頁”開啟“主題”，然後滾動到“背景”。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Van Tuis, maak Temas oop, en scroll dan na Agtergrond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W menu głównym otwórz Motywy, a następnie przewiń do opcji Tło."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На головному екрані відкрийте «Теми», потім прокрутіть до «Фон»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana Sayfa'dan Temalar'ı açın, ardından Arka Plan'a gidin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ploše otevřete Motivy a přejděte na Pozadí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ploche otvorte Motívy a potom prejdite na Pozadie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Από την Αρχική σελίδα, ανοίξτε τα Θέματα και, στη συνέχεια, κάντε κύλιση στο Φόντο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från hemmet öppnar du Teman och bläddrar sedan till Bakgrund."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra Hjem, åbn Temaer, og rul derefter til Baggrund."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra Hjem, åpne Temaer, og rull deretter til Bakgrunn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa aloitusnäytössä Teemat ja vieritä sitten kohtaan Tausta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari Beranda, buka Tema, lalu gulir ke Latar Belakang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ Trang chủ, mở Chủ đề, sau đó cuộn đến Nền."
          }
        }
      }
    },
