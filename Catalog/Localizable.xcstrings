    "Turn Key popups off, or leave them on and set how they spring.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel sleutelopspringers af, of laat hulle aan en stel in hoe hulle spring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte die Tasten-Popups aus — oder lass sie an und stell ein, wie stark sie federn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva las ventanas emergentes de tecla, o déjalas y ajusta cómo rebotan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita Klahvide hüpikud välja või jäta nad sisse ja määra nende vedrustus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive les bulles de touche, ou garde-les et règle leur rebond."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold ki a Kulcs felugró ablakokat, vagy hagyd bekapcsolva, és állítsd be, hogyan rugóznak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva i Popup dei tasti, oppure lasciali attivi e regola il loro rimbalzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キーのポップアップ」をオフにするか、オンのままで弾み方を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 팝업을 끄거나, 켜 둔 채 튀어오르는 정도를 조절하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan Pop timbul kekunci, atau biarkan hidup dan laraskan lantunannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga os Balões de tecla, ou deixa-os ligados e ajusta o salto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите всплывающие клавиши — или оставьте их и настройте, как они пружинят."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关掉“按键弹出框”，或者留着它，调一下弹跳的感觉。"
          }
        }
      }
    },
    "Turn Key press haptics on and set the feel on the pad.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
