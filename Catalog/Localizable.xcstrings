    "Blue into cyan, ending in white.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Blou in siaan, eindig in wit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Blau über Cyan zu Weiß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De azul a cian, terminando en blanco."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinisest tsüaani, lõpeb valgena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bleu au cyan, pour finir en blanc."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kékből cianba, végül fehérbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal blu al ciano, fino al bianco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "青からシアン、最後は白へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파랑에서 청록, 끝은 하양."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biru ke sian, berakhir putih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "De azul a ciano, a acabar em branco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синий переходит в голубой и заканчивается белым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝到青，最后收白。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Albastru în cyan, care se termină în alb."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blauw gaat over in cyaan en eindigt in wit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藍到青，最後收白。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niebieski w cyjan, kończący się na białym."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синій перетворюється в блакитний, закінчується білим."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maviden camgöbeğine, beyazla bitiyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Modrá do azurové, končící bílou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Modrá do azúrovej, končiaca bielou."
          }
        },
        "el": {
