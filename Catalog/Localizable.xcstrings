    "Nothing I change in the app reaches the keyboard": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niks wat ek in die toepassing verander, bereik die sleutelbord nie"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ich in der App ändere, kommt nicht auf der Tastatur an"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que cambio en la app no llega al teclado"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Midagi, mida ma rakenduses muudan, ei jõua klaviatuurini"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que je change dans l'app n'arrive pas au clavier"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amit az appban átállítok, nem jelenik meg a billentyűzeten"
