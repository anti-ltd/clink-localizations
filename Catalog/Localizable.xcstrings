        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastele se strâng într-o parte, la îndemâna unui deget mare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De toetsen knijpen naar één kant, binnen het bereik van één duim."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
