          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조금만 더 자세히 적어 주세요. 한두 문장이면 충분합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa veidi rohkem üksikasju: lausest-paarist piisab."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați puțin mai multe detalii: o propoziție sau două sunt suficiente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg wat meer details toe: een zin of twee is voldoende."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請再多寫一點細節，一兩句話就夠了。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verskaf 'n bietjie meer besonderhede: 'n sin of twee is genoeg."
