    "On an Apple Intelligence phone it can also punctuate what you said and drop the ums.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Op 'n Apple Intelligence-foon kan dit ook lees wat jy gesê het en die ums laat val."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem Gerät mit Apple Intelligence setzt es außerdem die Satzzeichen und lässt das Ähm weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un iPhone con Apple Intelligence también puede poner la puntuación y quitar las muletillas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence’iga telefonil saab see ka lisada kirjavahemärgid sellele, mida ütlesid, ja eemaldada ummardused."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un iPhone compatible Apple Intelligence, elle peut aussi ponctuer ce que tu as dit et retirer les hésitations."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence-képes telefonon a központozást is elhelyezi, és elhagyja a hümmögést."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su un iPhone con Apple Intelligence può anche mettere la punteggiatura e togliere gli intercalari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence対応の端末では、句読点を補い、「えーと」なども省いてくれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence를 지원하는 기기에서는 문장 부호까지 넣고 군더더기도 덜어 줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada telefon dengan Apple Intelligence, ia juga boleh meletakkan tanda baca dan membuang bunyi teragak-agak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Num iPhone com Apple Intelligence também pontua o que disseste e deixa cair os hesitos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На телефоне с Apple Intelligence он ещё и расставит знаки препинания и уберёт все «эээ»."
          }
        },
