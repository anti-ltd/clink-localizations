    "Glows where your taps land, hotter with traffic.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gloei waar jou krane land, warmer met verkeer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leuchtet dort, wo deine Tipper landen, und wird mit mehr Verkehr heißer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ilumina donde caen tus toques y se calienta cuanto más pasan por ahí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Särab seal, kus su vajutused maanduvad, ja läheb liiklusega kuumemaks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’illumine là où tes appuis atterrissent, de plus en plus chaud avec le trafic."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ott világít, ahová a koppintásaid esnek, és minél többször, annál forróbban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si illumina dove atterrano i tuoi tocchi, più caldo dove passi di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップが着地した場所が光り、回数が多いほど熱くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭이 닿는 자리가 빛나고, 많이 눌릴수록 더 뜨거워집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersinar di tempat ketikan anda mendarat, makin panas apabila makin kerap."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina onde os teus toques caem, mais quente quanto mais passa por ali."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светится там, куда попадают нажатия, и тем горячее, чем их больше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你点按的落点处发光，落点越多越热。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Strălucește acolo unde aterizează robinetele tale, mai fierbinte de trafic."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gloeit waar uw kranen landen, heter door het verkeer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你點按的落點處發光，落點越多越熱。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Świeci tam, gdzie lądują krany, a w ruchu ulicznym jest goręcej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Світиться там, де припадають ваші крани, гарячіша під час руху."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Musluklarınızın düştüğü yerde parlıyor, trafik nedeniyle daha sıcak."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svítí tam, kde dopadnou vaše kohoutky, žhavější s provozem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Svieti tam, kde dopadnú vaše kohútiky, čím viac sa zvyšuje premávka."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λάμπει εκεί που προσγειώνονται οι βρύσες σας, πιο ζεστό με την κίνηση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glöder där dina kranar landar, varmare med trafik."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gløder, hvor dine vandhaner lander, varmere med trafik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gløder der kranene dine lander, varmere med trafikk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hehkuu siellä, missä hanat laskeutuvat, kuumemmin liikenteessä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersinar di tempat keran Anda mendarat, lebih panas saat lalu lintas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát sáng nơi vòi của bạn tiếp đất, nóng hơn khi có giao thông."
          }
        }
      }
    },
