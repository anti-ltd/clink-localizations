          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa tudo o que vem depois do cursor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передаёт всё, что идёт после курсора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
