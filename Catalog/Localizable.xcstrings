          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørg med dine egne ord og Apple Intelligence-svar fra denne FAQ på din telefon."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør med dine egne ord og Apple Intelligence-svar fra denne FAQ-en, på telefonen din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysy omin sanoin ja Apple Intelligence-vastauksia tästä UKK:sta puhelimellasi."
