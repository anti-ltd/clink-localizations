            "value": "Tik daarop om na die volgende taal te beweeg."
          }
        }
      }
    },
    "Tap one to go to it, or put it back on its own.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp auf einen Eintrag, um dorthin zu springen, oder stell ihn einzeln zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca uno para ir hasta él, o devuélvelo a su valor por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un élément pour y aller, ou remets-le seul comme avant."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egyre, hogy odaugorj, vagy állítsd vissza külön-külön."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una voce per andarci, oppure ripristinala da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目をタップするとその設定に移動できます。ひとつだけ元に戻すこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 누르면 해당 설정으로 이동하고, 하나만 따로 되돌릴 수도 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik satu untuk pergi ke situ, atau kembalikan ia satu per satu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca num para ir até ele, ou repõe-no sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
