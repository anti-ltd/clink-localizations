    "Color every key of a kind at once. Painting a key on its own overrides its group.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleur elke sleutel van 'n soort gelyktydig in. Om 'n sleutel op sy eie te verf, ignoreer sy groep."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbe alle Tasten einer Art auf einmal. Färbst du eine Taste einzeln, geht das der Gruppe vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorea todas las teclas de un tipo a la vez. Si pintas una tecla por separado, esta prevalece sobre el grupo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Värvi korraga kõik samasugused klahvid. Üksikult värvitud klahv alistab oma grupi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore toutes les touches d’un même type d’un coup. Si tu colores une touche à part, elle l’emporte sur le groupe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Színezd ki egyszerre egy fajta összes billentyűjét. Ha egy billentyűt külön színezel, az felülírja a csoportot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colora tutti i tasti di un tipo insieme. Se colori un tasto da solo, ha la meglio sul gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ種類のキーをまとめて色付けできます。個別に塗ったキーはグループより優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 종류의 키를 한 번에 칠해요. 개별로 칠한 키는 그룹보다 우선해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnakan semua kekunci sejenis sekali gus. Kekunci yang diwarnakan sendiri mengatasi kumpulannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore todas as teclas de um tipo de uma vez. Se pintares uma tecla à parte, ela prevalece sobre o grupo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Красьте сразу все клавиши одного вида. Цвет, заданный отдельной клавише, перебивает группу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次给同一类按键上色。单独涂过的按键会覆盖所属分组。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorează fiecare cheie de un fel deodată. Pictarea unei chei pe cont propriu suprascrie grupului său."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleur elke soort sleutel in één keer. Het schilderen van een sleutel op zichzelf overschrijft de groep ervan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次給同一類按鍵上色。單獨塗過的按鍵會覆蓋所屬分組。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokoloruj każdy klawisz na raz. Malowanie klucza samodzielnie zastępuje jego grupę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розфарбуйте кожен ключ одного виду одночасно. Розмальовування окремого ключа замінює його групу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir türdeki her anahtarı aynı anda renklendirin. Bir anahtarın kendi başına boyanması, grubunu geçersiz kılar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybarvěte všechny klíče svého druhu najednou. Malování klíče samo o sobě přepíše jeho skupinu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyfarbite každý kľúč svojho druhu naraz. Maľovanie kľúča samo o sebe prepíše jeho skupinu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρωματίστε κάθε κλειδί του είδους ταυτόχρονα. Η ζωγραφική ενός κλειδιού από μόνο του υπερισχύει της ομάδας του."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Färglägg varje tangent på en gång. Att måla en nyckel för sig åsidosätter dess grupp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Farv hver tast af slagsen på én gang. At male en nøgle for sig selv tilsidesætter dens gruppe."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Farg hver tast av et slag samtidig. Å male en nøkkel alene overstyrer gruppen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Väritä jokainen näppäin kerralla. Avaimen maalaus yksinään ohittaa sen ryhmän."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnai setiap kunci sekaligus. Melukis kunci sendiri akan mengesampingkan kelompoknya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tô màu mọi phím của một loại cùng một lúc. Việc tự vẽ một phím sẽ ghi đè lên nhóm của nó."
          }
        }
      }
    },
