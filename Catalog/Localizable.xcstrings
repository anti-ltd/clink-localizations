    "Allow executable extensions for this repository before downloading actions.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube die ausführbaren Erweiterungen dieses Repositorys, bevor du Aktionen lädst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las extensiones ejecutables de este repositorio antes de descargar acciones."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Luba selle hoidla käivitatavad laiendused, enne kui laadid tegevusi alla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise les extensions exécutables de ce dépôt avant de télécharger des actions."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd ennél a tárháznál a végrehajtható bővítményeket, mielőtt műveleteket töltenél le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti le estensioni eseguibili di questo repository prima di scaricare azioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションをダウンロードする前に、このリポジトリの実行可能な拡張機能を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동작을 다운로드하기 전에 이 저장소의 실행 가능한 확장을 허용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan sambungan boleh laku untuk repositori ini sebelum memuat turun tindakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite as extensões executáveis deste repositório antes de transferir ações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите исполняемые расширения для этого репозитория, прежде чем загружать действия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载操作之前，请先允许此仓库的可执行扩展。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți extensii executabile pentru acest depozit înainte de a descărca acțiuni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta uitvoerbare extensies toe voor deze repository voordat u acties downloadt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載操作之前，請先允許此倉庫的可執行擴充套件。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat uitvoerbare uitbreidings vir hierdie bewaarplek toe voordat jy aksies aflaai."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na rozszerzenia wykonywalne dla tego repozytorium przed pobraniem działań."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити виконувані розширення для цього сховища перед діями завантаження."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eylemleri indirmeden önce bu depo için yürütülebilir uzantılara izin verin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před stahováním akcí povolte spustitelná rozšíření pro toto úložiště."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred stiahnutím akcií povoľte spustiteľné rozšírenia pre toto úložisko."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε τις εκτελέσιμες επεκτάσεις για αυτό το χώρο αποθήκευσης πριν από τη λήψη ενεργειών."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt körbara tillägg för det här arkivet innan du laddar ned åtgärder."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad eksekverbare udvidelser for dette lager, før handlinger downloades."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat kjørbare utvidelser for dette depotet før du laster ned handlinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli tämän arkiston suoritettavat laajennukset ennen toimintojen lataamista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan ekstensi yang dapat dieksekusi untuk repositori ini sebelum mengunduh tindakan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép các tiện ích mở rộng có thể thực thi được cho kho lưu trữ này trước khi tải xuống các hành động."
          }
        }
      }
    },
