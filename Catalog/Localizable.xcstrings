    "Calculate and paste the result": {
      "comment": "Tools card and/or tool-page description. Plain feature copy; preserve product and programming-language names.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechne und füge das Ergebnis ein"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz cálculos y pega el resultado"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvuta ja kleebi tulemus"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais un calcul et colle le résultat"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Számolás és az eredmény beillesztése"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai i calcoli e incolla il risultato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算して結果を貼り付けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산하고 결과를 붙여넣으세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat pengiraan dan tampal hasilnya"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz cálculos e cola o resultado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вычисления со вставкой результата"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算并粘贴结果"
          }
        }
      }
    },
    "Calculate without leaving the keyboard": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
