    "Turn Apple Intelligence on in Clink to look words up.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Apple Intelligence en Clink para consultar palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Apple Intelligence dans Clink pour chercher des mots."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Apple Intelligence in Clink, um Wörter nachzuschlagen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Apple Intelligence in Clink per cercare le parole."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a Apple Intelligence no Clink para consultar palavras."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Apple Intelligence dalam Clink untuk mencari perkataan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be az Apple Intelligence-t a Clinkben a szavak kikereséséhez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語を調べるには Clink で Apple Intelligence をオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Clink 中开启 Apple Intelligence 以查询单词。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어를 찾으려면 Clink에서 Apple Intelligence를 켜세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sõnade otsimiseks lülita Apple Intelligence Clinkis sisse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Apple Intelligence в Clink, чтобы искать слова."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați Apple Intelligence în Clink pentru a căuta cuvinte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Apple Intelligence in Clink in om woorden op te zoeken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 Clink 中開啟 Apple Intelligence 以查詢單詞。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel Apple Intelligence in Clink aan om woorde op te soek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Apple Intelligence w Clink, aby wyszukać słowa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Apple Intelligence у Clink, щоб шукати слова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelimeleri aramak için Clink'te Apple Intelligence'i açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte Apple Intelligence v Clink a vyhledejte slova."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite Apple Intelligence v Clink a vyhľadajte slová."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε το Apple Intelligence στο Clink για να αναζητήσετε λέξεις."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Apple Intelligence i Clink för att slå upp ord."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Apple Intelligence til i Clink for at slå ord op."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Apple Intelligence i Clink for å slå opp ord."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota Apple Intelligence käyttöön Clink:ssä etsiäksesi sanoja."
          }
        },
        "id": {
