    "Copied images. Only the text in your clipboard history can travel.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierte Bilder. Nur der Text aus deinem Zwischenablage-Verlauf kann mitreisen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes copiadas. Solo el texto del historial del portapapeles puede viajar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images copiées. Seul le texte de ton historique de presse-papiers peut voyager."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A másolt képek. A vágólap-előzményekből csak a szöveg utazhat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini copiate. Solo il testo della cronologia degli appunti può viaggiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
