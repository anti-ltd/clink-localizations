    "Let gradients and effects drift as you type.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat gradiënte en effekte dryf terwyl jy tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Farbverläufe und Effekte beim Tippen wandern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que los degradados y efectos se muevan mientras escribes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lase üleminekutel ja efektidel tipimise ajal triivida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse les dégradés et effets dériver pendant que tu tapes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagyd, hogy a színátmenetek és effektek elmozduljanak gépelés közben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia che sfumature ed effetti si muovano mentre scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力中にグラデーションやエフェクトを揺らします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이핑하는 동안 그라데이션과 효과가 흘러가게 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan kecerunan dan kesan bergerak semasa anda menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa os gradientes e efeitos deslizarem enquanto escreves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволить градиентам и эффектам двигаться, пока вы печатаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打字时让渐变和特效随之流动。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lăsați degradeurile și efectele să se deplaseze pe măsură ce tastați."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat verlopen en effecten veranderen terwijl u typt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打字時讓漸變和特效隨之流動。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól, aby gradienty i efekty dryfowały podczas pisania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нехай градієнти та ефекти змінюються під час введення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz yazarken degradelerin ve efektlerin kaymasına izin verin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte přechody a efekty při psaní unášet."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechajte prechody a efekty počas písania unášať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε τις διαβαθμίσεις και τα εφέ να μετακινούνται καθώς πληκτρολογείτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt gradienter och effekter glida medan du skriver."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad gradienter og effekter glide, mens du skriver."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La gradienter og effekter drive mens du skriver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna liukuvärien ja tehosteiden liikkua kirjoittaessasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan gradien dan efek melayang saat Anda mengetik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy để độ dốc và hiệu ứng trôi đi khi bạn nhập."
          }
        }
      }
    },
    "Let key sides slant too instead of staying as upright boxes.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat sleutel kante ook skuins in plaas daarvan om as regop bokse te bly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt auch die Tastenseiten schräg sein, statt aufrechte Kästen zu bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que los lados de las teclas también se inclinen en vez de quedarse como cajas rectas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lase ka klahvide külgedel kaldu olla, selle asemel et jääda püstisteks kastideks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse aussi les côtés des touches s'incliner au lieu de rester des cases droites."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedi, hogy a billentyűk oldalai is megdőljenek, ahelyett, hogy egyenes dobozok maradnának."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia inclinare anche i lati dei tasti invece di tenerli come riquadri dritti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの側面を、まっすぐな箱のままにせず傾けられるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 옆면이 곧은 상자로 있지 않고 기울어질 수 있게 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biar sisi kekunci turut condong, bukannya kekal sebagai kotak tegak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa as laterais das teclas inclinarem-se também, em vez de ficarem caixas direitas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволить и бокам клавиш наклоняться, а не оставаться ровными прямоугольниками."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让键的侧边也能倾斜，而不是保持竖直的方块。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lăsați și părțile cheie înclinate în loc să rămână ca cutii verticale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de belangrijkste zijkanten ook schuin staan in plaats van rechtopstaande dozen te blijven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓鍵的側邊也能傾斜，而不是保持豎直的方塊。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól, aby kluczowe boki również były pochylone, zamiast pozostać pionowymi pudełkami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нехай сторони клавіш також будуть нахилені замість того, щоб залишатися вертикальними ящиками."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dik kutular olarak kalmak yerine anahtar kenarların da eğimli olmasına izin verin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte klíčové strany také šikmo, místo aby zůstaly jako svislé krabice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechajte kľúčové strany naklonené, namiesto toho, aby zostali ako zvislé krabice."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε τις πλευρές των πλήκτρων να γέρνουν επίσης αντί να παραμείνουν ως όρθια κουτιά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt nyckelsidorna också luta istället för att stanna som upprättstående lådor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad nøglesider også skrå i stedet for at blive som opretstående kasser."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La nøkkelsidene skrå også i stedet for å bli som stående bokser."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna myös avainten sivujen vinoa sen sijaan, että ne pysyisivät pystylaatikoina."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan sisi-sisi kunci juga miring daripada tetap berbentuk kotak tegak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để các cạnh chính cũng nghiêng thay vì giữ nguyên dạng hộp thẳng đứng."
          }
        }
      }
    },
    "Let the pet breathe, blink, and bob while you're not typing. Turn off for a calmer, still companion. It still reacts to your keystrokes.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat die troeteldier asemhaal, knip en wip terwyl jy nie tik nie. Skakel af vir 'n rustiger, stil metgesel. Dit reageer steeds op jou toetsaanslagen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass das Haustier atmen, blinzeln und wippen, während du nicht tippst. Schalt es aus für einen ruhigeren, stillen Begleiter. Er reagiert weiterhin auf deine Tastenanschläge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que la mascota respire, parpadee y se balancee cuando no escribes. Desactívalo para un compañero más tranquilo y quieto: seguirá reaccionando a tus pulsaciones."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lase lemmikloomal hinge tõmba, pilkutada ja õõtsuda, kui sa ei tipi. Lülita välja rahulikuma, paigalseisva kaaslase jaoks. Ta reageerib ikka sinu klahvivajutustele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse le compagnon respirer, cligner des yeux et se balancer quand tu ne tapes pas. Désactive pour un compagnon plus calme et immobile. Il réagit quand même à tes frappes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagyd, hogy a kisállat lélegezzen, pislogjon és mozogjon, amíg nem gépelsz. Kapcsold ki egy nyugodtabb, mozdulatlan társért. A leütéseidre így is reagál."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia che il pet respiri, sbatta le palpebre e ondeggi mentre non scrivi. Disattivalo per un compagno più tranquillo e immobile. Reagisce comunque ai tuoi tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力していないあいだ、ペットが呼吸したり、まばたきしたり、ゆれたりします。オフにすると、静かで落ち着いた相棒になります。キー入力にはそれでも反応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력하지 않는 동안 펫이 숨 쉬고, 눈 깜빡이고, 까딱이게 해요. 더 차분하고 가만한 친구를 원하면 꺼요. 그래도 키 입력에는 반응해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biar peliharaan bernafas, berkelip, dan bergoyang semasa anda tak menaip. Matikan untuk teman yang lebih tenang dan diam. Ia masih bertindak balas kepada ketukan kekunci anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa a mascote respirar, piscar e balançar enquanto não escreves. Desliga para um companheiro mais calmo e parado. Continua a reagir às tuas teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть питомец дышит, моргает и покачивается, пока вы не печатаете. Выключите, если хотите спокойного и неподвижного соседа. На нажатия он всё равно реагирует."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你不打字时，让宠物呼吸、眨眼、晃动。想要更安静、不动的伙伴就关掉，它照样会对你的按键有反应。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lăsați animalul de companie să respire, să clipească și să se încline în timp ce nu scrieți. Opriți pentru un însoțitor mai calm și nemișcat. Încă reacționează la apăsările tale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat het huisdier ademen, knipperen en bewegen terwijl u niet typt. Schakel uit voor een kalmere, stille metgezel. Het reageert nog steeds op uw toetsaanslagen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你不打字時，讓寵物呼吸、眨眼、晃動。想要更安靜、不動的夥伴就關掉，它照樣會對你的按鍵有反應。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól zwierzęciu oddychać, mrugać i skakać, gdy nie piszesz. Wyłącz, aby uzyskać spokojniejszego, nieruchomego towarzysza. Nadal reaguje na naciśnięcia klawiszy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте вихованцеві дихати, моргати та хитатися, поки ви не друкуєте. Вимкніть для більш спокійного, нерухомого супутника. Він все ще реагує на натискання клавіш."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz yazmadığınız zamanlarda evcil hayvanınızın nefes almasına, göz kırpmasına ve sallanmasına izin verin. Daha sakin, hareketsiz bir arkadaş için kapatın. Hala tuş vuruşlarınıza tepki veriyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte zvíře dýchat, mrkat a poskakovat, zatímco vy nepíšete. Vypněte pro klidnějšího a nehybného společníka. Stále reaguje na vaše stisknutí kláves."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechajte domáce zviera dýchať, žmurkať a poskakovať, kým vy nepíšete. Vypnite pre pokojnejšieho a pokojnejšieho spoločníka. Stále reaguje na vaše stlačenia klávesov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε το κατοικίδιο να αναπνέει, να αναβοσβήνει και να αναβοσβήνει ενώ δεν πληκτρολογείτε. Απενεργοποιήστε για έναν πιο ήρεμο, ακίνητο σύντροφο. Εξακολουθεί να αντιδρά στα πλήκτρα σας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt husdjuret andas, blinka och guppa medan du inte skriver. Stäng av för en lugnare, stilla följeslagare. Den reagerar fortfarande på dina tangenttryckningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad kæledyret trække vejret, blinke og bobbe, mens du ikke skriver. Sluk for en roligere, stadig ledsager. Den reagerer stadig på dine tastetryk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La kjæledyret puste, blunke og bobbe mens du ikke skriver. Slå av for en roligere, fortsatt følgesvenn. Den reagerer fortsatt på tastetrykkene dine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna lemmikin hengittää, räpäyttää ja nyökätä, kun et kirjoita. Sammuta, jos haluat rauhallisemman, rauhallisen kumppanin. Se reagoi edelleen näppäinpainalluksiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan hewan peliharaan bernapas, berkedip, dan mengangguk saat Anda tidak sedang mengetik. Matikan untuk teman yang lebih tenang dan tenang. Itu masih bereaksi terhadap penekanan tombol Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy để thú cưng thở, chớp mắt và nhấp nhô khi bạn không gõ phím. Tắt để có một người bạn đồng hành bình tĩnh hơn, tĩnh lặng hơn. Nó vẫn phản ứng với các lần nhấn phím của bạn."
          }
        }
      }
    },
