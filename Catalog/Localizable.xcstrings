          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesy sa stláčajú na jednu stranu v dosahu jedného palca."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πλήκτρα πιέζονται προς τη μία πλευρά, ώστε να φτάνει ο ένας αντίχειρας."
          }
        },
        "sv": {
