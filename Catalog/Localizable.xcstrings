            "value": "Próbáld ki: húzd bármelyik tekerőt felfelé vagy jobbra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Provale: trascina una manopola in alto o a destra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試してみましょう。どちらかのノブを上か右にドラッグします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 해 보세요. 노브를 위나 오른쪽으로 드래그하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubalah: seret mana-mana tombol ke atas atau kanan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente: arraste qualquer um para cima ou para a direita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте: потяните любой регулятор вверх или вправо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试看：向上或向右拖动任一旋钮。"
          }
        }
      }
    },
