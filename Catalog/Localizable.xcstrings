    "How much a key grows when pressed. 100% is off. Higher values pop more.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel 'n sleutel groei as dit gedruk word. 100% is af. Hoër waardes verskyn meer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark eine Taste wächst, wenn sie gedrückt wird. 100 % ist aus. Höhere Werte ploppen mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto crece una tecla al pulsarla. 100% es apagado. Los valores más altos saltan más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui palju klahv vajutamisel kasvab. 100% on väljas. Kõrgemad väärtused pakuvad rohkem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De combien une touche grandit quand tu appuies. 100 % la désactive. Plus la valeur est haute, plus ça ressort."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyire nő meg egy billentyű, amikor megnyomod. A 100% kikapcsolt. A nagyobb érték jobban kiugrik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto cresce un tasto quando lo premi. 100% è disattivato. Valori più alti risaltano di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを押したときの拡大量です。100% でオフ。高いほど大きく弾みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누를 때 키가 얼마나 커지는지예요. 100%면 꺼져요. 값이 높을수록 더 튀어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak kekunci membesar bila ditekan. 100% bermaksud mati. Nilai lebih tinggi pop lebih ketara."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto uma tecla cresce quando é premida. 100% é desligado. Valores mais altos saltam mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько клавиша вырастает при нажатии. 100% — выключено. Больше — заметнее отскок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下时按键放大多少。100% 是关闭。数值越高弹得越明显。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de mult crește o tastă când este apăsată. 100% i dezactivate. Valorile mai mari apar mai mult."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel een toets groeit als hij wordt ingedrukt. 100% is uitgeschakeld. Hogere waarden knallen meer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下時按鍵放大多少。100% 是關閉。數值越高彈得越明顯。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak bardzo klawisz rośnie po naciśnięciu.100% wyłączone. Wyższe wartości są bardziej widoczne."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскільки збільшується клавіша при натисканні. 100% вимкнено. Більш високі значення з’являються більше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tuşa basıldığında ne kadar büyür. %100 kapalı. Daha yüksek değerler daha fazla ortaya çıkar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak moc klávesa po stisku naroste. 100% je vypnuto. Vyšší hodnoty vyskakují více."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Koľko kláves po stlačení narastie. 100% je vypnuté. Vyššie hodnoty vyskakujú viac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο μεγαλώνει ένα πλήκτρο όταν πατηθεί. 100% έκπτωση. Οι υψηλότερες τιμές αναδύονται περισσότερο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur mycket en tangent växer när den trycks ned. 100% är rabatt. Högre värden poppar mer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor meget en tast vokser, når der trykkes på den. 100% er rabat. Højere værdier dukker mere op."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mye en tast vokser når den trykkes. 100 % er avslag. Høyere verdier dukker mer opp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka paljon näppäin kasvaa painettaessa. 100% pois päältä. Korkeammat arvot nousevat enemmän."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa besar tombol tumbuh saat ditekan. 100% tidak aktif. Nilai yang lebih tinggi akan muncul lebih banyak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một phím sẽ tăng lên bao nhiêu khi được nhấn. 100% là tắt. Giá trị cao hơn sẽ xuất hiện nhiều hơn."
          }
        }
      }
    },
