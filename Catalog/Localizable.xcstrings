        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na tlačidlo jazyka na konci panela návrhov pre ďalší jazyk alebo ho podržte, aby ste si jeden vybrali."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε το κουμπί γλώσσας στο τέλος της γραμμής προτάσεων για την επόμενη γλώσσα ή κρατήστε το για να επιλέξετε μία."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på språkknappen i slutet av förslagsfältet för nästa språk, eller håll ned den för att välja ett."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på sprogknappen i slutningen af forslagslinjen for det næste sprog, eller hold den nede for at vælge et."
