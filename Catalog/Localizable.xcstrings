    "Adapt your keyboard with conditions, events, and plugin actions.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapta el teclado con condiciones, eventos y acciones de plugins."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapte ton clavier grâce à des conditions, des événements et des actions de plugins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe deine Tastatur mit Bedingungen, Ereignissen und Plugin-Aktionen an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Adatta la tastiera con condizioni, eventi e azioni dei plugin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapta o teclado com condições, eventos e ações de plugins."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настраивайте клавиатуру с помощью условий, событий и действий плагинов."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan papan kekunci dengan syarat, peristiwa dan tindakan pemalam."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alakítsd a billentyűzetet feltételekkel, eseményekkel és bővítményműveletekkel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "条件、イベント、プラグインのアクションでキーボードを調整できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过条件、事件和插件操作调整键盘。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조건, 이벤트 및 플러그인 동작으로 키보드를 조정하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohanda klaviatuuri tingimuste, sündmuste ja pistikprogrammide toimingutega."
          }
        }
      }
    },
