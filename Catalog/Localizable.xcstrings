            "value": "Det finns ett litet djur på mitt tangentbord"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er et lille dyr på mit tastatur"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er et lite dyr på tastaturet mitt"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäimistölläni on pieni eläin"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada binatang kecil di keyboard saya"
          }
        },
        "vi": {
