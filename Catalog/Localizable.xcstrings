    },
    "Something in that couldn’t be sent. Check it and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo de lo que has escrito no se ha podido enviar. Revísalo y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie n’a pas pu être envoyée. Vérifie et réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas davon konnte nicht gesendet werden. Prüf es und versuch es noch einmal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa non è stato inviato. Controlla e riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar parte disto. Verifica e tenta novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть данных не удалось отправить. Проверьте и попробуйте ещё раз."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebahagiannya tidak dapat dihantar. Semak dan cuba lagi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valamit nem sikerült elküldeni belőle. Ellenőrizd, és próbáld újra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部を送信できませんでした。内容を確認してもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分内容无法发送。请检查后再试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 내용을 보낼 수 없습니다. 확인 후 다시 시도해 주세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Osa sellest ei läinud teele. Kontrolli ja proovi uuesti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceva din asta nu a putut fi trimis. Verificați-l și încercați din nou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iets daarin kon niet worden verzonden. Controleer het en probeer het opnieuw."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分內容無法傳送。請檢查後再試。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Iets daarvan kon nie gestuur word nie. Gaan dit na en probeer weer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś w tym nie mogło zostać wysłane. Sprawdź i spróbuj ponownie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щось із цього не вдалося надіслати. Перевірте це та повторіть спробу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçindeki bir şey gönderilemedi. Kontrol edip tekrar deneyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Něco, co nebylo možné odeslat. Zkontrolujte to a zkuste to znovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niečo, čo sa nedalo odoslať. Skontrolujte to a skúste to znova."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτι σε αυτό δεν ήταν δυνατό να σταλεί. Ελέγξτε το και δοκιμάστε ξανά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något i som inte kunde skickas. Kontrollera det och försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget i, der ikke kunne sendes. Tjek det og prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe i som ikke kunne sendes. Sjekk det og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotakin siinä ei voitu lähettää. Tarkista se ja yritä uudelleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuatu di dalamnya tidak dapat dikirim. Periksa dan coba lagi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể gửi được thứ gì đó trong đó. Hãy kiểm tra và thử lại."
          }
        }
      }
    },
    "This device can’t send feedback right now. Email still reaches us.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no puede enviar comentarios ahora mismo. Por correo nos sigue llegando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas envoyer d’avis pour le moment. Par e-mail, ça nous parvient toujours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann gerade kein Feedback senden. Per E-Mail erreichst du uns trotzdem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
