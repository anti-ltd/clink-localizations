    "Hitbox 100%. Targets match the visible keys.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trefferfläche 100 %. Die Ziele entsprechen den sichtbaren Tasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Área táctil 100%. Los objetivos coinciden con las teclas visibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone tactile 100 %. Les cibles correspondent aux touches visibles."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitbox 100%. A célpontok megegyeznek a látható billentyűkkel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Area di tocco 100%. I bersagli coincidono con i tasti visibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒットボックス 100%。ターゲットが見えているキーと一致します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
