    "Sure, I'll have it over by then.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Seker, ek sal dit dan klaar hê."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar, bis dahin ist es bei dir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claro, para entonces lo tienes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindel, siis see sinuni jõuab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien sûr, tu l'auras d'ici là."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Persze, addigra átküldöm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Certo, per allora te lo mando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "了解です、それまでに送ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네, 그때까지 보낼게요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Boleh, sebelum itu saya hantar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Claro, até lá está aí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конечно, к этому времени всё будет готово."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好，到那时就发给你。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigur, o voi termina până atunci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natuurlijk, tegen die tijd ben ik er klaar mee."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好，到那時就發給你。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasne, do tego czasu już to skończę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звичайно, до того часу я все закінчу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabii o zamana kadar bitiririm."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasně, do té doby to budu mít za sebou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasné, dovtedy to budem mať za sebou."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σίγουρα, θα το έχω τελειώσει μέχρι τότε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visst, jag ska ha det över då."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Selvfølgelig skal jeg have det overstået til den tid."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jada, jeg har det over da."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toki, saan sen sitten ohi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentu, aku akan menyelesaikannya saat itu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chắc chắn rồi, đến lúc đó tôi sẽ xong việc."
          }
        }
      }
    },
