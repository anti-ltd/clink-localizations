    "Taller keys are easier to tap accurately. Shorter keys give more screen room.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoër sleutels is makliker om akkuraat te tik. Korter sleutels gee meer skermruimte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhere Tasten triffst du leichter genau. Niedrigere Tasten geben mehr Platz auf dem Bildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas más altas son más fáciles de tocar bien. Las más bajas dejan más espacio en pantalla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõrgemaid klahve on lihtsam täpselt tabada. Lühemad klahvid annavad ekraanil rohkem ruumi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches plus hautes sont plus faciles à toucher juste. Les plus basses laissent plus de place à l'écran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A magasabb gombokat könnyebb pontosan eltalálni. Az alacsonyabbak több helyet hagynak a képernyőn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti più alti sono più facili da toccare con precisione. Quelli più bassi lasciano più spazio sullo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーが高いほど正確にタップしやすくなります。低いと画面が広く使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 높을수록 정확하게 탭하기 쉬워요. 키가 낮으면 화면이 더 넓어져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci lebih tinggi senang diketik dengan tepat. Kekunci lebih pendek beri lebih ruang skrin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas mais altas são mais fáceis de acertar. As mais baixas deixam mais espaço no ecrã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По высоким клавишам легче попадать точно. Низкие оставляют больше места на экране."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键越高越好点准，越矮屏幕空间越大。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastele mai înalte sunt mai ușor de apăsat cu precizie. Tastele mai scurte oferă mai mult spațiu pentru ecran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grotere toetsen zijn gemakkelijker nauwkeurig te tikken. Kortere toetsen geven meer schermruimte."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵越高越好點準，越矮螢幕空間越大。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyższe klawisze są łatwiejsze do dokładnego wstukania. Krótsze klawisze zapewniają więcej miejsca na ekranie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Високі клавіші легше натискати точно. Коротші клавіші дають більше місця на екрані."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha uzun tuşlara doğru şekilde basmak daha kolaydır. Daha kısa tuşlar daha fazla ekran alanı sağlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na vyšší klávesy je snazší přesně klepat. Kratší klávesy poskytují více místa na obrazovce."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyššie klávesy sa ľahšie stláčajú presne. Kratšie klávesy poskytujú väčší priestor na obrazovke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ψηλότερα πλήκτρα είναι πιο εύκολο να πατήσετε με ακρίβεια. Τα πιο κοντά πλήκτρα δίνουν περισσότερο χώρο στην οθόνη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högre tangenter är lättare att knacka exakt. Kortare knappar ger mer skärmutrymme."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højere taster er nemmere at trykke præcist. Kortere taster giver mere skærmplads."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyere taster er lettere å trykke nøyaktig. Kortere taster gir mer skjermrom."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korkeampia näppäimiä on helpompi napauttaa tarkasti. Lyhyemmät näppäimet antavat enemmän tilaa näytölle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol yang lebih tinggi lebih mudah untuk diketuk secara akurat. Tombol yang lebih pendek memberi lebih banyak ruang layar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím cao hơn sẽ dễ gõ chính xác hơn. Phím ngắn hơn cho nhiều không gian màn hình hơn."
          }
        }
      }
    },
