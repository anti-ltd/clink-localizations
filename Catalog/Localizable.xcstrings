    },
    "Tap a chip to insert it where you're typing.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik 'n skyfie om dit in te voeg waar jy besig is om te tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Chip, um ihn dort einzufügen, wo du gerade tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un chip para insertarlo donde estés escribiendo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta kiipi, et see sinna sisestada, kuhu tipid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche une puce pour l'insérer là où tu tapes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy chipre, hogy beszúrd oda, ahol éppen gépelsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un chip per inserirlo dove stai scrivendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チップをタップすると、入力中の位置に挿入されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "칩을 탭하면 지금 입력 중인 위치에 들어가요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik cip untuk sisipkannya di tempat anda menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca num chip para o inserires onde estás a escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на плашку, чтобы вставить её туда, где вы печатаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下标签就能插入到你正在输入的位置。"
          }
        }
      }
    },
    "Tap a chip to paste that clip.": {
