        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak kunci yang bergoyang sebelum menetap. Tidak ada yang menetap dengan bersih."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có bao nhiêu chiếc chìa khóa lung lay trước khi chúng ổn định. Không có giải quyết sạch sẽ."
          }
        }
      }
    },
    "How much low-probability keys shrink to make room for the likely ones.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
