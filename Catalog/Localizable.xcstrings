    "Copy a complete prompt, paste it into any chat assistant, then paste its reply back here. No provider or API key is needed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia un prompt completo, pégalo en cualquier asistente de chat y luego pega aquí su respuesta. No hace falta proveedor ni clave de API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez une requête complète, collez-la dans n’importe quel assistant de conversation, puis collez sa réponse ici. Aucun fournisseur ni clé d’API n’est nécessaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere einen vollständigen Prompt, füge ihn in einen beliebigen Chat-Assistenten ein und füge dessen Antwort hier wieder ein. Ein Anbieter oder API-Schlüssel ist nicht nötig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia un prompt completo, incollalo in un qualsiasi assistente di chat, poi incolla qui la sua risposta. Non servono provider né chiave API."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie um prompt completo, cole-o em qualquer assistente de chat e depois cole a resposta aqui. Não é preciso provedor nem chave de API."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте полный запрос, вставьте его в любой чат-ассистент, а затем вставьте его ответ сюда. Провайдер и ключ API не нужны."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin gesaan lengkap, tampal ke mana-mana pembantu sembang, kemudian tampal jawapannya di sini. Tiada pembekal atau kunci API diperlukan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Másold ki a teljes promptot, illeszd be bármelyik csevegőasszisztensbe, majd illeszd ide a válaszát. Nincs szükség szolgáltatóra vagy API-kulcsra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全なプロンプトをコピーして任意のチャットアシスタントに貼り付け、その返答をここに貼り付けます。プロバイダやAPIキーは不要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制完整提示词，粘贴到任意聊天助手，再把它的回复粘贴回这里。无需服务商或 API 密钥。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 프롬프트를 복사해 원하는 챗 어시스턴트에 붙여넣은 다음, 그 답변을 여기에 붙여넣으세요. 제공자나 API 키가 필요 없습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopeeri terviklik viip, kleebi see mis tahes vestlusassistenti ja kleebi selle vastus siia tagasi. Teenusepakkujat ega API-võtit pole vaja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiați o solicitare completă, inserați-o în orice asistent de chat, apoi inserați-i răspunsul înapoi aici. Nu este nevoie de furnizor sau cheie API."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieer een volledige prompt, plak deze in een chatassistent en plak het antwoord hier terug. Er is geen provider of API-sleutel nodig."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製完整提示詞，貼上到任意聊天助手，再把它的回覆貼上回這裡。無需服務商或 API 金鑰。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieer 'n volledige prompt, plak dit in enige geselsassistent, en plak dan die antwoord hier terug. Geen verskaffer- of API-sleutel is nodig nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiuj cały monit, wklej go do dowolnego asystenta czatu, a następnie wklej tutaj odpowiedź. Nie jest potrzebny żaden dostawca ani klucz API."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопіюйте повне повідомлення, вставте його в будь-який помічник чату, а потім вставте його відповідь сюди. Постачальник або ключ API не потрібні."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstemin tamamını kopyalayın, herhangi bir sohbet asistanına yapıştırın ve ardından yanıtını buraya yapıştırın. Hiçbir sağlayıcıya veya API anahtarına gerek yoktur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkopírujte kompletní výzvu, vložte ji do libovolného chatovacího asistenta a poté sem vložte její odpověď. Není potřeba žádný poskytovatel ani klíč API."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopírujte úplnú výzvu, vložte ju do ľubovoľného chatového asistenta a potom sem prilepte jej odpoveď. Nie je potrebný žiadny poskytovateľ ani kľúč API."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντιγράψτε ένα πλήρες μήνυμα, επικολλήστε το σε οποιονδήποτε βοηθό συνομιλίας και, στη συνέχεια, επικολλήστε την απάντησή του εδώ. Δεν απαιτείται πάροχος ή κλειδί API."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiera en fullständig uppmaning, klistra in den i valfri chattassistent och klistra sedan tillbaka svaret här. Ingen leverantör eller API-nyckel behövs."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiér en komplet prompt, indsæt den i en chatassistent, og indsæt derefter svaret her igen. Ingen udbyder eller API-nøgle er nødvendig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopier en fullstendig forespørsel, lim den inn i en chat-assistent, og lim deretter inn svaret tilbake her. Ingen leverandør eller API-nøkkel er nødvendig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioi täydellinen kehote, liitä se mihin tahansa chat-avustajaan ja liitä sen vastaus takaisin tähän. Palveluntarjoajaa tai API-avainta ei tarvita."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin perintah lengkap, tempelkan ke asisten obrolan mana pun, lalu tempelkan balasannya kembali di sini. Tidak diperlukan penyedia atau kunci API."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao chép lời nhắc hoàn chỉnh, dán vào bất kỳ trợ lý trò chuyện nào, sau đó dán lại câu trả lời vào đây. Không cần nhà cung cấp hoặc khóa API."
          }
        }
      }
    },
