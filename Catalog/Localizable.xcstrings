    "Turn on analytics to see your streak, your speed, and your week. It stays on this phone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte die Analyse ein und sieh deine Serie, dein Tempo und deine Woche. Alles bleibt auf diesem Handy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las estadísticas para ver tu racha, tu velocidad y tu semana. Todo se queda en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active les statistiques pour voir ta série, ta vitesse et ta semaine. Tout reste sur ce téléphone."
          }
        },
        "hu": {
          "stringUnit": {
