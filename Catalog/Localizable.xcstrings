    "Each tap moves to the next selected layout or extra page. Pick at least two.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada toque pasa a la siguiente distribución o página adicional seleccionada. Elige al menos dos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque appui passe à la disposition ou page supplémentaire sélectionnée suivante. Choisis-en au moins deux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Tippen wechselt zum nächsten ausgewählten Layout oder zur nächsten Zusatzseite. Wähle mindestens zwei aus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni tocco passa alla disposizione o pagina aggiuntiva selezionata successiva. Scegline almeno due."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada toque avança para a disposição ou página adicional selecionada seguinte. Escolha pelo menos duas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое нажатие переключает на следующую выбранную раскладку или дополнительную страницу. Выберите хотя бы две."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap ketikan beralih ke susun atur atau halaman tambahan dipilih yang seterusnya. Pilih sekurang-kurangnya dua."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden koppintás a következő kiválasztott kiosztásra vagy extra oldalra vált. Válassz legalább kettőt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップするたびに、選択した次の配列や追加ページに切り替わります。2つ以上選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次轻点都会切换到下一个选中的布局或附加页面。请至少选择两个。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭할 때마다 선택한 다음 배열 또는 추가 페이지로 전환합니다. 두 개 이상 선택하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga puudutus lülitab järgmisele valitud paigutusele või lisalehele. Vali vähemalt kaks."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare atingere trece la următorul aspect selectat sau la pagina suplimentară. Alegeți cel puțin două."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke tik gaat naar de volgende geselecteerde lay-out of extra pagina. Kies er minstens twee."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次輕點都會切換到下一個選中的佈局或附加頁面。請至少選擇兩個。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke tik skuif na die volgende geselekteerde uitleg of ekstra bladsy. Kies minstens twee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde dotknięcie powoduje przejście do następnego wybranego układu lub dodatkowej strony. Wybierz przynajmniej dwa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне торкання переходить до наступного вибраного макета або додаткової сторінки. Виберіть принаймні два."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her dokunuşta bir sonraki seçilen düzene veya ekstra sayfaya geçilir. En az iki tane seçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každým klepnutím se přesunete na další vybrané rozvržení nebo další stránku. Vyberte alespoň dva."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každým klepnutím sa presuniete na ďalšie vybraté rozloženie alebo ďalšiu stranu. Vyberte aspoň dve."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε πάτημα μετακινείται στην επόμενη επιλεγμένη διάταξη ή επιπλέον σελίδα. Διαλέξτε τουλάχιστον δύο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje tryck flyttas till nästa valda layout eller extra sida. Välj minst två."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert tryk flyttes til det næste valgte layout eller ekstra side. Vælg mindst to."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert trykk går til neste valgte layout eller ekstra side. Velg minst to."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen napautus siirtyy seuraavalle valitulle asettelulle tai lisäsivulle. Valitse vähintään kaksi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap ketukan berpindah ke tata letak yang dipilih berikutnya atau halaman tambahan. Pilih setidaknya dua."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lần nhấn sẽ di chuyển đến bố cục đã chọn tiếp theo hoặc trang bổ sung. Chọn ít nhất hai."
          }
        }
      }
    },
