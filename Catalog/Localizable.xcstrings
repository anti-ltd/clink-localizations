            "value": "Kies Laat toe, en iOS hou op vra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf „Erlauben“ stellen, dann fragt iOS nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige «Permitir» y iOS deja de preguntar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali Luba ja iOS lõpetab küsimise."
          }
        },
