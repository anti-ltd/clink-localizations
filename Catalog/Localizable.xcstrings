    "Japanese reading data used to build the offline kana-to-Kanji conversion table.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Japannese leesdata wat gebruik word om die vanlyn kana-na-Kanji-omskakelingstabel te bou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Japanische Lesungsdaten, aus denen die Offline-Umwandlungstabelle von Kana zu Kanji entstand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de lecturas japonesas usados para crear la tabla de conversión de kana a kanji sin conexión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaapani loenguandmed, mille põhjal loodi ühenduseta kana-kanji teisendustabel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données de lectures japonaises utilisées pour créer la table de conversion kana-kanji hors ligne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
