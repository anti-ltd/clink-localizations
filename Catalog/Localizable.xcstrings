    "%lld more differ from the defaults: layouts, languages, and other settings without a single switch to point at.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld weitere weichen von den Standards ab: Layouts, Sprachen und andere Einstellungen ohne einen einzelnen Schalter, auf den man zeigen könnte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otros %lld difieren de los valores por defecto: disposiciones, idiomas y otros ajustes sin un control concreto al que apuntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld autres diffèrent des valeurs par défaut : dispositions, langues et autres réglages sans un interrupteur précis à montrer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "További %lld tér el az alapértelmezéstől: elrendezések, nyelvek és más beállítások, amikhez nem tartozik egyetlen kapcsoló sem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altre %lld si discostano dai valori predefiniti: disposizioni, lingue e altre impostazioni senza un singolo interruttore da indicare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかに %lld 件が初期値と異なります。レイアウトや言語など、ひとつのスイッチでは示せない設定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 밖에 %lld개가 기본값과 다릅니다. 배열, 언어처럼 스위치 하나로 가리킬 수 없는 설정입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lagi berbeza daripada tetapan asal: susun atur, bahasa dan tetapan lain yang tiada satu suis khusus untuk ditunjuk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Outras %lld diferem das predefinições: esquemas, idiomas e outras definições sem um controlo concreto para apontar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё %lld отличаются от стандартных: раскладки, языки и другие настройки, у которых нет отдельного переключателя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另有 %lld 项与默认值不同：布局、语言，以及其他没有单独开关可指的设置。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld veel erinevad vaikeväärtustest: paigutused, keeled ja muud seaded, millel pole ühte ühist lülitit."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld meer verskil van die verstekke: uitlegte, tale en ander instellings sonder 'n enkele skakelaar om na te wys."
          }
        }
      }
    },
