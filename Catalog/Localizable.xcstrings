    "Keys that sit beside the space bar on every layout, in every language. They stay put when you switch.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutels wat langs die spasiebalk sit op elke uitleg, in elke taal. Hulle bly sit wanneer jy oorskakel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasten, die in jedem Layout und jeder Sprache neben der Leertaste sitzen. Sie bleiben, wenn du wechselst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas que van junto a la barra espaciadora en todas las disposiciones y todos los idiomas. No se mueven al cambiar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvid, mis asuvad tühikuklahvi kõrval igas paigutuses ja igas keeles. Need jäävad paigale, kui vahetad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des touches placées à côté de la barre d’espace dans toutes les dispositions et toutes les langues. Elles restent en place quand tu changes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Billentyűk, amelyek minden elrendezésben és minden nyelven a szóköz mellett ülnek. Váltáskor is a helyükön maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasti che stanno accanto alla barra spaziatrice in ogni layout e in ogni lingua. Restano al loro posto quando cambi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのレイアウトでも、どの言語でも、スペースキーの隣に並ぶキーです。切り替えても動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 배열, 모든 언어에서 스페이스 바 옆에 놓이는 키입니다. 전환해도 자리를 지킵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci yang duduk di sebelah bar ruang pada setiap susun atur, dalam setiap bahasa. Ia kekal di tempatnya apabila anda bertukar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas que ficam ao lado da barra de espaço em todos os esquemas e em todos os idiomas. Não saem do sítio quando mudas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши, которые стоят рядом с пробелом в любой раскладке и на любом языке. При переключении они остаются на месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每一种布局、每一种语言里都紧挨空格键的按键。切换时它们不会挪动。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Taste care stau lângă bara de spațiu pe fiecare aspect, în fiecare limbă. Ei rămân pe loc când schimbi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toetsen die in elke lay-out, in elke taal, naast de spatiebalk staan. Ze blijven zitten als je overstapt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每一種佈局、每一種語言裡都緊挨空格鍵的按鍵。切換時它們不會挪動。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisze znajdujące się obok spacji w każdym układzie i w każdym języku. Pozostają na miejscu po zmianie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіші, розташовані поруч із пробілом на будь-якій розкладці, на будь-якій мові. Вони залишаються на місці, коли ви змінюєте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her dilde, her düzende boşluk çubuğunun yanında bulunan tuşlar. Geçiş yaptığınızda yerinde kalırlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesy, které jsou umístěny vedle mezerníku na každém rozvržení, v každém jazyce. Když přepnete, zůstanou na místě."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesy, ktoré sa nachádzajú vedľa medzerníka na každom rozložení, v každom jazyku. Keď prepnete, zostanú na mieste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλήκτρα που βρίσκονται δίπλα στη γραμμή διαστήματος σε κάθε διάταξη, σε κάθε γλώσσα. Μένουν στη θέση τους όταν αλλάζετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangenter som sitter bredvid mellanslagstangenten på varje layout, på alla språk. De stannar kvar när du byter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Taster, der sidder ved siden af mellemrumstasten på hvert layout, på alle sprog. De bliver siddende, når du skifter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Taster som sitter ved siden av mellomromstasten på hver layout, på alle språk. De blir liggende når du bytter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäimet, jotka sijaitsevat välilyöntinäppäimen vieressä kaikissa asetteluissa, kaikilla kielillä. Ne pysyvät paikallaan, kun vaihdat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol yang berada di samping bilah spasi pada setiap tata letak, dalam setiap bahasa. Mereka tetap diam saat Anda beralih."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím nằm cạnh phím cách trên mọi bố cục, trong mọi ngôn ngữ. Họ ở lại khi bạn chuyển đổi."
          }
        }
      }
    },
    "Keys twinkle in and out at random.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutels glinster willekeurig in en uit."
