    "Translate can use Apple's on-device AI. Your text is not sent to us.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate kan Apple se KI op die toestel gebruik. Jou teks word nie aan ons gestuur nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzen kann Apples KI direkt auf dem Gerät nutzen. Dein Text wird nicht an uns geschickt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducir puede usar la IA de Apple en el dispositivo. Tu texto no llega hasta nosotros."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlke võib kasutada Apple’i seadmesisest TI-d. Sinu teksti ei saadeta meile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduire peut utiliser l'IA sur l'appareil d'Apple. Ton texte ne nous est pas envoyé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Fordítás használhatja az Apple eszközön futó MI-jét. A szöveged nem jut el hozzánk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduci può usare l'IA di Apple sul dispositivo. Il tuo testo non ci viene inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳は Apple の端末内 AI を使えます。テキストがこちらに送られることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역은 Apple 온디바이스 AI를 쓸 수 있어요. 입력한 글은 저희한테 보내지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemah boleh guna AI pada peranti Apple. Teks anda tidak dihantar kepada kami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Traduzir pode usar a IA no dispositivo da Apple. O teu texto não nos é enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод может использовать ИИ Apple на устройстве. Ваш текст нам не отправляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译可以用 Apple 设备端 AI。你的文字不会发给我们。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate poate folosi IA de pe dispozitiv de la Apple. Textul dvs. nu ne este trimis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate kan de AI op het apparaat van Apple gebruiken. Uw tekst wordt niet naar ons verzonden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻譯可以用 Apple 裝置端 AI。你的文字不會發給我們。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tłumacz może korzystać ze sztucznej inteligencji Apple na urządzeniu. Twój tekst nie został do nas wysłany."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекладач може використовувати AI від Apple на пристрої. Ваш текст нам не надіслано."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri, Apple'ın cihazdaki yapay zekasını kullanabilir. Metniniz bize gönderilmedi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překladač může používat umělou inteligenci zařízení Apple. Váš text nám nebyl zaslán."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekladač môže používať AI na zariadení od spoločnosti Apple. Váš text sa nám neposiela."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Translate μπορεί να χρησιμοποιήσει το AI της Apple στη συσκευή. Το κείμενό σας δεν μας αποστέλλεται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate kan använda Apples on-device AI. Din text skickas inte till oss."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate kan bruge Apples on-device AI. Din tekst sendes ikke til os."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate kan bruke Apples AI på enheten. Teksten din sendes ikke til oss."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kääntäjä voi käyttää Applen laitteessa olevaa tekoälyä. Tekstiäsi ei lähetetä meille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan dapat menggunakan AI di perangkat Apple. Teks Anda tidak dikirimkan kepada kami."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch có thể sử dụng AI trên thiết bị của Apple. Văn bản của bạn không được gửi cho chúng tôi."
          }
        }
      }
    },
