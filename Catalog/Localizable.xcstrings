    "AI features layer on top of the existing engine. Offline suggestions and corrections keep working as normal.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Funktionen legen sich über die vorhandene Engine. Offline-Vorschläge und -Korrekturen laufen ganz normal weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones de IA se suman al motor que ya tienes. Las sugerencias y correcciones sin conexión siguen funcionando con normalidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctions d'IA s'ajoutent par-dessus le moteur existant. Les suggestions et corrections hors ligne continuent de marcher normalement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az MI-funkciók a meglévő motorra épülnek. Az offline javaslatok és javítások a szokásos módon működnek tovább."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le funzioni IA si aggiungono al motore esistente. Suggerimenti e correzioni offline continuano a funzionare come sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 機能は既存のエンジンの上に重なります。オフラインの候補や修正はこれまでどおり動きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 기능은 기존 엔진 위에 더해져요. 오프라인 추천과 수정은 평소대로 계속 작동해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciri AI menambah pada enjin sedia ada. Cadangan dan pembetulan luar talian terus berfungsi macam biasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As funcionalidades de IA acrescentam-se ao motor existente. As sugestões e correções offline continuam a funcionar como sempre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Функции ИИ надстраиваются над обычным движком. Офлайн-подсказки и исправления работают как всегда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 功能叠加在现有引擎之上。离线建议和更正照常工作。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "TI-funktsioonid lasuvad olemasoleval mootoril. Ühenduseta soovitused ja parandused töötavad nagu tavaliselt edasi."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "KI beskik oor laag bo-op die bestaande enjin. Vanlyn voorstelle en regstellings bly normaalweg werk."
          }
        }
      }
    },
    "AI finishes the word you're typing. AI picks are marked with a ✨.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI vervollständigt das Wort, das du tippst. KI-Vorschläge sind mit einem ✨ markiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA completa la palabra que estás escribiendo. Las sugerencias de IA llevan una ✨."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA termine le mot que tu tapes. Les suggestions IA sont marquées d'une ✨."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AI befejezi a szót, amit gépelsz. Az AI-javaslatok ✨ jellel vannak megjelölve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA completa la parola che stai digitando. I suggerimenti IA sono contrassegnati con una ✨."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力中の単語をAIが補完します。AIの候補には✨が付きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI가 입력 중인 단어를 완성합니다. AI 추천에는 ✨이 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "AI melengkapkan perkataan yang anda taip. Cadangan AI ditandai dengan ✨."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA completa a palavra que estás a escrever. As sugestões de IA têm uma ✨."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ дописывает слово, которое вы печатаете. Варианты от ИИ отмечены значком ✨."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 会补全你正在输入的单词。AI 建议带有 ✨ 标记。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "TI lõpetab sõna, mida sa tipid. TI-valikud on märgitud märgiga ✨."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "KI voltooi die woord wat jy tik. KI-keuse is met 'n ✨ gemerk."
          }
        }
      }
    },
    "AI help, translate, clipboard history and your pets, right on the keyboard.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Hilfe, Übersetzen, Zwischenablage-Verlauf und deine Haustiere, direkt auf der Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda con IA, traducción, historial del portapapeles y tus mascotas, directamente en el teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide IA, traduction, historique du presse-papiers et tes compagnons, directement sur le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "MI-segítség, fordítás, vágólap-előzmények és a kisállataid, közvetlenül a billentyűzeten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuto IA, traduzione, cronologia degli appunti e i tuoi animaletti, direttamente sulla tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIアシスト、翻訳、クリップボード履歴、ペットもキーボードでそのまま。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 도우미, 번역, 클립보드 기록, 펫까지 키보드에서 바로."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantuan AI, terjemahan, sejarah papan keratan dan peliharaan anda, terus pada papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda de IA, tradução, histórico da área de transferência e as tuas mascotes, mesmo no teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помощь ИИ, перевод, история буфера обмена и ваши питомцы — прямо на клавиатуре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
