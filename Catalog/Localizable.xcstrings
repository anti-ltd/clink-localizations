    "Handwriting is off. Turn it on to use and customize it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handschrift ist aus. Schalte sie ein, um sie zu nutzen und anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura a mano está desactivada. Actívala para usarla y personalizarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écriture manuscrite est désactivée. Active-la pour l'utiliser et la personnaliser."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kézírás ki van kapcsolva. Kapcsold be, hogy használhasd és beállíthasd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scrittura a mano è disattivata. Attivala per usarla e personalizzarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手書き入力はオフです。オンにすると使えて、設定も変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손글씨가 꺼져 있어요. 켜면 쓰고 설정도 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulisan tangan dimatikan. Hidupkannya untuk guna dan sesuaikannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A escrita manual está desligada. Liga-a para a usares e personalizares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рукописный ввод выключен. Включите его, чтобы пользоваться и настраивать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手写已关闭。打开后就能使用并调整设置。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Käsikiri on väljas. Lülita see sisse, et kasutada ja kohandada."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Handskrif is af. Skakel dit aan om dit te gebruik en aan te pas."
          }
        }
      }
    },
    "Handwriting turns the keyboard into a pad: write, and it becomes text.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Handschrift macht aus der Tastatur einen Block: Du schreibst, und daraus wird Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escritura a mano convierte el teclado en un bloc: escribes y se vuelve texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écriture manuscrite transforme le clavier en bloc-notes : tu écris, ça devient du texte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kézírás jegyzettömbbé alakítja a billentyűzetet: írsz, és szöveg lesz belőle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scrittura a mano trasforma la tastiera in un blocco: scrivi e diventa testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「手書き入力」はキーボードをメモ帳のように変えます。書いた文字がそのままテキストになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손글씨는 키보드를 필기판으로 바꿔 줍니다. 쓰면 그대로 텍스트가 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulisan tangan menukar papan kekunci menjadi pad: anda menulis, dan ia menjadi teks."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A escrita à mão transforma o teclado num bloco: escreves e vira texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рукописный ввод превращает клавиатуру в площадку для письма: пишете — получается текст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“手写”把键盘变成一块写字板：你写，它转成文字。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Käsikiri muudab klaviatuuri padjaks: kirjuta ja sellest saab tekst."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Handskrif verander die sleutelbord in 'n blok: skryf, en dit word teks."
          }
        }
      }
    },
