          }
        }
      }
    },
    "Keep what this panel holds between openings, and between keyboard launches.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep what this panel holds between openings, and between keyboard launches."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou wat hierdie paneel bevat tussen kere wat dit oopgemaak word, en tussen sleutelbordsessies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält den Inhalt dieses Panels, wenn du es schließt und wieder öffnest – auch über Tastatursitzungen hinweg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva lo que contiene este panel al cerrarlo y volver a abrirlo, y entre sesiones del teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoiab selle paneeli sisu alles sulgemiste vahel ja ka klaviatuuri uuesti avamisel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve le contenu de ce panneau d'une ouverture à l'autre, et d'une session du clavier à l'autre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megőrzi a panel tartalmát a megnyitások között, és a billentyűzet újraindítása után is."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva il contenuto di questo pannello tra un'apertura e l'altra, e tra le sessioni della tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパネルの内容を、閉じて開き直しても、キーボードを起動し直しても保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 패널의 내용을 다시 열 때도, 키보드를 다시 실행할 때도 그대로 유지합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekalkan kandungan panel ini antara setiap kali dibuka, dan antara sesi papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o que este painel contém entre aberturas e entre sessões do teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет содержимое панели между открытиями и между запусками клавиатуры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在关闭后重新打开，以及键盘重新启动后，都保留此面板中的内容。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrați ceea ce deține acest panou între deschideri și între lansări de tastatură."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar wat dit paneel bevat tussen openingen en tussen toetsenbordlanceringen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在關閉後重新開啟，以及鍵盤重新啟動後，都保留此面板中的內容。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj zawartość tego panelu między otwarciami i między uruchomieniami klawiatury."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігайте те, що містить ця панель, між відкриттями та натисканнями клавіатури."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu panelin açılışlar arasında ve klavye açılışları arasında tuttuğu şeyleri koruyun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchovávejte to, co tento panel obsahuje, mezi otevřeními a mezi spuštěními klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechajte to, čo tento panel obsahuje, medzi otvormi a medzi spustením klávesnice."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατηρήστε αυτό που κρατά αυτό το πλαίσιο μεταξύ των ανοιγμάτων και μεταξύ των εκκινήσεων του πληκτρολογίου."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll vad den här panelen rymmer mellan öppningar och mellan tangentbordsstarter."
          }
        },
