    "Predictions, autocorrect, and swipe decoding all run in the app. No server.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhersagen, Autokorrektur und Wischeingabe laufen alle in der App. Kein Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predicciones, autocorrección y deslizamiento van dentro de la app. Sin servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prédictions, la correction auto et le décodage par glissement marchent tous dans l'app. Pas de serveur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A javaslatok, az automatikus javítás és a csúsztatásos gépelés mind az appban fut. Nincs szerver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsioni, correzione automatica e swipe girano tutti nell'app. Nessun server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測も自動修正も、スワイプ入力の解析も、すべてアプリの中で動きます。サーバーは使いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예측, 자동 수정, 스와이프 인식이 전부 앱 안에서 돌아가요. 서버는 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramalan, autobetul dan penyahkodan leret, semuanya berjalan dalam app. Tiada pelayan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsões, correção automática e descodificação por deslize correm todas na app. Sem servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предсказания, автокоррекция и разбор скольжения — всё работает внутри приложения. Без сервера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联想、自动更正和滑动识别都在应用里跑，不走服务器。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennustused, automaatparandus ja pühkimise dekodeerimine töötavad kõik rakenduses. Serverit pole."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voorspellings, outokorreksie en vee-dekodering word alles in die toepassing uitgevoer. Geen bediener nie."
          }
        }
      }
    },
    "Predicts your next letter and silently enlarges likely keys without moving them, like the native keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagt deinen nächsten Buchstaben voraus und vergrößert wahrscheinliche Tasten ganz unauffällig, ohne sie zu verschieben, wie die native Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predice tu siguiente letra y agranda sin ruido las teclas probables, sin moverlas, como el teclado nativo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prédit ta prochaine lettre et agrandit discrètement les touches probables sans les bouger, comme le clavier natif."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjósolja a következő betűt, és csendben megnöveli a valószínű billentyűket anélkül, hogy elmozdítaná őket, mint a natív billentyűzet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevede la lettera che scriverai e ingrandisce di nascosto i tasti probabili senza spostarli, come la tastiera nativa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "純正キーボードのように、次に打つ文字を予測して、来そうなキーを動かさずにそっと大きくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 키보드처럼 다음 글자를 예측해서, 키를 옮기지 않고 나올 만한 키를 슬쩍 키워요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramal huruf anda seterusnya dan besarkan kekunci yang berkemungkinan secara senyap tanpa mengalihkannya, macam papan kekunci asli."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevê a tua próxima letra e aumenta discretamente as teclas prováveis sem as mexer, como o teclado nativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предсказывает следующую букву и незаметно увеличивает вероятные клавиши, не сдвигая их, — как родная клавиатура."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预测你的下一个字母，像原生键盘那样悄悄放大可能的键，但不挪动它们。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennustab sinu järgmise tähe ja suurendab vaikselt tõenäolisi klahve neid liigutamata, nagu süsteemne klaviatuur."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voorspel jou volgende letter en vergroot stilweg waarskynlike sleutels sonder om hulle te skuif, soos die inheemse sleutelbord."
          }
        }
      }
    },
