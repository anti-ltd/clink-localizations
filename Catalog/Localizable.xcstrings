          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dürtmek için evcil hayvana dokunun. Oraya taşımak için bir köşeye dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na zvíře šťouchnete. Klepnutím na roh jej tam přesunete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na domáceho maznáčika, aby ste ho štuchli. Klepnutím na roh ho tam presuniete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε το κατοικίδιο για να το σπρώξετε. Αγγίξτε μια γωνία για να τη μετακινήσετε εκεί."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på husdjuret för att peta i det. Tryck på ett hörn för att flytta det dit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på kæledyret for at stikke i det. Tryk på et hjørne for at flytte det dertil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på kjæledyret for å stikke i det. Trykk på et hjørne for å flytte det dit."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta lemmikkiä pistääksesi sitä. Napauta kulmaa siirtääksesi sen sinne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk hewan peliharaan untuk menyodoknya. Ketuk salah satu sudut untuk memindahkannya ke sana."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
