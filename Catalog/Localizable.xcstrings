    "Each letter goes on the key its romanization names. Longer ones, like “sh”, are a hold away.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada letra va en la tecla que indica su romanización. Las más largas, como «sh», se obtienen manteniendo pulsado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque lettre va sur la touche de sa romanisation. Les plus longues, comme « sh », s’obtiennent par un appui prolongé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Buchstabe landet auf der Taste seiner Umschrift. Längere wie „sh“ erreichst du durch langes Drücken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni lettera va sul tasto indicato dalla sua traslitterazione. Quelle più lunghe, come “sh”, si ottengono tenendo premuto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada letra vai na tecla indicada pela sua romanização. As mais longas, como “sh”, ficam a um toque longo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая буква попадает на клавишу своей латинской записи. Более длинные, вроде «sh», вводятся долгим нажатием."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap huruf diletakkan pada kekunci yang dinamakan oleh romanisasinya. Yang lebih panjang, seperti “sh”, dicapai dengan tekan lama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden betű arra a billentyűre kerül, amelyet a latin betűs átírása megnevez. A hosszabbak, például az „sh”, nyomva tartással érhetők el."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各文字はローマ字表記が示すキーに配置されます。「sh」のように長いものは長押しで入力できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个字母会放在其拉丁转写对应的按键上。像“sh”这样较长的转写，长按即可输入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 글자는 로마자 표기에 해당하는 키에 배치됩니다. “sh”처럼 긴 것은 길게 눌러 입력합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga täht läheb klahvile, mille nimetab tema latinisatsioon. Pikemad, nagu „sh“, saab kätte pikalt vajutades."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare literă merge pe cheie numele sale de romanizare. Cele mai lungi, cum ar fi „sh”, sunt la o distanță."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke letter gaat op de sleutel met de romaniseringsnaam. Langere, zoals \"sh\", zijn een houvast."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個字母會放在其拉丁轉寫對應的按鍵上。像“sh”這樣較長的轉寫，長按即可輸入。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke letter word geplaas op die sleutel wat deur sy romanisering aangedui word. Langer kombinasies, soos \"sh\", is beskikbaar deur die sleutel in te hou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda litera znajduje się na kluczu, a jej nazwy latynizacji. Dłuższe, takie jak „sh”, są trzymane z daleka."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна літера йде на клавіші, її назви романізації. Довші, як-от «sh», не можна використовувати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her harf, anahtarın romanizasyon adlarına devam eder. \"Ş\" gibi daha uzun olanlar biraz uzaktadır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé písmeno má na klíči svá romanizační jména. Delší, jako „sh“, jsou zadržovací."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé písmeno má na kľúči svoje romanizačné mená. Dlhšie, ako napríklad „sh“, sú zadržané."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε γράμμα πηγαίνει στο κλειδί με τα ρομανικά του ονόματα. Τα μακρύτερα, όπως το \"sh\", απέχουν πολύ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje bokstav går på nyckeln dess romaniseringsnamn. Längre, som \"sh\", är ett håll borta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert bogstav står på tasten dens romaniseringsnavne. Længere, som \"sh\", er et hold væk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver bokstav går på nøkkelen dens romaniseringsnavn. Lengre, som \"sh\", er et hold unna."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen kirjain menee avaimeen sen latinisointinimet. Pidemmät, kuten \"sh\", ovat otteen päässä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap huruf menggunakan kunci nama romanisasinya. Kalimat yang lebih panjang, seperti “sh”, bersifat penahan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi chữ cái nằm trên phím tên theo cách La Mã hóa của nó. Những cái dài hơn, chẳng hạn như “sh”, thì không nên dùng nữa."
          }
        }
      }
    },
