          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt het op elk gewenst moment intrekken via Instellingen → Algemeen → Toetsenbord → Clink."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時可以在設定 → 通用 → 鍵盤 → Clink 裡關掉。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz ją w każdej chwili odwołać w Ustawieniach → Ogólne → Klawiatura → Clink."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
