        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz cae por las columnas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgus langeb veergudesse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière tombe le long des colonnes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fény lefolyik az oszlopokon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La luce scende lungo le colonne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光が列を流れ落ちます。"
          }
        },
        "ko": {
