    "Add tools, text shortcuts and keyboard effects in one place.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Werkzeuge, Text-Kurzbefehle und Tastatureffekte an einem Ort hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade herramientas, atajos de texto y efectos del teclado en un solo lugar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa tööriistu, teksti otseteid ja klaviatuuriefekte ühest kohast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
