    "In a hurry, hold a row on the Tools tab to flip it on or off without opening it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn es schnell gehen muss: halte eine Zeile im Tab „Werkzeuge“ gedrückt, um sie umzuschalten, ohne sie zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con prisa: mantén pulsada una fila en la pestaña Herramientas para activarla o desactivarla sin abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressé ? Maintiens une ligne dans l'onglet Outils pour l'activer ou la désactiver sans l'ouvrir."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha sietsz: tarts nyomva egy sort az Eszközök lapon, és be- vagy kikapcsolod anélkül, hogy megnyitnád."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di fretta: tieni premuta una riga nella scheda Strumenti per accenderla o spegnerla senza aprirla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "急ぐときは、「ツール」タブの行を長押しすれば、開かずにオン・オフを切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "급할 때는 도구 탭에서 목록을 길게 눌러, 열지 않고 켜고 끌 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tergesa-gesa, tahan satu baris dalam tab Alat untuk menghidupkan atau mematikannya tanpa membukanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com pressa: mantém uma linha premida no separador Ferramentas para a ligar ou desligar sem a abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если некогда — удержите строку на вкладке «Инструменты», чтобы включить или выключить её, не заходя внутрь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "赶时间的话，在“工具”标签页长按某一行，不打开也能开关它。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui kiire on, hoia Tööriistade kaardil rida all, et see avamata sisse või välja lülitada."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou inderhaas 'n ry op die Tools-oortjie om dit aan of af te draai sonder om dit oop te maak."
          }
        }
      }
    },
    "In any app, hold the globe key and pick Clink.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cualquier app, mantén pulsada la tecla del globo y elige Clink."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans n'importe quelle app, maintiens la touche globe et choisis Clink."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte in einer beliebigen App die Globustaste gedrückt und wähle Clink."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In qualsiasi app, tieni premuto il tasto del globo e scegli Clink."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em qualquer app, mantém premida a tecla do globo e escolhe Clink."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam mana-mana app, tekan lama kekunci glob dan pilih Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármelyik appban tartsd lenyomva a földgömböt, majd válaszd a Clinket."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリでも地球儀キーを長押ししてClinkを選びます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意 App 中，长按地球键并选择 Clink。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 앱에서든 지구본 키를 길게 누르고 Clink를 선택하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Igas rakenduses hoia gloobusklahvi ja vali Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В любом приложении удерживайте клавишу с глобусом и выберите Clink."
          }
        },
        "af": {
          "stringUnit": {
