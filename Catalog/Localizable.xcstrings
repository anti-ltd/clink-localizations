    "Time between each deletion when rapid-delete starts. Higher is slower.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit zwischen den einzelnen Löschungen, wenn das Schnelllöschen anläuft. Höher heißt langsamer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo entre cada borrado cuando empieza el borrado rápido. Cuanto más alto, más lento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai entre chaque suppression quand la suppression rapide démarre. Plus c'est élevé, plus c'est lent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyi idő teljen el a törlések között, ha beindul a gyorstörlés. Nagyobb érték lassabb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo tra un'eliminazione e l'altra quando parte la cancellazione rapida. Più alto, più lento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高速削除が始まってからの、1文字ずつ消す間隔です。大きいほどゆっくりになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 삭제가 시작된 뒤 삭제 사이의 간격이에요. 높을수록 느려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa antara setiap padaman apabila padam pantas bermula. Lebih tinggi, lebih perlahan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo entre cada apagamento quando o apagar rápido começa. Mais alto é mais lento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Промежуток между удалениями при быстром удалении. Больше — медленнее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速删除开始后，每次删除之间的间隔。值越大越慢。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aeg iga kustutuse vahel, kui kiirkustutamine algab. Kõrgem on aeglasem."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tyd tussen elke uitvee wanneer vinnige uitvee begin. Hoër is stadiger."
          }
        }
      }
    },
