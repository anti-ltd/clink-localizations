    "Clink asks to confirm it's you before showing what's stored.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink vra om te bevestig dat dit jy is voordat jy wys wat gestoor is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink fragt nach einer Bestätigung, bevor Gespeichertes angezeigt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink pide confirmar que eres tú antes de mostrar lo guardado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink palub enne salvestatu kuvamist kinnitada, et see oled sina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink demande de confirmer que c’est bien toi avant d’afficher ce qui est stocké."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink megerősítést kér, mielőtt megmutatja a tárolt adatokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink chiede di confermare che sei tu prima di mostrare ciò che è salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されている内容を表示する前に、Clinkが本人確認を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink는 저장된 내용을 표시하기 전에 본인 확인을 요청합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink meminta pengesahan bahawa ini anda sebelum menunjukkan apa yang disimpan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink pede para confirmar que és tu antes de mostrar o que está guardado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink просит подтвердить, что это вы, прежде чем показать сохранённое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在显示已存储内容前，Clink 会要求确认是你本人。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink vă cere să confirme identitatea dvs. înainte de a afișa ceea ce este stocat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink vraagt om bevestiging dat jij het bent voordat je laat zien wat er is opgeslagen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在顯示已儲存內容前，Clink 會要求確認是你本人。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink prosi o potwierdzenie, że to Ty, zanim pokaże, co jest zapisane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink просить підтвердити вашу особу, перш ніж показати, що зберігається."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink, neyin saklandığını göstermeden önce siz olduğunuzu onaylamanızı ister."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink vás požádá o potvrzení, že jste to vy, než ukáže, co je uloženo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink vás pred zobrazením uloženého obsahu požiada o potvrdenie, že ste to vy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Clink ζητά να επιβεβαιώσει ότι είστε εσείς πριν εμφανίσει τι είναι αποθηκευμένο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ber att bekräfta att det är du innan den visar vad som är lagrat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink beder om at bekræfte, at det er dig, før den viser, hvad der er gemt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ber om å bekrefte at det er deg før den viser hva som er lagret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink pyytää vahvistamaan henkilöllisyytesi ennen kuin näyttää, mitä on tallennettu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink meminta konfirmasi bahwa ini memang Anda sebelum menunjukkan apa yang disimpan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink yêu cầu xác nhận đó là bạn trước khi hiển thị nội dung được lưu trữ."
          }
        }
      }
    },
    "Clink can show what Cling is holding but not change it. Turn on write access in Cling under Connected apps.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kan wys wat Cling vashou, maar dit nie verander nie. Skakel skryftoegang in Cling aan onder Gekoppelde programme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kann zeigen, was Cling hält, es aber nicht ändern. Aktiviere den Schreibzugriff in Cling unter Verbundene Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink puede mostrar lo que guarda Cling, pero no cambiarlo. Activa el acceso de escritura en Cling, en Apps conectadas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink saab näidata, mida Cling hoiab, aga ei saa seda muuta. Lülita Clingis jaotises Ühendatud rakendused sisse kirjutamisjuurdepääs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink peut afficher le contenu de Cling mais pas le modifier. Active l’accès en écriture dans Cling, sous Apps connectées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink meg tudja mutatni, mi van a Clingben, de módosítani nem. Kapcsold be az írási hozzáférést a Clingben, a Csatlakoztatott appok alatt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink può mostrare quello che contiene Cling ma non modificarlo. Attiva l'accesso in scrittura in Cling, in App connesse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink は Cling の内容を表示できますが、変更はできません。Cling の連携アプリで書き込みを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink는 Cling의 내용을 보여줄 수는 있지만 변경할 수는 없습니다. Cling의 연결된 앱에서 쓰기 권한을 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink boleh menunjukkan isi Cling tetapi tidak boleh mengubahnya. Hidupkan akses tulis dalam Cling di Apl bersambung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink pode mostrar o que o Cling tem, mas não alterar. Ative o acesso de escrita no Cling, em Apps ligadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink может показывать содержимое Cling, но не менять его. Включите доступ на запись в Cling, в разделе «Подключённые приложения»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 可以显示 Cling 里的内容，但不能修改。请在 Cling 的「已连接的 App」中开启写入权限。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink poate arăta ce deține Cling, dar nu îl poate schimba. Activați accesul la scriere în Cling sub Aplicații conectate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kan laten zien wat Cling vasthoudt, maar kan het niet veranderen. Schakel schrijftoegang in Cling in onder Verbonden apps."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 可以顯示 Cling 裡的內容，但不能修改。請在 Cling 的「已連線的 App」中開啟寫入許可權。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink może pokazać, co trzyma Cling, ale nie może tego zmienić. Włącz dostęp do zapisu w Cling w obszarze Połączone aplikacje."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink може показати, що тримає Cling, але не змінити це. Увімкніть доступ для запису в Cling у розділі «Підключені програми»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink, Cling'in tuttuğu şeyi gösterebilir ancak onu değiştiremez. Bağlı uygulamalar altında Cling'te yazma erişimini açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink může ukázat, co Cling drží, ale nemůže to změnit. Zapněte přístup pro zápis v Cling v části Připojené aplikace."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink môže ukázať, čo Cling drží, ale nemôže to zmeniť. Zapnite prístup na zápis v Cling v časti Pripojené aplikácie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Clink μπορεί να δείξει τι κρατά το Cling αλλά όχι να το αλλάξει. Ενεργοποιήστε την πρόσβαση εγγραφής στο Cling στην ενότητα Συνδεδεμένες εφαρμογές."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kan visa vad Cling håller i men inte ändra det. Aktivera skrivåtkomst i Cling under Anslutna appar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kan vise, hvad Cling holder, men ikke ændre det. Slå skriveadgang til i Cling under Forbundne apps."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kan vise hva Cling holder, men ikke endre det. Slå på skrivetilgang i Cling under Tilkoblede apper."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink voi näyttää, mitä Cling pitää hallussaan, mutta ei muuta sitä. Ota kirjoitusoikeus käyttöön Cling:ssä Yhdistetyt sovellukset -kohdassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink dapat menunjukkan apa yang dipegang Cling tetapi tidak mengubahnya. Aktifkan akses tulis di Cling pada Aplikasi yang terhubung."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink có thể hiển thị những gì Cling đang giữ nhưng không thay đổi nó. Bật quyền ghi trong Cling trong Ứng dụng được kết nối."
          }
        }
      }
    },
