          "stringUnit": {
            "state": "translated",
            "value": "Clipboard-ul este gol. Copiați mai întâi întregul răspuns al asistentului."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het klembord is leeg. Kopieer eerst het volledige antwoord van uw assistent."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿為空。請先複製助手的完整回覆。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die knipbord is leeg. Kopieer eers jou assistent se volledige antwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schowek jest pusty. Najpierw skopiuj całą odpowiedź asystenta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер обміну порожній. Спершу скопіюйте всю відповідь свого помічника."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pano boş. Önce asistanınızın yanıtının tamamını kopyalayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Schránka je prázdná. Nejprve zkopírujte celou odpověď asistenta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Schránka je prázdna. Najprv skopírujte celú odpoveď asistenta."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πρόχειρο είναι κενό. Αντιγράψτε πρώτα ολόκληρη την απάντηση του βοηθού σας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Urklippet är tomt. Kopiera din assistents hela svar först."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udklipsholderen er tom. Kopiér hele din assistents svar først."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utklippstavlen er tom. Kopier hele svaret til assistenten først."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leikepöytä on tyhjä. Kopioi ensin avustajasi koko vastaus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan klipnya kosong. Salin seluruh balasan asisten Anda terlebih dahulu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảng tạm trống. Trước tiên hãy sao chép toàn bộ câu trả lời của trợ lý."
          }
        }
      }
    },
    "The color behind the keys comes from your theme.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kleur agter die sleutels kom van jou tema af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Farbe hinter den Tasten kommt von deinem Design."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El color detrás de las teclas viene de tu tema."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Värv klahvide taga tuleb sinu teemast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur derrière les touches vient de ton thème."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk mögötti szín a témádból jön."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore dietro i tasti viene dal tuo tema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの後ろの色はテーマで決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 뒤의 색상은 테마에서 가져옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna di belakang kekunci datang daripada tema anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cor por trás das teclas vem do teu tema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвет за клавишами берётся из вашей темы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键后方的颜色来自你的主题。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Culoarea din spatele tastelor vine de la tema ta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kleur achter de toetsen komt uit jouw thema."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵後方的顏色來自你的主題。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolor za klawiszami pochodzi z Twojego motywu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Колір за клавішами походить від вашої теми."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşların arkasındaki renk temanızdan gelir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Barva za klávesami pochází z vašeho motivu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Farba za klávesmi pochádza z vašej témy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το χρώμα πίσω από τα πλήκτρα προέρχεται από το θέμα σας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Färgen bakom tangenterna kommer från ditt tema."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Farven bag tasterne kommer fra dit tema."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fargen bak nøklene kommer fra temaet ditt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäinten takana oleva väri tulee teemastasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna di balik tuts berasal dari tema Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màu đằng sau các phím xuất phát từ chủ đề của bạn."
          }
        }
      }
    },
    "The color, gradient or photo itself belongs to the theme, so you set it in the theme builder.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kleur, gradiënt of foto self behoort aan die tema, so jy stel dit in die temabouer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Farbe, der Verlauf oder das Foto selbst gehören zum Design — die stellst du im Design-Baukasten ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El color, el degradado o la foto en sí pertenecen al tema, así que se ajustan en el creador de temas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Värv, üleminek või foto ise kuulub teemale, seega määrad sa selle teema ehitajas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur, le dégradé ou la photo appartiennent au thème : tu les règles dans le créateur de thèmes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Maga a szín, a színátmenet vagy a fotó a témához tartozik, így azt a témaszerkesztőben állítod be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore, il gradiente o la foto appartengono al tema, quindi li imposti nel costruttore di temi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色やグラデーション、写真そのものはテーマのものなので、テーマビルダーで設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상, 그러데이션, 사진 자체는 테마의 것이라 테마 편집기에서 설정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna, gradien atau foto itu sendiri milik tema, jadi anda tetapkannya dalam pembina tema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cor, o gradiente ou a fotografia pertencem ao tema, por isso defines isso no criador de temas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сам цвет, градиент или фото принадлежат теме, поэтому задаются в редакторе тем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色、渐变和照片本身属于主题，在主题编辑器里设置。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Culoarea, gradientul sau fotografia în sine aparțin temei, așa că le setați în generatorul de teme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kleur, het verloop of de foto zelf hoort bij het thema, deze stel je dus in de themabouwer in."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顏色、漸變和照片本身屬於主題，在主題編輯器裡設定。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolor, gradient lub zdjęcie samo w sobie należy do motywu, więc ustawiasz je w kreatorze motywów."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сам колір, градієнт або фотографія належать до теми, тому ви встановлюєте їх у конструкторі тем."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rengin, degradenin veya fotoğrafın kendisi temaya aittir, dolayısıyla onu tema oluşturucuda siz ayarlarsınız."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samotná barva, přechod nebo fotka patří k tématu, takže si je nastavíte v nástroji theme builder."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Samotná farba, prechod alebo fotografia patria k téme, takže ju nastavíte v nástroji na vytváranie tém."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το χρώμα, η διαβάθμιση ή η ίδια η φωτογραφία ανήκουν στο θέμα, επομένως το ορίζετε στο πρόγραμμα δημιουργίας θεμάτων."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Själva färgen, gradienten eller fotot tillhör temat, så du ställer in det i temabyggaren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Selve farven, gradienten eller billedet hører til temaet, så du indstiller det i temabyggeren."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Selve fargen, gradienten eller bildet tilhører temaet, så du setter det i temabyggeren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Itse väri, liukuväri tai valokuva kuuluu teemaan, joten aseta se teeman rakennusohjelmassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna, gradien, atau foto itu sendiri adalah milik tema, jadi Anda mengaturnya di pembuat tema."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản thân màu sắc, độ dốc hoặc ảnh thuộc về chủ đề nên bạn đặt nó trong trình tạo chủ đề."
          }
        }
      }
    },
