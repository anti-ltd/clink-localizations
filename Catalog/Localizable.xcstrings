          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップするか指を滑らせると、引き継いだ色に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하거나 드래그하여 상속된 색상으로 되돌리세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik atau seret untuk mengembalikan warna yang diwarisi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ou desliza o dedo para repor a cor herdada."
          }
        },
        "ru": {
          "stringUnit": {
