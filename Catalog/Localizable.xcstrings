    "Percentages use your saved settings, never the last automated result. Supported size limits still apply.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los porcentajes se calculan sobre los ajustes guardados, nunca sobre el último resultado automático. Se respetan los límites de tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pourcentages utilisent les réglages enregistrés, jamais le dernier résultat automatisé. Les limites de taille restent applicables."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozente beziehen sich auf deine gespeicherten Einstellungen, nie auf das letzte Automationsergebnis. Die Größenlimits gelten weiterhin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le percentuali si riferiscono alle impostazioni salvate, mai all’ultimo risultato automatico. Restano validi i limiti di dimensione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As percentagens usam as definições guardadas, nunca o último resultado automático. Os limites de tamanho continuam a aplicar-se."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценты считаются от сохранённых настроек, а не от последнего результата автоматизации. Ограничения размеров сохраняются."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peratus menggunakan tetapan tersimpan, bukan hasil automasi terakhir. Had saiz masih terpakai."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A százalékok a mentett beállításokra vonatkoznak, soha nem az előző automatizált eredményre. A méretkorlátok továbbra is érvényesek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "割合は保存済みの設定を基準とし、直前の自動調整結果は使いません。対応サイズの制限は引き続き適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "百分比以保存的设置为基准，不使用上一次自动化结果。支持的尺寸限制仍然适用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
