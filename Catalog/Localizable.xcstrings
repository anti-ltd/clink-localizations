    "Taken from the left of the punctuation set.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Van die linkerkant van die leestekenstel geneem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von links aus dem Satzzeichen-Satz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se toman de la izquierda del conjunto de puntuación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võetud kirjavahemärkide komplektist vasakult."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pris à gauche de l’ensemble de ponctuation."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az írásjelkészlet bal oldaláról."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Presi da sinistra dal set di punteggiatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "句読点セットの左から取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구두점 세트의 왼쪽부터 가져옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diambil dari kiri set tanda baca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirados da esquerda do conjunto de pontuação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Берётся с левого края набора пунктуации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从标点集合左边取。"
          }
        }
      }
    },
    "Taken from the left: 1, 2, 3… then 0.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Van links geneem: 1, 2, 3 … dan 0."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von links: 1, 2, 3… dann 0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De izquierda a derecha: 1, 2, 3… y luego 0."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võetud vasakult: 1, 2, 3… siis 0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De gauche à droite : 1, 2, 3… puis 0."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Balról: 1, 2, 3… majd 0."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da sinistra: 1, 2, 3… poi 0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左から 1、2、3…、最後に 0。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽부터: 1, 2, 3… 그다음 0."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari kiri: 1, 2, 3… kemudian 0."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Da esquerda: 1, 2, 3… depois 0."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Берётся слева: 1, 2, 3… затем 0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左到右：1、2、3…，最后是 0。"
          }
        }
      }
    },
    "Talking and the AI tools are free, and always will be. Pro adds the keys, so you can type in other apps as well as speak.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Praat en die KI-gereedskap is gratis, en sal altyd wees. Pro voeg die sleutels by, sodat jy ander programme kan tik sowel as praat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprechen und die KI-Werkzeuge sind gratis und bleiben es auch. Pro bringt die Tasten dazu, damit du in anderen Apps nicht nur sprechen, sondern auch tippen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hablar y las herramientas de IA son gratis y siempre lo serán. Pro añade las teclas, para que en otras apps puedas escribir además de hablar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rääkimine ja TI-tööriistad on tasuta ja jäävad nii. Pro lisab klahvid, nii et sa saad teistes rakendustes mitte ainult rääkida, vaid ka tipida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parler et les outils d'IA sont gratuits, et le resteront. Pro ajoute les touches, pour que tu puisses aussi taper dans les autres apps, pas seulement parler."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszéd és az MI-eszközök ingyenesek, és azok is maradnak. A Pro hozzáadja a billentyűket, így más appokban nemcsak beszélhetsz, hanem gépelhetsz is."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlare e gli strumenti IA sono gratis e lo resteranno. Pro aggiunge i tasti, così nelle altre app puoi anche scrivere, non solo parlare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話すことも AI ツールも無料で、これからもずっと無料です。Pro を入れるとキーが加わり、ほかのアプリでも話すだけでなく打てるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하기도 AI 도구도 무료이고, 앞으로도 그렇습니다. Pro를 더하면 키가 열려서, 다른 앱에서도 말하는 것뿐 아니라 직접 칠 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bercakap dan alat AI adalah percuma, dan akan kekal begitu. Pro menambah kekunci, supaya anda boleh menaip dalam app lain dan bukan sekadar bercakap."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falar e as ferramentas de IA são grátis, e vão continuar a ser. O Pro acrescenta as teclas, para escreveres noutras apps além de falares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорить и пользоваться ИИ-инструментами бесплатно — и так будет всегда. Pro добавляет клавиши, чтобы в других приложениях можно было не только говорить, но и печатать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话和 AI 工具都是免费的，以后也一直免费。Pro 会把按键一起打开，让你在别的应用里除了说，也能打字。"
          }
        }
      }
    },
    "Talking is free and always will be. Pro adds the keys, so you can type in other apps as well as speak.": {
