    "A photo fills behind the keys and overrides the gradient.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Foto vul agter die sleutels en ignoreer die gradiënt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Foto liegt hinter den Tasten und überschreibt den Farbverlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una foto llena el fondo de las teclas y reemplaza el degradado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilt täidab klahvide taga ja asendab ülemineku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une photo remplit l'arrière des touches et remplace le dégradé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk mögött egy fotó jelenik meg, ami felülírja a színátmenetet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una foto riempie lo sfondo dei tasti e sostituisce il gradiente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真がキーの後ろに広がり、グラデーションを上書きします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 뒤를 사진이 채우면서 그라데이션을 덮어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto mengisi belakang kekunci dan mengatasi gradien."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma foto enche o fundo das teclas e substitui o gradiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За клавишами стоит фото, оно заменяет градиент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
