    "The keyboard you just tried works everywhere with a membership. Inside this app it stays free.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sleutelbord wat jy sopas probeer het, werk oral met 'n lidmaatskap. Binne hierdie toepassing bly dit gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einer Mitgliedschaft funktioniert die Tastatur, die du gerade ausprobiert hast, überall. In dieser App bleibt sie kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado que acabas de probar funciona en todas partes con una suscripción. Dentro de esta app seguirá siendo gratis."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuur, mida just proovisid, töötab liikmelisusega kõikjal. Selles rakenduses jääb see tasuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un abonnement, le clavier que tu viens d'essayer fonctionne partout. Dans cette app, il reste gratuit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagsággal az imént kipróbált billentyűzet mindenhol működik. Ebben az appban ingyenes marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un abbonamento, la tastiera che hai appena provato funziona ovunque. Dentro questa app resta gratuita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンバーシップに登録すると、今試したキーボードをどこでも使えます。このアプリ内では無料のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멤버십에 가입하면 방금 써 본 키보드를 어디서나 사용할 수 있어요. 이 앱 안에서는 계속 무료예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan keahlian, papan kekunci yang baru dicuba boleh digunakan di mana-mana. Dalam app ini, ia kekal percuma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma adesão, o teclado que acabaste de experimentar funciona em todo o lado. Nesta app continua grátis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура, которую вы только что попробовали, работает везде с членством. Внутри этого приложения она остаётся бесплатной."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开通会员后，刚刚试用的键盘可在任何地方使用。在此 App 内则会一直免费。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastatura pe care tocmai ai încercat-o funcționează peste tot cu un abonament. În interiorul acestei aplicații, rămâne gratuită."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het toetsenbord dat je zojuist hebt geprobeerd, werkt overal met een lidmaatschap. Binnen deze app blijft het gratis."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開通會員後，剛剛試用的鍵盤可在任何地方使用。在此 App 內則會一直免費。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawiatura, którą właśnie wypróbowałeś, działa wszędzie z członkostwem. Wewnątrz tej aplikacji pozostaje ona bezpłatna."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіатура, яку ви щойно спробували, працює скрізь із членством. У цій програмі він залишається безкоштовним."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Az önce denediğiniz klavye üyelikle her yerde çalışmaktadır. Bu uygulamanın içinde ücretsiz kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesnice, kterou jste právě vyzkoušeli, funguje všude s členstvím. Uvnitř této aplikace zůstává zdarma."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesnica, ktorú ste práve vyskúšali, funguje všade s členstvom. Vo vnútri tejto aplikácie zostáva zadarmo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πληκτρολόγιο που μόλις δοκιμάσατε λειτουργεί παντού με μια συνδρομή. Μέσα σε αυτήν την εφαρμογή παραμένει δωρεάν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangentbordet du just provat fungerar överallt med ett medlemskap. Inuti den här appen förblir den gratis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det tastatur, du lige har prøvet, fungerer overalt med et medlemskab. Inde i denne app forbliver den gratis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturet du nettopp prøvde fungerer overalt med et medlemskap. Inne i denne appen forblir den gratis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Juuri kokeilemasi näppäimistö toimii kaikkialla jäsenyyden kanssa. Tämän sovelluksen sisällä se pysyy ilmaiseksi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard yang baru saja Anda coba berfungsi di mana saja dengan keanggotaan. Di dalam aplikasi ini tetap gratis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bàn phím bạn vừa thử hoạt động ở mọi nơi với tư cách thành viên. Bên trong ứng dụng này nó vẫn miễn phí."
          }
        }
      }
    },
    "The keyboard's flip button swaps between these two, so a conversation is one tap each way.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sleutelbord se flip-knoppie ruil tussen hierdie twee, so 'n gesprek is een tik elke kant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tauschtaste der Tastatur wechselt zwischen diesen beiden — ein Gespräch ist also ein Tippen pro Richtung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón de intercambio del teclado alterna entre estos dos, así que una conversación es un toque en cada sentido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuuri vahetusnupp vahetab nende kahe vahel, nii et vestlus on üks puudutus kummaski suunas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton d’inversion du clavier bascule entre ces deux langues : une conversation ne demande qu’un appui dans chaque sens."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzet váltógombja e kettő között vált, így egy beszélgetés mindkét irányban egy koppintás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pulsante di scambio della tastiera alterna queste due lingue, così una conversazione è un tocco per parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの入れ替えボタンはこの2つを切り替えます。会話中もどちらの向きも1タップです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드의 전환 버튼이 이 두 언어를 바꿔 줍니다. 대화 중 어느 방향이든 한 번만 누르면 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Butang tukar pada papan kekunci menyilih antara kedua-duanya, jadi perbualan hanya satu ketikan setiap arah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão de troca do teclado alterna entre estes dois, por isso uma conversa é um toque em cada sentido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка переворота на клавиатуре меняет эти два языка местами, так что разговор — по одному нажатию в каждую сторону."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘上的互换按钮会在这两种语言之间切换，对话时每个方向都只需轻点一次。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Butonul de răsturnare al tastaturii schimbă între aceste două, așa că o conversație este o atingere în fiecare sens."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitklapknop van het toetsenbord wisselt tussen deze twee, dus een gesprek is slechts één tik in beide richtingen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤上的互換按鈕會在這兩種語言之間切換，對話時每個方向都只需輕點一次。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przycisk odwracania klawiatury przełącza się między tymi dwoma, więc rozmowa polega na jednym dotknięciu w każdą stronę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка повороту на клавіатурі перемикається між цими двома, тому розмова відбувається одним дотиком у кожну сторону."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyenin çevirme düğmesi bu ikisi arasında geçiş yapar, böylece konuşma her iki yönde de tek dokunuşla gerçekleşir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překlápěcí tlačítko klávesnice se mezi těmito dvěma přepíná, takže konverzace je jedním klepnutím v každém směru."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Preklápacie tlačidlo klávesnice sa prepína medzi týmito dvoma, takže konverzácia je jedným klepnutím v každom smere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κουμπί αναστροφής του πληκτρολογίου εναλλάσσεται μεταξύ αυτών των δύο, έτσι ώστε μια συνομιλία να είναι ένα πάτημα κάθε φορά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangentbordets vändknapp växlar mellan dessa två, så en konversation är ett tryck vardera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturets vippeknap skifter mellem disse to, så en samtale er et tryk hver vej."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturets vippeknapp bytter mellom disse to, så en samtale er ett trykk hver vei."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäimistön kääntöpainike vaihtaa näiden kahden välillä, joten keskustelu on yksi napautus kumpaankin suuntaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol flip keyboard bertukar di antara keduanya, sehingga percakapan cukup dilakukan dengan satu ketukan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nút lật của bàn phím hoán đổi giữa hai nút này, do đó, cuộc trò chuyện chỉ cần nhấn một lần mỗi chiều."
          }
        }
      }
    },
    "The keyboard, emoji and your presets are free in every app. Membership unlocks the tools: dictation, clipboard, AI Tools and more.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sleutelbord, emoji en jou voorafinstellings is gratis in elke toepassing. Lidmaatskap ontsluit die gereedskap: diktee, knipbord, KI-nutsgoed en meer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastatur, Emoji und deine Vorgaben sind in jeder App kostenlos. Mit der Mitgliedschaft werden die Tools freigeschaltet: Diktat, Zwischenablage, KI-Tools und mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado, los emojis y tus ajustes predefinidos son gratis en todas las apps. La suscripción desbloquea las herramientas: dictado, portapapeles, herramientas de IA y más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuur, emotikonid ja sinu eelseadistused on igas rakenduses tasuta. Liikmelisus avab tööriistad: dikteerimine, lõikelaud, AI-tööriistad ja palju muud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier, les emojis et tes préréglages sont gratuits dans toutes les apps. L’abonnement débloque les outils : dictée, presse-papiers, outils d’IA et plus encore."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzet, az emodzsik és a beállításaid minden alkalmazásban ingyenesek. Az előfizetés feloldja az eszközöket: diktálás, vágólap, AI-eszközök és még több."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera, le emoji e i tuoi preset sono gratuiti in ogni app. L'abbonamento sblocca gli strumenti: dettatura, appunti, strumenti AI e altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボード、絵文字、プリセットはすべてのアプリで無料です。メンバーシップでツール（音声入力、クリップボード、AIツールなど）が使えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드, 이모지, 프리셋은 모든 앱에서 무료입니다. 멤버십으로 받아쓰기, 클립보드, AI 도구 등 도구를 잠금 해제하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci, emoji dan pratetap anda adalah percuma dalam setiap aplikasi. Keahlian membuka kunci alatan: imlak, papan keratan, Alatan AI dan banyak lagi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado, os emojis e os seus predefinidos são gratuitos em todas as apps. A assinatura desbloqueia as ferramentas: ditado, área de transferência, ferramentas de IA e mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура, эмодзи и ваши пресеты бесплатны в каждом приложении. Членство открывает инструменты: диктовку, буфер обмена, инструменты ИИ и другое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘、表情符号和您的预设在任何应用中均免费。会员资格解锁工具：听写、剪贴板、AI 工具等。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastatura, emoji și presetările dvs. sunt gratuite în fiecare aplicație. Calitatea de membru deblochează instrumentele: dictare, clipboard, instrumente AI și multe altele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het toetsenbord, de emoji en je presets zijn gratis in elke app. Lidmaatschap ontgrendelt de tools: dicteren, klembord, AI Tools en meer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤、表情符號和您的預設在任何應用中均免費。會員資格解鎖工具：聽寫、剪貼簿、AI 工具等。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawiatura, emoji i gotowe ustawienia są bezpłatne w każdej aplikacji. Członkostwo odblokowuje narzędzia: dyktando, schowek, narzędzia AI i inne."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіатура, смайли та ваші попередні налаштування є безкоштовними в кожній програмі. Членство відкриває інструменти: диктування, буфер обміну, інструменти AI тощо."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye, emoji ve ön ayarlarınız her uygulamada ücretsizdir. Üyelik, şu araçların kilidini açar: dikte, pano, AI Araçları ve daha fazlası."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesnice, emotikony a vaše předvolby jsou zdarma v každé aplikaci. Členství odemkne nástroje: diktování, schránku, nástroje AI a další."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesnica, emotikony a vaše predvoľby sú v každej aplikácii zadarmo. Členstvo odomkne nástroje: diktovanie, schránka, nástroje AI a ďalšie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πληκτρολόγιο, τα emoji και οι προεπιλογές σας είναι δωρεάν σε κάθε εφαρμογή. Η ιδιότητα μέλους ξεκλειδώνει τα εργαλεία: υπαγόρευση, πρόχειρο, Εργαλεία AI και πολλά άλλα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangentbordet, emojin och dina förinställningar är gratis i alla appar. Medlemskap låser upp verktygen: diktering, urklipp, AI-verktyg och mer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturet, emoji og dine forudindstillinger er gratis i hver app. Medlemskab låser værktøjerne op: diktering, udklipsholder, AI-værktøjer og mere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturet, emojiene og forhåndsinnstillingene dine er gratis i hver app. Medlemskap låser opp verktøyene: diktering, utklippstavle, AI-verktøy og mer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäimistö, emoji ja esiasetukset ovat ilmaisia kaikissa sovelluksissa. Jäsenyys avaa työkalut: sanelun, leikepöydän, tekoälytyökalut ja paljon muuta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard, emoji, dan preset Anda gratis di setiap aplikasi. Keanggotaan membuka kunci alat: dikte, papan klip, Alat AI, dan banyak lagi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bàn phím, biểu tượng cảm xúc và cài đặt trước của bạn đều miễn phí trong mọi ứng dụng. Tư cách thành viên sẽ mở khóa các công cụ: đọc chính tả, bảng nhớ tạm, Công cụ AI và hơn thế nữa."
          }
        }
      }
    },
    "The keys are too round for me": {
