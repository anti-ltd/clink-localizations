    "Picks the most natural word, not just the most common": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies die mees natuurlike woord, nie net die algemeenste nie"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt das natürlichste Wort, nicht nur das häufigste"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la palabra más natural, no solo la más común"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valib kõige loomulikuma sõna, mitte ainult kõige sagedasema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisit le mot le plus naturel, pas seulement le plus courant"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legtermészetesebb szót választja, nem csak a leggyakoribbat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sceglie la parola più naturale, non solo la più comune"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん多い単語ではなく、いちばん自然な単語を選びます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 흔한 단어가 아니라 가장 자연스러운 단어를 골라요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih perkataan paling semula jadi, bukan sekadar yang paling biasa"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe a palavra mais natural, não só a mais comum"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирает самое естественное слово, а не просто самое частое"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑最自然的词，不只是最常见的"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege cuvântul cel mai natural, nu doar cel mai comun"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiest het meest natuurlijke woord, niet alleen het meest voorkomende"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "挑最自然的詞，不只是最常見的"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybiera najbardziej naturalne słowo, a nie tylko najczęstsze"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибирає найбільш природне слово, а не просто найпоширеніше"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece en yaygın kelimeyi değil, en doğal kelimeyi seçer"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybírá nejpřirozenější slovo, nejen to nejběžnější"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberá najprirodzenejšie slovo, nielen najbežnejšie"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέγει την πιο φυσική λέξη, όχι απλώς την πιο κοινή"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väljer det mest naturliga ordet, inte bara det vanligaste"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælger det mest naturlige ord, ikke kun det mest almindelige"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velger det mest naturlige ordet, ikke bare det vanligste"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitsee luonnollisimman sanan, ei vain yleisintä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kata yang paling alami, bukan hanya kata yang paling umum"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn từ tự nhiên nhất, không chỉ từ phổ biến nhất"
          }
        }
      }
    },
    "Picks up the names, slang, and jargon you type, not words the dictionary already has.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tel die name, slengtaal en jargon op wat jy tik, nie woorde wat die woordeboek reeds het nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkt sich Namen, Slang und Fachwörter, die du tippst – keine Wörter, die schon im Wörterbuch stehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende los nombres, la jerga y los tecnicismos que escribes, no las palabras que ya están en el diccionario."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabab nimesid, slängi ja žargooni, mida tipid, mitte sõnu, mis juba sõnaraamatus on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retient les noms, l'argot et le jargon que tu tapes, pas les mots que le dictionnaire connaît déjà."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjegyzi a neveket, a szlenget és a szakszavakat, amiket írsz – a szótárban meglévőket nem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impara i nomi, lo slang e il gergo che scrivi, non le parole che il dizionario ha già."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書にない名前やスラング、専門用語だけを覚えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전에 없는 이름, 은어, 전문 용어만 기억합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengingat nama, slanga dan jargon yang awak taip — bukan perkataan yang sudah ada dalam kamus."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda os nomes, a gíria e o jargão que escreves, não as palavras que o dicionário já tem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подхватывает имена, сленг и жаргон, которые вы печатаете, — а не слова, уже известные словарю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只记住你输入的名字、俚语和行话，词典里已有的词不记。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Preia numele, argoul și jargonul pe care le introduceți, nu cuvintele pe care le are deja dicționarul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakt de namen, het jargon en het jargon op dat u typt, niet de woorden die het woordenboek al bevat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只記住你輸入的名字、俚語和行話，詞典裡已有的詞不記。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wychwytuje wpisywane nazwy, slang i żargon, a nie słowa, które już znajdują się w słowniku."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підбирає назви, сленг і жаргон, які ви вводите, а не слова, які вже є в словнику."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözlükte halihazırda bulunan sözcükleri değil, yazdığınız adları, argo ve jargonu alır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybere jména, slang a žargon, který zadáte, nikoli slova, která již slovník obsahuje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Preberá mená, slang a žargón, ktoré zadávate, nie slová, ktoré už slovník obsahuje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέγει τα ονόματα, την αργκό και την ορολογία που πληκτρολογείτε, όχι λέξεις που έχει ήδη το λεξικό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar upp namnen, slangen och jargongen du skriver, inte ord som ordboken redan har."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsamler de navne, slang og jargon, du skriver, ikke ord, som ordbogen allerede har."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar opp navnene, slangen og sjargongen du skriver, ikke ordene som ordboken allerede har."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poimii kirjoittamasi nimet, slangin ja jargonin, ei sanakirjassa jo olevia sanoja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengambil nama, bahasa gaul, dan jargon yang Anda ketik, bukan kata-kata yang sudah dimiliki kamus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn tên, tiếng lóng và biệt ngữ bạn nhập chứ không phải những từ mà từ điển đã có."
          }
        }
      }
    },
