    "Share shortcuts only run when you tap them.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Deelkortpaaie loop net wanneer jy daarop tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen-Verknüpfungen laufen nur, wenn du sie antippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de compartir solo se ejecutan cuando los tocas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jagamise otseteed töötavad ainult siis, kui sa neid puudutad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis de partage ne se lancent que quand tu les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megosztási parancsikonok csak akkor futnak, ha rájuk koppintasz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scorciatoie di condivisione partono solo quando le tocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有ショートカットは、タップしたときだけ動きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 바로가기는 눌렀을 때만 실행돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan kongsi cuma berjalan bila anda ketiknya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos de partilha só correm quando os tocas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрые команды из меню «Поделиться» запускаются только по вашему нажатию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享快捷方式只有你点了才会运行。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comenzile rapide de partajare rulează numai atunci când le atingeți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snelkoppelingen voor delen worden alleen uitgevoerd als u erop tikt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享快捷方式只有你點了才會執行。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skróty udostępniania działają tylko po ich dotknięciu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ярлики спільного доступу запускаються лише тоді, коли ви їх торкаєтеся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım kısayolları yalnızca onlara dokunduğunuzda çalışır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílení zkratky se spustí, pouze když na ně klepnete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skratky zdieľania sa spustia iba vtedy, keď na ne klepnete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συντομεύσεις κοινής χρήσης εκτελούνται μόνο όταν τις πατάτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela genvägar körs bara när du trycker på dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Delingsgenveje kører kun, når du trykker på dem."
