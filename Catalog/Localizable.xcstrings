        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte ho, aby ste prebehli textom a postupne zrýchľovali."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε το για να επαναλάβετε το κείμενο, αυξάνοντας την ταχύτητα καθώς προχωράτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll den för att springa tillbaka genom texten och ta fart medan du går."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold den for at løbe tilbage gennem teksten, mens du tager fart."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold den for å løpe tilbake gjennom teksten og øke hastigheten mens du går."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä sitä painettuna palataksesi tekstin läpi ja nopeuta nopeutta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan untuk menelusuri kembali teks, tingkatkan kecepatan seiring berjalannya waktu."
