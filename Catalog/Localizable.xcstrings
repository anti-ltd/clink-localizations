        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona texto. Toca Mayúsculas para cambiar entre mayúscula y minúscula la primera letra; toca dos veces para cambiar todo el texto seleccionado. Sigue tocando para repetir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionne du texte. Touche Maj pour changer la casse de la première lettre, ou touche deux fois pour changer celle de toute la sélection. Continue à toucher pour recommencer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere Text. Tippe auf die Umschalttaste, um die Groß- und Kleinschreibung des ersten Buchstabens zu wechseln. Tippe zweimal für die gesamte Auswahl. Durch weiteres Tippen wiederholst du den Wechsel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona del testo. Tocca Maiusc per alternare maiuscola e minuscola della prima lettera; tocca due volte per modificare tutto il testo selezionato. Continua a toccare per ripetere."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleciona texto. Toca em Shift para alternar entre maiúscula e minúscula na primeira letra; toca duas vezes para alterar todo o texto selecionado. Continua a tocar para repetir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите текст. Нажмите Shift, чтобы изменить регистр первой буквы, или дважды — чтобы изменить регистр всего выделенного текста. Повторные нажатия снова переключают регистр."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih teks. Ketik Shift untuk menukar huruf pertama antara huruf besar dan kecil; ketik dua kali untuk menukar seluruh teks yang dipilih. Teruskan mengetik untuk mengulang."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelölj ki szöveget. Koppints a Shiftre az első betű kis- és nagybetűs alakjának váltásához, vagy koppints duplán a teljes kijelölés átalakításához. Újabb koppintásokkal megismételheted a váltást."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストを選択し、Shiftをタップすると最初の文字の大文字と小文字が切り替わります。ダブルタップすると選択範囲全体が切り替わります。続けてタップすると繰り返し切り替えられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中文字后，轻点 Shift 可切换首字母大小写，轻点两下可切换全部所选文字的大小写。继续轻点即可反复切换。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트를 선택한 후 Shift를 탭하면 첫 글자의 대소문자가 전환됩니다. 두 번 탭하면 선택한 텍스트 전체가 전환됩니다. 계속 탭하여 반복할 수 있습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali tekst. Puuduta tõstuklahvi, et vahetada esimese tähe suur- ja väiketähte; topeltpuudutus muudab kogu valitud teksti tähesuurust. Jätka puudutamist, et vahetust korrata."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectați text. Atingeți Shift pentru a comuta majusculele primei litere; atingeți de două ori pentru a comuta tot textul selectat. Atingeți în continuare pentru a repeta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer tekst. Tik op Shift om de hoofdlettergebruik van de eerste letter te wisselen; dubbeltik om alle geselecteerde tekst te wisselen. Blijf tikken om te herhalen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選中文字後，輕點 Shift 可切換首字母大小寫，輕點兩下可切換全部所選文字的大小寫。繼續輕點即可反覆切換。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies teks. Tik op Shift om die hoofletterstatus van die eerste letter te wissel; tik twee keer om dit vir alle geselekteerde teks te wissel. Hou aan tik om te herhaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz tekst. Stuknij Shift, aby zmienić wielkość pierwszej litery; kliknij dwukrotnie, aby przełączyć cały zaznaczony tekst. Dotykaj dalej, aby powtórzyć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть текст. Натисніть Shift, щоб змінити регістр першої літери; двічі торкніться, щоб перемкнути весь виділений текст. Продовжуйте натискати, щоб повторити."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metni seçin. İlk harfin büyük/küçük harf durumunu değiştirmek için Shift'e dokunun; seçili metnin tümüne geçiş yapmak için iki kez dokunun. Tekrarlamak için dokunmaya devam edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte text. Klepnutím na Shift přepnete velikost prvního písmene; dvojitým klepnutím přepnete veškerý vybraný text. Opakujte klepnutím."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte text. Klepnutím na Shift prepnete veľkosť prvého písmena; dvojitým klepnutím prepnete celý vybraný text. Opakujte opakovaným klepnutím."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε κείμενο. Πατήστε Shift για εναλλαγή του πρώτου γράμματος. πατήστε δύο φορές για εναλλαγή όλου του επιλεγμένου κειμένου. Συνεχίστε να αγγίζετε για επανάληψη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj text. Tryck på Shift för att växla den första bokstavens skiftläge; dubbeltryck för att växla all vald text. Fortsätt trycka för att upprepa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg tekst. Tryk på Shift for at skifte mellem store og små bogstaver i det første bogstav; dobbelttryk for at skifte al valgt tekst. Bliv ved med at trykke for at gentage."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg tekst. Trykk på Shift for å bytte mellom store og små bokstaver; dobbelttrykk for å veksle mellom all valgt tekst. Fortsett å trykke for å gjenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse teksti. Napauta Shift vaihtaaksesi ensimmäisen kirjaimen kirjainkokoa; kaksoisnapauta vaihtaaksesi kaiken valitun tekstin. Jatka napauttamista toistaaksesi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih teks. Ketuk Shift untuk mengganti huruf besar-kecil; ketuk dua kali untuk mengganti semua teks yang dipilih. Terus ketuk untuk mengulangi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn văn bản. Nhấn Shift để chuyển đổi chữ cái đầu tiên; nhấn đúp để chuyển đổi tất cả văn bản đã chọn. Tiếp tục nhấn để lặp lại."
          }
        }
      }
    },
    "Select the generated look in its picker after saving the plugin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle nach dem Speichern des Plugins das erstellte Design in der zugehörigen Auswahl aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras guardar el plugin, selecciona el diseño generado en su selector."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pärast plugina salvestamist vali loodud kujundus vastavast valikust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir enregistré le plugin, sélectionne le style créé dans le sélecteur correspondant."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bővítmény mentése után válaszd ki a létrehozott megjelenést a megfelelő választóban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver salvato il plugin, scegli lo stile generato nel relativo selettore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインを保存した後、対応する選択画面で生成されたデザインを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인을 저장한 다음 해당 선택 화면에서 생성된 스타일을 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas menyimpan pemalam, pilih gaya yang dijana dalam pemilihnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de guardares o plugin, seleciona o estilo gerado no respetivo seletor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После сохранения плагина выберите созданное оформление в соответствующем списке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存插件后，在相应的选择器中选择生成的外观。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectați aspectul generat în selectorul său după salvarea pluginului."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer het gegenereerde uiterlijk in de kiezer nadat u de plug-in hebt opgeslagen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存外掛後，在相應的選擇器中選擇生成的外觀。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies die gegenereerde voorkoms in die kieser nadat die inprop gestoor is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz wygenerowany wygląd w selektorze po zapisaniu wtyczki."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть згенерований вигляд у його засобі вибору після збереження плагіна."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklentiyi kaydettikten sonra seçicide oluşturulan görünümü seçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po uložení pluginu vyberte vygenerovaný vzhled v jeho výběru."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po uložení doplnku vyberte vygenerovaný vzhľad v jeho výbere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε την εμφάνιση που δημιουργήθηκε στον επιλογέα μετά την αποθήκευση της προσθήκης."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj det genererade utseendet i dess väljare efter att ha sparat plugin-programmet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg det genererede look i dets vælger efter at have gemt plugin'et."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg det genererte utseendet i velgeren etter at du har lagret programtillegget."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse luotu ulkoasu sen valitsimessa laajennuksen tallentamisen jälkeen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tampilan yang dihasilkan di pemilihnya setelah menyimpan plugin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn giao diện được tạo trong bộ chọn sau khi lưu plugin."
          }
        }
      }
    },
