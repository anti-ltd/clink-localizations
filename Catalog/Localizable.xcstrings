    "Pick ABC, 123 or #+= on the Keys tab. All keys and rows are arranged directly in the live preview.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl ABC, 123 oder #+= im Tab „Tasten“. Alle Tasten und Reihen ordnest du direkt in der Live-Vorschau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige ABC, 123 o #+= en la pestaña Teclas. Todas las teclas y filas se organizan en la vista previa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis ABC, 123 ou #+= dans l'onglet Touches. Touches et rangées s'agencent directement dans l'aperçu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd az ABC, 123 vagy #+= lapot a Billentyűk fülön. A billentyűket és sorokat az élő előnézetben rendezed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli ABC, 123 o #+= nella scheda Tasti. Tasti e righe si sistemano direttamente nell'anteprima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キー」タブで ABC・123・#+= を選びます。キーと行はライブプレビューで直接並べ替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘키’ 탭에서 ABC, 123, #+= 를 고르세요. 키와 행은 실시간 미리보기에서 바로 배치합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih ABC, 123 atau #+= pada tab Kekunci. Semua kekunci dan baris disusun terus dalam pratonton langsung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe ABC, 123 ou #+= no separador Teclas. Todas as teclas e linhas são organizadas na pré-visualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите ABC, 123 или #+= на вкладке «Клавиши». Все клавиши и ряды расставляются прямо в живом предпросмотре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「按键」标签里选 ABC、123 或 #+=。所有按键和行都直接在实时预览里排布。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali kaardil Klahvid ABC, 123 või #+=. Kõik klahvid ja read paigutatakse otse reaalaja eelvaates."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies ABC, 123 of #+= op die Sleutels-oortjie. Alle sleutels en rye word direk in die regstreekse voorskou gerangskik."
          }
        }
      }
    },
