    "Applies to every letter set to match the font. A letter with its own spacing keeps it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a todas las letras configuradas para seguir la fuente. Una letra con su propio espaciado lo conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique à toutes les lettres réglées pour suivre la police. Une lettre ayant son propre espacement le conserve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für alle Buchstaben, die der Schrift folgen. Ein Buchstabe mit eigenem Abstand behält ihn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica a ogni lettera impostata per seguire il font. Una lettera con spaziatura propria la mantiene."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a todas as letras definidas para acompanhar a fonte. Uma letra com espaçamento próprio mantém-no."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется ко всем буквам, следующим за шрифтом. Буква с собственными отступами сохраняет их."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan pada setiap huruf yang ditetapkan mengikut fon. Huruf dengan jarak sendiri mengekalkannya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden olyan betűre vonatkozik, amely a betűtípust követi. A saját térközzel rendelkező betű megtartja azt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォントに合わせる設定のすべての文字に適用されます。独自の字間を持つ文字はそのままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于所有设为跟随字体的字母。设有独立间距的字母会保留自己的间距。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글꼴을 따르도록 설정된 모든 글자에 적용됩니다. 자체 간격이 있는 글자는 그대로 유지됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehtib kõigile tähtedele, mis järgivad fonti. Oma vahedega täht säilitab need."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplică fiecărui set de litere pentru a se potrivi cu fontul. O literă cu spațiere proprie o păstrează."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geldt voor elke letterset die bij het lettertype past. Een letter met een eigen spatiëring behoudt deze."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於所有設為跟隨字型的字母。設有獨立間距的字母會保留自己的間距。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas toe op elke letterstel om by die lettertipe te pas. ‘n Letter met sy eie spasiering hou dit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy każdej litery ustawionej tak, aby pasowała do czcionki. Zachowuje ją litera z własnymi odstępami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосовується до кожного набору літер відповідно до шрифту. Літера з власним інтервалом зберігає його."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazı tipiyle eşleşecek şekilde ayarlanan her harf için geçerlidir. Kendi aralığına sahip bir harf onu korur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platí pro každé písmeno nastavené tak, aby odpovídalo písmu. Písmeno s vlastní mezerou ji drží."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzťahuje sa na každé písmeno, ktoré sa zhoduje s písmom. Drží ho písmeno s vlastnou medzerou."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ισχύει για κάθε γράμμα που έχει οριστεί για να ταιριάζει με τη γραμματοσειρά. Ένα γράμμα με το δικό του διάστημα το κρατά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gäller varje bokstav som ställs in för att matcha typsnittet. En bokstav med eget mellanrum behåller den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gælder for hvert bogstav, der er sat til at matche skrifttypen. Et bogstav med sit eget mellemrum beholder det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjelder for hver bokstav satt til å matche skriften. En bokstav med egen mellomrom beholder den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koskee jokaista fonttia vastaavaa kirjainta. Kirjain, jossa on omat välit, säilyttää sen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlaku untuk setiap kumpulan huruf agar sesuai dengan font. Surat dengan spasi tersendiri akan menyimpannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng cho mọi bộ chữ cái để khớp với phông chữ. Một chữ cái có khoảng cách riêng sẽ giữ nó."
          }
        }
      }
    },
    "Applies to every reel. The stage hides its own controls a couple of seconds after you stop touching it, so a screen recording starts clean.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Van toepassing op elke katrol. Die verhoog versteek sy eie kontroles 'n paar sekondes nadat jy opgehou het om daaraan te raak, so 'n skermopname begin skoon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für jedes Reel. Die Bühne blendet ihre eigenen Regler ein paar Sekunden nach dem letzten Tippen aus, damit die Aufnahme sauber startet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale para cada reel. El escenario esconde sus controles un par de segundos después de dejar de tocarlo, para que la grabación empiece limpia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakendub igale rullile. Lava peidab oma juhtelemendid mõni sekund pärast seda, kui lakkad teda puudutamast, et ekraanisalvestus algaks puhtalt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à chaque reel. La scène cache ses commandes deux secondes après que tu as arrêté de la toucher, pour que l’enregistrement parte propre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden reelre vonatkozik. A színpad pár másodperc után elrejti a saját vezérlőit, hogy a képernyőfelvétel tisztán induljon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale per ogni reel. Il palco nasconde i suoi comandi un paio di secondi dopo che smetti di toccarlo, così la registrazione parte pulita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのリールに適用されます。触るのをやめて数秒すると操作が隠れるので、画面収録がきれいに始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 릴에 적용됩니다. 손을 뗀 지 몇 초면 조작이 숨어서, 화면 녹화가 깔끔하게 시작됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan pada setiap reel. Pentas menyembunyikan kawalannya beberapa saat selepas anda berhenti menyentuhnya, supaya rakaman skrin bermula bersih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a cada reel. O palco esconde os controlos uns segundos depois de parares de o tocar, para a gravação começar limpa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется к каждому ролику. Сцена прячет свои элементы управления через пару секунд после того, как вы перестаёте её касаться, так что запись экрана начинается чисто."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于每条 reel。停止触摸一两秒后，舞台会藏起自己的控件，方便录屏从干净画面开始。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplică pentru fiecare bobină. Scena își ascunde propriile comenzi la câteva secunde după ce încetați să o atingeți, astfel încât o înregistrare a ecranului începe curată."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geldt voor elke rol. Het podium verbergt zijn eigen bedieningselementen een paar seconden nadat je hem niet meer aanraakt, zodat een schermopname schoon begint."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於每條 reel。停止觸控一兩秒後，舞臺會藏起自己的控制元件，方便錄屏從乾淨畫面開始。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy każdego bębna. Scena chowa swoje elementy sterujące kilka sekund po tym, jak przestaniesz jej dotykać, dzięki czemu nagrywanie ekranu rozpocznie się czysto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосовується до кожної котушки. Сцена приховує власні елементи керування через кілька секунд після того, як ви перестанете її торкатися, тому запис екрана починається чистим."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her makara için geçerlidir. Sahne alanı, dokunmayı bıraktıktan birkaç saniye sonra kendi kontrollerini gizler, böylece ekran kaydı temiz bir şekilde başlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platí pro každý kotouč. Jeviště skryje své vlastní ovládací prvky několik sekund poté, co se ho přestanete dotýkat, takže nahrávání obrazovky začne čistě."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platí pre každý kotúč. Pódium skryje svoje vlastné ovládacie prvky niekoľko sekúnd po tom, ako sa ho prestanete dotýkať, takže nahrávanie obrazovky začne čisté."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ισχύει για κάθε καρούλι. Η σκηνή κρύβει τα δικά της χειριστήρια μερικά δευτερόλεπτα αφού σταματήσετε να την αγγίζετε, έτσι ώστε η εγγραφή στην οθόνη να ξεκινά καθαρά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gäller varje rulle. Scenen döljer sina egna kontroller ett par sekunder efter att du slutat röra den, så en skärminspelning startar ren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gælder alle hjul. Scenen skjuler sine egne kontroller et par sekunder efter du holder op med at røre ved den, så en skærmoptagelse starter rent."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjelder alle hjul. Scenen skjuler sine egne kontroller et par sekunder etter at du slutter å berøre den, så et skjermopptak starter rent."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koskee jokaista rullaa. Lava piilottaa omat säätimensä pari sekuntia sen koskemisen lopettamisen jälkeen, joten näytön tallennus alkaa puhtaana."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlaku untuk setiap gulungan. Panggung menyembunyikan kontrolnya sendiri beberapa detik setelah Anda berhenti menyentuhnya, sehingga perekaman layar mulai bersih."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng cho mọi cuộn phim. Sân khấu sẽ ẩn các điều khiển của chính nó vài giây sau khi bạn ngừng chạm vào nó, do đó quá trình ghi màn hình sẽ bắt đầu sạch sẽ."
          }
        }
      }
    },
