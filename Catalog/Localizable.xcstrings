        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje bokstav tom. Rita de du vill ha."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert bogstav er tomt. Tegn dem, du ønsker."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver bokstav blank. Tegn de du vil ha."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen kirjain tyhjä. Piirrä haluamasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap huruf kosong. Gambarlah yang Anda inginkan."
          }
        },
