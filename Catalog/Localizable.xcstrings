    "Sources include FrequencyWords, Tatoeba, and similar projects. See Dictionaries in Extras for licenses.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu den Quellen zählen FrequencyWords, Tatoeba und ähnliche Projekte. Lizenzen findest du unter Wörterbücher in Extras."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre las fuentes están FrequencyWords, Tatoeba y proyectos parecidos. Mira Diccionarios en Extras para ver las licencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sources incluent FrequencyWords, Tatoeba et des projets similaires. Va voir Dictionnaires dans Extras pour les licences."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A források közt van a FrequencyWords, a Tatoeba és hasonló projektek. A licenceket az Extrák Szótárak részében találod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tra le fonti ci sono FrequencyWords, Tatoeba e progetti simili. Guarda Dizionari in Extra per le licenze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FrequencyWords や Tatoeba などが元になっています。ライセンスは「その他」の辞書をご覧ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출처는 FrequencyWords, Tatoeba 같은 프로젝트예요. 라이선스는 추가 기능의 사전에서 볼 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumbernya termasuk FrequencyWords, Tatoeba dan projek serupa. Lihat Kamus dalam Tambahan untuk lesen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As fontes incluem FrequencyWords, Tatoeba e projetos parecidos. Vê Dicionários em Extras para as licenças."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Среди источников — FrequencyWords, Tatoeba и подобные проекты. Лицензии — в разделе «Словари» в «Дополнительном»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
