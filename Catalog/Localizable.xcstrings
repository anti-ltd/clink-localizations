    "Downloaded packs stay on this device and are available to the keyboard offline.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgelaaide pakkette bly op hierdie toestel en is vanlyn vir die sleutelbord beskikbaar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Pakete bleiben auf diesem Gerät und sind für die Tastatur offline verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los paquetes descargados se quedan en este dispositivo y están disponibles sin conexión para el teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Allalaaditud paketid jäävad sellesse seadmesse ja on klaviatuuris võrguühenduseta saadaval."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les packs téléchargés restent sur cet appareil et sont disponibles hors ligne pour le clavier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड किए गए पैक इसी डिवाइस पर रहते हैं और कीबोर्ड के लिए ऑफ़लाइन उपलब्ध होते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A letöltött csomagok ezen a készüléken maradnak, és a billentyűzet offline is használhatja őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pacchetti scaricati restano su questo dispositivo e sono disponibili offline per la tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたパックはこのデバイスに保存され、キーボードでオフライン利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 팩은 이 기기에 저장되며 키보드에서 오프라인으로 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek yang dimuat turun kekal pada peranti ini dan tersedia luar talian untuk papan kekunci."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड गरिएका प्याकहरू यही उपकरणमा रहन्छन् र किबोर्डका लागि अफलाइन उपलब्ध हुन्छन्।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pacotes descarregados ficam neste dispositivo e estão disponíveis offline para o teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загруженные пакеты остаются на этом устройстве и доступны клавиатуре без подключения к интернету."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilen paketler bu aygıtta kalır ve klavye için çevrimdışı kullanılabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的语言包保留在此设备上，键盘可离线使用。"
          }
        }
      }
    },
