    "Your themes, layouts, custom keys and sounds, exactly how you set them up.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Themes, Layouts, eigenen Tasten und Sounds, genau wie du sie eingerichtet hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus temas, disposiciones, teclas personalizadas y sonidos, tal como los configuraste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes thèmes, dispositions, touches personnalisées et sons, exactement comme tu les as réglés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A témáid, elrendezéseid, egyéni billentyűid és hangjaid, pontosan úgy, ahogy beállítottad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi temi, layout, tasti personalizzati e suoni, esattamente come li hai impostati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ、レイアウト、カスタムキー、サウンドが設定したままで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마, 레이아웃, 커스텀 키와 사운드가 설정한 그대로 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema, susun atur, kekunci tersuai dan bunyi anda, tepat seperti yang anda tetapkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus temas, esquemas, teclas personalizadas e sons, tal como os configuraste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши темы, раскладки, свои клавиши и звуки — ровно в том виде, в каком вы их настроили."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的主题、布局、自定义按键和音效，保持原样。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu teemad, paigutused, kohandatud klahvid ja helid, täpselt nii, nagu sa seadistasid."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou temas, uitlegte, pasgemaakte sleutels en klanke, presies hoe jy dit opgestel het."
          }
        }
      }
    },
