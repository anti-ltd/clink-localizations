            "value": "Skakel Wys agtergrond af om die program wat jy besig is om in te tik, te laat wys."
          }
        }
      }
    },
    "Turn it off under Artificial Intelligence in settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalt es unter Künstliche Intelligenz in den Einstellungen aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalo en Inteligencia artificial, dentro de ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive-le dans Intelligence artificielle, dans les réglages."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold ki a beállításokban, a Mesterséges intelligencia résznél."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivalo in Intelligenza artificiale nelle impostazioni."
          }
        },
