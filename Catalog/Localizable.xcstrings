    "Add names, slang, or jargon the keyboard keeps fighting.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg name, sleng of jargon by die sleutelbord bly veg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füg Namen, Slang oder Fachbegriffe hinzu, gegen die die Tastatur ständig ankämpft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade nombres, jerga o argot con los que el teclado no para de pelearse."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa nimesid, slängi või žargooni, millega klaviatuur pidevalt võitleb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute les noms, l'argot ou le jargon que le clavier n'arrête pas de corriger."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedd fel a neveket, szlenget vagy szakszavakat, amikkel a billentyűzet folyton harcol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi nomi, slang o gergo che la tastiera continua a correggerti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードがいつも直してしまう名前やスラング、専門用語を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 자꾸 바꾸려 드는 이름, 속어, 전문 용어를 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah nama, slanga, atau jargon yang papan kekunci asyik tolak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona nomes, calão ou jargão que o teclado teima em corrigir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте имена, сленг или жаргон, с которыми клавиатура постоянно спорит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把键盘老爱改掉的名字、俚语或行话加进来。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați nume, argou sau jargon cu care tastatura continuă să lupte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg namen, jargon of jargon toe, het toetsenbord blijft vechten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把鍵盤老愛改掉的名字、俚語或行話加進來。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj nazwy, slang lub żargon, a klawiatura wciąż walczy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте імена, сленг або жаргон, з якими клавіатура продовжує боротися."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyenin mücadele ettiği adları, argoları veya jargonları ekleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte jména, slang nebo žargon, klávesnice stále bojuje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte mená, slang alebo žargón, klávesnica neustále bojuje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ονόματα, αργκό ή ορολογία που το πληκτρολόγιο συνεχίζει να παλεύει."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till namn, slang eller jargong tangentbordet fortsätter att slåss om."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj navne, slang eller jargon, tastaturet bliver ved med at kæmpe."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til navn, slang eller sjargong tastaturet fortsetter å kjempe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää nimiä, slangia tai ammattikieltä, näppäimistö taistelee jatkuvasti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan nama, bahasa gaul, atau jargon yang membuat keyboard terus kesulitan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tên, tiếng lóng hoặc biệt ngữ, bàn phím sẽ tiếp tục chiến đấu."
          }
        }
      }
    },
    "Add names, slang, or jargon the keyboard keeps fighting. They show up as you type, stay correctly spelled, and survive a learned-words reset.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg name, sleng of jargon by die sleutelbord bly veg. Hulle verskyn terwyl jy tik, bly korrek gespel, en oorleef 'n aangeleerde woorde-terugstelling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Namen, Slang oder Fachwörter hinzu, gegen die die Tastatur ankämpft. Sie erscheinen beim Tippen, bleiben richtig geschrieben und überstehen das Löschen gelernter Wörter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade nombres, jerga o tecnicismos contra los que pelea el teclado. Aparecen mientras escribes, se mantienen bien escritos y sobreviven al borrado de palabras aprendidas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa nimesid, slängi või žargooni, millega klaviatuur pidevalt võitleb. Need ilmuvad tipimise ajal, jäävad õigesti kirjutatud ja säilivad õpitud sõnade lähtestamisel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute les noms, l'argot ou le jargon que le clavier n'arrête pas de corriger. Ils apparaissent pendant la frappe, gardent leur orthographe et survivent à l'effacement des mots appris."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add hozzá azokat a neveket, szlenget vagy szakszavakat, amiket a billentyűzet folyton javít. Gépelés közben megjelennek, helyesen maradnak, és a tanult szavak törlését is túlélik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi nomi, slang o gergo contro cui la tastiera continua a lottare. Compaiono mentre scrivi, restano scritti bene e sopravvivono alla cancellazione delle parole imparate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードが直そうとする名前やスラング、専門用語を追加できます。入力中に候補として出て、つづりもそのまま、学習した単語を消しても残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 자꾸 고치려는 이름, 은어, 전문 용어를 추가하세요. 입력할 때 후보로 나오고, 철자도 그대로 유지되며, 학습된 단어를 지워도 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah nama, slanga atau jargon yang sentiasa dibetulkan papan kekunci. Ia muncul semasa awak menaip, kekal ejaannya dan tidak hilang apabila perkataan yang dipelajari dibersihkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona nomes, gíria ou jargão contra os quais o teclado insiste. Aparecem enquanto escreves, mantêm a grafia e sobrevivem à limpeza das palavras aprendidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте имена, сленг или жаргон, с которыми клавиатура постоянно спорит. Они появляются в подсказках, пишутся правильно и переживают сброс выученных слов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把键盘老想改掉的名字、俚语或行话加进来。它们会在你打字时出现，拼写保持不变，清空已学词汇后也还在。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați nume, argou sau jargon cu care tastatura continuă să lupte. Ele apar pe măsură ce tastați, rămân scrise corect și supraviețuiesc unei resetare a cuvintelor învățate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg namen, jargon of jargon toe, het toetsenbord blijft vechten. Ze verschijnen terwijl u typt, blijven correct gespeld en overleven een reset van geleerde woorden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把鍵盤老想改掉的名字、俚語或行話加進來。它們會在你打字時出現，拼寫保持不變，清空已學詞彙後也還在。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj nazwy, slang lub żargon, a klawiatura wciąż walczy. Pojawiają się podczas pisania, zachowują poprawną pisownię i przetrwają reset wyuczonych słów."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте імена, сленг або жаргон, з якими клавіатура продовжує боротися. Вони з’являються під час введення тексту, залишаються правильними й залишаються без змін після скидання вивчених слів."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyenin mücadele ettiği adları, argoları veya jargonları ekleyin. Siz yazdıkça ortaya çıkarlar, doğru şekilde yazılırlar ve öğrenilen kelimelerin sıfırlanmasından sağ çıkarlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte jména, slang nebo žargon, klávesnice stále bojuje. Zobrazují se při psaní, zůstávají správně napsané a přežijí reset naučených slov."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte mená, slang alebo žargón, klávesnica neustále bojuje. Zobrazujú sa pri písaní, zostanú správne napísané a prežijú reset naučených slov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ονόματα, αργκό ή ορολογία που το πληκτρολόγιο συνεχίζει να παλεύει. Εμφανίζονται καθώς πληκτρολογείτε, παραμένουν σωστά γραμμένα και επιβιώνουν από μια επαναφορά μαθησιακών λέξεων."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till namn, slang eller jargong tangentbordet fortsätter att slåss om. De dyker upp när du skriver, förblir rättstavade och överlever en återställning av inlärda ord."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj navne, slang eller jargon, tastaturet bliver ved med at kæmpe. De dukker op, mens du skriver, forbliver stavet korrekt og overlever en nulstilling af lærte ord."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til navn, slang eller sjargong tastaturet fortsetter å kjempe. De dukker opp mens du skriver, forblir riktig stavet og overlever en tilbakestilling av lærte ord."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää nimiä, slangia tai ammattikieltä, näppäimistö taistelee jatkuvasti. Ne näkyvät kirjoittaessasi, pysyvät oikein kirjoitettuina ja selviävät opittujen sanojen nollauksesta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan nama, bahasa gaul, atau jargon yang membuat keyboard terus kesulitan. Kata-kata tersebut muncul saat Anda mengetik, tetap mengeja dengan benar, dan bertahan setelah penyetelan ulang kata-kata yang dipelajari."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tên, tiếng lóng hoặc biệt ngữ, bàn phím sẽ tiếp tục chiến đấu. Chúng hiển thị khi bạn nhập, viết đúng chính tả và tồn tại khi thiết lập lại các từ đã học."
          }
        }
      }
    },
