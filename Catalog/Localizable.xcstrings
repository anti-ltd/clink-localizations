    "The layout %@ types on. Change which one it uses in Languages.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die uitleg %@ tik aan. Verander watter een dit in Tale gebruik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anordnung, auf der %@ getippt wird. Welche es nutzt, änderst du unter Sprachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposición con la que se escribe %@. Cambia cuál usa en Idiomas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paigutus, milles %@ tipitakse. Muuda, millist ta kasutab, lehel Keeled."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposition sur laquelle %@ s’écrit. Choisis-en une autre dans Langues."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elrendezés, amin a(z) %@ íródik. A Nyelvek alatt választhatsz másikat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposizione su cui si scrive %@. Cambia quale usa in Lingue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を入力するキー配列です。どれを使うかは「言語」で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 입력하는 자판 배열입니다. 어떤 배열을 쓸지는 ‘언어’에서 바꿉니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Susunan kekunci untuk menaip %@. Tukar yang mana satu digunakan dalam Bahasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A disposição em que %@ se escreve. Muda qual usa em Idiomas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раскладка, на которой печатает «%@». Сменить её можно в «Языках»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入%@时使用的键位排布。要换成哪一套，可在「语言」里改。"
          }
        }
      }
    },
