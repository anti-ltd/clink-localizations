    "Show this key beside the space bar on every layout, presets included. Set it up once instead of adding it to each layout.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wys hierdie sleutel langs die spasiebalk op elke uitleg, voorafinstellings ingesluit. Stel dit een keer op in plaas daarvan om dit by elke uitleg te voeg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt diese Taste in jedem Layout neben der Leertaste, auch in den Voreinstellungen. Einmal einrichten, statt sie zu jedem Layout hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra esta tecla junto a la barra espaciadora en todas las disposiciones, preajustes incluidos. Configúrala una vez en lugar de añadirla a cada disposición."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva seda klahvi tühikuklahvi kõrval igas paigutuses, eelseadistused kaasa arvatud. Seadista see üks kord, selle asemel et igasse paigutusse lisada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche cette touche à côté de la barre d'espace sur toutes les dispositions, préréglages compris. Configure-la une fois au lieu de l'ajouter à chaque disposition."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelenítsd meg ezt a billentyűt a szóköz mellett minden elrendezésen, az előbeállításokat is beleértve. Állítsd be egyszer, ahelyett, hogy minden elrendezéshez hozzáadnád."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra questo tasto accanto alla barra spaziatrice in ogni layout, preset compresi. Impostalo una volta invece di aggiungerlo a ogni layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーを、プリセットを含むすべてのレイアウトでスペースバーの横に表示します。レイアウトごとに追加せず、一度だけ設定すれば済みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 레이아웃에서 스페이스 바 옆에 이 키를 보여줘요, 프리셋 포함이에요. 레이아웃마다 넣는 대신 한 번만 설정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjuk kekunci ini di sebelah bar ruang pada setiap susun atur, termasuk praset. Sediakan sekali sahaja, bukannya menambahnya pada setiap susun atur."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra esta tecla ao lado da barra de espaços em todos os esquemas, predefinições incluídas. Configura uma vez em vez de a adicionar a cada esquema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать эту клавишу рядом с пробелом во всех раскладках, включая пресеты. Настраивается один раз вместо добавления в каждую раскладку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每个布局的空格键旁边都显示这个键，包括预设。设一次就行，不用往每个布局里都加。"
          }
        }
      }
    },
