        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím nebo přetažením vyberte klávesy. Dalším klepnutím zrušíte výběr."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím alebo potiahnutím vyberte klávesy. Opätovným klepnutím zrušíte výber."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ή σύρετε για να επιλέξετε πλήκτρα. Πατήστε ξανά για αποεπιλογή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck eller dra för att välja tangenter. Tryck igen för att avmarkera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk eller træk for at vælge taster. Tryk igen for at fravælge."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk eller dra for å velge taster. Trykk igjen for å oppheve valget."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse näppäimet napauttamalla tai vetämällä. Napauta uudelleen peruuttaaksesi valinnan."
