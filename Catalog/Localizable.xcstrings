    "Lift on the last one. The word lands, with a space after it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lig op die laaste een. Die woord land, met 'n spasie daarna."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb den Finger beim letzten Buchstaben. Das Wort steht da, mit Leerzeichen dahinter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta el dedo en la última. La palabra aparece, con un espacio detrás."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõsta sõrm viimasel. Sõna maandub, järgneb tühik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève le doigt sur la dernière. Le mot s'inscrit, suivi d'une espace."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utolsónál emeld fel. A szó megjelenik, utána szóközzel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solleva sull'ultima. La parola compare, con uno spazio dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の文字で指を離します。単語が入力され、後ろに空白が入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 글자에서 손가락을 떼세요. 단어가 입력되고 뒤에 공백이 붙습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Angkat jari pada huruf terakhir. Perkataan itu muncul, dengan ruang selepasnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta o dedo na última. A palavra aparece, com um espaço a seguir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимите палец на последней. Слово встанет на место, а за ним — пробел."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在最后一个字母上抬起手指。词就写好了，后面还带一个空格。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridicați pe ultimul. Cuvântul aterizează, cu un spațiu după el."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Til de laatste op. Het woord landt, met een spatie erna."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在最後一個字母上抬起手指。詞就寫好了，後面還帶一個空格。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podnieś się na ostatnim. Słowo „ląduje” ze spacją po nim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підніміть останній. Слово приземляється з пробілом після нього."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuncuyu kaldırın. Kelime, arkasında bir boşluk bırakarak gelir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvedněte na posledním. Slovo přistane s mezerou za ním."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdvihnite na poslednom. Slovo pristane s medzerou za ním."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σήκωσε στο τελευταίο. Η λέξη προσγειώνεται, με ένα κενό μετά από αυτήν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft på den sista. Ordet landar, med ett mellanslag efter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft på den sidste. Ordet lander med et mellemrum efter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft på den siste. Ordet lander, med et mellomrom etter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosta viimeiseen. Sana laskeutuu välilyönnillä sen jälkeen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angkat yang terakhir. Kata tersebut mendarat, dengan spasi setelahnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nâng lên cái cuối cùng. Từ tiếp đất, với một khoảng trắng sau nó."
          }
        }
      }
    },
    "Lifts every key off the background.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lig elke sleutel van die agtergrond af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebt jede Taste vom Hintergrund ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despega las teclas del fondo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõstab iga klahvi taustast lahti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décolle chaque touche du fond."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden billentyűt elemel a háttértől."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stacca ogni tasto dallo sfondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーが背景から浮き上がって見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 배경 위로 떠 보여요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengangkat setiap kekunci daripada latar belakang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta cada tecla do fundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приподнимает каждую клавишу над фоном."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让每个按键从背景上浮起来。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridică fiecare cheie de pe fundal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haalt elke toets van de achtergrond."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓每個按鍵從背景上浮起來。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podnosi każdy klawisz z tła."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє кожну клавішу з фону."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm tuşları arka plandan kaldırır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvedne všechny klávesy z pozadí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdvihne každý kľúč z pozadia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σηκώνει κάθε πλήκτρο από το φόντο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyfter varje tangent från bakgrunden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løfter hver tast fra baggrunden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løfter hver tast fra bakgrunnen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nostaa jokaisen näppäimen pois taustalta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angkat setiap tombol dari latar belakang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấc mọi phím ra khỏi nền."
          }
        }
      }
    },
    "Lifts the entire keyboard up from the bottom edge of the keyboard extension.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lig die hele sleutelbord op vanaf die onderste rand van die sleutelborduitbreiding."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebt die ganze Tastatur vom unteren Rand der Tastaturerweiterung an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube todo el teclado desde el borde inferior de la extensión de teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõstab terve klaviatuuri klaviatuurilaienduse alumisest servast üles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulève tout le clavier depuis le bord inférieur de l'extension."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Feljebb emeli az egész billentyűzetet a billentyűzet-kiterjesztés alsó szélétől."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solleva tutta la tastiera dal bordo inferiore dell'estensione tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボード拡張機能の下端から、キーボード全体を持ち上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 확장의 아래 가장자리에서 키보드 전체를 위로 올려 줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Angkat seluruh papan kekunci naik dari tepi bawah sambungan papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta o teclado todo a partir da margem de baixo da extensão de teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимает всю клавиатуру над нижним краем расширения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
