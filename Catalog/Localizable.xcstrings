    "Text and images you copy while typing with Clink will appear here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text und Bilder, die du beim Tippen mit Clink kopierst, tauchen hier auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí verás el texto y las imágenes que copies mientras escribes con Clink."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte et les images que tu copies en tapant avec Clink apparaîtront ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt jelenik meg a szöveg és a képek, amiket a Clinkkel gépelés közben másolsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo e le immagini che copi mentre scrivi con Clink compaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink で入力中にコピーしたテキストや画像がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink로 입력하는 동안 복사한 텍스트랑 이미지가 여기에 나와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks dan gambar yang anda salin semasa menaip dengan Clink akan muncul di sini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto e as imagens que copiares enquanto escreves com o Clink aparecem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст и изображения, скопированные во время печати в Clink, появятся здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Clink 打字时复制的文字和图片会显示在这里。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst ja pildid, mida sa Clinkiga tipides kopeerid, ilmuvad siia."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teks en beelde wat jy kopieer terwyl jy met Clink tik, sal hier verskyn."
          }
        }
      }
    },
