    "Symbol on every letter’s long-press (A → @, S → #, …), no accents": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Simbool op elke letter se langdruk (A → @, S → #, …), geen aksent nie"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbol beim langen Drücken jedes Buchstabens (A → @, S → #, …), keine Akzente"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un símbolo en cada pulsación larga de letra (A → @, S → #, …), sin acentos"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sümbol iga tähe pikkvajutusel (A → @, S → #, …), aksentideta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un symbole sur l'appui long de chaque lettre (A → @, S → #, …), sans accents"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szimbólum minden betű hosszú lenyomásán (A → @, S → #, …), ékezetek nélkül"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un simbolo sulla pressione prolungata di ogni lettera (A → @, S → #, …), senza accenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての文字の長押しで記号 (A → @, S → #, …)、アクセントなし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 글자를 길게 누르면 기호 (A → @, S → #, …), 악센트는 없어요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simbol pada tekan lama setiap huruf (A → @, S → #, …), tiada aksen"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Símbolo no toque prolongado de cada letra (A → @, S → #, …), sem acentos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Символ по долгому нажатию на каждой букве (A → @, S → #, …), без акцентов"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个字母长按都有一个符号（A → @, S → #, …），不带重音"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Simbol pe apăsarea lungă a fiecărei litere (A → @, S → #, …), fără accente"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbool bij lang indrukken van elke letter (A → @, S → #, …), geen accenten"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個字母長按都有一個符號（A → @, S → #, …），不帶重音"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbol po długim naciśnięciu każdej litery (A → @, S → #, …), bez akcentów"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Символ при тривалому натисканні кожної літери (A → @, S → #, …), без наголосів"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her harfe uzun basıldığında sembol (A → @, S → #,…), vurgu yok"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbol na dlouhém stisku každého písmene (A → @, S → #, …), bez diakritiky"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbol pri dlhom stlačení každého písmena (A → @, S → #, ...), bez diakritických znamienok"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύμβολο στο παρατεταμένο πάτημα κάθε γράμματος (A → @, S → #, …), χωρίς τόνους"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbol på varje bokstavs långtryckning (A → @, S → #, …), inga accenter"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbol på hvert bogstavs lange tryk (A → @, S → #, …), ingen accenter"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbol på hver bokstavs langtrykk (A → @, S → #, …), ingen aksenter"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Symboli jokaisen kirjaimen pitkässä painalluksessa (A → @, S → #, …), ei aksenttimerkkejä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simbol di setiap huruf ditekan lama (A → @, S → #, …), tanpa aksen"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ký hiệu khi nhấn và giữ mỗi chữ cái (A → @, S → #, …), không có dấu"
          }
        }
      }
    },
