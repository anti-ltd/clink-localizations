          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて端末上で動作します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 게 기기에서 실행돼요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya berjalan pada peranti"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo corre no dispositivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё работает на устройстве"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都在本机运行"
          }
        }
      }
    },
    "Everything stays on this device. This clears the copies in iCloud and turns sync off.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles bly op hierdie toestel. Dit maak die kopieë in iCloud skoon en skakel sinkronisering af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf diesem Gerät. Das hier löscht die Kopien in iCloud und schaltet die Synchronisierung aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en este dispositivo. Esto borra las copias de iCloud y desactiva la sincronización."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik jääb sellesse seadmesse. See tühjendab koopiad iCloudist ja lülitab sünkroonimise välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur cet appareil. Cette action efface les copies dans iCloud et désactive la synchronisation."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden ezen az eszközön marad. Ez az iCloudban lévő másolatokat törli, és kikapcsolja a szinkronizálást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta su questo dispositivo. Questa azione cancella le copie su iCloud e disattiva la sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてこの端末に残ります。iCloud上のコピーを削除し、同期をオフにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 이 기기에 그대로 남습니다. iCloud에 있는 사본을 지우고 동기화를 끕니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya kekal pada peranti ini. Tindakan ini memadam salinan dalam iCloud dan mematikan penyegerakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica neste dispositivo. Isto apaga as cópias no iCloud e desliga a sincronização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё остаётся на этом устройстве. Это удалит копии в iCloud и выключит синхронизацию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容都会保留在这台设备上。此操作会清除 iCloud 中的副本并关闭同步。"
          }
        }
      }
    },
    "Everything you made comes along": {
      "extractionState": "stale",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles wat jy gemaak het kom saam"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du gestaltet hast, kommt mit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que creaste te acompaña"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik, mida lõid, tuleb kaasa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que tu as créé te suit"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden, amit készítettél, veled jön"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che hai creato viene con te"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作ったものはぜんぶ一緒に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 만든 모든 것이 그대로"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang anda buat dibawa bersama"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que criaste vem contigo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что вы сделали, едет с вами"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你做的一切随身携带"
          }
        }
      }
    },
    "Everything you type. Learned words can travel if you switch that on, but never the messages you typed them in.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles wat jy tik. Aangeleerde woorde kan reis as jy dit aanskakel, maar nooit die boodskappe waarin jy dit ingetik het nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du tippst. Gelernte Wörter können mitreisen, wenn du das einschaltest – die Nachrichten, in denen du sie getippt hast, nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que escribes. Las palabras aprendidas pueden viajar si lo activas, pero nunca los mensajes en los que las escribiste."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik, mida tipid. Õpitud sõnad saavad reisida kaasa, kui selle sisse lülidad, aga mitte kunagi sõnumid, milles sa neid tipisid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que tu écris. Les mots appris peuvent voyager si tu l'actives, mais jamais les messages dans lesquels tu les as tapés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden, amit írsz. A tanult szavak utazhatnak, ha bekapcsolod, de az üzenetek, amelyekben leírtad őket, soha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto quello che scrivi. Le parole apprese possono viaggiare se lo attivi, ma non i messaggi in cui le hai scritte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力した内容そのもの。学習した単語はオンにすれば同期できますが、それを打ち込んだメッセージは決して送られません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력한 내용 자체. 학습된 단어는 켜면 동기화되지만, 그 단어를 입력한 메시지는 절대 나가지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang anda taip. Perkataan dipelajari boleh merentas peranti jika anda hidupkannya, tetapi mesej tempat anda menaipnya tidak sekali-kali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que escreves. As palavras aprendidas podem viajar se ligares isso, mas nunca as mensagens onde as escreveste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что вы печатаете. Выученные слова могут переезжать, если вы это включите, но сами сообщения — никогда."
          }
        },
