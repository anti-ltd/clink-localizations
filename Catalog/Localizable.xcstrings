    "In Cling, go to Settings ▸ Connected apps and turn Clink on.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gaan in Cling na Instellings ▸ Gekoppelde toepassings en skakel Clink aan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in Cling zu Einstellungen ▸ Verbundene Apps und aktiviere Clink."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Cling, ve a Ajustes ▸ Apps conectadas y activa Clink."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava Clingis Seaded ▸ Ühendatud rakendused ja lülita Clink sisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Cling, allez dans Réglages ▸ Apps connectées et activez Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clingben nyisd meg a Beállítások ▸ Csatlakoztatott appok menüt, és kapcsold be a Clinket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Cling, vai su Impostazioni ▸ App connesse e attiva Clink."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling の設定 ▸ 連携アプリ を開き、Clink をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling에서 설정 ▸ 연결된 앱으로 이동해 Clink를 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam Cling, pergi ke Tetapan ▸ Apl bersambung dan hidupkan Clink."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No Cling, vá a Definições ▸ Apps ligadas e ative o Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Cling откройте «Настройки» ▸ «Подключённые приложения» и включите Clink."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
