          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink konnte die Datei nicht lesen. Probier wav, m4a oder mp3."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink no pudo leer ese archivo. Prueba un wav, m4a o mp3."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ei saanud seda faili lugeda. Proovi wav, m4a või mp3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink n’a pas pu lire ce fichier. Essaie un wav, m4a ou mp3."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink nem tudta olvasni a fájlt. Próbálj wav, m4a vagy mp3 fájlt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
