    "Comma and period beside the space bar": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Komma en punt langs die spasiebalk"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komma und Punkt neben der Leertaste"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coma y punto junto a la barra espaciadora"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Koma ja punkt tühikuklahvi kõrval"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Virgule et point à côté de la barre d'espace"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vessző és pont a szóköz mellett"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Virgola e punto accanto alla barra spaziatrice"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースバーの横にカンマとピリオド"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 바 옆에 쉼표와 마침표"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Koma dan noktah di sebelah bar ruang"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vírgula e ponto ao lado da barra de espaços"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запятая и точка рядом с пробелом"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空格键旁边的逗号和句号"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Virgulă și punct lângă bara de spațiu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komma en punt naast de spatiebalk"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
