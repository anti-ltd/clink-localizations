    "Off just uppercases these while shift or caps-lock is on (á → Á). On lets you pick a separate shifted set.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Af net hoofletters hierdie terwyl shift of caps-lock aan is (á → Á). Aan laat jou 'n aparte geskuifde stel kies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Diese werden bei Umschalt oder Feststelltaste nur großgeschrieben (á → Á). An: Du kannst einen eigenen Umschalt-Satz wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado, solo pasan a mayúsculas con Mayús o Bloq Mayús activado (á → Á). Activado, puedes elegir un conjunto distinto para Mayús."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Väljas kirjutab need vaid suureks, kui tõstuklahv või Caps Lock on all (á → Á). Sees saad valida eraldi tõstukomplekti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, elles passent juste en majuscules quand Maj ou le verrouillage majuscule est actif (á → Á). Activé, tu peux choisir un jeu distinct pour Maj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikapcsolva ezek csak nagybetűsek lesznek Shift vagy Caps Lock alatt (á → Á). Bekapcsolva külön shift-készletet választhatsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato, con shift o blocco maiuscole diventano solo maiuscole (á → Á). Attivato, puoi scegliere un set separato per lo shift."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフのときはシフトや Caps Lock 中にそのまま大文字になるだけです（á → Á）。オンにすると別のシフト用セットを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 시프트나 캡스 락이 켜져 있을 때 그냥 대문자가 돼요 (á → Á). 켜면 별도의 시프트 세트를 고를 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mati: huruf ini hanya jadi besar semasa shift atau caps lock aktif (á → Á). Hidup: boleh pilih set shift yang berasingan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado, apenas passam a maiúsculas com o shift ou o caps lock ativo (á → Á). Ativado, podes escolher um conjunto separado para o shift."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено — они просто становятся заглавными при Shift или Caps Lock (á → Á). Включено — можно задать отдельный набор для Shift."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时，Shift 或大写锁定开启会直接变成大写（á → Á）。开启后可以单独选择一组 Shift 字符。"
          }
        }
      }
    },
    "Off lets strips and tool tiles float on the keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Af laat stroke en gereedskapteëls op die sleutelbord dryf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Streifen und Kacheln schweben auf der Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado, las franjas y baldosas flotan sobre el teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Väljas laseb ribadel ja tööriistaplaatidel klaviatuuril hõljuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, les barres et tuiles flottent sur le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ki: a sávok és csempék a billentyűzeten lebegnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivo: strisce e piastrelle fluttuano sulla tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると帯やタイルがキーボード上に浮かびます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 띠와 타일이 키보드 위에 뜹니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimatikan: jalur dan jubin terapung pada papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado: faixas e mosaicos flutuam no teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В выключенном состоянии полосы и плитки инструментов свободно лежат на клавиатуре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，条带和瓷砖会浮在键盘上。"
          }
        }
      }
    },
    "Off, the rest of the bar stays where it is.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aus, bleibt der Rest der Leiste, wo er ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está desactivado, el resto de la barra se queda donde está."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Välja lülitatuna jääb ülejäänud riba oma kohale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, le reste de la barre reste en place."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikapcsolva a sáv többi része a helyén marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, il resto della barra resta dov'è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにしても、バーのほかの項目はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄더라도 바의 나머지 항목은 그대로 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika dimatikan, bahagian lain bar kekal di tempatnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado, o resto da barra fica onde está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключить, остальная панель останется на месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，栏中其他项目保持原位。"
          }
        }
      }
    },
