    "Tap a colored tile to open that tool.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik 'n gekleurde teël om daardie instrument oop te maak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe eine farbige Kachel, um dieses Tool zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una baldosa de color para abrir esa herramienta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta värvilist plaati, et see tööriist avada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une tuile colorée pour ouvrir cet outil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy színes csempére az eszköz megnyitásához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una piastrella colorata per aprire quello strumento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色付きタイルをタップしてそのツールを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색 타일을 탭하면 그 도구가 열립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik jubin berwarna untuk buka alat itu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca um mosaico colorido para abrir essa ferramenta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь цветной плитки, чтобы открыть этот инструмент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点彩色瓷砖即可打开该工具。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți o placă colorată pentru a deschide instrumentul respectiv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een gekleurde tegel om dat hulpmiddel te openen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點彩色瓷磚即可開啟該工具。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij kolorowy kafelek, aby otworzyć to narzędzie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться кольорової плитки, щоб відкрити цей інструмент."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aracı açmak için renkli bir döşemeye dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na barevnou dlaždici otevřete tento nástroj."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na farebnú dlaždicu otvoríte tento nástroj."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ένα χρωματιστό πλακίδιο για να ανοίξετε αυτό το εργαλείο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en färgad ruta för att öppna det verktyget."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en farvet flise for at åbne det værktøj."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en farget flis for å åpne det verktøyet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa työkalu napauttamalla värillistä laatta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk ubin berwarna untuk membuka alat itu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào ô màu để mở công cụ đó."
          }
        }
      }
    },
