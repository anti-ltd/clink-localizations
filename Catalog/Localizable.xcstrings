        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 엘리먼트는 플러그인이 그립니다. 플러그인 자체 설정은 플러그인 탭에 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugin melukis elemen ini. Tetapannya sendiri ada pada tab Plugin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O plugin desenha este elemento. As definições dele estão no separador Plugins."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот элемент рисует плагин. Его собственные настройки находятся на вкладке «Плагины»."
