        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут немає нічого читабельного. Або він порожній, або його написала новіша версія Clink."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada okunabilir hiçbir şey yok. Ya boş ya da Clink'in daha yeni bir sürümü yazdı."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není tu nic k přečtení. Buď je prázdný, nebo to napsala novější verze Clink."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie je tu nič čitateľné. Buď je prázdny, alebo to napísala novšia verzia Clink."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει τίποτα αναγνώσιμο εδώ μέσα. Είτε είναι άδειο, είτε το έγραψε μια νεότερη έκδοση του Clink."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inget läsbart här. Antingen är den tom, eller så har en nyare version av Clink skrivit den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er intet læsbart herinde. Enten er den tom, eller også har en nyere version af Clink skrevet den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke noe lesbart her. Enten er den tom, eller en nyere versjon av Clink skrev den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täällä ei ole mitään luettavaa. Joko se on tyhjä tai Clink:n uudempi versio kirjoitti sen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang bisa dibaca di sini. Entah itu kosong, atau Clink versi terbaru aja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì có thể đọc được ở đây. Hoặc nó trống hoặc phiên bản mới hơn của Clink đã viết nó."
          }
        }
      }
    },
    "Thermal glow per key: landing centroid, spread & traffic": {
      "extractionState": "manual",
      "localizations": {
