          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znacznik zapisywania skrótu z podwójną spacją."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначка, яку пише ярлик подвійного пробілу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çift boşluklu kısayolun yazdığı işaret."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Značka zapisuje zkratka s dvojitou mezerou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Značka zapisuje skratka s dvojitou medzerou."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σημάδι που γράφει η συντόμευση διπλού διαστήματος."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeringen som genvägen med dubbla mellanslag skriver."
          }
        },
        "da": {
