    "Up to 32 characters. Leave blank for the default label.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 32 Zeichen. Lass das Feld leer, um die Standardbeschriftung zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta 32 caracteres. Deja el campo vacío para usar la etiqueta predeterminada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuni 32 märki. Vaikimisi teksti kasutamiseks jäta väli tühjaks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "32 caractères maximum. Laisse ce champ vide pour utiliser le texte par défaut."
          }
        },
        "hu": {
