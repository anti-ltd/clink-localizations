    "This font started from %@, so its letters are someone else's work and Clink won't export it as a file. A font you draw from scratch can be exported.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta fuente parte de %@, así que sus letras son obra de otra persona y Clink no la exportará como archivo. Una fuente que dibujes desde cero sí se puede exportar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette police est basée sur %@ : ses lettres sont l’œuvre de quelqu’un d’autre, donc Clink ne peut pas l’exporter en fichier. Tu peux exporter une police que tu dessines entièrement toi-même."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Schrift geht von %@ aus, ihre Buchstaben sind also fremde Arbeit, und Clink exportiert sie nicht als Datei. Eine von Grund auf gezeichnete Schrift lässt sich exportieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo font parte da %@, quindi le sue lettere sono lavoro di qualcun altro e Clink non lo esporterà come file. Un font che disegni da zero può essere esportato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta fonte partiu de %@, por isso as letras são trabalho de outra pessoa e o Clink não a exporta como ficheiro. Uma fonte que desenhe de raiz pode ser exportada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот шрифт создан на основе %@, поэтому его буквы — чужая работа, и Clink не экспортирует его в файл. Шрифт, нарисованный с нуля, экспортировать можно."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fon ini bermula daripada %@, jadi hurufnya ialah hasil kerja orang lain dan Clink tidak akan mengeksportnya sebagai fail. Fon yang anda lukis dari awal boleh dieksport."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a betűtípus %@ alapján készült, így a betűi más munkája, és a Clink nem exportálja fájlként. A nulláról rajzolt betűtípus exportálható."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォントは%@をもとにしているため、その文字は他者の制作物であり、Clinkはファイルとして書き出しません。ゼロから描いたフォントは書き出せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个字体基于 %@ 制作，字形是他人的作品，Clink 不会将其导出为文件。你从零绘制的字体可以导出。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 글꼴은 %@에서 시작했으므로 글자가 다른 사람의 작업물이며 Clink는 파일로 내보내지 않습니다. 처음부터 직접 그린 글꼴은 내보낼 수 있습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See font sai alguse fondist %@, seega on selle tähed kellegi teise töö ja Clink ei ekspordi seda failina. Nullist joonistatud fondi saab eksportida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest font a început de la %@, așa că literele sale sunt opera altcuiva și Clink nu îl va exporta ca fișier. Un font pe care îl desenați de la zero poate fi exportat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit lettertype is gestart vanuit %@, dus de letters zijn het werk van iemand anders en Clink zal het niet als bestand exporteren. Een lettertype dat u helemaal opnieuw tekent, kan worden geëxporteerd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個字型基於 %@ 製作，字形是他人的作品，Clink 不會將其匯出為檔案。你從零繪製的字型可以匯出。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie lettertipe is gebaseer op %@; die letters is dus iemand anders se werk en Clink sal dit nie as 'n lêer uitvoer nie.'n Lettertipe wat jy van nuuts af teken, kan uitgevoer word."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta czcionka zaczęła się od %@, więc jej litery są dziełem kogoś innego i Clink nie wyeksportuje jej jako pliku. Czcionkę narysowaną od podstaw można wyeksportować."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей шрифт походить від %@, тому його букви є чужою роботою, і Clink не експортує його як файл. Шрифт, який ви малюєте з нуля, можна експортувати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yazı tipi %@'ten başlatılmıştır, dolayısıyla harfleri başkasının eseridir ve Clink onu bir dosya olarak dışa aktarmaz. Sıfırdan çizdiğiniz bir yazı tipi dışa aktarılabilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto písmo začalo ze %@, takže jeho písmena jsou dílem někoho jiného a Clink jej neexportuje jako soubor. Písmo, které nakreslíte od začátku, lze exportovat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto písmo začalo zo %@, takže jeho písmená sú dielom niekoho iného a Clink ho neexportuje ako súbor. Písmo, ktoré nakreslíte od začiatku, je možné exportovať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η γραμματοσειρά ξεκίνησε από το %@, επομένως τα γράμματά της είναι δουλειά κάποιου άλλου και το Clink δεν θα την εξαγάγει ως αρχείο. Μια γραμματοσειρά που σχεδιάζετε από την αρχή μπορεί να εξαχθεί."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta teckensnitt startade från %@, så dess bokstäver är någon annans arbete och Clink kommer inte att exportera det som en fil. Ett teckensnitt som du ritar från grunden kan exporteras."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne skrifttype startede fra %@, så dens bogstaver er en andens arbejde, og Clink eksporterer den ikke som en fil. En skrifttype, du tegner fra bunden, kan eksporteres."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne fonten startet fra %@, så bokstavene er andres arbeid, og Clink vil ikke eksportere den som en fil. En skrift du tegner fra bunnen av kan eksporteres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä fontti sai alkunsa %@:stä, joten sen kirjaimet ovat jonkun muun työtä, eikä Clink vie sitä tiedostona. Tyhjästä piirtämäsi fontti voidaan viedä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Font ini dimulai dari %@, jadi hurufnya adalah karya orang lain dan Clink tidak akan mengekspornya sebagai file. Font yang Anda gambar dari awal dapat diekspor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phông chữ này bắt đầu từ %@, vì vậy các chữ cái của nó là tác phẩm của người khác và Clink sẽ không xuất nó dưới dạng tệp. Phông chữ bạn vẽ từ đầu có thể được xuất."
          }
        }
      }
    },
