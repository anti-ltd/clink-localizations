          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão no iCloud para sincronizar entre os seus dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в iCloud, чтобы синхронизировать между устройствами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 iCloud 以在设备间同步。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
