    "Not written down here? Search your own question and Apple Intelligence answers it from this page.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie hier neergeskryf nie? Soek jou eie vraag en Apple Intelligence beantwoord dit vanaf hierdie bladsy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steht hier nicht? Such deine eigene Frage — Apple Intelligence beantwortet sie aus dieser Seite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No está escrito aquí? Busca tu propia pregunta y Apple Intelligence la responde a partir de esta página."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Siin pole kirjas? Otsi oma küsimust ja Apple Intelligence vastab sellelt lehelt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas écrit ici ? Cherche ta propre question : Apple Intelligence y répond à partir de cette page."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs itt leírva? Keress rá a saját kérdésedre, és az Apple Intelligence ebből az oldalból válaszol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è scritto qui? Cerca la tua domanda e Apple Intelligence risponde partendo da questa pagina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに書かれていない場合は、自分の質問を検索してください。Apple Intelligenceがこのページをもとに答えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 없나요? 직접 질문을 검색하면 Apple Intelligence가 이 페이지를 바탕으로 답합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada tertulis di sini? Cari soalan anda sendiri dan Apple Intelligence menjawabnya daripada halaman ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está escrito aqui? Procura a tua própria pergunta e a Apple Intelligence responde a partir desta página."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь про это не написано? Задайте свой вопрос в поиске — Apple Intelligence ответит на него по этой странице."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里没写？直接搜你自己的问题，Apple Intelligence 会依据本页作答。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu este scris aici? Căutați propria întrebare și Apple Intelligence îi răspunde de pe această pagină."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat het hier niet opgeschreven? Zoek uw eigen vraag en Apple Intelligence beantwoordt deze vanaf deze pagina."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡沒寫？直接搜你自己的問題，Apple Intelligence 會依據本頁作答。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zapisano tutaj? Wyszukaj własne pytanie, a Apple Intelligence odpowie na nie na tej stronie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут не записано? Знайдіть власне запитання, і Apple Intelligence відповість на нього на цій сторінці."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada yazmıyor musun? Kendi sorunuzu arayın ve Apple Intelligence bu sayfadan yanıtlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není zde napsáno? Vyhledejte svou vlastní otázku a Apple Intelligence na ni odpoví na této stránce."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie je tu napísané? Vyhľadajte svoju vlastnú otázku a Apple Intelligence na ňu odpovie na tejto stránke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι γραμμένο εδώ; Αναζητήστε τη δική σας ερώτηση και το Apple Intelligence απαντά από αυτήν τη σελίδα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte nedskrivet här? Sök på din egen fråga och Apple Intelligence svarar på den från den här sidan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke skrevet ned her? Søg på dit eget spørgsmål, og Apple Intelligence besvarer det fra denne side."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke skrevet ned her? Søk på ditt eget spørsmål og Apple Intelligence svarer på det fra denne siden."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Eikö tänne ole kirjoitettu? Etsi oma kysymyksesi ja Apple Intelligence vastaa siihen tältä sivulta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ditulis di sini? Cari pertanyaan Anda sendiri dan Apple Intelligence menjawabnya dari halaman ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không được viết ra ở đây? Tìm kiếm câu hỏi của riêng bạn và Apple Intelligence trả lời câu hỏi đó từ trang này."
          }
        }
      }
    },
