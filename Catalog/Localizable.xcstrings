    "Relaxed and everyday, for friends and chat.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Locker und alltäglich, für Freunde und Chats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Relajado y de diario: para amigos y chats."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détendu et quotidien, pour les amis et les discussions."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Laza, hétköznapi, barátokhoz és csevegéshez."
          }
        },
        "it": {
