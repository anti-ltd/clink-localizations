        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 키가 자기를 어떻게 표시할지예요: 깃발, 지구본, 지역 코드. 깃발이 없으면 지구본으로 대체돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
