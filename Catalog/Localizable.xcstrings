            "state": "translated",
            "value": "点按按键或在按键上拖动手指，即可上色。"
          }
        }
      }
    },
    "Tap or drag to reset a color to its inherited value.": {
      "comment": "Canvas erase-tool instruction. Remove the selected color override so the key uses the color inherited from its group or theme. Does not remove the key or other customization.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oder streiche, um wieder die übergeordnete Farbe zu übernehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap or drag to reset a color to its inherited value."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca o desliza el dedo para restablecer el color heredado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta või lohista, et taastada päritud värv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie ou fais glisser ton doigt pour rétablir la couleur héritée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints vagy húzd az ujjad az örökölt szín visszaállításához."
          }
        },
        "it": {
