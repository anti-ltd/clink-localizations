    "Slow, sparse and soft. Barely there behind the keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stadig, yl en sag. Skaars daar agter die sleutels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsam, spärlich und weich. Hinter den Tasten kaum zu bemerken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lento, disperso y suave. Casi no se nota detrás de las teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aeglane, hõre ja pehme. Klahvide taga vaevu märgatav."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lent, clairsemé et doux. À peine perceptible derrière les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassú, ritka és lágy. Alig észrevehető a billentyűk mögött."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lento, rado e morbido. Dietro i tasti si nota appena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり、控えめ、やわらかく。キーの後ろでほとんど目立ちません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "느리고 성기고 부드럽게. 키 뒤에서 거의 눈에 띄지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlahan, jarang dan lembut. Hampir tidak kelihatan di belakang kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lento, disperso e suave. Quase não se nota por trás das teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленно, редко и мягко. За клавишами почти незаметно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢、疏、柔。在按键后方几乎察觉不到。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lent, rar și moale. Abia acolo în spatele cheilor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Langzaam, schaars en zacht. Nauwelijks achter de sleutels."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "慢、疏、柔。在按鍵後方幾乎察覺不到。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powolne, rzadkie i miękkie. Ledwo tam za klawiszami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повільний, рідкісний і м'який. Ледве там за ключами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yavaş, seyrek ve yumuşak. Anahtarların arkasında zar zor var."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomalé, řídké a měkké. Sotva tam za klíči."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomalé, riedke a mäkké. Sotva tam za kľúčmi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αργό, αραιό και απαλό. Μόλις εκεί πίσω από τα κλειδιά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Långsam, sparsam och mjuk. Knappt där bakom nycklarna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsomt, sparsomt og blødt. Knap der bag tasterne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakte, sparsom og myk. Så vidt bak nøklene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidasta, harvaa ja pehmeää. Hädin tuskin avainten takana."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lambat, jarang dan lembut. Hampir tidak ada di belakang kunci."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chậm rãi, thưa thớt và mềm mại. Hầu như không có đằng sau các phím."
          }
        }
      }
    },
    "Slowly moves keys to where you actually tap": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweeg sleutels stadig na waar jy werklik tik"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegt die Tasten langsam dorthin, wo du tatsächlich tippst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve poco a poco las teclas hacia donde tocas de verdad"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Liigutab klahvid aeglaselt sinna, kuhu sa tegelikult vajutad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace lentement les touches vers l'endroit où tu appuies vraiment"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassan oda mozgatja a billentyűket, ahová valójában koppintasz"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta lentamente i tasti verso dove tocchi davvero"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際にタップする場所へ、キーを少しずつ動かします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 실제로 누르는 곳으로 천천히 옮겨요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlahan-lahan mengalihkan kekunci ke tempat anda sebenarnya ketik"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Move as teclas devagar para onde realmente tocas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постепенно смещает клавиши туда, куда вы на самом деле нажимаете"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢慢把键移到你实际点按的位置"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mută încet tastele acolo unde atingeți efectiv"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweegt de toetsen langzaam naar de plek waar u daadwerkelijk tikt"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "慢慢把鍵移到你實際點按的位置"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powoli przesuwa klawisze do miejsca, w którym faktycznie stukasz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повільно переміщує клавіші туди, де ви фактично натискаєте"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşları gerçekte dokunduğunuz yere yavaşça hareket ettirir"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomalu přesouvá klávesy tam, kde skutečně klepnete"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomaly presúva klávesy tam, kde skutočne klepnete"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακινεί αργά τα πλήκτρα στο σημείο όπου πραγματικά αγγίζετε"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyttar långsamt tangenterna dit du faktiskt trycker"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytter langsomt tasterne til det sted, hvor du rent faktisk trykker"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytter sakte tastene dit du faktisk trykker"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirtää näppäimiä hitaasti siihen kohtaan, johon todella napautat"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindahkan tombol secara perlahan ke tempat yang sebenarnya Anda ketuk"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ từ di chuyển các phím đến nơi bạn thực sự chạm vào"
          }
        }
      }
    },
