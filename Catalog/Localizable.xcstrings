    "Transcription runs on your device. Your voice isn't sent anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transkripsie loop op jou toestel. Jou stem word nêrens heen gestuur nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transkription läuft auf deinem Gerät. Deine Stimme wird nirgendwohin gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción se realiza en tu dispositivo. Tu voz no se envía a ningún sitio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriptsioon toimub sinu seadmes. Sinu häält ei saadeta kuhugi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription se fait sur ton appareil. Ta voix n'est envoyée nulle part."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az átírás az eszközödön fut. A hangod sehová sem kerül elküldésre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione avviene sul tuo dispositivo. La tua voce non viene inviata da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしはデバイス上で行われます。音声はどこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 변환은 기기에서 실행됩니다. 음성은 어디에도 전송되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripsi berjalan pada peranti anda. Suara anda tidak dihantar ke mana-mana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição corre no teu dispositivo. A tua voz não é enviada para lado nenhum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание идёт на вашем устройстве. Голос никуда не отправляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写在你的设备上完成。你的语音不会被发送到任何地方。"
          }
        }
      }
    },
