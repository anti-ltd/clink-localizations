          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 것도 업로드, 공유 또는 판매되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa dimuat naik, dikongsi atau dijual."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é enviado, partilhado ou vendido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не загружается, не передаётся и не продаётся."
          }
        },
