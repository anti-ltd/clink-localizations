    "Back to the letters. Always shown when the category tabs are off.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terug na die briewe. Word altyd gewys wanneer die kategorie-oortjies af is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück zu den Buchstaben. Wird immer angezeigt, wenn die Kategorie-Tabs aus sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a las letras. Siempre se ve cuando las pestañas de categorías están apagadas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagasi tähtede juurde. Alati nähtav, kui kategooriakaardid on välja lülitatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour aux lettres. Toujours affichée quand les onglets de catégories sont désactivés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissza a betűkhöz. Mindig látszik, ha a kategóriafülek ki vannak kapcsolva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna alle lettere. Resta sempre visibile quando le schede delle categorie sono spente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字に戻ります。カテゴリタブをオフにしているときは常に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자로 돌아가요. 카테고리 탭을 꺼두면 항상 보여요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali ke huruf. Sentiasa ditunjukkan apabila tab kategori dimatikan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta às letras. Aparece sempre quando os separadores de categorias estão desligados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назад к буквам. Всегда видна, когда вкладки категорий выключены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到字母。关掉分类栏时会一直显示。"
          }
        }
      }
    },
