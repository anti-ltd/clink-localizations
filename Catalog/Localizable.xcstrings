    "Calculator sits in the keyboard and drops the result straight into what you're writing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rechner sitzt in der Tastatur und setzt das Ergebnis direkt in deinen Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La calculadora vive en el teclado y suelta el resultado directamente en lo que escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La calculatrice est dans le clavier et dépose le résultat directement dans ce que tu écris."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Számológép a billentyűzeten belül van, és az eredményt egyenesen abba írja, amit épp gépelsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La calcolatrice sta nella tastiera e lascia il risultato direttamente in quello che stai scrivendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電卓はキーボードの中にあり、計算結果をそのまま入力中の文章に入れられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산기는 키보드 안에 있고, 결과를 지금 쓰고 있는 곳에 바로 넣어 줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkulator berada dalam papan kekunci dan memasukkan hasilnya terus ke dalam apa yang anda tulis."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A calculadora está dentro do teclado e larga o resultado directamente no que estás a escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Калькулятор живёт прямо в клавиатуре и вставляет результат в то, что вы пишете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算器就在键盘里，算完直接把结果写进你正在打的内容。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkulaator asub klaviatuuril ja pannab tulemuse otse sinu kirjutatavasse teksti."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sakrekenaar sit in die sleutelbord en laat die resultaat reguit in wat jy skryf."
          }
        }
      }
    },
    "Calculators, snippet boards, pickers: your panels appear behind the keyboard's panel button.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taschenrechner, Snippet-Boards, Picker: deine Panels erscheinen hinter der Panel-Taste der Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculadoras, tableros de fragmentos, selectores: tus paneles aparecen detrás del botón de panel del teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculatrices, tableaux de snippets, sélecteurs : tes panneaux apparaissent derrière le bouton de panneau du clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Számológépek, snippet-táblák, választók: a paneljeid a billentyűzet panel gombja mögött jelennek meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolatrici, bacheche di snippet, selettori: i tuoi pannelli compaiono dietro il pulsante pannelli della tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電卓、スニペット集、ピッカー。あなたのパネルはキーボードのパネルボタンの奥に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산기, 스니펫 모음, 피커: 내가 만든 패널은 키보드의 패널 버튼 뒤에 나타나요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkulator, papan snippet, pemilih: panel anda muncul di sebalik butang panel papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculadoras, quadros de snippets, seletores: os teus painéis aparecem atrás do botão de painel do teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Калькуляторы, доски заготовок, списки выбора — ваши панели появляются за кнопкой панелей на клавиатуре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算器、代码片段板、选择器：你的面板会出现在键盘面板按钮后面。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkulaatorid, nippide tahvlid, valijad: sinu paneelid ilmuvad klaviatuuri paneelinupu taha."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sakrekenaars, brokkieborde, kiesers: jou panele verskyn agter die sleutelbord se paneelknoppie."
          }
        }
      }
    },
