        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işık sütunlardan aşağıya düşüyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Světlo padá po sloupech."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Svetlo padá po stĺpoch."
