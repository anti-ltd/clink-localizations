    "Restore purchases and share Clink Pro between iOS and Android.": {
      "comment": "Optional Clink account page. Connects store purchases across Apple and Android; it does not sync typing or settings.",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel aankope en deel Clink Pro tussen iOS en Android."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle Käufe wieder her und teile Clink Pro zwischen iOS und Android."
          }
        },
