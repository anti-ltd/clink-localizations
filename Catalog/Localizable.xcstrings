    "Make a pack from your own clicks: a file, a recording, or a copy of a built-in one to start from.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maak 'n pak uit jou eie klikke: 'n lêer, 'n opname, of 'n kopie van 'n ingeboude een om van te begin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bau dir ein Paket aus deinen eigenen Klicks – eine Datei, eine Aufnahme oder eine Kopie eines vorinstallierten Pakets als Startpunkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un paquete con tus propios clics: un archivo, una grabación o una copia de uno integrado para empezar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee pakk omaenda klõpsudest: fail, salvestus või sisseehitatud pakist tehtud koopia, millest alustada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un pack avec tes propres clics — un fichier, un enregistrement, ou une copie d'un pack intégré pour partir de quelque chose."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Készíts csomagot a saját kattanásaidból – egy fájlból, egy felvételből, vagy egy beépített csomag másolatából kiindulva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un pacchetto con i tuoi clic — un file, una registrazione o una copia di uno integrato da cui partire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のクリック音でパックを作れます。ファイル、録音、または内蔵パックのコピーから始められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 만든 클릭 소리로 팩을 만들어 보세요. 파일, 녹음, 또는 기본 제공 팩의 복사본에서 시작할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipta pek daripada bunyi klik anda sendiri — daripada fail, rakaman, atau salinan pek terbina dalam sebagai permulaan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria um pacote com os teus próprios cliques — um ficheiro, uma gravação ou uma cópia de um integrado para começares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соберите набор из своих щелчков — из файла, из записи или из копии встроенного набора для начала."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你自己的按键声做一个声音包——可以来自文件、录音，或复制一个内置包作为起点。"
          }
        }
      }
    },
