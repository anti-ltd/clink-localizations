          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF 搜尋已達到每小時上限。請稍後重試。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-soektog het sy uurlikse limiet bereik. Probeer later weer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukiwanie GIF osiągnęło limit godzinowy. Spróbuj ponownie później."
          }
        },
        "uk": {
          "stringUnit": {
