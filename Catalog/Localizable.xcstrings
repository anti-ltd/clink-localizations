    "Your cursor demo, shown live. Swipe it to change movement style.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou wyser-demo, regstreeks gewys. Swiep dit om bewegingstyl te verander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Cursor-Demo, live. Wisch darüber, um die Bewegungsart zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu demo del cursor, en directo. Deslízala para cambiar el modo de movimiento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu kursori demo, reaalajas. Viipa sellel, et liikumisstiili vahetada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta démo du curseur, en direct. Balaie-la pour changer le mode de déplacement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kurzor demó élőben. Húzd el az ujjad rajta a mozgatás módjának váltásához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La demo del cursore, dal vivo. Scorrila per cambiare modalità di movimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルのデモです。スワイプすると移動方式を変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서 데모를 실시간으로 보여 줍니다. 밀어서 이동 방식을 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo kursor anda, secara langsung. Leret untuk tukar cara pergerakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua demo do cursor, ao vivo. Desliza-a para mudar o modo de movimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Демо курсора вживую. Смахните, чтобы сменить способ перемещения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标演示实时展示。左右滑动即可切换移动方式。"
