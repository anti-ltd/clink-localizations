    },
    "All active languages run at once, for bilingual typing.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle aktiewe tale loop gelyktydig, vir tweetalige tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle aktiven Sprachen laufen gleichzeitig, zweisprachiges Tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los idiomas activos funcionan a la vez: escritura bilingüe."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik aktiivsed keeled töötavad korraga, kahekeelseks tipimiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les langues actives marchent en même temps, saisie bilingue."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összes aktív nyelv egyszerre fut, kétnyelvű gépelés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le lingue attive funzionano insieme, digitazione bilingue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにした言語がすべて同時に動きます。二言語での入力です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜 둔 언어가 전부 한꺼번에 돌아가요. 두 언어를 같이 쓰는 방식이에요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua bahasa aktif jalan serentak, penaipan dwibahasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as línguas ativas correm ao mesmo tempo, escrita bilingue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все активные языки работают одновременно — для двуязычной печати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有启用的语言一起跑，双语输入。"
          }
        }
      }
