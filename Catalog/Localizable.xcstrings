    "3pt key · 4pt row. Even gaps between keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "3pt sleutel · 4pt ry. Selfs gapings tussen sleutels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taste 3 pt · Reihe 4 pt. Gleichmäßige Lücken zwischen den Tasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecla 3pt · fila 4pt. Huecos iguales entre teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "3 pt klahv · 4 pt rida. Ühtlased pilud klahvide vahel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche 3 pt · rangée 4 pt. Espaces réguliers entre les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "3 pt billentyű · 4 pt sor. Egyenletes rések a billentyűk közt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasto 3pt · riga 4pt. Spazi uguali tra i tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー3pt · 行4pt。キーの間が均等にあきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 3pt · 행 4pt. 키 사이 간격이 고르게 떨어져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci 3pt · baris 4pt. Jurang sekata antara kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecla 3pt · linha 4pt. Espaços iguais entre as teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиша 3pt · ряд 4pt. Равные зазоры между клавишами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键3pt · 行4pt。按键间距很匀。"
          }
        }
      }
    },
