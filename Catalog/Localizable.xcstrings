    "Renews monthly. Cancel anytime.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hernu maandeliks. Kanselleer enige tyd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich monatlich. Jederzeit kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva cada mes. Cancela cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Uueneb igakuiselt. Tühista igal ajal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvelé chaque mois. Annulable à tout moment."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Havonta megújul. Bármikor lemondhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova ogni mese. Annulla quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月自動更新。いつでもキャンセルできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매월 갱신됩니다. 언제든 해지할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperbaharui setiap bulan. Batal bila-bila masa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova-se mensalmente. Cancela quando quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продлевается раз в месяц. Отменить можно в любой момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月续订。随时可取消。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reînnoiește lunar. Anulați oricând."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt maandelijks verlengd. Annuleer op elk gewenst moment."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月續訂。隨時可取消。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odnawia się co miesiąc. Anuluj w dowolnym momencie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлюється щомісяця. Скасувати будь-коли."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık olarak yenilenir. İstediğiniz zaman iptal edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovuje se měsíčně. Kdykoli zrušit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovuje sa mesačne. Zrušiť kedykoľvek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανανεώνεται κάθε μήνα. Ακύρωση ανά πάσα στιγμή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förnyas varje månad. Avbryt när som helst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes månedligt. Annuller når som helst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes månedlig. Avbryt når som helst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusitaan kuukausittain. Peru milloin tahansa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperbarui setiap bulan. Batalkan kapan saja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gia hạn hàng tháng. Hủy bỏ bất cứ lúc nào."
          }
        }
      }
    },
