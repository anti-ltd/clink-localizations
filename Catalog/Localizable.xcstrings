    "Float each word above a slightly inset target key.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra cada palabra sobre su tecla de destino, ligeramente hundida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche chaque mot au-dessus de sa touche cible, légèrement enfoncée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt jedes Wort über einer leicht abgesenkten Zieltaste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra ogni parola sopra il tasto di destinazione, leggermente incassato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra cada palavra sobre a tecla de destino, ligeiramente rebaixada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает каждое слово над слегка утопленной целевой клавишей."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Paparkan setiap perkataan di atas kekunci sasaran yang sedikit tenggelam."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden szó a kissé besüllyesztett célbillentyűje fölött jelenik meg."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少しへこんだ入力先のキーの上に、各単語を表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将每个词显示在略微下陷的目标按键上方。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 단어를 살짝 들어간 대상 키 위에 표시합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvab iga sõna veidi süvistatud sihtklahvi kohal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Flotați fiecare cuvânt deasupra unei chei țintă ușor introduse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweef elk woord boven een iets verzonken doelsleutel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將每個詞顯示在略微下陷的目標按鍵上方。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat elke woord bo 'n effens ingesenteer sleutel dryf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umieść każde słowo nad lekko wsuniętym klawiszem docelowym."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плавайте кожне слово над злегка вставленою цільовою клавішею."
          }
        },
        "tr": {
          "stringUnit": {
