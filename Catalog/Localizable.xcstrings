    "Hitbox 100%. Targets match the visible keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hitbox 100%. Teikens pas by die sigbare sleutels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trefferfläche 100 %. Die Ziele entsprechen den sichtbaren Tasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Área táctil 100%. Los objetivos coinciden con las teclas visibles."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabamustsoon 100%. Sihid vastavad nähtavatele klahvidele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone tactile 100 %. Les cibles correspondent aux touches visibles."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitbox 100%. A célpontok megegyeznek a látható billentyűkkel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Area di tocco 100%. I bersagli coincidono con i tasti visibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒットボックス 100%。ターゲットが見えているキーと一致します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치 영역 100%. 대상이 보이는 키와 같아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotak sentuh 100%. Sasaran sepadan dengan kekunci yang kelihatan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Área tátil 100%. As zonas coincidem com as teclas visíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зона нажатия 100%. Совпадает с видимыми клавишами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控区 100%。判定区和看到的键一致。"
          }
        }
      }
    },
    "Hitbox 115%. Bigger targets, catches more taps. Best for screen protectors.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hitbox 115%. Groter teikens, vang meer krane. Beste vir skermbeskermers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trefferfläche 115 %. Größere Ziele, fängt mehr Tipps. Am besten bei Schutzfolien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Área táctil 115%. Objetivos más grandes, captan más toques. Ideal para protectores de pantalla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabamustsoon 115%. Suuremad sihid, tabab rohkem vajutusi. Parim ekraanikaitsetele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone tactile 115 %. Cibles plus grandes, attrape plus d'appuis. Idéal avec une protection d'écran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitbox 115%. Nagyobb célpontok, több koppintást fog el. Képernyővédő fóliához a legjobb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Area di tocco 115%. Bersagli più grandi, cattura più tocchi. Ideale per le pellicole protettive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒットボックス 115%。ターゲットが大きくなり、より多くのタップを拾います。保護フィルムに最適。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치 영역 115%. 대상이 커서 탭을 더 잘 잡아요. 화면 보호 필름에 좋아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotak sentuh 115%. Sasaran lebih besar, tangkap lebih banyak ketikan. Terbaik untuk pelindung skrin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Área tátil 115%. Zonas maiores, apanha mais toques. Ideal para películas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зона нажатия 115%. Крупнее, ловит больше нажатий. Лучший вариант с защитной плёнкой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控区 115%。判定区更大，能接住更多点按。最适合贴了屏幕膜时用。"
          }
        }
      }
    },
    "Hitbox 85%. Tight targets, fewer mis-hits between keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hitbox 85%. Stywe teikens, minder mis-treffers tussen sleutels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trefferfläche 85 %. Enge Ziele, weniger Fehltreffer zwischen den Tasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Área táctil 85%. Objetivos ajustados, menos fallos entre teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabamustsoon 85%. Tihedad sihid, vähem eksitamisi klahvide vahel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone tactile 85 %. Cibles serrées, moins d'erreurs entre les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitbox 85%. Szűk célpontok, kevesebb mellényúlás a billentyűk közt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Area di tocco 85%. Bersagli stretti, meno tocchi sbagliati tra i tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒットボックス 85%。ターゲットが小さめで、キー間の押し間違いが減ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치 영역 85%. 대상이 좁아서 키 사이 오타가 줄어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotak sentuh 85%. Sasaran ketat, kurang tersalah antara kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Área tátil 85%. Zonas apertadas, menos enganos entre teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зона нажатия 85%. Плотнее, меньше промахов между клавишами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控区 85%。判定区更紧，键间误触更少。"
          }
        }
      }
    },
