    "Include pinned clips when clearing all history.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit vasgespelde snitte in wanneer alle geskiedenis uitgevee word."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftete Clips mitlöschen, wenn du den ganzen Verlauf leerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir los recortes fijados al borrar todo el historial."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaasa kinnitatud klipid kogu ajaloo tühjendamisel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclure les extraits épinglés quand tu effaces tout l'historique."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rögzített klipeket is törölje az összes előzmény törlésekor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Includi le clip bloccate quando cancelli tutta la cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての履歴を消すとき、ピン留めしたクリップも一緒に消します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 기록을 지울 때 고정한 클립도 같이 지워요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertakan keratan yang dipin apabila anda kosongkan semua sejarah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir os clips fixados ao limpar todo o histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалять и закреплённые фрагменты при очистке всей истории."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空全部历史时，连固定的剪贴一起清掉。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Includeți clipuri fixate atunci când ștergeți tot istoricul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg vastgezette clips toe bij het wissen van de hele geschiedenis."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清空全部歷史時，連固定的剪貼一起清掉。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołącz przypięte klipy podczas czyszczenia całej historii."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Включати закріплені кліпи під час очищення всієї історії."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm geçmişi temizlerken sabitlenmiş klipleri dahil edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při mazání celé historie zahrnout připnuté klipy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri vymazávaní celej histórie zahrnúť pripnuté klipy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συμπεριλάβετε καρφιτσωμένα κλιπ κατά τη διαγραφή όλου του ιστορικού."
          }
        },
        "sv": {
