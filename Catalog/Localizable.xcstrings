    "Typing on the keys needs a membership outside Clink. In here, the whole keyboard stays free.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Om op die sleutels te tik, benodig 'n lidmaatskap buite Clink. Hier binne bly die hele sleutelbord gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Tippen auf den Tasten außerhalb von Clink brauchst du eine Mitgliedschaft. Hier drin bleibt die ganze Tastatur kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribir con las teclas fuera de Clink requiere una suscripción. Aquí dentro, todo el teclado sigue siendo gratis."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvidel tipimine vajab Clinkist väljaspool liikmelisust. Siin sees jääb terve klaviatuur tasuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taper sur les touches en dehors de Clink demande un abonnement. Ici, tout le clavier reste gratuit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűkön való gépeléshez a Clinken kívül tagság kell. Itt bent az egész billentyűzet ingyenes marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per scrivere con i tasti fuori da Clink serve un abbonamento. Qui dentro l’intera tastiera resta gratis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink の外でキーを使って入力するにはメンバーシップが必要です。この中ではキーボード全体が無料のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 밖에서 키로 입력하려면 멤버십이 필요합니다. 여기 안에서는 키보드 전체가 계속 무료입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menaip dengan kekunci di luar Clink memerlukan keahlian. Di dalam sini, seluruh papan kekunci kekal percuma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrever com as teclas fora do Clink exige uma subscrição. Aqui dentro, todo o teclado continua gratuito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы печатать на клавишах за пределами Clink, нужна подписка. Здесь клавиатура целиком остаётся бесплатной."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Clink 之外用按键打字需要会员。在这里，整个键盘始终免费。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru tastarea tastelor este nevoie de un abonament în afara Clink. Aici, întreaga tastatură rămâne liberă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor het typen van de toetsen is een lidmaatschap buiten Clink vereist. Hier blijft het hele toetsenbord vrij."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Clink 之外用按鍵打字需要會員。在這裡，整個鍵盤始終免費。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisanie na klawiszach wymaga członkostwa poza Clink. Tutaj cała klawiatura pozostaje wolna."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введення на клавішах потребує членства за межами Clink. Тут вся клавіатура залишається вільною."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşlara yazmak Clink dışında bir üyeliğe ihtiyaç duyar. Burada klavyenin tamamı serbest kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Psaní na klávesách vyžaduje členství mimo Clink. Zde zůstane celá klávesnice volná."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Písanie na klávesoch vyžaduje členstvo mimo Clink. Tu zostane celá klávesnica voľná."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πληκτρολόγηση στα κλειδιά απαιτεί συνδρομή εκτός του Clink. Εδώ, ολόκληρο το πληκτρολόγιο παραμένει ελεύθερο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att skriva på nycklarna kräver ett medlemskap utanför Clink. Här inne förblir hela tangentbordet fritt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtastning på tasterne kræver et medlemskab uden for Clink. Herinde forbliver hele tastaturet gratis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å skrive på tastene krever et medlemskap utenfor Clink. Her inne forblir hele tastaturet ledig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäimien kirjoittaminen vaatii jäsenyyden Clink:n ulkopuolella. Täällä koko näppäimistö pysyy vapaana."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengetik pada kunci memerlukan keanggotaan di luar Clink. Di sini, seluruh keyboard tetap gratis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc gõ phím cần có tư cách thành viên bên ngoài Clink. Ở đây, toàn bộ bàn phím vẫn miễn phí."
          }
        }
      }
    },
