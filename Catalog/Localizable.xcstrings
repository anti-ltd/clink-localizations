    "Move it back on the page it lives on, or start the lot over from Profiles.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skuif dit terug op die bladsy waarop dit leef, of begin die lot oor vanaf Profiele."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell sie auf der Seite zurück, auf der sie sitzt – oder fang unter „Profile“ ganz von vorn an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a ponerlo como estaba en la página donde vive, o empieza de cero desde Perfiles."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teisalda see tagasi lehele, kus see asub, või alusta kõige otsast peale Profiilidest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remets-le en place sur la page où il se trouve, ou repars de zéro depuis Profils."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsd vissza azon az oldalon, ahol van – vagy kezdd az egészet elölről a Profiloknál."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimettila a posto nella pagina in cui si trova, oppure ricomincia da capo da Profili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その設定があるページで戻すか、プロファイルからまとめてやり直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 설정이 있는 페이지에서 되돌리거나, 프로필에서 전체를 처음부터 다시 시작하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah semula pada halaman tempat ia berada, atau mulakan semuanya semula dari Profil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta a pô-la como estava na página onde vive, ou começa tudo de novo em Perfis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Верните её на той странице, где она живёт, — или начните всё заново из «Профилей»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在它所在的页面改回来，或者从配置文件里全部重来。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutați-l înapoi pe pagina în care locuiește sau începeți lotul de la început din Profiluri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaats het terug naar de pagina waar het op staat, of begin opnieuw vanuit Profielen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在它所在的頁面改回來，或者從配置檔案裡全部重來。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieś go z powrotem na stronę, na której się znajduje, lub rozpocznij wszystko od nowa w Profilach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемістіть його назад на сторінку, на якій він живе, або почніть усе спочатку з профілів."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulunduğu sayfaya geri taşıyın veya her şeye Profiller'den başlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesuňte jej zpět na stránku, na které žije, nebo začněte losování znovu z Profilů."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presuňte ho späť na stránku, na ktorej žije, alebo začnite veľa odznova z Profilov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακινήστε το πίσω στη σελίδα που ζει ή ξεκινήστε την παρτίδα από τα Προφίλ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta tillbaka den på sidan den lever på, eller börja om från Profiler."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt den tilbage på den side, den lever på, eller start partiet forfra fra Profiler."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt den tilbake på siden den lever på, eller start partiet på nytt fra Profiler."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä se takaisin sivulle, jolla se elää, tai aloita erä alusta Profiilista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindahkan kembali ke halaman tempatnya berada, atau mulai lagi dari Profil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di chuyển nó trở lại trang nơi nó tồn tại hoặc bắt đầu lại từ đầu từ Hồ sơ."
          }
        }
      }
    },
