    "Restore this action to its default prompt and color?": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel hierdie handeling terug na sy verstekboodskap en kleur?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion auf ihren Standard-Prompt und ihre Standardfarbe zurücksetzen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restaurar esta acción a su prompt y color predeterminados?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taastada see tegevus oma vaikejuhise ja -värvi juurde?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer cette action à son prompt et sa couleur par défaut ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítod ezt a műveletet az alapértelmezett promptjára és színére?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristinare questa azione al prompt e al colore predefiniti?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアクションを初期のプロンプトと色に戻しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 액션을 기본 프롬프트와 색으로 되돌릴까요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulihkan tindakan ini kepada gesaan dan warna lalainya?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Repor esta ação para o prompt e cor predefinidos?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуть этому действию стандартный запрос и цвет?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要把这个操作恢复为默认提示词和颜色吗？"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restabiliți această acțiune la promptul și culoarea implicită?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze actie herstellen naar de standaardprompt en -kleur?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要把這個操作恢復為預設提示詞和顏色嗎？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywrócić tę akcję do domyślnego monitu i koloru?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновити для цієї дії сповіщення та колір за умовчанням?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu eylem varsayılan istemine ve rengine geri yüklensin mi?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovit tuto akci na výchozí výzvu a barvu?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoviť túto akciu na predvolenú výzvu a farbu?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφορά αυτής της ενέργειας στην προεπιλεγμένη προτροπή και το χρώμα της;"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställa den här åtgärden till dess standardprompt och färg?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du gendanne denne handling til dens standardprompt og farve?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du gjenopprette denne handlingen til standard melding og farge?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palautetaanko tämän toiminnon oletuskehote ja -väri?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembalikan tindakan ini ke prompt dan warna defaultnya?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục hành động này về lời nhắc và màu sắc mặc định của nó?"
          }
        }
      }
    },
