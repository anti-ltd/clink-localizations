    "Nothing I change in the app reaches the keyboard": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Niks wat ek in die toepassing verander, bereik die sleutelbord nie"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ich in der App ändere, kommt nicht auf der Tastatur an"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que cambio en la app no llega al teclado"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Midagi, mida ma rakenduses muudan, ei jõua klaviatuurini"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que je change dans l'app n'arrive pas au clavier"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amit az appban átállítok, nem jelenik meg a billentyűzeten"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che cambio nell'app non arriva alla tastiera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリで変えた設定がキーボードに反映されません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 바꾼 설정이 키보드에 반영되지 않아요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang saya ubah dalam app tidak sampai ke papan kekunci"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que mudo na app não chega ao teclado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего из того, что я меняю в приложении, не доходит до клавиатуры"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App 里改的设置没有生效"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic din ce schimb în aplicație nu ajunge la tastatură"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets dat ik in de app verander, bereikt het toetsenbord"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App 裡改的設定沒有生效"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic, co zmienię w aplikacji, nie dociera do klawiatury"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніщо, що я змінив у програмі, не потрапляє на клавіатуру"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamada değiştirdiğim hiçbir şey klavyeye ulaşmıyor"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic, co v aplikaci změním, se nedostane na klávesnici"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič, čo v aplikácii zmením, sa nedostane na klávesnicu"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα που αλλάζω στην εφαρμογή δεν φτάνει στο πληκτρολόγιο"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget jag ändrar i appen når tangentbordet"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet, jeg ændrer i appen, når tastaturet"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting jeg endrer i appen når tastaturet"
