    "How far the light reaches around the key you press, in key widths.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe ver die lig om die sleutel reik wat jy druk, in sleutelwydtes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit das Licht um die gedrückte Taste reicht, in Tastenbreiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta dónde llega la luz alrededor de la tecla que pulsas, en anchos de tecla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui kaugele ulatub valgus vajutatud klahvi ümber, klahvilaiustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'où la lumière s'étend autour de la touche frappée, en largeurs de touche."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddig ér a fény a lenyomott gomb körül, gombszélességben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fin dove arriva la luce attorno al tasto premuto, in larghezze di tasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押したキーの周りに光が届く範囲（キー幅単位）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누른 키 주변으로 빛이 닿는 범위(키 너비 기준)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejauh mana cahaya sampai di sekeliling kekunci yang ditekan, dalam lebar kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até onde a luz chega em torno da tecla premida, em larguras de tecla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько далеко свет достаёт вокруг нажатой клавиши, в ширинах клавиши."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯光在所按按键周围扩散的范围（以按键宽度计）。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de departe ajunge lumina în jurul tastei pe care o apăsați, în lățimi ale tastei."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe ver het licht rond de toets reikt die u indrukt, in toetsbreedtes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "燈光在所按按鍵周圍擴散的範圍（以按鍵寬度計）。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak daleko światło dociera wokół naciśniętego klawisza, w szerokościach klawiszy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскільки світло досягає клавіші, яку ви натискаєте, у ширині клавіші."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuş genişliklerinde ışığın bastığınız tuşun çevresinde ne kadar uzağa ulaştığı."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak daleko světlo dosáhne kolem klávesy, kterou stisknete, v šířkách kláves."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako ďaleko dosiahne svetlo okolo klávesu, ktorú stlačíte, v šírkach klávesov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο μακριά φτάνει το φως γύρω από το πλήκτρο που πατάτε, σε πλάτη πλήκτρων."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur långt ljuset når runt knappen du trycker på, i tangentbredder."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor langt lyset når omkring den tast, du trykker på, i tastebredder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor langt lyset når rundt tasten du trykker på, i tastebredder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka pitkälle valo ulottuu painamasi näppäimen ympäriltä näppäinleveyksinä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa jauh jangkauan cahaya di sekitar tombol yang Anda tekan, dalam lebar tombol."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng cách ánh sáng chiếu tới xung quanh phím bạn nhấn, tính theo chiều rộng phím."
          }
        }
      }
    },
    "How far up to drag a key before its drag-up action fires: the language switcher, a Tools key, or a long-press variant. Lower triggers more easily, higher prevents accidents.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe ver om 'n sleutel te sleep voordat sy opsleep-aksie begin: die taalwisselaar, 'n Tools-sleutel of 'n langdrukvariant. Laer snellers makliker, hoër voorkom ongelukke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit du eine Taste nach oben ziehen musst, bis ihre Zieh-Aktion auslöst: Sprachumschalter, Werkzeug-Taste oder Haltevariante. Kleiner löst leichter aus, größer verhindert Versehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto hay que arrastrar una tecla hacia arriba para que se active su acción: el selector de idioma, una tecla de herramientas o una variante de pulsación larga. Menos se activa con más facilidad; más evita errores."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui kaugele tuleb klahvi üles lohistada, enne kui selle üleslohistamise tegevus käivitub: keelevalija, tööriistaklahv või pikkvajutuse variant. Madalam käivitub kergemini, kõrgem hoiab õnnetused eemal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance de glissement vers le haut avant que l’action de la touche ne se déclenche : sélecteur de langue, touche Outils ou variante d’appui long. Plus court se déclenche plus facilement, plus long évite les erreurs."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Milyen messzire kell felhúzni egy gombot, hogy elsüljön a húzási művelete: nyelvváltó, Eszközök gomb vagy hosszú nyomásos változat. Kisebb érték könnyebben elsül, nagyobb megelőzi a véletleneket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto trascinare un tasto verso l’alto prima che scatti la sua azione: il selettore lingua, un tasto Strumenti o una variante con pressione prolungata. Meno scatta più facilmente, di più evita errori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの上ドラッグ操作（言語切り替え、ツールキー、長押しバリアント）が発動するまでの距離です。短いほど反応しやすく、長いほど誤操作を防げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 전환기, 도구 키, 길게 누르기 변형 등 위로 끌기 동작이 실행되기까지 키를 얼마나 끌어올려야 하는지입니다. 짧을수록 쉽게 실행되고, 길수록 실수를 막아 줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejauh mana kekunci perlu diseret ke atas sebelum tindakan seretannya berlaku: penukar bahasa, kekunci Alatan, atau varian tekan lama. Lebih pendek lebih mudah tercetus, lebih panjang mengelak tersilap."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até onde arrastar uma tecla para cima antes de a ação de arrasto disparar: o seletor de idioma, uma tecla de ferramentas ou uma variante de toque longo. Menos dispara com mais facilidade, mais evita enganos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько высоко нужно потянуть клавишу, чтобы сработало действие подъёма: переключатель языка, клавиша инструментов или вариант из долгого нажатия. Меньше — срабатывает легче, больше — меньше случайностей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要将按键向上拖动多远，其上拖动作才会触发：语言切换、工具键或长按变体。距离越短越容易触发，越长越不易误触。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de mult să trageți o tastă înainte de a se declanșa acțiunea de tragere: comutatorul de limbă, o tastă Instrumente sau o variantă cu apăsare lungă. Mai jos declanșează mai ușor, mai mare previne accidentele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe ver je een toets omhoog moet slepen voordat de sleepactie wordt geactiveerd: de taalwisselaar, een Tools-toets of een variant van lang indrukken. Lager triggert gemakkelijker, hoger voorkomt ongelukken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要將按鍵向上拖動多遠，其上拖動作才會觸發：語言切換、工具鍵或長按變體。距離越短越容易觸發，越長越不易誤觸。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak daleko należy przeciągnąć klawisz, zanim zostanie uruchomiona akcja przeciągania: przełącznik języka, klawisz Narzędzia lub wariant z długim naciśnięciem. Niższe wyzwalacze łatwiej, wyższe zapobiegają wypadkom."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як далеко вгору перетягнути клавішу, перш ніж спрацює її перетягування: перемикач мови, клавіша інструментів або варіант тривалого натискання. Нижче спрацьовує легше, а вище запобігає нещасним випадкам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarı sürükleme eylemi gerçekleşmeden önce bir tuşun ne kadar sürükleneceği: dil değiştirici, Araçlar tuşu veya uzun basılan bir türev. Daha düşük tetiklemeler daha kolay olur, daha yüksek tetiklemeler kazaları önler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak daleko přetáhnout klávesu, než se spustí její přetažení: přepínač jazyka, klávesa Tools nebo varianta dlouhého stisknutí. Nižší spouští snadněji, vyšší předchází nehodám."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako ďaleko potiahnuť kláves, kým sa spustí akcia potiahnutia: prepínač jazyka, kláves Nástroje alebo variant dlhého stlačenia. Nižšie sa spúšťa ľahšie, vyššie predchádza nehodám."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο μακριά μπορείτε να σύρετε ένα κλειδί πριν ενεργοποιηθεί η δράση σύρεώς του: η εναλλαγή γλώσσας, ένα πλήκτρο Εργαλεία ή μια παραλλαγή παρατεταμένου πάτημας. Χαμηλότερα ερεθίσματα πιο εύκολα, υψηλότερα αποτρέπει τα ατυχήματα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur långt upp för att dra en tangent innan dess drag-upp-åtgärd aktiveras: språkväxeln, en Verktygstangent eller en långtrycksvariant. Lägre avtryckare lättare, högre förhindrar olyckor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor langt op skal der trækkes en tast, før dens træk-op-handling udløses: sprogskifteren, en værktøjstast eller en variant med et langt tryk. Lavere udløsere nemmere, højere forhindrer ulykker."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor langt opp for å dra en tast før dens trekk-opp-handling utløses: språkbytteren, en verktøytast eller en langtrykksvariant. Lavere trigger lettere, høyere forhindrer ulykker."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka pitkälle näppäintä vedetään, ennen kuin se käynnistyy: kielen vaihtaja, työkalunäppäin tai pitkä painallus. Alempi laukaisee helpommin, korkeampi ehkäisee onnettomuuksia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa jauh tombol harus ditarik sebelum tindakan tarik ke atas diaktifkan: pengalih bahasa, tombol Alat, atau varian tekan lama. Pemicu yang lebih rendah lebih mudah, yang lebih tinggi mencegah kecelakaan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng cách kéo một phím trước khi hành động kéo lên của nó kích hoạt: trình chuyển đổi ngôn ngữ, phím Công cụ hoặc một biến thể nhấn và giữ. Kích hoạt thấp hơn dễ dàng hơn, cao hơn ngăn ngừa tai nạn."
          }
        }
      }
    },
    "How far you must drag left before the first word is deleted. Lower is more sensitive.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe ver jy links moet sleep voordat die eerste woord uitgevee word. Laer is meer sensitief."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit du nach links ziehen musst, bis das erste Wort gelöscht wird. Niedriger ist empfindlicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tienes que arrastrar a la izquierda antes de borrar la primera palabra. Más bajo es más sensible."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui kaugele tuleb lohistada vasakule, enne kui esimene sõna kustutatakse. Madalam on tundlikum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'où tu dois glisser vers la gauche avant que le premier mot soit supprimé. Plus bas, plus sensible."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Milyen messze kell balra húznod, mielőtt törlődik az első szó. Az alacsonyabb érzékenyebb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto devi trascinare a sinistra prima che sparisca la prima parola. Più basso è più sensibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の単語が消えるまでに左へドラッグする距離です。低いほど反応しやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 단어가 지워지기 전까지 왼쪽으로 얼마나 끌어야 하는지예요. 낮을수록 더 민감해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejauh mana anda perlu seret ke kiri sebelum perkataan pertama dipadam. Lagi rendah lagi sensitif."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até onde tens de arrastar para a esquerda antes de a primeira palavra ser apagada. Mais baixo é mais sensível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько далеко нужно провести влево, чтобы удалилось первое слово. Меньше — чувствительнее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要往左拖多远才删掉第一个词。数值越低越灵敏。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de departe trebuie să trageți spre stânga înainte ca primul cuvânt să fie șters. Inferior este mai sensibil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe ver u naar links moet slepen voordat het eerste woord wordt verwijderd. Lager is gevoeliger."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要往左拖多遠才刪掉第一個詞。數值越低越靈敏。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak daleko należy przeciągnąć w lewo, aby pierwsze słowo zostało usunięte. Niższy jest bardziej czuły."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскільки далеко потрібно перетягнути вліво, перш ніж перше слово буде видалено. Нижня більш чутлива."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk kelime silinmeden önce ne kadar sola sürüklemeniz gerekir. Alt kısım daha hassastır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak daleko musíte táhnout doleva, než bude smazáno první slovo. Nižší je citlivější."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako ďaleko musíte potiahnuť doľava, kým sa vymaže prvé slovo. Nižšie je citlivejšie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο μακριά πρέπει να σύρετε αριστερά πριν διαγραφεί η πρώτη λέξη. Το χαμηλότερο είναι πιο ευαίσθητο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur långt du måste dra åt vänster innan det första ordet raderas. Lägre är känsligare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor langt skal du trække til venstre, før det første ord slettes. Lavere er mere følsomt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor langt du må dra til venstre før det første ordet slettes. Nedre er mer følsomt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka pitkälle sinun täytyy vetää vasemmalle ennen kuin ensimmäinen sana poistetaan. Alempi on herkempi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa jauh Anda harus menyeret ke kiri sebelum kata pertama dihapus. Lebih rendah lebih sensitif."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn phải kéo sang trái bao xa trước khi từ đầu tiên bị xóa. Thấp hơn là nhạy cảm hơn."
          }
        }
      }
    },
    "How far your finger travels to move the cursor one character. If it jumps too fast, lower this.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe ver jou vinger beweeg om die wyser een karakter te beweeg. As dit te vinnig spring, verlaag dit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit dein Finger wandert, um den Cursor um ein Zeichen zu bewegen. Springt er zu schnell, dreh das runter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto mueves el dedo para desplazar el cursor un carácter. Si salta demasiado rápido, baja este valor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui kaugele liigub su sõrm, et liigutada kursorit ühe märgi võrra. Kui ta hüppab liiga kiiresti, siis madalda seda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La distance que ton doigt parcourt pour bouger le curseur d'un caractère. S'il saute trop vite, baisse ça."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyit mozdul az ujjad, hogy a kurzor egy karaktert lépjen. Ha túl gyorsan ugrik, csökkentsd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto si sposta il dito per muovere il cursore di un carattere. Se salta troppo in fretta, abbassalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルを1文字動かすのに指を動かす距離です。動きが速すぎるときは下げてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서를 한 글자 옮기려면 손가락이 얼마나 움직여야 하는지예요. 너무 빨리 건너뛰면 이 값을 낮춰보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejauh mana jari anda gerak untuk alihkan kursor satu aksara. Kalau ia melompat terlalu laju, rendahkan ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até onde o teu dedo anda para mover o cursor um caractere. Se saltar depressa demais, baixa isto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какое расстояние проходит палец, чтобы сдвинуть курсор на один символ. Если он летит слишком быстро, уменьшите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手指要滑多远，光标才移动一个字符。要是跳得太快，就把它调低。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de departe parcurge degetul pentru a muta cursorul cu un caracter. Dacă sare prea repede, coborâți-l."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe ver uw vinger beweegt om de cursor één teken te verplaatsen. Als het te snel springt, verlaag dit dan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手指要滑多遠，游標才移動一個字元。要是跳得太快，就把它調低。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak daleko przesuwa się palec, aby przesunąć kursor o jeden znak. Jeśli skacze za szybko, obniż to."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстань, на яку пройде ваш палець, щоб перемістити курсор на один символ. Якщо він стрибає занадто швидко, опустіть його."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmleci bir karakter hareket ettirmek için parmağınızın ne kadar uzağa gittiği. Çok hızlı atlıyorsa bunu düşürün."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak daleko se váš prst posune, aby se kurzor posunul o jeden znak. Pokud skáče příliš rychle, snižte ji."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako ďaleko prejde váš prst, aby ste posunuli kurzor o jeden znak. Ak skáče príliš rýchlo, znížte ho."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο μακριά ταξιδεύει το δάχτυλό σας για να μετακινήσετε τον κέρσορα έναν χαρακτήρα. Εάν πηδάει πολύ γρήγορα, χαμηλώστε το."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur långt fingret går för att flytta markören ett tecken. Om den hoppar för snabbt, sänk den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor langt din finger bevæger sig for at flytte markøren ét tegn. Hvis den hopper for hurtigt, sænk denne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor langt fingeren beveger seg for å flytte markøren ett tegn. Hvis den hopper for fort, senk denne."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka pitkälle sormesi liikkuu siirtääksesi kohdistinta yhden merkin. Jos se hyppää liian nopeasti, laske tämä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa jauh jari Anda bergerak untuk menggerakkan kursor satu karakter. Jika lompatannya terlalu cepat, turunkan ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng cách ngón tay của bạn di chuyển để di chuyển con trỏ một ký tự. Nếu nó nhảy quá nhanh, hãy hạ thấp mức này."
          }
        }
      }
    },
    "How fast the key spring settles. Lower is snappier, higher is more relaxed.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe vinnig lê die sleutelveer. Laer is vinniger, hoër is meer ontspanne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie schnell die Tastenfeder zur Ruhe kommt. Niedriger ist flotter, höher ist entspannter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con qué rapidez se asienta el resorte de la tecla. Más bajo va más ágil, más alto más relajado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui kiiresti klahvi vedru raugab. Madalam on nobedam, kõrgem on lõdvestunum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitesse à laquelle le ressort de la touche se stabilise. Plus bas, plus vif ; plus haut, plus souple."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Milyen gyorsan ül el a billentyű rugója. Az alacsonyabb pattanósabb, a magasabb lazább."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto in fretta si assesta la molla del tasto. Più basso è più scattante, più alto è più morbido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーのばねが落ち着く速さです。低いほどキビキビ、高いほどゆったりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스프링이 잦아드는 속도예요. 낮으면 착 붙고, 높으면 좀 더 느긋해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selaju mana spring kekunci mengendap. Lagi rendah lagi pantas, lagi tinggi lagi santai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A rapidez com que a mola da tecla assenta. Mais baixo é mais ágil, mais alto é mais suave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как быстро успокаивается пружина клавиши. Меньше — резче, больше — расслабленнее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键弹簧回稳有多快。数值越低越干脆，越高越舒缓。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de repede se așează arcul cheii. Mai jos este mai rapid, mai sus este mai relaxat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe snel de sleutelveer bezinkt. Lager is vlotter, hoger is meer ontspannen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵彈簧回穩有多快。數值越低越乾脆，越高越舒緩。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak szybko osiada sprężyna klucza. Niższy jest szybszy, wyższy jest bardziej zrelaksowany."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як швидко сідає ключова пружина. Нижче – різкіше, вище – спокійніше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar yayın ne kadar hızlı yerleştiği. Daha düşük daha hızlıdır, daha yüksek ise daha rahattır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak rychle se pružina klíče usadí. Nižší je svižnější, vyšší je uvolněnější."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako rýchlo sa kľúčová pružina usadí. Nižšie je svižnejšie, vyššie je uvoľnenejšie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο γρήγορα κατακάθεται η βασική άνοιξη. Το χαμηλότερο είναι πιο γρήγορο, το υψηλότερο είναι πιο χαλαρό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur snabbt nyckelfjädern sätter sig. Lägre är snabbare, högre är mer avslappnad."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor hurtigt sætter nøglefjederen sig. Lavere er snappere, højere er mere afslappet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor raskt setter nøkkelfjæren seg. Lavere er raskere, høyere er mer avslappet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka nopeasti avaimen jousi asettuu. Alempi on näppärämpi, korkeampi on rennompi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa cepat pegas kunci mengendap. Lebih rendah lebih cepat, lebih tinggi lebih santai."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lò xo chìa khóa lắng xuống nhanh như thế nào. Thấp hơn là nhanh hơn, cao hơn là thoải mái hơn."
          }
        }
      }
    },
    "How fast the space-bar spring settles. Lower is snappier.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
