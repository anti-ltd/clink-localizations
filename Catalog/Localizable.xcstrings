    "Corner radius of each key. 0 is square, higher values make rounder caps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eckenradius jeder Taste. 0 ist eckig, höhere Werte machen die Tasten runder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Radio de las esquinas de cada tecla. 0 es cuadrado, cuanto más alto, más redondas quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rayon des coins de chaque touche. 0 pour du carré, plus la valeur monte plus les touches sont arrondies."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyes billentyűk sarkának lekerekítése. A 0 szögletes, a nagyobb érték kerekebb billentyűket ad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggio degli angoli di ogni tasto. 0 è quadrato, valori più alti li rendono più arrotondati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーの角の丸みです。0だと四角、大きくするほどキャップが丸くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 키의 모서리 둥글기예요. 0은 각지고, 값이 클수록 키캡이 더 둥글어져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejari sudut setiap kekunci. 0 buat segi empat, nilai lebih tinggi buat penutup lebih bulat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Raio dos cantos de cada tecla. 0 é quadrado, valores mais altos deixam as teclas mais redondas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Радиус скругления клавиши. 0 — квадратные, чем больше, тем круглее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个按键的圆角大小。0 是方角，数值越大键帽越圆。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga klahvi nurgaraadius. 0 on kandiline, suuremad väärtused teevad katted ümaramaks."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoek radius van elke sleutel. 0 is vierkantig, hoër waardes maak ronder pette."
          }
        }
      }
    },
