        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 开着，不过 %@ 离线建议照常给你。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "AI este activat, dar sugestiile %@ offline continuă în mod normal."
          }
        },
        "nl": {
