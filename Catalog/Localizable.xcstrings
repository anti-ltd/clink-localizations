        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο μεγάλο μεγαλώνει κάθε σωματίδιο. Μεγαλύτερα σχήματα γεμίζουν περισσότερα από τα κλειδιά."
          }
        },
        "sv": {
          "stringUnit": {
