    "clinkkeys.app has the longer guides, and a way to write to us. A real person reads it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app het die langer gidse, en 'n manier om aan ons te skryf. ’n Regte mens lees dit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf clinkkeys.app stehen die ausführlichen Anleitungen, und von dort kannst du uns schreiben. Es liest ein echter Mensch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En clinkkeys.app están las guías largas y un sitio para escribirnos. Lo lee una persona de verdad."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app-il on pikemad juhendid ja võimalus meile kirjutada. Ehtsat inimest loeb seda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app rassemble les guides détaillés et un moyen de nous écrire. C'est une vraie personne qui lit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A clinkkeys.app oldalon vannak a hosszabb útmutatók, és onnan írhatsz nekünk. Egy valódi ember olvassa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su clinkkeys.app trovi le guide più lunghe e un modo per scriverci. Legge una persona vera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.appには詳しいガイドと、ご連絡いただける窓口があります。実際の担当者が読んでいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app에는 더 자세한 가이드와 문의 방법이 있습니다. 실제 담당자가 읽습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app ada panduan yang lebih panjang dan cara untuk menulis kepada kami. Orang sebenar yang membacanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em clinkkeys.app estão os guias mais longos e uma forma de nos escreveres. É lido por uma pessoa a sério."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На clinkkeys.app есть подробные руководства и способ нам написать. Читает живой человек."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app 上有更详细的指南，也能从那里写信给我们。看信的是真人。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app are ghidurile mai lungi și o modalitate de a ne scrie. O persoană reală o citește."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app heeft langere handleidingen en een manier om ons te schrijven. Een echt mens leest het."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app 上有更詳細的指南，也能從那裡寫信給我們。看信的是真人。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app zawiera dłuższe przewodniki i możliwość napisania do nas. Czyta to prawdziwa osoba."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app має докладніші посібники та спосіб написати нам. Його читає реальна людина."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app'te daha uzun kılavuzlar ve bize yazmanın bir yolu var. Gerçek bir insan okur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app má delší průvodce a způsob, jak nám napsat. Čte to skutečný člověk."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app má dlhších sprievodcov a spôsob, ako nám napísať. Číta to skutočný človek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το clinkkeys.app έχει τους μεγαλύτερους οδηγούς και έναν τρόπο να μας γράφει. Το διαβάζει πραγματικός άνθρωπος."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app har de längre guiderna och ett sätt att skriva till oss. En riktig person läser den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app har de længere guider og en måde at skrive til os på. En rigtig person læser den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app har lengre guider, og en måte å skrive til oss på. En ekte person leser den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.appilla on pidemmät oppaat ja tapa kirjoittaa meille. Todellinen ihminen lukee sen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app memiliki panduan yang lebih panjang, dan cara untuk menulis kepada kami. Orang sungguhan membacanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "clinkkeys.app có hướng dẫn dài hơn và cách viết thư cho chúng tôi. Một người thực sự đọc nó."
          }
        }
      }
