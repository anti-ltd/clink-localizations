    "Adds the punctuation and capitals speech recognition misses. Your words are left exactly as you said them.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg die leestekens en hoofletters spraakherkenning mis. Jou woorde word presies gelaat soos jy dit gesê het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Zeichensetzung und Großschreibung hinzu, die die Spracherkennung übersieht. Ihre Wörter bleiben genau so, wie Sie sie gesagt haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la puntuación y mayúsculas que el reconocimiento de voz no capta. Tus palabras quedan exactamente como las dijiste."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisab kirjavahemärgid ja suurtähed, mida kõnetuvastus vahele jätab. Sinu sõnad jäävad täpselt nii, nagu sa ütlesid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute la ponctuation et les majuscules que la reconnaissance vocale oublie. Vos mots restent exactement comme vous les avez dits."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiegészíti az írásjeleket és nagybetűket, amiket a beszédfelismerés kihagy. A szavak pontosan úgy maradnak, ahogy mondta őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge la punteggiatura e le maiuscole che il riconoscimento vocale perde. Le tue parole rimangono esattamente come le hai dette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声認識が見逃す句読点や大文字を補います。話した言葉はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 인식이 놓친 구두점과 대문자를 추가합니다. 말한 단어는 그대로 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambah tanda baca dan huruf besar yang terlepas oleh pengecaman pertuturan. Perkataan anda kekal seperti yang anda ucapkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona a pontuação e maiúsculas que o reconhecimento de fala não capta. As suas palavras ficam exatamente como as disse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет знаки препинания и заглавные буквы, которые распознавание речи пропускает. Ваши слова остаются ровно такими, как вы их сказали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加语音识别遗漏的标点和大小写。你所说的话保持原样。"
          }
        }
      }
    },
