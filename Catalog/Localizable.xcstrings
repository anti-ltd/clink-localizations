    "Shortcuts expand instantly, even with autocorrect off": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortpaaie brei onmiddellik uit, selfs met outokorreksie af"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kürzel werden sofort erweitert, auch bei ausgeschalteter Autokorrektur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos se expanden al instante, incluso con la autocorrección apagada"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otseteed laienevad koheselt, isegi kui automaatparandus on väljas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis se développent instantanément, même avec la correction auto désactivée"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rövidítések azonnal kibővülnek, még kikapcsolt automatikus javítással is"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scorciatoie si espandono all'istante, anche con la correzione automatica disattivata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動修正がオフでも、ショートカットはすぐに展開されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 수정을 꺼도 단축어는 바로 확장돼요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan berkembang serta-merta, walaupun autobetul dimatikan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos expandem-se logo, mesmo com a correção automática desligada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сокращения разворачиваются мгновенно, даже при выключенной автокоррекции"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷替换即时展开，就算关了自动更正也一样"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comenzile rapide se extind instantaneu, chiar și cu corectarea automată dezactivată"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snelkoppelingen worden onmiddellijk uitgebreid, zelfs als autocorrectie is uitgeschakeld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷替換即時展開，就算關了自動更正也一樣"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skróty rozwijają się natychmiast, nawet przy wyłączonej autokorekcie"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ярлики миттєво розширюються, навіть якщо автовиправлення вимкнено"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik düzeltme kapalı olsa bile kısayollar anında genişler"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zástupci se okamžitě rozbalí, i když jsou automatické opravy vypnuté"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skratky sa rozšíria okamžite, dokonca aj keď sú automatické opravy vypnuté"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συντομεύσεις επεκτείνονται αμέσως, ακόμη και με απενεργοποιημένη την αυτόματη διόρθωση"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genvägar expanderar omedelbart, även med autokorrigering av"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genveje udvides øjeblikkeligt, selv med autokorrektur slået fra"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snarveier utvides umiddelbart, selv med autokorrektur av"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikakuvakkeet laajenevat välittömästi, vaikka automaattinen korjaus olisi pois päältä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan diperluas secara instan, bahkan dengan koreksi otomatis nonaktif"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím tắt mở rộng ngay lập tức, ngay cả khi tắt tính năng tự động sửa lỗi"
          }
        }
      }
    },
