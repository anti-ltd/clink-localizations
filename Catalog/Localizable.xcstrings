    "Go to Support and tell us what's happening.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh auf „Support“ und schreib uns, was los ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a Soporte y cuéntanos qué pasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Va dans Support et raconte-nous ce qui se passe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Menj a Támogatás oldalra, és írd meg, mi történik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai su Assistenza e raccontaci cosa succede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「サポート」から、状況を教えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원에서 무슨 일이 있었는지 알려 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergi ke Sokongan dan beritahu kami apa yang berlaku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai a Apoio e conta-nos o que se passa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зайдите в «Поддержку» и расскажите, что происходит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进“支持”，把情况告诉我们。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mine lehele Tugi ja räägi meile, mis lahti on."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gaan na Ondersteuning en vertel ons wat gebeur."
          }
        }
      }
