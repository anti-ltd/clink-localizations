    "Shows your recent emoji in a row. Pick how many.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wys jou onlangse emosiekone in 'n ry. Kies hoeveel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt deine zuletzt genutzten Emojis in einer Reihe. Wähle, wie viele."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tus emojis recientes en una fila. Elige cuántos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvab sinu viimased emojid reas. Vali, mitu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
