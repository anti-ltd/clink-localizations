        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensioni, forma e aree tattili dei tasti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの大きさ、形、タップ範囲"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 크기, 모양, 터치 영역"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saiz, bentuk dan kotak sentuh kekunci"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho, forma e áreas táteis das teclas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер и форма клавиш, зоны нажатия"
          }
        },
        "zh-Hans": {
          "stringUnit": {
