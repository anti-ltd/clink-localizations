    "Letters your arrangement has no room for. Separate them with spaces. These stay available even when accent popups are switched off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buchstaben, für die auf deiner Anordnung kein Platz ist. Mit Leerzeichen trennen. Sie bleiben erreichbar, auch wenn Akzent-Popups aus sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras para las que no hay sitio en tu disposición. Sepáralas con espacios. Siguen disponibles aunque desactives los desplegables de acentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lettres qui ne tiennent pas sur ta disposition. Sépare-les par des espaces. Elles restent accessibles même si les fenêtres d’accents sont désactivées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Betűk, amiknek nincs helye az elrendezéseden. Szóközzel válaszd el őket. Akkor is elérhetők maradnak, ha az ékezetes felugrók ki vannak kapcsolva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lettere che non trovano posto nella tua disposizione. Separale con degli spazi. Restano disponibili anche con i popup degli accenti disattivati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配列に入りきらない文字です。スペースで区切ってください。アクセントのポップアップをオフにしていても使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자판에 자리가 없는 글자들입니다. 공백으로 구분하세요. 악센트 팝업을 꺼 두어도 계속 쓸 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Huruf yang tiada ruang pada susunan anda. Pisahkan dengan ruang. Ia kekal boleh dicapai walaupun pop-up aksen dimatikan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras que não cabem na tua disposição. Separa-as com espaços. Continuam disponíveis mesmo com os pop-ups de acentos desligados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буквы, которым не хватило места в вашей раскладке. Разделяйте их пробелами. Они остаются доступны, даже когда всплывающие акценты выключены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键位排不下的字母。用空格分隔。即使关掉重音弹窗，它们也照样能用。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähed, millele sinu paigutusel ruumi pole. Eralda need tühikutega. Need jäävad kättesaadavaks isegi siis, kui aksendihüpikud on välja lülitatud."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Briewe waarvoor u reëling nie plek het nie. Skei hulle met spasies. Hierdie bly beskikbaar selfs wanneer aksentopspringers afgeskakel is."
          }
        }
      }
    },
