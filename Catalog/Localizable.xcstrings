    "Nothing drifts behind the keys until Animate is on.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niks dryf agter die sleutels totdat Animate aan is nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinter den Tasten bewegt sich nichts, solange „Animieren“ aus ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada se mueve detrás de las teclas mientras «Animar» esté desactivado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvide taga ei triibi midagi, enne kui Animeeri on sees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne bouge derrière les touches tant qu’« Animer » est désactivé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amíg az Animálás ki van kapcsolva, semmi sem mozog a billentyűk mögött."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dietro i tasti non si muove nulla finché «Anima» è disattivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アニメーション」をオンにするまで、キーの後ろでは何も動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘애니메이션’을 켜기 전까지는 키 뒤에서 아무것도 움직이지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa bergerak di belakang kekunci selagi Animasi dimatikan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada se move por trás das teclas enquanto a opção Animar estiver desligada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока «Анимация» выключена, за клавишами ничего не движется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不开启「动画」，按键后方就什么都不会动。"
          }
        }
      }
    },
    "Nothing drifts behind the keys until this is on.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niks dryf agter die sleutels totdat dit aan is nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinter den Tasten bewegt sich nichts, solange das aus ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada se mueve detrás de las teclas hasta que actives esto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvide taga ei triibi midagi, enne kuni see on sees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne bouge derrière les touches tant que ce n'est pas activé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amíg ez ki van kapcsolva, semmi sem mozog a billentyűk mögött."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dietro i tasti non si muove nulla finché non attivi questa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これをオンにするまで、キーの後ろでは何も動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이걸 켜기 전까지는 키 뒤에서 아무것도 움직이지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa bergerak di belakang kekunci selagi ini dimatikan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada se move por trás das teclas enquanto isto estiver desligado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока это выключено, за клавишами ничего не движется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不开这个，按键后方就什么都不会动。"
          }
        }
      }
    },
    "Nothing else changes. Your layout, tools, stickers and pets stay as they are.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Niks anders verander nie. Jou uitleg, gereedskap, plakkers en troeteldiere bly soos hulle is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonst ändert sich nichts. Layout, Werkzeuge, Sticker und Haustiere bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambia nada más. Tu disposición, herramientas, pegatinas y mascotas se mantienen igual."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muud ei muutu. Paigutus, tööriistad, kleepsud ja lemmikloomad jäävad samaks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d'autre ne change. Votre disposition, vos outils, vos autocollants et vos compagnons restent tels quels."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi más nem változik. Az elrendezés, az eszközök, a matricák és a kisállatok érintetlenek maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non cambia nient'altro. Layout, strumenti, adesivi e animaletti restano come sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかは変わりません。レイアウト、ツール、ステッカー、ペットはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 외에는 바뀌지 않습니다. 레이아웃, 도구, 스티커, 펫은 그대로 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa lagi berubah. Susun atur, alat, pelekat dan peliharaan anda kekal sama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada mais muda. Seu esquema, ferramentas, adesivos e mascotes ficam como estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше ничего не меняется. Раскладка, инструменты, стикеры и питомцы останутся прежними."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他内容不变。你的布局、工具、贴纸和宠物都保持原样。"
          }
        }
      }
    },
    "Nothing here is uploaded, and turning it off deletes what it collected.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niks hier word opgelaai nie, en as jy dit afskakel, word dit wat dit ingesamel is, uitgevee."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts davon wird hochgeladen, und wenn du es ausschaltest, wird das Gesammelte gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de esto se sube a ningún sitio, y al desactivarlo se borra lo recogido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Midagi siit ei laadita üles ja selle väljalülitamine kustutab kogutu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est envoyé nulle part, et le désactiver supprime ce qui a été collecté."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi nem töltődik fel sehová, és ha kikapcsolod, az összegyűjtött adat törlődik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente di tutto questo viene caricato da qualche parte, e disattivarlo cancella ciò che è stato raccolto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらがどこかに送信されることはなく、オフにすると集めたデータは削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 내용은 어디에도 업로드되지 않으며, 끄면 모아 둔 데이터도 삭제됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa di sini dimuat naik, dan mematikannya akan memadam data yang dikumpul."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada disto é enviado para lado nenhum, e desligá-lo apaga o que foi recolhido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсюда ничего не загружается, а при выключении собранное удаляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些都不会上传，关掉它还会把已收集的数据一并删除。"
          }
        }
      }
    },
    "Nothing here yet. Pick emoji below and they land in this set, in the order you tap them.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog niks hier nie. Kies emoji hieronder en hulle land in hierdie stel, in die volgorde waarin jy daarop tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts drin. Wähl unten Emojis aus – sie landen in der Reihenfolge im Set, in der du sie antippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí todavía no hay nada. Elige emoji abajo y se van al conjunto en el orden en que los toques."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Siin pole veel midagi. Vali all emojisid ja need maanduvad sellesse komplekti selles järjekorras, nagu neid puudutad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l'instant. Choisis des emoji en dessous : ils rejoignent le set dans l'ordre où tu les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt még nincs semmi. Válassz lentről emojikat – abban a sorrendben kerülnek a készletbe, ahogy megérinted őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non c'è ancora niente. Scegli le emoji qui sotto: entrano nel set nell'ordine in cui le tocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ空です。下から絵文字を選ぶと、タップした順にこのセットへ入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 비어 있어요. 아래에서 이모지를 고르면 누른 순서대로 이 세트에 들어가요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada apa-apa. Pilih emoji di bawah dan ia masuk ke set ini mengikut susunan anda ketik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nada aqui. Escolhe emoji abaixo e entram no conjunto pela ordem em que lhes tocas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока пусто. Выбирайте эмодзи ниже — они попадут в этот набор в том порядке, в котором вы их нажмёте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里还是空的。在下面挑表情，按你点的顺序加进这个合集。"
          }
        }
      }
    },
    "Nothing in that backup could be restored.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
