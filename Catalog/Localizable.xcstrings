    "Read and replace clipboard contents.": {
      "comment": "Android-only copy for the companion app (batch B10: Plugins). The plugin access sheet's Clipboard switch, without iOS's Full Access (Android has no such switch). Translations drafted for the Android port; native-speaker review required before release. Add to clink-index.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees en vervang knipbordinhoud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Číst a nahrazovat obsah schránky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læs og erstat indholdet af udklipsholderen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest und ersetzt den Inhalt der Zwischenablage."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανάγνωση και αντικατάσταση του περιεχομένου του προχείρου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee y reemplaza el contenido del portapapeles."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loeb ja asendab lõikelaua sisu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukee ja korvaa leikepöydän sisällön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit et remplace le contenu du presse-papiers."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágólap tartalmának olvasása és cseréje."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca dan mengganti isi papan klip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge e sostituisce il contenuto degli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードの内容を読み取り、置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 내용을 읽고 바꿉니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca dan gantikan kandungan papan klip."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Les og erstatt innholdet i utklippstavlen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klembordinhoud lezen en vervangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczyt i zastępowanie zawartości schowka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê e substitui o conteúdo da área de transferência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citește și înlocuiește conținutul clipboardului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтение и замена содержимого буфера обмена."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čítať a nahrádzať obsah schránky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läs och ersätt innehållet i urklipp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pano içeriğini okur ve değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читання й заміна вмісту буфера обміну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc và thay thế nội dung bảng nhớ tạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取和替换剪贴板内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取並取代剪貼簿內容。"
          }
        }
      }
    },
    "Passes the clipboard text in.": {
      "comment": "Android-only copy for the companion app (batch B10: Plugins). The action editor's Clipboard input, without iOS's Full Access (Android has no such switch). Translations drafted for the Android port; native-speaker review required before release. Add to clink-index.",
