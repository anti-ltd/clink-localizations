    "Total width of the bar. The other keys in the row give way.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Totale breedte van die staaf. Die ander sleutels in die ry gee pad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamtbreite des Balkens. Die anderen Tasten in der Zeile weichen aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancho total de la barra. Las otras teclas de la fila ceden espacio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Riba kogulaius. Ülejäänud klahvid reas teevad ruumi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur totale de la barre. Les autres touches de la rangée cèdent la place."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sáv teljes szélessége. A sor többi billentyűje helyet ad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Larghezza totale della barra. Gli altri tasti della riga fanno spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バー全体の幅です。同じ行のほかのキーが場所を譲ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바 전체 너비입니다. 같은 줄의 다른 키가 자리를 내줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar keseluruhan bar. Kekunci lain dalam baris memberi laluan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Largura total da barra. As outras teclas da fila cedem espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общая ширина полосы. Остальные клавиши в ряду уступают место."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整条栏的总宽度。同一行的其他按键会让出空间。"
          }
        }
      }
    },
    "Total width of the strip. The other keys in the row give way.": {
