    "Most of that is animation rather than speed, and you can take it out.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meeste daarvan is animasie eerder as spoed, en jy kan dit uithaal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das meiste davon ist Animation, nicht Tempo, und du kannst sie herausnehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayor parte de eso es animación, no lentitud, y se puede quitar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Enamik sellest on animatsioon, mitte kiirus, ja sa võid selle eemaldada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'essentiel, c'est de l'animation, pas de la lenteur, et tu peux la retirer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek java része animáció, nem lassúság, és ki lehet venni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In gran parte è animazione, non lentezza, e la puoi togliere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その多くは速度ではなくアニメーションによるもので、取り除けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분은 속도가 아니라 애니메이션 때문이고, 없앨 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebanyakannya animasi dan bukan kelajuan, dan anda boleh membuangnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A maior parte disso é animação, não lentidão, e podes tirá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почти всё это — анимация, а не скорость, и её можно убрать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这多半是动画造成的，不是真的慢，可以去掉。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cea mai mare parte este mai degrabă animație decât viteză și o poți elimina."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het meeste daarvan is animatie in plaats van snelheid, en je kunt het eruit halen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這多半是動畫造成的，不是真的慢，可以去掉。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Większość z nich to animacja, a nie prędkość, i możesz to wyeliminować."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Здебільшого це анімація, а не швидкість, і ви можете її вилучити."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunların çoğu hızdan ziyade animasyondur ve bunu kaldırabilirsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Většina z toho je animace spíše než rychlost, a můžete ji odstranit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Väčšinu z toho tvorí animácia, nie rýchlosť, a môžete ju odstrániť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα περισσότερα από αυτά είναι κινούμενα σχέδια και όχι ταχύτητα, και μπορείτε να το αφαιρέσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det mesta är animation snarare än hastighet, och du kan ta bort det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det meste af det er animation snarere end hastighed, og du kan tage det ud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det meste av det er animasjon i stedet for hastighet, og du kan ta det ut."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suurin osa siitä on animaatiota nopeuden sijaan, ja voit ottaa sen pois."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagian besar adalah animasi daripada kecepatan, dan Anda dapat menghilangkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hầu hết đó là hoạt ảnh chứ không phải tốc độ và bạn có thể lấy nó ra."
          }
        }
      }
    },
