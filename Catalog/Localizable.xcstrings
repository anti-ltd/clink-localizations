    "Add an AI panel behind the keyboard's panel button. Proofread, rewrite, change tone, shorten, reply and more.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg 'n AI-paneel agter die sleutelbord se paneelknoppie. Proeflees, herskryf, verander toon, verkort, antwoord en meer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge hinter dem Panel-Button der Tastatur ein KI-Panel hinzu. Korrekturlesen, umschreiben, Ton ändern, kürzen, antworten und mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un panel de IA detrás del botón de panel del teclado. Corrige, reescribe, cambia el tono, acorta, responde y más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa klaviatuuri paneelinupu taha TI-paneel. Loe üle, kirjuta ümber, muuda tooni, lühenda, vasta ja palju muud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un panneau IA derrière le bouton de panneau du clavier. Relis, réécris, change le ton, raccourcis, réponds et plus encore."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá egy AI-panelt a billentyűzet panel gombja mögé. Helyesírás-ellenőrzés, átírás, hangnemváltás, rövidítés, válaszírás és még sok más."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un pannello IA dietro il pulsante pannelli della tastiera. Correggi, riscrivi, cambia tono, accorcia, rispondi e altro ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードのパネルボタンの奥に AI パネルを足します。校正、書き直し、トーン変更、短縮、返信などができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드의 패널 버튼 뒤에 AI 패널을 넣어줘요. 교정, 다시 쓰기, 어조 바꾸기, 줄이기, 답장 등을 할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah panel AI di sebalik butang panel papan kekunci. Semak ejaan, tulis semula, ubah nada, pendekkan, balas dan banyak lagi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um painel de IA atrás do botão de painel do teclado. Revê, reescreve, muda o tom, encurta, responde e mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить панель ИИ за кнопкой панелей на клавиатуре. Проверка, переписывание, смена тона, сокращение, ответ и не только."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘面板按钮后面加一个 AI 面板。校对、改写、换语气、缩短、回复等等。"
          }
        }
      }
    },
