    "Feel one tick when holding space enters cursor mode.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siente una vibración al mantener pulsado el espacio y entrar en modo cursor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ressentez une vibration lorsque maintenir l’espace active le mode curseur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spüre einen Impuls, wenn Gedrückthalten der Leertaste den Cursormodus aktiviert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senti un impulso quando tenendo premuta la barra spaziatrice si attiva la modalità cursore."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sente um toque háptico quando manter a barra de espaço ativa o modo de cursor."
          }
        },
