    "Trail thickness at the start of the glide, as a multiple of the base thickness. Set below End width for a tapering tail.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spurdicke am Anfang der Bewegung, als Vielfaches der Grunddicke. Setz sie unter die Endbreite für einen spitz zulaufenden Schweif."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grosor del trazo al principio del deslizamiento, como múltiplo del grosor base. Ponlo por debajo del Ancho final para una cola que se estrecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épaisseur de la trace au début du glissé, en multiple de l'épaisseur de base. Mets-la sous Largeur de fin pour une queue qui s'affine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyom vastagsága a húzás elején, az alapvastagság többszöröseként. Állítsd a Végszélesség alá egy elkeskenyedő farokért."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spessore della scia all'inizio dello scorrimento, come multiplo dello spessore di base. Impostalo sotto la Larghezza finale per una coda che si assottiglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グライド開始時の軌跡の太さで、基本の太さに対する倍率です。終端の幅より小さくすると尾が細くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "궤적이 시작될 때의 굵기예요, 기본 굵기의 배수로요. 끝 너비보다 작게 하면 꼬리가 가늘어져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketebalan jejak pada permulaan luncuran, sebagai gandaan ketebalan asas. Tetapkan di bawah Lebar hujung untuk ekor yang meruncing."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Espessura do rasto no início do deslize, como múltiplo da espessura base. Define abaixo da Largura final para uma cauda afunilada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Толщина следа в начале движения, кратно базовой толщине. Задайте меньше «Ширины в конце», чтобы хвост сужался."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动起点处的轨迹粗细，是基础粗细的倍数。设得比末端宽度小，就有一条渐细的尾巴。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jälje paksus libisemise algul, baaspaksuse kordsena. Määra lõpulaiusest väiksemaks aheneva saba jaoks."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Roetdikte aan die begin van die gly, as 'n veelvoud van die basisdikte. Stel onder Eindwydte vir 'n tapse stert."
          }
        }
      }
    },
    "Trail thickness at your finger, as a multiple of the base thickness.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spurdicke an deinem Finger, als Vielfaches der Grunddicke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grosor del trazo en tu dedo, como múltiplo del grosor base."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épaisseur de la trace au niveau de ton doigt, en multiple de l'épaisseur de base."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyom vastagsága az ujjadnál, az alapvastagság többszöröseként."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spessore della scia in corrispondenza del dito, come multiplo dello spessore di base."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指のところの軌跡の太さで、基本の太さに対する倍率です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손가락 위치의 궤적 굵기예요, 기본 굵기의 배수로요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketebalan jejak pada jari anda, sebagai gandaan ketebalan asas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Espessura do rasto junto ao teu dedo, como múltiplo da espessura base."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Толщина следа у пальца, кратно базовой толщине."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手指处的轨迹粗细，是基础粗细的倍数。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jälje paksus sinu sõrmel, baaspaksuse kordsena."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spoordikte by jou vinger, as 'n veelvoud van die basisdikte."
          }
        }
      }
    },
