            "value": "Ia dua suis pada halaman yang sama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "São dois interruptores na mesma página."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
