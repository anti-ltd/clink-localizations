          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhi leikepöytä tai muistilehtiö kunkin paneelin asetuksista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus clipboard atau notepad dari pengaturan masing-masing panel."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa clipboard hoặc notepad khỏi cài đặt của mỗi bảng."
          }
        }
      }
    },
    "With one tool enabled, opening Tools jumps straight into it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een instrument geaktiveer, spring die opening van Tools reguit daarin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist nur ein Tool aktiviert, öffnet „Tools“ direkt dieses Tool."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una sola herramienta activada, abrir Herramientas va directo a ella."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühe tööriistaga sisse lülitatuna hüppab Tööriistade avamine otse sellesse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un seul outil activé, ouvrir Outils y accède directement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha csak egy eszköz van bekapcsolva, az Eszközök megnyitása egyenesen abba ugrik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un solo strumento attivo, aprire Strumenti porta dritto lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なツールが1つだけの場合、ツールを開くとそのツールに直接進みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구가 하나만 켜져 있으면 도구를 열었을 때 바로 그 도구로 이동합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika hanya satu alat diaktifkan, membuka Alat terus masuk ke situ."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com apenas uma ferramenta ativada, abrir Ferramentas vai direto a ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включён только один инструмент, «Инструменты» сразу открываются на нём."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只启用一个工具时，打开\"工具\"会直接进入该工具。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu un instrument activat, deschiderea Instrumentelor sare direct în el."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als één tool is ingeschakeld, springt het openen van Tools er meteen in."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只啟用一個工具時，開啟\"工具\"會直接進入該工具。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po włączeniu jednego narzędzia otwarcie Narzędzia powoduje przejście bezpośrednio do niego."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ввімкнути один інструмент, відкривши Інструменти, ви одразу перейдете до нього."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir araç etkinleştirildiğinde, Araçlar'ın açılması doğrudan bu aracın içine atlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je povolen jeden nástroj, otevření Nástroje skočí přímo do něj."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď je povolený jeden nástroj, otvorenie Nástroje preskočí priamo do neho."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με ένα εργαλείο ενεργοποιημένο, το άνοιγμα των Εργαλείων μεταβαίνει κατευθείαν σε αυτό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När ett verktyg är aktiverat hoppar öppningsverktyg direkt in i det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når ét værktøj er aktiveret, springer åbning af Værktøjer direkte ind i det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med ett verktøy aktivert, hopper åpning av Verktøy rett inn i det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun yksi työkalu on käytössä, työkalujen avaaminen hyppää suoraan siihen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan satu alat diaktifkan, membuka Alat langsung melompat ke dalamnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi một công cụ được bật, việc mở Công cụ sẽ chuyển thẳng vào công cụ đó."
          }
        }
      }
    },
    "With shift on, it just uppercases.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Met shift aan, is dit net hoofletters."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei aktivem Umschalt wird nur großgeschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Mayús activado, solo pasa a mayúsculas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõstuklahviga kirjutab ta lihtsalt suureks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Maj activé, la touche passe juste en majuscule."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktív Shift mellett csak nagybetűs lesz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con shift attivo, passa solo in maiuscolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフトがオンのときは大文字になるだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시프트가 켜져 있으면 그냥 대문자가 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semasa shift aktif, huruf hanya jadi besar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o shift ativo, apenas passa a maiúsculas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При включённом Shift это просто становится заглавным."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 开启时只会变成大写。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu shift activat, sunt doar litere mari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als shift is ingeschakeld, zijn het alleen maar hoofdletters."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 開啟時只會變成大寫。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy włączonym Shift, są tylko wielkie litery."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо Shift увімкнено, це лише верхній регістр."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift açıkken sadece büyük harf kullanılır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Se zapnutým Shiftem se pouze velká písmena."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "So zapnutým shiftom sa píšu len veľké písmená."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με ενεργοποιημένο το shift, έχει μόνο κεφαλαία."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med shift på, det bara versaler."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med shift på, er der kun store bogstaver."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med shift på, er det bare store bokstaver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihteen ollessa päällä se vain isoja kirjaimia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan shift aktif, itu hanya huruf besar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật shift, nó chỉ viết hoa."
          }
        }
      }
    },
