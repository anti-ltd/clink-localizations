    "Plugins run as you type and can change what the keyboard shows. Only allow repositories you trust.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins laufen, während du tippst, und können ändern, was die Tastatur anzeigt. Erlaube nur Repositorys, denen du vertraust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los plugins se ejecutan mientras escribes y pueden cambiar lo que muestra el teclado. Permite solo repositorios en los que confíes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pistikprogrammid töötavad tippimise ajal ja võivad muuta seda, mida klaviatuur näitab. Luba ainult hoidlaid, mida usaldad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plugins s’exécutent pendant que tu tapes et peuvent modifier l’affichage du clavier. N’autorise que les dépôts auxquels tu fais confiance."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bővítmények gépelés közben futnak, és megváltoztathatják, amit a billentyűzet mutat. Csak megbízható tárolókat engedélyezz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I plugin girano mentre scrivi e possono cambiare ciò che la tastiera mostra. Consenti solo i repository di cui ti fidi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインは入力中に動作し、キーボードの表示を変えられます。信頼できるリポジトリだけを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인은 입력하는 동안 실행되며 키보드에 보이는 내용을 바꿀 수 있습니다. 신뢰하는 저장소만 허용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugin berjalan semasa anda menaip dan boleh mengubah apa yang dipaparkan papan kekunci. Benarkan hanya repositori yang anda percayai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os plugins correm enquanto escreve e podem mudar o que o teclado mostra. Permita apenas repositórios em que confia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плагины работают во время набора и могут менять то, что показывает клавиатура. Разрешайте только репозитории, которым доверяете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插件在你输入时运行，还能改变键盘显示的内容。只允许你信任的仓库。"
          }
        }
      }
    },
