            "state": "translated",
            "value": "A betűtípusfájl túl nagy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォントファイルが大きすぎます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字体文件过大"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서체 파일이 너무 큽니다"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Fondifail on liiga suur"
          }
        }
      }
    },
    "The full hue wheel, ignoring the theme's colors.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die volkleurwiel, ignoreer die tema se kleure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ganze Farbkreis, unabhängig von den Farben des Themes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el círculo de color, sin tener en cuenta los colores del tema."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Terve värviratas, teema värve eirates."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La roue des couleurs complète, sans tenir compte des couleurs du thème."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes színkör, a téma színeit figyelmen kívül hagyva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'intera ruota dei colori, ignorando i colori del tema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマの色に関係なく、色相環をすべて使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마 색과 무관하게 전체 색상환을 사용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Roda warna penuh, tanpa mengira warna tema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O círculo de cores completo, ignorando as cores do tema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный цветовой круг, игнорируя цвета темы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用完整色环，不参考主题配色。"
          }
        }
      }
    },
