    "Add two or three takes of the same click. Clink rotates them as you type so repeats don't sound identical.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg twee of drie take van dieselfde klik by. Klink draai hulle terwyl jy tik sodat herhalings nie identies klink nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm zwei, drei Varianten desselben Klicks auf – Clink wechselt beim Tippen zwischen ihnen, damit Wiederholungen nicht gleich klingen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade dos o tres tomas del mismo clic: Clink las va alternando mientras escribes, para que las repeticiones no suenen iguales."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa kaks või kolm võtet sama klõpsu jaoks. Clink vahetab neid tipimise ajal, nii et kordused ei kõla ühtmoodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute deux ou trois prises du même clic — Clink les alterne pendant que tu tapes, pour que les répétitions ne sonnent pas pareil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegyél fel két-három változatot ugyanabból a kattanásból – a Clink gépelés közben váltogatja őket, így az ismétlődések nem hangzanak egyformán."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi due o tre versioni dello stesso clic — Clink le alterna mentre scrivi, così le ripetizioni non suonano identiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じクリック音を 2〜3 通り入れておくと、Clink がタイプ中に切り替えて鳴らすので、連打しても同じ音の繰り返しになりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 클릭 소리를 두세 번 나눠 담아 두세요. 타이핑할 때 Clink가 번갈아 재생해서 연타해도 같은 소리가 반복되지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah dua atau tiga rakaman bunyi klik yang sama — Clink akan menyilih gantikannya semasa anda menaip supaya bunyi berulang tidak kedengaran sama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona duas ou três versões do mesmo clique — o Clink vai alternando entre elas enquanto escreves, para as repetições não soarem iguais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте два-три варианта одного щелчка — Clink чередует их при печати, чтобы повторы не звучали одинаково."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一个按键声多录两三条——打字时 Clink 会轮换播放，连打时不会一直是同一个声音。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați două sau trei reprize ale aceluiași clic. Clink le rotește pe măsură ce tastați, astfel încât repetările să nu sune identice."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg twee of drie opnames van dezelfde klik toe. Clink roteert ze terwijl u typt, zodat herhalingen niet identiek klinken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一個按鍵聲多錄兩三條——打字時 Clink 會輪換播放，連打時不會一直是同一個聲音。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj dwa lub trzy ujęcia tego samego kliknięcia. Clink obraca je podczas pisania, więc powtórzenia nie brzmią identycznie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте два-три дублі одного клацання. Clink повертає їх під час введення, щоб повтори не звучали однаково."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı tıklamanın iki veya üç çekimini ekleyin. Clink siz yazarken bunları döndürür, böylece tekrarlar aynı ses çıkarmaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte dvě nebo tři záběry stejného kliknutí. Clink je při psaní otáčí, takže opakování nezní stejně."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte dve alebo tri zábery toho istého kliknutia. Clink ich pri písaní otáča, takže opakovania neznejú rovnako."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε δύο ή τρεις λήψεις από το ίδιο κλικ. Το Clink τα περιστρέφει καθώς πληκτρολογείτε, ώστε οι επαναλήψεις να μην ακούγονται πανομοιότυπες."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till två eller tre tagningar av samma klick. Clink roterar dem medan du skriver så att upprepningar inte låter identiska."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj to eller tre optagelser af samme klik. Clink roterer dem, mens du skriver, så gentagelser ikke lyder identiske."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til to eller tre bilder av samme klikk. Clink roterer dem mens du skriver, slik at repetisjoner ikke høres identiske ut."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää kaksi tai kolme otetta samasta napsautuksesta. Clink pyörittää niitä kirjoittaessasi, joten toistot eivät kuulosta identtisiltä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan dua atau tiga kali klik yang sama. Clink memutarnya saat Anda mengetik sehingga pengulangannya tidak terdengar sama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm hai hoặc ba lần nhấp chuột giống nhau. Clink xoay chúng khi bạn nhập để âm thanh lặp lại không giống nhau."
          }
        }
      }
    },
