    "Color every key of a kind at once. Painting a key on its own overrides its group.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kleur elke sleutel van 'n soort gelyktydig in. Om 'n sleutel op sy eie te verf, ignoreer sy groep."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbe alle Tasten einer Art auf einmal. Färbst du eine Taste einzeln, geht das der Gruppe vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorea todas las teclas de un tipo a la vez. Si pintas una tecla por separado, esta prevalece sobre el grupo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Värvi korraga kõik samasugused klahvid. Üksikult värvitud klahv alistab oma grupi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore toutes les touches d’un même type d’un coup. Si tu colores une touche à part, elle l’emporte sur le groupe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Színezd ki egyszerre egy fajta összes billentyűjét. Ha egy billentyűt külön színezel, az felülírja a csoportot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colora tutti i tasti di un tipo insieme. Se colori un tasto da solo, ha la meglio sul gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ種類のキーをまとめて色付けできます。個別に塗ったキーはグループより優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 종류의 키를 한 번에 칠해요. 개별로 칠한 키는 그룹보다 우선해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnakan semua kekunci sejenis sekali gus. Kekunci yang diwarnakan sendiri mengatasi kumpulannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore todas as teclas de um tipo de uma vez. Se pintares uma tecla à parte, ela prevalece sobre o grupo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Красьте сразу все клавиши одного вида. Цвет, заданный отдельной клавише, перебивает группу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次给同一类按键上色。单独涂过的按键会覆盖所属分组。"
          }
        }
      }
    },
