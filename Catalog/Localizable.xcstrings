    "Changes lists everything you've moved away from its default.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Änderungen“ listet alles auf, was du vom Standard weggedreht hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambios enumera todo lo que has movido de su valor por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifications liste tout ce que tu as éloigné de sa valeur d'origine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Módosítások mindent felsorol, amit elmozdítottál az alapértékétől."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiche elenca tutto quello che hai spostato dal valore predefinito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「変更」には、初期値から動かしたものがすべて並びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항에는 기본값에서 바꾼 것이 모두 나열됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan menyenaraikan semua yang anda ubah daripada nilai lalainya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterações lista tudo o que afastaste do valor de origem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Изменениях» перечислено всё, что вы сдвинули со стандартного значения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“更改”会列出所有被你从默认值改动过的项。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„Muudatused\" loetleb kõik, mille oled vaikeväärtusest eemaldanud."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veranderinge lys alles wat jy van die verstek af wegbeweeg het."
          }
        }
      }
