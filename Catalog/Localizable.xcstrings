    "Still missing? Raise Prediction strength a notch.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog steeds vermis? Verhoog voorspellingssterkte 'n kerf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer noch daneben? Dreh die Vorhersagestärke eine Stufe hoch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sigues fallando? Sube un punto la Fuerza de predicción."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Endiselt puudu? Tõsta Ennustuse tugevust ühe astme võrra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours à côté ? Monte la Force de prédiction d'un cran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még mindig mellémegy? Told feljebb egy fokkal az Előrejelzés erősségét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbagli ancora? Alza di un gradino l'Intensità della previsione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それでも外れる場合は、「予測の強さ」を一段上げてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래도 빗나가면 예측 강도를 한 단계 올려 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih tersasar? Naikkan Kekuatan ramalan satu takuk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuas a falhar? Sobe a Força da previsão um ponto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё равно не хватает? Поднимите «Силу предсказаний» на ступень."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还是按不准？把“预测强度”往上调一档。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă lipsește? Creșteți puterea predicției cu o crestătură."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog steeds vermist? Verhoog de sterkte van de voorspelling een tandje hoger."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還是按不準？把“預測強度”往上調一檔。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal brakuje? Podnieś siłę prognozowania o krok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Все ще пропав? Підвищити силу передбачення на одиницю."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hala kayıp mı? Tahmin gücünü bir kademe artırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stále chybí? Zvyšte sílu předpovědi o stupeň."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Still missing? Zvýšte silu predpovede o stupienok."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λείπει ακόμα; Αυξήστε τη δύναμη της πρόβλεψης κατά μια εγκοπή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortfarande saknas? Höj prediktionsstyrkan ett snäpp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mangler du stadig? Hæv forudsigelsesstyrken et hak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsatt savnet? Øk prediksjonsstyrken et hakk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vieläkö puuttuu? Nosta ennusteen voimakkuutta pykälän verran."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih hilang? Tingkatkan kekuatan Prediksi."
          }
        },
        "vi": {
