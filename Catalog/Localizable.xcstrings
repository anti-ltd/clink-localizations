          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Parkuje światło po pauzie i budzi je następnym naciśnięciem klawisza."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Паркує світло після паузи та вмикає його під час наступного натискання клавіші."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir duraklamanın ardından ışığı park eder ve bir sonraki tuş vuruşunuzda uyandırır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaparkuje světlo po pauze a probudí ho při dalším stisknutí klávesy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaparkuje svetlo po prestávke a prebudí ho pri ďalšom stlačení klávesu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σταθμεύει το φως μετά από μια παύση και το ξυπνά με το επόμενο πάτημα του πλήκτρου."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parkerar ljuset efter en paus och väcker det vid nästa knapptryckning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Parkerer lyset efter en pause og vækker det ved dit næste tastetryk."
          }
        },
