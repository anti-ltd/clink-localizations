          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihto- ja askelpalautinnäppäinten leveys verrattuna tavalliseen kirjainnäppäimeen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar tombol shift dan spasi mundur relatif terhadap tombol huruf standar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiều rộng của phím shift và phím xóa lùi so với phím chữ cái tiêu chuẩn."
          }
        }
      }
    },
    "Width of the space bar in key units. Narrower leaves room for keys on either side.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Breedte van die spasiebalk in sleuteleenhede. Smaller laat ruimte vir sleutels aan weerskante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite der Leertaste in Tasteneinheiten. Schmaler lässt Platz für Tasten an beiden Seiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancho de la barra espaciadora en unidades de tecla. Más estrecha deja sitio para teclas a los lados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tühikuklahvi laius klahviühikutes. Kitsam jättab mõlemale poole ruumi klahvidele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur de la barre d'espace en unités de touche. Plus étroite, ça laisse de la place pour des touches de chaque côté."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szóköz szélessége billentyűegységben. Ha keskenyebb, mindkét oldalon marad hely a billentyűknek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Larghezza della barra spaziatrice in unità di tasto. Più stretta, più spazio per i tasti ai lati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー単位で見たスペースバーの幅です。狭くすると両側にキーを置くスペースができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 바 너비를 키 개수로 나타내요. 좁게 하면 양옆에 키를 둘 자리가 생겨요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar bar ruang dalam unit kekunci. Lebih sempit beri ruang untuk kekunci di kiri kanan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Largura da barra de espaço em unidades de tecla. Mais estreita deixa espaço para teclas de cada lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ширина пробела в клавишах. Уже — остаётся место для клавиш по бокам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空格键的宽度，以键为单位。窄一点，就能给两边的键留出地方。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lățimea barei de spațiu în unități cheie. Mai îngustă lasă loc pentru chei de ambele părți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breedte van de spatiebalk in sleuteleenheden. Smaller laat aan beide kanten ruimte voor sleutels."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空格鍵的寬度，以鍵為單位。窄一點，就能給兩邊的鍵留出地方。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szerokość spacji w kluczowych jednostkach. Węższy pozostawia miejsce na klucze po obu stronach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ширина пробілу в ключових одиницях. Вужчий залишає місце для ключів з обох боків."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuş birimlerindeki boşluk çubuğunun genişliği. Daha dar, her iki tarafta da anahtarlar için yer bırakır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šířka mezerníku v klíčových jednotkách. Užší ponechává prostor pro klíče na obou stranách."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Šírka medzerníka v kľúčových jednotkách. Užšie ponecháva priestor pre kľúče na oboch stranách."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλάτος της γραμμής διαστήματος σε βασικές μονάδες. Το στενότερο αφήνει χώρο για κλειδιά και στις δύο πλευρές."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bredd på mellanslagstangenten i nyckelenheter. Smalare ger plats för nycklar på båda sidor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellemrumstastens bredde i nøgleenheder. Smallere giver plads til nøgler på begge sider."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bredde på mellomromstasten i nøkkelenheter. Smalere gir plass til nøkler på hver side."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välilyöntinäppäimen leveys avainyksiköissä. Kapeampi jättää tilaa avaimille molemmille puolille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar bilah spasi dalam satuan utama. Lebih sempit menyisakan ruang untuk kunci di kedua sisi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiều rộng của thanh dấu cách trong các đơn vị chính. Thu hẹp hơn để lại chỗ cho chìa khóa ở hai bên."
          }
        }
      }
    },
    "Width of the trail line drawn under your finger while swiping.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Breedte van die spoorlyn onder jou vinger getrek terwyl jy swiep."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite der Spurlinie, die beim Wischen unter deinem Finger gezeichnet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancho de la línea que se dibuja bajo tu dedo al deslizar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jäljejoone laius, mis su sõrme alla pühkimise ajal joonistatakse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur de la ligne de trace tracée sous ton doigt quand tu balayes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csúsztatás közben az ujjad alá húzott nyomvonal szélessége."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Larghezza della scia disegnata sotto il dito mentre scorri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプ中に指の下に出る軌跡の線の太さです。"
