          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przecinek i kropka obok spacji"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кома та крапка біля пробілу"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluk çubuğunun yanındaki virgül ve nokta"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čárka a tečka vedle mezerníku"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čiarka a bodka vedľa medzerníka"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κόμμα και τελεία δίπλα στο πλήκτρο διαστήματος"
          }
        },
        "sv": {
