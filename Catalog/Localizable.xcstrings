            "state": "translated",
            "value": "Telex"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Telex"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Telex"
