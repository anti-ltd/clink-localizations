          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda o tema automaticamente com o modo claro/escuro do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняет тему автоматически вместе со светлым и тёмным режимом системы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟着系统的浅色/深色模式自动切换主题。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comută automat tema cu modul de lumină/întuneric al sistemului."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakelt automatisch van thema met de licht/donker-modus van het systeem."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟著系統的淺色/深色模式自動切換主題。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie przełącza motyw w trybie jasny/ciemny system."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично перемикає тему з системним світлим/темним режимом."
          }
        },
        "tr": {
          "stringUnit": {
