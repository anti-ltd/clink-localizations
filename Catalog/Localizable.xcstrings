    "Compose writes fresh text using the draft as context (e.g. a reply). Insert leads.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose skryf vars teks deur die konsep as konteks te gebruik (bv. 'n antwoord). Voeg leidrade in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Verfassen“ schreibt neuen Text mit dem Entwurf als Kontext (z. B. eine Antwort). „Einfügen“ macht das."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redactar escribe texto nuevo usando el borrador como contexto (por ejemplo, una respuesta). Con Insertar lo añades."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„Koosta\" kirjutab uue teksti, kasutades mustandit kontekstina (nt. vastus). „Lisa\" on eesotsas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Composer écrit un nouveau texte en se servant du brouillon comme contexte (par ex. une réponse). Insertion en tête."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Írás friss szöveget ír, a piszkozatot kontextusként használva (pl. egy választ). A Beszúrás a fő gomb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Componi scrive un testo nuovo usando la bozza come contesto (ad es. una risposta). Di solito inserisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「作成」はドラフトを手がかりに新しい文章を書きます(例: 返信)。「挿入」が先に出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성은 초안을 참고해서 새 글을 써줘요(예: 답장). 삽입으로 이어져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose tulis teks baharu guna draf sebagai konteks (cth. balasan). Insert yang utama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compor escreve texto novo usando o rascunho como contexto (por exemplo, uma resposta). Inserir fica em primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Написать» создаёт новый текст, опираясь на черновик как на контекст (например, ответ). «Вставить» идёт первым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「撰写」会拿草稿当背景，生成一段全新的文本（比如一条回复）。对应「插入」。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose scrie text proaspăt folosind schița ca context (de exemplu, un răspuns). Introduceți cabluri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose schrijft nieuwe tekst met het concept als context (bijvoorbeeld een antwoord). Leidingen invoegen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「撰寫」會拿草稿當背景，生成一段全新的文字（比如一條回覆）。對應「插入」。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcja Compose zapisuje nowy tekst, używając wersji roboczej jako kontekstu (np. odpowiedzi). Włóż przewody."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose пише новий текст, використовуючи чернетку як контекст (наприклад, відповідь). Вставте відведення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oluştur, taslağı bağlam olarak kullanarak (örneğin bir yanıt) yeni metin yazar. Potansiyel müşterileri ekleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose zapíše nový text pomocí konceptu jako kontextu (např. odpověď). Vložte vodiče."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napísať nový text pomocou konceptu ako kontextu (napr. odpoveď). Vložte vodiče."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Compose γράφει νέο κείμενο χρησιμοποιώντας το προσχέδιο ως πλαίσιο (π.χ. μια απάντηση). Εισαγάγετε καλώδια."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose skriver ny text med utkastet som sammanhang (t.ex. ett svar). Sätt i ledningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose skriver ny tekst med udkastet som kontekst (f.eks. et svar). Indsæt ledninger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose skriver ny tekst med utkastet som kontekst (f.eks. et svar). Sett inn ledninger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose kirjoittaa uutta tekstiä käyttämällä luonnosta kontekstina (esim. vastaus). Aseta johdot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose menulis teks baru menggunakan draf sebagai konteks (misalnya balasan). Masukkan petunjuk."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose viết văn bản mới bằng cách sử dụng bản nháp làm ngữ cảnh (ví dụ: câu trả lời). Chèn khách hàng tiềm năng."
          }
        }
      }
    },
