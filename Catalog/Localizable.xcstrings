    "Hide this sticker without deleting it. Its place stays saved.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Versteek hierdie plakker sonder om dit uit te vee. Sy plek bly gestoor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blende diesen Sticker aus, ohne ihn zu löschen. Seine Position bleibt gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta esta pegatina sin borrarla: su posición se conserva."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peida see kleeps ilma seda kustutamata. Tema asukoht jääb alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquez cet autocollant sans le supprimer : sa position reste enregistrée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejtsd el ezt a matricát törlés nélkül. A helye megmarad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi questo adesivo senza eliminarlo: la sua posizione resta salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除せずにステッカーを隠します。位置は保存されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하지 않고 이 스티커를 숨깁니다. 위치는 그대로 저장됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan pelekat ini tanpa memadamkannya. Kedudukannya kekal disimpan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculte este adesivo sem excluí-lo: a posição dele permanece salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть стикер, не удаляя его. Его позиция сохранится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏此贴纸而不删除它，其位置会保留。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascundeți acest autocolant fără a-l șterge. Locul său rămâne salvat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verberg deze sticker zonder hem te verwijderen. Zijn plaats blijft behouden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏此貼紙而不刪除它，其位置會保留。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj tę naklejkę bez jej usuwania. Jego miejsce pozostaje zapisane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сховайте цю наклейку, не видаляючи її. Його місце залишається збереженим."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çıkartmayı silmeden gizleyin. Yeri saklı kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryjte tuto nálepku, aniž byste ji smazali. Jeho místo zůstává zachováno."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryť túto nálepku bez odstránenia. Jeho miesto zostáva uložené."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απόκρυψη αυτού του αυτοκόλλητου χωρίς να το διαγράψετε. Ο τόπος του παραμένει σωθείς."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dölj denna klistermärke utan att ta bort den. Dess plats förblir räddad."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul dette klistermærke uden at slette det. Dens plads forbliver reddet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul dette klistremerket uten å slette det. Stedet forblir reddet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piilota tämä tarra poistamatta sitä. Sen paikka säilyy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan stiker ini tanpa menghapusnya. Tempatnya tetap tersimpan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn nhãn dán này mà không xóa nó. Vị trí của nó vẫn được lưu."
          }
        }
      }
    },
