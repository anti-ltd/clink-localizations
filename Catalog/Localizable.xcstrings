    "Try Clink right here, no setup needed. Pick a field type and start typing.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer Clink hier, geen opstelling nodig nie. Kies 'n veldtipe en begin tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probier Clink direkt hier aus, ganz ohne Einrichtung. Wähl einen Feldtyp und leg los."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba Clink aquí mismo, sin configurar nada. Elige un tipo de campo y empieza a escribir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Proovi Clinki kohe siin, seadistamiseta. Vali välja tüüp ja hakka tipitama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie Clink ici même, aucune configuration nécessaire. Choisis un type de champ et commence à taper."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbáld ki a Clinket itt, semmit sem kell beállítanod. Válassz mezőtípust, és kezdj el gépelni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova Clink proprio qui, senza dover configurare niente. Scegli un tipo di campo e inizia a scrivere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでClinkをすぐ試せます。設定はいりません。フィールドの種類を選んで入力してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 바로 Clink를 써보세요. 따로 설정할 것 없어요. 필드 종류를 고르고 입력을 시작하면 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuba Clink terus di sini, tak perlu apa-apa persediaan. Pilih jenis medan dan mula menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimenta o Clink mesmo aqui, sem preparação nenhuma. Escolhe um tipo de campo e começa a escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте Clink прямо здесь — настраивать ничего не нужно. Выберите тип поля и начинайте печатать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就在这儿试试 Clink，不用设置。选个字段类型，开始打字吧。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încercați Clink chiar aici, nu este nevoie de configurare. Alegeți un tip de câmp și începeți să tastați."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer Clink hier, geen configuratie nodig. Kies een veldtype en begin met typen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "就在這兒試試 Clink，不用設定。選個欄位型別，開始打字吧。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypróbuj Clink tutaj, nie jest wymagana żadna konfiguracja. Wybierz typ pola i zacznij pisać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте Clink прямо тут, налаштування не потрібні. Виберіть тип поля та почніть вводити текст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink'i hemen burada deneyin; kurulum gerekmez. Bir alan türü seçin ve yazmaya başlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyzkoušejte Clink přímo zde, není potřeba žádné nastavení. Vyberte typ pole a začněte psát."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyskúšajte Clink priamo tu, nie je potrebné žiadne nastavenie. Vyberte typ poľa a začnite písať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκιμάστε το Clink εδώ, δεν χρειάζεται εγκατάσταση. Επιλέξτε έναν τύπο πεδίου και ξεκινήστε να πληκτρολογείτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova Clink här, ingen installation behövs. Välj en fälttyp och börja skriva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv Clink lige her, ingen opsætning nødvendig. Vælg en felttype, og begynd at skrive."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv Clink her, ingen oppsett er nødvendig. Velg en felttype og begynn å skrive."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile Clink:ää täällä, asennusta ei tarvita. Valitse kentän tyyppi ja ala kirjoittaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba Clink di sini, tidak perlu pengaturan. Pilih jenis bidang dan mulailah mengetik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dùng thử Clink ngay tại đây, không cần thiết lập. Chọn một loại trường và bắt đầu nhập."
          }
        }
      }
    },
