            "value": "Legfeljebb %lld csoport. A billentyűzet paneljén húzd jobbra a mentett jegyzetet a besoroláshoz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大%lldグループ。キーボードのパネルで保存したメモを右にスワイプすると、グループに割り当てられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %lld 个分组。在键盘面板中向右轻扫已保存的笔记即可分组。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 %lld개 그룹. 키보드 패널에서 저장된 메모를 오른쪽으로 쓸어넘겨 그룹에 배정하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuni %lld rühma. Rühma määramiseks pühi salvestatud märget klaviatuuripaneelil paremale."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Până la grupurile %lld. Glisați o notă salvată direct în panoul tastaturii pentru a o atribui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaal %lld-groepen. Veeg een opgeslagen notitie naar rechts in het toetsenbordpaneel om deze toe te wijzen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %lld 個分組。在鍵盤面板中向右輕掃已儲存的筆記即可分組。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot %lld-groepe. Swiep 'n gestoorde nota na regs in die sleutelbordpaneel om dit toe te wys."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do grup %lld. Przesuń zapisaną notatkę w prawo na panelu klawiatury, aby ją przypisać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До груп %lld. Проведіть збережену нотатку праворуч на панелі клавіатури, щоб призначити її."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gruplarına kadar. Kaydedilmiş bir notu atamak için klavye panelinde sağa kaydırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až do skupin %lld. Uloženou poznámku přiřaďte přejetím prstem doprava na panelu klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Až do skupín %lld. Uloženú poznámku priradíte potiahnutím prstom doprava na paneli klávesnice."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έως ομάδες %lld. Σύρετε μια αποθηκευμένη σημείωση προς τα δεξιά στον πίνακα του πληκτρολογίου για να την εκχωρήσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp till %lld-grupper. Svep en sparad anteckning åt höger på tangentbordspanelen för att tilldela den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op til %lld grupper. Stryg en gemt note til højre i tastaturpanelet for at tildele den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptil %lld-grupper. Sveip et lagret notat til høyre i tastaturpanelet for å tilordne det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-ryhmiin asti. Määritä tallennettu muistiinpano pyyhkäisemällä oikealle näppäimistöpaneelissa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingga grup %lld. Gesek catatan yang disimpan ke kanan di panel keyboard untuk menetapkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lên đến nhóm %lld. Vuốt ghi chú đã lưu ngay trong bảng bàn phím để gán ghi chú đó."
          }
        }
      }
    },
    "Up to 32 characters. Leave blank for the default label.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 32 Zeichen. Lass das Feld leer, um die Standardbeschriftung zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta 32 caracteres. Deja el campo vacío para usar la etiqueta predeterminada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuni 32 märki. Vaikimisi teksti kasutamiseks jäta väli tühjaks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "32 caractères maximum. Laisse ce champ vide pour utiliser le texte par défaut."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb 32 karakter. Az alapértelmezett felirathoz hagyd üresen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a 32 caratteri. Lascia il campo vuoto per usare il testo predefinito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "32文字まで入力できます。空欄にすると標準の表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 32자까지 입력할 수 있습니다. 비워 두면 기본 문구가 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehingga 32 aksara. Biarkan kosong untuk menggunakan label lalai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até 32 caracteres. Deixa o campo vazio para usar o texto predefinido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До 32 символов. Оставьте поле пустым, чтобы использовать надпись по умолчанию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
