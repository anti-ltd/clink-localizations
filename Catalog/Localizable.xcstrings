    "Linger 100ms · repeat after 600ms, 150→60ms. Calm & forgiving.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "100ms Verweilen · Wiederholung nach 600ms, 150→60ms. Ruhig und nachsichtig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera 100ms · repite tras 600ms, 150→60ms. Tranquilo e indulgente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai 100ms · répétition après 600ms, 150→60ms. Calme et indulgent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "100 ms tartás · 600 ms után ismétlés, 150→60 ms. Nyugodt és megbocsátó."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attesa 100ms · ripeti dopo 600ms, 150→60ms. Calmo e tollerante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保持100ms · 600ms後にリピート、150→60ms。穏やかでゆったり。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지 100ms · 600ms 뒤 반복, 150→60ms. 차분하고 너그러워요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlengah 100ms · ulang selepas 600ms, 150→60ms. Tenang & bertolak ansur."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera 100ms · repete depois de 600ms, 150→60ms. Calmo e tolerante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержка 100 мс · повтор через 600 мс, 150→60 мс. Спокойно и снисходительно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停留 100ms · 600ms 后开始重复，150→60ms。从容、宽松。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viivitus 100 ms · kordus pärast 600 ms, 150→60 ms. Rahulik ja leebe."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verlang 100ms · herhaal na 600ms, 150→60ms. Kalm & vergewensgesind."
          }
        }
      }
    },
    "Linger 40ms · repeat after 250ms, 80→25ms. Quick & aggressive.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "40ms Verweilen · Wiederholung nach 250ms, 80→25ms. Schnell und aggressiv."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera 40ms · repite tras 250ms, 80→25ms. Rápido y agresivo."
          }
        },
        "fr": {
          "stringUnit": {
