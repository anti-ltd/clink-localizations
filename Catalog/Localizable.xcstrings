    "Copied images. Only the text in your clipboard history can travel.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekopieerde beelde. Slegs die teks in jou knipbordgeskiedenis kan reis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierte Bilder. Nur der Text aus deinem Zwischenablage-Verlauf kann mitreisen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes copiadas. Solo el texto del historial del portapapeles puede viajar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopeeritud pildid. Ainult sinu lõikelaua ajaloo tekst saab kaasa reisida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images copiées. Seul le texte de ton historique de presse-papiers peut voyager."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A másolt képek. A vágólap-előzményekből csak a szöveg utazhat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini copiate. Solo il testo della cronologia degli appunti può viaggiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーした画像。移動できるのはクリップボード履歴のテキストだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 이미지. 클립보드 기록에서는 텍스트만 이동할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imej yang disalin. Hanya teks dalam sejarah papan keratan anda boleh merentas peranti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens copiadas. Só o texto do histórico da área de transferência pode viajar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопированные изображения. Переехать может только текст из истории буфера обмена."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制的图片。剪贴板历史中只有文字会同步。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagini copiate. Numai textul din istoricul clipboard poate călători."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekopieerde afbeeldingen. Alleen de tekst in uw klembordgeschiedenis kan worden verplaatst."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製的圖片。剪貼簿歷史中只有文字會同步。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiowane obrazy. Podróżować może tylko tekst zapisany w historii schowka."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопійовані зображення. Переміщатися може лише текст у вашій історії буфера обміну."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalanan resimler. Yalnızca pano geçmişinizdeki metin seyahat edebilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkopírované obrázky. Cestovat může pouze text v historii schránky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopírované obrázky. Cestovať môže iba text v histórii schránky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντιγραμμένες εικόνες. Μόνο το κείμενο στο ιστορικό του προχείρου σας μπορεί να ταξιδέψει."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierade bilder. Endast texten i din urklippshistorik kan resa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierede billeder. Kun teksten i din udklipsholderhistorik kan rejse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierte bilder. Bare teksten i utklippstavlen din kan reise."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioidut kuvat. Vain leikepöydän historiassa oleva teksti voi matkustaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar yang disalin. Hanya teks dalam riwayat papan klip Anda yang dapat berpindah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình ảnh được sao chép. Chỉ văn bản trong lịch sử clipboard của bạn mới có thể di chuyển."
          }
        }
      }
    },
