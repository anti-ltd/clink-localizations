    "Empty slots stay blank if you have fewer tools on.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leë gleuwe bly leeg as jy minder gereedskap aan het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leere Plätze bleiben frei, wenn weniger Tools an sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los huecos vacíos se quedan en blanco si tienes menos herramientas activas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tühjad kohad jäävad tühjaks, kui sul on vähem tööriistu sees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les emplacements restants restent vides si tu actives moins d’outils."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az üres helyek üresek maradnak, ha kevesebb eszköz van bekapcsolva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli slot vuoti restano vuoti se hai meno strumenti attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンのツールが少ないと、空き枠は空のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켠 도구가 더 적으면 빈 칸은 비어 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Slot kosong kekal kosong jika lebih sedikit alat dihidupkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os espaços vazios ficam em branco se tiveres menos ferramentas ligadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пустые ячейки остаются пустыми, если включено меньше инструментов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开的工具较少时，空位保持空白。"
          }
        }
      }
    },
    "Empty slots stay blank until you copy more text.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leë gleuwe bly leeg totdat jy meer teks kopieer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leere Plätze bleiben frei, bis du mehr Text kopierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los huecos vacíos se quedan en blanco hasta que copies más texto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tühjad kohad jäävad tühjaks, kuni kopeerid rohkem teksti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les emplacements restent vides tant que tu ne copies pas plus de texte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az üres helyek üresek maradnak, amíg több szöveget nem másolsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli slot vuoti restano vuoti finché non copi altro testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き枠は、テキストをもっとコピーするまで空のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 칸은 텍스트를 더 복사하기 전까지 비어 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Slot kosong kekal kosong sehingga anda salin lebih banyak teks."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os espaços vazios ficam em branco até copiares mais texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пустые ячейки остаются пустыми, пока вы не скопируете больше текста."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空位会保持空白，直到你复制更多文字。"
          }
        }
      }
    },
