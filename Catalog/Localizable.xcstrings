    "Set the light and dark sides separately if the built-in pairing isn't what you want.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel die ligte en donker kante afsonderlik as die ingeboude paring nie is wat jy wil hê nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell die helle und die dunkle Seite einzeln ein, wenn dir die vorgegebene Paarung nicht passt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el lado claro y el oscuro por separado si la combinación de fábrica no te convence."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Määra heled ja tumeda poole eraldi, kui sisseehitatud paaris ei sobi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle le côté clair et le côté sombre séparément si l'association d'origine ne te convient pas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a gyári párosítás nem tetszik, állítsd be külön a világos és a sötét oldalt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il lato chiaro e quello scuro separatamente, se l'abbinamento di serie non ti convince."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定の組み合わせが好みでなければ、ライトとダークをそれぞれ個別に設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 조합이 마음에 들지 않으면 밝은 쪽과 어두운 쪽을 따로 설정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan bahagian cerah dan gelap secara berasingan jika gandingan asalnya tidak menepati citarasa anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Define o lado claro e o escuro em separado, se o par de origem não for o que queres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте светлую и тёмную стороны по отдельности, если встроенная пара вам не подходит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果自带的搭配不合口味，浅色和深色可以分别设置。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setați părțile luminoase și întunecate separat dacă împerecherea încorporată nu este ceea ce doriți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel de lichte en donkere kant apart in als de ingebouwde koppeling niet is wat je wilt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果自帶的搭配不合口味，淺色和深色可以分別設定。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli wbudowane parowanie nie jest tym, czego chcesz, ustaw oddzielnie jasną i ciemną stronę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановіть світлі та темні сторони окремо, якщо вбудоване поєднання не те, що вам потрібно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerleşik eşleştirme istediğiniz gibi değilse aydınlık ve karanlık tarafları ayrı ayrı ayarlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud vestavěné párování není to, co chcete, nastavte světlou a tmavou stranu samostatně."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte svetlú a tmavú stranu oddelene, ak vstavané párovanie nie je to, čo chcete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρυθμίστε τη φωτεινή και τη σκοτεινή πλευρά ξεχωριστά, εάν η ενσωματωμένη αντιστοίχιση δεν είναι αυτό που θέλετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in de ljusa och mörka sidorna separat om den inbyggda parningen inte är vad du vill ha."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstil de lyse og mørke sider separat, hvis den indbyggede parring ikke er, hvad du ønsker."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Still inn de lyse og mørke sidene separat hvis den innebygde sammenkoblingen ikke er det du ønsker."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta vaaleat ja tummat puolet erikseen, jos sisäänrakennettu pariliitos ei ole haluamasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur sisi terang dan gelap secara terpisah jika pemasangan bawaan tidak sesuai dengan keinginan Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt riêng các mặt sáng và tối nếu tính năng ghép nối tích hợp không phải là thứ bạn muốn."
          }
        }
      }
    },
