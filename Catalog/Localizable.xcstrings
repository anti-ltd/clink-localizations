          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga Animar fundos, no separador Fundo, para usares isto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Анимировать фоны» на вкладке «Задний план», чтобы этим пользоваться."
