          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzással rendezd át a billentyűzet Fordítás menüjének nyelveit, és kapcsold ki, amit nem szeretnél látni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグしてキーボードの翻訳メニューの言語を並べ替え、表示しない言語はオフにできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
