    "Applies to": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Van toepassing op"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
