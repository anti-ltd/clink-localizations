    "Predictions, autocorrect, and swipe decoding all run in the app. No server.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voorspellings, outokorreksie en vee-dekodering word alles in die toepassing uitgevoer. Geen bediener nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhersagen, Autokorrektur und Wischeingabe laufen alle in der App. Kein Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predicciones, autocorrección y deslizamiento van dentro de la app. Sin servidor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennustused, automaatparandus ja pühkimise dekodeerimine töötavad kõik rakenduses. Serverit pole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prédictions, la correction auto et le décodage par glissement marchent tous dans l'app. Pas de serveur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A javaslatok, az automatikus javítás és a csúsztatásos gépelés mind az appban fut. Nincs szerver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsioni, correzione automatica e swipe girano tutti nell'app. Nessun server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測も自動修正も、スワイプ入力の解析も、すべてアプリの中で動きます。サーバーは使いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예측, 자동 수정, 스와이프 인식이 전부 앱 안에서 돌아가요. 서버는 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramalan, autobetul dan penyahkodan leret, semuanya berjalan dalam app. Tiada pelayan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsões, correção automática e descodificação por deslize correm todas na app. Sem servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предсказания, автокоррекция и разбор скольжения — всё работает внутри приложения. Без сервера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联想、自动更正和滑动识别都在应用里跑，不走服务器。"
          }
        }
      }
    },
