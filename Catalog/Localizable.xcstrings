          }
        }
      }
    },
    "The suggestion bar and the corrections are separate switches, so you can keep one and drop the other.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die voorstelbalk en die regstellings is aparte skakelaars, sodat jy een kan hou en die ander kan laat val."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschlagsleiste und Korrekturen sind getrennte Schalter, du kannst also eines behalten und das andere loswerden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de sugerencias y las correcciones son interruptores distintos, así que puedes quedarte con una y quitar las otras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soovituseriba ja parandused on eraldi lüliti, nii et saad ühe hoida ja teise ära jätta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre de suggestions et les corrections sont deux interrupteurs distincts : tu peux garder l'une et supprimer les autres."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A javaslatsáv és a javítások külön kapcsoló, így az egyiket megtarthatod, a másikat elhagyhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra dei suggerimenti e le correzioni sono interruttori separati, quindi puoi tenere l'una e togliere le altre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補バーと自動修正は別のスイッチなので、片方だけ残すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천 바와 수정은 서로 다른 스위치라, 하나만 남겨 둘 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bar cadangan dan pembetulan ialah suis berasingan, jadi anda boleh kekalkan satu dan buang yang lain."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de sugestões e as correções são interruptores diferentes, por isso podes ficar com uma e largar a outra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка подсказок и исправления — разные переключатели, так что одно можно оставить, а другое убрать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议栏和更正是两个独立开关，可以留一个、去一个。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara de sugestii și corecțiile sunt comutatoare separate, astfel încât să puteți păstra una și să renunțați la cealaltă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De suggestiebalk en de correcties zijn afzonderlijke schakelaars, dus u kunt de ene behouden en de andere laten vallen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建議欄和更正是兩個獨立開關，可以留一個、去一個。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasek sugestii i poprawki to osobne przełączniki, więc możesz zachować jeden i pominąć drugi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель пропозицій і виправлення є окремими перемикачами, тому ви можете залишити один і відкинути інший."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öneri çubuğu ve düzeltmeler ayrı anahtarlardır; dolayısıyla birini tutup diğerini bırakabilirsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel návrhů a opravy jsou samostatné přepínače, takže si můžete jeden ponechat a druhý zahodit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel návrhov a opravy sú samostatné prepínače, takže jeden si môžete ponechať a druhý zahodiť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή προτάσεων και οι διορθώσεις είναι ξεχωριστοί διακόπτες, ώστε να μπορείτε να κρατήσετε το ένα και να αφήσετε το άλλο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förslagsfältet och korrigeringarna är separata omkopplare, så du kan behålla den ena och släppa den andra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forslagslinjen og rettelserne er separate kontakter, så du kan beholde den ene og slippe den anden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forslagslinjen og rettelsene er separate brytere, slik at du kan beholde den ene og slippe den andre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehdotuspalkki ja korjaukset ovat erillisiä kytkimiä, joten voit pitää toisen ja pudottaa toisen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah saran dan koreksi merupakan saklar terpisah, sehingga Anda dapat menyimpan satu dan membuang yang lain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh gợi ý và phần chỉnh sửa là các công tắc riêng biệt nên bạn có thể giữ cái này và bỏ cái kia."
          }
        }
      }
    },
    "The switcher follows the Tools menu style: choose Grid for tiles or Cards for a list.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die skakelaar volg die Tools-kieslysstyl: kies Grid vir teëls of Kaarte vir 'n lys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Umschalter folgt dem Stil des Werkzeugmenüs: Wähle Raster für Kacheln oder Karten für eine Liste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El selector sigue el estilo del menú Herramientas: elige Cuadrícula para mosaicos o Tarjetas para una lista."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahetaja järgib Tööriistade menüü stiili: paanide jaoks vali Ruudustik, loendi jaoks Kaardid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sélecteur reprend le style du menu Outils : choisissez Grille pour des tuiles ou Cartes pour une liste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A váltó az Eszközök menü stílusát követi: csempékhez válaszd a Rácsot, listához a Kártyákat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il selettore segue lo stile del menu Strumenti: scegli Griglia per i riquadri o Schede per un elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切替は「ツール」メニューと同じスタイルです。タイルならグリッド、一覧ならカードを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환기는 도구 메뉴 스타일을 따릅니다. 타일은 격자, 목록은 카드를 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penukar mengikut gaya menu Alat: pilih Grid untuk jubin atau Kad untuk senarai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seletor segue o estilo do menu Ferramentas: escolhe Grelha para mosaicos ou Cartões para uma lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключатель повторяет стиль меню «Инструменты»: выберите «Сетку» для плиток или «Карточки» для списка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换器沿用“工具”菜单样式：磁贴选“网格”，列表选“卡片”。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comutatorul urmează stilul meniului Instrumente: alege Grid pentru plăci sau Carduri pentru o listă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De switcher volgt de menustijl Extra: kies Raster voor tegels of Kaarten voor een lijst."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換器沿用“工具”選單樣式：磁貼選“網格”，列表選“卡片”。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełącznik jest zgodny ze stylem menu Narzędzia: wybierz opcję Siatka dla kafelków lub Karty dla listy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемикач відповідає стилю меню «Інструменти»: виберіть «Сітка» для плиток або «Картки» для списку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirici, Araçlar menü stilini izler: kutucuklar için Izgara'yı veya liste için Kartlar'ı seçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepínač se řídí stylem nabídky Nástroje: zvolte Mřížka pro dlaždice nebo Karty pro seznam."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepínač sa riadi štýlom ponuky Nástroje: vyberte Mriežka pre dlaždice alebo Karty pre zoznam."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακόπτης ακολουθεί το στυλ μενού Εργαλεία: επιλέξτε Πλέγμα για πλακίδια ή Κάρτες για λίστα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växlaren följer menystilen Verktyg: välj Rutnät för brickor eller Kort för en lista."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skifteren følger menustilen Værktøjer: vælg Gitter for fliser eller Kort for en liste."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytteren følger Verktøy-menystilen: velg Rutenett for fliser eller Kort for en liste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihteisto noudattaa Työkalut-valikon tyyliä: valitse Ruudukko ruuduille tai Kortit luetteloa varten."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengalih mengikuti gaya menu Alat: pilih Kisi untuk ubin atau Kartu untuk daftar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình chuyển đổi tuân theo kiểu menu Công cụ: chọn Lưới cho ô hoặc Thẻ cho danh sách."
          }
        }
      }
    },
    "The system picks the key you meant. Letter keys commit right away, so text shows up before anything else.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die stelsel kies die sleutel wat jy bedoel het. Briefsleutels verbind dadelik, so teks verskyn voor enigiets anders."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das System wählt die Taste, die du meintest. Buchstabentasten werden sofort übernommen – der Text erscheint vor allem anderen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema elige la tecla que querías. Las teclas de letra se confirman al instante: el texto aparece antes que nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Süsteem valib klahvi, mida tahtsid. Täheklahvid rakenduvad kohe, nii et tekst ilmub enne kõike muud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système choisit la touche que tu visais. Les touches de lettres s'appliquent tout de suite — le texte apparaît avant tout le reste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rendszer kiválasztja a billentyűt, amelyikre gondoltál. A betűbillentyűk azonnal érvényesülnek – a szöveg minden más előtt megjelenik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sistema sceglie il tasto che intendevi. I tasti lettera si confermano subito — il testo compare prima di ogni altra cosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが、あなたが意図したキーを選びます。文字キーはすぐに確定し、何よりも先にテキストが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 노린 키를 골라요. 글자 키는 바로 확정돼요 — 텍스트가 무엇보다 먼저 나와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem pilih kekunci yang anda maksudkan. Kekunci huruf disahkan serta-merta — teks muncul sebelum apa-apa lain."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema escolhe a tecla que querias. As teclas de letra confirmam logo — o texto aparece antes de tudo o resto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система сама определяет, какую клавишу вы имели в виду. Буквенные клавиши срабатывают сразу — текст появляется раньше всего остального."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统会挑出你想按的键。字母键立刻确认——文字比其他任何东西都先出现。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemul alege cheia la care ai vrut să spui. Tastele cu litere se angajează imediat, astfel încât textul apare înainte de orice altceva."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het systeem kiest de sleutel die u bedoelde. Lettertoetsen worden meteen vastgelegd, zodat tekst vóór alles verschijnt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統會挑出你想按的鍵。字母鍵立刻確認——文字比其他任何東西都先出現。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "System wybiera klucz, który miałeś na myśli. Klawisze literowe zatwierdzają się od razu, więc tekst pojawia się przed wszystkim innym."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Система вибирає ключ, який ви мали на увазі. Літерні ключі фіксуються відразу, тому текст відображається раніше всього іншого."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem kastettiğin anahtarı seçer. Harf tuşları hemen işlenir, böylece metin her şeyden önce görünür."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Systém vybere klíč, který jste měli na mysli. Písmenné klávesy se okamžitě potvrzují, takže text se zobrazí před čímkoli jiným."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Systém vyberie kľúč, ktorý ste mali na mysli. Písmenové klávesy sa potvrdia okamžite, takže text sa zobrazí skôr ako čokoľvek iné."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σύστημα επιλέγει το κλειδί που εννοούσατε. Τα πλήκτρα γραμμάτων δεσμεύονται αμέσως, έτσι το κείμενο εμφανίζεται πριν από οτιδήποτε άλλο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemet väljer nyckeln du menade. Bokstavsnycklar binds direkt, så text dyker upp före allt annat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemet vælger den nøgle, du mente. Bogstavnøgler forpligtes med det samme, så tekst dukker op før noget andet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemet velger nøkkelen du mente. Bokstavnøkler forpliktes umiddelbart, så tekst vises før noe annet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestelmä valitsee tarkoitetun avaimen. Kirjainnäppäimet sitoutuvat välittömästi, joten teksti näkyy ennen kaikkea muuta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem mengambil kunci yang Anda maksud. Tombol huruf langsung diterapkan, sehingga teks muncul sebelum teks lainnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ thống chọn khóa bạn muốn nói. Các phím chữ cái được thực hiện ngay lập tức, vì vậy văn bản sẽ hiển thị trước bất kỳ nội dung nào khác."
          }
        }
      }
    },
