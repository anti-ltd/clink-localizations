    "Clipboard needs Full Access, and reading it shows the iOS paste banner.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zwischenablage braucht Vollzugriff, und beim Lesen zeigt iOS das Einfügen-Banner an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles necesita acceso completo, y al leerlo iOS muestra el aviso de pegado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers nécessite l'accès complet, et sa lecture affiche la bannière de collage d'iOS."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágólaphoz Teljes hozzáférés kell, és a beolvasásakor az iOS megjeleníti a beillesztési sávot."
