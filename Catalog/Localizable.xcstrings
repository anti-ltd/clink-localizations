        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každú sekundu"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε δευτερόλεπτο"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje sekund"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert sekund"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert sekund"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joka sekunti"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap detik"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi giây"
          }
        }
      }
    },
    "Every setting goes back to how Clink shipped. Your themes, profiles, and saved words are kept.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke instelling gaan terug na hoe Clink gestuur het. Jou temas, profiele en gestoorde woorde word gehou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Einstellungen gehen zurück auf den Auslieferungszustand von Clink. Deine Themes, Profile und gespeicherten Wörter bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los ajustes vuelven a como venía Clink. Tus temas, perfiles y palabras guardadas se mantienen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga seadistus naaseb Clinki väljalaskeolekusse. Sinu teemad, profiilid ja salvestatud sõnad jäävad alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les réglages reviennent à l’état d’origine de Clink. Tes thèmes, profils et mots enregistrés sont conservés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden beállítás visszaáll arra, ahogy a Clink érkezett. A témáid, profiljaid és mentett szavaid megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le impostazioni tornano com’era Clink all’inizio. Temi, profili e parole salvate restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定はすべて Clink の初期状態に戻ります。テーマ、プロファイル、保存した単語はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정이 모두 Clink의 처음 상태로 돌아갑니다. 테마, 프로필, 저장한 단어는 그대로 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua tetapan kembali kepada keadaan asal Clink. Tema, profil dan perkataan simpanan anda kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as definições voltam ao estado em que o Clink veio. Os teus temas, perfis e palavras guardadas ficam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все настройки вернутся к тому, какими Clink был из коробки. Темы, профили и сохранённые слова останутся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有设置都会回到 Clink 出厂时的状态。你的主题、配置文件和已保存的词会保留。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare setare revine la modul în care a fost expediat Clink. Temele, profilurile și cuvintele salvate sunt păstrate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke instelling gaat terug naar hoe Clink is verzonden. Uw thema's, profielen en opgeslagen woorden worden bewaard."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有設定都會回到 Clink 出廠時的狀態。你的主題、配置檔案和已儲存的詞會保留。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde ustawienie pochodzi z wersji dostarczonej Clink. Twoje motywy, profile i zapisane słowa zostaną zachowane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне налаштування повертається до того, як постачався Clink. Ваші теми, профілі та збережені слова зберігаються."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ayar Clink'in nasıl gönderildiğine bağlıdır. Temalarınız, profilleriniz ve kayıtlı kelimeleriniz saklanır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé nastavení se vrací k tomu, jak byl Clink dodán. Vaše motivy, profily a uložená slova zůstanou zachována."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé nastavenie sa vracia k tomu, ako bol Clink dodaný. Vaše témy, profily a uložené slová sa zachovajú."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε ρύθμιση επιστρέφει στον τρόπο αποστολής του Clink. Τα θέματα, τα προφίλ και οι αποθηκευμένες λέξεις σας διατηρούνται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje inställning går tillbaka till hur Clink skickades. Dina teman, profiler och sparade ord behålls."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver indstilling går tilbage til, hvordan Clink blev sendt. Dine temaer, profiler og gemte ord bevares."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver innstilling går tilbake til hvordan Clink ble sendt. Dine temaer, profiler og lagrede ord beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen asetus palautuu Clink:n toimitustapaan. Teemasi, profiilisi ja tallennetut sanasi säilytetään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap pengaturan kembali ke cara pengiriman Clink. Tema, profil, dan kata-kata yang Anda simpan disimpan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi cài đặt đều quay trở lại cách Clink được vận chuyển. Chủ đề, hồ sơ và từ đã lưu của bạn sẽ được lưu giữ."
          }
        }
      }
    },
    "Every tap is recorded against the key you meant.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke tik word opgeneem teen die sleutel wat jy bedoel het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Tipper wird der Taste zugeordnet, die du gemeint hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada toque se registra en la tecla que querías pulsar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga vajutus salvestatakse klahvi vastu, mida tahtsid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque appui est enregistré sur la touche que tu visais."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden koppintás ahhoz a billentyűhöz kerül, amelyikre gondoltál."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni tocco viene registrato sul tasto che volevi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップはすべて、意図したキーに紐づけて記録されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 탭이 원래 누르려던 키에 기록됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap ketikan direkodkan pada kekunci yang anda maksudkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada toque fica registado na tecla que querias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое нажатие записывается напротив той клавиши, в которую вы целились."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次点按都会记在你原本想按的那个键上。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare atingere este înregistrată împotriva tastei la care v-ați referit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke tik wordt opgenomen tegen de toets die u bedoelde."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次點按都會記在你原本想按的那個鍵上。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde dotknięcie jest rejestrowane względem klawisza, który miałeś na myśli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне натискання записується проти клавіші, яку ви мали на увазі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her dokunuş, kastettiğin tuşa göre kaydedilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé klepnutí je zaznamenáno proti klíči, který jste měli na mysli."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé klepnutie sa zaznamená oproti kľúču, ktorý ste mali na mysli."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε πάτημα καταγράφεται στο κλειδί που εννοούσατε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje tryck spelas in mot nyckeln du menade."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert tryk optages mod den nøgle, du mente."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert trykk registreres mot nøkkelen du mente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen napautus tallennetaan haluamaasi avainta vasten."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap ketukan direkam berdasarkan kunci yang Anda maksud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lần nhấn đều được ghi lại theo phím bạn muốn nói."
          }
        }
      }
    },
    "Every time the keyboard opens, shortcuts get loaded into memory. Short strings expand to full phrases and show up as suggestions.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke keer as die sleutelbord oopmaak, word kortpaaie in die geheue gelaai. Kort stringe brei uit na volledige frases en verskyn as voorstelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mal, wenn die Tastatur öffnet, werden Kürzel in den Speicher geladen. Kurze Zeichenfolgen werden zu ganzen Phrasen und erscheinen als Vorschläge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que se abre el teclado, los atajos se cargan en memoria. Las cadenas cortas se expanden a frases completas y aparecen como sugerencias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga kord, kui klaviatuur avaneb, laaditakse otseteed mällu. Lühendid laienevad täisfraasideks ja ilmuvad soovitustena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À chaque ouverture du clavier, les raccourcis sont chargés en mémoire. Les chaînes courtes se développent en phrases complètes et apparaissent dans les suggestions."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahányszor megnyílik a billentyűzet, a rövidítések betöltődnek a memóriába. A rövid karakterláncok teljes kifejezésekké bővülnek, és javaslatként jelennek meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni volta che la tastiera si apre, le scorciatoie vengono caricate in memoria. Le stringhe brevi si espandono in frasi complete e compaiono come suggerimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードを開くたびに、ショートカットがメモリに読み込まれます。短い文字列が完全なフレーズに展開され、候補として表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 열릴 때마다 단축어가 메모리에 올라와요. 짧은 문자열이 완전한 문구로 확장돼서 추천으로 나와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap kali papan kekunci dibuka, pintasan dimuatkan ke dalam memori. Rentetan pendek berkembang jadi frasa penuh dan muncul sebagai cadangan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre que o teclado abre, os atalhos são carregados na memória. Textos curtos expandem-se em frases completas e aparecem como sugestões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При каждом открытии клавиатуры сокращения загружаются в память. Короткие строки разворачиваются в полные фразы и появляются в подсказках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次键盘打开时，快捷替换都会加载进内存。短字符串会展开成完整短语，并作为建议出现。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "De fiecare dată când se deschide tastatura, comenzile rapide se încarcă în memorie. Șirurile scurte se extind la fraze complete și apar ca sugestii."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke keer dat het toetsenbord wordt geopend, worden snelkoppelingen in het geheugen geladen. Korte tekenreeksen worden uitgebreid tot volledige zinnen en verschijnen als suggesties."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次鍵盤開啟時，快捷替換都會載入進記憶體。短字串會展開成完整短語，並作為建議出現。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy każdym otwarciu klawiatury skróty są ładowane do pamięci. Krótkie ciągi znaków rozwijają się do pełnych fraz i wyświetlają się jako sugestie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоразу, коли відкривається клавіатура, ярлики завантажуються в пам’ять. Короткі рядки розгортаються до повних фраз і відображаються як пропозиції."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye her açıldığında kısayollar belleğe yüklenir. Kısa dizeler tam ifadelere genişler ve öneri olarak görünür."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při každém otevření klávesnice se do paměti načtou zkratky. Krátké řetězce se rozbalí na celé fráze a zobrazí se jako návrhy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri každom otvorení klávesnice sa do pamäte načítajú skratky. Krátke reťazce sa rozšíria na celé frázy a zobrazia sa ako návrhy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε φορά που ανοίγει το πληκτρολόγιο, οι συντομεύσεις φορτώνονται στη μνήμη. Οι σύντομες συμβολοσειρές επεκτείνονται σε πλήρεις φράσεις και εμφανίζονται ως προτάσεις."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje gång tangentbordet öppnas laddas genvägar in i minnet. Korta strängar utökas till fullständiga fraser och visas som förslag."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver gang tastaturet åbnes, indlæses genveje i hukommelsen. Korte strenge udvides til hele sætninger og vises som forslag."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver gang tastaturet åpnes, blir snarveier lastet inn i minnet. Korte strenger utvides til fullstendige fraser og vises som forslag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aina kun näppäimistö avautuu, pikanäppäimet ladataan muistiin. Lyhyet merkkijonot laajenevat täysiksi lauseiksi ja näkyvät ehdotuksina."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap kali keyboard terbuka, pintasan dimuat ke dalam memori. String pendek diperluas ke frasa penuh dan muncul sebagai saran."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi khi bàn phím mở ra, các phím tắt sẽ được tải vào bộ nhớ. Các chuỗi ngắn mở rộng thành cụm từ đầy đủ và hiển thị dưới dạng gợi ý."
          }
        }
      }
    },
    "Every tool has its own page, with the switch at the top and everything it can do underneath.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke instrument het sy eie bladsy, met die skakelaar aan die bokant en alles wat dit kan doen daaronder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Werkzeug hat seine eigene Seite: oben der Schalter, darunter alles, was es kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada herramienta tiene su propia página: el interruptor arriba y todo lo que sabe hacer debajo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Igal tööriistal on oma leht: üleval lüliti, all kõik, mida ta oskab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque outil a sa page : l'interrupteur en haut, et tout ce qu'il sait faire en dessous."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden eszköznek saját oldala van: fent a kapcsoló, alatta minden, amit tud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni strumento ha la sua pagina: in alto l'interruttore, sotto tutto quello che sa fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールごとにページがあり、上部にスイッチ、その下にできることが並びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구마다 자기 페이지가 있고, 위에 스위치, 아래에 할 수 있는 일이 모여 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap alat ada halamannya sendiri, dengan suis di atas dan segala kebolehannya di bawah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ferramenta tem a sua página: o interruptor em cima e tudo o que sabe fazer por baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого инструмента своя страница: переключатель сверху, всё остальное — под ним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个工具都有自己的页面：开关在上面，能做的事在下面。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare instrument are propria pagină, cu comutatorul în partea de sus și tot ce poate face dedesubt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke tool heeft zijn eigen pagina, met bovenaan de schakelaar en daaronder alles wat hij kan doen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個工具都有自己的頁面：開關在上面，能做的事在下面。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde narzędzie ma swoją własną stronę, z przełącznikiem na górze i wszystkimi jego możliwościami poniżej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен інструмент має власну сторінку з перемикачем угорі та всім, що він може робити під ним."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her aracın kendi sayfası vardır; anahtar üsttedir ve yapabileceği her şey alttadır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý nástroj má svou vlastní stránku s přepínačem nahoře a vším, co umí, pod ním."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý nástroj má svoju vlastnú stránku s prepínačom v hornej časti a so všetkým, čo môže robiť pod ním."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε εργαλείο έχει τη δική του σελίδα, με το διακόπτη στο επάνω μέρος και όλα όσα μπορεί να κάνει από κάτω."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje verktyg har sin egen sida, med omkopplaren överst och allt det kan göra under."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert værktøj har sin egen side med kontakten øverst og alt, hvad det kan nedenunder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert verktøy har sin egen side, med bryteren øverst og alt det kan gjøre under."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisella työkalulla on oma sivunsa, jonka yläosassa on kytkin ja alla kaikki mitä se voi tehdä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap alat memiliki halamannya sendiri, dengan tombol di bagian atas dan segala sesuatu yang dapat dilakukan di bawahnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi công cụ đều có trang riêng, với nút chuyển ở trên cùng và mọi thứ nó có thể thực hiện ở bên dưới."
          }
        }
      }
    },
    "Everyday typing works without Full Access. Turn it on for clipboard access, custom **clink** sound packs, haptics and GIF browsing.": {
      "comment": "GIF browser UI and accessibility. Native-speaker editorial sign-off for this release is tracked in docs/gif-tool-localization-review.md.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyday typing works without Full Access. Turn it on for clipboard access, custom **clink** sound packs, haptics and GIF browsing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes escribir normalmente sin Acceso completo. Actívalo para acceder al portapapeles, usar packs de sonidos personalizados de **clink**, activar la respuesta háptica y explorar GIFs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux taper normalement sans l’Accès complet. Active-le pour accéder au presse-papiers, utiliser les packs de sons personnalisés **clink**, profiter du retour haptique et parcourir des GIFs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normales Tippen funktioniert ohne Vollzugriff. Aktiviere ihn für den Zugriff auf die Zwischenablage, eigene **clink**-Soundpakete, Haptik und das Durchsuchen von GIFs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi scrivere normalmente senza Accesso completo. Attivalo per accedere agli appunti, usare i pacchetti di suoni personalizzati **clink**, il feedback aptico e sfogliare GIF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes escrever normalmente sem Acesso total. Ativa-o para aceder à área de transferência, usar pacotes de sons personalizados **clink**, resposta háptica e explorar GIFs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычный ввод работает без Полного доступа. Включите его для доступа к буферу обмена, пользовательских звуковых наборов **clink**, тактильного отклика и просмотра GIF."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penaipan biasa berfungsi tanpa Akses penuh. Hidupkannya untuk mengakses papan klip, menggunakan pek bunyi tersuai **clink**, maklum balas haptik dan melayari GIF."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szokásos gépelés Teljes hozzáférés nélkül is működik. A vágólap eléréséhez, az egyéni **clink** hangcsomagokhoz, a rezgéses visszajelzéshez és a GIF-ek böngészéséhez kapcsold be."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の入力はフルアクセスなしでも利用できます。クリップボード、カスタムの**clink**サウンドパック、触覚フィードバック、GIFの閲覧を使うには、フルアクセスをオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日常输入无需“完全访问”。如需访问剪贴板、使用自定义 **clink** 声音包、触感反馈或浏览 GIF，请开启此权限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반적인 입력은 전체 접근 없이도 가능해요. 클립보드 접근, 사용자 설정 **clink** 사운드 팩, 햅틱, GIF 둘러보기를 사용하려면 전체 접근을 켜세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavaline kirjutamine töötab ilma täisjuurdepääsuta. Luba see lõikelaua, kohandatud **clink**-helipakettide, puutetagasiside ja GIF-ide sirvimise kasutamiseks."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți tasta în mod obișnuit fără acces complet. Activează-l pentru acces la clipboard, pachete de sunete **clink** personalizate, răspuns haptic și căutarea de GIF-uri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagelijks typen werkt zonder volledige toegang. Schakel het in voor toegang tot het klembord, aangepaste **clink**-geluidspakketten, haptiek en GIF-browsen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日常輸入無需“完整取用”。如需訪問剪貼簿、使用自定義 **clink** 聲音包、觸感反饋或瀏覽 GIF，請開啟此許可權。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Daaglikse tikwerk funksioneer sonder Voltooi Toegang. Skakel dit aan vir knipbordtoegang, pasgemaakte **klink** klankpakkette, haptika en GIF-blaai."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Codzienne pisanie działa bez pełnego dostępu. Włącz tę opcję, aby uzyskać dostęp do schowka, niestandardowych pakietów dźwiękowych **clink**, elementów dotykowych i przeglądania plików GIF."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоденне введення тексту працює без повного доступу. Увімкніть його, щоб отримати доступ до буфера обміну, користувацькі звукові пакети **clink**, тактильні дії та перегляд GIF."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük yazma, Tam Erişim olmadan çalışır. Panoya erişim, özel **tıklama** ses paketleri, dokunma teknolojisi ve GIF'te gezinme için bu özelliği açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každodenní psaní funguje bez plného přístupu. Zapněte jej pro přístup do schránky, vlastní zvukové balíčky **cinknutí**, haptiku a procházení GIFů."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každodenné písanie funguje bez úplného prístupu. Zapnite ho pre prístup do schránky, vlastné **clink** zvukové balíčky, haptiku a prehliadanie GIF."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η καθημερινή πληκτρολόγηση λειτουργεί χωρίς πλήρη πρόσβαση. Ενεργοποιήστε το για πρόσβαση στο πρόχειρο, προσαρμοσμένα πακέτα ήχου **clink**, απτικά και περιήγηση GIF."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att skriva varje dag fungerar utan full åtkomst. Slå på den för åtkomst till urklipp, anpassade **clink**-ljudpaket, haptik och GIF-surfning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Daglig skrivning fungerer uden fuld adgang. Slå det til for at få adgang til udklipsholderen, tilpassede **clink**-lydpakker, haptics og GIF-browsing."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Daglig skriving fungerer uten full tilgang. Slå den på for tilgang til utklippstavlen, tilpassede **klinke**-lydpakker, haptics og GIF-surfing."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivittäinen kirjoittaminen toimii ilman täydellistä pääsyä. Ota se käyttöön, niin voit käyttää leikepöytää, mukautettuja **clink**-äänipaketteja, haptiikkaa ja GIF-selailua."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengetikan sehari-hari berfungsi tanpa Akses Penuh. Aktifkan untuk akses papan klip, paket suara **clink** khusus, penelusuran haptik dan GIF."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc gõ hàng ngày hoạt động mà không cần truy cập đầy đủ. Bật tính năng này để truy cập bảng nhớ tạm, gói âm thanh **clink** tùy chỉnh, cảm giác xúc giác và duyệt ảnh GIF."
          }
        }
      }
    },
