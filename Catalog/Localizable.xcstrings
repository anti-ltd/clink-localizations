    "Hold the key to pick a character or open a panel, Gboard-style.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou die sleutel in om 'n karakter te kies of maak 'n paneel in Gboard-styl oop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt die Taste gedrückt, um ein Zeichen zu wählen oder ein Panel zu öffnen, so wie bei Gboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la tecla para elegir un carácter o abrir un panel, al estilo Gboard."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia klahvi, et valida märk või avada paneel, Gboardi moodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens la touche pour choisir un caractère ou ouvrir un panneau, façon Gboard."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd lenyomva a billentyűt egy karakter kiválasztásához vagy egy panel megnyitásához, Gboard-módra."
          }
        },
        "it": {
          "stringUnit": {
