    "Started from %@. Your font stays on this device: fonts made here aren't attached to shared themes.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creada a partir de %@. Tu fuente se queda en este dispositivo: las fuentes hechas aquí no se adjuntan a los temas compartidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créée à partir de %@. Ta police reste sur cet appareil : les polices créées ici ne sont pas jointes aux thèmes partagés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgehend von %@ erstellt. Deine Schrift bleibt auf diesem Gerät: hier erstellte Schriften werden geteilten Themes nicht beigefügt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creato a partire da %@. Il tuo font resta su questo dispositivo: i font creati qui non vengono allegati ai temi condivisi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Criada a partir de %@. A sua fonte fica neste dispositivo: as fontes feitas aqui não são anexadas a temas partilhados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создан на основе %@. Ваш шрифт остаётся на этом устройстве: созданные здесь шрифты не прикрепляются к общим темам."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimulakan daripada %@. Fon anda kekal pada peranti ini: fon yang dibuat di sini tidak dilampirkan pada tema yang dikongsi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ alapján készült. A betűtípusod ezen az eszközön marad: az itt készített betűtípusok nem csatolódnak a megosztott témákhoz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をもとに作成しました。このフォントは端末内にとどまり、共有するテーマには添付されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 %@ 创建。你的字体保留在此设备上：在此制作的字体不会随分享的主题一起发送。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 시작했습니다. 만든 글꼴은 이 기기에만 남으며, 공유하는 테마에는 첨부되지 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loodud fondi %@ põhjal. Sinu font jääb sellesse seadmesse: siin tehtud fonte ei lisata jagatavatele teemadele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "A început de la %@. Fontul dvs. rămâne pe acest dispozitiv: fonturile create aici nu sunt atașate temelor partajate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestart vanuit %@. Je lettertype blijft op dit apparaat staan: lettertypen die hier worden gemaakt, zijn niet gekoppeld aan gedeelde thema's."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基於 %@ 建立。你的字型保留在此裝置上：在此製作的字型不會隨分享的主題一起傳送。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin vanaf %@. Jou lettertipe bly op hierdie toestel: lettertipes wat hier gemaak word, word nie aan gedeelde temas gekoppel nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaczęło się od %@. Twoja czcionka pozostanie na tym urządzeniu: utworzone tutaj czcionki nie są dołączone do udostępnionych motywów."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почав з %@. Ваш шрифт залишається на цьому пристрої: створені тут шрифти не додаються до спільних тем."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'ten başladı. Yazı tipiniz bu cihazda kalır: Burada oluşturulan yazı tipleri, paylaşılan temalara eklenmez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začátek od %@. Vaše písmo zůstane v tomto zařízení: písma vytvořená zde nejsou připojena ke sdíleným motivům."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Začína sa od %@. Vaše písmo zostane v tomto zariadení: písma vytvorené tu nie sú pripojené k zdieľaným motívom."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκίνησε από το %@. Η γραμματοσειρά σας παραμένει σε αυτήν τη συσκευή: οι γραμματοσειρές που κατασκευάζονται εδώ δεν συνδέονται με κοινόχρηστα θέματα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Började från %@. Ditt teckensnitt stannar på den här enheten: teckensnitt som görs här är inte kopplade till delade teman."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Startede fra %@. Din skrifttype forbliver på denne enhed: skrifttyper lavet her er ikke knyttet til delte temaer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet fra %@. Skriften din forblir på denne enheten: skrifter laget her er ikke knyttet til delte temaer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkoi %@:stä. Fonttisi pysyy tällä laitteella: täällä tehtyjä kirjasimia ei liitetä jaettuihin teemoihin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimulai dari %@. Font Anda tetap ada di perangkat ini: font yang dibuat di sini tidak dilampirkan ke tema bersama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu từ %@. Phông chữ của bạn vẫn còn trên thiết bị này: phông chữ được tạo ở đây không được đính kèm với các chủ đề được chia sẻ."
          }
        }
      }
    },
