        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내 주시려면 리포트 공유를 누르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik Kongsi laporan jika anda mahu menghantarnya kepada kami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
