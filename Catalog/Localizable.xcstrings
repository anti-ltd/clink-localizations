    "Long-press extras need a key that types a single character.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los extras de pulsación larga necesitan una tecla que escriba un solo carácter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les options d’appui long nécessitent une touche qui saisit un seul caractère."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusatzzeichen beim Gedrückthalten benötigen eine Taste, die ein einzelnes Zeichen eingibt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le opzioni della pressione prolungata richiedono un tasto che digiti un solo carattere."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os extras de pressão prolongada precisam de uma tecla que escreva um único caráter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для дополнительных символов по долгому нажатию нужна клавиша, вводящая один символ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan tambahan tekan lama memerlukan kekunci yang menaip satu aksara."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hosszú nyomás extráihoz egyetlen karaktert beíró billentyű szükséges."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しの追加機能には、1文字を入力するキーが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按附加选项需要使用只输入单个字符的按键。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 누르기 추가 기능은 한 글자를 입력하는 키가 필요합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pika vajutuse lisavalikud vajavad klahvi, mis sisestab ühe märgi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Suplimentele cu apăsare lungă au nevoie de o tastă care să tasteze un singur caracter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra's die lang worden ingedrukt, hebben een toets nodig die één teken typt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按附加選項需要使用只輸入單個字元的按鍵。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstra funksies vir lang druk vereis 'n sleutel wat 'n enkele karakter tik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatki wymagające długiego naciśnięcia wymagają klawisza wpisującego pojedynczy znak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для додаткових функцій із тривалим натисканням потрібна клавіша, яка вводить один символ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun basılan ekstralar, tek bir karakter yazan bir tuşa ihtiyaç duyar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doplňky pro dlouhé stisknutí potřebují klávesu, která zadá jeden znak."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Doplnky na dlhé stlačenie potrebujú kláves, ktorý napíše jeden znak."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πρόσθετα με παρατεταμένο πάτημα χρειάζονται ένα πλήκτρο που πληκτρολογεί έναν χαρακτήρα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
