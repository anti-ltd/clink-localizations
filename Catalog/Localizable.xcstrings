    "Every page opens on the settings most people want and keeps the rest folded away.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke bladsy maak oop op die instellings wat die meeste mense wil hê en hou die res weggevou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Seite startet mit dem, was die meisten brauchen, und hält den Rest eingeklappt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada página se abre con los ajustes que quiere casi todo el mundo y guarda el resto plegado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga leht avaneb seadistustega, mida enamik tahab, ja hoiab ülejäänu kokku voldituna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque page s'ouvre sur les réglages que veulent la plupart des gens et garde le reste replié."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden oldal azzal nyit, amit a legtöbben keresnek, a többit pedig összecsukva tartja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni pagina si apre sulle impostazioni che vuole la maggior parte delle persone e tiene il resto ripiegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ページは多くの人が使う設定で開き、それ以外は畳んだままにしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 페이지는 대부분이 쓰는 설정으로 열리고, 나머지는 접어 둡니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap halaman dibuka dengan tetapan yang dimahukan kebanyakan orang dan menyimpan selebihnya dalam lipatan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada página abre com as definições que quase toda a gente quer e mantém o resto dobrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая страница открывается на настройках, нужных большинству, а остальные держит свёрнутыми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个页面都从大多数人要用的设置开始，其余的先收起来。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare pagină se deschide cu setările pe care le doresc majoritatea oamenilor și păstrează restul pliat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke pagina wordt geopend met de instellingen die de meeste mensen willen en houdt de rest weggeklapt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個頁面都從大多數人要用的設定開始，其餘的先收起來。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda strona otwiera się z ustawieniami, których oczekuje większość ludzi, a reszta pozostaje złożona."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна сторінка відкривається з налаштуваннями, які потрібні більшості людей, а решта залишаються згорнутими."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sayfa çoğu insanın istediği ayarlarda açılır ve geri kalanı katlanmış halde kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá stránka se otevře s nastavením, které si většina lidí přeje, a zbytek zůstane složený."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá stránka sa otvorí s nastaveniami, ktoré si väčšina ľudí želá, a zvyšok ponechá zložený."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε σελίδα ανοίγει στις ρυθμίσεις που θέλουν οι περισσότεροι και κρατά τις υπόλοιπες διπλωμένες."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje sida öppnas med de inställningar som de flesta vill ha och håller resten borta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver side åbner på de indstillinger, de fleste ønsker, og holder resten foldet væk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver side åpnes på innstillingene de fleste vil ha og holder resten foldet bort."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen sivu avautuu useimpien ihmisten haluamilla asetuksilla ja pitää loput taitettuna."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap halaman terbuka pada pengaturan yang diinginkan kebanyakan orang dan membiarkan sisanya tetap terlipat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi trang sẽ mở ra theo cài đặt mà hầu hết mọi người mong muốn và giữ phần còn lại ở dạng gấp."
          }
        }
      }
    },
    "Every preset theme, layout and sound stays free too. The tools, custom looks, and custom themes and layouts need a membership.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke voorafingestelde tema, uitleg en klank bly ook gratis. Die gereedskap, pasgemaakte voorkoms en pasgemaakte temas en uitlegte het 'n lidmaatskap nodig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch jedes Design, Layout und jeder Sound aus den Presets bleibt kostenlos. Die Tools, eigene Looks sowie eigene Designs und Layouts erfordern eine Mitgliedschaft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los temas, diseños y sonidos predefinidos también siguen siendo gratis. Las herramientas, los looks personalizados y los temas y diseños personalizados requieren una suscripción."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik eelseadistatud teemad, paigutused ja helid on samuti tasuta. Tööriistad, kohandatud välimused ning kohandatud teemad ja paigutused nõuavad liikmelisust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les thèmes, dispositions et sons prédéfinis restent gratuits. Les outils, les looks personnalisés et les thèmes et dispositions personnalisés nécessitent un abonnement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden beépített téma, elrendezés és hang ingyenes marad. Az eszközök, az egyedi megjelenések, valamint az egyedi témák és elrendezések előfizetést igényelnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche tutti i temi, i layout e i suoni predefiniti restano gratuiti. Gli strumenti, gli stili personalizzati e i temi e layout personalizzati richiedono un abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットのテーマ、レイアウト、サウンドもすべて無料のままです。ツール、カスタムルック、カスタムテーマ・レイアウトにはメンバーシップが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리셋 테마, 레이아웃, 사운드도 모두 무료로 유지됩니다. 도구, 맞춤 스타일, 맞춤 테마와 레이아웃은 멤버십이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua tema, susun atur dan bunyi pratetap juga kekal percuma. Alatan, rupa tersuai serta tema dan susun atur tersuai memerlukan keahlian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os temas, layouts e sons predefinidos também continuam gratuitos. As ferramentas, os visuais personalizados e os temas e layouts personalizados exigem uma assinatura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все готовые темы, раскладки и звуки тоже остаются бесплатными. Инструменты, свои стили, свои темы и раскладки требуют членства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有预设主题、布局和声音也保持免费。工具、自定义外观以及自定义主题和布局需要会员资格。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare temă, aspect și sunet presetat rămân de asemenea libere. Instrumentele, aspectul personalizat și temele și machetele personalizate necesită abonament."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk vooraf ingesteld thema, lay-out en geluid blijft ook gratis. Voor de tools, het aangepaste uiterlijk en de aangepaste thema's en lay-outs is een lidmaatschap vereist."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有預設主題、佈局和聲音也保持免費。工具、自定義外觀以及自定義主題和佈局需要會員資格。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy wstępnie ustawiony motyw, układ i dźwięk również pozostają bezpłatne. Narzędzia, niestandardowy wygląd oraz niestandardowe motywy i układy wymagają członkostwa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна попередньо встановлена тема, макет і звук також залишаються безкоштовними. Інструменти, користувацький вигляд, користувацькі теми та макети потребують членства."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceden ayarlanmış her tema, düzen ve ses de ücretsiz kalır. Araçlar, özel görünümler, özel temalar ve düzenler üyeliğe ihtiyaç duyar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý přednastavený motiv, rozvržení a zvuk zůstává také zdarma. Nástroje, vlastní vzhled a vlastní motivy a rozvržení vyžadují členství."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá prednastavená téma, rozloženie a zvuk zostane tiež zadarmo. Nástroje, vlastný vzhľad a vlastné motívy a rozloženia vyžadujú členstvo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε προκαθορισμένο θέμα, διάταξη και ήχος παραμένει επίσης δωρεάν. Τα εργαλεία, οι προσαρμοσμένες εμφανίσεις και τα προσαρμοσμένα θέματα και διατάξεις χρειάζονται συνδρομή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje förinställt tema, layout och ljud förblir gratis. Verktygen, anpassade utseenden och anpassade teman och layouter behöver ett medlemskap."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert forudindstillet tema, layout og lyd forbliver også gratis. Værktøjerne, det tilpassede udseende og de tilpassede temaer og layouts kræver et medlemskab."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert forhåndsinnstilte tema, layout og lyd forblir også gratis. Verktøyene, tilpasset utseende og tilpassede temaer og oppsett trenger et medlemskap."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen esiasetettu teema, asettelu ja ääni pysyvät myös ilmaisina. Työkalut, mukautetut ulkoasut ja mukautetut teemat ja asettelut vaativat jäsenyyden."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap tema preset, tata letak, dan suara juga tetap gratis. Alat, tampilan khusus, serta tema dan tata letak khusus memerlukan keanggotaan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi chủ đề, bố cục và âm thanh cài sẵn đều miễn phí. Các công cụ, giao diện tùy chỉnh cũng như chủ đề và bố cục tùy chỉnh cần có tư cách thành viên."
          }
        }
      }
    },
    "Every reaction is optional. They run on press or appearance only, so the keyboard stays fast.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke reaksie is opsioneel. Hulle werk slegs op druk of voorkoms, so die sleutelbord bly vinnig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Reaktion ist optional. Sie laufen nur beim Drücken oder Einblenden, damit die Tastatur schnell bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada reacción es opcional. Solo se ejecutan al pulsar o al aparecer, así que el teclado sigue yendo rápido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga reaktsioon on valikuline. Need töötavad ainult vajutusel või ilmumisel, nii et klaviatuur jääb kiireks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque réaction est facultative. Elles ne tournent qu'à l'appui ou à l'apparition, comme ça le clavier reste rapide."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden reakció opcionális. Csak megnyomáskor vagy megjelenéskor futnak, így a billentyűzet gyors marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni reazione è facoltativa. Partono solo alla pressione o alla comparsa, così la tastiera resta veloce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反応はどれもお好みです。押したときや表示されたときだけ動くので、キーボードは速いままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반응은 모두 선택이에요. 누르거나 나타날 때만 돌아서 키보드가 계속 빨라요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap reaksi bersifat pilihan. Ia jalan semasa ditekan atau muncul sahaja, jadi papan kekunci kekal pantas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada reação é opcional. Só correm ao premires ou ao aparecerem, por isso o teclado mantém-se rápido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все реакции необязательны. Они срабатывают только при нажатии или появлении, поэтому клавиатура остаётся быстрой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每种反应都是可选的。它们只在按下或出现时运行，所以键盘一直很快。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare reacție este opțională. Acestea rulează numai la apăsare sau la apariție, astfel încât tastatura rămâne rapidă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke reactie is optioneel. Ze werken alleen op druk of uiterlijk, dus het toetsenbord blijft snel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每種反應都是可選的。它們只在按下或出現時執行，所以鍵盤一直很快。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda reakcja jest opcjonalna. Działają tylko po naciśnięciu lub pojawieniu się, więc klawiatura pozostaje szybka."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна реакція необов'язкова. Вони працюють лише при натисканні або зовнішньому вигляді, тому клавіатура залишається швидкою."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her reaksiyon isteğe bağlıdır. Yalnızca basında veya görünümde çalışırlar, böylece klavye hızlı kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá reakce je volitelná. Běží pouze na stisk nebo vzhled, takže klávesnice zůstává rychlá."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá reakcia je voliteľná. Fungujú iba na stlačenie alebo vzhľad, takže klávesnica zostáva rýchla."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε αντίδραση είναι προαιρετική. Λειτουργούν μόνο με το πάτημα ή την εμφάνιση, έτσι το πληκτρολόγιο παραμένει γρήγορο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje reaktion är valfri. De körs endast på tryck eller utseende, så tangentbordet förblir snabbt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver reaktion er valgfri. De kører kun på tryk eller udseende, så tastaturet forbliver hurtigt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver reaksjon er valgfri. De kjører kun på trykk eller utseende, så tastaturet holder seg raskt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen reaktio on valinnainen. Ne toimivat vain painalluksella tai ulkonäöllä, joten näppäimistö pysyy nopeana."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap reaksi adalah opsional. Mereka berjalan saat ditekan atau ditampilkan saja, sehingga keyboard tetap cepat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi phản ứng đều là tùy chọn. Chúng chỉ chạy khi nhấn hoặc hiển thị, vì vậy bàn phím luôn hoạt động nhanh."
          }
        }
      }
    },
    "Every sample learned for this layout & language is discarded. Other profiles keep theirs.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke monster wat vir hierdie uitleg en taal geleer word, word weggegooi. Ander profiele behou hulle s'n."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle für dieses Layout & diese Sprache gelernten Beispiele werden verworfen. Andere Profile behalten ihre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descartan todas las muestras aprendidas para esta distribución e idioma. Otros perfiles conservan las suyas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga selle paigutuse ja keele jaoks õpitud näidis hüljatakse. Teised profiilid peavad omad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les échantillons appris pour cette disposition et cette langue sont supprimés. Les autres profils gardent les leurs."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ehhez a kiosztáshoz és nyelvhez tanult minden minta törlődik. A többi profil megtartja a sajátját."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i campioni appresi per questo layout e questa lingua vengono eliminati. Gli altri profili mantengono i propri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレイアウトと言語で学習したサンプルはすべて破棄されます。他のプロファイルのものはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 레이아웃과 언어로 학습한 샘플이 모두 사라져요. 다른 프로필의 학습 내용은 그대로 남아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua sampel yang dipelajari untuk susun atur & bahasa ini dibuang. Profil lain kekalkan sampel mereka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as amostras aprendidas para este esquema e idioma são descartadas. Os outros perfis mantêm as deles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все образцы, выученные для этой раскладки и языка, будут отброшены. У других профилей свои остаются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "针对这个布局和语言学到的所有样本都会被清空。其他配置文件的学习内容不受影响。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare probă învățată pentru acest aspect și limbă este eliminată. Alte profiluri le păstrează pe ale lor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk voorbeeld dat voor deze lay-out en taal is geleerd, wordt weggegooid. Andere profielen behouden die van hen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "針對這個佈局和語言學到的所有樣本都會被清空。其他配置檔案的學習內容不受影響。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda próbka nauczona dla tego układu i języka jest odrzucana. Inne profile zachowują swoje."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен вивчений зразок для цього макета та мови відкидається. Інші профілі зберігають свої."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu düzen ve dil için öğrenilen her örnek atılır. Diğer profiller kendilerininkini korur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý vzorek naučený pro toto rozvržení a jazyk je vyřazen. Ostatní profily si ponechávají své."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá vzorka naučená pre toto rozloženie a jazyk sa zahodí. Ostatné profily si ponechávajú svoje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε δείγμα που μαθαίνεται για αυτήν τη διάταξη και τη γλώσσα απορρίπτεται. Άλλα προφίλ διατηρούν τα δικά τους."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje prov som lärts för denna layout och språk kasseras. Andra profiler behåller sina."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver prøve lært til dette layout og sprog kasseres. Andre profiler beholder deres."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver prøve som er lært for denne layouten og språket blir forkastet. Andre profiler beholder sine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen tälle asettelulle ja kielelle opittu näyte hylätään. Muut profiilit pitävät omansa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap sampel yang dipelajari untuk tata letak & bahasa ini akan dibuang. Profil lain tetap menggunakan profilnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi mẫu đã học về bố cục và ngôn ngữ này đều bị loại bỏ. Các hồ sơ khác giữ nguyên của họ."
          }
        }
      }
    },
