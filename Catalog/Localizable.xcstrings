    "Swipe a clip and tap the pin to keep it, while the rest ages out.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiep 'n skeersel en tik op die pen om dit te hou, terwyl die res verouder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wisch über einen Eintrag und tipp auf die Nadel, damit er bleibt, während der Rest altert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza un elemento y toca el pin para conservarlo mientras el resto caduca."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viipa klipi üle ja puuduta nõela, et see hoida, samal ajal kui ülejäänud aeguvad välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaie un élément et touche l'épingle pour le garder pendant que le reste s'efface avec le temps."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd el az elemet, és koppints a gombostűre, hogy megmaradjon, míg a többi idővel kikopik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri un elemento e tocca la puntina per tenerlo, mentre il resto scade col tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目をスワイプしてピンをタップすると、その項目だけ残り、ほかは古いものから消えていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 쓸어 핀을 누르면 그 항목만 남고, 나머지는 오래된 순으로 사라집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret satu item dan ketik pin untuk mengekalkannya, sementara yang lain luput mengikut masa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza um item e toca no pino para o manteres, enquanto os outros vão saindo com o tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните фрагмент и нажмите на булавку, чтобы оставить его, пока остальные устаревают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把某条划开、点一下图钉就能留住它，其余的会随时间被挤掉。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisați un clip și atingeți știftul pentru a-l păstra, în timp ce restul îmbătrânește."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg over een fragment en tik op de pin om het te behouden, terwijl de rest veroudert."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把某條劃開、點一下圖釘就能留住它，其餘的會隨時間被擠掉。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń klip i dotknij pinezki, aby go zachować, podczas gdy reszta się zestarzeje."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведіть пальцем по кліпу та торкніться шпильки, щоб зберегти його, а решта старіє."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir klibi kaydırın ve geri kalanı eskidikçe onu tutmak için raptiyeye dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejeďte klip a klepněte na špendlík, abyste jej udrželi, zatímco zbytek stárne."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnite klip a ťuknite na špendlík, aby ste ho udržali, kým zvyšok zostarne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε ένα κλιπ και πατήστε την καρφίτσα για να το κρατήσετε, ενώ τα υπόλοιπα γερνούν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep ett klipp och tryck på nålen för att behålla det medan resten åldras."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stryg et klip, og tryk på knappenålen for at beholde det, mens resten ældes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip et klipp og trykk på pinnen for å beholde det, mens resten eldes ut."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhkäise klippiä ja napauta nastaa säilyttääksesi sen, kun loput vanhenevat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesek klip dan ketuk pin untuk menyimpannya, sementara sisanya akan habis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt một clip và nhấn vào ghim để giữ nó trong khi phần còn lại sẽ cũ đi."
          }
        }
      }
    },
    "Swipe a saved note right to pin it in Cling. Requires Full Access.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiep 'n gestoorde nota regs om dit in Cling vas te pen. Vereis volle toegang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische eine gespeicherte Notiz nach rechts, um sie in Cling anzupinnen. Erfordert Vollzugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza una nota guardada a la derecha para fijarla en Cling. Requiere acceso completo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viipa salvestatud märge paremale, et see Clingis kinnitada. Vajab täisjuurdepääsu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaie une note enregistrée vers la droite pour l’épingler dans Cling. Nécessite l’accès complet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd jobbra a mentett jegyzetet, hogy rögzítsd a Clingben. Teljes hozzáférés szükséges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri una nota salvata verso destra per fissarla in Cling. Richiede l'accesso completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したメモを右にスワイプすると Cling にピン留めされます。フルアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 메모를 오른쪽으로 밀면 Cling에 고정됩니다. 전체 접근 권한이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret nota tersimpan ke kanan untuk menyematnya dalam Cling. Memerlukan Akses Penuh."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize uma nota guardada para a direita para a fixar no Cling. Requer acesso total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните сохранённую заметку вправо, чтобы закрепить её в Cling. Нужен полный доступ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向右滑动已保存的备忘，即可固定到 Cling。需要完全访问权限。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisați spre dreapta o notă salvată pentru a o fixa în Cling. Necesită acces complet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg een opgeslagen notitie naar rechts om deze vast te zetten in Cling. Vereist volledige toegang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向右滑動已儲存的備忘，即可固定到 Cling。需要完整取用許可權。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń zapisaną notatkę w prawo, aby przypiąć ją w Cling. Wymaga pełnego dostępu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведіть збережену нотатку праворуч, щоб закріпити її в Cling. Потрібен повний доступ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmiş bir notu Cling'e sabitlemek için sağa kaydırın. Tam Erişim gerektirir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejetím prstem doprava uloženou poznámku připnete v Cling. Vyžaduje úplný přístup."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnutím prstom doprava uloženú poznámku ju pripnete v Cling. Vyžaduje úplný prístup."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε μια αποθηκευμένη σημείωση προς τα δεξιά για να την καρφιτσώσετε στο Cling. Απαιτεί πλήρη πρόσβαση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep en sparad anteckning åt höger för att fästa den i Cling. Kräver full åtkomst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stryg en gemt note til højre for at fastgøre den i Cling. Kræver fuld adgang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip et lagret notat til høyre for å feste det i Cling. Krever full tilgang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhkäise tallennettu muistiinpano oikealle kiinnittääksesi sen Cling:ään. Vaatii täyden pääsyn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesek catatan yang disimpan ke kanan untuk menyematkannya di Cling. Membutuhkan Akses Penuh."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt ghi chú đã lưu sang phải để ghim vào Cling. Yêu cầu quyền truy cập đầy đủ."
          }
        }
      }
    },
    "Swipe a text clip right to pin it as a note in Cling. Requires Full Access.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiep 'n tekssnit regs om dit as 'n nota in Cling vas te pen. Vereis volle toegang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische einen Textschnipsel nach rechts, um ihn als Notiz in Cling anzupinnen. Erfordert Vollzugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza un fragmento de texto a la derecha para guardarlo como nota en Cling. Requiere acceso completo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viipa tekstiklipp paremale, et see Clingis märkmena kinnitada. Vajab täisjuurdepääsu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaie un extrait de texte vers la droite pour l’épingler comme note dans Cling. Nécessite l’accès complet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd jobbra a szövegrészletet, hogy jegyzetként rögzítsd a Clingben. Teljes hozzáférés szükséges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri un testo copiato verso destra per salvarlo come nota in Cling. Richiede l'accesso completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストのクリップを右にスワイプすると Cling にメモとしてピン留めされます。フルアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 클립을 오른쪽으로 밀면 Cling에 메모로 고정됩니다. 전체 접근 권한이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret klip teks ke kanan untuk menyematnya sebagai nota dalam Cling. Memerlukan Akses Penuh."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize um excerto de texto para a direita para o fixar como nota no Cling. Requer acesso total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните текстовый фрагмент вправо, чтобы закрепить его заметкой в Cling. Нужен полный доступ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
