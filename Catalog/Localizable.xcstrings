    "Nothing drifts behind the keys until Animate is on.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Niks dryf agter die sleutels totdat Animate aan is nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinter den Tasten bewegt sich nichts, solange „Animieren“ aus ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada se mueve detrás de las teclas mientras «Animar» esté desactivado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvide taga ei triibi midagi, enne kui Animeeri on sees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne bouge derrière les touches tant qu’« Animer » est désactivé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amíg az Animálás ki van kapcsolva, semmi sem mozog a billentyűk mögött."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dietro i tasti non si muove nulla finché «Anima» è disattivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アニメーション」をオンにするまで、キーの後ろでは何も動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘애니메이션’을 켜기 전까지는 키 뒤에서 아무것도 움직이지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa bergerak di belakang kekunci selagi Animasi dimatikan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada se move por trás das teclas enquanto a opção Animar estiver desligada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока «Анимация» выключена, за клавишами ничего не движется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不开启「动画」，按键后方就什么都不会动。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nu se deplasează în spatele tastelor până când Animate este pornit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er drijft niets achter de toetsen totdat Animate is ingeschakeld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不開啟「動畫」，按鍵後方就什麼都不會動。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie dryfuje za klawiszami, dopóki program Animate nie zostanie włączony."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніщо не рухається за клавішами, доки не ввімкнено Animate."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Animate açılana kadar tuşların arkasında hiçbir şey sürüklenmez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokud není Animate zapnuté, nic se za klávesami nehýbe."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kým nie je zapnutá funkcia Animate, za klávesmi sa nič neunáša."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα δεν παρασύρεται πίσω από τα πλήκτρα μέχρι να ενεργοποιηθεί το Animate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget driver bakom tangenterna förrän Animate är på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet driver bag tasterne, før Animate er slået til."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting driver bak tastene før Animate er på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään ei ajaudu näppäinten taakse ennen kuin Animate on päällä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang tertinggal di belakang tombol hingga Animate aktif."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì trôi ra sau các phím cho đến khi Animate được bật."
          }
        }
      }
    },
