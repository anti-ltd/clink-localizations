    "Install Cling and open it once, then your saved things show up here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Cling und öffne es einmal, danach erscheint hier, was du gespeichert hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala Cling y ábrelo una vez; entonces lo que hayas guardado aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe Cling et ouvre-le une fois : tes éléments enregistrés apparaîtront ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Telepítsd a Clinget, és nyisd meg egyszer, utána itt jelenik meg, amit elmentettél."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa Cling e aprilo una volta: quello che hai salvato comparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling をインストールして一度開くと、保存したものがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling을 설치하고 한 번 열면 저장한 것이 여기에 나타납니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang Cling dan buka sekali, kemudian simpanan anda muncul di sini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o Cling e abra-o uma vez; depois o que guardou aparece aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите Cling и откройте его один раз — сохранённое появится здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 Cling 并打开一次，你保存的内容就会出现在这里。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paigalda Cling ja ava see üks kord, siis ilmuvad sinu salvestatud asjad siia."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Installeer Cling en maak dit een keer oop, dan verskyn jou gestoorde goed hier."
          }
        }
      }
    },
    "Install Cling and your saved things show up in the keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Cling, und was du gespeichert hast, erscheint in der Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala Cling y lo que guardes aparecerá en el teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe Cling et tes éléments enregistrés apparaîtront dans le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Telepítsd a Clinget, és amit elmentettél, megjelenik a billentyűzeten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa Cling e quello che hai salvato comparirà nella tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling をインストールすると、保存したものがキーボードに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling을 설치하면 저장한 것이 키보드에 나타납니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang Cling dan simpanan anda muncul dalam papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o Cling e o que guardar aparece no teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите Cling — и сохранённое появится на клавиатуре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 Cling，你保存的内容就会出现在键盘里。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paigalda Cling ja sinu salvestatud asjad ilmuvad klaviatuurile."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Installeer Cling en jou gestoorde goed verskyn in die sleutelbord."
          }
        }
      }
    },
