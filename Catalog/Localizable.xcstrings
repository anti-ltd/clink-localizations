    "Delete any of it from there. The copy on this device stays.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vee enige daarvan van daar af uit. Die kopie op hierdie toestel bly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dort kannst du alles löschen. Die Kopie auf diesem Gerät bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde ahí puedes borrar lo que quieras. La copia de este dispositivo se queda."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustuta sealt mis tahes. Selle seadme koopia jääb alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux tout supprimer depuis là. La copie sur cet appareil reste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Onnan bármit törölhetsz. Az ezen az eszközön lévő másolat megmarad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da lì puoi eliminare quello che vuoi. La copia su questo dispositivo resta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこから削除できます。この端末のコピーは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거기서 원하는 항목을 삭제할 수 있습니다. 이 기기의 사본은 그대로 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh memadam mana-mana daripadanya di situ. Salinan pada peranti ini kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir daí podes apagar o que quiseres. A cópia neste dispositivo fica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляйте оттуда что угодно. Копия на этом устройстве останется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可从那里删除其中任何内容。这台设备上的副本会保留。"
          }
        }
      }
    },
