    "Your keyboard is exactly as it shipped. Anything you change turns up here, so you can find it again or put it back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tastatur ist genau so, wie sie ausgeliefert wurde. Alles, was du änderst, taucht hier auf, damit du es wiederfindest oder zurückstellst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teclado está tal como vino. Todo lo que cambies aparecerá aquí, para que puedas encontrarlo o dejarlo como estaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton clavier est exactement dans son état d’origine. Tout ce que tu modifies apparaît ici, pour le retrouver ou le remettre comme avant."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzeted pontosan olyan, amilyen érkezett. Amit megváltoztatsz, itt bukkan fel, hogy visszataláld vagy visszaállítsd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua tastiera è esattamente com’era all’inizio. Tutto ciò che cambi compare qui, così lo ritrovi o lo rimetti com’era."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードは出荷時のままです。変更したものはここに並ぶので、あとから見つけたり元に戻したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 처음 상태 그대로입니다. 무엇이든 바꾸면 여기에 나타나므로 다시 찾거나 되돌릴 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci anda betul-betul seperti asal. Apa sahaja yang anda ubah akan muncul di sini, supaya anda boleh menjumpainya semula atau mengembalikannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu teclado está tal como veio. Tudo o que mudares aparece aqui, para o encontrares outra vez ou o pores como estava."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша клавиатура ровно такая, какой вышла из коробки. Всё, что вы измените, появится здесь — чтобы найти это снова или вернуть обратно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的键盘和出厂时一模一样。你改动的任何设置都会出现在这里，方便你再找到它或还原。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu klaviatuur on täpselt väljalaskeolekus. Kõik, mida muudad, ilmub siia, et saaksid selle üles leida või tagasi panna."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou sleutelbord is presies soos dit verskeep is. Enigiets wat jy verander, verskyn hier, sodat jy dit weer kan vind of terugsit."
          }
        }
      }
    },
