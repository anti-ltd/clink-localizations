          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați comutatorul de profil și puteți schimba profilurile de pe tastatură."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel de profielschakelaar in en u kunt profielen wisselen vanaf het toetsenbord zelf."
