    "Text FX restyles the word you're on. The styled text works in any app.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text-FX gestaltet das aktuelle Wort um. Der gestaltete Text funktioniert in jeder App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FX de texto cambia el estilo de la palabra en la que estás. El texto con estilo funciona en cualquier app."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksti-FX muudab kursori juures oleva sõna stiili. Kujundatud tekst toimib igas rakenduses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FX de texte change le style du mot en cours. Le texte ainsi mis en forme fonctionne dans toutes les apps."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Szöveg FX átformázza az aktuális szót. A formázott szöveg bármelyik appban használható."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FX testo cambia lo stile della parola su cui ti trovi. Il testo formattato funziona in qualsiasi app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストFXは、カーソル位置にある単語の見た目を変えます。変換した文字はどのアプリでも使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 FX는 커서가 있는 단어의 스타일을 바꿉니다. 스타일을 적용한 텍스트는 어떤 앱에서든 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "FX Teks mengubah gaya perkataan semasa. Teks bergaya itu boleh digunakan dalam mana-mana app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "FX de texto muda o estilo da palavra em que estás. O texto com estilo funciona em qualquer app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текстовые эффекты меняют оформление текущего слова. Такой текст можно использовать в любом приложении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字特效会改变光标所在单词的样式。处理后的文字可在任何 App 中使用。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Text FX redă stilul cuvântului în care vă aflați. Textul stilizat funcționează în orice aplicație."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Text FX verandert het woord waarop u zich bevindt. De opgemaakte tekst werkt in elke app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字特效會改變游標所在單詞的樣式。處理後的文字可在任何 App 中使用。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Text FX verander die styl van die woord waarop jy tans is. Die gestileerde teks werk in enige toepassing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Efekty tekstowe zmieniają styl słowa, na którym się znajdujesz. Stylizowany tekst działa w dowolnej aplikacji."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Text FX змінює стиль слова, яке ви використовуєте. Стилізований текст працює в будь-якій програмі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Text FX, üzerinde bulunduğunuz kelimeyi yeniden şekillendirir. Stillendirilmiş metin herhangi bir uygulamada çalışır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text FX změní styl slova, které právě používáte. Stylizovaný text funguje v jakékoli aplikaci."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Text FX zmení štýl slova, ktoré práve používate. Štylizovaný text funguje v akejkoľvek aplikácii."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Text FX επαναφέρει το στυλ της λέξης που χρησιμοποιείτε. Το στυλιζαρισμένο κείμενο λειτουργεί σε οποιαδήποτε εφαρμογή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Text FX stilar om ordet du använder. Den formaterade texten fungerar i alla appar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst FX omstiler det ord, du er på. Den stylede tekst fungerer i enhver app."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst FX omstiler ordet du er på. Den stilede teksten fungerer i alle apper."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Text FX muotoilee käyttämäsi sanan uudelleen. Tyylitelty teksti toimii missä tahansa sovelluksessa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Text FX mengubah gaya kata yang Anda gunakan. Teks yang ditata berfungsi di aplikasi apa pun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Text FX sẽ thiết kế lại từ bạn đang sử dụng. Văn bản được tạo kiểu hoạt động trong mọi ứng dụng."
          }
        }
      }
    },
