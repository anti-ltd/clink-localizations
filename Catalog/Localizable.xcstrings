            "state": "translated",
            "value": "Outputtet indsættes ved markøren og beholder inputtet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utgangen settes inn ved markøren, og beholder inngangen."
          }
        },
        "fi": {
          "stringUnit": {
