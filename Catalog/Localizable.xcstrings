    "Everything stays on this device. This clears the copies in iCloud and turns sync off.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bly op hierdie toestel. Dit maak die kopieë in iCloud skoon en skakel sinkronisering af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf diesem Gerät. Das hier löscht die Kopien in iCloud und schaltet die Synchronisierung aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en este dispositivo. Esto borra las copias de iCloud y desactiva la sincronización."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik jääb sellesse seadmesse. See tühjendab koopiad iCloudist ja lülitab sünkroonimise välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur cet appareil. Cette action efface les copies dans iCloud et désactive la synchronisation."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden ezen az eszközön marad. Ez az iCloudban lévő másolatokat törli, és kikapcsolja a szinkronizálást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta su questo dispositivo. Questa azione cancella le copie su iCloud e disattiva la sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてこの端末に残ります。iCloud上のコピーを削除し、同期をオフにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 이 기기에 그대로 남습니다. iCloud에 있는 사본을 지우고 동기화를 끕니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya kekal pada peranti ini. Tindakan ini memadam salinan dalam iCloud dan mematikan penyegerakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica neste dispositivo. Isto apaga as cópias no iCloud e desliga a sincronização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё остаётся на этом устройстве. Это удалит копии в iCloud и выключит синхронизацию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容都会保留在这台设备上。此操作会清除 iCloud 中的副本并关闭同步。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Totul rămâne pe acest dispozitiv. Aceasta șterge copiile din iCloud și dezactivează sincronizarea."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles blijft op dit apparaat. Hierdoor worden de kopieën in iCloud gewist en wordt de synchronisatie uitgeschakeld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有內容都會保留在這臺裝置上。此操作會清除 iCloud 中的副本並關閉同步。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko pozostaje na tym urządzeniu. Spowoduje to usunięcie kopii w iCloud i wyłączenie synchronizacji."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе залишається на цьому пристрої. Це очищає копії в iCloud і вимикає синхронізацію."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey bu cihazda kalır. Bu, iCloud'teki kopyaları temizler ve senkronizasyonu kapatır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše zůstává na tomto zařízení. Tím vymažete kopie v iCloud a vypnete synchronizaci."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko zostáva na tomto zariadení. Tým sa vymažú kópie v iCloud a vypne sa synchronizácia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα παραμένουν σε αυτή τη συσκευή. Αυτό διαγράφει τα αντίγραφα στο iCloud και απενεργοποιεί τον συγχρονισμό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt finns kvar på den här enheten. Detta rensar kopiorna i iCloud och stänger av synkroniseringen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt forbliver på denne enhed. Dette rydder kopierne i iCloud og slår synkronisering fra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt forblir på denne enheten. Dette sletter kopiene i iCloud og slår synkronisering av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki jää tälle laitteelle. Tämä tyhjentää iCloud:n kopiot ja poistaa synkronoinnin käytöstä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya tetap ada di perangkat ini. Ini menghapus salinan di iCloud dan mematikan sinkronisasi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ vẫn còn trên thiết bị này. Thao tác này sẽ xóa các bản sao trong iCloud và tắt đồng bộ hóa."
          }
        }
      }
    },
