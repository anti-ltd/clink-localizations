    "Correctly punctuate what I say and make it more formal.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken reg wat ek sê en maak dit meer formeel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz meine Zeichensetzung richtig und formuliere es förmlicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntúa bien lo que digo y hazlo más formal."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pane kirjavahemärgid õigesti ja tee see ametlikumaks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponctue correctement ce que je dis et rends-le plus formel."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tedd helyesen a központozást, és fogalmazd hivatalosabbra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punteggia bene quello che dico e rendilo più formale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容に正しく句読点をつけて、より丁寧な表現にして。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 말한 내용에 문장부호를 제대로 넣고 더 격식 있게 다듬어 줘."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Letak tanda baca yang betul pada apa yang saya sebut dan jadikan lebih formal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontua bem o que digo e torna-o mais formal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расставить знаки препинания и сделать сказанное более официальным."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把我说的正确加上标点，并写得更正式。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Punctează corect ceea ce spun și fă-l mai formal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderstreep wat ik zeg correct en maak het formeler."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把我說的正確加上標點，並寫得更正式。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawidłowo akcentuj to, co mówię i nadaj mu bardziej formalny charakter."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правильно розставте розділові знаки в моїх словах і зробіть це більш офіційним."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Söylediklerimi doğru şekilde noktalayın ve daha resmi hale getirin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Správně interpunkci, co říkám, a udělejte to formálnějším."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Správne napíšte, čo hovorím, a urobte to formálnejším."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σημειώστε σωστά αυτό που λέω και κάντε το πιο επίσημο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in det jag säger korrekt och gör det mer formellt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt punktum i det, jeg siger, og gør det mere formelt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett inn det jeg sier riktig og gjør det mer formelt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välitä sanomani oikein ja tee siitä muodollisempi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri tanda baca dengan benar pada apa yang saya katakan dan buatlah menjadi lebih formal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chấm câu chính xác những gì tôi nói và làm cho nó trang trọng hơn."
          }
        }
      }
    },
