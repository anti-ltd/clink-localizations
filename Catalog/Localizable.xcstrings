    "Turns off the backdrop and animation, and clears the selected style.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel die agtergrond en animasie af en maak die geselekteerde styl skoon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet Hintergrund und Animation aus und entfernt den ausgewählten Stil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva el fondo y la animación, y borra el estilo seleccionado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülitab tausta ja animatsiooni välja ning tühjendab valitud stiili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive l'arrière-plan et l'animation, et efface le style sélectionné."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikapcsolja a hátteret és az animációt, és törli a kiválasztott stílust."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva lo sfondo e l'animazione e cancella lo stile selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景とアニメーションをオフにし、選択したスタイルをクリアします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경과 애니메이션을 끄고 선택한 스타일을 지웁니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mematikan latar belakang dan animasi, serta mengosongkan gaya yang dipilih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativa o fundo e a animação e limpa o estilo selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключает фон и анимацию и очищает выбранный стиль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭背景和动画，并清除所选样式。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivează fundalul și animația și șterge stilul selectat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakelt de achtergrond en animatie uit en wist de geselecteerde stijl."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉背景和動畫，並清除所選樣式。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącza tło i animację oraz czyści wybrany styl."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимикає фон і анімацію та очищає вибраний стиль."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka planı ve animasyonu kapatır ve seçilen stili temizler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypne pozadí a animaci a vymaže vybraný styl."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypne pozadie a animáciu a vymaže vybratý štýl."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιεί το φόντο και την κινούμενη εικόνα και διαγράφει το επιλεγμένο στυλ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stänger av bakgrunden och animeringen och rensar den valda stilen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiverer baggrunden og animationen og rydder den valgte stil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slår av bakteppet og animasjonen, og sletter den valgte stilen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kytkee taustan ja animaation pois päältä ja tyhjentää valitun tyylin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menonaktifkan latar belakang dan animasi, serta menghapus gaya yang dipilih."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt phông nền và hoạt ảnh, đồng thời xóa kiểu đã chọn."
          }
        }
      }
    },
    "Turns on the on-device smarts behind smarter suggestions and translation. Nothing works until you flip this.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel die slimfone op die toestel aan agter slimmer voorstelle en vertaling. Niks werk totdat jy dit omdraai nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet die Intelligenz auf dem Gerät ein, die hinter cleveren Vorschlägen und dem Übersetzen steckt. Nichts läuft, bevor du das anmachst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la inteligencia en el dispositivo que hay detrás de las sugerencias y la traducción más listas. Nada funciona hasta que actives esto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülitab sisse seadmesisesed nutikused nutikamate soovituste ja tõlke taga. Midagi ei tööta, enne kui sa seda lülitad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active l'intelligence sur l'appareil derrière des suggestions et une traduction plus malines. Rien ne marche tant que tu n'as pas activé ça."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolja az eszközön futó okos funkciókat, amik az okosabb javaslatok és a fordítás mögött állnak. Semmi sem működik, amíg ezt be nem kapcsolod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l'intelligenza sul dispositivo dietro suggerimenti e traduzione più intelligenti. Niente funziona finché non la attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よりスマートな候補や翻訳を支える、オンデバイスの知能をオンにします。これをオンにするまで何も動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 똑똑한 추천이랑 번역을 뒷받침하는 온디바이스 지능을 켜요. 이걸 켜기 전에는 아무것도 작동하지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghidupkan kepintaran atas-peranti di sebalik cadangan dan terjemahan yang lebih pintar. Tiada apa berfungsi sehingga anda menghidupkan ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga a inteligência no dispositivo por trás de sugestões e tradução mais espertas. Nada funciona até ligares isto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает работающий на устройстве интеллект, на котором держатся умные подсказки и перевод. Пока это выключено, ничего из них не работает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设备端的智能功能，更聪明的建议和翻译都靠它。不开的话这些都用不了。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează inteligența de pe dispozitiv din spatele sugestiilor și traducerilor mai inteligente. Nimic nu funcționează până nu întorci asta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakelt de slimme functies op het apparaat in achter slimmere suggesties en vertalingen. Niets werkt totdat je dit omdraait."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟裝置端的智慧功能，更聰明的建議和翻譯都靠它。不開的話這些都用不了。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącza na urządzeniu inteligentne sugestie i tłumaczenia. Nic nie działa, dopóki tego nie odwrócisz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вмикає інтелектуальну функцію на пристрої, що забезпечує розумніші пропозиції та переклад. Ніщо не працює, поки ви не перевернете це."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha akıllı öneriler ve çevirinin ardındaki cihazdaki akıllı özellikleri açar. Bunu çevirene kadar hiçbir şey işe yaramaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapne inteligentní návrhy a překlady na zařízení. Nic nefunguje, dokud to nepřeklopíte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapne inteligentné funkcie zariadenia na základe inteligentnejších návrhov a prekladov. Nič nefunguje, kým to neprevrátite."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιεί τα smarts στη συσκευή πίσω από πιο έξυπνες προτάσεις και μετάφραση. Τίποτα δεν λειτουργεί μέχρι να το αναστρέψετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slår på smartare på enheten bakom smartare förslag och översättning. Inget fungerar förrän du vänder på detta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tænder smarterne på enheden bag smartere forslag og oversættelse. Intet virker, før du vender dette."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slår på smartheten på enheten bak smartere forslag og oversettelse. Ingenting fungerer før du snur dette."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottaa käyttöön älykkäämpien ehdotusten ja käännösten takana olevat laitteet. Mikään ei toimi ennen kuin käännät tämän."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengaktifkan kecerdasan pada perangkat di balik saran dan terjemahan yang lebih cerdas. Tidak ada yang berhasil sampai Anda membaliknya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật tính năng thông minh trên thiết bị đằng sau các đề xuất và bản dịch thông minh hơn. Không có gì hoạt động cho đến khi bạn lật cái này."
          }
        }
      }
    },
    "Tweak the key size, the bounce, the sounds, the haptics. Or don't. It works great as-is.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas die sleutelgrootte, die weiering, die klanke, die haptika aan. Of moenie. Dit werk uitstekend soos dit is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell die Tastengröße, das Abprallen, die Töne, die Haptik ein. Oder lass es – es funktioniert auch so super."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el tamaño de las teclas, el rebote, los sonidos, la vibración. O no lo hagas: funciona genial tal cual."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Näpi klahvi suurust, põrget, helisid, haptikat. Või ära näpi. See töötab suurepäraselt nii nagu on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste la taille des touches, le rebond, les sons, le retour haptique. Ou pas — ça marche très bien tel quel."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítgasd a billentyűméretet, a pattanást, a hangokat, a rezgést. Vagy ne – így is remekül működik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola la dimensione dei tasti, il rimbalzo, i suoni, il feedback aptico. Oppure no — funziona benissimo così com'è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの大きさ、跳ね具合、サウンド、触覚フィードバックを調整できます。もちろんそのままでも十分に使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 크기, 바운스, 소리, 햅틱을 손봐요. 아니면 그냥 둬도 돼요 — 기본으로도 훌륭해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah suai saiz kekunci, lantunan, bunyi, haptik. Atau tidak — ia berfungsi hebat seadanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta o tamanho das teclas, o ressalto, os sons, a vibração. Ou não — funciona lindamente como está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подкрутите размер клавиш, отскок, звуки, тактильную отдачу. Или не подкручивайте — и так отлично работает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调调按键大小、回弹、声音、触感。不调也行——它开箱就很好用。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificați dimensiunea tastei, săritura, sunetele, hapticul. Sau nu. Funcționează grozav așa cum este."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de sleutelgrootte, de veerkracht, de geluiden en de haptiek aan. Of niet. Het werkt prima zoals het is."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調調按鍵大小、回彈、聲音、觸感。不調也行——它開箱就很好用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj rozmiar klawiszy, odbicie, dźwięki i wrażenia dotykowe. Albo nie. Działa świetnie, tak jak jest."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте розмір клавіш, відскок, звуки, тактильні відчуття. Або ні. Він чудово працює як є."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar boyutunu, sıçramayı, sesleri ve dokunsal özellikleri ayarlayın. Ya da yapma. Olduğu haliyle harika çalışıyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravte velikost klíče, odraz, zvuky, haptiku. Nebo ne. Funguje skvěle tak, jak je."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vylaďte veľkosť kľúča, odraz, zvuky, haptiku. Alebo nie. Funguje skvele tak ako je."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσαρμόστε το μέγεθος του κλειδιού, την αναπήδηση, τους ήχους, τα απτικά. Ή όχι. Λειτουργεί τέλεια ως έχει."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Justera nyckelstorleken, studsen, ljuden, haptiken. Eller inte. Det fungerar utmärkt som det är."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Juster nøglestørrelsen, hoppet, lydene, haptik. Eller lad være. Det fungerer fantastisk som det er."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Juster nøkkelstørrelsen, sprett, lydene, haptikken. Eller ikke. Den fungerer utmerket som den er."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säädä avaimen kokoa, pomppimista, ääniä ja haptiikkaa. Tai älä. Toimii loistavasti sellaisenaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan ukuran kunci, pantulan, suara, haptik. Atau tidak. Ini berfungsi dengan baik apa adanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinh chỉnh kích thước phím, độ nảy, âm thanh, độ rung. Hoặc không. Nó hoạt động tuyệt vời như hiện tại."
          }
        }
      }
    },
