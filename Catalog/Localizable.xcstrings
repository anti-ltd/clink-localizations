            "value": "Le son de chaque appui."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden gombnyomás hangja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suono di ogni tasto."
          }
        },
        "ja": {
          "stringUnit": {
