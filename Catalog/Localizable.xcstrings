        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca domyślny pakiet, głośność i strojenie. Twoje niestandardowe pakiety pozostają."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлює стандартний пакет, гучність і налаштування. Ваші спеціальні пакети залишаються."
          }
        },
        "tr": {
