            "state": "translated",
            "value": "O sinal que o atalho do espaço duplo escreve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знак, который ставит двойной пробел."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连按两次空格时输入的符号。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca pe care o scrie comanda rapidă cu spațiu dublu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het teken dat de snelkoppeling met dubbele spatie schrijft."
          }
        },
        "zh-Hant": {
          "stringUnit": {
