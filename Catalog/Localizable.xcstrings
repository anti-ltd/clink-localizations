    "%@ is a built-in layout. Make your own copy of it to add and edit keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is 'n ingeboude uitleg. Maak jou eie kopie daarvan om sleutels by te voeg en te wysig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ein festes Layout. Mach dir eine eigene Kopie, um Tasten hinzuzufügen und zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es una distribución integrada. Haz tu propia copia para añadir y editar teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on sisseehitatud paigutus. Tee sellest oma koopia, et lisada ja muuta klahve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est une disposition intégrée. Fais-en une copie pour ajouter et modifier des touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ egy beépített elrendezés. Csinálj róla saját másolatot, ha billentyűket akarsz hozzáadni vagy szerkeszteni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è un layout integrato. Fanne una tua copia per aggiungere e modificare i tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は最初から入っているレイアウトです。キーを追加したり編集したりするには、コピーを作ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 은(는) 기본 레이아웃이에요. 키를 추가하거나 고치려면 복사본을 만들어서 쓰세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ialah susun atur siap sedia. Buat salinan anda sendiri untuk tambah dan ubah kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é um esquema integrado. Faz uma cópia tua para adicionares e editares teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — встроенная раскладка. Сделайте свою копию, чтобы добавлять и менять клавиши."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是内置布局。复制一份，就能加键和改键了。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ este un aspect încorporat. Faceți propria copie a acestuia pentru a adăuga și edita chei."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is een ingebouwde lay-out. Maak er uw eigen kopie van om sleutels toe te voegen en te bewerken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是內建佈局。複製一份，就能加鍵和改鍵了。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ to układ wbudowany. Utwórz własną kopię, aby dodawać i edytować klucze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a built-in layout. Make your own copy of it to add and edit keys."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yerleşik bir düzendir. Anahtar eklemek ve düzenlemek için kendi kopyanızı oluşturun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je vestavěné rozložení. Vytvořte si vlastní kopii, abyste mohli přidávat a upravovat klíče."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je vstavané rozloženie. Vytvorte si vlastnú kópiu na pridávanie a úpravu kľúčov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ είναι μια ενσωματωμένη διάταξη. Δημιουργήστε το δικό σας αντίγραφο για να προσθέσετε και να επεξεργαστείτε κλειδιά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är en inbyggd layout. Gör din egen kopia av den för att lägga till och redigera nycklar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er et indbygget layout. Lav din egen kopi af den for at tilføje og redigere nøgler."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er en innebygd layout. Lag din egen kopi av den for å legge til og redigere nøkler."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on sisäänrakennettu asettelu. Tee siitä oma kopio avaimien lisäämistä ja muokkaamista varten."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adalah tata letak bawaan. Buat salinan Anda sendiri untuk menambah dan mengedit kunci."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ là một bố cục tích hợp. Tạo bản sao của riêng bạn để thêm và chỉnh sửa khóa."
          }
        }
      }
    },
    "%@ is a built-in layout. Make your own copy of it to keep keys on this layout alone.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is 'n ingeboude uitleg. Maak jou eie kopie daarvan om sleutels op hierdie uitleg alleen te hou."
          }
        },
        "de": {
