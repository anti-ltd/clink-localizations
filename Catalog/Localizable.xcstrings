    "Capture the current clipboard when the history panel is opened.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vang die huidige knipbord vas wanneer die geskiedenispaneel oopgemaak word."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Zwischenablage übernehmen, sobald du das Verlaufs-Panel öffnest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda lo que tengas en el portapapeles al abrir el panel de historial."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvesta käesolev lõikelaud ajaloo paneeli avamisel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture le presse-papiers actuel quand tu ouvres le panneau d'historique."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elmenti az aktuális vágólapot, amikor megnyitod az előzmények panelt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cattura ciò che hai negli appunti quando apri il pannello della cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴パネルを開いたときに、今クリップボードにある内容を取り込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 패널을 열 때 지금 클립보드 내용을 가져와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil salinan papan keratan semasa bila panel sejarah dibuka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda a área de transferência atual quando abres o painel de histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забирать текущее содержимое буфера обмена при открытии панели истории."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开历史面板时，抓取当前剪贴板的内容。"
          }
        }
      }
    },
