    "How a pressed key springs back to rest after each press.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoe 'n gedrukte sleutel na elke druk terugspring om te rus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie eine gedrückte Taste nach jedem Tastendruck in ihre Ruheposition zurückspringt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo vuelve una tecla a su posición de reposo tras cada pulsación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuidas vajutatud klahv pärast iga vajutust tagasi puhkeasendisse hüppab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment une touche enfoncée revient au repos après chaque pression."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogyan pattan vissza egy megnyomott billentyű nyugalmi állapotába minden lenyomás után."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come un tasto premuto torna a riposo dopo ogni pressione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押したキーが毎回の押下後にどのように元の位置に戻るかを示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누른 키가 매번 누를 때마다 원래 상태로 돌아오는 방식을 설정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cara kekunci yang ditekan kembali ke kedudukan asal selepas setiap tekanan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como uma tecla premida volta ao repouso após cada pressão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как нажатая клавиша возвращается в исходное положение после каждого нажатия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下按键后，按键如何弹回原位。"
          }
        }
      }
    },
    "How a pressed key springs back to rest, shaped by the feel above.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoe 'n ingedrukte sleutel terugspring om te rus, gevorm deur die gevoel hierbo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie eine gedrückte Taste in die Ruhelage zurückfedert, geprägt vom Gefühl oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo una tecla pulsada vuelve a su posición de reposo, según el tacto elegido arriba."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuidas vajutatud klahv tagasi raugeb, kujundatuna ülaloleva tunnetuse poolt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment une touche pressée revient à sa place, selon le ressenti choisi ci-dessus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Így ugrik vissza a lenyomott gomb nyugalmi helyzetébe, a fent választott érzés alakítja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come un tasto premuto torna a riposo, modellato dalla sensazione scelta sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押したキーが元に戻るときのばねの動き。上で選んだ雰囲気に合わせて変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눌린 키가 제자리로 되돌아오는 방식으로, 위의 느낌 설정에 따라 달라집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cara kekunci yang ditekan melantun kembali ke kedudukan asal, dibentuk oleh rasa di atas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como uma tecla premida regressa ao repouso, moldado pela sensação acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как нажатая клавиша возвращается в покой — в зависимости от ощущения, заданного выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下的按键如何回弹复位，由上方的触感设置决定。"
          }
        }
      }
    },
