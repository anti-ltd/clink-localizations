            "value": "O koľko sa kláves zväčší pri stlačení. 100 % je vypnuté; vyššie dáva väčší pop."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο κλιμακώνεται ένα πλήκτρο όταν πατηθεί. 100% έκπτωση? υψηλότερο δίνει μεγαλύτερη ποπ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur mycket en tangent skalas upp när den trycks ned. 100 % är rabatterat; högre ger en större pop."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor meget en tast skalerer op, når der trykkes på den. 100% er off; højere giver et større pop."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mye en tast skalerer opp når den trykkes. 100 % er avslag; høyere gir en større pop."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka paljon näppäin skaalautuu, kun sitä painetaan. 100 % pois päältä; korkeampi antaa suuremman popin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa besar skala tombol saat ditekan. 100% tidak aktif; lebih tinggi memberikan pop yang lebih besar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức độ tăng tỷ lệ của một phím khi được nhấn. giảm 100%; cao hơn sẽ tạo ra tiếng vang lớn hơn."
          }
        }
      }
    },
    "How much each key bulges outward as your finger passes over it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel elke sleutel na buite bult as jou vinger daaroor beweeg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark sich jede Taste nach außen wölbt, wenn dein Finger darüber fährt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto sobresale cada tecla cuando pasas el dedo por encima."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui palju iga klahv väljapoole pundub, kui su sõrm üle libiseb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
