    "Punctuate what I say and tighten it. Same meaning, fewer words.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Punteer wat ek sê en maak dit strenger. Dieselfde betekenis, minder woorde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz die Zeichensetzung und straff es. Gleiche Aussage, weniger Worte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntúa lo que digo y condénsalo. Mismo sentido, menos palabras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pane kirjavahemärgid ja tõmba kokku. Sama tähendus, vähem sõnu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponctue ce que je dis et resserre-le. Même sens, moins de mots."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tedd ki a központozást, és tömörítsd. Ugyanaz az értelem, kevesebb szó."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punteggia quello che dico e stringilo. Stesso senso, meno parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容に句読点をつけて引き締めて。意味はそのまま、言葉は少なく。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 말한 내용에 문장부호를 넣고 간결하게 줄여 줘. 뜻은 그대로, 말은 짧게."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Letak tanda baca pada apa yang saya sebut dan padatkannya. Makna sama, kata lebih sedikit."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontua o que digo e condensa. Mesmo sentido, menos palavras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расставить знаки препинания и подтянуть сказанное. Тот же смысл, меньше слов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给我说的加上标点并精简。意思不变，字数更少。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Punctează ceea ce spun și strânge-l. Același sens, mai puține cuvinte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderstreep wat ik zeg en span het aan. Dezelfde betekenis, minder woorden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給我說的加上標點並精簡。意思不變，字數更少。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podkreślaj to, co mówię i dokręcaj. To samo znaczenie, mniej słów."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставте розділові знаки, що я кажу, і посиліть це. Те саме значення, менше слів."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Söylediklerimi noktalayın ve sıkılaştırın. Aynı anlam, daha az kelime."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdůrazněte, co říkám, a utáhněte to. Stejný význam, méně slov."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdôraznite, čo hovorím, a utiahnite to. Rovnaký význam, menej slov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σημειώστε αυτό που λέω και σφίξτε το. Ίδιο νόημα, λιγότερες λέξεις."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera det jag säger och dra åt det. Samma betydelse, färre ord."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt punktum i det, jeg siger, og stram det. Samme betydning, færre ord."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett punktum i det jeg sier og stram det. Samme betydning, færre ord."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välittele sanomani ja kiristä sitä. Sama merkitys, vähemmän sanoja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandai apa yang saya katakan dan kencangkan. Arti yang sama, kata-kata yang lebih sedikit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chấm câu những gì tôi nói và thắt chặt nó. Ý nghĩa tương tự, ít từ hơn."
          }
        }
      }
    },
