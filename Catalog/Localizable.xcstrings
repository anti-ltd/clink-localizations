        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu visual de grabación, en directo. Deslízalo para cambiar de estilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton visuel d'enregistrement, en direct. Balaie-le pour changer de style."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felvétel látványa, élőben. Húzd oldalra, ha másik stílust szeretnél."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La grafica di registrazione, dal vivo. Scorrila per cambiare stile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中に出るビジュアルです。スワイプするとスタイルを変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음할 때 보이는 그대로예요. 좌우로 밀면 스타일이 바뀌어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual rakaman anda, secara langsung. Leret untuk tukar gaya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu visual de gravação, ao vivo. Desliza-o para mudar de estilo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш вид записи вживую. Смахните, чтобы сменить стиль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这就是录音时的画面。左右滑动即可换样式。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu salvestuse visuaal, reaalajas. Viipa sellel, et stiili vahetada."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou opname visueel, regstreeks gewys. Swiep dit om styl te verander."
          }
        }
      }
    },
