    "Runs just inside the edge, on the key itself.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop net binne die rand, op die sleutel self."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verläuft knapp innerhalb der Kante, auf der Taste selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Va justo por dentro del borde, sobre la propia tecla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulgeb vahetult servast seespool, klahvil endal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe juste à l’intérieur du bord, sur la touche elle-même."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyű szélén belül fut, magán a billentyűn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corre appena dentro il bordo, sul tasto stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの縁のすぐ内側、キーの上を通ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 가장자리 바로 안쪽, 키 위를 지나가요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan betul-betul di dalam bibir kekunci, pada kekunci itu sendiri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa mesmo por dentro do bordo, na própria tecla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идёт по внутреннему краю, по самой клавише."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿着按键边缘内侧走，画在按键上。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulează chiar în interiorul marginii, pe cheia însăși."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopt net binnen de rand, op de sleutel zelf."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沿著按鍵邊緣內側走，畫在按鍵上。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biegnie tuż za krawędzią, na samym kluczu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проходить лише всередині краю, на самому ключі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarın kendisi üzerinde, kenarın hemen içinde çalışır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běží těsně za okrajem, na samotném klíči."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Beží tesne vnútri okraja, na samotnom kľúči."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τρέχει ακριβώς μέσα στην άκρη, στο ίδιο το κλειδί."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Går precis innanför kanten, på själva nyckeln."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kører lige indenfor kanten, på selve nøglen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Går like innenfor kanten, på selve nøkkelen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toimii aivan reunan sisällä, itse avaimessa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan tepat di dalam edge, pada kunci itu sendiri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy ngay bên trong mép, trên chính phím."
          }
        }
      }
    },
    "Runs just outside the edge, so the key keeps its full size.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop net buite die rand, so die sleutel behou sy volle grootte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verläuft knapp außerhalb der Kante, sodass die Taste ihre volle Größe behält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Va justo por fuera del borde, así la tecla conserva todo su tamaño."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulgeb vahetult servast väljaspool, nii et klahv hoiab oma täissuuruse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe juste à l’extérieur du bord : la touche garde toute sa taille."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyű szélén kívül fut, így a billentyű megtartja a teljes méretét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corre appena fuori dal bordo, così il tasto resta grande com’è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの縁のすぐ外側を通るので、キーの大きさはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 가장자리 바로 바깥을 지나서, 키 크기는 그대로예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan betul-betul di luar bibir kekunci, jadi saiz kekunci kekal penuh."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa mesmo por fora do bordo, por isso a tecla mantém o tamanho todo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идёт по внешнему краю, поэтому клавиша сохраняет полный размер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿着按键边缘外侧走，按键还是原来的大小。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulează chiar în afara marginii, astfel încât cheia își păstrează dimensiunea completă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopt net buiten de rand, waardoor de sleutel zijn volledige grootte behoudt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沿著按鍵邊緣外側走，按鍵還是原來的大小。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybiega tuż poza krawędź, dzięki czemu klucz zachowuje swój pełny rozmiar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виходить за межі краю, тому ключ зберігає свій повний розмір."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenarın hemen dışında çalışır, böylece anahtar tam boyutunu korur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běží těsně za okrajem, takže klíč si zachovává svou plnou velikost."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Beží tesne za okrajom, takže kľúč si zachováva svoju plnú veľkosť."
