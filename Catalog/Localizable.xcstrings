    "Drag stickers to move them. Pinch or use the size slider to resize.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe Sticker, um sie zu verschieben. Zum Größenändern kneife oder nutze den Größenregler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra las pegatinas para moverlas. Pellizca o usa el control de tamaño para redimensionarlas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista kleepse liigutamiseks. Suuruse muutmiseks näpi või kasuta suuruselülitit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les autocollants pour les déplacer. Pincez ou utilisez le curseur de taille pour les redimensionner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd a matricákat mozgatáshoz. Méretezéshez csipesszel vagy a méretcsúszkával."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina gli adesivi per spostarli. Pizzica o usa il cursore per ridimensionarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステッカーをドラッグして移動。ピンチまたはサイズスライダーで拡大縮小。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스티커를 드래그하여 이동하세요. 크기는 핀치하거나 크기 슬라이더로 조절하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret pelekat untuk menggerakkannya. Cubit atau gunakan peluncur saiz untuk menukar saiz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste os adesivos para movê-los. Aperte ou use o controle de tamanho para redimensionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте стикеры, чтобы перемещать их. Изменяйте размер щипком или ползунком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动贴纸以移动它们。用双指捏合或大小滑块调整尺寸。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep plakkers om hulle te skuif. Knyp of gebruik die grootteskuifbalk om die grootte te verander."
          }
        }
      }
    },
    "Turn stickers on to bring them to the keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Sticker, um sie auf die Tastatur zu bringen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las pegatinas para llevarlas al teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita kleepsud sisse, et need klaviatuurile tuua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les autocollants pour les afficher sur le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a matricákat, hogy a billentyűzetre kerüljenek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva gli adesivi per portarli sulla tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステッカーをオンにしてキーボードに表示しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드에 표시하려면 스티커를 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan pelekat untuk membawanya ke papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative os adesivos para levá-los ao teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите стикеры, чтобы они появились на клавиатуре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启贴纸以便将它们显示到键盘上。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel plakkers aan om dit na die sleutelbord te bring."
          }
        }
      }
    },
    "123, space, and return go with it. Add keys back from Key if you want them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "123, Leertaste und Return verschwinden mit. Du kannst sie unter Tasten wieder hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "123, espacio y retorno desaparecen con ella. Puedes volver a añadirlos desde Teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "123, tühik ja Enter kaovad koos sellega. Saad need klahvid uuesti lisada menüüs Klahvid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "123, espace et retour disparaissent avec eux. Vous pouvez les rajouter depuis Touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A 123, a szóköz és az Enter vele megy. A Billentyűk menüpontban veheted vissza őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "123, spazio e invio spariscono con loro. Puoi riaggiungerli da Tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "123、スペース、Return も一緒に消えます。必要なキーは「キー」から追加し直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "123, 스페이스, Return 키도 함께 사라집니다. 키 메뉴에서 다시 추가할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "123, bar ruang dan return turut hilang. Tambah semula daripada Kekunci jika anda mahu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "123, espaço e retorno vão junto. Você pode adicioná-los novamente em Teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "123, пробел и возврат исчезнут вместе с ней. Вернуть их можно в разделе «Клавиши»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "123、空格和回车键会一起移除。如需保留可在“按键”中重新添加。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "123, spasie, en terugkeer gaan daarmee saam. Voeg sleutels terug vanaf Key as jy dit wil hê."
          }
        }
      }
    },
