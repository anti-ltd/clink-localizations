    "Recolor one key, or every letter at once.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Herkleur een sleutel, of elke letter op een slag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbe eine Taste um oder gleich alle Buchstaben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el color de una tecla o de todas las letras a la vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Värvi üks klahv ümber või kõik tähed korraga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change la couleur d’une touche ou de toutes les lettres d’un coup."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Színezz át egy billentyűt, vagy az összes betűt egyszerre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia colore a un tasto o a tutte le lettere insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー1つでも、文字キー全部でも色を変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 하나만, 또는 글자 키 전부를 한 번에 바꿔요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar warna satu kekunci, atau semua huruf sekali gus."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda a cor de uma tecla ou de todas as letras de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекрасьте одну клавишу или все буквы разом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改一个按键的颜色，或者一次改完所有字母。"
          }
        }
      }
    },
