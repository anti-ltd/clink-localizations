    "That file is silent. There's nothing to hear.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese archivo no suena. No hay nada que oír."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est silencieux. Il n’y a rien à entendre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist still. Da ist nichts zu hören."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel file è silenzioso. Non c’è niente da sentire."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse ficheiro está mudo. Não há nada para ouvir."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail itu senyap. Tiada apa untuk didengar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájl csendes. Nincs mit hallani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのファイルは無音です。聞こえるものがありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件是静音的。没什么可听。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 파일은 고요해요. 들을 게 없어요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See fail on vaikne. Pole midagi kuulda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл беззвучный. Слушать нечего."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Daardie lêer is stil. Daar is niks om te hoor nie."
          }
        }
      }
    },
    "That file is too big. Pick a short clip.": {
