    "Tap one to go to it, or put it back on its own.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik een om daarna te gaan, of sit dit op sy eie terug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp auf einen Eintrag, um dorthin zu springen, oder stell ihn einzeln zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca uno para ir hasta él, o devuélvelo a su valor por separado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta ühel, et sinna minna, või pane see üksinda tagasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un élément pour y aller, ou remets-le seul comme avant."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egyre, hogy odaugorj, vagy állítsd vissza külön-külön."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una voce per andarci, oppure ripristinala da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目をタップするとその設定に移動できます。ひとつだけ元に戻すこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 누르면 해당 설정으로 이동하고, 하나만 따로 되돌릴 수도 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik satu untuk pergi ke situ, atau kembalikan ia satu per satu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca num para ir até ele, ou repõe-no sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы перейти к настройке, или верните её по отдельности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按其中一项即可跳转，也可以单独把它还原。"
          }
        }
      }
    },
    "Tap or drag across keys to paint.": {
      "comment": "Canvas paint-tool instruction. Tap individual keyboard keys or drag across multiple keys to apply the selected color.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Tasten oder streiche über sie, um sie zu färben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap or drag across keys to paint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca las teclas o desliza el dedo sobre ellas para pintarlas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta klahve või lohista sõrmega üle nende, et neid värvida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur les touches ou fais glisser ton doigt dessus pour les colorer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a billentyűkre, vagy húzd végig rajtuk az ujjad a színezéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca i tasti o trascinaci sopra il dito per colorarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーをタップするか、指を滑らせると色を塗れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 탭하거나 키 위로 손가락을 드래그하여 색을 칠하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kekunci atau seret jari merentasinya untuk mewarnakannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca nas teclas ou desliza o dedo sobre elas para as pintar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
