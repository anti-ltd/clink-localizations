          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueado para sempre. Obrigado por estares aqui desde o início"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокировано навсегда. Спасибо, что вы были с нами с самого начала"
