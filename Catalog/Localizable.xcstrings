    "Set the colour and the speed underneath.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbe und Tempo stellst du darunter ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debajo ajustas el color y la velocidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle la couleur et la vitesse en dessous."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alatta állítsd be a színt és a sebességet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sotto imposti il colore e la velocità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その下で色と速さを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 아래에서 색과 속도를 정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan warna dan kelajuan di bawahnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Define a cor e a velocidade por baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте цвет и скорость ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下面设置颜色和速度。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Määra allpool värv ja kiirus."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stel die kleur en die spoed daaronder."
          }
        }
      }
    },
    "Set the key, text and background colours, and give light and dark separate looks.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg die Farben für Tasten, Text und Hintergrund fest und gib Hell und Dunkel jeweils ein eigenes Aussehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define los colores de teclas, texto y fondo, y dale a claro y oscuro aspectos distintos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définis les couleurs des touches, du texte et de l'arrière-plan, et donne au clair et au sombre un rendu distinct."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsd be a billentyűk, a szöveg és a háttér színét, és adj a világosnak és a sötétnek külön megjelenést."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta i colori di tasti, testo e sfondo, e dai a chiaro e scuro un aspetto ciascuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー、文字、背景の色を決め、ライトとダークにそれぞれの見た目を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키와 글자, 배경 색을 정하고, 밝은 모드와 어두운 모드에 각각 다른 모습을 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan warna kekunci, teks dan latar belakang, dan berikan mod cerah serta gelap rupa masing-masing."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Define as cores das teclas, do texto e do fundo, e dá ao claro e ao escuro aspetos separados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте цвета клавиш, текста и фона и сделайте светлому и тёмному виду разное оформление."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定按键、文字和背景的颜色，再给浅色和深色各配一套样子。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Määra klahvi, teksti ja tausta värvid ning anna heledale ja tumedale eraldi ilme."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stel die sleutel-, teks- en agtergrondkleure, en gee lig en donker aparte voorkoms."
          }
        }
      }
    },
    "Set the light and dark sides separately if the built-in pairing isn't what you want.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell die helle und die dunkle Seite einzeln ein, wenn dir die vorgegebene Paarung nicht passt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el lado claro y el oscuro por separado si la combinación de fábrica no te convence."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle le côté clair et le côté sombre séparément si l'association d'origine ne te convient pas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a gyári párosítás nem tetszik, állítsd be külön a világos és a sötét oldalt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il lato chiaro e quello scuro separatamente, se l'abbinamento di serie non ti convince."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定の組み合わせが好みでなければ、ライトとダークをそれぞれ個別に設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 조합이 마음에 들지 않으면 밝은 쪽과 어두운 쪽을 따로 설정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan bahagian cerah dan gelap secara berasingan jika gandingan asalnya tidak menepati citarasa anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Define o lado claro e o escuro em separado, se o par de origem não for o que queres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте светлую и тёмную стороны по отдельности, если встроенная пара вам не подходит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果自带的搭配不合口味，浅色和深色可以分别设置。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Määra heled ja tumeda poole eraldi, kui sisseehitatud paaris ei sobi."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stel die ligte en donker kante afsonderlik as die ingeboude paring nie is wat jy wil hê nie."
          }
        }
      }
    },
