    "Get the keyboard the way you want it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kry die sleutelbord soos jy dit wil hê."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte die Tastatur so ein, wie du sie haben willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el teclado como te guste."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seadista klaviatuur nii, nagu soovid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle le clavier comme tu le veux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsd be a billentyűzetet úgy, ahogy szeretnéd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema la tastiera come la vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずキーボードを好みの状態にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 키보드를 원하는 상태로 맞추세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sediakan papan kekunci seperti yang anda mahu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Põe o teclado como o queres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте клавиатуру такой, какой хотите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先把键盘调成你想要的样子。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Obțineți tastatura așa cum doriți."
