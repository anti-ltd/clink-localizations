    "A theme carries a light look and a dark one, and Clink switches between them with the phone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Design hat einen hellen und einen dunklen Look, und Clink wechselt zusammen mit dem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tema lleva un aspecto claro y otro oscuro, y Clink cambia entre ellos con el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un thème contient un rendu clair et un sombre, et Clink bascule en même temps que le téléphone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy témában van egy világos és egy sötét változat, a Clink pedig a telefonnal együtt vált köztük."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tema porta con sé un aspetto chiaro e uno scuro, e Clink passa dall'uno all'altro insieme al telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマにはライト用とダーク用の見た目があり、Clinkは端末に合わせて切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마에는 밝은 모습과 어두운 모습이 함께 들어 있고, Clink이 기기에 맞춰 전환합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu tema membawa rupa cerah dan rupa gelap, dan Clink bertukar antara keduanya bersama telefon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um tema traz um aspecto claro e um escuro, e o Clink alterna entre eles com o telemóvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В теме есть светлый вид и тёмный, и Clink переключает их вместе с телефоном."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个主题自带浅色和深色两套外观，Clink 会跟着手机一起切换。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teema kannab endas heledat ja tumedat ilmet ning Clink vahetab neid koos telefoniga."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Tema het 'n ligte voorkoms en 'n donker een, en Clink skakel tussen hulle met die foon."
          }
        }
      }
    },
    "A thin tail swelling into a bright head.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein dünner Schweif, der zu einem hellen Kopf anschwillt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cola fina que se ensancha hasta una cabeza brillante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fine queue qui s'élargit en une tête lumineuse."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vékony csóva, ami fényes fejben végződik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una coda sottile che si allarga in una testa luminosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "細い尾が、明るい頭へと太くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가느다란 꼬리가 밝은 머리로 굵어져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekor nipis yang membesar jadi kepala terang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cauda fina que engrossa até uma cabeça brilhante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тонкий хвост, переходящий в яркую голову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "细尾巴一路变粗，收在明亮的头上。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peenike saba, mis paisub heledaks peaks."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Dun stert wat tot 'n helder kop swel."
          }
        }
      }
    },
    "A tile pops up above each key as you press it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über jeder Taste erscheint beim Drücken ein Kärtchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece una placa sobre cada tecla al pulsarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pastille apparaît au-dessus de chaque touche quand tu la presses."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden billentyű fölött egy lapka jelenik meg, amikor lenyomod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sopra ogni tasto compare una piastrella quando lo premi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを押すと、その上にタイルがポンと出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누르면 그 위로 타일이 톡 떠올라요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jubin timbul di atas setiap kekunci apabila anda menekannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece uma placa por cima de cada tecla quando a premes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При нажатии над клавишей всплывает плитка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每按一个键，键上方就会弹出一个小方块。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga klahvi vajutamisel hüppab selle kohale kaart."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Teël verskyn bo elke sleutel terwyl jy dit druk."
          }
        }
      }
    },
    "A tiny pet lives in the corner of your keyboard and reacts as you type.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Ecke deiner Tastatur wohnt ein kleines Haustier, das auf dein Tippen reagiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pequeña mascota vive en la esquina del teclado y reacciona mientras escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit animal vit dans le coin de ton clavier et réagit quand tu tapes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzet sarkában egy kis kedvenc lakik, és reagál a gépelésedre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un piccolo animaletto vive nell'angolo della tastiera e reagisce mentre scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの隅に小さなペットが住んでいて、入力に反応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 구석에 작은 펫이 살면서 입력에 반응해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Haiwan peliharaan kecil tinggal di penjuru papan kekunci dan bertindak balas semasa anda menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pequeno animal vive no canto do teclado e reage enquanto escreves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В углу клавиатуры живёт маленький питомец и реагирует на вашу печать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一只小宠物住在键盘角落，会随你的输入做出反应。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu klaviatuuri nurgas elab tilluke lemmikloom, mis reageerib sinu tipimisele."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
