          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik cadangan untuk menggunakannya"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy javaslatra a használatához"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補をタップして入力"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
