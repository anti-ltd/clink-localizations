    "Sticks close to the original wording, phrase by phrase.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Bly naby die oorspronklike bewoording, frase vir frase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt nah am Original, Wendung für Wendung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ciñe a la redacción original, frase por frase."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Püsib originaali sõnastuse lähedal, fraasi kaupa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste au plus près du texte d'origine, expression par expression."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szorosan követi az eredeti megfogalmazást, fordulatról fordulatra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta fedele al testo originale, frase per frase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原文の言い回しを一語一句そのままたどります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원문의 표현을 구절 단위로 그대로 따릅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengekalkan susunan kata asal, rangkai kata demi rangkai kata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém-se fiel à redação original, expressão a expressão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держится близко к исходным формулировкам, фраза за фразой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐句贴合原文的措辞。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ține aproape de formularea originală, frază cu frază."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijft dicht bij de oorspronkelijke bewoording, zin voor zin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐句貼合原文的措辭。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzyma się blisko oryginalnego brzmienia, fraza po frazie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дотримується оригінального формулювання, фраза за фразою."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cümle cümle orijinal ifadeye yakın bir şekilde yapışır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Blíží se původnímu znění, frázi po frázi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Drží sa blízko pôvodného znenia, frázu po fráze."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κολλάει κοντά στην αρχική διατύπωση, φράση προς φράση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håller sig nära den ursprungliga formuleringen, fras för fras."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Holder sig tæt på den oprindelige formulering, sætning for sætning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Holder seg nær den opprinnelige ordlyden, frase for frase."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysyy lähellä alkuperäistä sanamuotoa, lause lauseelta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap dekat dengan kata-kata aslinya, frase demi frase."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bám sát từ ngữ gốc, từng cụm từ."
          }
        }
      }
    },
