    "Jot in any app, drop it in anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryf enige toepassing in, gooi dit enige plek in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiere in jeder App, füge es überall ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota en cualquier app y suéltalo donde quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee märkmeid igas rakenduses ja sisesta need kuhu iganes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note dans n'importe quelle app, dépose-le où tu veux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jegyzetelj bármelyik appban, illeszd be bárhová."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annota in qualsiasi app, inseriscilo ovunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリでもメモして、どこへでも入れられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 앱에서든 적어 두고, 어디에나 넣으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat dalam mana-mana apl, letakkan di mana-mana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota em qualquer app e larga-o onde quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте в любом приложении и вставляйте куда угодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何应用里记下，随处放入。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrieți în orice aplicație, introduceți-o oriunde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak notities in elke app en zet ze overal neer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何應用裡記下，隨處放入。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanotuj w dowolnej aplikacji, upuść ją w dowolnym miejscu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Намітьте в будь-якому додатку, завантажте його будь-де."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir uygulamaya not edin, herhangi bir yere bırakın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapište si jakoukoli aplikaci, vložte ji kamkoli."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapíšte si akúkoľvek aplikáciu, vložte ju kdekoľvek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σημειώστε σε οποιαδήποτε εφαρμογή, ρίξτε την οπουδήποτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv i vilken app som helst, släpp in den var som helst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jot in any app, drop it in anywhere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn hvilken som helst app, slipp den inn hvor som helst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita mihin tahansa sovellukseen, pudota se minne tahansa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat di aplikasi apa pun, letakkan di mana saja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi vào bất kỳ ứng dụng nào, thả nó vào bất cứ đâu."
          }
        }
      }
    },
    "Jot text from any app, then drop it wherever you type. Adds a notepad to the panel button.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryf teks van enige toepassing af en los dit dan waar jy ook al tik. Voeg 'n notaboek by die paneelknoppie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiere Text aus jeder App und setz ihn ein, wo du gerade tippst. Fügt der Panel-Taste einen Notizblock hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota texto desde cualquier app y suéltalo donde escribas. Añade un bloc de notas al botón del panel."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee teksti märkmeid igast rakendusest ja sisesta need sinna, kuhu tipid. Lisab paneelinupule märkmiku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note du texte depuis n'importe quelle app, puis dépose-le là où tu tapes. Ajoute un bloc-notes au bouton du panneau."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jegyzetelj bármelyik appból, aztán dobd be oda, ahol épp gépelsz. Jegyzettömböt tesz a panel gombhoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendi appunti da qualsiasi app, poi incollali dove scrivi. Aggiunge un blocco note al pulsante del pannello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリからでもテキストをメモして、入力したい場所に貼り付けられます。パネルボタンにメモ帳を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 앱에서든 텍스트를 적어 두고, 입력하는 곳 어디에나 붙여넣어요. 패널 버튼에 메모장을 넣어 줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat teks dari mana-mana apl, kemudian letak di mana sahaja anda menaip. Tambah pad nota pada butang panel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota texto a partir de qualquer app e larga-o onde escreveres. Adiciona um bloco de notas ao botão do painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте текст из любого приложения и вставляйте его там, где печатаете. Добавляет блокнот к кнопке панелей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何应用里记点文字，再粘到你要打字的地方。会在面板按钮里加一个记事本。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrieți text din orice aplicație, apoi plasați-l oriunde introduceți. Adaugă un bloc de note la butonul panoului."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak tekst vanuit elke app en zet deze neer waar u typt. Voegt een notitieblok toe aan de paneelknop."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何應用裡記點文字，再粘到你要打字的地方。會在面板按鈕里加一個記事本。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanotuj tekst z dowolnej aplikacji, a następnie upuść go w dowolnym miejscu, w którym piszesz. Dodaje notatnik do przycisku panelu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишіть текст із будь-якої програми, а потім розмістіть його там, де ви вводите. Додає блокнот до кнопки панелі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir uygulamadan metni not alın ve yazdığınız yere bırakın. Panel düğmesine bir not defteri ekler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapište text z libovolné aplikace a pak jej umístěte, ať píšete kamkoli. Přidá k tlačítku panelu poznámkový blok."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapíšte si text z ľubovoľnej aplikácie a potom ho pustite kamkoľvek píšete. Pridá k tlačidlu panela poznámkový blok."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σημειώστε κείμενο από οποιαδήποτε εφαρμογή και, στη συνέχεια, αποθέστε το όπου πληκτρολογείτε. Προσθέτει ένα σημειωματάριο στο κουμπί του πίνακα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv text från valfri app och släpp den var du än skriver. Lägger till ett anteckningsblock till panelknappen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv tekst fra enhver app, og slip den derefter, uanset hvor du skriver. Adds a notepad to the panel button."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv tekst fra en hvilken som helst app, og slipp den hvor enn du skriver. Legger til en notisblokk på panelknappen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita tekstiä mistä tahansa sovelluksesta ja pudota se minne tahansa kirjoitat. Lisää muistiinpanon paneelipainikkeeseen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat teks dari aplikasi apa pun, lalu letakkan di mana pun Anda mengetik. Menambahkan notepad ke tombol panel."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết văn bản từ bất kỳ ứng dụng nào rồi thả nó vào bất cứ nơi nào bạn nhập. Thêm một notepad vào nút bảng điều khiển."
          }
        }
      }
    },
