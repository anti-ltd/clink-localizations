    "All %@ dictionaries are bundled in the app. Nothing you type is sent anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %@ Wörterbücher stecken in der App. Nichts, was du tippst, wird irgendwohin geschickt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los %@ diccionarios vienen dentro de la app. Nada de lo que escribes se envía a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %@ dictionnaires sont intégrés à l’app. Rien de ce que tu tapes n’est envoyé où que ce soit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mind a %@ szótár az appban van. Semmi nem megy el abból, amit írsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i %@ dizionari sono inclusi nell’app. Niente di ciò che scrivi viene inviato da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 種類の辞書はすべてアプリに同梱されています。入力した内容がどこかに送られることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전 %@개가 모두 앱에 들어 있습니다. 입력한 내용은 어디로도 전송되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesemua %@ kamus disertakan dalam app. Apa-apa yang anda taip tidak dihantar ke mana-mana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os %@ dicionários vêm todos dentro da app. Nada do que escreves é enviado para lado nenhum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все словари (%@) встроены в приложение. Ничего из напечатанного никуда не отправляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 本词典全部随应用打包。你输入的内容不会发送到任何地方。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik %@ sõnaraamatut on rakendusse sisse ehitatud. Midagi, mida sa tipid, ei saadeta kuhugi."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle %@ woordeboeke word in die toepassing gebundel. Niks wat jy tik word êrens heen gestuur nie."
          }
        }
      }
    },
