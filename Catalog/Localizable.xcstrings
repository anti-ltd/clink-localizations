          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše běží na zařízení se Apple Intelligence. Z vašeho telefonu nic neopustí. Každá funkce zůstane vypnutá, dokud ji zde nezapnete."
          }
