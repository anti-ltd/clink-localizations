    "Start typing with Clink and your stats will show up here.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin tik met Clink en jou statistieke sal hier verskyn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fang an, mit Clink zu tippen, dann erscheinen deine Statistiken hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a escribir con Clink y tus estadísticas aparecerán aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakka Clinkiga tipitama ja sinu statistika ilmub siia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence à taper avec Clink et tes statistiques apparaîtront ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdj el gépelni a Clinkkel, és a statisztikáid itt fognak megjelenni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia a scrivere con Clink e le tue statistiche compariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkで入力を始めると、ここに統計が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink으로 입력을 시작하면, 여기에 통계가 나타나요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mula menaip dengan Clink dan statistik anda akan dipaparkan di sini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa a escrever com o Clink e as tuas estatísticas vão aparecer aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните печатать в Clink — и здесь появится ваша статистика."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始用 Clink 打字吧，你的统计数据会显示在这里。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începeți să tastați cu Clink și statisticile dvs. vor apărea aici."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met typen met Clink en je statistieken worden hier weergegeven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始用 Clink 打字吧，你的統計資料會顯示在這裡。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij pisać za pomocą Clink, a Twoje statystyki pojawią się tutaj."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть вводити текст із Clink, і тут з’явиться ваша статистика."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ile yazmaya başladığınızda istatistikleriniz burada görünecektir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začněte psát pomocí Clink a vaše statistiky se zobrazí zde."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Začnite písať pomocou Clink a vaše štatistiky sa zobrazia tu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινήστε να πληκτρολογείτε με το Clink και τα στατιστικά σας θα εμφανιστούν εδώ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja skriva med Clink och din statistik kommer att dyka upp här."
          }
        },
        "da": {
