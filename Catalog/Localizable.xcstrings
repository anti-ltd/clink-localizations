    "Dimmed ones come from the layout's long-press presets or your language.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeblendete stammen aus den Langdruck-Presets des Layouts oder deiner Sprache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atenuados vienen de los ajustes de pulsación larga de la distribución o de tu idioma."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuhmimad pärinevad paigutuse pika vajutuse eelseadetest või sinu keelest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments grisés viennent des préréglages d’appui long de la disposition ou de votre langue."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A halványak a kiosztás hosszú nyomás előbeállításaiból vagy a nyelvedből származnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelli attenuati vengono dai preset a pressione prolungata del layout o dalla tua lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "薄いものは配列の長押しプリセットか言語から来ています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흐린 항목은 배열의 길게 누르기 프리셋이나 언어에서 옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang malap datang daripada pratetap tekan lama susun atur atau bahasa anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os esmaecidos vêm dos predefinidos de toque longo do layout ou do seu idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приглушённые берутся из пресетов долгого нажатия раскладки или вашего языка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变暗的来自布局的长按预设或你的语言。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cele estompate provin din presetările de apăsare lungă ale layout-ului sau din limba dvs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedimde opties zijn afkomstig van de voorinstellingen voor lang indrukken van de lay-out of van uw taal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變暗的來自佈局的長按預設或你的語言。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfloues kom van die uitleg se langdruk-voorafinstellings of jou taal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyciemnione pochodzą z ustawień wstępnych układu po długim naciśnięciu lub z Twojego języka."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемнені походять із попередніх налаштувань макета при тривалому натисканні або вашої мови."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soluk renkli olanlar, düzenin uzun basılan ön ayarlarından veya dilinizden gelir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ztlumené pocházejí z předvoleb dlouhého stisknutí rozvržení nebo vašeho jazyka."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlmené vychádzajú z predvolieb dlhého stlačenia rozloženia alebo vášho jazyka."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σκοτεινές προέρχονται από τις προεπιλογές παρατεταμένου πατήματος της διάταξης ή τη γλώσσα σας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedtonade kommer från layoutens långtrycksförinställningar eller ditt språk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedtonede kommer fra layoutets langtryksforudindstillinger eller dit sprog."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedtonede kommer fra oppsettets forhåndsinnstillinger for lang trykk eller språket ditt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Himmennetyt tulevat asettelun pitkän painalluksen esiasetuksista tai kielestäsi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang redup berasal dari preset tata letak yang ditekan lama atau bahasa Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những điểm bị mờ đến từ cài đặt trước khi nhấn và giữ của bố cục hoặc ngôn ngữ của bạn."
          }
        }
      }
    },
