    "One tap swaps your whole setup: layout, gestures, feel. Your theme stays put.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een tik ruil jou hele opstelling om: uitleg, gebare, gevoel. Your theme stays put."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipp tauscht deine ganze Einrichtung: Layout, Gesten, Gefühl. Dein Design bleibt, wo es ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque cambia toda tu configuración: distribución, gestos, sensación. Tu tema se queda como está."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üks puudutus vahetab kogu su seadistuse: paigutuse, žestid, tunnetuse. Sinu teema jääb paigale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En un tap, toute ta config change : disposition, gestes, ressenti. Ton thème ne bouge pas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy koppintás az egész beállításodat átváltja: kiosztás, gesztusok, érzés. A témád marad, ahol van."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco cambia tutta la tua configurazione: layout, gesti, feeling. Il tuo tema resta dov'è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップで設定をまるごと切り替え。配列もジェスチャーも打ち心地も。テーマはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 탭하면 배열, 제스처, 타건감까지 설정이 통째로 바뀌어요. 테마는 그대로예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu ketukan menukar seluruh persediaan anda: susun atur, gerak isyarat, rasa. Tema anda kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque troca toda a tua configuração: disposição, gestos, sensação. O teu tema fica onde está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно нажатие меняет всю настройку: раскладку, жесты, ощущения. Тема остаётся прежней."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一下，整套设置随之切换：布局、手势、手感。主题保持不变。"
          }
        }
      }
    },
