    "Suggest names from your Contacts as you type. Off by default; text replacements are unaffected.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel name uit jou kontakte voor terwyl jy tik. Af by verstek; teksvervangings word nie geraak nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlägt beim Tippen Namen aus deinen Kontakten vor. Standardmäßig aus; Textersetzungen bleiben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugiere nombres de tus Contactos mientras escribes. Desactivado por defecto; las sustituciones de texto no se ven afectadas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soovita tipimise ajal nimesid sinu Kontaktidest. Vaikimisi väljas; tekstiasendusi ei mõjutata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggère des noms de tes contacts pendant que tu tapes. Désactivé par défaut ; les remplacements de texte ne sont pas touchés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Neveket javasol a Kapcsolataidból gépelés közben. Alapból ki van kapcsolva; a szövegcserékre nincs hatással."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerisce nomi dai tuoi Contatti mentre scrivi. Disattivato per impostazione predefinita; le sostituzioni di testo non ne risentono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力中に連絡先の名前を候補に出します。デフォルトはオフで、テキスト置換には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력하는 동안 연락처에서 이름을 추천해요. 기본은 꺼져 있고, 텍스트 대체어에는 영향 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangkan nama dari Kenalan anda semasa anda menaip. Mati secara lalai; penggantian teks tak terjejas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugere nomes dos teus Contactos enquanto escreves. Desligado por predefinição; as substituições de texto não são afetadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказывать имена из ваших контактов по ходу печати. По умолчанию выключено; на замены текста не влияет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打字时从你的通讯录里建议名字。默认关闭；文本替换不受影响。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerați nume din Agenda dvs. pe măsură ce introduceți text. Oprit implicit; înlocuirile de text nu sunt afectate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel namen uit uw contacten voor terwijl u typt. Standaard uitgeschakeld; tekstvervangingen blijven onaangetast."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打字時從你的通訊錄裡建議名字。預設關閉；文字替換不受影響。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas pisania sugerowaj nazwiska z Kontaktów. Domyślnie wyłączone; zamiany tekstu pozostają niezmienione."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропонуйте імена зі своїх контактів під час введення. Вимкнено за замовчуванням; заміни тексту не впливають."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazarken Kişilerinizden ad önerin. Varsayılan olarak kapalı; metin değişiklikleri etkilenmez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při psaní navrhujte jména ze svých kontaktů. Ve výchozím nastavení vypnuto; náhrady textu nejsou ovlivněny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Navrhujte mená zo svojich kontaktov počas písania. Predvolene vypnuté; nahradenia textu nie sú ovplyvnené."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προτείνετε ονόματα από τις Επαφές σας καθώς πληκτρολογείτε. Απενεργοποίηση από προεπιλογή. Οι αντικαταστάσεις κειμένου δεν επηρεάζονται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Föreslå namn från dina kontakter medan du skriver. Av som standard; textersättningar påverkas inte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Foreslå navne fra dine kontakter, mens du skriver. Fra som standard; teksterstatninger er upåvirkede."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Foreslå navn fra kontaktene dine mens du skriver. Av som standard; teksterstatninger påvirkes ikke."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehdota nimiä yhteystiedoistasi kirjoittaessasi. Oletuksena pois päältä; tekstin korvaaminen ei vaikuta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarankan nama dari Kontak Anda saat Anda mengetik. Mati secara default; penggantian teks tidak terpengaruh."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đề xuất tên từ Danh bạ của bạn khi bạn nhập. Tắt theo mặc định; thay thế văn bản không bị ảnh hưởng."
