    "Stays on this device unless you turn on Learned Words in iCloud Sync.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Bly op hierdie toestel tensy jy Geleerde Woorde in iCloud Sync aanskakel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt auf diesem Gerät, solange du Gelernte Wörter in der iCloud-Synchronisierung nicht einschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda en este dispositivo salvo que actives Palabras aprendidas en la sincronización con iCloud."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jääb sellesse seadmesse, kui sa ei lülita iCloudi sünkroonimises sisse Õpitud sõnu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste sur cet appareil, sauf si tu actives Mots appris dans la synchro iCloud."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen az eszközön marad, hacsak be nem kapcsolod a Tanult szavak elemet az iCloud-szinkronban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta su questo dispositivo, a meno che tu non attivi Parole apprese nella sincronizzazione iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud同期で「学習した単語」をオンにしない限り、この端末から出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화에서 학습된 단어를 켜지 않으면 이 기기에만 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekal pada peranti ini melainkan awak hidupkan Perkataan dipelajari dalam Penyegerakan iCloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica neste dispositivo, a não ser que ligues Palavras aprendidas na sincronização iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаётся на этом устройстве, пока вы не включите «Выученные слова» в синхронизации с iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你在 iCloud 同步里打开“已学习的单词”，否则只留在这台设备上。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rămâne pe acest dispozitiv dacă nu activați Cuvinte învățate în iCloud Sync."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijft op dit apparaat staan, tenzij u Geleerde Woorden in iCloud Sync inschakelt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你在 iCloud 同步裡開啟“已學習的單詞”，否則只留在這臺裝置上。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostanie na tym urządzeniu, chyba że włączysz Nauczone słowa w iCloud Sync."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишається на цьому пристрої, якщо ви не ввімкнете вивчені слова в iCloud Sync."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Sync'te Öğrenilen Kelimeler'i açmadığınız sürece bu cihazda kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstane na tomto zařízení, dokud v iCloud Sync nezapnete naučená slova."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stays on this device unless you turn on Learned Words in iCloud Sync."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παραμένει σε αυτήν τη συσκευή εκτός και αν ενεργοποιήσετε το Learned Words στο iCloud Sync."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blir kvar på den här enheten om du inte aktiverar inlärda ord i iCloud Sync."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbliver på denne enhed, medmindre du slår Lærde ord til i iCloud Sync."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blir på denne enheten med mindre du slår på Learned Words i iCloud Sync."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysyy tällä laitteella, ellet ota Learned Words -toimintoa käyttöön iCloud Syncissä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap berada di perangkat ini kecuali Anda mengaktifkan Kata yang Dipelajari di Sinkronisasi iCloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn ở trên thiết bị này trừ khi bạn bật Từ đã học trong iCloud Sync."
          }
        }
      }
    },
