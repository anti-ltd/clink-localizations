    "Keys slowly reshape to fit where your fingers really land, learned over days of real typing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasten passen ihre Form langsam daran an, wo deine Finger wirklich landen – gelernt über Tage echten Tippens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas cambian de forma poco a poco para ajustarse a donde caen tus dedos, aprendido durante días de escritura real."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvid muudavad aeglaselt kuju, et sobituda sinna, kuhu su sõrmed tegelikult langevad, õpitud päevade jooksul päris trükkimisest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches se remodèlent peu à peu selon l’endroit où vos doigts tombent vraiment, appris sur des jours de frappe réelle."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk lassan átformálódnak oda, ahová az ujjaid valóban esnek, napokig tartó valódi gépelésből tanulva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti cambiano forma lentamente per adattarsi a dove cadono davvero le dita, imparato in giorni di digitazione reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の入力を何日も学習し、指が本当に当たる位置に合わせてキーの形が少しずつ変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "며칠간의 실제 입력으로 학습해, 손가락이 실제로 닿는 곳에 맞게 키 모양이 천천히 바뀝니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci perlahan-lahan berubah bentuk mengikut tempat jari anda benar-benar mendarat, dipelajari selama beberapa hari menaip sebenar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas mudam de forma aos poucos para se ajustar a onde seus dedos realmente tocam, aprendido em dias de digitação real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши постепенно меняют форму под то, куда на самом деле попадают пальцы, — по итогам нескольких дней реального набора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键会根据手指实际落点慢慢改变形状，通过数天的真实输入学习而来。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastele se remodelează încet pentru a se potrivi acolo unde degetele tale aterizează cu adevărat, învățate de-a lungul zilelor de tastare reală."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toetsen veranderen langzaam van vorm zodat ze passen op de plek waar je vingers echt terechtkomen, zoals je hebt geleerd tijdens dagen van echt typen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵會根據手指實際落點慢慢改變形狀，透過數天的真實輸入學習而來。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutels verander stadig van vorm om te pas by waar jou vingers werklik land; dit word aangeleer oor dae van werklike tikwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisze powoli zmieniają kształt, dopasowując się do miejsca, w którym naprawdę lądują Twoje palce, czego nauczyłeś się przez wiele dni prawdziwego pisania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіші повільно змінюють форму, щоб відповідати дійсному положенню ваших пальців, навчених за дні реального набору тексту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşlar, parmaklarınızın gerçekte dokunduğu yere uyacak şekilde yavaşça yeniden şekillenir ve günlerce süren gerçek yazma deneyimiyle öğrenilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesy se pomalu přetvářejí tak, aby seděly tam, kde vaše prsty skutečně dopadnou, naučené během dnů skutečného psaní."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesy sa pomaly menia, aby sa zmestili tam, kde vaše prsty skutočne pristanú, čo sa naučili počas dní skutočného písania."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πλήκτρα αλλάζουν σιγά-σιγά για να ταιριάζουν στο σημείο που πραγματικά προσγειώνονται τα δάχτυλά σας, που μάθατε για μέρες πραγματικής πληκτρολόγησης."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangenter omformas långsamt för att passa där dina fingrar verkligen landar, lärt sig under dagar av riktigt skrivande."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Taster omformes langsomt, så de passer til, hvor dine fingre virkelig lander, lært over dage med rigtig skrivning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Taster omformes sakte for å passe der fingrene dine virkelig lander, lært over dager med ekte skriving."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäimet muotoutuvat hitaasti niin, että ne sopivat sormesi todelliseen paikkaan, ja ne on opittu päivien aikana kirjoittamalla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol-tombolnya perlahan-lahan dibentuk kembali agar sesuai dengan tempat jari Anda mendarat, yang dipelajari selama berhari-hari saat mengetik sebenarnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím được định hình lại từ từ để vừa với vị trí thực sự của ngón tay bạn, được học qua nhiều ngày gõ phím thực sự."
          }
        }
      }
    },
    "Keys snap instantly to their bloom size with no spring, like the stock keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutels pas onmiddellik na hul blomgrootte sonder veer, soos die voorraadsleutelbord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tasten springen ohne Feder sofort auf ihre volle Größe, wie bei der Standardtastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas saltan al instante a su tamaño ampliado, sin rebote, como el teclado de serie."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvid hüppavad ilma vedruta koheselt oma bloom-suurusesse, nagu süsteemne klaviatuur."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches passent d'un coup à leur taille agrandie sans ressort, comme le clavier d'origine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk rugózás nélkül, azonnal a teljes méretükre ugranak, mint a gyári billentyűzeten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti scattano subito alla loro dimensione ingrandita senza molla, come la tastiera di serie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "純正キーボードのように、キーはバネ感なしで一気に拡大サイズになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 키보드처럼 키가 스프링 없이 곧바로 확대 크기로 바뀌어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci terus lompat ke saiz kembangnya tanpa spring, macam papan kekunci asli."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas saltam logo para o tamanho ampliado, sem mola, como o teclado de fábrica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши мгновенно принимают увеличенный размер без пружины — как на стандартной клавиатуре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键没有弹簧，像系统键盘那样一下放大到展开尺寸。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastele se fixează instantaneu la dimensiunea lor de înflorire fără arc, la fel ca tastatura originală."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toetsen klikken onmiddellijk vast in hun bloeiformaat zonder veer, zoals bij het standaardtoetsenbord."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵沒有彈簧，像系統鍵盤那樣一下放大到展開尺寸。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisze natychmiast przybierają swój rozmiar, bez użycia sprężyny, jak w przypadku standardowej klawiatury."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіші миттєво прив’язуються до свого розміру без пружини, як стандартна клавіатура."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşlar, standart klavyeler gibi yaylanma olmadan anında çiçek boyutlarına oturur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesy se okamžitě zaklapnou na svou velikost bez pružiny, jako je tomu u běžné klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesy sa okamžite prichytia na svoju veľkosť bez pružiny, ako je to na bežnej klávesnici."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πλήκτρα κουμπώνουν αμέσως στο μέγεθος άνθισής τους χωρίς ελατήριο, όπως το πληκτρολόγιο στοκ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nycklar snäpper omedelbart till sin blomstorlek utan fjäder, som det vanliga tangentbordet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Taster klikker øjeblikkeligt til deres blomstrende størrelse uden forår, som det almindelige tastatur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Taster fester seg umiddelbart til blomstringsstørrelsen uten fjær, som et vanlig tastatur."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäimet napsahtavat välittömästi kukintakokoonsa ilman jousta, kuten varastossa oleva näppäimistö."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol langsung masuk ke ukuran mekarnya tanpa pegas, seperti keyboard bawaan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím bấm ngay lập tức đạt kích cỡ vừa phải mà không cần lò xo, giống như bàn phím gốc."
          }
        }
      }
    },
    "Keys swell under your finger as you glide on glass themes. No effect on solid themes.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutels swel onder jou vinger terwyl jy op glastemas gly. Geen effek op vaste temas nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tasten schwellen unter deinem Finger an, wenn du über Glas-Themes gleitest. Bei soliden Themes passiert nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas se agrandan bajo tu dedo al deslizarte por temas de vidrio. No hacen nada en temas sólidos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvid pundavad su sõrme all, kui libised klaasteemadel. Ühtlastel teemadel mõju puudub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches gonflent sous ton doigt quand tu glisses sur les thèmes en verre. Aucun effet sur les thèmes pleins."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk megduzzadnak az ujjad alatt, ahogy üvegtémákon siklasz. A tömör témákra nincs hatással."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti si gonfiano sotto il dito mentre scorri sui temi in vetro. Nessun effetto sui temi pieni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラステーマで指を滑らせると、指の下でキーが膨らみます。ソリッドテーマでは効果はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글래스 테마에서 손가락을 미끄러뜨리면 키가 손가락 아래에서 부풀어요. 솔리드 테마에서는 효과가 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci membengkak di bawah jari anda semasa anda meluncur pada tema kaca. Tiada kesan pada tema pejal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas incham sob o teu dedo enquanto deslizas nos temas de vidro. Não fazem nada nos temas sólidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В стеклянных темах клавиши раздуваются под пальцем во время скольжения. В сплошных темах эффекта нет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在玻璃主题上滑动时，手指下的按键会鼓起来。实色主题没这效果。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastele se umflă sub deget în timp ce aluneci pe teme de sticlă. Niciun efect asupra temelor solide."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toetsen zwellen onder je vinger terwijl je over glazen thema's glijdt. Geen effect op solide thema's."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在玻璃主題上滑動時，手指下的按鍵會鼓起來。實色主題沒這效果。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisze puchną pod Twoim palcem, gdy przesuwasz się po szklanych motywach. Brak wpływu na stałe motywy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіші роздуваються під вашим пальцем, коли ви ковзаєте по скляних темах. Немає впливу на суцільні теми."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cam temalar üzerinde kayarken tuşlar parmağınızın altında şişer. Katı temalar üzerinde etkisi yoktur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při klouzání po skleněných motivech se vám pod prstem nafouknou klávesy. Žádný vliv na pevná témata."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri kĺzaní po sklenených témach sa vám pod prstami nafúknu klávesy. Žiadny vplyv na pevné témy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πλήκτρα φουσκώνουν κάτω από το δάχτυλό σας καθώς γλιστράτε πάνω σε γυάλινα θέματα. Καμία επίδραση σε στερεά θέματα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangenterna sväller under fingret när du glider på glasteman. Ingen effekt på solida teman."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Taster svulmer op under din finger, mens du glider på glastemaer. Ingen effekt på solide temaer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Taster svulmer under fingeren mens du glir på glasstemaer. Ingen effekt på solide temaer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäimet turpoavat sormesi alla, kun liukuvat lasiteemoilla. Ei vaikutusta kiinteisiin teemoihin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol membengkak di bawah jari Anda saat Anda meluncur di atas tema kaca. Tidak ada efek pada tema padat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím phồng lên dưới ngón tay bạn khi bạn lướt trên các chủ đề bằng kính. Không có tác dụng trên các chủ đề vững chắc."
          }
        }
      }
    },
