    "Turn on Analytics in Clink to see your typing here.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel Analytics in Clink aan om jou tik hier te sien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Statistiken in Clink ein, um dein Tippverhalten hier zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las Estadísticas en Clink para ver aquí tu forma de escribir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita Clinkis sisse Statistika, et näha siin oma tipimist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active les Statistiques dans Clink pour voir ta frappe ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a Statisztikát a Clinkben, hogy itt lásd a gépelésedet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le Statistiche in Clink per vedere qui la tua scrittura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkで入力統計をオンにすると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink에서 통계를 켜면 여기서 타이핑 기록을 볼 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Statistik dalam Clink untuk lihat penaipan anda di sini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga as Estatísticas no Clink para veres aqui a tua escrita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Статистику» в Clink, чтобы увидеть здесь свою печать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Clink 中打开统计功能，就能在这里查看你的打字情况。"
          }
        }
      }
    },
    "Turn on Animate backgrounds, on the Backdrop tab, to use these.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel Animeer agtergronde op die Agtergrond-oortjie aan om dit te gebruik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere „Hintergründe animieren“ im Tab „Hintergrund“, um das hier zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Animar fondos, en la pestaña Fondo, para usar esto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita Tausta kaardil sisse Animeeri taustu, et neid kasutada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
