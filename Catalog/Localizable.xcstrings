    "Show tap, drag, and hold cues on the live keyboard while recording tutorials.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra indicadores de toques, arrastres y pulsaciones largas al grabar tutoriales con el teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les appuis, glissements et appuis longs sur le clavier pendant l’enregistrement de tutoriels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Tippen, Ziehen und Gedrückthalten beim Aufnehmen von Anleitungen auf der Tastatur an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra tocchi, trascinamenti e pressioni prolungate sulla tastiera mentre registri tutorial."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra os toques, arrastos e pressões prolongadas no teclado durante a gravação de tutoriais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает касания, перетаскивания и удержания на клавиатуре при записи обучающих видео."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan petunjuk ketik, seret dan tekan lama pada papan kekunci semasa merakam tutorial."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oktatóvideó felvételekor jelzi a koppintást, húzást és nyomva tartást a billentyűzeten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チュートリアルの録画中に、キーボード上のタップ、ドラッグ、長押しを表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制教程时，在键盘上显示轻点、拖动和长按提示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "튜토리얼을 녹화할 때 키보드에 탭, 드래그, 길게 누르기 표시를 보여 줍니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Õpetuse salvestamisel kuvatakse klaviatuuril puudutuste, lohistamiste ja pikkade vajutuste märgid."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișați atingeți, trageți și mențineți apăsat indicații pe tastatura live în timp ce înregistrați tutoriale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon aanwijzingen voor tikken, slepen en vasthouden op het live toetsenbord terwijl u zelfstudies opneemt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製教程時，在鍵盤上顯示輕點、拖動和長按提示。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wys aanwysers vir tik, sleep en hou op die lewendige sleutelbord tydens die opname van tutoriale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuj wskazówki dotyczące dotykania, przeciągania i przytrzymywania na klawiaturze na żywo podczas nagrywania samouczków."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показуйте підказки натискання, перетягування та утримання на живій клавіатурі під час запису навчальних посібників."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eğitimleri kaydederken canlı klavyede dokunma, sürükleme ve basılı tutma ipuçlarını gösterin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při nahrávání výukových programů zobrazte na živé klávesnici narážky klepnutím, přetažením a podržením."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počas nahrávania výukových programov zobrazte na živej klávesnici narážky na klepnutie, potiahnutie a podržanie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση ενδείξεων πατήματος, μεταφοράς και παρατεταμένης λειτουργίας στο ζωντανό πληκτρολόγιο κατά την εγγραφή σεμιναρίων."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa knacka, dra och håll ledtrådar på tangentbordet när du spelar in självstudiekurser."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis tryk, træk og hold signaler på livetastaturet, mens du optager selvstudier."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis trykk, dra og hold signaler på live-tastaturet mens du tar opp veiledninger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä napautus-, vedä- ja painettuna vihjeet live-näppäimistöllä, kun tallennat opetusohjelmia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan isyarat ketuk, seret, dan tahan pada keyboard langsung saat merekam tutorial."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị các tín hiệu nhấn, kéo và giữ trên bàn phím trực tiếp trong khi ghi hướng dẫn."
          }
        }
      }
    },
