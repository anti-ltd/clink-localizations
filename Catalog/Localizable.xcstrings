    "On iOS 26+, AI assist uses Apple Intelligence on your phone.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Op iOS 26+ gebruik KI-hulp Apple Intelligence op jou foon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab iOS 26+ nutzt die KI-Hilfe Apple Intelligence auf deinem Handy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En iOS 26+, la ayuda de IA usa Apple Intelligence en tu teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26+ korral kasutab TI-abistaja sinu telefonis Apple Intelligence’it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur iOS 26+, l'assistance IA utilise Apple Intelligence sur ton téléphone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26-tól az MI-segítség az Apple Intelligence-t használja a telefonodon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su iOS 26+, l'aiuto IA usa Apple Intelligence sul tuo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 以降では、AI アシストは iPhone の中の Apple Intelligence を使います。"
