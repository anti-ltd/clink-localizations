    "Record typing stats. Off by default; you can turn it back on anytime.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teken tikstatistieke op. Af by verstek; jy kan dit enige tyd weer aanskakel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp-Statistiken aufzeichnen. Standardmäßig aus; du kannst es jederzeit wieder einschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra estadísticas de escritura. Desactivado por defecto; puedes volver a activarlo cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvesta tipimisstatistikat. Vaikimisi väljas; sa võid igal ajal tagasi sisse lülitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre les statistiques de frappe. Désactivé par défaut ; tu peux le réactiver à tout moment."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzíti a gépelési statisztikákat. Alapértelmezetten ki van kapcsolva; bármikor visszakapcsolhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra le statistiche di digitazione. Disattivato di default; puoi riattivarlo quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力統計を記録します。デフォルトではオフですが、いつでもオンに戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이핑 통계를 기록해요. 기본값은 꺼짐이고, 언제든 다시 켤 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod statistik menaip. Dimatikan secara lalai; anda boleh hidupkannya semula bila-bila masa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Regista estatísticas de escrita. Desligado por predefinição; podes voltar a ligar quando quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывать статистику печати. По умолчанию выключено, включить можно в любой момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录打字统计数据。默认关闭，随时可以重新打开。"
          }
        }
      }
    },
    "Record where your taps land on each key, per layout & language, to shape the keyboard to you": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teken aan waar jou krane op elke sleutel land, per uitleg en taal, om die sleutelbord vir jou te vorm"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasst, wo deine Tipps auf jeder Taste landen, pro Layout & Sprache, um die Tastatur auf dich anzupassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra dónde caen tus toques en cada tecla, por disposición e idioma, para moldear el teclado a tu medida"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvestab, kuhu sinu vajutused igal klahvil maanduvad, paigutuse ja keele kaupa, et klaviatuur sinuga kohanduks"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre où tes appuis atterrissent sur chaque touche, par disposition et langue, pour adapter le clavier à toi"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzíti, hova esnek a koppintásaid az egyes billentyűkön, elrendezésenként és nyelvenként, hogy hozzád formálja a billentyűzetet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra dove atterrano i tuoi tocchi su ogni tasto, per layout e lingua, per modellare la tastiera su di te"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーでタップがどこに着地するかを、レイアウトと言語ごとに記録して、キーボードをあなたに合わせます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이아웃과 언어별로 각 키에서 탭이 어디에 닿는지 기록해서 키보드를 나에게 맞춰요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod di mana ketikan anda mendarat pada setiap kekunci, ikut susun atur & bahasa, untuk bentukkan papan kekunci mengikut anda"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Regista onde os teus toques caem em cada tecla, por esquema e idioma, para moldar o teclado a ti"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывать, куда попадают ваши нажатия на каждой клавише, отдельно по раскладкам и языкам, чтобы подстроить клавиатуру под вас"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录你在每个键上的落点，按布局和语言分别记，把键盘塑造成适合你的"
          }
        }
      }
    },
