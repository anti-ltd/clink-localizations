    "Tap the letters of your alphabet, in order. They’re added after the letters you already have.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca las letras de tu alfabeto en orden. Se añaden después de las que ya tienes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez les lettres de votre alphabet dans l’ordre. Elles sont ajoutées après celles que vous avez déjà."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe die Buchstaben deines Alphabets der Reihe nach an. Sie werden hinter den vorhandenen eingefügt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca le lettere del tuo alfabeto in ordine. Vengono aggiunte dopo quelle che hai già."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque nas letras do seu alfabeto, em ordem. Elas são adicionadas depois das que você já tem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь букв своего алфавита по порядку. Они добавятся после уже имеющихся."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik huruf abjad anda mengikut urutan. Huruf itu ditambah selepas huruf yang sedia ada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints sorban az ábécéd betűire. A meglévő betűid után kerülnek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルファベットの文字を順番にタップしてください。今ある文字の後ろに追加されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按顺序轻点字母表中的字母。它们会添加在现有字母之后。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알파벳 글자를 순서대로 탭하세요. 이미 있는 글자 뒤에 추가됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta oma tähestiku tähti järjest. Need lisatakse olemasolevate tähtede järele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți literele alfabetului dvs., în ordine. Sunt adăugate după literele pe care le aveți deja."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de letters van je alfabet, in volgorde. Ze worden toegevoegd na de letters die je al hebt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按順序輕點字母表中的字母。它們會新增在現有字母之後。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik die letters van jou alfabet in volgorde. Hulle word bygevoeg na die letters wat jy reeds het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stukaj w litery alfabetu w odpowiedniej kolejności. Są dodawane po literach, które już posiadasz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться букв вашого алфавіту по порядку. Вони додаються після літер, які у вас уже є."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alfabenizdeki harflere sırayla dokunun. Zaten sahip olduğunuz harflerin arkasına eklenirler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na písmena své abecedy v daném pořadí. Jsou přidány za písmena, která již máte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnite na písmená svojej abecedy v poradí. Pridajú sa za písmená, ktoré už máte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε τα γράμματα του αλφαβήτου σας, με τη σειρά. Προστίθενται μετά τα γράμματα που έχετε ήδη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på bokstäverna i ditt alfabet, i ordning. De läggs till efter bokstäverna du redan har."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på bogstaverne i dit alfabet i rækkefølge. De tilføjes efter de bogstaver, du allerede har."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på bokstavene i alfabetet i rekkefølge. De legges til etter bokstavene du allerede har."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta aakkosten kirjaimia järjestyksessä. Ne lisätään jo olemassa olevien kirjainten jälkeen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk huruf alfabet Anda secara berurutan. Mereka ditambahkan setelah huruf yang Anda miliki."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào các chữ cái trong bảng chữ cái của bạn theo thứ tự. Chúng được thêm vào sau những chữ cái bạn đã có."
          }
        }
      }
    },
