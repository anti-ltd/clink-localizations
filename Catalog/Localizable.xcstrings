        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 키보드로 선택됨"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipilih sebagai papan kekunci anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgt som tastaturet ditt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekozen als je toetsenbord"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrana jako Twoja klawiatura"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecionado como o teu teclado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectată ca tastatură"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрана как клавиатура"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybraté ako vaša klávesnica"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valt som ditt tangentbord"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyeniz olarak seçildi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрано як вашу клавіатуру"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chọn làm bàn phím của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选为你的键盘"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選為你的鍵盤"
          }
        }
      }
    },
    "Subscriptions renew automatically until you cancel. Manage or cancel in the Play Store app › Payments & subscriptions › Subscriptions. A free trial (if offered) converts to a paid subscription unless cancelled during the trial.": {
      "comment": "Android-only copy for the companion app (batch B4: onboarding, setup, paywall), replacing iOS settings paths, Full Access and the App Store with their Android and Google Play counterparts. Translations drafted for the Android port; native-speaker review required before release. Add to clink-index.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Intekeninge hernu outomaties totdat jy kanselleer. Bestuur of kanselleer in die Play Winkel-app › Betalings en intekeninge › Intekeninge. ’n Gratis proeftydperk (indien aangebied) word ’n betaalde intekening tensy dit tydens die proeftydperk gekanselleer word."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předplatné se automaticky obnovuje, dokud ho nezrušíte. Spravovat nebo zrušit ho můžete v aplikaci Obchod Play › Platby a předplatná › Předplatná. Bezplatná zkušební verze (pokud je nabízena) přejde v placené předplatné, pokud ji během zkušební doby nezrušíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementer fornyes automatisk, indtil du opsiger dem. Administrer eller opsig i Play Butik-appen › Betalinger og abonnementer › Abonnementer. En gratis prøveperiode (hvis den tilbydes) bliver til et betalt abonnement, medmindre den opsiges i prøveperioden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos verlängern sich automatisch, bis du kündigst. Verwalten oder kündigen kannst du in der Play Store App › Zahlungen und Abos › Abos. Eine kostenlose Testphase (falls angeboten) wird zum kostenpflichtigen Abo, wenn du nicht während der Testphase kündigst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συνδρομές ανανεώνονται αυτόματα μέχρι να τις ακυρώσετε. Διαχειριστείτε ή ακυρώστε τες στην εφαρμογή Play Store › Πληρωμές και συνδρομές › Συνδρομές. Μια δωρεάν δοκιμή (αν προσφέρεται) μετατρέπεται σε συνδρομή επί πληρωμή, εκτός αν ακυρωθεί κατά τη διάρκεια της δοκιμής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción se renueva automáticamente hasta que la canceles. Puedes gestionarla o cancelarla en la app Play Store › Pagos y suscripciones › Suscripciones. Si hay una prueba gratis, pasará a ser de pago salvo que la canceles durante la prueba."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tellimused uuenevad automaatselt, kuni sa need tühistad. Halda või tühista Play poe rakenduses › Maksed ja tellimused › Tellimused. Tasuta proov (kui see on pakutud) muutub tasuliseks tellimuseks, kui sa seda proovi ajal ei tühista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaukset uusiutuvat automaattisesti, kunnes peruutat ne. Hallinnoi tai peruuta Play Kauppa -sovelluksessa › Maksut ja tilaukset › Tilaukset. Ilmainen kokeilujakso (jos tarjolla) muuttuu maksulliseksi tilaukseksi, ellei sitä peruuteta kokeilun aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abonnement se renouvelle automatiquement jusqu’à ce que tu l’annules. Tu peux le gérer ou l’annuler dans l’app Play Store › Paiements et abonnements › Abonnements. Si un essai gratuit est proposé, il devient payant sauf si tu l’annules pendant l’essai."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előfizetés automatikusan megújul, amíg le nem mondod. A Play Áruház alkalmazásban, a Fizetések és előfizetések › Előfizetések alatt kezelheted vagy mondhatod le. Az ingyenes próba (ha van) fizetős előfizetéssé válik, ha a próba alatt nem mondod le."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan diperpanjang otomatis sampai Anda membatalkannya. Kelola atau batalkan di aplikasi Play Store › Pembayaran & langganan › Langganan. Uji coba gratis (jika ditawarkan) akan menjadi langganan berbayar kecuali dibatalkan selama masa uji coba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abbonamento si rinnova automaticamente finché non lo annulli. Puoi gestirlo o annullarlo nell’app Play Store › Pagamenti e abbonamenti › Abbonamenti. Se è prevista una prova gratuita, diventa un abbonamento a pagamento se non la annulli durante la prova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解約するまでサブスクリプションは自動更新されます。Play ストア アプリ › お支払いと定期購入 › 定期購入 で管理または解約できます。無料トライアルがある場合、トライアル期間中に解約しなければ有料サブスクリプションに移行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 취소할 때까지 자동으로 갱신돼요. Play 스토어 앱 › 결제 및 구독 › 구독에서 관리하거나 취소할 수 있어요. 무료 체험이 제공되는 경우 체험 기간에 취소하지 않으면 유료 구독으로 전환돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan diperbaharui secara automatik sehingga anda membatalkannya. Urus atau batalkan dalam app Play Store › Pembayaran & langganan › Langganan. Percubaan percuma, jika ditawarkan, akan menjadi langganan berbayar melainkan dibatalkan semasa tempoh percubaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementer fornyes automatisk til du sier dem opp. Administrer eller si opp i Play Butikk-appen › Betalinger og abonnementer › Abonnementer. En gratis prøveperiode (hvis den tilbys) blir til et betalt abonnement med mindre den sies opp i prøveperioden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementen worden automatisch verlengd totdat je opzegt. Beheer of zeg op in de Play Store-app › Betalingen en abonnementen › Abonnementen. Een gratis proefperiode (indien aangeboden) wordt een betaald abonnement, tenzij je tijdens de proefperiode opzegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcje odnawiają się automatycznie do czasu anulowania. Zarządzaj nimi lub anuluj je w aplikacji Sklep Play › Płatności i subskrypcje › Subskrypcje. Bezpłatny okres próbny (jeśli jest oferowany) zmienia się w płatną subskrypcję, chyba że zostanie anulowany w jego trakcie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As subscrições renovam-se automaticamente até as cancelares. Podes gerir ou cancelar na app Play Store › Pagamentos e subscrições › Subscrições. Se houver um teste grátis, passa a subscrição paga se não o cancelares durante o teste."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonamentele se reînnoiesc automat până le anulezi. Gestionează sau anulează din aplicația Magazin Play › Plăți și abonamente › Abonamente. O perioadă de probă gratuită (dacă este oferită) devine abonament plătit, dacă nu este anulată în timpul perioadei de probă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписки продлеваются автоматически, пока вы их не отмените. Управление и отмена — в приложении Play Маркет › Платежи и подписки › Подписки. Бесплатный период (если предложен) переходит в платную подписку, если не отменить его во время пробного периода."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predplatné sa automaticky obnovuje, kým ho nezrušíte. Spravovať alebo zrušiť ho môžete v aplikácii Obchod Play › Platby a predplatné › Predplatné. Bezplatná skúšobná verzia (ak sa ponúka) prejde na platené predplatné, ak ju počas skúšobného obdobia nezrušíte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumerationer förnyas automatiskt tills du säger upp dem. Hantera eller säg upp i Play Butik-appen › Betalningar och prenumerationer › Prenumerationer. En kostnadsfri provperiod (om den erbjuds) övergår till en betald prenumeration om den inte sägs upp under provperioden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelikler siz iptal edene kadar otomatik olarak yenilenir. Play Store uygulaması › Ödemeler ve abonelikler › Abonelikler bölümünden yönetin veya iptal edin. Ücretsiz deneme (sunuluyorsa), deneme süresinde iptal edilmezse ücretli aboneliğe dönüşür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підписки поновлюються автоматично, доки ви їх не скасуєте. Керувати ними чи скасувати можна в застосунку Play Маркет › Платежі й підписки › Підписки. Безкоштовний пробний період (якщо пропонується) переходить у платну підписку, якщо його не скасувати до завершення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói đăng ký tự động gia hạn cho đến khi bạn hủy. Quản lý hoặc hủy trong ứng dụng Cửa hàng Play › Thanh toán và gói đăng ký › Gói đăng ký. Bản dùng thử miễn phí (nếu có) sẽ chuyển thành gói đăng ký trả phí trừ khi bạn hủy trong thời gian dùng thử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅会自动续订，直到你取消为止。可在 Play 商店应用 ›“付款和订阅”›“订阅”中管理或取消。若提供免费试用，在试用期内未取消则会转为付费订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱會自動續訂，直到你取消為止。請在 Play 商店 App › 付款和訂閱 › 訂閱中管理或取消。免費試用（如有提供）若未在試用期間取消，將轉為付費訂閱。"
          }
        }
      }
    },
    "Turn Clink on once in Android’s keyboard settings and it joins this list.": {
      "comment": "Android-only copy for the companion app (batch B4: onboarding, setup, paywall), replacing iOS settings paths, Full Access and the App Store with their Android and Google Play counterparts. Translations drafted for the Android port; native-speaker review required before release. Add to clink-index.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel Clink een keer aan in Android se sleutelbordinstellings, en dit verskyn in hierdie lys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednou zapněte Clink v nastavení klávesnice Androidu a objeví se v tomto seznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Clink til én gang i Androids tastaturindstillinger, så kommer det med på denne liste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Clink einmal in den Tastatureinstellungen von Android, dann erscheint es in dieser Liste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε το Clink μία φορά στις ρυθμίσεις πληκτρολογίου του Android και θα εμφανιστεί σε αυτή τη λίστα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Clink una vez en los ajustes de teclado de Android y aparecerá en esta lista."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita Clink üks kord Androidi klaviatuuriseadetes sisse ja see ilmub sellesse loendisse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota Clink kerran käyttöön Androidin näppäimistöasetuksissa, niin se tulee tähän luetteloon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active Clink une fois dans les réglages de clavier d’Android et il rejoindra cette liste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be egyszer a Clinket az Android billentyűzet-beállításaiban, és megjelenik ebben a listában."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan Clink sekali di setelan keyboard Android, lalu Clink akan muncul di daftar ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Clink una volta nelle impostazioni della tastiera di Android e comparirà in questo elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android のキーボード設定で一度 Clink をオンにすると、この一覧に加わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 키보드 설정에서 Clink를 한 번 켜면 이 목록에 추가돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Clink sekali dalam tetapan papan kekunci Android dan ia akan menyertai senarai ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Clink én gang i Androids tastaturinnstillinger, så kommer det med i denne listen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Clink één keer aan in de toetsenbordinstellingen van Android en het verschijnt in deze lijst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Clink raz w ustawieniach klawiatury Androida, a pojawi się na tej liście."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa o Clink uma vez nas definições de teclado do Android e ele passa a fazer parte desta lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează Clink o dată în setările de tastatură Android și apare în această listă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Clink один раз в настройках клавиатуры Android, и он появится в этом списке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Raz zapnite Clink v nastaveniach klávesnice Androidu a objaví sa v tomto zozname."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Clink en gång i Androids tangentbordsinställningar så hamnar det i den här listan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink’i Android’in klavye ayarlarında bir kez açın, bu listeye eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Clink один раз у налаштуваннях клавіатури Android, і він з’явиться в цьому списку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Clink một lần trong cài đặt bàn phím của Android, nó sẽ xuất hiện trong danh sách này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Android 的键盘设置中开启一次 Clink，它就会出现在这个列表中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要在 Android 的鍵盤設定中開啟 Clink 一次，它就會出現在此清單中。"
          }
        }
      }
    },
    "Your purchase is pending. Clink Pro unlocks once Google Play confirms the payment.": {
      "comment": "Android-only copy for the companion app (batch B4: onboarding, setup, paywall), replacing iOS settings paths, Full Access and the App Store with their Android and Google Play counterparts. Translations drafted for the Android port; native-speaker review required before release. Add to clink-index.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou aankoop is hangende. Clink Pro word ontsluit sodra Google Play die betaling bevestig."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš nákup čeká na vyřízení. Clink Pro se odemkne, jakmile Google Play potvrdí platbu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit køb afventer. Clink Pro låses op, så snart Google Play bekræfter betalingen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf ist ausstehend. Clink Pro wird freigeschaltet, sobald Google Play die Zahlung bestätigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αγορά σας εκκρεμεί. Το Clink Pro ξεκλειδώνεται μόλις το Google Play επιβεβαιώσει την πληρωμή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente. Clink Pro se desbloqueará cuando Google Play confirme el pago."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu ost on ootel. Clink Pro avatakse, kui Google Play makse kinnitab."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostoksesi odottaa. Clink Pro avautuu, kun Google Play vahvistaa maksun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton achat est en attente. Clink Pro se débloque dès que Google Play confirme le paiement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlásod függőben van. A Clink Pro akkor nyílik meg, amikor a Google Play megerősíti a fizetést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian Anda tertunda. Clink Pro terbuka setelah Google Play mengonfirmasi pembayaran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è in sospeso. Clink Pro si sblocca quando Google Play conferma il pagamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は保留中です。Google Play が支払いを確認すると Clink Pro のロックが解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매가 대기 중이에요. Google Play가 결제를 확인하면 Clink Pro가 잠금 해제돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian anda belum selesai. Clink Pro dibuka sebaik sahaja Google Play mengesahkan bayaran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet ditt venter. Clink Pro låses opp når Google Play bekrefter betalingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop is in behandeling. Clink Pro wordt ontgrendeld zodra Google Play de betaling bevestigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup oczekuje na realizację. Clink Pro odblokuje się, gdy Google Play potwierdzi płatność."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua compra está pendente. O Clink Pro fica desbloqueado assim que o Google Play confirmar o pagamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziția ta este în așteptare. Clink Pro se deblochează după ce Google Play confirmă plata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка ожидает подтверждения. Clink Pro откроется, как только Google Play подтвердит оплату."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš nákup čaká na vybavenie. Clink Pro sa odomkne, keď Google Play potvrdí platbu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt köp väntar. Clink Pro låses upp när Google Play bekräftar betalningen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma işleminiz beklemede. Google Play ödemeyi onayladığında Clink Pro’nun kilidi açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша покупка очікує підтвердження. Clink Pro розблокується, щойно Google Play підтвердить оплату."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch mua của bạn đang chờ xử lý. Clink Pro sẽ mở khóa khi Google Play xác nhận thanh toán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的购买正在处理中。Google Play 确认付款后，Clink Pro 即会解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的購買交易正在處理中。Google Play 確認付款後即會解鎖 Clink Pro。"
          }
        }
      }
    },
