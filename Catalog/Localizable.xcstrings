    "Add Clink once under Third-Party Keyboards and it lands in this list.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Clink einmal unter Tastaturen von Drittanbietern hinzu, dann taucht es in dieser Liste auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade Clink una vez en Teclados de terceros y aparecerá en esta lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute Clink une fois dans Claviers tiers et il apparaîtra dans cette liste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add hozzá a Clinket egyszer a Külső billentyűzetek alatt, és megjelenik ebben a listában."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi Clink una volta in Tastiere di terze parti e comparirà in questa lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「他社製キーボード」で Clink を一度追加すると、このリストに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타사 키보드에서 Clink를 한 번 추가하면 이 목록에 나타나요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah Clink sekali di bawah Papan Kekunci Pihak Ketiga dan ia akan muncul dalam senarai ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona o Clink uma vez em Teclados de terceiros e ele aparece nesta lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз добавьте Clink в разделе «Сторонние клавиатуры» — и он появится в этом списке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“第三方键盘”里添加一次 Clink，它就会出现在这个列表中。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa Clink üks kord kolmanda osapoole klaviatuuride alla ja see ilmub sellesse loendisse."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg Clink een keer onder derdeparty-sleutelborde by en dit beland in hierdie lys."
          }
        }
      }
    },
