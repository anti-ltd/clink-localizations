    "Unlock the tools and customization that turn Clink into your personal keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontsluit die gereedskap en aanpassing wat Clink in jou persoonlike sleutelbord verander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte die Werkzeuge und Anpassungen frei, die Clink zu deiner persönlichen Tastatur machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea las herramientas y la personalización que hacen de Clink tu teclado personal."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava tööriistad ja kohandused, mis teevad Clinkist sinu isikliku klaviatuuri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquez les outils et la personnalisation qui font de Clink votre clavier personnel."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldd fel az eszközöket és testreszabást, amelyek a Clinket a személyes billentyűzeteddé teszik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca gli strumenti e la personalizzazione che rendono Clink la tua tastiera personale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkを自分だけのキーボードにするツールとカスタマイズを使えるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink을 나만의 키보드로 만드는 도구와 사용자화 기능을 잠금 해제하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kunci alat dan penyesuaian yang menjadikan Clink papan kekunci peribadi anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueia as ferramentas e a personalização que fazem do Clink o teu teclado pessoal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте инструменты и настройку, которые превратят Clink в вашу личную клавиатуру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁工具和自定义功能，让 Clink 成为你的专属键盘。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deblocați instrumentele și personalizarea care transformă Clink în tastatura dvs. personală."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel de tools en aanpassingen die van Clink uw persoonlijke toetsenbord maken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖工具和自定義功能，讓 Clink 成為你的專屬鍵盤。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj narzędzia i możliwości dostosowywania, dzięki którym Clink stanie się Twoją osobistą klawiaturą."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте інструменти та налаштування, які перетворюють Clink на вашу персональну клавіатуру."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink'i kişisel klavyenize dönüştüren araçların ve özelleştirmenin kilidini açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odemkněte nástroje a přizpůsobení, které změní Clink na vaši osobní klávesnici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odomknite nástroje a prispôsobenia, ktoré premenia Clink na vašu osobnú klávesnicu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκλειδώστε τα εργαλεία και την προσαρμογή που μετατρέπουν το Clink στο προσωπικό σας πληκτρολόγιο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås upp verktygen och anpassningen som gör Clink till ditt personliga tangentbord."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås op for værktøjerne og tilpasningen, der gør Clink til dit personlige tastatur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås opp verktøyene og tilpasningen som gjør Clink til ditt personlige tastatur."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa työkalut ja mukautukset, jotka tekevät Clink:stä henkilökohtaisen näppäimistösi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kunci alat dan penyesuaian yang mengubah Clink menjadi keyboard pribadi Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khóa các công cụ và tùy chỉnh biến Clink thành bàn phím cá nhân của bạn."
          }
        }
      }
    },
    "Unlocked for life. Thanks for being here early": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lewens lank ontsluit. Dankie dat jy vroeg hier was"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für immer freigeschaltet. Danke, dass du so früh dabei warst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueado para siempre. Gracias por estar aquí desde el principio"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Avatud eluaegselt. Aitäh, et olid nii vara siin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillé à vie. Merci d'avoir été là dès le début"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Örökre feloldva. Köszönöm, hogy már korán itt voltál"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbloccato per sempre. Grazie di esserci stato fin dall'inizio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ずっとアンロック済み。最初からいてくれてありがとう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평생 잠금 해제. 처음부터 함께해 주셔서 고마워요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuka selamanya. Terima kasih kerana ada sejak awal"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueado para sempre. Obrigado por estares aqui desde o início"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокировано навсегда. Спасибо, что вы были с нами с самого начала"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已终身解锁。谢谢你从一开始就在这里"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deblocat pe viață. Mulțumesc că ai fost aici devreme"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendeld voor het leven. Bedankt dat je hier vroeg was"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已終身解鎖。謝謝你從一開始就在這裡"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokowany na całe życie. Dziękuję, że byłeś tu wcześniej"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблоковано на все життя. Дякую, що прийшли раніше"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ömür boyu kilidi açıldı. Erken geldiğin için teşekkürler"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odemčeno na celý život. Díky, že jste tu brzy"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odomknutý na celý život. Ďakujem, že ste tu skoro"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκλείδωτο για μια ζωή. Ευχαριστώ που ήσασταν εδώ νωρίς"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upplåst för livet. Tack för att du var här tidigt"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Låst op for livet. Tak fordi du var her tidligt"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Låst opp for livet. Takk for at du var her tidlig"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avattu koko elämäksi. Kiitos, että olit täällä aikaisin"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak terkunci seumur hidup. Terima kasih sudah datang lebih awal"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã mở khóa trọn đời. Cảm ơn vì đã đến đây sớm"
          }
        }
      }
    },
