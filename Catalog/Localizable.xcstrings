        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào nút ngôn ngữ ở cuối thanh gợi ý để tìm ngôn ngữ tiếp theo hoặc giữ nút đó để chọn một ngôn ngữ."
