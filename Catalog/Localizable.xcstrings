    "Restart from the top after the last phrase": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Herbegin van bo na die laaste frase"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der letzten Phrase wieder von vorn anfangen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar de nuevo desde arriba tras la última frase"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alusta pärast viimast fraasi uuesti ülevalt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repartir du début après la dernière phrase"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdje elölről az utolsó mondat után"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricomincia dall'inizio dopo l'ultima frase"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後のフレーズのあと、最初から再生し直します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 구문까지 가면 처음부터 다시 시작"
