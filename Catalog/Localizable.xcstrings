    "Fix the word when you type a space or punctuation.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maak die woord reg wanneer jy 'n spasie of leesteken tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigiert das Wort, sobald du ein Leerzeichen oder Satzzeichen tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige la palabra al escribir un espacio o un signo de puntuación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Parandab sõna, kui tipid tühiku või kirjavahemärgi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige le mot quand tu tapes une espace ou un signe de ponctuation."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Javítja a szót, amikor szóközt vagy írásjelet írsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corregge la parola quando digiti uno spazio o un segno di punteggiatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースや句読点を入力したときに単語を直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "띄어쓰기나 문장 부호를 입력하면 단어를 고쳐줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Betulkan perkataan bila anda taip ruang atau tanda baca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige a palavra quando escreves um espaço ou pontuação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправлять слово, когда вы ставите пробел или знак препинания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入空格或标点时，帮你把词改对。"
          }
        }
      }
    },
    "Fix typos as you type, in the languages you have turned on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigiert Tippfehler beim Tippen, in den Sprachen, die du eingeschaltet hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige erratas mientras escribes, en los idiomas que tienes activados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Parandab näpuvead tipimise ajal nendes keeltes, mille oled sisse lülitanud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige les fautes de frappe pendant que tu tapes, dans les langues que tu as activées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gépelés közben javítja az elgépeléseket a bekapcsolt nyelveiden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corregge i refusi mentre scrivi, nelle lingue che hai attivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにしている言語で、入力しながら打ち間違いを直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜 둔 언어에서 입력하는 동안 오타를 고쳐요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membetulkan silap taip semasa anda menaip, dalam bahasa yang anda hidupkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige gralhas enquanto escreves, nos idiomas que tens ligados."
