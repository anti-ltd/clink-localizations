            "value": "Ведите по пробелу, чтобы перемещать курсор"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动空格键移动光标"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisați bara de spațiu pentru a muta cursorul"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschuif de spatiebalk om de cursor te verplaatsen"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑動空格鍵移動游標"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń spację, aby przesunąć kursor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведіть пальцем по пробілу, щоб перемістити курсор"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmleci hareket ettirmek için boşluk çubuğunu kaydırın"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posunutím mezerníku přesunete kurzor"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzor presuniete posunutím medzerníka"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε το πλήκτρο διαστήματος για να μετακινήσετε τον κέρσορα"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra mellanslagstangenten för att flytta markören"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skub mellemrumstasten for at flytte markøren"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skyv mellomromstasten for å flytte markøren"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä kohdistinta liu'uttamalla välilyöntinäppäintä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser bilah spasi untuk memindahkan kursor"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trượt thanh dấu cách để di chuyển con trỏ"
          }
        }
      }
    },
    "Slide the space bar toward the thumb opposite your last key: tap a right-side letter and space hops left, so the free thumb hits it. Recenters after a space.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skuif die spasiebalk na die duim oorkant jou laaste sleutel: tik 'n letter aan die regterkant en spasie hop links, sodat die vrye duim dit tref. Hersentreer na 'n spasie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiebt die Leertaste zum Daumen gegenüber deiner letzten Taste: tipp einen Buchstaben rechts und die Leertaste springt nach links, damit der freie Daumen sie trifft. Zentriert sich nach einem Leerzeichen wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza la barra espaciadora hacia el pulgar opuesto a tu última tecla: toca una letra del lado derecho y el espacio salta a la izquierda, para que lo pulse el pulgar libre. Se recentra después de un espacio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Libistab tühikuklahvi vastaskäe pöidla poole: vajuta parempoolset tähte ja tühik hüppab vasakule, nii et vaba pöial teda tabab. Taasesastub pärast tühikut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace la barre d'espace vers le pouce opposé à ta dernière touche : appuie sur une lettre de droite et l'espace saute à gauche, pour que le pouce libre l'atteigne. Se recentre après une espace."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szóközt az utolsó billentyűddel ellentétes hüvelykujj felé csúsztatja: koppints egy jobb oldali betűre, és a szóköz balra ugrik, hogy a szabad hüvelykujj érje el. Szóköz után visszaközépre áll."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai scorrere la barra spaziatrice verso il pollice opposto al tuo ultimo tasto: tocca una lettera a destra e lo spazio salta a sinistra, così il pollice libero lo raggiunge. Si ricentra dopo uno spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースバーを、最後に押したキーと反対の親指の方へ寄せます。右側の文字を押すとスペースが左に移り、空いた親指で押せます。スペースを入力すると中央に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 바를 마지막 키의 반대쪽 엄지로 밀어요. 오른쪽 글자를 누르면 스페이스가 왼쪽으로 뛰어서 노는 엄지가 누를 수 있어요. 스페이스를 치면 다시 가운데로 와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Luncurkan bar ruang ke arah ibu jari bertentangan dengan kekunci terakhir anda: ketik huruf sebelah kanan dan ruang melompat ke kiri, supaya ibu jari yang bebas menekannya. Berpusat semula selepas ruang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a barra de espaços para o polegar oposto à tua última tecla: toca numa letra do lado direito e o espaço salta para a esquerda, para o polegar livre lhe acertar. Volta ao centro depois de um espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сдвигать пробел к тому большому пальцу, который противоположен последней клавише: нажали букву справа — пробел уходит влево, под свободный палец. После пробела он возвращается в центр."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把空格键往你上一个键的另一只拇指那侧滑：点右边的字母，空格就跳到左边，让空着的拇指去点。按下空格后重新居中。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisați bara de spațiu spre degetul mare opus ultimei taste: atingeți o literă din partea dreaptă și spațiul sare spre stânga, astfel încât degetul mare liber îl lovește. Recentrează după un spațiu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schuif de spatiebalk naar de duim tegenover uw laatste toets: tik op een letter aan de rechterkant en de spatie springt naar links, zodat de vrije duim deze raakt. Recenters na een spatie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把空格鍵往你上一個鍵的另一隻拇指那側滑：點右邊的字母，空格就跳到左邊，讓空著的拇指去點。按下空格後重新居中。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń spację w kierunku kciuka naprzeciwko ostatniego klawisza: dotknij litery po prawej stronie, a spacja przeskoczy w lewo, tak aby wolny kciuk trafił w nią. Wyśrodkowuje po spacji."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемістіть пробіл у бік великого пальця навпроти останньої клавіші: торкніться літери правого боку, і пробіл перескочить ліворуч, щоб вільний великий палець торкнувся її. Повторне центрування після пробілу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluk çubuğunu son tuşunuzun karşısındaki başparmağınıza doğru kaydırın: sağ taraftaki bir harfe dokunduğunuzda boşluk sola atlar, böylece serbest başparmak ona çarpar. Bir boşluktan sonra yeniden başlayanlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuňte mezerník směrem k palci naproti vaší poslední klávese: klepněte na písmeno na pravé straně a mezerník poskočí doleva, takže na něj narazí volný palec. Středuje za mezerou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuňte medzerník smerom k palcu oproti poslednému klávesu: ťuknite na písmeno na pravej strane a medzerník poskočí doľava, aby naň narazil voľný palec. Centruje za medzerou."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε το πλήκτρο διαστήματος προς τον αντίχειρα απέναντι από το τελευταίο σας πλήκτρο: αγγίξτε ένα γράμμα στη δεξιά πλευρά και μεταπηδήστε το διάστημα προς τα αριστερά, ώστε ο ελεύθερος αντίχειρας να το χτυπήσει. Επικεντρώνεται μετά από ένα διάστημα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjut mellanslagstangenten mot tummen mittemot din senaste tangent: tryck på en bokstav på höger sida och mellanslag hoppar åt vänster så att den lediga tummen träffar den. Centrerar om efter ett mellanslag."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skub mellemrumstasten mod tommelfingeren modsat din sidste tast: Tryk på et bogstav i højre side, og mellemrum hopper til venstre, så den ledige tommelfinger rammer den. Gencentrerer efter et mellemrum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skyv mellomromstasten mot tommelen på motsatt side av den siste tasten: trykk på en bokstav på høyre side og mellomrom hopper til venstre, så den ledige tommelen treffer den. Sentrerer på nytt etter et mellomrom."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liu'uta välilyöntiä viimeistä näppäintä vastapäätä olevaa peukaloa kohti: napauta oikeanpuoleista kirjainta ja välilyönti hyppää vasemmalle, jotta vapaa peukalo osuu siihen. Recenters after a space."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser bilah spasi ke arah ibu jari di seberang tombol terakhir Anda: ketuk huruf di sisi kanan dan lompat spasi ke kiri, sehingga ibu jari yang bebas menyentuhnya. Memusatkan kembali setelah spasi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trượt thanh dấu cách về phía ngón cái đối diện với phím cuối cùng của bạn: chạm vào một chữ cái bên phải và dấu cách nhảy sang trái để ngón cái tự do chạm vào nó. Gần đây sau một khoảng trắng."
          }
        }
      }
    },
