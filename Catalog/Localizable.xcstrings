          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback neemt een korte pauze. Probeer het over een paar minuten opnieuw."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "反饋暫時休息一下。請幾分鐘後再試。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Terugvoer neem 'n kort blaaskans. Probeer weer oor 'n paar minute."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacja zwrotna ma krótką przerwę. Spróbuj ponownie za kilka minut."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
