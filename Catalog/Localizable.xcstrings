          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтение и замена содержимого буфера обмена. Нужен полный доступ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca dan gantikan kandungan papan klip. Memerlukan Akses Penuh."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágólap tartalmának olvasása és cseréje. Teljes hozzáférés szükséges."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードの内容を読み取り、置き換えます。フルアクセスが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
