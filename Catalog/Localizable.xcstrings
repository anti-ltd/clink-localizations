          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-søgning har nået sin timegrænse. Prøv igen senere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-søk har nådd timegrensen. Prøv igjen senere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-haku on saavuttanut tuntirajansa. Yritä myöhemmin uudelleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencarian GIF telah mencapai batas per jamnya. Coba lagi nanti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm GIF đã đạt đến giới hạn hàng giờ. Hãy thử lại sau."
          }
        }
      }
    },
