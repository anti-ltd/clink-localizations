    "Type a shortcut, press space, and Clink inserts the phrase. Stays on this device; overrides Settings → Keyboard shortcuts on conflict.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe das Kürzel, drücke die Leertaste, und Clink setzt den Ausdruck ein. Bleibt auf diesem Gerät und geht bei gleichem Kürzel den Einstellungen vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe el atajo, pulsa espacio y Clink inserta la frase. Se queda en este dispositivo y tiene prioridad sobre los atajos de Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tape le raccourci, appuie sur espace et Clink insère l'expression. Reste sur cet appareil et l'emporte sur les raccourcis des Réglages."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd be a rövidítést, nyomj szóközt, és a Clink beszúrja a kifejezést. Ezen az eszközön marad, és ütközés esetén felülírja a Beállítások rövidítéseit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi la scorciatoia, premi spazio e Clink inserisce la frase. Resta su questo dispositivo e ha la precedenza sulle scorciatoie di Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを入力してスペースを押すと、フレーズが挿入されます。この端末に留まり、重複時は「設定」のショートカットより優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어를 입력하고 스페이스를 누르면 문구가 삽입됩니다. 이 기기에만 저장되고, 겹칠 때는 설정의 단축어보다 우선합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip pintasan, tekan space, dan Clink memasukkan frasa itu. Kekal pada peranti ini dan mengatasi pintasan dalam Tetapan jika bertindih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve o atalho, carrega no espaço e o Clink insere a frase. Fica neste dispositivo e prevalece sobre os atalhos dos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наберите сокращение, нажмите пробел — и Clink вставит фразу. Остаётся на этом устройстве; при конфликте перебивает системные сокращения из Настроек → «Клавиатура»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入快捷方式再按空格，Clink 就会插入短语。只保存在这台设备上，冲突时优先于“设置”里的快捷方式。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipi otsetee, vajuta tühikut ja Clink sisestab fraasi. Jääb sellesse seadmesse; konfliktis alistab Seaded → Klaviatuuri otseteed."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik 'n kortpad, druk spasie, en Clink voeg die frase in. Bly op hierdie toestel; ignoreer Instellings → Sleutelbordkortpaaie op konflik."
          }
        }
      }
    },
