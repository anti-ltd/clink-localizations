    "Runs just inside the edge, on the key itself.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Loop net binne die rand, op die sleutel self."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verläuft knapp innerhalb der Kante, auf der Taste selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Va justo por dentro del borde, sobre la propia tecla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulgeb vahetult servast seespool, klahvil endal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe juste à l’intérieur du bord, sur la touche elle-même."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyű szélén belül fut, magán a billentyűn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corre appena dentro il bordo, sul tasto stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの縁のすぐ内側、キーの上を通ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 가장자리 바로 안쪽, 키 위를 지나가요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan betul-betul di dalam bibir kekunci, pada kekunci itu sendiri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa mesmo por dentro do bordo, na própria tecla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идёт по внутреннему краю, по самой клавише."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿着按键边缘内侧走，画在按键上。"
          }
        }
      }
    },
    "Runs just outside the edge, so the key keeps its full size.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Loop net buite die rand, so die sleutel behou sy volle grootte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verläuft knapp außerhalb der Kante, sodass die Taste ihre volle Größe behält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Va justo por fuera del borde, así la tecla conserva todo su tamaño."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulgeb vahetult servast väljaspool, nii et klahv hoiab oma täissuuruse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe juste à l’extérieur du bord : la touche garde toute sa taille."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyű szélén kívül fut, így a billentyű megtartja a teljes méretét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corre appena fuori dal bordo, così il tasto resta grande com’è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの縁のすぐ外側を通るので、キーの大きさはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 가장자리 바로 바깥을 지나서, 키 크기는 그대로예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan betul-betul di luar bibir kekunci, jadi saiz kekunci kekal penuh."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa mesmo por fora do bordo, por isso a tecla mantém o tamanho todo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идёт по внешнему краю, поэтому клавиша сохраняет полный размер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿着按键边缘外侧走，按键还是原来的大小。"
          }
        }
      }
    },
