        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viipa tekstiklipp paremale, et see Clingi rakenduses märkmena kinnitada. Vajab täisjuurdepääsu."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Swiep 'n tekssnit regs om dit as 'n nota in die Cling-toepassing vas te pen. Vereis volle toegang."
          }
        }
      }
    },
    "Swipe across the keys to type a word": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza por las teclas para escribir una palabra"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse sur les touches pour écrire un mot"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über die Tasten wischen, um ein Wort zu schreiben"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri sui tasti per scrivere una parola"
          }
        },
        "pt": {
