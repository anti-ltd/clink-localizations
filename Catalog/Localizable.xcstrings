    "A language key beside the space bar: tap to switch, hold to pick (separate mode)": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Taalsleutel langs die spasiebalk: tik om te wissel, hou om te kies (afsonderlike modus)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sprachtaste neben der Leertaste: tippen zum Wechseln, halten zum Auswählen (getrennter Modus)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tecla de idioma junto a la barra espaciadora: toca para cambiar, mantén pulsado para elegir (modo aparte)"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeleklahv tühikuklahvi kõrval: puuduta vahetamiseks, hoia valimiseks (eraldi režiim)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une touche de langue à côté de la barre d'espace : touche pour changer, maintiens pour choisir (mode séparé)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy nyelvbillentyű a szóköz mellett: koppints a váltáshoz, tartsd nyomva a választáshoz (külön mód)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tasto lingua accanto alla barra spaziatrice: tocca per cambiare, tieni premuto per scegliere (modalità separata)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースバーの横に言語キー。タップで切り替え、長押しで選択（別モード）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 바 옆의 언어 키: 탭하면 전환, 길게 누르면 선택(별도 모드)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci bahasa di sebelah bar ruang: ketik untuk tukar, tahan untuk pilih (mod berasingan)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tecla de idioma ao lado da barra de espaços: toca para trocar, mantém premida para escolher (modo separado)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиша языка рядом с пробелом: нажатие — переключить, удержание — выбрать (раздельный режим)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空格键旁边一个语言键：点一下切换，长按挑选（独立模式）"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O tastă de limbă lângă bara de spațiu: atingeți pentru a comuta, țineți apăsat pentru a alege (mod separat)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een taaltoets naast de spatiebalk: tikken om te schakelen, vasthouden om te kiezen (aparte modus)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空格鍵旁邊一個語言鍵：點一下切換，長按挑選（獨立模式）"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisz języka obok spacji: dotknij, aby przełączyć, przytrzymaj, aby wybrać (oddzielny tryb)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіша мови поруч із пробілом: торкніться, щоб переключитися, утримуйте, щоб вибрати (окремий режим)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluk çubuğunun yanında bir dil tuşu: geçiş yapmak için dokunun, seçmek için basılı tutun (ayrı mod)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazyková klávesa vedle mezerníku: klepnutím přepnete, podržením vyberete (oddělený režim)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazykový kláves vedľa medzerníka: klepnutím prepnete, podržaním vyberiete (samostatný režim)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα πλήκτρο γλώσσας δίπλα στη γραμμή διαστήματος: πατήστε για εναλλαγή, κρατήστε πατημένο για επιλογή (ξεχωριστή λειτουργία)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En språkknapp bredvid mellanslagstangenten: tryck för att växla, håll ned för att välja (separat läge)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
