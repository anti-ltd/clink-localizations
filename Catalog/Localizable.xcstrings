    "Cling isn't letting Clink make changes. Turn that on in Cling.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cling laat nie toe dat Clink veranderinge aanbring nie. Skakel dit aan in Cling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling lässt Clink keine Änderungen vornehmen. Schalte das in Cling ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling no permite que Clink haga cambios. Actívalo en Cling."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling ei lase Clinkil muudatusi teha. Lülita see Clingis sisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling n’autorise pas Clink à faire des modifications. Active-le dans Cling."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cling nem engedi, hogy a Clink módosítson. Kapcsold be a Clingben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling non permette a Clink di fare modifiche. Attivalo in Cling."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling が Clink による変更を許可していません。Cling でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling이 Clink의 변경을 허용하지 않습니다. Cling에서 켜 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling tidak membenarkan Clink membuat perubahan. Hidupkan dalam Cling."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cling não deixa o Clink fazer alterações. Ative isso no Cling."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling не разрешает Clink вносить изменения. Включите это в Cling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling 不允许 Clink 做修改。请在 Cling 中开启。"
          }
        }
      }
    },
