    "Locks the keyboard and shows the paywall as if you'd never bought anything. Debug builds only.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperrt die Tastatur und zeigt die Paywall an, als hättest du nie etwas gekauft. Nur in Debug-Builds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea el teclado y muestra el muro de pago como si nunca hubieras comprado nada. Solo en compilaciones de depuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouille le clavier et affiche le mur payant comme si tu n'avais jamais rien acheté. Builds de débogage uniquement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lezárja a billentyűzetet, és úgy mutatja a fizetőfalat, mintha soha nem vásároltál volna semmit. Csak debug buildekben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca la tastiera e mostra il paywall come se non avessi mai comprato nulla. Solo build di debug."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードをロックし、何も購入していないかのように課金画面を表示します。デバッグビルド限定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드를 잠그고 아무것도 산 적 없는 것처럼 결제 화면을 보여줘요. 디버그 빌드 전용."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengunci papan kekunci dan memaparkan tembok bayar seolah-olah anda tidak pernah membeli apa-apa. Binaan nyahpepijat sahaja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia o teclado e mostra o ecrã de compra como se nunca tivesses comprado nada. Apenas em builds de depuração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокирует клавиатуру и показывает экран оплаты так, будто вы ничего не покупали. Только в отладочных сборках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定键盘并显示付费墙，就像你从未购买过一样。仅限调试版本。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukustab klaviatuuri ja näitab tasumüüri nii, nagu sa poleks kunagi midagi ostnud. Ainult silumise versioonides."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sluit die sleutelbord en wys die betaalmuur asof jy nog nooit iets gekoop het nie. Ontfout slegs bouwerk."
          }
        }
      }
    },
