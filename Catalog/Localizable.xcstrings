    "Custom profiles need Clink Membership. Subscribe in the Clink app.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eigene Profile ist eine Clink-Mitgliedschaft erforderlich. Abonniere sie in der Clink-App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles personalizados requieren una suscripción a Clink. Suscríbete en la app Clink."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohandatud profiilid nõuavad Clinki liikmesust. Telli see Clinki rakenduses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils personnalisés nécessitent un abonnement Clink. Abonne-toi dans l’app Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyéni profilokhoz Clink-tagság szükséges. Fizess elő a Clink appban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I profili personalizzati richiedono un abbonamento Clink. Abbonati nell’app Clink."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムプロファイルにはClinkメンバーシップが必要です。Clinkアプリで登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 설정 프로필을 사용하려면 Clink 멤버십이 필요합니다. Clink 앱에서 구독하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil tersuai memerlukan Keahlian Clink. Langgan dalam app Clink."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os perfis personalizados requerem uma adesão ao Clink. Adere na app Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для пользовательских профилей нужна подписка Clink. Оформите её в приложении Clink."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义配置需要 Clink 会员资格，请在 Clink App 中订阅。"
          }
        }
      }
    },
