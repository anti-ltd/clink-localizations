          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka tab ini selepas repositori menerbitkan keluaran."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre este separador depois de o repositório publicar uma versão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
