            "value": "Akcenty aj symbol pri dlhom stlačení každého písmena (A → á à â … @)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τόσο τόνοι όσο και σύμβολο στο παρατεταμένο πάτημα κάθε γράμματος (A → á à â … @)"
          }
        },
        "sv": {
