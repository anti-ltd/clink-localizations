    "Custom profiles need Clink Membership. Subscribe in the Clink app.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eigene Profile ist eine Clink-Mitgliedschaft erforderlich. Abonniere sie in der Clink-App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles personalizados requieren una suscripción a Clink. Suscríbete en la app Clink."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohandatud profiilid nõuavad Clinki liikmesust. Telli see Clinki rakenduses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils personnalisés nécessitent un abonnement Clink. Abonne-toi dans l’app Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyéni profilokhoz Clink-tagság szükséges. Fizess elő a Clink appban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I profili personalizzati richiedono un abbonamento Clink. Abbonati nell’app Clink."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムプロファイルにはClinkメンバーシップが必要です。Clinkアプリで登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 설정 프로필을 사용하려면 Clink 멤버십이 필요합니다. Clink 앱에서 구독하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil tersuai memerlukan Keahlian Clink. Langgan dalam app Clink."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os perfis personalizados requerem uma adesão ao Clink. Adere na app Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для пользовательских профилей нужна подписка Clink. Оформите её в приложении Clink."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义配置需要 Clink 会员资格，请在 Clink App 中订阅。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilurile personalizate necesită calitatea de membru Clink. Abonați-vă în aplicația Clink."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangepaste profielen hebben een Clink-lidmaatschap nodig. Abonneer u in de Clink-app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自定義配置需要 Clink 會員資格，請在 Clink App 中訂閱。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasgemaakte profiele benodig Clink-lidmaatskap. Teken in via die Clink-app in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile niestandardowe wymagają członkostwa Clink. Subskrybuj w aplikacji Clink."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Користувацькі профілі потребують членства Clink. Підпишіться в додатку Clink."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel profiller Clink Üyeliğine ihtiyaç duyar. Clink uygulamasına abone olun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastní profily vyžadují členství Clink. Přihlaste se k odběru v aplikaci Clink."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastné profily vyžadujú členstvo Clink. Prihláste sa na odber v aplikácii Clink."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα προσαρμοσμένα προφίλ χρειάζονται συνδρομή Clink. Εγγραφείτε στην εφαρμογή Clink."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassade profiler kräver Clink-medlemskap. Prenumerera i Clink-appen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpassede profiler kræver Clink-medlemskab. Abonner i Clink-appen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpassede profiler trenger Clink-medlemskap. Abonner i Clink-appen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukautetut profiilit vaativat Clink-jäsenyyden. Tilaa Clink-sovelluksessa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil khusus memerlukan Keanggotaan Clink. Berlangganan di aplikasi Clink."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ tùy chỉnh cần có tư cách thành viên Clink. Đăng ký trong ứng dụng Clink."
          }
        }
      }
    },
