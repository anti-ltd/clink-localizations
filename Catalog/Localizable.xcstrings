    "Hold a key for its accent bar, or flick straight down to type the first accent instantly.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou 'n sleutel vir sy aksentbalk, of blaai reguit af om die eerste aksent onmiddellik in te tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte eine Taste für ihre Akzentleiste, oder wische gerade nach unten, um sofort den ersten Akzent zu tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una tecla para ver sus acentos, o desliza recto hacia abajo para escribir el primero al instante."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia klahvi selle aksendiriba jaoks või tõmba otse alla, et sisestada esimene aksent koheselt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens une touche pour sa barre d'accents, ou balaie tout droit vers le bas pour taper le premier accent instantanément."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarts lenyomva egy gombot az ékezetsávhoz, vagy húzz egyenesen lefelé, és rögtön az első ékezet íródik be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un tasto per la barra degli accenti, o scorri dritto verso il basso per digitare subito il primo accento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを長押しするとアクセントバーが出ます。まっすぐ下にフリックすると、最初のアクセントがすぐ入力されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 길게 누르면 악센트 바가 떠요. 곧장 아래로 튕기면 첫 악센트가 바로 입력돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan kekunci untuk bar aksennya, atau leret terus ke bawah untuk taip aksen pertama serta-merta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém uma tecla premida para a barra de acentos, ou desliza a direito para baixo para escreveres logo o primeiro acento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержите клавишу, чтобы открыть её полосу акцентов, или смахните строго вниз, чтобы сразу вставить первый акцент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按按键弹出重音栏，或者直接下滑，立刻打出第一个重音。"
          }
        }
      }
    },
