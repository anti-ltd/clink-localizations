    "1024×1024 for posts — every language we ship in its own name for itself, and the free-vs-membership split. Share → Save Image.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 para publicaciones: cada idioma que enviamos, con su propio nombre, y la división gratis-vs-membresía. Compartir → Guardar imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 pour les posts — chaque langue que nous livrons, dans son propre nom, et la répartition gratuit-vs-abonnement. Partager → Enregistrer l'image."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 für Posts — jede Sprache, die wir ausliefern, in ihrem eigenen Namen, und die Gratis-vs-Mitgliedschaft-Aufteilung. Teilen → Bild speichern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 per i post — ogni lingua che spediamo, nel suo nome, e la divisione gratuito-vs-abbonamento. Condividi → Salva immagine."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 para publicações — em todas as línguas que distribuímos, com o seu próprio nome, e a divisão grátis-vs-subscrição. Partilhar → Guardar imagem."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 untuk siaran — setiap bahasa yang kami hantar, dalam nama tersendiri, dan pembahagian percuma-vs-keahlian. Kongsi → Simpan Imej."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 posztokhoz — minden nyelv, amit kiadunk, a saját nevén, és az ingyenes-vs-tagság felosztás. Megosztás → Kép mentése."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿用 1024×1024 — 対応言語をそれぞれの言語名で、無料 vs メンバーシップの比較も。共有 → 画像を保存。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于帖子的 1024×1024 — 我们推出的每种语言，都用它自己的名称，以及免费与会员的区别。分享 → 保存图片。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시물용 1024×1024 — 지원하는 모든 언어를 그 언어 이름으로, 무료 vs 멤버십 비교까지. 공유 → 이미지 저장."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 postituste jaoks — iga keel, mida välja anname, oma nimega, ja tasuta-vs-liikmelisuse jaotus. Jaga → Salvesta pilt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 для публикаций — каждый язык, который мы выпускаем, назван на самом себе, и разделение «бесплатно против членства». Поделиться → Сохранить изображение."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1024×1024 vir plasings - elke taal wat ons stuur in sy eie naam vir homself, en die gratis-vs-lidmaatskap verdeel. Deel → Stoor prent."
          }
        }
      }
    },
    "We're building this for you": {
      "extractionState": "manual",
      "localizations": {
