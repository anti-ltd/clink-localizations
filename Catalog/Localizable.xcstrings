            "state": "translated",
            "value": "Taille de chaque emoji dans sa case."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie groß jedes Emoji in seiner Zelle gezeichnet wird."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto è grande ogni emoji nella sua cella."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quão grande cada emoji é desenhado na sua célula."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa besar setiap emoji dilukis pada selnya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mekkora legyen az egyes emojik a saját cellájukban."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各マスに描く絵文字の大きさです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个格子里表情画多大。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 칸에 이모지를 얼마나 크게 그릴지입니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui suurelt iga emoji oma lahtrisse joonistatakse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько крупно каждый эмодзи рисуется в своей ячейке."
