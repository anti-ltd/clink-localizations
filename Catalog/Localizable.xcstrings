        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ecrã já funciona. Adiciona o teclado nas Definições para falares também noutras apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот экран уже работает. Добавьте клавиатуру в Настройках, чтобы говорить и в других приложениях."
