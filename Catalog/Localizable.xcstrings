    "Tools fill the keyboard as a grid of tiles.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gereedskap vul die sleutelbord as 'n rooster van teëls."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werkzeuge füllen die Tastatur als Kachelraster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas llenan el teclado como una cuadrícula de mosaicos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tööriistad täidavad klaviatuuri plaatide ruudustikuna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils remplissent le clavier sous forme de grille de tuiles."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközök csempékből álló rácsként töltik ki a billentyűzetet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli strumenti riempiono la tastiera come una griglia di riquadri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールがタイル状に並んでキーボードいっぱいに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구가 타일 격자로 키보드를 가득 채워요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alatan memenuhi papan kekunci sebagai grid jubin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ferramentas preenchem o teclado como uma grelha de mosaicos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструменты заполняют клавиатуру сеткой плиток."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具以方块网格铺满整个键盘。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrumentele umplu tastatura ca o grilă de plăci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gereedschappen vullen het toetsenbord als een raster van tegels."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具以方塊網格鋪滿整個鍵盤。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narzędzia wypełniają klawiaturę w postaci siatki płytek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інструменти заповнюють клавіатуру у вигляді сітки плиток."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araçlar klavyeyi döşemelerden oluşan bir ızgara şeklinde doldurur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nástroje vyplňují klávesnici jako mřížku dlaždic."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nástroje vypĺňajú klávesnicu ako mriežku dlaždíc."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα εργαλεία γεμίζουν το πληκτρολόγιο ως ένα πλέγμα πλακιδίων."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Verktyg fyller tangentbordet som ett rutnät av brickor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Værktøjer fylder tastaturet som et gitter af fliser."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verktøy fyller tastaturet som et rutenett av fliser."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalut täyttävät näppäimistön ruudukkona."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat mengisi keyboard sebagai kisi-kisi ubin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các công cụ lấp đầy bàn phím dưới dạng lưới các ô xếp."
          }
        }
      }
    },
