    "Save your current setup as a profile and it shows up in the keyboard's switcher.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stoor jou huidige opstelling as 'n profiel en dit verskyn in die sleutelbord se skakelaar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher dein aktuelles Setup als Profil, dann taucht es im Wechsler auf der Tastatur auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tu configuración actual como perfil y aparecerá en el teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvesta oma praegune seadistus profiilina ja see ilmub klaviatuuri vahetajasse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre ta config actuelle comme profil et elle apparaîtra dans le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentsd el a mostani beállításodat profilként, és megjelenik a billentyűzet váltójában."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva la configurazione attuale come profilo e comparirà nel selettore della tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまのセットアップをプロファイルとして保存すると、キーボードの切り替えに出てきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 설정을 프로필로 저장하면 키보드 전환 목록에 나타납니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan persediaan semasa anda sebagai profil dan ia akan muncul dalam penukar papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde a configuração atual como perfil e ela aparece no teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните текущую настройку как профиль — и он появится в переключателе на клавиатуре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把当前配置存成配置文件，它就会出现在键盘的切换器里。"
          }
        }
      }
    },
    "Save your whole setup to a file to back it up or share it, then import it on another device.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stoor jou hele opstelling in 'n lêer om dit te rugsteun of te deel, en voer dit dan op 'n ander toestel in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere deine ganze Einrichtung in einer Datei, um sie zu sichern oder zu teilen, und importiere sie dann auf einem anderen Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda toda tu configuración en un archivo para tener una copia o compartirla, y luego impórtala en otro dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvesta kogu oma seadistus faili, et varundada või jagada, ja impordi see siis teises seadmes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre toute ta config dans un fichier pour la sauvegarder ou la partager, puis importe-la sur un autre appareil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentsd el az egész beállításodat egy fájlba, hogy legyen róla mentés vagy megoszthasd, majd töltsd be egy másik eszközön."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva tutta la tua configurazione in un file per farne un backup o condividerla, poi importala su un altro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定をまるごとファイルに保存して、バックアップや共有ができます。別のデバイスで読み込むこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 전체를 파일로 저장해서 백업하거나 공유하고, 다른 기기에서 다시 가져올 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan seluruh persediaan anda ke fail untuk sandaran atau kongsi, kemudian import pada peranti lain."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda toda a tua configuração num ficheiro para lhe fazeres cópia de segurança ou a partilhares e depois importa-la noutro dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните всю настройку в файл, чтобы сделать резервную копию или поделиться, а потом импортируйте её на другом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把你的整套设置存成文件，用来备份或分享，再在别的设备上导入。"
          }
        }
      }
    },
