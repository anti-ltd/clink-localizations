          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink não conseguiu ler esse ficheiro. Experimenta wav, m4a ou mp3."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink не смог прочитать этот файл. Попробуйте wav, m4a или mp3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 读不了这个文件。试试 wav、m4a 或 mp3。"
          }
        }
      }
    },
    "Clink couldn't save that sound.": {
      "extractionState": "manual",
