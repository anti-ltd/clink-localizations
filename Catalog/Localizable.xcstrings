    "Correction stays off until a key shows a bias that beats its own spread.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La corrección permanece desactivada hasta que el desplazamiento habitual de una tecla supera la dispersión de sus toques."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La correction reste désactivée tant que le décalage habituel d’une touche ne dépasse pas la dispersion de ses appuis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Korrektur bleibt aus, bis die systematische Abweichung einer Taste größer ist als die Streuung ihrer Berührungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La correzione resta disattivata finché lo scostamento abituale di un tasto non supera la dispersione dei suoi tocchi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A correção permanece desligada até o desvio habitual de uma tecla superar a dispersão dos toques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коррекция отключена, пока систематическое смещение нажатий на клавишу не превысит их разброс."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembetulan kekal dimatikan sehingga sisihan tetap kekunci melebihi sebaran sentuhannya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A javítás addig kikapcsolva marad, amíg egy billentyű következetes eltérése nem haladja meg az érintéseinek szórását."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーのタップ位置の偏りがばらつきを上回るまで、補正は行われません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有按键触点的固定偏移超过其分散程度，才会启用纠正。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키의 일정한 치우침이 터치 위치의 흩어짐보다 커질 때까지 보정하지 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Parandus jääb välja lülitatuks, kuni klahvi püsiv kõrvalekalle ületab puudutuste hajuvuse."
          }
        }
      }
    },
