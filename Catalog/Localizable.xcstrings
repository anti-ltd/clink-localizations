        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 한쪽으로 모여 한 손 엄지로 닿습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci dirapatkan ke satu sisi, dalam jangkauan satu ibu jari."
