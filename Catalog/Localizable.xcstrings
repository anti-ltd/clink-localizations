    "Characters per line used to calculate vertical cursor jumps when you drag up or down.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Karakters per reël wat gebruik word om vertikale wyserspronge te bereken wanneer jy op of af sleep."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichen pro Zeile, mit denen die vertikalen Cursorsprünge berechnet werden, wenn du nach oben oder unten ziehst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caracteres por línea que se usan para calcular los saltos verticales del cursor cuando arrastras hacia arriba o abajo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märke rea kohta, mille järgi arvutatakse kursori püstised hüpped, kui lohistad üles või alla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caractères par ligne, servent à calculer les sauts verticaux du curseur quand tu glisses vers le haut ou le bas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A soronkénti karakterszám, amiből számolja a függőleges kurzorugrásokat, amikor felfelé vagy lefelé húzol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caratteri per riga, usati per calcolare i salti verticali del cursore quando trascini su o giù."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下にドラッグしたときのカーソルの縦移動量を計算するための、1行あたりの文字数です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위아래로 드래그할 때 커서가 세로로 얼마나 움직일지 계산하는 줄당 글자 수예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilangan aksara setiap baris, dipakai untuk kira lompatan kursor menegak bila anda seret ke atas atau ke bawah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Caracteres por linha usados para calcular os saltos verticais do cursor quando arrastas para cima ou para baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько символов в строке — по этому числу считаются вертикальные прыжки курсора, когда вы ведёте вверх или вниз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你上下拖动时，用来算光标竖向跳几行的每行字符数。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caractere pe linie utilizate pentru a calcula salturile verticale ale cursorului atunci când trageți în sus sau în jos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekens per regel die worden gebruikt om de verticale cursorsprongen te berekenen wanneer u omhoog of omlaag sleept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你上下拖動時，用來算游標豎向跳幾行的每行字元數。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znaki w wierszu używane do obliczania pionowych skoków kursora podczas przeciągania w górę lub w dół."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Символів у рядку, які використовуються для обчислення вертикальних стрибків курсору під час перетягування вгору або вниз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarı veya aşağı sürüklediğinizde dikey imleç atlamalarını hesaplamak için kullanılan satır başına karakter sayısı."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znaky na řádek používané k výpočtu vertikálních skoků kurzoru při tažení nahoru nebo dolů."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Znaky na riadok používané na výpočet zvislých skokov kurzora pri ťahaní nahor alebo nadol."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χαρακτήρες ανά γραμμή που χρησιμοποιούνται για τον υπολογισμό των κατακόρυφων μεταπηδήσεων του δρομέα όταν σύρετε επάνω ή κάτω."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecken per rad används för att beräkna vertikala markörhopp när du drar uppåt eller nedåt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn pr. linje bruges til at beregne lodrette markørspring, når du trækker op eller ned."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn per linje som brukes til å beregne vertikale markørhopp når du drar opp eller ned."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkkejä riviä kohden käytetään laskettaessa pystysuorat kohdistimen hyppyt, kun vedät ylös tai alas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karakter per baris yang digunakan untuk menghitung lompatan kursor vertikal saat Anda menyeret ke atas atau ke bawah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ký tự trên mỗi dòng được sử dụng để tính toán bước nhảy con trỏ dọc khi bạn kéo lên hoặc xuống."
          }
        }
      }
    },
    "Characters that belong in the middle of a word without ending it. Without these, Clink stops the word at the mark and corrects the fragment.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Karakters wat in die middel van 'n woord hoort sonder om dit te beëindig. Sonder hierdie stop Clink die woord by die merk en korrigeer die fragment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichen, die mitten im Wort stehen, ohne es zu beenden. Ohne sie bricht Clink das Wort am Zeichen ab und korrigiert das Bruchstück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caracteres que van en medio de una palabra sin terminarla. Sin ellos, Clink corta la palabra en el signo y corrige el trozo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märgid, mis kuuluvad sõna keskele seda lõpetamata. Ilma nendeta katkestab Clink sõna märgi kohalt ja parandab jupi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caractères qui s’écrivent au milieu d’un mot sans le terminer. Sans eux, Clink coupe le mot au signe et corrige le fragment."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olyan karakterek, amik a szó közepén állnak, de nem zárják le. Nélkülük a Clink a jelnél elvágja a szót, és a töredéket javítja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caratteri che stanno in mezzo a una parola senza chiuderla. Senza di loro Clink taglia la parola sul segno e corregge il frammento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語を終わらせずに語中に現れる文字です。登録しないと、Clink はその記号で語を切り、断片のほうを修正してしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어를 끝내지 않고 중간에 오는 문자입니다. 등록하지 않으면 Clink가 그 기호에서 단어를 끊고 조각을 교정해 버립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksara yang berada di tengah perkataan tanpa menamatkannya. Tanpanya, Clink memotong perkataan pada tanda itu dan membetulkan cebisannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Caracteres que ficam no meio de uma palavra sem a terminar. Sem eles, o Clink corta a palavra no sinal e corrige o pedaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Символы, которые стоят внутри слова и не заканчивают его. Без них Clink обрывает слово на этом знаке и исправляет обрывок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出现在词中间、但不结束这个词的字符。不填的话，Clink 会在该符号处把词截断，然后去纠正那个片段。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caractere care aparțin mijlocului unui cuvânt fără a-l termina. Fără acestea, Clink oprește cuvântul la semn și corectează fragmentul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekens die in het midden van een woord thuishoren zonder het te beëindigen. Zonder deze stopt Clink het woord bij de markering en corrigeert het fragment."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出現在詞中間、但不結束這個詞的字元。不填的話，Clink 會在該符號處把詞截斷，然後去糾正那個片段。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znaki, które znajdują się w środku wyrazu, ale go nie kończą. Bez nich Clink zatrzymuje słowo w miejscu znaku i poprawia fragment."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Символи, які знаходяться в середині слова без закінчення. Без них Clink зупиняє слово на позначці та виправляє фрагмент."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kelimenin sonuna gelmeden ortasına ait olan karakterler. Bunlar olmadan, Clink sözcüğü işarette durdurur ve parçayı düzeltir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znaky, které patří doprostřed slova, aniž by ho ukončily. Bez nich Clink zastaví slovo na značce a opraví fragment."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Znaky, ktoré patria do stredu slova bez toho, aby ho ukončili. Bez nich Clink zastaví slovo na značke a opraví fragment."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χαρακτήρες που ανήκουν στη μέση μιας λέξης χωρίς να την τελειώνουν. Χωρίς αυτά, το Clink σταματά τη λέξη στο σημάδι και διορθώνει το τμήμα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecken som hör hemma i mitten av ett ord utan att det slutar. Utan dessa stoppar Clink ordet vid märket och korrigerar fragmentet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn, der hører til i midten af ​​et ord uden at afslutte det. Uden disse stopper Clink ordet ved mærket og retter fragmentet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn som hører hjemme i midten av et ord uten å avslutte det. Uten disse stopper Clink ordet ved merket og korrigerer fragmentet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hahmot, jotka kuuluvat sanan keskelle päättämättä sitä. Ilman näitä Clink pysäyttää sanan merkkiin ja korjaa fragmentin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karakter yang berada di tengah kata tanpa mengakhirinya. Tanpa ini, Clink menghentikan kata pada sasaran dan mengoreksi fragmennya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ký tự nằm ở giữa một từ mà không kết thúc từ đó. Nếu không có những thứ này, Clink sẽ dừng từ ở điểm đánh dấu và sửa đoạn đó."
          }
        }
      }
    },
