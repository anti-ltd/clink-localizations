        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No teclado, abre-o pelo menu de ferramentas e começa a falar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На клавиатуре откройте её из меню инструментов и начинайте говорить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘上从工具菜单打开它，然后开口说。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe tastatură, deschideți-o din meniul de instrumente și începeți să vorbiți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open het op het toetsenbord vanuit het menu Extra en begin te praten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鍵盤上從工具選單開啟它，然後開口說。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na klawiaturze otwórz ją z menu narzędzi i zacznij mówić."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На клавіатурі відкрийте його з меню інструментів і почніть говорити."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyedeki araçlar menüsünden açın ve konuşmaya başlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na klávesnici ji otevřete z nabídky nástrojů a začněte mluvit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na klávesnici ju otvorte z ponuky nástrojov a začnite hovoriť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο πληκτρολόγιο, ανοίξτε το από το μενού εργαλείων και ξεκινήστε να μιλάτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna det från verktygsmenyn på tangentbordet och börja prata."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På tastaturet skal du åbne det fra værktøjsmenuen og begynde at tale."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På tastaturet åpner du det fra verktøymenyen og begynner å snakke."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa se näppäimistön työkaluvalikosta ja aloita puhuminen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di keyboard, buka dari menu alat dan mulailah berbicara."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên bàn phím, hãy mở nó từ menu công cụ và bắt đầu nói."
          }
        }
      }
    },
