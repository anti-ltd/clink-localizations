        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯光颜色"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조명 색"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valguse värv"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвет света"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ligte kleur"
          }
        }
      }
    },
    "Light laid over the keys. Your theme's colours stay put underneath.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz sobre las teclas. Los colores de tu tema se mantienen debajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une lumière posée sur les touches. Les couleurs du thème restent en dessous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht über den Tasten. Die Farben deines Themes bleiben darunter erhalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Luce sopra i tasti. I colori del tema restano sotto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz por cima das teclas. As cores do teu tema ficam por baixo."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya di atas kekunci. Warna tema anda kekal di bawahnya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fény a gombok fölött. A téma színei alatta maradnak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの上に光を重ねます。テーマの色はその下に残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯光叠在按键上，主题的颜色仍留在下面。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 위에 빛을 덮습니다. 테마 색은 그 아래 그대로 남습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgus laotatakse klahvidele. Sinu teema värvid jäävad all hoituks."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свет поверх клавиш. Цвета вашей темы остаются под ним."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lig oor die sleutels gelê. Jou tema se kleure bly onder."
          }
        }
      }
    },
    "Light up the key you hit on top of the moving light.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina la tecla que pulsas además de la luz en movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éclairez la touche frappée en plus de la lumière en mouvement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gedrückte Taste leuchtet zusätzlich zum bewegten Licht auf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Illumina il tasto premuto oltre alla luce in movimento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina a tecla premida além da luz em movimento."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terangi kekunci yang anda tekan selain cahaya yang bergerak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lenyomott gomb a mozgó fény mellett is felvillan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動く光に加えて、押したキーも光らせます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在流动的灯光之外，再点亮你按下的按键。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흐르는 조명 위에, 누른 키도 함께 켭니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Süüta vajutatud klahv lisaks liikuvale valgusele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсвечивать нажатую клавишу поверх движущегося света."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lig die sleutel wat jy slaan bo-op die bewegende lig aan."
          }
        }
      }
    },
    "Lighting borrows a colour your theme already uses, so the theme still looks like itself.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La iluminación toma un color que ya usa tu tema, así el tema sigue siendo el mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'éclairage emprunte une couleur déjà présente dans votre thème, pour qu'il reste lui-même."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beleuchtung leiht sich eine Farbe, die dein Theme schon nutzt – so bleibt es sich selbst treu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'illuminazione prende in prestito un colore già usato dal tema, così il tema resta sé stesso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A iluminação empresta uma cor que o teu tema já usa, para o tema continuar a ser ele mesmo."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencahayaan meminjam warna yang sudah digunakan tema anda, jadi tema kekal seperti asalnya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megvilágítás a téma egyik meglévő színét használja, így a téma önmaga marad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマがすでに使っている色を借りるので、テーマの印象はそのままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯光沿用主题已有的颜色，主题依旧是它本来的样子。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마가 이미 쓰는 색을 빌려 오므로 테마는 그대로 유지됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgustus laenab värvi, mida sinu teema juba kasutab, nii et teema näeb ikka välja nagu ise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсветка берёт цвет, который ваша тема уже использует, так что тема остаётся сама собой."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beligting leen 'n kleur wat jou tema reeds gebruik, so die tema lyk steeds soos homself."
          }
        }
      }
    },
    "Lighting style": {
      "extractionState": "manual",
      "localizations": {
