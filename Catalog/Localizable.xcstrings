    "Cling isn't letting Clink make changes. Turn that on in Cling.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling lässt Clink keine Änderungen vornehmen. Schalte das in Cling ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling no permite que Clink haga cambios. Actívalo en Cling."
          }
        },
        "fr": {
