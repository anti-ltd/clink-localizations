        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Penukar Profil dan anda boleh menukar profil terus dari papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga a Troca de perfil e passas a mudar de perfil a partir do próprio teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите переключатель профилей — и профили можно будет менять прямо с клавиатуры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“配置文件切换”，就能直接在键盘上换配置文件。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita sisse Profiilivahetaja ja sa saad profiile vahetada otse klaviatuurilt."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel die profielskakelaar aan en jy kan profiele van die sleutelbord self af ruil."
          }
        }
      }
    },
    "Turn the category tabs back on to style them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte die Kategorie-Tabs wieder ein, um sie zu gestalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a activar las pestañas de categorías para darles estilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réactive les onglets de catégories pour choisir leur style."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold vissza a kategóriafüleket, hogy stílust adhass nekik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riattiva le schede delle categorie per dar loro uno stile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタイルを変えるには、カテゴリタブをもう一度オンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스타일을 바꾸려면 카테고리 탭을 다시 켜주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan semula tab kategori untuk menggayakannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta a ligar os separadores de categorias para lhes dar estilo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите вкладки категорий обратно, чтобы задать им вид."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想调样式，先把分类栏打开。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita kategooriakaardid tagasi sisse, et neid kujundada."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel die kategorie-oortjies weer aan om hulle te styl."
          }
        }
      }
    },
    "Turn the pet off, or pick another one and move it to a different corner.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte das Haustier aus, oder nimm ein anderes und setz es in eine andere Ecke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva la mascota, o elige otra y ponla en otra esquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive le compagnon, ou choisis-en un autre et place-le dans un autre coin."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold ki a kisállatot, vagy válassz másikat, és tedd át egy másik sarokba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva l'animaletto, oppure scegline un altro e spostalo in un angolo diverso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペットをオフにするか、別のペットを選んで違う隅に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펫을 끄거나, 다른 펫을 골라 다른 구석으로 옮기세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan peliharaan itu, atau pilih yang lain dan alihkannya ke sudut berbeza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga a mascote, ou escolhe outra e muda-a para outro canto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите питомца — или выберите другого и переставьте его в другой угол."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把宠物关掉，或者换一只、挪到别的角落。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita lemmikloom välja või vali teine ja liiguta ta teise nurka."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel die troeteldier af, of kies 'n ander een en skuif dit na 'n ander hoek."
          }
        }
      }
    },
    "Turns on the on-device smarts behind smarter suggestions and translation. Nothing works until you flip this.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet die Intelligenz auf dem Gerät ein, die hinter cleveren Vorschlägen und dem Übersetzen steckt. Nichts läuft, bevor du das anmachst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la inteligencia en el dispositivo que hay detrás de las sugerencias y la traducción más listas. Nada funciona hasta que actives esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active l'intelligence sur l'appareil derrière des suggestions et une traduction plus malines. Rien ne marche tant que tu n'as pas activé ça."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolja az eszközön futó okos funkciókat, amik az okosabb javaslatok és a fordítás mögött állnak. Semmi sem működik, amíg ezt be nem kapcsolod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l'intelligenza sul dispositivo dietro suggerimenti e traduzione più intelligenti. Niente funziona finché non la attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よりスマートな候補や翻訳を支える、オンデバイスの知能をオンにします。これをオンにするまで何も動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 똑똑한 추천이랑 번역을 뒷받침하는 온디바이스 지능을 켜요. 이걸 켜기 전에는 아무것도 작동하지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghidupkan kepintaran atas-peranti di sebalik cadangan dan terjemahan yang lebih pintar. Tiada apa berfungsi sehingga anda menghidupkan ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga a inteligência no dispositivo por trás de sugestões e tradução mais espertas. Nada funciona até ligares isto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает работающий на устройстве интеллект, на котором держатся умные подсказки и перевод. Пока это выключено, ничего из них не работает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设备端的智能功能，更聪明的建议和翻译都靠它。不开的话这些都用不了。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülitab sisse seadmesisesed nutikused nutikamate soovituste ja tõlke taga. Midagi ei tööta, enne kui sa seda lülitad."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel die slimfone op die toestel aan agter slimmer voorstelle en vertaling. Niks werk totdat jy dit omdraai nie."
          }
        }
      }
    },
    "Twist": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Giro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Torsion"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdrehen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torsione"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Torção"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulas"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csavarás"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツイスト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扭转"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비틀기"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vääne"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скручивание"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Draai"
          }
        }
      }
    },
    "Two columns, each card as tall as its clip. Tap one to paste.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Spalten, jede Karte so hoch wie ihr Clip. Tippe einen zum Einfügen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos columnas, cada tarjeta tan alta como su clip: toca uno para pegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux colonnes, chaque carte à la hauteur de son clip. Touche l'une d'elles pour coller."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Két oszlop, minden kártya akkora, mint a benne lévő elem. Koppints egyre a beillesztéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due colonne, ogni scheda alta quanto la sua clip: toccane una per incollare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2列に並び、カードの高さはクリップに合わせて伸びます。タップで貼り付け。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 열로 놓이고 카드 높이는 클립 길이에 맞춰져요. 하나를 탭하면 붙여넣기돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua lajur, setiap kad setinggi klipnya. Ketik satu untuk tampal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas colunas, cada cartão tão alto quanto o seu clip. Toque num para colar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Две колонки, высота карточки равна её фрагменту. Нажмите на любую, чтобы вставить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分成两列，卡片高度随剪贴内容伸展，点按其中一条即可粘贴。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaks veergu, iga kaart sama kõrge kui oma klipp. Puuduta üht, et kleepida."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twee kolomme, elke kaart so lank soos sy clip. Tik een om te plak."
          }
        }
      }
    },
    "Two taps and it works in every app.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos toques y funcionará en todas las apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux gestes et il fonctionne dans toutes les apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweimal tippen und es funktioniert in jeder App."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due tocchi e funziona in tutte le app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois toques e funciona em todas as apps."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua ketikan dan ia berfungsi dalam semua app."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Két koppintás, és minden appban működik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2回タップするだけで、すべてのアプリで使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点两次，即可在所有 App 中使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번만 탭하면 모든 앱에서 사용할 수 있어요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaks puudutust ja see töötab igas rakenduses."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два касания — и работает в каждом приложении."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twee krane en dit werk in elke toepassing."
          }
        }
      }
    },
    "Two things iOS will ask you": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Dinge, nach denen iOS fragt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos cosas que iOS te preguntará"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux choses qu'iOS va te demander"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Két dolog, amit az iOS kérdezni fog"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due cose che iOS ti chiederà"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS から聞かれる 2 つのこと"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 물어볼 두 가지"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua perkara yang iOS akan tanya"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas coisas que o iOS vai perguntar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Две вещи, о которых спросит iOS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会问你的两件事"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaks asja, mida iOS sinult küsib"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twee dinge wat iOS jou sal vra"
          }
        }
      }
    },
    "Two ways, and both stay on the keyboard: the language button on the suggestion bar, and a swipe up on the Return key. The keys change with the language.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Wege, beide direkt auf der Tastatur: die Sprachtaste in der Vorschlagsleiste, und ein Wisch nach oben auf der Eingabetaste. Die Tasten wechseln mit der Sprache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos maneras, y las dos sin salir del teclado: el botón de idioma en la barra de sugerencias, y deslizar hacia arriba en la tecla de retorno. Las teclas cambian con el idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux façons, et les deux restent sur le clavier : le bouton de langue dans la barre de suggestions, et un balayage vers le haut sur la touche Retour. Les touches changent avec la langue."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Két út van, és mindkettő a billentyűzeten marad: a nyelvgomb a javaslatsávon, és egy felfelé húzás az Enteren. A billentyűk a nyelvvel együtt váltanak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due modi, entrambi senza uscire dalla tastiera: il pulsante lingua nella barra dei suggerimenti e uno scorrimento verso l'alto sul tasto Invio. I tasti cambiano insieme alla lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "方法は2つ、どちらもキーボード上で完結します。候補バーの言語ボタンと、リターンキーの上方向スワイプです。キーも言語に合わせて変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 가지가 있고 둘 다 키보드 안에서 끝납니다. 추천 바의 언어 버튼과, Return 키를 위로 쓸어올리는 동작입니다. 키도 언어에 맞춰 바뀝니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua cara, dan kedua-duanya kekal pada papan kekunci: butang bahasa pada bar cadangan, dan leretan ke atas pada kekunci Return. Kekuncinya bertukar bersama bahasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas formas, e ambas ficam no teclado: o botão de idioma na barra de sugestões, e um deslize para cima na tecla Return. As teclas mudam com o idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два способа, и оба не требуют уходить с клавиатуры: кнопка языка в строке подсказок и подъём по клавише Return. Клавиши меняются вместе с языком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两种办法，都不用离开键盘：候选栏上的语言按钮，以及在 Return 键上向上轻扫。按键也会跟着语言一起变。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaks viisi, mõlemad klaviatuuril: keeleklahv soovituseribal ja viipa üles sisestusklahvil. Klahvid vahetuvad keelega."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twee maniere, en albei bly op die sleutelbord: die taalknoppie op die voorstelbalk, en 'n swiep op die Return-sleutel. Die sleutels verander met die taal."
          }
        }
      }
    },
    "Two ways, and the second one is quick enough to use mid-word.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Wege — und der zweite ist schnell genug für mitten im Wort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos maneras, y la segunda es lo bastante rápida para usarla a mitad de palabra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux façons, et la seconde est assez rapide pour s'utiliser en plein mot."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Két út van, és a második elég gyors ahhoz, hogy szó közben használd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due modi, e il secondo è abbastanza rapido da usare a metà parola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
