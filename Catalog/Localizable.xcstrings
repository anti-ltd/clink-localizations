    "Reach emoji from the Tools menu. Off removes emoji entirely. Want a dedicated 🙂 key? Add one from Layout → Quick presets.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereik emoji's vanaf die Tools-kieslys. Af verwyder emoji heeltemal. Wil jy 'n toegewyde 🙂-sleutel hê? Voeg een by uitleg → Vinnige voorafinstellings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji über das Werkzeug-Menü erreichen. Aus entfernt Emoji vollständig. Lieber eine eigene 🙂-Taste? Füge sie unter Layout → Schnellvorlagen hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accede a los emojis desde el menú de herramientas. Desactivado, los emojis desaparecen por completo. ¿Prefieres una tecla 🙂 propia? Añádela en Diseño → Ajustes rápidos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji Tööriistade menüüst. Väljas eemaldab emoji täielikult. Tahad eraldi klahvi 🙂? Lisa see jaotisest Paigutus → Kiirmallid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accède aux emojis depuis le menu Outils. Désactivé, les emojis disparaissent entièrement. Tu préfères une touche 🙂 dédiée ? Ajoute-la dans Disposition → Préréglages."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az emojikat az Eszközök menüből éred el. Kikapcsolva az emojik teljesen eltűnnek. Inkább külön 🙂 gombot szeretnél? Add hozzá az Elrendezés → Gyors sablonok alatt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggiungi le emoji dal menu Strumenti. Se disattivato, le emoji spariscono del tutto. Preferisci un tasto 🙂 dedicato? Aggiungilo da Layout → Preimpostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵文字はツールメニューから開けます。オフにすると絵文字は完全に非表示になります。専用の🙂キーが欲しい場合は「レイアウト」→「クイックプリセット」から追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이모지는 도구 메뉴에서 열 수 있습니다. 끄면 이모지가 완전히 사라집니다. 전용 🙂 키를 원하시나요? 레이아웃 → 빠른 프리셋에서 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Capai emoji daripada menu Alatan. Jika dimatikan, emoji hilang sepenuhnya. Mahu kekunci 🙂 khusus? Tambahkannya dari Susun Atur → Pratetap Pantas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceda aos emojis pelo menu de ferramentas. Desligado, os emojis desaparecem por completo. Prefere uma tecla 🙂 dedicada? Adicione uma em Esquema → Predefinições rápidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывать эмодзи из меню инструментов. Выключено — эмодзи убираются совсем. Нужна отдельная клавиша 🙂? Добавьте её в «Раскладке» → «Быстрые пресеты»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从工具菜单进入表情。关闭后将完全移除表情。想要专属的 🙂 键？可在「布局」→「快捷预设」中添加。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajungeți la emoji din meniul Instrumente. Dezactivat elimină complet emoji. Vrei o cheie 🙂 dedicată? Adăugați unul din Aspect → Presetări rapide."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereik emoji via het menu Extra. Uit verwijdert emoji volledig. Wilt u een speciale 🙂-sleutel? Voeg er een toe via Lay-out → Snelle voorinstellingen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從工具選單進入表情。關閉後將完全移除表情。想要專屬的 🙂 鍵？可在「佈局」→「快捷預設」中新增。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzyskaj dostęp do emoji z menu Narzędzia. Opcja Wyłącz całkowicie usuwa emoji. Chcesz dedykowany klucz 🙂? Dodaj jeden z Układ → Szybkie ustawienia wstępne."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до емодзі з меню «Інструменти». Вимкнути повністю видаляє смайли. Хочете спеціальний 🙂 ключ? Додайте один із Макет → Швидкі налаштування."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araçlar menüsünden emojiye ulaşın. Kapalı, emojiyi tamamen kaldırır. Özel bir 🙂 anahtarı mı istiyorsunuz? Düzen → Hızlı ön ayarlar'dan bir tane ekleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete emotikony z nabídky Nástroje. Vypnuto zcela odstraní emotikony. Chcete vyhrazený klíč 🙂? Přidejte jednu z nabídky Rozvržení → Rychlé předvolby."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prejdite na emotikony z ponuky Nástroje. Vypnuté úplne odstráni emotikony. Chcete vyhradený kľúč 🙂? Pridajte jeden z Rozloženie → Rýchle predvoľby."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσεγγίστε emoji από το μενού Εργαλεία. Το Off αφαιρεί εντελώς τα emoji. Θέλετε ένα αποκλειστικό κλειδί 🙂; Προσθέστε ένα από τη Διάταξη → Γρήγορες προεπιλογές."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nå emoji från menyn Verktyg. Av tar bort emoji helt. Vill du ha en dedikerad 🙂-nyckel? Lägg till en från Layout → Snabbförinställningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nå emoji fra menuen Værktøjer. Fra fjerner emoji helt. Vil du have en dedikeret 🙂 nøgle? Tilføj en fra Layout → Hurtige forudindstillinger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nå emoji fra Verktøy-menyen. Av fjerner emoji helt. Vil du ha en dedikert 🙂-nøkkel? Legg til en fra Layout → Hurtigforhåndsinnstillinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa emoji Työkalut-valikosta. Pois poistaa emojin kokonaan. Haluatko erillisen 🙂 avaimen? Lisää yksi kohdasta Asettelu → Pika-esiasetukset."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangkau emoji dari menu Alat. Mati menghapus emoji seluruhnya. Ingin kunci 🙂 khusus? Tambahkan satu dari Tata Letak → Preset cepat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp cận biểu tượng cảm xúc từ menu Công cụ. Tắt sẽ loại bỏ hoàn toàn biểu tượng cảm xúc. Muốn có một phím 🙂 chuyên dụng? Thêm một từ Bố cục → Cài đặt trước nhanh."
          }
        }
      }
    },
