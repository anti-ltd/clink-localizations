        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 설정은 그대로 둘게요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapan semasa anda kekal macam sekarang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas definições atuais ficam como estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущие настройки останутся как есть."
