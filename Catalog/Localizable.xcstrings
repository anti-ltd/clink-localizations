            "value": "Probier es auf der echten Tastatur aus und behalte es, wenn schnelles Tippen flotter oder kühler wirkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruébalo en el teclado real y déjalo si escribir rápido se siente más ágil o el teléfono más fresco."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Proovi päris klaviatuuril ja jäta sisse, kui kiire trükkimine tundub nobedam või seade jahedam."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez-le sur le vrai clavier et gardez-le si la frappe rapide semble plus vive ou plus fraîche."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbáld ki a valódi billentyűzeten, és hagyd bekapcsolva, ha a gyors gépelés pörgősebb vagy hűvösebb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Provalo sulla tastiera reale e tienilo se la digitazione veloce sembra più scattante o più fresca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際のキーボードで試し、速く打つときに軽快に感じたり発熱が減ったりしたらそのまま使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 키보드에서 써 보고, 빠르게 입력할 때 더 경쾌하거나 덜 뜨겁다면 켜 두세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuba pada papan kekunci sebenar, dan kekalkan jika menaip laju terasa lebih pantas atau lebih sejuk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste no teclado real e mantenha se digitar rápido parecer mais ágil ou mais fresco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте на настоящей клавиатуре и оставьте, если быстрый набор стал отзывчивее или устройство меньше греется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在真实键盘上试试，如果快速输入更跟手或更凉爽就保留它。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încercați-o pe o tastatură reală și păstrați-o dacă tastarea rapidă vă pare mai rapidă sau mai rece."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer het op een echt toetsenbord en bewaar het als snel typen sneller of koeler aanvoelt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在真實鍵盤上試試，如果快速輸入更跟手或更涼爽就保留它。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer dit op 'n regte sleutelbord en hou dit as vinnige tik vinniger of lekkerder voel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypróbuj tę opcję na prawdziwej klawiaturze i zachowaj ją, jeśli szybkie pisanie będzie szybsze i przyjemniejsze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте його на справжній клавіатурі та збережіть, якщо швидкий набір тексту здасться швидкішим або крутішим."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu gerçek bir klavyede deneyin ve hızlı yazmanın daha hızlı veya daha havalı olduğunu düşünüyorsanız bunu koruyun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyzkoušejte to na skutečné klávesnici a ponechte si ji, pokud vám rychlé psaní připadá svižnější nebo chladnější."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyskúšajte to na skutočnej klávesnici a ponechajte si ju, ak vám rýchle písanie pripadá svižnejšie alebo chladnejšie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκιμάστε το σε πραγματικό πληκτρολόγιο και διατηρήστε το εάν η γρήγορη πληκτρολόγηση είναι πιο γρήγορη ή πιο δροσερή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova det på ett riktigt tangentbord och behåll det om det känns snabbare eller coolare att skriva snabbt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv det på et rigtigt tastatur, og behold det, hvis hurtig indtastning føles smartere eller køligere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv det på et ekte tastatur, og behold det hvis rask skriving føles raskere eller kulere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile sitä oikealla näppäimistöllä ja säilytä se, jos nopea kirjoittaminen tuntuu sujuvammalta tai viileämmältä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobalah pada keyboard sungguhan, dan simpanlah jika pengetikan cepat terasa lebih cepat atau lebih keren."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thử nó trên bàn phím thực và giữ nó nếu cảm giác gõ nhanh hơn hoặc mát hơn."
          }
        }
      }
    },
