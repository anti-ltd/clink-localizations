    "One-time purchase. Payment charged to your Google Play account. Restore anytime from this screen.": {
      "comment": "Android-only copy for the companion app (batch B4: onboarding, setup, paywall), replacing iOS settings paths, Full Access and the App Store with their Android and Google Play counterparts. Translations drafted for the Android port; native-speaker review required before release. Add to clink-index.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenmalige aankoop. Betaling word van jou Google Play-rekening gehef. Herstel enige tyd op hierdie skerm."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorázový nákup. Platba bude stržena z vašeho účtu Google Play. Obnovit ho můžete kdykoli na této obrazovce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Engangskøb. Betalingen trækkes fra din Google Play-konto. Gendan når som helst fra denne skærm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmaliger Kauf. Die Zahlung wird deinem Google Play-Konto belastet. Du kannst den Kauf jederzeit auf diesem Bildschirm wiederherstellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εφάπαξ αγορά. Η πληρωμή χρεώνεται στον λογαριασμό σας Google Play. Επαναφέρετε την αγορά ανά πάσα στιγμή από αυτή την οθόνη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. El pago se carga a tu cuenta de Google Play. Puedes restaurarlo cuando quieras desde esta pantalla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühekordne ost. Makse võetakse sinu Google Play kontolt. Taasta igal ajal sellelt ekraanilt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kertaosto. Maksu veloitetaan Google Play -tililtäsi. Palauta milloin tahansa tästä näkymästä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achat unique. Le paiement est débité de ton compte Google Play. Tu peux le restaurer à tout moment depuis cet écran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyszeri vásárlás. A fizetést a Google Play-fiókodra terheljük. Erről a képernyőről bármikor visszaállíthatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian satu kali. Pembayaran ditagihkan ke akun Google Play Anda. Pulihkan kapan saja dari layar ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisto una tantum. Il pagamento viene addebitato sul tuo account Google Play. Puoi ripristinarlo quando vuoi da questa schermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度だけの購入です。Google Play アカウントに請求されます。この画面からいつでも復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일회성 구매예요. Google Play 계정으로 결제되며, 언제든 이 화면에서 복원할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian sekali sahaja. Bayaran dikenakan pada akaun Google Play anda. Pulihkan pada bila-bila masa daripada skrin ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Engangskjøp. Betalingen belastes Google Play-kontoen din. Gjenopprett når som helst fra denne skjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenmalige aankoop. De betaling wordt via je Google Play-account afgerekend. Herstel altijd via dit scherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup jednorazowy. Płatność zostanie pobrana z konta Google Play. Przywróć w dowolnej chwili na tym ekranie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. O pagamento é cobrado na tua conta Google Play. Podes restaurar a compra quando quiseres neste ecrã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziție unică. Plata se încasează din contul tău Google Play. Restaurează oricând din acest ecran."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разовая покупка. Оплата списывается с вашего аккаунта Google Play. Восстановить можно в любой момент с этого экрана."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorazový nákup. Platba sa strhne z vášho účtu Google Play. Obnoviť ho môžete kedykoľvek na tejto obrazovke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Engångsköp. Betalningen debiteras ditt Google Play-konto. Återställ när som helst från den här skärmen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek seferlik satın alma. Ödeme Google Play hesabınızdan alınır. Bu ekrandan istediğiniz zaman geri yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одноразова покупка. Оплата стягується з вашого облікового запису Google Play. Відновити покупку можна будь-коли на цьому екрані."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mua một lần. Khoản thanh toán được tính vào tài khoản Google Play của bạn. Khôi phục bất cứ lúc nào từ màn hình này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性购买。费用将从你的 Google Play 账号扣除。你可以随时在此页面恢复购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性購買。費用將從你的 Google Play 帳戶扣款。隨時可在此畫面回復購買。"
          }
        }
      }
    },
    "Prices load once Google Play is reachable. Check your connection and try again.": {
      "comment": "Android-only copy for the companion app (batch B4: onboarding, setup, paywall), replacing iOS settings paths, Full Access and the App Store with their Android and Google Play counterparts. Translations drafted for the Android port; native-speaker review required before release. Add to clink-index.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Pryse laai sodra Google Play bereikbaar is. Kontroleer jou verbinding en probeer weer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceny se načtou, jakmile bude Google Play dostupné. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Priserne indlæses, når Google Play kan nås. Tjek din forbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Preise werden geladen, sobald Google Play erreichbar ist. Prüfe deine Verbindung und versuch es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τιμές φορτώνονται μόλις το Google Play γίνει προσβάσιμο. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios aparecerán cuando se pueda conectar con Google Play. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinnad laaditakse, niipea kui Google Play on kättesaadav. Kontrolli ühendust ja proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinnat latautuvat, kun Google Play on tavoitettavissa. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prix s’afficheront dès que Google Play sera joignable. Vérifie ta connexion et réessaie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az árak akkor töltődnek be, amikor elérhető a Google Play. Ellenőrizd a kapcsolatot, majd próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga dimuat setelah Google Play dapat dijangkau. Periksa koneksi Anda lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prezzi compariranno quando Google Play sarà raggiungibile. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play に接続すると価格が表示されます。通信状況を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play에 연결되면 가격이 표시돼요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga akan dimuatkan apabila Google Play boleh dicapai. Semak sambungan dan cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisene lastes inn når Google Play kan nås. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De prijzen worden geladen zodra Google Play bereikbaar is. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceny wczytają się, gdy Google Play będzie osiągalne. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os preços aparecem quando for possível aceder ao Google Play. Verifica a ligação e tenta novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prețurile se încarcă după ce Google Play devine accesibil. Verifică conexiunea și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены загружаются, когда Google Play становится доступен. Проверьте соединение и попробуйте снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceny sa načítajú, keď bude Google Play dostupné. Skontrolujte pripojenie a skúste to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Priserna läses in när Google Play går att nå. Kontrollera anslutningen och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiyatlar Google Play’e ulaşılabildiğinde yüklenir. Bağlantınızı kontrol edip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціни завантажаться, щойно Google Play стане доступним. Перевірте з’єднання й спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá sẽ tải khi kết nối được với Google Play. Hãy kiểm tra kết nối rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到 Google Play 后会显示价格。请检查网络连接，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連上 Google Play 後就會載入價格。請檢查網路連線後再試一次。"
          }
        }
      }
    },
    "Selected as your keyboard": {
      "comment": "Android-only copy for the companion app (batch B4: onboarding, setup, paywall), replacing iOS settings paths, Full Access and the App Store with their Android and Google Play counterparts. Translations drafted for the Android port; native-speaker review required before release. Add to clink-index.",
