          }
        }
      }
    },
    "You can switch back to tools only from the General tab.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy kan net terugskakel na gereedskap vanaf die Algemeen-oortjie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst im Tab „Allgemein“ jederzeit wieder auf „Nur Werkzeuge“ umschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes volver a Solo herramientas desde la pestaña General."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa saad kaardilt Üldine tagasi lülitada ainult tööriistadele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux revenir à Outils uniquement depuis l'onglet Général."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Csak eszközök bármikor visszakapcsolható az Általános fülön."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi tornare a Solo strumenti dalla scheda Generali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「一般」タブから、いつでもツールのみに戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘일반’ 탭에서 언제든 도구 전용으로 되돌릴 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh kembali ke Alat sahaja daripada tab Umum."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes voltar a Só ferramentas no separador Geral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуться к режиму «Только инструменты» можно на вкладке «Общие»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时可以在“通用”标签页切回仅工具。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți reveni la instrumente numai din fila General."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U kunt alleen via het tabblad Algemeen teruggaan naar tools."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時可以在“通用”標籤頁切回僅工具。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do narzędzi możesz wrócić tylko z karty Ogólne."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете повернутися до інструментів лише на вкладці Загальні."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araçlara yalnızca Genel sekmesinden geri dönebilirsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zpět na nástroje můžete přepnout pouze ze záložky Obecné."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Späť na nástroje môžete prepnúť iba na karte Všeobecné."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να επιστρέψετε στα εργαλεία μόνο από την καρτέλα Γενικά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan bara byta tillbaka till verktyg från fliken Allmänt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan kun skifte tilbage til værktøjer fra fanen Generelt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan bare bytte tilbake til verktøy fra fanen Generelt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit vaihtaa takaisin työkaluihin vain Yleiset-välilehdeltä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat beralih kembali ke alat hanya dari tab Umum."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chỉ có thể chuyển về các công cụ từ tab Chung."
          }
        }
      }
    },
