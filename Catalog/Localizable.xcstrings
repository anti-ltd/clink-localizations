    "Add punctuation and capitals only. Leave my words exactly as I said them.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg slegs leestekens en hoofletters by. Los my woorde presies soos ek dit gesê het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Zeichensetzung und Großschreibung. Lass meine Worte genau so, wie ich sie gesagt habe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade solo puntuación y mayúsculas. Deja mis palabras tal como las dije."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa ainult kirjavahemärgid ja suurtähed. Jäta mu sõnad täpselt nii, nagu ma ütlesin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute seulement la ponctuation et les majuscules. Laisse mes mots exactement comme je les ai dits."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a központozást és a nagybetűket tedd hozzá. A szavaimat hagyd pontosan úgy, ahogy mondtam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi solo punteggiatura e maiuscole. Lascia le mie parole esattamente come le ho dette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "句読点だけ補って、言葉は話したとおりそのまま残して。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문장부호만 넣고, 내 말은 말한 그대로 남겨 둬."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah tanda baca dan huruf besar sahaja. Biarkan perkataan saya betul-betul seperti yang saya sebut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona só pontuação e maiúsculas. Deixa as minhas palavras tal como as disse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только знаки препинания и заглавные буквы. Слова оставить ровно такими, как сказано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只加标点，我说的字句原样保留。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați doar semne de punctuație și majuscule. Lăsați-mi cuvintele exact așa cum le-am spus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg alleen interpunctie en hoofdletters toe. Laat mijn woorden precies achter zoals ik ze heb gezegd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只加標點，我說的字句原樣保留。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj tylko znaki interpunkcyjne i wielkie litery. Zostaw moje słowa dokładnie tak, jak je powiedziałem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте лише розділові знаки та великі літери. Залиште мої слова так, як я їх сказав."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca noktalama işaretlerini ve büyük harfleri ekleyin. Sözlerimi aynen söylediğim gibi bırak."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte pouze interpunkci a velká písmena. Nechte má slova přesně tak, jak jsem je řekl."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte iba interpunkciu a veľké písmená. Nechaj moje slová presne tak, ako som ich povedal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε μόνο σημεία στίξης και κεφαλαία. Αφήστε τα λόγια μου όπως τα είπα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg endast till skiljetecken och versaler. Lämna mina ord precis som jag sa dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj kun tegnsætning og store bogstaver. Lad mine ord være præcis, som jeg sagde dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg kun til tegnsetting og store bokstaver. La ordene mine være akkurat som jeg sa dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää vain välimerkit ja isot kirjaimet. Jätä sanani täsmälleen sellaisina kuin sanoin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan tanda baca dan huruf kapital saja. Tinggalkan kata-kata saya persis seperti yang saya ucapkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ thêm dấu câu và chữ hoa. Hãy để lại lời tôi nói chính xác như tôi đã nói."
          }
        }
      }
    },
