    "Tools list floats over the keys. Slide onto one and release.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gereedskaplys sweef oor die sleutels. Skuif op een en laat los."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werkzeugliste schwebt über den Tasten. Gleite auf einen Eintrag und lass los."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de herramientas flota sobre las teclas. Desliza hasta una y suelta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tööriistade loend hõljub klahvide kohal. Libise ühele ja vabasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des outils flotte au-dessus des touches. Glisse jusqu'à l'un d'eux et relâche."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközlista a billentyűk fölött lebeg. Csússz rá egyre, és engedd el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco degli strumenti fluttua sopra i tasti. Scorri su uno e rilascia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールの一覧がキーの上に浮かびます。指をすべらせて離すと選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 목록이 키 위에 떠요. 원하는 항목으로 밀고 손을 떼면 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai alatan terapung atas kekunci. Luncur ke salah satu dan lepaskan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de ferramentas flutua sobre as teclas. Desliza até uma e larga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список инструментов всплывает над клавишами. Доведите палец до нужного и отпустите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具列表浮在按键上方。滑到其中一项再松手就行。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista de instrumente plutește peste taste. Glisați pe unul și eliberați."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lijst met tools zweeft over de toetsen. Schuif er één op en laat los."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具列表浮在按鍵上方。滑到其中一項再鬆手就行。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista narzędzi unosi się nad klawiszami. Wsuń się na jeden i zwolnij."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список інструментів плаває над клавішами. Посуньтеся на один і відпустіть."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araçlar listesi tuşların üzerinde kayar. Birinin üzerine kaydırın ve bırakın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seznam nástrojů se vznáší nad klávesami. Nasuňte na jednu a uvolněte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoznam nástrojov sa vznáša nad klávesmi. Nasuňte na jednu a uvoľnite."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λίστα εργαλείων επιπλέει πάνω από τα πλήκτρα. Σύρετε στο ένα και αφήστε το."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Verktygslistan flyter över tangenterna. Skjut på en och släpp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Værktøjslisten flyder over tasterne. Skub på en og slip."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verktøylisten flyter over tastene. Skyv på en og slipp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkaluluettelo kelluu näppäinten päällä. Liu'uta toisen päälle ja vapauta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar alat melayang di atas tombol. Geser ke satu dan lepaskan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách công cụ nổi trên các phím. Trượt lên một cái và thả ra."
          }
        }
      }
    },
