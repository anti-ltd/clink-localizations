        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak setiap kekunci membonjol keluar bila jari anda lalu atasnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto cada tecla salta para fora quando o teu dedo passa por cima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько клавиша выпячивается, когда палец проходит над ней."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手指划过时，每个键往外鼓起来多少。"
          }
        }
      }
    },
    "How much low-probability keys shrink to make room for the likely ones.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoeveel lae-waarskynlikheid sleutels krimp om plek te maak vir die waarskynlikes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark unwahrscheinliche Tasten schrumpfen, um den wahrscheinlichen Platz zu machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto se encogen las teclas poco probables para dejar sitio a las más probables."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui palju vähetõenäolised klahvid kahaneda teevad tõenäolistele ruumi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De combien les touches peu probables rétrécissent pour laisser la place aux plus probables."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyire zsugorodnak össze a kis valószínűségű gombok, hogy helyet adjanak a valószínűeknek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto si restringono i tasti poco probabili per far spazio a quelli più probabili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出やすいキーの場所をあけるために、出にくいキーがどれくらい縮むかです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘 안 쓰는 키가 자주 쓰는 키에 자리를 내주려고 얼마나 줄어드는지예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak kekunci berkebarangkalian rendah mengecut untuk beri ruang kepada yang berkemungkinan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto as teclas pouco prováveis encolhem para dar espaço às mais prováveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько сжимаются маловероятные клавиши, освобождая место вероятным."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低概率的键收缩多少，好给高概率的键腾地方。"
          }
        }
      }
    },
    "How much of the screen the effect fills. Higher packs in more particles.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoeveel van die skerm vul die effek. Hoër pakke in meer deeltjies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel vom Bildschirm der Effekt ausfüllt. Höhere Werte erzeugen mehr Partikel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánta parte de la pantalla llena el efecto. Los valores más altos concentran más partículas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui palju ekraanist efekt täidab. Suurem väärtus lisab rohkem osakesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
