    "Text and images you copy while typing with Clink will appear here.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks en beelde wat jy kopieer terwyl jy met Clink tik, sal hier verskyn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text und Bilder, die du beim Tippen mit Clink kopierst, tauchen hier auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí verás el texto y las imágenes que copies mientras escribes con Clink."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst ja pildid, mida sa Clinkiga tipides kopeerid, ilmuvad siia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte et les images que tu copies en tapant avec Clink apparaîtront ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt jelenik meg a szöveg és a képek, amiket a Clinkkel gépelés közben másolsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo e le immagini che copi mentre scrivi con Clink compaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink で入力中にコピーしたテキストや画像がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink로 입력하는 동안 복사한 텍스트랑 이미지가 여기에 나와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks dan gambar yang anda salin semasa menaip dengan Clink akan muncul di sini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto e as imagens que copiares enquanto escreves com o Clink aparecem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст и изображения, скопированные во время печати в Clink, появятся здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Clink 打字时复制的文字和图片会显示在这里。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Textul și imaginile pe care le copiați în timp ce tastați cu Clink vor apărea aici."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst en afbeeldingen die u kopieert terwijl u typt met Clink, verschijnen hier."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Clink 打字時複製的文字和圖片會顯示在這裡。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj pojawi się tekst i obrazy, które skopiujesz podczas pisania za pomocą Clink."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст і зображення, які ви копіюєте під час введення за допомогою Clink, з’являться тут."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ile yazarken kopyaladığınız metin ve resimler burada görünecektir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se zobrazí text a obrázky, které zkopírujete při psaní pomocí Clink."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sa zobrazí text a obrázky, ktoré kopírujete počas písania pomocou Clink."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κείμενο και οι εικόνες που αντιγράφετε ενώ πληκτρολογείτε με το Clink θα εμφανίζονται εδώ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Text och bilder du kopierar medan du skriver med Clink kommer att visas här."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst og billeder, du kopierer, mens du skriver med Clink, vises her."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst og bilder du kopierer mens du skriver med Clink vil vises her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksti ja kuvat, jotka kopioit kirjoittaessasi Clink:llä, näkyvät tässä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
