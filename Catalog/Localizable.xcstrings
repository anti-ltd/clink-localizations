          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cursor leva-as de totalmente redondas a cantos direitos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один регулятор ведёт их от полностью скруглённых до угловатых."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
