    "Loads settings from the file. Your themes are untouched.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laai instellings vanaf die lêer. Jou temas is onaangeraak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt die Einstellungen aus der Datei. Deine Themes bleiben unangetastet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga los ajustes desde el archivo. Tus temas se quedan igual."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadib seaded failist. Sinu teemad jäävad puutumata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge les réglages depuis le fichier. Tes thèmes restent intacts."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Betölti a beállításokat a fájlból. A témáidhoz nem nyúl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica le impostazioni dal file. I tuoi temi restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルから設定を読み込みます。テーマはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에서 설정을 불러와요. 테마는 그대로 둬요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muatkan tetapan dari fail. Tema anda tak diusik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega as definições do ficheiro. Os teus temas ficam intactos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружает настройки из файла. Темы остаются нетронутыми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从文件里加载设置。你的主题不会动。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încarcă setările din fișier. Temele tale sunt neatinse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadt instellingen uit het bestand. Je thema's blijven onaangeroerd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從檔案里載入設定。你的主題不會動。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ładuje ustawienia z pliku. Twoje motywy są nietknięte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажує налаштування з файлу. Ваші теми недоторкані."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarları dosyadan yükler. Temalarınıza dokunulmaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načte nastavení ze souboru. Vaše témata jsou nedotčená."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Načíta nastavenia zo súboru. Vaše témy sú nedotknuté."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φορτώνει τις ρυθμίσεις από το αρχείο. Τα θέματά σας είναι ανέγγιχτα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Laddar inställningar från filen. Dina teman är orörda."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indlæser indstillinger fra filen. Dine temaer er uberørte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Laster inn innstillinger fra filen. Temaene dine er uberørte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataa asetukset tiedostosta. Teemasi ovat koskemattomia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memuat pengaturan dari file. Tema Anda tidak tersentuh."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải cài đặt từ tập tin. Chủ đề của bạn không bị ảnh hưởng."
