    "Rounds the top of the keyboard. The app you're typing in shows through the corners.": {
      "comment": "Android only: Themes > Background, rounding the keyboard's top corners.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Rond die bokant van die sleutelbord af. Die toepassing waarin jy tik, wys deur die hoeke."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaoblí horní okraj klávesnice. V rozích prosvítá aplikace, do které píšete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Runder tastaturets top. Den app, du skriver i, kan ses gennem hjørnerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rundet die Oberkante der Tastatur ab. In den Ecken scheint die App durch, in der du tippst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στρογγυλεύει το πάνω μέρος του πληκτρολογίου. Η εφαρμογή στην οποία πληκτρολογείτε φαίνεται μέσα από τις γωνίες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redondea la parte superior del teclado. La app en la que escribes se ve a través de las esquinas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ümardab klaviatuuri ülaosa. Rakendus, kuhu trükid, paistab nurkadest läbi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyöristää näppäimistön yläreunan. Sovellus, johon kirjoitat, näkyy kulmien läpi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrondit le haut du clavier. L’app dans laquelle vous tapez apparaît dans les coins."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lekerekíti a billentyűzet tetejét. A sarkokban átlátszik az app, amelyben gépelsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membulatkan bagian atas papan ketik. Aplikasi tempat Anda mengetik terlihat di sudutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrotonda la parte superiore della tastiera. Negli angoli si vede l’app in cui stai scrivendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの上端を丸くします。角からは入力中のアプリが見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 위쪽 모서리를 둥글게 만듭니다. 모서리로 입력 중인 앱이 보입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membulatkan bahagian atas papan kekunci. Apl yang anda taip kelihatan melalui bucunya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Runder av toppen av tastaturet. Appen du skriver i, vises gjennom hjørnene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rondt de bovenkant van het toetsenbord af. De app waarin u typt, is door de hoeken zichtbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaokrągla górę klawiatury. W narożnikach widać aplikację, w której piszesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arredonda o topo do teclado. O app em que você está digitando aparece pelos cantos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotunjește partea de sus a tastaturii. Aplicația în care scrieți se vede prin colțuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скругляет верх клавиатуры. В углах видно приложение, в котором вы печатаете."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaoblí horný okraj klávesnice. V rohoch presvitá aplikácia, do ktorej píšete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rundar av tangentbordets överkant. Appen du skriver i syns genom hörnen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyenin üst kısmını yuvarlar. Yazdığınız uygulama köşelerden görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заокруглює верх клавіатури. У кутах видно додаток, у якому ви вводите текст."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo tròn phần trên của bàn phím. Ứng dụng bạn đang nhập sẽ hiện qua các góc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将键盘顶部改为圆角，可透过圆角看到你正在输入的 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將鍵盤頂部改為圓角，可透過圓角看到你正在輸入的 App。"
          }
        }
      }
    },
    "No internet connection": {
      "comment": "Onboarding language picker: the language catalog could not load because the device is offline. A separate Try again button retries the request.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen internetverbinding"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné připojení k internetu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen internetforbindelse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Internetverbindung"
          }
        },
        "el": {
