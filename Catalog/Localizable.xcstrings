    "Clink asks to confirm it's you before showing what's stored.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink vra om te bevestig dat dit jy is voordat jy wys wat gestoor is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink fragt nach einer Bestätigung, bevor Gespeichertes angezeigt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink pide confirmar que eres tú antes de mostrar lo guardado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink palub enne salvestatu kuvamist kinnitada, et see oled sina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink demande de confirmer que c’est bien toi avant d’afficher ce qui est stocké."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink megerősítést kér, mielőtt megmutatja a tárolt adatokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink chiede di confermare che sei tu prima di mostrare ciò che è salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されている内容を表示する前に、Clinkが本人確認を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink는 저장된 내용을 표시하기 전에 본인 확인을 요청합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink meminta pengesahan bahawa ini anda sebelum menunjukkan apa yang disimpan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink pede para confirmar que és tu antes de mostrar o que está guardado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink просит подтвердить, что это вы, прежде чем показать сохранённое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在显示已存储内容前，Clink 会要求确认是你本人。"
          }
        }
      }
    },
    "Clink can show what Cling is holding but not change it. Turn on write access in Cling under Connected apps.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink kan wys wat Cling vashou, maar dit nie verander nie. Skakel skryftoegang in Cling aan onder Gekoppelde programme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink kann zeigen, was Cling hält, es aber nicht ändern. Aktiviere den Schreibzugriff in Cling unter Verbundene Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink puede mostrar lo que guarda Cling, pero no cambiarlo. Activa el acceso de escritura en Cling, en Apps conectadas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink saab näidata, mida Cling hoiab, aga ei saa seda muuta. Lülita Clingis jaotises Ühendatud rakendused sisse kirjutamisjuurdepääs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink peut afficher le contenu de Cling mais pas le modifier. Active l’accès en écriture dans Cling, sous Apps connectées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink meg tudja mutatni, mi van a Clingben, de módosítani nem. Kapcsold be az írási hozzáférést a Clingben, a Csatlakoztatott appok alatt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink può mostrare quello che contiene Cling ma non modificarlo. Attiva l'accesso in scrittura in Cling, in App connesse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink は Cling の内容を表示できますが、変更はできません。Cling の連携アプリで書き込みを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink는 Cling의 내용을 보여줄 수는 있지만 변경할 수는 없습니다. Cling의 연결된 앱에서 쓰기 권한을 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink boleh menunjukkan isi Cling tetapi tidak boleh mengubahnya. Hidupkan akses tulis dalam Cling di Apl bersambung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink pode mostrar o que o Cling tem, mas não alterar. Ative o acesso de escrita no Cling, em Apps ligadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink может показывать содержимое Cling, но не менять его. Включите доступ на запись в Cling, в разделе «Подключённые приложения»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 可以显示 Cling 里的内容，但不能修改。请在 Cling 的「已连接的 App」中开启写入权限。"
          }
        }
      }
    },
    "Clink can't hear you": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
