        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個頁面都會顯示全部微調控制元件，外加實驗室"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda kontrolka dostrajania jest pokazana na każdej stronie, a także Laboratorium."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен елемент керування точним налаштуванням відображається всередині кожної сторінки, а також лабораторія."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ince ayar kontrolü, her sayfada artı Laboratuvar'da gösterilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý doladěný ovládací prvek je zobrazen na každé stránce plus laboratoř."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý ovládací prvok jemného doladenia je zobrazený na každej stránke plus laboratórium."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε στοιχείο ελέγχου λεπτομέρειας εμφανίζεται μέσα σε κάθε σελίδα, συν το Εργαστήριο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje finjusteringskontroll visas på varje sida, plus labbet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver finjusteringskontrol vises inde på hver side, plus laboratoriet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver finjusteringskontroll vises på hver side, pluss laboratoriet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen hienosäätösäädin näkyy jokaisen sivun sisällä sekä Lab."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap kontrol penyesuaian ditampilkan di dalam setiap halaman, ditambah Lab."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi điều khiển tinh chỉnh đều được hiển thị bên trong mỗi trang, cùng với Lab."
          }
        }
      }
    },
    "Every key cycles the hue wheel together.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke sleutel draai die kleurwiel saam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Tasten durchlaufen den Farbkreis gemeinsam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las teclas recorren el círculo de color a la vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik klahvid läbivad värviratta koos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les touches parcourent la roue des couleurs ensemble."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden gomb együtt jár körbe a színkörön."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i tasti percorrono insieme la ruota dei colori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのキーが同時に色相を巡ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 키가 함께 색상환을 돕니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua kekunci melalui roda warna bersama-sama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as teclas percorrem o círculo de cores em conjunto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все клавиши вместе проходят по цветовому кругу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有按键一同循环色环。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare cheie circulă împreună cu roata de nuanțe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke toets laat het tintwiel samen draaien."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有按鍵一同迴圈色環。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy klawisz przełącza koło barw."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна клавіша разом обертає колесо відтінків."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her tuş renk tekerleğini birlikte döndürür."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá klávesa otáčí kolečkem odstínu společně."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý kľúč spolu cykluje koliesko odtieňa."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε πλήκτρο ενώνει τον τροχό απόχρωσης."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje tangent växlar färgtonshjulet tillsammans."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver tast cykler farvetonehjulet sammen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver tast sykler fargetonehjulet sammen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen avain pyörittää sävypyörää yhdessä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap kunci memutar roda rona secara bersamaan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi phím sẽ xoay bánh xe màu sắc cùng nhau."
          }
        }
      }
    },
    "Every key's glass blends as one sheet, so a press repaints the whole keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Glas aller Tasten verschmilzt zu einer Fläche, daher zeichnet ein Tipp die ganze Tastatur neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cristal de todas las teclas se funde en una sola lámina, así que cada toque redibuja todo el teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõigi klahvide klaas sulandub üheks pinnaks, nii et vajutus joonistab kogu klaviatuuri uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le verre de toutes les touches se fond en une seule plaque : une frappe redessine tout le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden billentyű üvege egy lappá olvad, így egy érintés az egész billentyűzetet újrarajzolja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vetro di tutti i tasti si fonde in un’unica lastra, quindi un tocco ridisegna tutta la tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのキーのガラスが1枚に溶け合うため、1回押すとキーボード全体が再描画されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 키의 유리가 한 장으로 합쳐져, 한 번 누르면 키보드 전체를 다시 그립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaca setiap kekunci bergabung sebagai satu kepingan, jadi satu tekanan melukis semula seluruh papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O vidro de todas as teclas se funde numa só folha, então um toque redesenha o teclado inteiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стекло всех клавиш сливается в один лист, поэтому каждое нажатие перерисовывает всю клавиатуру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有按键的玻璃融合为一整片，因此每次按下都会重绘整个键盘。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticla fiecărei taste se amestecă ca o singură foaie, așa că o presă revopsește întreaga tastatură."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het glas van elke toets loopt als één vel over, zodat een druk op het toetsenbord het hele toetsenbord opnieuw schildert."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有按鍵的玻璃融合為一整片，因此每次按下都會重繪整個鍵盤。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke sleutel se glas meng as een vel, dus verf 'n druk die hele sleutelbord oor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szkło każdego klawisza łączy się w jeden arkusz, więc prasa przemalowuje całą klawiaturę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скло кожної клавіші зливається як один аркуш, тому натискання перефарбовує всю клавіатуру."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her tuşun camı tek bir sayfa halinde birleşiyor, böylece bir tuşa basıldığında klavyenin tamamı yeniden boyanıyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sklo každé klávesy splyne jako jeden list, takže stisknutím překreslíte celou klávesnici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sklo každého klávesu splynie ako jeden list, takže stlačením prekreslíte celú klávesnicu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το γυαλί κάθε πλήκτρου αναμειγνύεται ως ένα φύλλο, έτσι ένα πάτημα βάφει ξανά ολόκληρο το πληκτρολόγιο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje tangents glas smälter samman som ett ark, så en tryckning målar om hela tangentbordet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver tasts glas blander sig som et ark, så et tryk maler hele tastaturet om."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver tasts glass smelter sammen som ett ark, så et trykk maler hele tastaturet på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisen näppäimen lasi sekoittuu yhdeksi levyksi, joten painallus maalaa koko näppäimistön uudelleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaca setiap kunci menyatu menjadi satu lembar, sehingga pers akan mengecat ulang seluruh keyboard."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặt kính của mỗi phím hòa quyện thành một tấm, do đó, chỉ cần nhấn một lần, toàn bộ bàn phím sẽ được sơn lại."
          }
        }
      }
    },
