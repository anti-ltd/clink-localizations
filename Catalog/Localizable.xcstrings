          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mye nøkler vingler før de slår seg. Ingen legger seg rent."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka paljon näppäimet heiluvat ennen kuin ne asettuvat. Mikään ei laskeudu puhtaaksi."
