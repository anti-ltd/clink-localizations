    "Hold the emoji to feel it. Drag the marks to change how long.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou die emoji vas om dit te voel. Sleep die merke om hoe lank te verander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte das Emoji, um es zu spüren. Zieh an den Strichen, um die Dauer zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el emoji para notarlo. Arrastra las marcas para cambiar cuánto dura."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia emojisid, et tunda. Lohista märke, et muuta kestust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens l'emoji pour le sentir. Fais glisser les marques pour changer la durée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd nyomva az emodzsit, hogy érezd. A vonalak húzásával állíthatod az időt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto l'emoji per sentirlo. Trascina i segni per cambiare la durata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵文字を長押しすると体感できます。目盛りをドラッグすると長さを変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이모지를 꾹 눌러 보세요. 눈금을 끌면 길이를 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan emoji untuk merasainya. Seret tanda untuk ubah tempohnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o emoji premido para sentires. Arrasta as marcas para mudares a duração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержите эмодзи, чтобы почувствовать. Двигайте метки, чтобы изменить длительность."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住表情就能体验。拖动刻度可以改时长。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține emoji-ul pentru a-l simți. Trageți marcajele pentru a modifica cât timp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de emoji vast om hem te voelen. Versleep de markeringen om de lengte te wijzigen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住表情就能體驗。拖動刻度可以改時長。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj emoji, aby to poczuć. Przeciągnij znaczniki, aby zmienić czas trwania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте емодзі, щоб відчути його. Перетягніть позначки, щоб змінити тривалість."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hissetmek için emojiyi basılı tutun. Süreyi değiştirmek için işaretleri sürükleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte emotikon, abyste to cítili. Přetažením značek změníte délku."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte emotikon, aby ste to cítili. Potiahnutím značiek zmeníte dĺžku."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε το emoji για να το νιώσετε. Σύρετε τα σημάδια για να αλλάξετε τη διάρκεια."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll i emojin för att känna den. Dra markeringarna för att ändra hur länge."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold emoji'en for at mærke den. Træk mærkerne for at ændre hvor længe."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold emojien for å føle den. Dra merkene for å endre hvor lenge."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitele emojia tunteaksesi sen. Muuta pituutta vetämällä merkkejä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegang emoji untuk merasakannya. Seret tanda untuk mengubah durasinya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ biểu tượng cảm xúc để cảm nhận nó. Kéo dấu để thay đổi trong bao lâu."
          }
        }
      }
    },
    "Hold the globe key, switch to another keyboard and back, so Clink reloads.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou die aardbolsleutel vas, skakel oor na 'n ander sleutelbord en terug, sodat Clink herlaai."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Globustaste, wechsle zu einer anderen Tastatur und wieder zurück, damit Clink neu lädt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la tecla del globo, cambia a otro teclado y vuelve, para que Clink se recargue."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia gloobusklahvi, vaheta teisele klaviatuurile ja tagasi, et Clink uuesti laadiks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens la touche globe, passe à un autre clavier puis reviens : Clink se recharge."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd nyomva a földgömb gombot, válts át másik billentyűzetre, majd vissza, hogy a Clink újratöltsön."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto il tasto globo, passa a un'altra tastiera e torna indietro, così Clink si ricarica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地球儀キーを長押しして別のキーボードに切り替え、また戻します。これでClinkが読み込み直されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지구본 키를 길게 눌러 다른 키보드로 갔다가 돌아오면 Clink가 다시 불러옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan kekunci globe, tukar ke papan kekunci lain dan kembali, supaya Clink dimuat semula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a tecla do globo premida, muda para outro teclado e volta, para o Clink recarregar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержите клавишу глобуса, переключитесь на другую клавиатуру и обратно, чтобы Clink перезагрузился."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住地球键，切到别的键盘再切回来，Clink 就会重新加载。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți apăsată tasta glob, comutați la altă tastatură și înapoi, astfel încât Clink se reîncarcă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de globe-toets ingedrukt, schakel over naar een ander toetsenbord en terug, zodat Clink opnieuw wordt geladen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住地球鍵，切到別的鍵盤再切回來，Clink 就會重新載入。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj klawisz kuli ziemskiej, przełącz się na inną klawiaturę i z powrotem, aby Clink przeładował się."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте клавішу глобуса, перемикайтеся на іншу клавіатуру й назад, щоб Clink перезавантажився."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küre tuşunu basılı tutun, başka bir klavyeye geçin ve geri dönün, böylece Clink yeniden yüklenir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte klávesu zeměkoule, přepněte na jinou klávesnici a zpět, takže se Clink znovu načte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte kláves zemegule, prepnite na inú klávesnicu a späť, aby sa Clink znova načítalo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε το πλήκτρο υδρόγειου, μεταβείτε σε άλλο πληκτρολόγιο και πίσω, ώστε το Clink να φορτώσει ξανά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll globtangenten, byt till ett annat tangentbord och tillbaka, så Clink laddas om."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold globustasten nede, skift til et andet tastatur og tilbage, så Clink genindlæses."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold globustasten, bytt til et annet tastatur og tilbake, så Clink laster inn på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä maapallonäppäintä painettuna, vaihda toiseen näppäimistöön ja takaisin, jotta Clink latautuu uudelleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan tombol globe, alihkan ke keyboard lain dan kembali, sehingga Clink dimuat ulang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ phím địa cầu, chuyển sang bàn phím khác và quay lại để Clink tải lại."
          }
        }
      }
    },
