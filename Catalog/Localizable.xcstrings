    "Tap the new key and give it something to do: a tool, a phrase, an action.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik die nuwe sleutel en gee dit iets om te doen: 'n instrument, 'n frase, 'n aksie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe die neue Taste an und gib ihr eine Aufgabe: ein Werkzeug, einen Textbaustein, eine Aktion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la tecla nueva y dale algo que hacer: una herramienta, una frase, una acción."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta uuele klahvile ja anna talle ülesanne: tööriist, fraas või tegevus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche la nouvelle touche et donne-lui un rôle : un outil, une phrase, une action."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints az új billentyűre, és adj neki feladatot: eszközt, szöveget, műveletet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il nuovo tasto e dagli qualcosa da fare: uno strumento, una frase, un'azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加したキーをタップして、役割を決めます。ツール、定型文、アクションから選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 키를 눌러 할 일을 정하세요. 도구, 문구, 동작 중에서 고를 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kekunci baharu itu dan berikan tugasnya: alat, frasa, atau tindakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca na tecla nova e dá-lhe algo para fazer: uma ferramenta, uma frase, uma ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на новую клавишу и задайте ей дело: инструмент, фразу, действие."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点新键，给它一个用处：一个工具、一段文字，或一个动作。"
          }
        }
      }
    },
    "Tap the size badge on a row to see exactly what's stored.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik die grootte kenteken op 'n ry om presies te sien wat gestoor is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf das Größen-Badge einer Zeile, um genau zu sehen, was gespeichert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la etiqueta de tamaño de una fila para ver exactamente qué hay guardado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta real suurusmärgile, et näha täpselt, mis on salvestatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche le badge de taille d’une ligne pour voir exactement ce qui est stocké."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy sor méretjelzőjére, hogy pontosan lásd, mi van tárolva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca l’etichetta con la dimensione su una riga per vedere esattamente cosa è salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行のサイズバッジをタップすると、保存されている内容をそのまま確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행의 용량 배지를 탭하면 저장된 내용을 그대로 확인할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik lencana saiz pada satu baris untuk melihat dengan tepat apa yang disimpan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca no indicador de tamanho de uma linha para veres exatamente o que está guardado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на плашку с размером в строке, чтобы увидеть, что именно там хранится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点某一行的容量标记，即可查看具体存储了什么。"
          }
        }
      }
    },
