    "Plain text, one word per line, with an optional count after it (\"word 1234\") to rank suggestions.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewone teks, een woord per reël, met 'n opsionele telling daarna (\"woord 1234\") om voorstelle te rangskik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiner Text, ein Wort pro Zeile, optional mit einer Zahl dahinter („Wort 1234“), um Vorschläge zu sortieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto sin formato, una palabra por línea, con un número opcional detrás («palabra 1234») para ordenar las sugerencias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihttekst, üks sõna rea kohta, valikuline arv järel („sõna 1234\") soovituste järjestamiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte brut, un mot par ligne, éventuellement suivi d’un nombre (« mot 1234 ») pour classer les suggestions."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyszerű szöveg, soronként egy szó, mögé tehetsz egy számot („szó 1234”), ami a javaslatok sorrendjét adja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo semplice, una parola per riga, con un numero facoltativo dopo («parola 1234») per ordinare i suggerimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレーンテキストで 1 行 1 語。語の後ろに数値（「単語 1234」）を書くと候補の順番に使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 텍스트로 한 줄에 한 단어씩. 단어 뒤에 숫자(\"단어 1234\")를 적으면 추천 순서에 반영됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks biasa, satu perkataan setiap baris, dengan nombor pilihan selepasnya (\"perkataan 1234\") untuk menyusun cadangan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto simples, uma palavra por linha, com um número opcional a seguir («palavra 1234») para ordenar as sugestões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычный текст, по слову в строке, при желании с числом после него («слово 1234») для ранжирования подсказок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纯文本，每行一个词；词后可加数字（“词 1234”）来决定候选顺序。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Text simplu, un cuvânt pe rând, cu un număr opțional după el (\"cuvântul 1234\") pentru a clasifica sugestiile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Platte tekst, één woord per regel, met een optionele telling erna (\"woord 1234\") om suggesties te rangschikken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "純文字，每行一個詞；詞後可加數字（“詞 1234”）來決定候選順序。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwykły tekst, jedno słowo w wierszu, z opcjonalną liczbą po nim („słowo 1234”) w celu uszeregowania sugestii."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звичайний текст, по одному слову на рядок, із необов’язковим підрахунком після нього («слово 1234») для ранжирування пропозицій."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önerileri sıralamak için her satıra bir kelime ve sonrasında isteğe bağlı bir sayım (\"kelime 1234\") içeren düz metin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prostý text, jedno slovo na řádek, s volitelným počtem za ním („slovo 1234“) pro hodnocení návrhů."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čistý text, jedno slovo na riadok, s voliteľným počtom za ním („slovo 1234“) na hodnotenie návrhov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απλό κείμενο, μία λέξη ανά γραμμή, με προαιρετική καταμέτρηση μετά από αυτήν (\"λέξη 1234\") για την ταξινόμηση των προτάσεων."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanlig text, ett ord per rad, med ett valfritt antal efter (\"ord 1234\") för att rangordna förslag."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Almindelig tekst, et ord pr. linje, med et valgfrit antal efter (\"ord 1234\") for at rangere forslag."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ren tekst, ett ord per linje, med et valgfritt antall etter (\"ord 1234\") for å rangere forslag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelkkää tekstiä, yksi sana riviä kohden, jonka jälkeen valinnainen määrä (\"sana 1234\") ehdotusten luokitteluun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks biasa, satu kata per baris, dengan jumlah opsional setelahnya (\"kata 1234\") untuk menentukan peringkat saran."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản thuần túy, một từ trên mỗi dòng, với số đếm tùy chọn sau nó (\"từ 1234\") để xếp hạng các đề xuất."
          }
        }
      }
    },
