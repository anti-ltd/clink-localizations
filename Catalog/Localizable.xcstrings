    "Lights off. Pick a style to light up the keys.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht aus. Wähle einen Stil, um die Tasten zu beleuchten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luces apagadas. Elige un estilo para iluminar las teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuled kustus. Vali stiil, et klahvid süttiksid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumières éteintes. Choisissez un style pour éclairer les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Világítás kikapcsolva. Válassz stílust a billentyűk megvilágításához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Luci spente. Scegli uno stile per illuminare i tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライトはオフです。スタイルを選ぶとキーが光ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조명이 꺼져 있어요. 스타일을 골라 키를 밝혀 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu dimatikan. Pilih gaya untuk menyalakan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Luzes apagadas. Escolhe um estilo para iluminar as teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсветка выключена. Выберите стиль, чтобы подсветить клавиши."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯光已关闭。选择一种样式来点亮按键。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Luminile stinse. Alegeți un stil pentru a lumina tastele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lichten uit. Kies een stijl om de toetsen te verlichten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "燈光已關閉。選擇一種樣式來點亮按鍵。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lig af. Kies 'n styl om die sleutels te verlig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Światła wyłączone. Wybierz styl, aby podświetlić klawisze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Світло вимкнено. Виберіть стиль підсвічування клавіш."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işıklar kapalı. Tuşları aydınlatacak bir stil seçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zhasnutá světla. Vyberte styl pro rozsvícení kláves."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Svetlá vypnuté. Vyberte štýl na rozsvietenie klávesov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σβηστά φώτα. Επιλέξτε ένα στυλ για να φωτίσετε τα πλήκτρα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Belysningen släckt. Välj en stil för att lysa upp tangenterna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lys slukket. Vælg en stil for at lyse tasterne op."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lysene er av. Velg en stil for å lyse opp tastene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valot pois päältä. Valitse tyyli sytyttääksesi näppäimet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu mati. Pilih gaya untuk menyalakan tombol."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt đèn. Chọn một phong cách để làm sáng các phím."
          }
        }
      }
    },
