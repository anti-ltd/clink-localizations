    "Computed on this device. Nothing is uploaded, shared, or sold.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auf diesem Gerät berechnet. Nichts wird hochgeladen, geteilt oder verkauft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se calcula en este dispositivo. No se sube, comparte ni vende nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé sur cet appareil. Rien n'est envoyé, partagé ou vendu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen a készüléken számoljuk ki. Semmit nem töltünk fel, osztunk meg vagy adunk el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolato su questo dispositivo. Niente viene caricato, condiviso o venduto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末上で計算されます。アップロードも共有も販売も一切しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 계산돼요. 업로드하거나 공유하거나 판매하지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikira pada peranti ini. Tiada apa-apa yang dimuat naik, dikongsi atau dijual."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado neste dispositivo. Nada é enviado, partilhado ou vendido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё считается на этом устройстве. Ничего не загружается, не передаётся и не продаётся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本机计算。不会上传、共享或出售任何数据。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvutatakse selles seadmes. Midagi ei laadita üles, ei jagata ega müüda."
