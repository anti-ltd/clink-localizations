          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrisul de mână este dezactivat. Porniți-l pentru ao utiliza și personalizați."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handschrift is uitgeschakeld. Schakel het in om het te gebruiken en aan te passen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手寫已關閉。開啟後就能使用並調整設定。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pismo ręczne jest wyłączone. Włącz go, aby go używać i dostosowywać."
