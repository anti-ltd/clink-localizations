        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa lama Anda harus menahan bilah spasi sebelum mode kursor diaktifkan. Naikkan jika kursor terpicu secara tidak sengaja saat mengetik."
          }
        },
        "vi": {
