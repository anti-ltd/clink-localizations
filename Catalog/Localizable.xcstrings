        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 뒤 키보드를 사진이 채우면서 그라데이션을 덮어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto mengisi papan kekunci di belakang kekunci dan mengatasi gradien."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma foto enche o teclado por trás das teclas e substitui o gradiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото заполняет клавиатуру за клавишами и заменяет градиент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片铺满按键后面的键盘，盖过渐变。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O fotografie umple tastatura din spatele tastelor și suprascrie gradientul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een foto vult het toetsenbord achter de toetsen en overschrijft het verloop."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片鋪滿按鍵後面的鍵盤，蓋過漸變。"
