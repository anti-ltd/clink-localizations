          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个键帽罩上一层颜色，像发光键帽。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O spălare de culoare peste fiecare capac, ca o tastă aprinsă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een vleugje kleur over elke dop, als een verlichte toetsdop."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為每個鍵帽罩上一層顏色，像發光鍵帽。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolor na każdej nasadce, przypominający podświetlany klawisz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кольоровий відтінок на кожній кришкі, як підсвічена клавіша."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kapağın üzerinde yanan bir klavye tuşu gibi bir renk tonu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Barva přes každou čepici, jako rozsvícená klíčenka."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Premytie farby cez každú čiapku, ako rozsvietená kľúčenka."
