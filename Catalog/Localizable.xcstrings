    "Set the color and the speed underneath.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stel die kleur en die spoed daaronder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbe und Tempo stellst du darunter ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debajo ajustas el color y la velocidad."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Määra allpool värv ja kiirus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle la couleur et la vitesse en dessous."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alatta állítsd be a színt és a sebességet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sotto imposti il colore e la velocità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その下で色と速さを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 아래에서 색과 속도를 정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan warna dan kelajuan di bawahnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Define a cor e a velocidade por baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте цвет и скорость ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下面设置颜色和速度。"
          }
        }
      }
    },
