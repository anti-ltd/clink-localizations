    "Open the Clink keyboard with Full Access enabled to show the text replacements iOS shares with Clink.": {
      "comment": "Text replacement settings page. iOS entries are a read-only snapshot shared by the keyboard extension; Settings opens the app settings page.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Clink keyboard with Full Access enabled to show the text replacements iOS shares with Clink."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el teclado Clink con «Permitir acceso total» activado para ver las sustituciones de texto que iOS comparte con Clink."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le clavier Clink avec l’option « Autoriser l’accès complet » activée pour afficher les remplacements de texte qu’iOS partage avec Clink."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere „Vollen Zugriff erlauben“ und öffne die Clink-Tastatur, um die von iOS geteilten Textersetzungen anzuzeigen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la tastiera Clink con «Consenti accesso completo» attivo per vedere le sostituzioni testo che iOS condivide con Clink."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o teclado Clink com a opção «Permitir acesso total» ativada para veres as substituições de texto que o iOS partilha com o Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Разрешить полный доступ» и откройте клавиатуру Clink, чтобы увидеть замены текста, которые iOS передаёт Clink."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka papan kekunci Clink dengan “Benarkan Akses Penuh” diaktifkan untuk melihat penggantian teks yang dikongsi oleh iOS dengan Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a „Teljes hozzáférés engedélyezése” beállítást, majd nyisd meg a Clink billentyűzetet az iOS által megosztott szövegcserék megtekintéséhez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「フルアクセスを許可」をオンにしてClinkキーボードを開くと、iOSから共有されたユーザ辞書の項目が表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用“允许完全访问”后打开 Clink 键盘，即可查看 iOS 向 Clink 共享的文本替换。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘전체 접근 허용’을 켜고 Clink 키보드를 열면 iOS에서 Clink에 공유한 텍스트 대치 항목을 볼 수 있습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita sisse „Luba täielik juurdepääs” ja ava Clinki klaviatuur, et näha tekstiasendusi, mida iOS Clinkiga jagab."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți tastatura Clink cu Acces complet activat pentru a afișa înlocuirile de text pe care iOS le partajează cu Clink."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open het Clink-toetsenbord met volledige toegang ingeschakeld om de tekstvervangingen weer te geven die iOS deelt met Clink."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用“允許完整取用”後開啟 Clink 鍵盤，即可檢視 iOS 向 Clink 共享的文字替換。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak die Clink-sleutelbord oop met Volle Toegang geaktiveer om die teksvervangings te wys wat iOS met Clink deel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz klawiaturę Clink z włączonym pełnym dostępem, aby wyświetlić tekst zastępujący tekst iOS współdzielony z Clink."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте клавіатуру Clink із увімкненим повним доступом, щоб показати заміни тексту, якими iOS ділиться з Clink."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS'in Clink ile paylaştığı metin değiştirmeleri göstermek için Tam Erişim etkinleştirilmiş Clink klavyeyi açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete klávesnici Clink s povoleným plným přístupem a zobrazte nahrazení textu, které iOS sdílí se Clink."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte klávesnicu Clink s povoleným úplným prístupom a zobrazte nahradenia textu, ktoré iOS zdieľa so Clink."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το πληκτρολόγιο Clink με ενεργοποιημένη την πλήρη πρόσβαση για να εμφανίσετε τις αντικαταστάσεις κειμένου που κοινοποιούνται στο iOS με το Clink."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Clink-tangentbordet med Full Access aktiverat för att visa textersättningarna iOS delar med Clink."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Clink-tastaturet med fuld adgang aktiveret for at vise teksterstatningerne iOS deler med Clink."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Clink-tastaturet med full tilgang aktivert for å vise teksterstatningene iOS deler med Clink."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Clink-näppäimistö, jossa Full Access on käytössä, näyttääksesi tekstin korvaukset, jotka iOS jakaa Clink:n kanssa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka keyboard Clink dengan Akses Penuh diaktifkan untuk menampilkan penggantian teks yang dibagikan iOS dengan Clink."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở bàn phím Clink đã bật Full Access để hiển thị các văn bản thay thế iOS chia sẻ với Clink."
          }
        }
      }
    },
