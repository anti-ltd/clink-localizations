    "No trail, no ripple. Cleanest.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geen spoor, geen rimpeling. Skoonste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Spur, keine Welle. Am aufgeräumtesten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin estela, sin onda. El más limpio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jälge pole, laineid pole. Puhtaim."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune traînée, aucune ondulation. Le plus net."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs nyom, nincs hullám. A legtisztább."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna scia, nessuna onda. Il più pulito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軌跡なし、波紋なし。いちばんすっきり。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔상도 물결도 없어요. 가장 깔끔해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada jejak, tiada riak. Paling bersih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem rasto, sem ondulação. O mais limpo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без следа и без волны. Самый чистый вариант."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无拖尾、无涟漪。最干净。"
          }
        }
      }
    },
    "No trail. Nothing is drawn while you glide.": {
