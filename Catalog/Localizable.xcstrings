    },
    "An Arabic diacritics key right of the space bar: tap for fatha, hold for the rest": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Arabiese diakritiese sleutel regs van die spasiebalk: tik vir fatha, hou vir die res"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Taste für arabische Diakritika rechts neben der Leertaste: tippen für Fatha, halten für den Rest"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tecla de diacríticos árabes a la derecha del espacio: toca para la fatha, mantén para el resto"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Araabia diakriitikute klahv tühikuklahvi paremal: puuduta fatha jaoks, hoia ülejäänute jaoks"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une touche de diacritiques arabes à droite de la barre d'espace : appuie pour la fatha, maintiens pour les autres"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Arab mellékjelek billentyűje a szóköztől jobbra: koppints a fathához, tartsd nyomva a többihez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tasto per i segni diacritici arabi a destra della barra spaziatrice: tocca per la fatha, tieni premuto per gli altri"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースバーの右にあるアラビア語の発音記号キー。タップでファトハ、長押しでその他"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스바 오른쪽의 아랍어 발음 기호 키. 탭하면 파트하, 길게 누르면 나머지"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci tanda diakritik Arab di sebelah kanan bar ruang: ketik untuk fatha, tahan untuk yang lain"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tecla de diacríticos árabes à direita da barra de espaço: toca para fatha, mantém para os restantes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиша арабских огласовок справа от пробела: нажатие — фатха, удержание — остальные"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空格键右侧的阿拉伯语符号键：轻点输入 fatha，长按选其他"
          }
        }
      }
    },
    "An active rule stays active within this margin of its threshold. Width margins are in points.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla activa se mantiene dentro de este margen del umbral. Los márgenes de ancho se expresan en puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle active le reste dans cette marge autour de son seuil. Les marges de largeur sont en points."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine aktive Regel bleibt innerhalb dieser Toleranz um den Schwellenwert aktiv. Breitentoleranzen sind in Punkten angegeben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regola attiva resta tale entro questo margine dalla soglia. I margini di larghezza sono in punti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma regra ativa mantém-se dentro desta margem do limiar. As margens de largura são em pontos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активное правило остаётся активным в пределах этого запаса от порога. Для ширины запас задаётся в пунктах."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peraturan aktif kekal aktif dalam margin ambangnya ini. Margin lebar diukur dalam mata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az aktív szabály e tűréshatáron belül aktív marad. A szélesség tűrése pontban értendő."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なルールは、しきい値からこの許容幅の範囲内では有効のままです。幅の単位はポイントです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已生效的规则在阈值附近的此余量范围内保持生效。宽度余量以点为单位。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 규칙은 임계값에서 이 허용 범위 내에 있으면 유지됩니다. 너비 허용 범위의 단위는 포인트입니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiivne reegel jääb selle varu piires aktiivseks. Laiuse varu mõõdetakse punktides."
          }
        }
      }
    },
    "An automation can temporarily override this setting. Your edits change the saved value.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una automatización puede sustituir temporalmente este ajuste. Tus cambios modifican el valor guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une automatisation peut remplacer temporairement ce réglage. Tes modifications changent la valeur enregistrée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Automation kann diese Einstellung vorübergehend überschreiben. Deine Änderungen gelten für den gespeicherten Wert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’automazione può modificare temporaneamente questa impostazione. Le tue modifiche cambiano il valore salvato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma automação pode substituir temporariamente esta definição. As tuas alterações mudam o valor guardado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматизация может временно заменить эту настройку. Ваши изменения меняют сохранённое значение."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Automasi boleh menggantikan tetapan ini buat sementara. Suntingan anda mengubah nilai tersimpan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy automatizálás ideiglenesen felülírhatja ezt a beállítást. A módosításaid a mentett értéket változtatják meg."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オートメーションでこの設定が一時的に上書きされることがあります。編集すると保存値が変更されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动化可以临时覆盖此设置。您的编辑会更改保存值。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동화가 이 설정을 임시로 변경할 수 있습니다. 편집한 내용은 저장된 값에 반영됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaatika võib selle seade ajutiselt üle kirjutada. Sinu muudatused muudavad salvestatud väärtust."
          }
        }
      }
    },
    "An automation could not run. Review its conditions and actions in Clink.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido ejecutar una automatización. Revisa sus condiciones y acciones en Clink."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une automatisation n’a pas pu s’exécuter. Vérifie ses conditions et ses actions dans Clink."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Automation konnte nicht ausgeführt werden. Prüfe ihre Bedingungen und Aktionen in Clink."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile eseguire un’automazione. Controlla le condizioni e le azioni in Clink."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível executar uma automação. Revê as condições e ações no Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить автоматизацию. Проверьте её условия и действия в Clink."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Automasi tidak dapat dijalankan. Semak syarat dan tindakannya dalam Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy automatizálás nem tudott lefutni. Ellenőrizd a feltételeit és műveleteit a Clinkben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オートメーションを実行できませんでした。Clinkで条件とアクションを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法运行某个自动化。请在 Clink 中检查其条件和操作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동화를 실행하지 못했습니다. Clink에서 조건과 동작을 확인해 주세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaatikat ei saanud käivitada. Vaata selle tingimused ja toimingud Clinkis üle."
          }
        }
      }
    },
    "An effect you built, or one a plugin offers.": {
