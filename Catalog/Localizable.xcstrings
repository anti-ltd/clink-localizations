    "Size controls adjust the keys, while spacing controls adjust the gaps around them.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Größenregler passen die Tasten an, die Abstandsregler die Zwischenräume um sie herum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los controles de tamaño ajustan las teclas y los de espaciado ajustan los huecos que las rodean."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Suuruse seaded muudavad klahve, vahede seaded aga nende ümber olevat ruumi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes de taille règlent les dimensions des touches, et celles d’espacement règlent les espaces autour."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A méretbeállításokkal a billentyűket, a térközbeállításokkal pedig a körülöttük lévő helyet módosíthatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I controlli delle dimensioni regolano i tasti, mentre quelli della spaziatura regolano gli spazi intorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「サイズ」ではキーの大きさを、「間隔」ではキーの周囲のすき間を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘크기’에서는 키의 크기를, ‘간격’에서는 키 주변의 빈 공간을 조절합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kawalan saiz melaraskan kekunci, manakala kawalan jarak melaraskan ruang di sekelilingnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os controlos de tamanho ajustam as teclas, enquanto os de espaçamento ajustam os espaços à sua volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки размера меняют сами клавиши, а настройки интервалов — расстояния между ними."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“大小”用于调整按键尺寸，“间距”用于调整按键周围的空隙。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comenzile de dimensiune ajustează tastele, în timp ce comenzile de spațiere reglează golurile din jurul lor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met de grootteregelaars worden de toetsen aangepast, terwijl de afstandsregelaars de openingen eromheen aanpassen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“大小”用於調整按鍵尺寸，“間距”用於調整按鍵周圍的空隙。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Grootte-kontroles pas die sleutels aan, terwyl spasiëringskontroles die gapings daaromheen aanpas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementy sterujące rozmiarem dostosowują klawisze, a elementy sterujące odstępami regulują odstępy wokół nich."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Елементи керування розміром регулюють клавіші, тоді як елементи керування інтервалом регулюють проміжки навколо них."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyut kontrolleri tuşları ayarlarken aralık kontrolleri etraflarındaki boşlukları ayarlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovládací prvky velikosti upravují klávesy, zatímco ovládací prvky rozestupu upravují mezery kolem nich."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovládacie prvky veľkosti upravujú klávesy, zatiaľ čo ovládacie prvky rozstupu upravujú medzery okolo nich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα χειριστήρια μεγέθους προσαρμόζουν τα πλήκτρα, ενώ τα χειριστήρια απόστασης προσαρμόζουν τα κενά γύρω τους."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Storlekskontroller justerar tangenterna, medan avståndskontroller justerar mellanrummen runt dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Størrelseskontroller justerer tasterne, mens afstandskontroller justerer hullerne omkring dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Størrelseskontroller justerer tastene, mens avstandskontroller justerer hullene rundt dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokosäätimet säätävät näppäimiä, kun taas välisäätimet säätävät rakoja niiden ympärillä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol ukuran menyesuaikan tombol, sementara kontrol jarak menyesuaikan celah di sekitarnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều khiển kích thước điều chỉnh các phím, trong khi điều khiển khoảng cách điều chỉnh khoảng trống xung quanh chúng."
          }
        }
      }
    },
