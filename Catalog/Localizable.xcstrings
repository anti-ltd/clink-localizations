    "After flipping back, insert a space so you can keep typing.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nadat jy teruggeblaai het, voeg 'n spasie in sodat jy kan aanhou tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Zurückwechseln ein Leerzeichen setzen, damit du weitertippen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al volver, mete un espacio para que sigas escribiendo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pärast tagasilülitamist lisa tühik, et saaksid jätkata tipimist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après être revenu, insère une espace pour que tu puisses continuer à taper."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Miután visszalapoztál, szúrj be egy szóközt, hogy gépelhess tovább."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando torni indietro, inserisce uno spazio così continui a scrivere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻ったあとにスペースを入れて、そのまま入力を続けられるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 돌아온 뒤에 공백을 넣어서 계속 입력할 수 있게 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas berbalik, sisipkan ruang supaya anda boleh terus menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de voltares, insere um espaço para continuares a escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После возврата вставлять пробел, чтобы можно было печатать дальше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切回去以后插个空格，你就能接着打。"
          }
        }
      }
    },
    "After typing punctuation on the symbols page, flip back to letters.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nadat jy leestekens op die simbole-bladsy getik het, blaai terug na letters."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einem Satzzeichen auf der Symbolseite zurück zu den Buchstaben wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de escribir un signo en la página de símbolos, vuelve a las letras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pärast kirjavahemärgi tipimist sümbolilehel lülita tagasi tähtedele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir tapé une ponctuation sur la page des symboles, revient aux lettres."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Miután beírtad az írásjelet a szimbólumoldalon, lapozz vissza a betűkre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver messo un segno di punteggiatura nella pagina dei simboli, torna alle lettere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記号ページで句読点を入力したら、文字に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기호 페이지에서 문장 부호를 입력한 뒤 글자로 다시 돌아가요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
