    "Drag 14pt to delete, 26pt per word. Fast deletions.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra 14 pt para borrar, 26 pt por palabra. Borrado rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse de 14 pt pour effacer, puis de 26 pt par mot. Effacement rapide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "14 pt ziehen zum Löschen, 26 pt pro Wort. Schnelles Löschen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina di 14 pt per eliminare, 26 pt per parola. Cancellazione rapida."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste 14 pt para apagar, 26 pt por palavra. Eliminação rápida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите на 14 пт для удаления, по 26 пт на слово. Быстрое удаление."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret 14 pt untuk memadam, 26 pt bagi setiap perkataan. Pemadaman pantas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzz 14 pt-ot a törléshez, szavanként 26 pt-ot. Gyors törlés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "14ptドラッグで開始し、26ptごとに1単語削除します。素早く削除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动 14 pt 开始删除，之后每 26 pt 删除一个词。删除速度快。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "14pt에서 삭제를 시작하고 단어마다 26pt씩 이동합니다. 빠르게 삭제합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutamiseks lohista 14 pt, iga sõna kohta 26 pt. Kiire kustutamine."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trageți 14 pt pentru a șterge, 26 pt pe cuvânt. Ștergeri rapide."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep 14pt om te verwijderen, 26pt per woord. Snelle verwijderingen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動 14 pt 開始刪除，之後每 26 pt 刪除一個詞。刪除速度快。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep 14pt om te verwyder, 26pt per woord. Vinnige verwyderings."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij 14 punktów, aby usunąć, 26 punktów na słowo. Szybkie usuwanie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть 14pt, щоб видалити, 26pt на слово. Швидке видалення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silmek için 14pt, kelime başına 26pt sürükleyin. Hızlı silmeler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetažením 14 bodů smažete, 26 bodů na slovo. Rychlé mazání."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnutím 14 bodov odstránite, 26 bodov na slovo. Rýchle mazanie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε 14 pt για διαγραφή, 26 pt ανά λέξη. Γρήγορες διαγραφές."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra 14 pkt för att radera, 26 pkt per ord. Snabba borttagningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk 14 pkt for at slette, 26 pkt pr. ord. Hurtige sletninger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra 14 pkt for å slette, 26 pkt per ord. Raske slettinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista vetämällä 14 pt, 26 pt per sana. Nopeat poistot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret 14pt untuk menghapus, 26pt per kata. Penghapusan cepat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo 14pt để xóa, 26pt mỗi từ. Xóa nhanh."
          }
        }
      }
    },
