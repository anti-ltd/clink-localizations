    "Edit ABC in the Keys tab and edit 123 / #+= in the Pages tab. All keys and rows are designed directly in the live preview.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wysig ABC in die Sleutels-oortjie en wysig 123 / #+= in die Bladsye-oortjie. Alle sleutels en rye word direk in die regstreekse voorskou ontwerp."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ABC bearbeitest du im Tab „Tasten“, 123 / #+= im Tab „Seiten“. Alle Tasten und Reihen gestaltest du direkt in der Live-Vorschau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ABC se edita en la pestaña Teclas y 123 / #+= en la pestaña Páginas. Todas las teclas y filas se diseñan directamente en la vista previa en vivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuda ABC-d kaardil Klahvid ja 123 / #+= kaardil Lehed. Kõik klahvid ja read kujundad otse reaalajas eelvaates."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ABC se modifie dans l’onglet Touches, et 123 / #+= dans l’onglet Pages. Toutes les touches et rangées se conçoivent directement dans l’aperçu en direct."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ABC-t a Billentyűk fülön szerkeszted, a 123 / #+= oldalt pedig az Oldalak fülön. Minden billentyűt és sort közvetlenül az élő előnézetben alakítasz ki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ABC si modifica nella scheda Tasti, mentre 123 / #+= nella scheda Pagine. Tutti i tasti e le righe si progettano direttamente nell’anteprima dal vivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ABC は「キー」タブ、123 / #+= は「ページ」タブで編集します。キーも行も、すべてライブプレビュー上で直接デザインします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ABC는 ‘키’ 탭에서, 123 / #+=는 ‘페이지’ 탭에서 편집합니다. 키와 행은 모두 실시간 미리보기에서 바로 디자인합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunting ABC dalam tab Kekunci dan sunting 123 / #+= dalam tab Halaman. Semua kekunci dan baris direka terus dalam pratonton langsung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ABC edita-se no separador Teclas e o 123 / #+= no separador Páginas. Todas as teclas e linhas são desenhadas diretamente na pré-visualização ao vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ABC правится на вкладке «Клавиши», а 123 и #+= — на вкладке «Страницы». Все клавиши и ряды собираются прямо в живом предпросмотре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ABC 在「按键」标签页里编辑，123 / #+= 在「页面」标签页里编辑。所有按键和行都直接在实时预览中设计。"
          }
        }
      }
    },
