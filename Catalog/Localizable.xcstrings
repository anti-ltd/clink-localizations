        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펫을 끄거나, 다른 펫을 골라 다른 구석으로 옮기세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
