    "Thick trail · strong, wide ripple.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dik spoor · sterk, wye rimpeling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicke Spur · starke, breite Welle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trazo grueso · onda fuerte y amplia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paks jälg · tugev, lai laine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace épaisse · ondulation forte et large."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastag nyom · erős, széles hullám."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scia spessa · onda forte e ampia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "太い軌跡 · 強く広い波紋。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두꺼운 궤적 · 강하고 넓은 물결."
          }
        },
