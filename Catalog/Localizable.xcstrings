        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți Traducere și porniți-l, apoi setați limba în care traduceți de obicei."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Vertalen, schakel het in en stel vervolgens de taal in waarin u gewoonlijk vertaalt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟“翻譯”並開啟，再設好你常譯入的語言。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Tłumacz i włącz go, a następnie ustaw język, na który zwykle tłumaczysz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Перекладач і ввімкніть його, а потім виберіть мову, якою зазвичай перекладаєте."
