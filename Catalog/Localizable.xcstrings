    "Dictation types what you say, into whatever field you're in.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Diktat tippt, was du sagst, direkt in das Feld, in dem du gerade bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado escribe lo que dices en el campo en el que estés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée écrit ce que tu dis, dans le champ où tu te trouves."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktálás abba a mezőbe írja, amit mondasz, ahol épp vagy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura scrive quello che dici nel campo in cui ti trovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力は、話した内容を今いる入力欄にそのまま書き込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기는 말한 내용을 지금 있는 입력란에 그대로 적습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imlak menaip apa yang anda sebut, ke dalam medan yang sedang anda gunakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado escreve o que dizes, no campo onde estiveres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовка печатает сказанное прямо в то поле, где вы находитесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
