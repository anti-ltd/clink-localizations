    "Shift lights up when it's on, Return in Go and Send fields.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift lig op wanneer dit aan is, Return in Go en Send velde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umschalt leuchtet, wenn es aktiv ist, die Eingabetaste in Los- und Senden-Feldern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayúsculas se enciende cuando está activa, y Retorno en los campos Ir y Enviar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõstuklahv süttib, kui on sees, sisestusklahv Mine ja Saada väljades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Majuscules s’allume quand elle est active, et Retour dans les champs Aller et Envoyer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Shift akkor világít, ha be van kapcsolva, az Enter pedig az Ugrás és Küldés mezőkben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Maiuscole si accende quando è attivo, Invio nei campi Vai e Invia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift はオンのときに、リターンは「開く」や「送信」になる入力欄で光ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift는 켜졌을 때, Return은 ‘이동’이나 ‘보내기’ 입력란에서 켜져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift menyala apabila dihidupkan, Return pula dalam medan Pergi dan Hantar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Maiúsculas acende quando está ativo, e Return nos campos Ir e Enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift подсвечивается, когда включён, а Return — в полях «Вперёд» и «Отправить»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 开启时会亮起，Return 则在“前往”和“发送”输入框里亮。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift se aprinde când este pornit, Return în câmpurile Go și Send."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift licht op als deze is ingeschakeld, de velden Terug in Go en Verzenden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 開啟時會亮起，Return 則在“前往”和“傳送”輸入框裡亮。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift świeci się, gdy jest włączony, Return w polach Go i Send."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift світиться, коли він увімкнений, Return у полях Go та Send."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift açıkken yanar, Git ve Gönder alanlarında Geri Dön."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift se rozsvítí, když je zapnutý, pole Return in Go a Send."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift sa rozsvieti, keď je zapnutý, polia Return in Go a Send."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Shift ανάβει όταν είναι ενεργοποιημένο, τα πεδία Επιστροφή στα Μετάβαση και Αποστολή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift tänds när den är på, Återgå i Go och Skicka-fälten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift lyser, når den er tændt, Return in Go og Send felterne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift lyser når den er på, Return in Go og Send-feltene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihto syttyy, kun se on päällä, Palaa Mene- ja Lähetä-kentissä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift menyala saat aktif, Return di kolom Go dan Send."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift sáng lên khi nó được bật, Quay lại trong các trường Đi và Gửi."
          }
        }
      }
    },
