    "Quicker and busier, in smaller pieces.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schneller und dichter, in kleineren Teilchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más rápido y con más movimiento, en piezas más pequeñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus rapide et plus chargé, en éléments plus petits."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyorsabb és mozgalmasabb, apróbb darabokban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più rapido e movimentato, in pezzi più piccoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "速く、にぎやかに。粒は小さめ。"
          }
