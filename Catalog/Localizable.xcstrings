    "Community uploads are reviewed. Files can only be imported in Clink.": {
      "extractionState": "manual",
      "comment": "Clink Community sharing and moderation UI. Native editorial review required before release.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beiträge für die Community werden geprüft. Dateien lassen sich nur in Clink importieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les créations sont examinées avant publication. Les fichiers s’importent uniquement dans Clink."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las aportaciones se revisan antes de publicarse. Los archivos solo se pueden importar en Clink."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le creazioni vengono esaminate prima della pubblicazione. I file si possono importare solo in Clink."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As criações são revistas antes da publicação. Os ficheiros só podem ser importados no Clink."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inzendingen worden beoordeeld voordat ze verschijnen. Bestanden kun je alleen in Clink importeren."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Insendings word nagegaan voordat dit gepubliseer word. Lêers kan slegs in Clink ingevoer word."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Materiały są sprawdzane przed publikacją. Pliki można importować tylko w Clink."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Роботи перевіряються перед публікацією. Файли можна імпортувати лише в Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работы проверяются перед публикацией. Файлы можно импортировать только в Clink."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçerikler yayımlanmadan önce incelenir. Dosyalar yalnızca Clink’te içe aktarılabilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvky před zveřejněním kontrolujeme. Soubory lze importovat pouze v Clink."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príspevky pred zverejnením kontrolujeme. Súbory možno importovať iba v Clink."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contribuțiile sunt verificate înainte de publicare. Fișierele pot fi importate doar în Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A feltöltéseket közzététel előtt ellenőrizzük. A fájlok csak a Clinkben importálhatók."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üleslaaditud looming vaadatakse enne avaldamist üle. Faile saab importida ainult Clinkis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luomukset tarkistetaan ennen julkaisua. Tiedostoja voi tuoda vain Clinkissä."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapelser granskas innan de publiceras. Filer kan bara importeras i Clink."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreationer gennemgås, før de offentliggøres. Filer kan kun importeres i Clink."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreasjoner gjennomgås før de publiseres. Filer kan bare importeres i Clink."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι δημιουργίες ελέγχονται πριν δημοσιευτούν. Τα αρχεία εισάγονται μόνο στο Clink."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciptaan disemak sebelum diterbitkan. Fail hanya boleh diimport dalam Clink."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreasi ditinjau sebelum dipublikasikan. File hanya bisa diimpor di Clink."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung sẽ được duyệt trước khi đăng. Chỉ có thể nhập tệp trong Clink."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿は公開前に審査されます。ファイルはClinkアプリ内でのみ読み込めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창작물은 검토 후 게시됩니다. 파일은 Clink 앱에서만 가져올 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作品经审核后才会公开。文件只能在 Clink 内导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "作品經審核後才會公開。檔案只能在 Clink 內匯入。"
          }
        }
      }
    },
