          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경 탭에서 배경 애니메이션을 켜면 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
