    "Theme holds the built-in ones and a builder for your own.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tema hou die ingeboude en 'n bouer vir jou eie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter „Design“ liegen die mitgelieferten Designs und ein Editor für deine eigenen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema guarda los que vienen incluidos y un editor para los tuyos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teema hoiab sisseehitatuid ja ehitaja sinu enda jaoks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thème contient ceux fournis et un éditeur pour les tiens."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Téma oldalon vannak a beépítettek és egy szerkesztő a sajátjaidhoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Tema ci sono quelli inclusi e un editor per i tuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「テーマ」には標準のテーマと、自分で作るためのエディタがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마에는 기본 테마들과 직접 만드는 편집기가 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema menyimpan yang terbina dalam dan pembina untuk tema anda sendiri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema tem os que vêm de origem e um editor para os teus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Темах» лежат встроенные варианты и редактор для своих."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“主题”里有内置主题，也有做自己主题的编辑器。"
          }
        }
