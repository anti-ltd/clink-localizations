    "Fill the empty bar with your tools. Off keeps it clear until suggestions appear.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul die leë balk met jou gereedskap. Af hou dit duidelik totdat voorstelle verskyn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt die leere Leiste mit deinen Tools. Deaktiviert bleibt sie leer, bis Vorschläge erscheinen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llena la barra vacía con tus herramientas. Desactivado, permanece despejada hasta que aparezcan sugerencias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Täida tühi riba oma tööriistadega. Välja lülitatuna jääb see tühjaks, kuni soovitused ilmuvad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplit la barre vide avec tes outils. Désactivé, elle reste dégagée jusqu’à l’apparition de suggestions."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitölti az üres sávot az eszközeiddel. Kikapcsolva üres marad, amíg javaslatok nem jelennek meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riempie la barra vuota con i tuoi strumenti. Disattivato, resta sgombra finché non compaiono suggerimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空のバーをツールで埋めます。オフにすると、候補が表示されるまでバーは空のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 바를 도구로 채웁니다. 끄면 제안이 나타나기 전까지 바를 비워 둡니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Isikan bar kosong dengan alat anda. Jika dimatikan, bar kekal kosong sehingga cadangan muncul."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenche a barra vazia com as tuas ferramentas. Desativado, ela fica livre até aparecerem sugestões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполнять пустую строку вашими инструментами. Выключено — строка остаётся пустой, пока не появятся подсказки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你的工具填满空白栏。关闭时，栏会保持空白，直到出现建议为止。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Umpleți bara goală cu instrumentele dvs. Dezactivat îl menține clar până când apar sugestii."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul de lege balk met je gereedschap. Uit houdt het duidelijk totdat er suggesties verschijnen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用你的工具填滿空白欄。關閉時，欄會保持空白，直到出現建議為止。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypełnij pusty pasek swoimi narzędziami. Wyłączone sprawia, że ​​wszystko jest jasne, dopóki nie pojawią się sugestie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заповніть порожню панель своїми інструментами. Якщо вимкнено, зберігає чіткість, доки не з’являться пропозиції."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş çubuğu araçlarınızla doldurun. Kapalı, öneriler görünene kadar açık kalmasını sağlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyplňte prázdnou lištu svými nástroji. Vypnuto zůstane prázdné, dokud se nezobrazí návrhy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyplňte prázdnu lištu svojimi nástrojmi. Vypnuté ho ponechá čisté, kým sa neobjavia návrhy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γεμίστε την άδεια γραμμή με τα εργαλεία σας. Το Off το διατηρεί καθαρό μέχρι να εμφανιστούν οι προτάσεις."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyll den tomma baren med dina verktyg. Av håller det tydligt tills förslag visas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyld den tomme bjælke med dine værktøjer. Fra holder det klart, indtil forslag vises."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyll den tomme linjen med verktøyene dine. Av holder det klart til forslag vises."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täytä tyhjä palkki työkaluillasi. Pois päältä pitää sen selkeänä, kunnes ehdotuksia tulee näkyviin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isi bilah kosong dengan alat Anda. Mati membuatnya tetap jelas sampai saran muncul."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điền vào thanh trống bằng các công cụ của bạn. Tắt giữ cho nó rõ ràng cho đến khi đề xuất xuất hiện."
          }
        }
      }
    },
