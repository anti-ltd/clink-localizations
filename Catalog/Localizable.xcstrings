    "Restores Clink to factory defaults and permanently removes your custom content and saved profiles.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt Clink auf Werkseinstellungen zurück und entfernt dauerhaft eigene Inhalte und gespeicherte Profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece Clink a los valores de fábrica y elimina permanentemente tu contenido personalizado y los perfiles guardados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taastab Clinki tehase vaikeseaded ning eemaldab jäädavalt sinu kohandatud sisu ja salvestatud profiilid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit les réglages d’usine de Clink et supprime définitivement ton contenu personnalisé et tes profils enregistrés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítja a Clink gyári beállításait, és végleg eltávolítja az egyéni tartalmakat és mentett profilokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina Clink alle impostazioni di fabbrica e rimuove definitivamente contenuti personalizzati e profili salvati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkを工場出荷時設定に戻し、カスタムコンテンツと保存済みプロファイルを完全に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink을 공장 기본값으로 복원하고 사용자 설정 콘텐츠와 저장된 프로필을 영구적으로 제거합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulihkan Clink kepada tetapan kilang serta mengalih keluar kandungan tersuai dan profil tersimpan anda secara kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura o Clink para as predefinições de fábrica e remove permanentemente o seu conteúdo personalizado e perfis guardados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает заводские настройки Clink и безвозвратно удаляет ваш пользовательский контент и сохранённые профили."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Clink 恢复为出厂默认设置，并永久移除你的自定内容和已保存的配置文件。"
          }
        }
      }
    },
    "Restores every setting to default. Your custom themes and saved emoji skin tones are kept.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stel elke instelling terug na verstek. Jou pasgemaakte temas en gestoorde emoji-velkleure word behou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt alle Einstellungen auf die Standardwerte zurück. Deine eigenen Designs und gespeicherten Emoji-Hauttöne bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Devuelve todos los ajustes a como venían. Tus temas y los tonos de piel de emoji guardados se quedan como están."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taastab iga seadistuse vaikeväärtusele. Sinu kohandatud teemad ja salvestatud emoji nahatoonid jäävad alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remet tous les réglages par défaut. Tes thèmes perso et tes teintes de peau d'emojis sont gardés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden beállítást visszaállít az alaphelyzetbe. Az egyéni témáid és a mentett emoji bőrtónusaid megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riporta tutte le impostazioni ai valori predefiniti. I tuoi temi personalizzati e le tonalità della pelle salvate per gli emoji restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての設定を初期状態に戻します。カスタムテーマと保存した絵文字の肌の色はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 설정을 기본값으로 되돌려요. 직접 만든 테마와 저장한 이모지 피부톤은 그대로 둬요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Set semula semua tetapan ke lalai. Tema tersuai dan ton kulit emoji anda dikekalkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Repõe todas as definições para os valores originais. Os teus temas personalizados e os tons de pele de emoji guardados ficam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает все настройки к стандартным. Ваши темы и сохранённые тона кожи эмодзи остаются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把所有设置还原成默认。你的自定义主题和保存的表情肤色都会留着。"
          }
        }
      }
    },
    "Restores hitbox size, cursor scroll sensitivity, and all physics values. Other settings are untouched.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Herstel trefboksgrootte, wyserrol-sensitiwiteit en alle fisikawaardes. Ander instellings is onaangeraak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt Trefferflächengröße, Cursor-Scroll-Empfindlichkeit und alle Physikwerte wieder her. Andere Einstellungen bleiben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Devuelve el tamaño del área táctil, la sensibilidad del cursor y todos los valores de física a su estado original. El resto de ajustes se quedan igual."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taastab tabamustsooni suuruse, kursorikerimise tundlikkuse ja kõik füüsikaväärtused. Muid seadeid ei puudutata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remet la taille des zones de touche, la sensibilité du défilement au curseur et toutes les valeurs physiques par défaut. Le reste ne bouge pas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítja a gombok érzékelési méretét, a kurzorgörgetés érzékenységét és az összes fizikai értéket. A többi beállításhoz nem nyúl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riporta ai valori predefiniti la dimensione dell'area attiva, la sensibilità di scorrimento del cursore e tutti i valori fisici. Le altre impostazioni non le tocca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "当たり判定の大きさ、カーソルのスクロール感度、物理の値をすべて元に戻します。ほかの設定はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치 영역 크기, 커서 스크롤 감도, 모든 물리 값을 되돌려요. 다른 설정은 건드리지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Set semula saiz kotak sentuh, kepekaan tatal kursor, dan semua nilai fizik. Tetapan lain tak berubah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Repõe o tamanho da área de toque, a sensibilidade do cursor e todos os valores de física. As outras definições ficam na mesma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает размер зон нажатия, чувствительность прокрутки курсора и все параметры физики. Остальные настройки не затрагиваются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还原触控区大小、光标滑动灵敏度和所有物理参数。其他设置不动。"
          }
        }
      }
    },
    "Restores no entrance animation.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Herstel geen ingangsanimasie nie."
          }
        },
        "de": {
