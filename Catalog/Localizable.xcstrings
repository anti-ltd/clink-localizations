    "Links credit the source projects. Opening one leaves the app.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links verweisen auf die Ursprungsprojekte. Beim Öffnen verlässt du die App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces acreditan los proyectos originales. Al abrir uno, sales de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens créditent les projets d'origine. En ouvrir un te fait quitter l'app."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A linkek a forrásprojekteket ismerik el. Megnyitásukkor elhagyod az appot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link accreditano i progetti originali. Aprirne uno ti fa uscire dall'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクは元のプロジェクトへのクレジットです。開くとアプリの外に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크는 원본 프로젝트를 표시해요. 열면 앱 밖으로 나가게 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pautan memberi kredit kepada projek sumber. Membukanya keluar dari apl."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os links dão crédito aos projetos de origem. Abrir um sai da app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки — благодарность исходным проектам. Переход по ссылке уводит из приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接会指向原始项目，点开会离开这个应用。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingid osutavad allikprojektidele. Ühe avamisel lahkud rakendusest."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakels gee krediet aan die bronprojekte. As u een oopmaak, word die toepassing verlaat."
          }
        }
      }
    },
    "Links in the app are for attribution. They open Safari only if you tap them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links in der App dienen der Namensnennung. Safari öffnet sich nur, wenn du sie antippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces de la app son para dar crédito. Solo abren Safari si los tocas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens dans l'app servent à l'attribution. Ils n'ouvrent Safari que si tu les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appban lévő linkek a forrás megjelölésére vannak. A Safarit csak akkor nyitják meg, ha rájuk koppintasz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link nell'app servono per l'attribuzione. Aprono Safari solo se li tocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内のリンクは出典を示すためのものです。タップしたときだけ Safari が開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 안의 링크는 출처를 밝히려고 넣은 거예요. 눌렀을 때만 Safari가 열려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pautan dalam app ini untuk atribusi. Ia cuma buka Safari kalau anda ketiknya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ligações na app são para atribuição. Só abrem o Safari se as tocares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки в приложении нужны для указания авторства. Safari откроется, только если вы на них нажмёте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用里的链接是用来署名的。你点了才会打开 Safari。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingid rakenduses on autoritunnustuse jaoks. Need avavad Safari ainult siis, kui sa neid puudutad."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakels in die toepassing is vir toeskrywing. Hulle maak Safari net oop as jy daarop tik."
          }
        }
      }
    },
