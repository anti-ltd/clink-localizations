    "Split keyboard, just below it, pulls the keys out to both edges for thumbs instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die geteilte Tastatur direkt darunter zieht die Tasten stattdessen an beide Ränder, für die Daumen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado dividido, justo debajo, lleva las teclas a los dos bordes para los pulgares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier scindé, juste en dessous, écarte au contraire les touches vers les deux bords, pour les pouces."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alatta lévő osztott billentyűzet ehelyett mindkét szélre húzza a billentyűket, a hüvelykujjaknak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera divisa, subito sotto, porta invece i tasti verso i due bordi, per i pollici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐ下の分割キーボードは逆に、キーを左右の端に寄せて親指で打てるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 아래의 분할 키보드는 반대로 키를 양쪽 가장자리로 벌려 엄지로 치게 해 줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci berpecah, tepat di bawahnya, sebaliknya menarik kekunci ke kedua-dua tepi untuk ibu jari."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado dividido, mesmo por baixo, puxa antes as teclas para as duas margens, para os polegares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Разделённая клавиатура» чуть ниже, наоборот, разводит клавиши к обоим краям — под большие пальцы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紧挨着的分离键盘则相反，把按键分到左右两边，方便双拇指。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jagatud klaviatuur vahetult allpool tõmbab klahvid hoopis mõlema serva poole pöidlaste jaoks."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gesplete sleutelbord, net onder dit, trek die sleutels uit na albei kante vir duime in plaas daarvan."
          }
        }
      }
    },
