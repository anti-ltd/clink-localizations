    "Learned words show up in the suggestion bar as you type.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelernte Wörter erscheinen beim Tippen in der Vorschlagsleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras aprendidas aparecen en la barra de sugerencias mientras escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots appris apparaissent dans la barre de suggestions pendant que tu tapes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megtanult szavak gépelés közben megjelennek a javaslatsávban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole apprese compaiono nella barra dei suggerimenti mentre scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習した単語は入力中に変換候補バーに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학습한 단어는 입력할 때 추천 바에 나타나요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataan yang dipelajari muncul pada bar cadangan semasa anda menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras aprendidas aparecem na barra de sugestões enquanto escreves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выученные слова появляются в строке подсказок по ходу печати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
