    "Revert an expansion and it won’t re-expand": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel 'n uitbreiding terug en dit sal nie weer uitbrei nie"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm eine Erweiterung zurück und sie erweitert sich nicht erneut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshaz una expansión y no se volverá a expandir"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võta laiendus tagasi ja see ei laiene uuesti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annule un développement et il ne se redéveloppera pas"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vonj vissza egy bővítést, és nem bővül újra"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla un'espansione e non si riespanderà"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡大を元に戻すと、もう拡大し直しません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장을 되돌리면 다시 확장되지 않아요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan satu pengembangan dan ia takkan berkembang semula"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverte uma expansão e ela não volta a expandir-se"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откатите разворачивание — и оно больше не повторится"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销一次展开，它就不会再展开"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveniți o expansiune și nu se va re-extinde"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai een uitbreiding terug en deze zal niet opnieuw uitbreiden"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷一次展開，它就不會再展開"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cofnij rozszerzenie, a nie będzie ono ponownie rozwijane"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасуйте розширення, і воно не розгорнеться повторно"
