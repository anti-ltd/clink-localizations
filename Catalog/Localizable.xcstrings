          }
        }
      }
    },
    "Nothing is uploaded, shared, or sold.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niks word opgelaai, gedeel of verkoop nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird hochgeladen, geteilt oder verkauft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se sube, comparte ni vende nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Midagi ei laadita üles, jagata ega müüda."
          }
        },
        "fr": {
