        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 내가 말한 내용에 문장부호를 제대로 넣고 격식 있게 다듬어 줘"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "cth. Letak tanda baca yang betul dan jadikan lebih formal"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "ex. Pontua bem o que digo e torna-o mais formal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "например: расставить знаки препинания и сделать сказанное официальным"
