    "Revoke it any time in Settings → General → Keyboard → Clink.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Herroep dit enige tyd in Instellings → Algemeen → Sleutelbord → Klink."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst ihn jederzeit widerrufen, unter Einstellungen → Allgemein → Tastatur → Clink."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quítalo cuando quieras en Ajustes → General → Teclado → Clink."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võta see igal ajal tagasi jaotises Seaded → Üldine → Klaviatuur → Clink."
