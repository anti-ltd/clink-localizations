    "How much a key grows when pressed. 100% is off. Higher values pop more.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoeveel 'n sleutel groei as dit gedruk word. 100% is af. Hoër waardes verskyn meer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark eine Taste wächst, wenn sie gedrückt wird. 100 % ist aus. Höhere Werte ploppen mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto crece una tecla al pulsarla. 100% es apagado. Los valores más altos saltan más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui palju klahv vajutamisel kasvab. 100% on väljas. Kõrgemad väärtused pakuvad rohkem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De combien une touche grandit quand tu appuies. 100 % la désactive. Plus la valeur est haute, plus ça ressort."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyire nő meg egy billentyű, amikor megnyomod. A 100% kikapcsolt. A nagyobb érték jobban kiugrik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto cresce un tasto quando lo premi. 100% è disattivato. Valori più alti risaltano di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを押したときの拡大量です。100% でオフ。高いほど大きく弾みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누를 때 키가 얼마나 커지는지예요. 100%면 꺼져요. 값이 높을수록 더 튀어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak kekunci membesar bila ditekan. 100% bermaksud mati. Nilai lebih tinggi pop lebih ketara."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto uma tecla cresce quando é premida. 100% é desligado. Valores mais altos saltam mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько клавиша вырастает при нажатии. 100% — выключено. Больше — заметнее отскок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下时按键放大多少。100% 是关闭。数值越高弹得越明显。"
          }
        }
      }
    },
