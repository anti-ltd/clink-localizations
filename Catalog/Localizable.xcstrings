    "Clink turns this on as a typing language once the dictionary is added.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink skakel dit aan as 'n tiktaal sodra die woordeboek bygevoeg is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink schaltet diese Sprache zum Tippen ein, sobald das Wörterbuch hinzugefügt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink activará este idioma para escribir en cuanto se añada el diccionario."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink lubab selle sisestuskeelena, niipea kui sõnaraamat on lisatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink activera cette langue de saisie dès que le dictionnaire sera ajouté."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink bekapcsolja ezt gépelési nyelvként, amint a szótár bekerült."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink attiverà questa lingua di scrittura appena il dizionario è aggiunto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書を追加すると、この言語が入力言語としてオンになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전을 추가하면 이 언어가 입력 언어로 켜집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink akan menghidupkan bahasa ini untuk menaip sebaik kamus ditambah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink liga este idioma de escrita assim que o dicionário for adicionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После добавления словаря Clink включит это как язык печати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加词典后，Clink 会把这个语言设为输入语言。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink activează această limbă ca limbă de tastare odată ce dicționarul este adăugat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink schakelt dit in als typtaal zodra het woordenboek is toegevoegd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增詞典後，Clink 會把這個語言設為輸入語言。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink włącza ten język jako język pisania po dodaniu słownika."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink вмикає це як мову набору тексту після додавання словника."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink, sözlük eklendiğinde bunu yazma dili olarak açar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakmile je slovník přidán, Clink to zapne jako jazyk pro psaní."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink to po pridaní slovníka zapne ako jazyk na písanie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Clink το ενεργοποιεί ως γλώσσα πληκτρολόγησης μόλις προστεθεί το λεξικό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink aktiverar detta som ett skrivspråk när ordboken läggs till."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink aktiverer dette som et skrivesprog, når ordbogen er tilføjet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink slår på dette som et skrivespråk når ordboken er lagt til."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ottaa tämän käyttöön kirjoituskielenä, kun sanakirja on lisätty."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink mengaktifkannya sebagai bahasa pengetikan setelah kamus ditambahkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink bật tính năng này làm ngôn ngữ gõ khi từ điển được thêm vào."
          }
        }
      }
    },
