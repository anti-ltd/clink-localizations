    "Translation already works offline. Turn this on for better results.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vertaling werk reeds vanlyn. Skakel dit aan vir beter resultate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzen funktioniert schon offline. Schalt das für bessere Ergebnisse ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción ya funciona sin conexión. Activa esto para obtener mejores resultados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlge töötab juba ühenduseta. Lülita see sisse paremate tulemuste jaoks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction marche déjà hors ligne. Active ça pour de meilleurs résultats."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fordítás offline is működik. Kapcsold be a jobb eredményekért."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione funziona già offline. Attivala per risultati migliori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳はすでにオフラインで動きます。より良い結果のためにはこれをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역은 이미 오프라인으로 돼요. 더 나은 결과를 원하면 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan sudah berfungsi luar talian. Hidupkan ini untuk hasil lebih baik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução já funciona offline. Liga isto para melhores resultados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод и так работает офлайн. Включите это, чтобы результат стал лучше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译本来就能离线用。想要更好的效果就打开这个。"
          }
        }
      }
    },
    "Translation already works offline. Turn this on if you'd rather use Apple Intelligence for better results, all on your device.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vertaling werk reeds vanlyn. Skakel dit aan as jy eerder Apple Intelligence wil gebruik vir beter resultate, alles op jou toestel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzen funktioniert schon offline. Schalt das ein, wenn du für bessere Ergebnisse lieber Apple Intelligence nimmst, alles auf deinem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción ya funciona sin conexión. Activa esto si prefieres usar Apple Intelligence para mejores resultados, todo en tu dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlge töötab juba ühenduseta. Lülita see sisse, kui eelistad paremate tulemuste jaoks Apple Intelligence’i, kõik sinu seadmes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction marche déjà hors ligne. Active ça si tu préfères utiliser Apple Intelligence pour de meilleurs résultats, le tout sur ton appareil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fordítás offline is működik. Kapcsold be, ha inkább az Apple Intelligence-t szeretnéd jobb eredményhez, mindezt a te eszközödön."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione funziona già offline. Attivala se preferisci usare Apple Intelligence per risultati migliori, tutto sul tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳はすでにオフラインで動きます。より良い結果のために Apple Intelligence を使いたいときはこれをオンにしてください。すべてデバイスの中で処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역은 이미 오프라인으로 잘 돼요. 더 나은 결과를 원하면 이걸 켜서 Apple Intelligence를 쓰면 돼요. 전부 기기에서 처리돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan sudah berfungsi luar talian. Hidupkan ini jika anda lebih suka guna Apple Intelligence untuk hasil lebih baik, semuanya pada peranti anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução já funciona offline. Liga isto se preferires usar o Apple Intelligence para melhores resultados, tudo no teu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод и так работает офлайн. Включите это, если хотите более качественный результат через Apple Intelligence — всё на вашем устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译本来就能离线用。如果你更想用 Apple Intelligence 换更好的效果，就开这个，全都在你的设备上完成。"
          }
        }
      }
    },
    "Translation language order": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Orden de idiomas de traducción"
          }
