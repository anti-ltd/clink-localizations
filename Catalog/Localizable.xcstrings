        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa besar setiap partikel tumbuh. Bentuk yang lebih besar mengisi lebih banyak tombol."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi hạt phát triển lớn đến mức nào. Hình dạng lớn hơn lấp đầy nhiều phím hơn."
          }
        }
      }
    },
    "How long the key holds its pressed state before bouncing back. Adds weight.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe lank die sleutel sy ingedrukte toestand hou voordat dit terugbons. Voeg gewig by."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange die Taste gedrückt bleibt, bevor sie zurückschnellt. Fühlt sich dadurch schwerer an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto mantiene la tecla su estado pulsado antes de rebotar. Añade peso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui kaua klahv hoiab oma vajutatud olekut, enne kui tagasi hüppab. Lisab raskust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de temps la touche reste enfoncée avant de remonter. Ajoute du poids."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddig tartja a billentyű a lenyomott állapotát, mielőtt visszapattan. Súlyt ad neki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per quanto il tasto resta premuto prima di tornare su. Aggiunge peso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーが押された状態のままでいてから戻るまでの時間です。重みが出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누른 채로 튀어 오르기까지 얼마나 머무는지예요. 묵직한 느낌이 나요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa lama kekunci kekal ditekan sebelum melantun balik. Menambah berat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto tempo a tecla mantém o estado premido antes de voltar. Dá peso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько клавиша держится нажатой, прежде чем отскочить назад. Добавляет веса."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键弹回来之前保持按下状态多久。会多一点厚重感。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât timp își menține tasta apăsată înainte de a reveni. Adaugă greutate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe lang de toets de ingedrukte toestand vasthoudt voordat hij terugveert. Voegt gewicht toe."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵彈回來之前保持按下狀態多久。會多一點厚重感。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak długo klawisz pozostaje wciśnięty, zanim się odbije. Dodaje wagę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як довго клавіша утримується в натиснутому стані, перш ніж відскочити назад. Додає вагу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarın geri dönmeden önce basılı durumunu ne kadar süre koruduğu. Ağırlık ekler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak dlouho klávesa drží stisknutý stav, než se vrátí zpět. Přidává váhu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako dlho drží kláves stlačený stav pred odrazom späť. Pridáva váhu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο καιρό κρατά το πλήκτρο πατημένο πριν αναπηδήσει. Προσθέτει βάρος."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur länge knappen håller sitt nedtryckta läge innan den studsar tillbaka. Lägger till vikt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor længe tasten holder sin trykket tilstand, før den hopper tilbage. Tilføjer vægt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor lenge tasten holder sin trykket tilstand før den spretter tilbake. Legger til vekt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka kauan näppäin pitää painettuna ennen kuin se palautuu. Lisää painoa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa lama tombol menahan keadaan ditekan sebelum memantul kembali. Menambah berat badan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím giữ trạng thái nhấn trong bao lâu trước khi bật trở lại. Thêm trọng lượng."
          }
        }
      }
    },
    "How long the key stays in its pressed state before bouncing back. Adds a weighted feel.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe lank die sleutel in sy gedrukte toestand bly voordat dit terugbons. Voeg 'n geweegde gevoel by."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange die Taste gedrückt bleibt, bevor sie zurückschnellt. Fühlt sich dadurch schwerer an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto se queda la tecla pulsada antes de rebotar. Le da una sensación de peso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui kaua klahv püsib vajutatud olekus, enne kui tagasi hüppab. Lisab raskustundet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
