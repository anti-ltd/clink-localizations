        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나머지를 되돌리려면 그 화면 맨 아래의 ‘전체 보기’를 누릅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
