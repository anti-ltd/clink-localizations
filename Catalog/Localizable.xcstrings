          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Bericht teilen“, wenn du ihn uns schicken willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Compartir informe si quieres enviárnoslo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta Jaga aruanne, kui tahad selle meile saata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Partager le rapport si tu veux nous l'envoyer."
          }
        },
        "hu": {
