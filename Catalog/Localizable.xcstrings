    "Slide along the space bar to move the cursor.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skuif langs die spasiebalk om die wyser te beweeg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streiche über die Leertaste, um den Cursor zu bewegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza por la barra espaciadora para mover el cursor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Libise mööda tühikuklahvi, et kursorit liigutada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser le long de la barre d'espace pour déplacer le curseur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd az ujjad a szóközön a kurzor mozgatásához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri lungo la barra spaziatrice per spostare il cursore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースバーをなぞると、カーソルを動かせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 바를 따라 밀면 커서가 움직여요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Luncur sepanjang bar ruang untuk gerakkan kursor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza ao longo da barra de espaços para mover o cursor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведите по пробелу, чтобы двигать курсор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿着空格键滑动来移动光标。"
          }
        }
      }
    },
