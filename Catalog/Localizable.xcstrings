    "Prices load once the App Store is reachable. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios aparecerán cuando se pueda conectar con el App Store. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prix s'afficheront dès que l'App Store sera joignable. Vérifie ta connexion et réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Preise werden geladen, sobald der App Store erreichbar ist. Prüfe deine Verbindung und versuch es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prezzi compariranno quando l'App Store sarà raggiungibile. Controlla la connessione e riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os preços aparecem quando for possível aceder à App Store. Verifica a ligação e tenta novamente."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga akan dimuatkan apabila App Store boleh dicapai. Semak sambungan dan cuba lagi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az árak akkor töltődnek be, amikor elérhető az App Store. Ellenőrizd a kapcsolatot, majd próbáld újra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeに接続すると価格が表示されます。通信状況を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到 App Store 后会显示价格。请检查网络连接，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에 연결되면 가격이 표시돼요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinnad laaditakse, niipea kui App Store on kättesaadav. Kontrolli ühendust ja proovi uuesti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены загружаются, когда App Store становится доступен. Проверьте соединение и попробуйте снова."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pryse laai sodra die App Store bereikbaar is. Gaan jou verbinding na en probeer weer."
          }
        }
      }
    },
