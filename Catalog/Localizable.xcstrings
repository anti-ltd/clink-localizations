    "Plain text, one word per line, with an optional count after it (\"word 1234\") to rank suggestions.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiner Text, ein Wort pro Zeile, optional mit einer Zahl dahinter („Wort 1234“), um Vorschläge zu sortieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto sin formato, una palabra por línea, con un número opcional detrás («palabra 1234») para ordenar las sugerencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte brut, un mot par ligne, éventuellement suivi d’un nombre (« mot 1234 ») pour classer les suggestions."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyszerű szöveg, soronként egy szó, mögé tehetsz egy számot („szó 1234”), ami a javaslatok sorrendjét adja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo semplice, una parola per riga, con un numero facoltativo dopo («parola 1234») per ordinare i suggerimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレーンテキストで 1 行 1 語。語の後ろに数値（「単語 1234」）を書くと候補の順番に使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 텍스트로 한 줄에 한 단어씩. 단어 뒤에 숫자(\"단어 1234\")를 적으면 추천 순서에 반영됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks biasa, satu perkataan setiap baris, dengan nombor pilihan selepasnya (\"perkataan 1234\") untuk menyusun cadangan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto simples, uma palavra por linha, com um número opcional a seguir («palavra 1234») para ordenar as sugestões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычный текст, по слову в строке, при желании с числом после него («слово 1234») для ранжирования подсказок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纯文本，每行一个词；词后可加数字（“词 1234”）来决定候选顺序。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihttekst, üks sõna rea kohta, valikuline arv järel („sõna 1234\") soovituste järjestamiseks."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gewone teks, een woord per reël, met 'n opsionele telling daarna (\"woord 1234\") om voorstelle te rangskik."
          }
        }
      }
    },
