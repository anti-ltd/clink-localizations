    "Handwriting turns the keyboard into a pad: write, and it becomes text.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Handskrif verander die sleutelbord in 'n blok: skryf, en dit word teks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Handschrift macht aus der Tastatur einen Block: Du schreibst, und daraus wird Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escritura a mano convierte el teclado en un bloc: escribes y se vuelve texto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Käsikiri muudab klaviatuuri padjaks: kirjuta ja sellest saab tekst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écriture manuscrite transforme le clavier en bloc-notes : tu écris, ça devient du texte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kézírás jegyzettömbbé alakítja a billentyűzetet: írsz, és szöveg lesz belőle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scrittura a mano trasforma la tastiera in un blocco: scrivi e diventa testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「手書き入力」はキーボードをメモ帳のように変えます。書いた文字がそのままテキストになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손글씨는 키보드를 필기판으로 바꿔 줍니다. 쓰면 그대로 텍스트가 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulisan tangan menukar papan kekunci menjadi pad: anda menulis, dan ia menjadi teks."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A escrita à mão transforma o teclado num bloco: escreves e vira texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рукописный ввод превращает клавиатуру в площадку для письма: пишете — получается текст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“手写”把键盘变成一块写字板：你写，它转成文字。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrisul de mână transformă tastatura într-un pad: scrieți și devine text."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handschrift verandert het toetsenbord in een blok: schrijf en het wordt tekst."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“手寫”把鍵盤變成一塊寫字板：你寫，它轉成文字。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pismo odręczne zamienia klawiaturę w pad: napisz, a stanie się tekstem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рукописне введення перетворює клавіатуру на планшет: напишіть, і це стане текстом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "El yazısı, klavyeyi bir tuş takımına dönüştürür: yazın ve metin haline gelir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruční psaní změní klávesnici na blok: pište a stane se textem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ručné písanie zmení klávesnicu na blok: píšte a stane sa textom."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραφή μετατρέπει το πληκτρολόγιο σε πληκτρολόγιο: γράψτε και γίνεται κείμενο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Handskrift förvandlar tangentbordet till ett block: skriv, och det blir text."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Håndskrift forvandler tastaturet til en blok: skriv, og det bliver til tekst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Håndskrift gjør tastaturet til en blokk: skriv, og det blir til tekst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käsinkirjoitus muuttaa näppäimistön näppäimistöksi: kirjoita ja siitä tulee tekstiä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulisan tangan mengubah keyboard menjadi bantalan: tulis, dan itu menjadi teks."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chữ viết tay biến bàn phím thành một bàn phím: viết và nó trở thành văn bản."
          }
        }
      }
    },
