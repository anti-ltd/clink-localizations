        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt az azonosítót már egy másik panel használja. A bővítmény az elsőt nyitja meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro pannello usa già questo ID. Un plug-in apre quello che viene prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このIDはすでに別のパネルで使われています。プラグインは先にあるほうを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 패널이 이미 이 ID를 사용 중입니다. 플러그인은 먼저 있는 패널을 엽니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel lain sudah menggunakan ID ini. Pemalam membuka yang mana dahulu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro painel já usa este ID. Um plug-in abre o que vier primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот ID уже занят другой панелью. Плагин откроет ту, что идёт первой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个面板已在使用此 ID。插件会打开排在前面的那个。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un alt panou folosește deja acest ID. Un plugin se deschide, oricare survine mai întâi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ander paneel gebruikt deze ID al. Een plug-in wordt geopend, afhankelijk van wat zich het eerst voordoet."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個面板已在使用此 ID。外掛會開啟排在前面的那個。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inny panel używa już tego identyfikatora. Wtyczka otworzy się w zależności od tego, co nastąpi wcześniej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інша панель уже використовує цей ідентифікатор. Плагін відкривається залежно від того, що станеться раніше."
