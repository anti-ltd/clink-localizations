    "30 seconds. Start when you type.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "30 Sekunden. Der Test beginnt, sobald du tippst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30 seconds. Start when you type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "30 segundos. La prueba empieza cuando escribes."
          }
