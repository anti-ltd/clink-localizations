    "To bring the rest back, tap Show everything at the bottom of that screen.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om die res terug te bring, tik Wys alles onderaan daardie skerm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um den Rest zurückzuholen, tippe unten auf diesem Bildschirm auf „Alles anzeigen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recuperar lo demás, toca Mostrar todo al final de esa pantalla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ülejäänu tagasi tuua, puuduta selle ekraani all Kuva kõik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour récupérer le reste, touche Tout afficher en bas de cet écran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A többi visszahozásához koppints a képernyő alján a Mutass mindent gombra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per riavere il resto, tocca Mostra tutto in fondo a quella schermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻すには、その画面の下にある「すべて表示」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나머지를 되돌리려면 그 화면 맨 아래의 ‘전체 보기’를 누릅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mendapatkannya semula, ketik Tunjukkan semuanya di bahagian bawah skrin itu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para trazeres o resto de volta, toca em Mostrar tudo no fim desse ecrã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы вернуть остальное, нажмите «Показать всё» внизу того экрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想找回其余部分，点那一屏底部的“显示全部”。"
          }
        }
      }
    },
    "To make your own, tap Create theme.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om jou eie te maak, tik Skep tema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ein eigenes tippst du auf „Theme erstellen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para hacer uno tuyo, toca Crear tema."
