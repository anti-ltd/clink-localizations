    "Translate is off. Turn it on to use and customize it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vertaal is af. Skakel dit aan om dit te gebruik en aan te pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzen ist aus. Schalte es ein, um es zu nutzen und anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción está desactivada. Actívala para usarla y personalizarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlge on väljas. Lülita see sisse, et kasutada ja kohandada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction est désactivée. Active-la pour l'utiliser et la personnaliser."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fordítás ki van kapcsolva. Kapcsold be, hogy használhasd és beállíthasd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione è disattivata. Attivala per usarla e personalizzarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳はオフです。オンにすると使えて、設定も変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역이 꺼져 있어요. 켜면 쓰고 설정도 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemah dimatikan. Hidupkannya untuk guna dan sesuaikannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução está desligada. Liga-a para a usares e personalizares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод выключен. Включите его, чтобы пользоваться и настраивать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译已关闭。打开后就能使用并调整设置。"
          }
        }
      }
    },
