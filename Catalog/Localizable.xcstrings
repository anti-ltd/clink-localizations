    "Your pet, shown live. Give it a poke. Pick a species, corner, and size below.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Haustier, live. Stups es an. Wähle unten Art, Ecke und Größe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mascota, en vivo. Dale un toque. Elige especie, esquina y tamaño abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compagnon, en direct. Donne-lui un petit coup. Choisis l'espèce, le coin et la taille ci-dessous."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kisállatod élőben. Bökd meg. Lent válassz fajt, sarkot és méretet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo pet, dal vivo. Dagli un colpetto. Sotto scegli specie, angolo e dimensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペットのライブ表示。つついてみてください。下で種類・位置・サイズを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펫을 실시간으로 보여줘요. 한번 찔러보세요. 아래에서 종류, 위치, 크기를 고르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peliharaan anda, dipapar secara langsung. Cuba cuit. Pilih spesies, sudut dan saiz di bawah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua mascote, ao vivo. Dá-lhe um toque. Escolhe espécie, canto e tamanho abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш питомец вживую. Ткните в него. Вид, угол и размер выбираются ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宠物的实时样子。戳它一下试试。下面可以选种类、角落和大小。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu lemmikloom, reaalajas. Torka teda. Vali all liik, nurk ja suurus."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou troeteldier, regstreeks gewys. Gee dit 'n slag. Kies 'n spesie, hoek en grootte hieronder."
          }
        }
      }
    },
