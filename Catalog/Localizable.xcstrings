          }
        }
      }
    },
    "Its words join a language you already type in. Nothing is replaced.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sy woorde sluit aan by 'n taal wat jy reeds intik. Niks word vervang nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Wörter kommen zu einer Sprache dazu, die du schon tippst. Es wird nichts ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus palabras se suman a un idioma que ya usas. No se sustituye nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle sõnad ühinevad keelega, mida sa juba tipid. Midagi ei asendata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses mots s’ajoutent à une langue que tu utilises déjà. Rien n’est remplacé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szavai egy már használt nyelvhez adódnak hozzá. Semmi nem cserélődik le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue parole si aggiungono a una lingua che già usi. Non viene sostituito nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに使っている言語に語彙が加わります。置き換えは起きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 쓰고 있는 언어에 단어가 더해집니다. 대체되는 것은 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataannya ditambah pada bahasa yang anda sudah guna. Tiada apa-apa yang diganti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras juntam-se a um idioma que já usas. Nada é substituído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его слова добавятся к языку, на котором вы уже печатаете. Ничего не заменяется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些词会加入你已经在用的语言，不会替换任何内容。"
          }
        }
      }
    },
