    "Remove one, or clear the lot. Learn from your typing turns the whole thing off.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwyder een, of maak die lot skoon. Leer uit jou tik skakel die hele ding af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösch einzelne oder alle. „Aus deinem Tippen lernen“ schaltet das Ganze ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra una, o vacíalas todas. Aprender de tu escritura lo apaga por completo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemalda üks või tühjenda kõik. Õpi sinu tipimisest lülitab kogu asja välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime-en une, ou tout. Apprendre de ta saisie désactive complètement le mécanisme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törölj egyet, vagy üresítsd ki az egészet. A Tanulás a gépelésedből kapcsoló az egészet kikapcsolja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellane una o svuota tutto. Impara da come scrivi disattiva l'intera cosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つずつ削除しても、すべて消しても構いません。「入力から学習する」をオフにすれば、そもそも覚えなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나씩 지워도 되고 전부 비워도 됩니다. 입력한 내용에서 배우기를 끄면 아예 기억하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam satu, atau kosongkan semuanya. Belajar dari cara anda menaip mematikan keseluruhannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga uma, ou limpa tudo. Aprender com a tua escrita desliga o mecanismo por completo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уберите одно слово или очистите весь список. «Учиться на вашей печати» выключает это целиком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以删掉某一个，也可以全部清空。关掉“从你的输入里学习”，它就不再记了。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scoateți unul sau ștergeți lotul. Învățați din tastarea dvs. dezactivează totul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder er één, of ruim de boel op. Leren van uw typen schakelt het hele ding uit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以刪掉某一個，也可以全部清空。關掉“從你的輸入裡學習”，它就不再記了。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń jednego lub oczyść działkę. Uczenie się na podstawie pisania wyłącza całą sprawę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаліть один або очистіть партію. Навчання з вашого введення вимикає все це."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birini kaldırın veya partiyi temizleyin. Yazarak öğrenmek her şeyi kapatır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraňte jeden nebo vyčistěte šarži. Učit se z vašeho psaní celou věc vypne."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstráňte jeden alebo vyčistite dávku. Učte sa zo svojho písania celú vec vypne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαιρέστε ένα ή καθαρίστε την παρτίδα. Learn from your typing turns the whole thing off."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort en eller rensa partiet. Lär dig av ditt skrivande stänger av det hela."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern en, eller ryd partiet. Lær af din skrivning slår det hele fra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern en, eller fjern partiet. Lær av skrivingen din slår av hele greia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista yksi tai tyhjennä erä. Kirjoittamisesta oppiminen sammuttaa koko asian."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus satu, atau kosongkan semuanya. Belajar dari pengetikan Anda mematikan semuanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa một hoặc xóa rất nhiều. Học từ cách đánh máy của bạn sẽ tắt toàn bộ."
          }
        }
      }
    },
