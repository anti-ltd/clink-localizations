    "Share this theme with your placed stickers.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel hierdie tema met jou geplaasde plakkers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile dieses Theme mit deinen platzierten Stickern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte este tema con las pegatinas que has colocado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga seda teemat koos paigutatud kleepsudega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage ce thème avec les autocollants que tu as placés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszd meg ezt a témát az elhelyezett matricáiddal együtt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi questo tema con gli adesivi che hai posizionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配置したステッカーと一緒にこのテーマを共有します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배치한 스티커와 함께 이 테마를 공유합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kongsi tema ini bersama pelekat yang anda letakkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Partilha este tema com os autocolantes que colocaste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь этой темой вместе с размещёнными стикерами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享此主题及已放置的贴纸。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuie această temă împreună cu autocolantele plasate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel dit thema met de stickers die je hebt geplaatst."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享此主題及已放置的貼紙。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij ten motyw wraz z rozmieszczonymi naklejkami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поділіться цією темою разом із розміщеними наліпками."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu temayı yerleştirdiğiniz çıkartmalarla birlikte paylaşın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílej tento motiv spolu s rozmístěnými samolepkami."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdieľaj tento motív spolu s rozmiestnenými nálepkami."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μοιραστείτε αυτό το θέμα μαζί με τα αυτοκόλλητα που τοποθετήσατε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela det här temat med klistermärkena du har placerat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del dette tema med de klistermærker, du har placeret."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Del dette temaet med klistremerkene du har plassert."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaa tämä teema ja siihen sijoittamasi tarrat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagikan tema ini beserta stiker yang telah Anda tempatkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ giao diện này cùng các nhãn dán bạn đã đặt."
          }
        }
      }
    },
    "Replaces your sticker arrangement.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervang jou plakkeruitleg."
          }
