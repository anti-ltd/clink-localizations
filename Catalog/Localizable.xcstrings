    "Tap a digit to type it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik 'n syfer om dit in te tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe eine Ziffer, um sie zu tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un dígito para escribirlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta numbrit, et see sisestada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un chiffre pour le taper."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy számjegyre a beíráshoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una cifra per digitarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数字をタップすると入力されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자를 탭하면 입력됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik digit untuk taipkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca um dígito para o escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь цифры, чтобы ввести её."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点数字即可输入。"
          }
        }
      }
    },
    "Tap a key in the preview to paint it. Anything you leave unset stays the theme's color.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik 'n sleutel in die voorskou om dit te verf. Enigiets wat jy ongesteld laat bly die tema se kleur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in der Vorschau auf eine Taste, um sie zu färben. Was du nicht setzt, behält die Farbe des Designs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una tecla en la vista previa para pintarla. Lo que no ajustes conserva el color del tema."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta eelvaates klahvi, et see värvida. Määratlemata jäänud jäävad teema värvi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche une touche dans l’aperçu pour la colorer. Ce que tu ne définis pas garde la couleur du thème."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy billentyűre az előnézetben, és színezd ki. Amit nem állítasz be, megtartja a téma színét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un tasto nell’anteprima per colorarlo. Quello che non imposti mantiene il colore del tema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューのキーをタップすると色を塗れます。設定しなかった部分はテーマの色のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기에서 키를 탭하면 칠할 수 있어요. 설정하지 않은 부분은 테마 색상 그대로예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kekunci dalam pratonton untuk mewarnakannya. Apa yang tidak ditetapkan kekal warna tema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca numa tecla na pré-visualização para pintá-la. O que não definires fica com a cor do tema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на клавишу в предпросмотре, чтобы покрасить её. Всё, что вы не тронете, останется цвета темы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按预览里的按键就能上色。没有设置的地方保持主题颜色。"
          }
        }
      }
    },
    "Tap a key to customize its style, colors, or artwork.": {
      "comment": "Canvas editor instruction. Select a keyboard key in the preview to edit its visual appearance; artwork means an image placed on the keycap.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Taste, um ihren Stil, ihre Farben oder ihr Bild anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una tecla para personalizar su estilo, sus colores o su imagen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta klahvi, et kohandada selle stiili, värve või pilti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionne une touche pour personnaliser son style, ses couleurs ou son image."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy billentyűre, és szabd testre a stílusát, a színeit vagy a képét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un tasto per personalizzarne lo stile, i colori o l’immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーをタップすると、スタイルや色、画像をカスタマイズできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 탭하여 스타일, 색상, 이미지를 원하는 대로 설정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kekunci untuk menyesuaikan gaya, warna atau imejnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca numa tecla para personalizares o estilo, as cores ou a imagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на клавишу, чтобы изменить её стиль, цвета или изображение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按按键，自定义样式、颜色或图案。"
          }
        }
      }
    },
    "Tap a point to select it. Its curve handles appear alongside — drag them to bend the line.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un punto para seleccionarlo. Sus manejadores de curva aparecen al lado: arrástralos para curvar la línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un point pour le sélectionner. Ses poignées de courbe apparaissent à côté : faites-les glisser pour courber le tracé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Punkt, um ihn auszuwählen. Seine Kurvengriffe erscheinen daneben – ziehe sie, um die Linie zu biegen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un punto per selezionarlo. Le sue maniglie di curva compaiono accanto: trascinale per piegare la linea."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num ponto para o selecionar. As pegas da curva aparecem ao lado — arraste-as para curvar a linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь точки, чтобы выбрать её. Рядом появятся рычаги кривой — потяните их, чтобы изогнуть линию."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik satu titik untuk memilihnya. Pemegang lengkungnya muncul di sebelah — seret untuk melengkungkan garis."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy pontra a kijelöléséhez. Mellette megjelennek az ívfogói – húzd őket a vonal hajlításához."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "点をタップして選びます。隣に曲線のハンドルが現れるので、ドラッグして線を曲げます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一个节点以选中它。旁边会出现曲线控制柄——拖动它们即可弯曲线条。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점을 탭해 선택하세요. 옆에 곡선 핸들이 나타납니다 — 드래그해 선을 구부리세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta punkti, et see valida. Kõrvale ilmuvad kõvera pidemed – lohista neid joone painutamiseks."
          }
        }
      }
    },
    "Tap a result to open its page and reveal the matching controls.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Ergebnis, um die zugehörige Seite und die passenden Einstellungen zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un resultado para abrir su página y ver los controles correspondientes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta tulemust, et avada selle leht ja näha vastavaid seadeid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un résultat pour ouvrir sa page et afficher les réglages correspondants."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy találatra a hozzá tartozó oldal és beállítások megnyitásához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un risultato per aprire la relativa pagina e mostrare i controlli corrispondenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索結果をタップすると、そのページが開き、該当する設定項目が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 결과를 탭하면 해당 페이지가 열리고 관련 설정 항목이 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik hasil carian untuk membuka halamannya dan memaparkan kawalan yang sepadan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca num resultado para abrir a respetiva página e mostrar os controlos correspondentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на результат, чтобы открыть нужную страницу и перейти к найденным настройкам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点搜索结果，即可打开对应页面并显示相关设置。"
          }
        }
      }
    },
    "Tap a spot on the bar to type that emoji.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik 'n plek op die balk om daardie emoji in te tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Stelle im Balken, um dieses Emoji zu tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un punto de la barra para escribir ese emoji."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta ribal kohale, et see emoji sisestada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un endroit de la barre pour taper cet emoji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a sáv egy pontjára, hogy azt az emojit írd be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un punto della barra per digitare quell’emoji."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーの位置をタップすると、その絵文字が入力されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바의 한곳을 탭하면 그 이모지가 입력됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik satu tempat pada bar untuk taip emoji itu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca num sítio da barra para escrever esse emoji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь места на полосе, чтобы ввести этот эмодзи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点栏上的位置就能打出那个表情。"
          }
        }
      }
    },
    "Tap a spot on the bar to type that mark.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik 'n plek op die balk om daardie merk te tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Stelle im Balken, um dieses Zeichen zu tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un punto de la barra para escribir ese signo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta ribal kohale, et see märk sisestada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un endroit de la barre pour taper ce signe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a sáv egy pontjára, hogy azt a jelet írd be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un punto della barra per digitare quel segno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーの位置をタップすると、その記号が入力されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바의 한곳을 탭하면 그 기호가 입력됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
