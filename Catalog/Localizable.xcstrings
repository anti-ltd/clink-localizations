        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca no animal para o cutucar. Toca num canto para o mover para lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь питомца, чтобы ткнуть его. Коснитесь угла, чтобы переместить его туда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按宠物可以戳戳它。点按一个角落可把它移到那里。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți animalul de companie pentru a-l înțepa. Atingeți un colț pentru a-l muta acolo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het huisdier om het te porren. Tik op een hoek om deze daarheen te verplaatsen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按寵物可以戳戳它。點按一個角落可把它移到那裡。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op die troeteldier om daaraan te druk. Tik op 'n hoek om dit soontoe te skuif."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij zwierzaka, aby go szturchnąć. Kliknij róg, aby go tam przenieść."
