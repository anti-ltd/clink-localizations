          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä vastaus ei läpäissyt Clink:n tarkastuksia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Balasan itu tidak lolos pemeriksaan Clink."
          }
