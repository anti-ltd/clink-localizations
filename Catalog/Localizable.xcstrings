    "Learned per language, so your French never corrects your English.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer per taal, so jou Frans korrigeer nooit jou Engels nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird pro Sprache gelernt – dein Französisch korrigiert nie dein Englisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aprende por idioma, así que tu francés nunca corrige tu inglés."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Õpitakse keele kaupa, nii et sinu prantsuse ei paranda kunagi sinu inglise keelt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appris par langue : ton français ne corrigera jamais ton anglais."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyelvenként tanul, így a francia szavak sosem javítják az angolt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si impara per lingua, così il tuo francese non corregge mai il tuo inglese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語ごとに学習するので、フランス語が英語を書き換えることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어별로 학습해서 프랑스어가 영어를 고치는 일은 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipelajari mengikut bahasa, jadi bahasa Perancis awak tidak akan membetulkan bahasa Inggeris."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É aprendido por idioma, por isso o teu francês nunca corrige o teu inglês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обучение идёт отдельно по языкам, поэтому французский никогда не полезет исправлять английский."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按语言分开学习，法语不会去改你的英文。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Învățat în funcție de limbă, astfel încât franceza nu vă corectează niciodată engleza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Per taal geleerd, zodat je Frans nooit je Engels corrigeert."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按語言分開學習，法語不會去改你的英文。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uczono się każdego języka, więc Twój francuski nigdy nie poprawi Twojego angielskiego."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивчення кожної мови, тому ваша французька ніколи не виправляє вашу англійську."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile göre öğrenilir, böylece Fransızcanız asla İngilizcenizi düzeltmez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Učí se podle jazyka, takže vaše francouzština nikdy neopraví vaši angličtinu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naučte sa podľa jazyka, takže vaša francúzština nikdy neopraví vašu angličtinu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μαθαίνετε ανά γλώσσα, έτσι τα γαλλικά σας δεν διορθώνουν ποτέ τα αγγλικά σας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lär dig per språk, så din franska korrigerar aldrig din engelska."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lært pr. sprog, så dit fransk retter aldrig dit engelsk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lært per språk, så fransken din korrigerer aldri engelsken din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kielikohtaisesti opittu, joten ranskasi ei koskaan korjaa englantiasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipelajari per bahasa, jadi bahasa Prancis Anda tidak pernah mengoreksi bahasa Inggris Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Học theo từng ngôn ngữ, vì vậy tiếng Pháp của bạn không bao giờ sửa tiếng Anh của bạn."
          }
        }
      }
    },
