        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하여 켜고 끄기. 드래그하여 행을 이동합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik untuk togol. Seret untuk alihkan baris."
          }
