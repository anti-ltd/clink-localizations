            "value": "Un mando metálico moleteado que gira al abrir el menú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une molette en métal strié qui tourne à l’ouverture du menu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gerändelter Metalldrehregler, der sich beim Öffnen des Menüs dreht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una manopola metallica zigrinata che ruota all’apertura del menu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um botão metálico recartilhado que roda ao abrir o menu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рифлёная металлическая ручка, которая поворачивается при открытии меню."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol logam bertekstur yang berputar apabila menu dibuka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bordázott fémtekerő, amely a menü megnyitásakor elfordul."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューを開くと回転する、滑り止め加工のある金属製ノブです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开菜单时会旋转的滚花金属旋钮。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴를 열면 회전하는 빗금 무늬 금속 노브입니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rihveldatud metallist pöördnupp, mis pöördub menüü avamisel."
          }
        }
      }
    },
