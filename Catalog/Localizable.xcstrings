          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你对这个操作的更改会被放弃。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu muudatused sellele tegevusele hüljatakse."
