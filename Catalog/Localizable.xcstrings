          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε ένα πλήκτρο για τη γραμμή τονισμού του ή μετακινήστε το κατευθείαν προς τα κάτω για να πληκτρολογήσετε αμέσως την πρώτη έμφαση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll ned en tangent för dess accentstapel eller svep rakt ned för att skriva den första accenten direkt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
