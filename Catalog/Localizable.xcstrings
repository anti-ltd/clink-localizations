    },
    "Google Play isn’t available on this device, so Clink Pro can’t be bought here. Typing, emoji and every free feature keep working.": {
      "comment": "Android-only copy for the companion app (batch B4: onboarding, setup, paywall), replacing iOS settings paths, Full Access and the App Store with their Android and Google Play counterparts. Translations drafted for the Android port; native-speaker review required before release. Add to clink-index.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play is nie op hierdie toestel beskikbaar nie, so Clink Pro kan nie hier gekoop word nie. Tik, emoji en elke gratis funksie werk steeds."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play není na tomto zařízení k dispozici, takže zde nelze Clink Pro koupit. Psaní, emoji a všechny bezplatné funkce fungují dál."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play er ikke tilgængelig på denne enhed, så Clink Pro kan ikke købes her. Skrivning, emoji og alle gratis funktioner virker stadig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play ist auf diesem Gerät nicht verfügbar, daher kann Clink Pro hier nicht gekauft werden. Tippen, Emojis und alle kostenlosen Funktionen funktionieren weiterhin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Google Play δεν είναι διαθέσιμο σε αυτή τη συσκευή, οπότε το Clink Pro δεν μπορεί να αγοραστεί εδώ. Η πληκτρολόγηση, τα emoji και όλες οι δωρεάν λειτουργίες συνεχίζουν να λειτουργούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play no está disponible en este dispositivo, así que aquí no se puede comprar Clink Pro. La escritura, los emojis y todas las funciones gratuitas siguen funcionando."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play pole selles seadmes saadaval, seega ei saa siin Clink Pro’d osta. Kirjutamine, emojid ja kõik tasuta funktsioonid töötavad edasi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play ei ole käytettävissä tällä laitteella, joten Clink Prota ei voi ostaa täältä. Kirjoittaminen, emojit ja kaikki ilmaiset ominaisuudet toimivat edelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play n’est pas disponible sur cet appareil : Clink Pro ne peut donc pas être acheté ici. La saisie, les emojis et toutes les fonctions gratuites continuent de fonctionner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen a készüléken nem érhető el a Google Play, ezért itt nem vásárolható meg a Clink Pro. A gépelés, az emojik és minden ingyenes funkció továbbra is működik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play tidak tersedia di perangkat ini, jadi Clink Pro tidak bisa dibeli di sini. Mengetik, emoji, dan semua fitur gratis tetap berfungsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play non è disponibile su questo dispositivo, quindi qui non puoi acquistare Clink Pro. Scrittura, emoji e tutte le funzioni gratuite continuano a funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末では Google Play を利用できないため、ここでは Clink Pro を購入できません。文字入力、絵文字、すべての無料機能は引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 Google Play를 사용할 수 없어 Clink Pro를 구매할 수 없어요. 입력, 이모지, 모든 무료 기능은 계속 사용할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play tiada pada peranti ini, jadi Clink Pro tidak boleh dibeli di sini. Penaipan, emoji dan semua ciri percuma terus berfungsi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play er ikke tilgjengelig på denne enheten, så Clink Pro kan ikke kjøpes her. Skriving, emoji og alle gratisfunksjoner virker fortsatt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play is niet beschikbaar op dit apparaat, dus Clink Pro kan hier niet worden gekocht. Typen, emoji en alle gratis functies blijven werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play nie jest dostępne na tym urządzeniu, więc nie można tu kupić Clink Pro. Pisanie, emoji i wszystkie bezpłatne funkcje nadal działają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Google Play não está disponível neste aparelho, por isso não é possível comprar o Clink Pro aqui. A escrita, os emojis e todas as funcionalidades gratuitas continuam a funcionar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play nu este disponibil pe acest dispozitiv, așa că Clink Pro nu poate fi cumpărat aici. Tastarea, emoji și toate funcțiile gratuite funcționează în continuare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play недоступен на этом устройстве, поэтому купить Clink Pro здесь нельзя. Ввод, эмодзи и все бесплатные функции продолжают работать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play nie je na tomto zariadení k dispozícii, takže tu nemožno kúpiť Clink Pro. Písanie, emoji a všetky bezplatné funkcie fungujú ďalej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play är inte tillgängligt på den här enheten, så Clink Pro kan inte köpas här. Skrivande, emoji och alla gratisfunktioner fungerar fortfarande."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda Google Play kullanılamıyor, bu yüzden Clink Pro burada satın alınamaz. Yazma, emoji ve tüm ücretsiz özellikler çalışmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play недоступний на цьому пристрої, тому Clink Pro тут не можна придбати. Набір тексту, емодзі та всі безкоштовні функції й далі працюють."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play không khả dụng trên thiết bị này nên không thể mua Clink Pro tại đây. Gõ phím, emoji và mọi tính năng miễn phí vẫn hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上没有 Google Play，因此无法在这里购买 Clink Pro。文字输入、表情符号和所有免费功能照常可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置無法使用 Google Play，因此無法在這裡購買 Clink Pro。打字、表情符號和所有免費功能都能照常使用。"
          }
        }
      }
    },
    "Not selected yet": {
