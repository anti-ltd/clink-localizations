    "Outlines the region each key actually claims.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Omskryf die streek wat elke sleutel eintlik eis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnet den Bereich nach, den jede Taste tatsächlich beansprucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja la zona que ocupa realmente cada tecla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõmbab piirjoone ala ümber, mida iga klahv tegelikult hõivab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace la zone que chaque touche occupe réellement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirajzolja, mekkora területet foglal el valójában az egyes billentyűk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia l’area che ogni tasto occupa davvero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーが実際に受け持つ範囲を線で示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 키가 실제로 차지하는 영역을 윤곽으로 보여 줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggariskan kawasan yang sebenarnya dituntut oleh setiap kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traça a zona que cada tecla ocupa mesmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обводит область, которую на самом деле занимает каждая клавиша."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描出每个按键实际占据的范围。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conturează regiunea pe care fiecare cheie o revendică de fapt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geeft een overzicht van de regio die elke sleutel feitelijk claimt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "描出每個按鍵實際佔據的範圍。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przedstawia region, do którego faktycznie należy każdy klucz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Окреслює регіон, на який фактично претендує кожен ключ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her anahtarın gerçekte talep ettiği bölgenin ana hatlarını çizer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastiňuje region, který si každý klíč skutečně nárokuje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Načrtáva región, ktorý si každý kľúč skutočne nárokuje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιγράφει την περιοχή που πραγματικά διεκδικεί κάθε κλειδί."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skisserar regionen varje nyckel faktiskt gör anspråk på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
