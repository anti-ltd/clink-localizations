    "Use this code within five minutes. Give it only to your own device or account.": {
      "comment": "Optional private app account and purchase sharing. No email or typing data. Recovery key and pairing codes are secrets.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa este código en cinco minutos. Introdúcelo solo en tu propio dispositivo o cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise ce code sous cinq minutes, uniquement sur ton propre appareil ou compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende diesen Code innerhalb von fünf Minuten und nur für dein eigenes Gerät oder Konto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa questo codice entro cinque minuti, solo sul tuo dispositivo o account."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa este código no prazo de cinco minutos, apenas no teu próprio dispositivo ou conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте этот код в течение пяти минут только на своём устройстве или в своём аккаунте."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan kod ini dalam masa lima minit, hanya untuk peranti atau akaun anda sendiri."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Öt percen belül használd fel a kódot, kizárólag a saját eszközödhöz vagy fiókodhoz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードは5分以内に、ご自身のデバイスまたはアカウントでのみ使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在五分钟内使用此验证码，仅用于你自己的设备或账户。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드는 5분 안에 본인의 기기나 계정에서만 사용해 주세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasuta seda koodi viie minuti jooksul ainult oma seadme või konto jaoks."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește acest cod în cel mult cinci minute, doar pentru dispozitivul sau contul tău."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik deze code binnen vijf minuten, alleen voor je eigen apparaat of account."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在五分鐘內使用此代碼，僅限你自己的裝置或帳號。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik hierdie kode binne vyf minute, slegs vir jou eie toestel of rekening."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj tego kodu w ciągu pięciu minut, wyłącznie na swoim urządzeniu lub koncie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використайте цей код протягом п’яти хвилин лише на власному пристрої або у власному обліковому записі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kodu beş dakika içinde yalnızca kendi cihazınızda veya hesabınızda kullanın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použij tento kód do pěti minut pouze pro vlastní zařízení nebo účet."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použi tento kód do piatich minút iba pre vlastné zariadenie alebo účet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε αυτόν τον κωδικό μέσα σε πέντε λεπτά, μόνο για δική σου συσκευή ή λογαριασμό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd koden inom fem minuter, bara för din egen enhet eller ditt eget konto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug denne kode inden for fem minutter, kun til din egen enhed eller konto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk koden innen fem minutter, bare for din egen enhet eller konto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä koodi viiden minuutin kuluessa vain omalla laitteellasi tai tililläsi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan kode ini dalam lima menit, hanya untuk perangkat atau akun Anda sendiri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng mã này trong vòng năm phút, chỉ cho thiết bị hoặc tài khoản của chính bạn."
          }
        }
      }
    },
    "Couldn’t load this repository. Check the address and your connection, and make sure it has a Clink release.": {
      "comment": "Add-repository error. A release is a published GitHub release containing Clink packs.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido cargar este repositorio. Comprueba la dirección y tu conexión, y asegúrate de que tenga una versión publicada para Clink."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger ce dépôt. Vérifie l’adresse et ta connexion, et assure-toi qu’une version pour Clink y a été publiée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Repository konnte nicht geladen werden. Prüfe die Adresse und deine Verbindung und stelle sicher, dass dort ein Release für Clink veröffentlicht wurde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare questo repository. Controlla l’indirizzo e la connessione e assicurati che contenga una release per Clink."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar este repositório. Verifica o endereço e a tua ligação e confirma que tem uma versão publicada para o Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить этот репозиторий. Проверьте адрес и подключение к интернету и убедитесь, что в нём опубликован релиз для Clink."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori ini tidak dapat dimuatkan. Semak alamat dan sambungan internet anda, dan pastikan repositori ini mempunyai keluaran untuk Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült betölteni ezt a tárolót. Ellenőrizd a címet és az internetkapcsolatot, és győződj meg róla, hogy a tárolóban van közzétett kiadás a Clinkhez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリを読み込めませんでした。アドレスとインターネット接続を確認し、Clink用のリリースが公開されていることを確かめてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载此仓库。请检查地址和网络连接，并确认仓库中已发布适用于 Clink 的版本。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장소를 불러올 수 없습니다. 주소와 인터넷 연결을 확인하고, 저장소에 Clink용 릴리스가 게시되어 있는지 확인해 주세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seda hoidlat ei saanud laadida. Kontrolli aadressi ja internetiühendust ning veendu, et hoidlas on avaldatud Clinki jaoks mõeldud väljalase."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest depozit nu a putut fi încărcat. Verifică adresa și conexiunea la internet și asigură-te că are o versiune publicată pentru Clink."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze repository kon niet worden geladen. Controleer het adres en je internetverbinding en zorg dat er een release voor Clink is gepubliceerd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入此儲存庫。請檢查網址和網路連線，並確認儲存庫中已發布適用於 Clink 的版本。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie bewaarplek kon nie gelaai word nie. Gaan die adres en jou internetverbinding na en maak seker dat dit ’n vrystelling vir Clink bevat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać tego repozytorium. Sprawdź adres i połączenie z internetem oraz upewnij się, że opublikowano w nim wydanie dla Clink."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити цей репозиторій. Перевірте адресу й підключення до інтернету та переконайтеся, що в ньому опубліковано реліз для Clink."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu depo yüklenemedi. Adresi ve internet bağlantınızı kontrol edin ve depoda Clink için yayımlanmış bir sürüm olduğundan emin olun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento repozitář se nepodařilo načíst. Zkontroluj adresu a připojení k internetu a ujisti se, že je v něm zveřejněné vydání pro Clink."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento repozitár sa nepodarilo načítať. Skontroluj adresu a pripojenie k internetu a uisti sa, že je v ňom zverejnené vydanie pre Clink."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η φόρτωση αυτού του αποθετηρίου. Έλεγξε τη διεύθυνση και τη σύνδεσή σου στο διαδίκτυο και βεβαιώσου ότι περιέχει μια δημοσιευμένη έκδοση για το Clink."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att läsa in detta arkiv. Kontrollera adressen och din internetanslutning och se till att det finns en publicerad version för Clink."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette repository kunne ikke indlæses. Kontrollér adressen og din internetforbindelse, og sørg for, at der er udgivet en version til Clink."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke laste inn dette kodelageret. Sjekk adressen og internettforbindelsen, og sørg for at det finnes en publisert utgivelse for Clink."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä tietovarastoa ei voitu ladata. Tarkista osoite ja internetyhteys ja varmista, että tietovarastossa on Clinkille tarkoitettu julkaisu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori ini tidak dapat dimuat. Periksa alamat dan koneksi internet Anda, lalu pastikan repositori ini memiliki rilis untuk Clink."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tải kho lưu trữ này. Hãy kiểm tra địa chỉ và kết nối mạng, đồng thời đảm bảo kho lưu trữ có bản phát hành dành cho Clink."
          }
        }
      }
    },
