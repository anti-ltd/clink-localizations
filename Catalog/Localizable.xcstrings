    "A gradient fills behind the keys, refracted through the glass.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Gradiënt vul agter die sleutels, gebreek deur die glas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinter den Tasten liegt ein Farbverlauf, gebrochen durch das Glas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un degradado llena el fondo de las teclas, refractado por el cristal."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvide taga täidab üleminek, mis murdub läbi klaasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dégradé remplit l'arrière des touches, réfracté à travers le verre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk mögött színátmenet húzódik, az üvegen megtörve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gradiente riempie lo sfondo dei tasti, rifratto dal vetro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラデーションがキーの後ろに広がり、ガラス越しに屈折します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 뒤로 그라데이션이 깔리고, 유리를 지나면서 굴절돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradien mengisi belakang kekunci, dibiaskan melalui kaca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um gradiente enche o fundo das teclas, refratado pelo vidro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За клавишами разливается градиент, преломлённый стеклом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "渐变在按键后面铺开，透过玻璃折射出来。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gradient se umple în spatele tastelor, refractat prin sticlă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Achter de toetsen vult zich een verloop, gebroken door het glas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "漸變在按鍵後面鋪開，透過玻璃折射出來。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradient wypełnia się za klawiszami i jest załamany przez szkło."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Градієнт заливається за клавішами, заломлюючись крізь скло."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşların arkasında camdan kırılan bir degrade doluyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za klávesami se vyplní gradient, který se láme přes sklo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Za klávesmi sa vypĺňa gradient, ktorý sa láme cez sklo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια κλίση γεμίζει πίσω από τα πλήκτρα, που διαθλάται μέσα από το γυαλί."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En gradient fylls bakom nycklarna, bruten genom glaset."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En gradient fylder bag tasterne, brudt gennem glasset."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En gradient fylles bak tastene, brutt gjennom glasset."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäinten taakse täyttyy kaltevuus, joka taittuu lasin läpi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradien terisi di belakang tuts, dibiaskan melalui kaca."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một dải màu lấp đầy phía sau các phím, khúc xạ qua kính."
          }
        }
      }
    },
    "A gradient fills the keyboard behind the keys, overriding the color.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Gradiënt vul die sleutelbord agter die sleutels, wat die kleur oorheers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Farbverlauf füllt die Tastatur hinter den Tasten und überschreibt die Farbe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un degradado llena el teclado detrás de las teclas y reemplaza el color."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üleminek täidab klaviatuuri klahvide taga ja asendab värvi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dégradé remplit le clavier derrière les touches et remplace la couleur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk mögött színátmenet tölti ki a billentyűzetet, felülírva a színt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gradiente riempie la tastiera dietro i tasti e sostituisce il colore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラデーションがキーの後ろのキーボードを覆い、色を上書きします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 뒤 키보드를 그라데이션이 채우면서 색을 덮어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradien mengisi papan kekunci di belakang kekunci, dan mengatasi warna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um gradiente enche o teclado por trás das teclas e substitui a cor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Градиент заливает клавиатуру за клавишами и заменяет цвет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "渐变铺满按键后面的键盘，盖过颜色。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gradient umple tastatura din spatele tastelor, suprascriind culoarea."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een verloop vult het toetsenbord achter de toetsen en overschrijft de kleur."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "漸變鋪滿按鍵後面的鍵盤，蓋過顏色。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradient wypełnia klawiaturę za klawiszami, zastępując kolor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Градієнт заповнює клавіатуру позаду клавіш, замінюючи колір."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir degrade, klavyeyi tuşların arkasında doldurarak rengi geçersiz kılar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přechod vyplní klávesnici za klávesami a přepíše barvu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prechod vyplní klávesnicu za klávesmi a prepíše farbu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια διαβάθμιση γεμίζει το πληκτρολόγιο πίσω από τα πλήκτρα, παρακάμπτοντας το χρώμα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En gradient fyller tangentbordet bakom tangenterna och åsidosätter färgen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En gradient fylder tastaturet bag tasterne og tilsidesætter farven."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En gradient fyller tastaturet bak tastene og overstyrer fargen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradientti täyttää näppäimistön näppäinten takana ohittaen värin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradien mengisi keyboard di belakang tombol, menggantikan warnanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một dải chuyển màu lấp đầy bàn phím phía sau các phím, ghi đè màu."
          }
        }
      }
    },
