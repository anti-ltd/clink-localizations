        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be. Azonnal ott lesz a billentyűzet eszközmenüjében."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo. Compare subito nel menu strumenti della tastiera."
