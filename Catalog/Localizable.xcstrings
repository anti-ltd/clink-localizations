    "Every downloaded and locally created action will be removed. This can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede geladene und lokal erstellte Aktion wird entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todas las acciones descargadas y creadas localmente. No se puede deshacer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik allalaaditud ja kohapeal loodud tegevused eemaldatakse. Seda ei saa tagasi võtta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les actions téléchargées et créées localement seront supprimées. C’est irréversible."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden letöltött és helyben létrehozott művelet el lesz távolítva. Ez nem vonható vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni azione scaricata e creata localmente verrà rimossa. L’operazione non è annullabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたアクションとローカルで作成したアクションはすべて削除されます。この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드했거나 로컬에서 만든 모든 동작이 제거됩니다. 되돌릴 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap tindakan yang dimuat turun dan dicipta secara tempatan akan dibuang. Ini tidak boleh dibatalkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as ações transferidas e criadas localmente serão removidas. Não é possível anular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все загруженные и созданные на этом устройстве действия будут удалены. Это действие нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有已下载和本地创建的操作都将被移除。此操作无法撤消。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare acțiune descărcată și creată local va fi eliminată. Acest lucru nu poate fi anulat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke gedownloade en lokaal gemaakte actie wordt verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
