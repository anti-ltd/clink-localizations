    "Clink only reads your clipboard when you ask it to, and clips stay on the device.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink lees net jou knipbord wanneer jy dit vra, en snitte bly op die toestel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink liest die Zwischenablage nur, wenn du es willst, und die Clips bleiben auf dem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink solo lee el portapapeles cuando se lo pides, y los clips se quedan en el dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink loeb sinu lõikelauda ainult siis, kui sa seda palud, ja klipid jäävad seadmesse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ne lit le presse-papiers que quand tu le demandes, et les clips restent sur l'appareil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink csak akkor olvassa a vágólapot, ha kéred, és a másolatok a készüléken maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink legge gli appunti solo quando glielo chiedi, e i contenuti restano sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkはあなたが求めたときだけクリップボードを読み、コピーした内容は端末に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink는 요청할 때만 클립보드를 읽고, 복사한 내용은 기기에 남아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink hanya membaca papan keratan bila anda minta, dan klip kekal pada peranti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink só lê a área de transferência quando lhe pedes, e os clips ficam no dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink читает буфер обмена, только когда вы попросите, и фрагменты остаются на устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 只在你需要时读取剪贴板，复制的内容都留在设备上。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink îți citește clipboard-ul doar când îți ceri, iar clipurile rămân pe dispozitiv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink leest uw klembord alleen wanneer u daarom vraagt, en clips blijven op het apparaat staan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 只在你需要時讀取剪貼簿，複製的內容都留在裝置上。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink czyta Twój schowek tylko wtedy, gdy o to poprosisz, a klipy pozostają na urządzeniu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink читає ваш буфер обміну лише тоді, коли ви його запитуєте, а кліпи залишаються на пристрої."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink panonuzu yalnızca siz istediğinizde okur ve klipler cihazda kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink přečte vaši schránku, pouze když o to požádáte, a klipy zůstanou v zařízení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink prečíta vašu schránku iba vtedy, keď o to požiadate, a klipy zostanú v zariadení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Clink διαβάζει το πρόχειρό σας μόνο όταν του το ζητήσετε και τα κλιπ παραμένουν στη συσκευή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink läser bara ditt urklipp när du ber om det, och klipp stannar på enheten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink læser kun dit udklipsholder, når du beder det om det, og klip bliver på enheden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink leser bare utklippstavlen når du ber om det, og klipp blir værende på enheten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink lukee leikepöydän vain pyydettäessä, ja leikkeet pysyvät laitteella."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink hanya membaca clipboard Anda saat Anda memintanya, dan klip tetap ada di perangkat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink chỉ đọc khay nhớ tạm của bạn khi bạn yêu cầu và các clip vẫn ở trên thiết bị."
          }
        }
      }
    },
