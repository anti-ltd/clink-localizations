    "Shown on the category tab. Set the tab style to Emoji on the Layout tab to use the set’s first emoji instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint auf dem Kategorie-Tab. Stell den Tab-Stil unter „Layout“ auf Emoji, damit stattdessen das erste Emoji des Sets zu sehen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ve en la pestaña de la categoría. Pon el estilo de las pestañas en Emoji, en la pestaña Diseño, para que salga el primer emoji del conjunto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichée sur l'onglet de la catégorie. Passe le style des onglets sur Emoji dans « Disposition » pour montrer plutôt le premier emoji du set."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kategóriafülön látszik. Állítsd a fülstílust Emojira az „Elrendezés” fülön, ha inkább a készlet első emojija jelenjen meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare sulla scheda della categoria. Imposta lo stile delle schede su Emoji in «Layout» per mostrare invece la prima emoji del set."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリタブに表示されます。「レイアウト」タブでタブのスタイルを絵文字にすると、代わりにセットの最初の絵文字が出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카테고리 탭에 보여요. ‘레이아웃’ 탭에서 탭 스타일을 이모지로 바꾸면 세트의 첫 이모지가 대신 나와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditunjukkan pada tab kategori. Tetapkan gaya tab kepada Emoji di tab Susun Atur untuk guna emoji pertama set itu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece no separador da categoria. Muda o estilo dos separadores para Emoji no separador Esquema, para mostrar o primeiro emoji do conjunto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывается на вкладке категории. Задайте вкладкам стиль «Эмодзи» на вкладке «Раскладка», чтобы вместо этого использовался первый эмодзи набора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在分类栏上。想改用合集里的第一个表情，就到「布局」里把分类栏样式设为表情。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvatakse kategooriakaardil. Määra kaardi stiiliks Emoji kaardil Paigutus, et kasutada hoopis komplekti esimest emojisid."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Getoon op die kategorie-oortjie. Stel die oortjiestyl na Emoji op die Uitleg-oortjie om eerder die stel se eerste emoji te gebruik."
          }
        }
      }
    },
