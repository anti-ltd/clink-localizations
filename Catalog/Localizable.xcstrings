    "Text FX restyles the word you're on. The styled text works in any app.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text-FX gestaltet das aktuelle Wort um. Der gestaltete Text funktioniert in jeder App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FX de texto cambia el estilo de la palabra en la que estás. El texto con estilo funciona en cualquier app."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksti-FX muudab kursori juures oleva sõna stiili. Kujundatud tekst toimib igas rakenduses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FX de texte change le style du mot en cours. Le texte ainsi mis en forme fonctionne dans toutes les apps."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Szöveg FX átformázza az aktuális szót. A formázott szöveg bármelyik appban használható."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FX testo cambia lo stile della parola su cui ti trovi. Il testo formattato funziona in qualsiasi app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストFXは、カーソル位置にある単語の見た目を変えます。変換した文字はどのアプリでも使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 FX는 커서가 있는 단어의 스타일을 바꿉니다. 스타일을 적용한 텍스트는 어떤 앱에서든 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "FX Teks mengubah gaya perkataan semasa. Teks bergaya itu boleh digunakan dalam mana-mana app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "FX de texto muda o estilo da palavra em que estás. O texto com estilo funciona em qualquer app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текстовые эффекты меняют оформление текущего слова. Такой текст можно использовать в любом приложении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字特效会改变光标所在单词的样式。处理后的文字可在任何 App 中使用。"
          }
        }
      }
    },
