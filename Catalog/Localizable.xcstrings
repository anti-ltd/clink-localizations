    "One sweep. One word. Two thumbs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wisch. Ein Wort. Zwei Daumen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un desliz. Una palabra. Dos pulgares."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üks pühk. Üks sõna. Kaks pöialt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un balayage. Un mot. Deux pouces."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy húzás. Egy szó. Két hüvelykujj."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gesto. Una parola. Due pollici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとスワイプ。ひとつの言葉。両方の親指。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 스와이프. 한 단어. 두 엄지."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu leret. Satu perkataan. Dua ibu jari."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um deslize. Uma palavra. Dois polegares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один взмах. Одно слово. Два больших пальца."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次滑动。一个词。两枚拇指。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een sweep. Een woord. Twee duime."
          }
        }
      }
    },
    "Add as many as you'd like, we support %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge so viele hinzu, wie du möchtest – wir unterstützen %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tantos como quieras, admitimos %lld"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa nii palju, kui soovid – toetame %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez-en autant que vous voulez, nous prenons en charge %lld"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá annyit, amennyit szeretnél – %lld nyelvet támogatunk"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungine quanti vuoi, supportiamo %lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "好きなだけ追加できます。%lld 言語に対応"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 만큼 추가하세요. %lld개 언어를 지원합니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah seberapa banyak yang anda mahu, kami menyokong %lld"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione quantos quiser, suportamos %lld"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте столько, сколько хотите — поддерживаем %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想加多少就加多少，我们支持 %lld 种语言"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg soveel by as wat jy wil, ons ondersteun %lld"
          }
        }
      }
    },
    "Every preset theme, layout and sound stays free too. The tools, custom looks, and custom themes and layouts need a membership.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch jedes Design, Layout und jeder Sound aus den Presets bleibt kostenlos. Die Tools, eigene Looks sowie eigene Designs und Layouts erfordern eine Mitgliedschaft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los temas, diseños y sonidos predefinidos también siguen siendo gratis. Las herramientas, los looks personalizados y los temas y diseños personalizados requieren una suscripción."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik eelseadistatud teemad, paigutused ja helid on samuti tasuta. Tööriistad, kohandatud välimused ning kohandatud teemad ja paigutused nõuavad liikmelisust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les thèmes, dispositions et sons prédéfinis restent gratuits. Les outils, les looks personnalisés et les thèmes et dispositions personnalisés nécessitent un abonnement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden beépített téma, elrendezés és hang ingyenes marad. Az eszközök, az egyedi megjelenések, valamint az egyedi témák és elrendezések előfizetést igényelnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche tutti i temi, i layout e i suoni predefiniti restano gratuiti. Gli strumenti, gli stili personalizzati e i temi e layout personalizzati richiedono un abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットのテーマ、レイアウト、サウンドもすべて無料のままです。ツール、カスタムルック、カスタムテーマ・レイアウトにはメンバーシップが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리셋 테마, 레이아웃, 사운드도 모두 무료로 유지됩니다. 도구, 맞춤 스타일, 맞춤 테마와 레이아웃은 멤버십이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua tema, susun atur dan bunyi pratetap juga kekal percuma. Alatan, rupa tersuai serta tema dan susun atur tersuai memerlukan keahlian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os temas, layouts e sons predefinidos também continuam gratuitos. As ferramentas, os visuais personalizados e os temas e layouts personalizados exigem uma assinatura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有预设主题、布局和声音也保持免费。工具、自定义外观以及自定义主题和布局需要会员资格。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все готовые темы, раскладки и звуки тоже остаются бесплатными. Инструменты, свои стили, свои темы и раскладки требуют членства."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke voorafingestelde tema, uitleg en klank bly ook gratis. Die gereedskap, pasgemaakte voorkoms en pasgemaakte temas en uitlegte het 'n lidmaatskap nodig."
          }
        }
      }
    },
    "Feel this": {
      "extractionState": "manual",
      "localizations": {
