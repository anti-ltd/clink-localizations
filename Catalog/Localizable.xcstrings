    "No counts in the file, so Clink is treating the list’s order as most-common-first.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geen tellings in die lêer nie, so Clink behandel die lys se volgorde as mees-algemene-eerste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Häufigkeiten in der Datei – Clink nimmt die Reihenfolge der Liste als „häufigste zuerst“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no trae frecuencias, así que Clink toma el orden de la lista como «más comunes primero»."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Failis sagedusi pole, seega Clink käsitleb loendi järjekorda kui „kõige sagedasemad esimesena\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de fréquences dans le fichier : Clink considère l’ordre de la liste comme « les plus courants d’abord »."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlban nincsenek gyakoriságok, ezért a Clink a lista sorrendjét veszi „leggyakoribb elöl” sorrendnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna frequenza nel file: Clink interpreta l’ordine dell’elenco come «prima le più comuni»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルに出現数がないため、リストの並び順を「よく使う順」として扱います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에 빈도가 없어, Clink는 목록 순서를 자주 쓰는 순서로 봅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada kiraan dalam fail, jadi Clink menganggap susunan senarai sebagai paling biasa dahulu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro não traz frequências, por isso o Clink assume a ordem da lista como «mais comuns primeiro»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В файле нет частот, поэтому Clink считает, что список отсортирован от самых частых слов к редким."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件中没有词频，Clink 会把词表顺序当作从常用到少用。"
          }
        }
      }
    },
