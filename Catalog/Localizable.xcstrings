    "Key height and key width resize the keys themselves.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutelhoogte en sleutelwydte verander die grootte van die sleutels self."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenhöhe und Tastenbreite ändern die Tasten selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El alto y el ancho de tecla cambian las teclas en sí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvi kõrgus ja klahvi laius muudavad klahve eneseid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La hauteur et la largeur de touche redimensionnent les touches elles-mêmes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűmagasság és -szélesség magukat a billentyűket méretezi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altezza e larghezza dei tasti ridimensionano i tasti stessi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キーの高さ」と「キーの幅」はキーそのものの大きさを変えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 높이와 키 너비는 키 자체의 크기를 바꿉니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinggi dan lebar kekunci mengubah saiz kekunci itu sendiri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A altura e a largura de tecla redimensionam as próprias teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Высота клавиши» и «Ширина клавиши» меняют размер самих клавиш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“按键高度”和“按键宽度”改的是按键本身。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înălțimea cheii și lățimea cheii redimensionează cheile în sine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutelhoogte en sleutelbreedte passen de grootte van de toetsen zelf aan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“按鍵高度”和“按鍵寬度”改的是按鍵本身。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysokość i szerokość klucza zmieniają rozmiar samych klawiszy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Висота та ширина клавіш змінюють розмір самих клавіш."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar yüksekliği ve anahtar genişliği, tuşların boyutunu yeniden ayarlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výška klíče a šířka klíče mění velikost samotných klíčů."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Výška kľúča a šírka kľúča menia veľkosť samotných kľúčov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ύψος και το πλάτος του κλειδιού αλλάζουν το μέγεθος των ίδιων των πλήκτρων."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckelhöjd och nyckelbredd ändrar storleken på själva tangenterna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøglehøjde og nøglebredde ændrer størrelsen på selve tasterne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasthøyde og nøkkelbredde endre størrelsen på selve tastene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäimen korkeus ja leveys muuttavat itse näppäinten kokoa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinggi kunci dan lebar kunci mengubah ukuran kunci itu sendiri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiều cao phím và chiều rộng phím tự thay đổi kích thước của các phím."
          }
        }
      }
    },
