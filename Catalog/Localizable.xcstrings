    "%@ is a built-in layout. Make your own copy of it to add and edit keys.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ein festes Layout. Mach dir eine eigene Kopie, um Tasten hinzuzufügen und zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es una distribución integrada. Haz tu propia copia para añadir y editar teclas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est une disposition intégrée. Fais-en une copie pour ajouter et modifier des touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ egy beépített elrendezés. Csinálj róla saját másolatot, ha billentyűket akarsz hozzáadni vagy szerkeszteni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è un layout integrato. Fanne una tua copia per aggiungere e modificare i tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は最初から入っているレイアウトです。キーを追加したり編集したりするには、コピーを作ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 은(는) 기본 레이아웃이에요. 키를 추가하거나 고치려면 복사본을 만들어서 쓰세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ialah susun atur siap sedia. Buat salinan anda sendiri untuk tambah dan ubah kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é um esquema integrado. Faz uma cópia tua para adicionares e editares teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — встроенная раскладка. Сделайте свою копию, чтобы добавлять и менять клавиши."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是内置布局。复制一份，就能加键和改键了。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on sisseehitatud paigutus. Tee sellest oma koopia, et lisada ja muuta klahve."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ is 'n ingeboude uitleg. Maak jou eie kopie daarvan om sleutels by te voeg en te wysig."
          }
        }
      }
    },
    "%@ is a built-in layout. Make your own copy of it to keep keys on this layout alone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ein festes Layout. Mach dir eine eigene Kopie, um Tasten nur auf diesem Layout zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es una distribución integrada. Haz tu propia copia para tener teclas solo en esta distribución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est une disposition intégrée. Fais-en une copie pour garder des touches sur cette disposition seulement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ egy beépített elrendezés. Csinálj róla saját másolatot, ha csak ezen az elrendezésen akarsz billentyűket tartani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è un layout integrato. Fanne una tua copia per tenere i tasti solo su questo layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は最初から入っているレイアウトです。このレイアウトだけにキーを置くには、コピーを作ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 은(는) 기본 레이아웃이에요. 이 레이아웃에만 키를 두려면 복사본을 만들어서 쓰세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ialah susun atur siap sedia. Buat salinan anda sendiri untuk mengekalkan kekunci pada susun atur ini sahaja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é um esquema integrado. Faz uma cópia tua para manteres teclas só neste esquema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — встроенная раскладка. Сделайте свою копию, чтобы клавиши остались только в ней."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是内置布局。复制一份，就能只在这个布局上留按键了。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on sisseehitatud paigutus. Tee sellest oma koopia, et hoida klahve ainult sellel paigutusel."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ is 'n ingeboude uitleg. Maak jou eie kopie daarvan om sleutels op hierdie uitleg alleen te hou."
          }
        }
      }
    },
    "%@ isn't a variable, so it'll be sent as-is.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist keine Variable und wird deshalb unverändert gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no es una variable, así que se enviará tal cual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est pas une variable, il sera donc envoyé tel quel."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ nem változó, ezért változatlanul kerül elküldésre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è una variabile, quindi verrà inviato così com'è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は変数ではないため、そのまま送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 변수가 아니므로 그대로 전송됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bukan pemboleh ubah, jadi ia akan dihantar seadanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não é uma variável, por isso será enviado tal como está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — не переменная, поэтому отправится как есть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是变量，将按原样发送。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pole muutuja, seega saadetakse see muutmata kujul."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ is nie 'n veranderlike nie, so dit sal gestuur word soos dit is."
          }
        }
      }
    },
