    "A clear knob showing the dial inside, to match the Switches keys.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mando transparente con el dial a la vista, a juego con las teclas que muestran el interruptor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une molette transparente laissant voir le cadran, assortie aux touches à mécanisme apparent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein durchsichtiger Drehregler mit sichtbarer Skala, passend zu den Tasten mit sichtbaren Schaltern."
          }
        },
        "it": {
          "stringUnit": {
