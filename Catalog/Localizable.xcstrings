    "The words themselves don’t change. This only moves them. To filter the list against a different language’s writing rules, import the file again.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die woorde self verander nie. Dit beweeg hulle net. Om die lys teen 'n ander taal se skryfreëls te filtreer, voer die lêer weer in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wörter selbst ändern sich nicht. Sie werden nur verschoben. Um die Liste nach den Schreibregeln einer anderen Sprache zu filtern, importiere die Datei erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras no cambian. Solo se mueven. Para filtrar la lista con las reglas de escritura de otro idioma, importa el archivo de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sõnad ise ei muutu. See ainult liigutab neid. Et loendit teise keele kirjareeglite järgi filtreerida, impordi fail uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots eux-mêmes ne changent pas. Ils sont seulement déplacés. Pour filtrer la liste selon les règles d’écriture d’une autre langue, réimportez le fichier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Maguk a szavak nem változnak, csak átkerülnek. Ha egy másik nyelv írásszabályai szerint szűrnéd a listát, importáld újra a fájlt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole non cambiano. Vengono solo spostate. Per filtrare l’elenco con le regole di scrittura di un’altra lingua, importa di nuovo il file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語そのものは変わりません。移動するだけです。別の言語の表記ルールで絞り込むには、ファイルを取り込み直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어 자체는 바뀌지 않고 옮겨지기만 합니다. 다른 언어의 표기 규칙으로 걸러내려면 파일을 다시 가져오세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataannya sendiri tidak berubah. Ia hanya berpindah. Untuk menapis senarai mengikut peraturan tulisan bahasa lain, import fail itu semula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras em si não mudam. Só são movidas. Para filtrar a lista pelas regras de escrita de outro idioma, importa o ficheiro outra vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сами слова не меняются — они только переносятся. Чтобы отфильтровать список по правилам письма другого языка, импортируйте файл заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词本身不会变，只是换个归属。若想按另一门语言的书写规则重新筛选词表，请重新导入文件。"
          }
        }
      }
    },
