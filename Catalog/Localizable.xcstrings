    "Each background has a unique reaction.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke agtergrond het 'n unieke reaksie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Hintergrund hat seine eigene Reaktion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada fondo tiene una reacción única."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Igal taustal on oma ainulaadne reaktsioon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fond a sa propre réaction."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden háttérnek egyedi reakciója van."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni sfondo ha una reazione unica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景ごとに独自の反応があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경마다 고유한 반응이 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap latar belakang mempunyai reaksi yang unik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada fundo tem uma reação única."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждой фоновой темы своя уникальная реакция."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个背景都有独特的反应。"
          }
        }
      }
    },
    "Each tap moves to the next selected layout or extra page. Pick at least two.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada toque pasa a la siguiente distribución o página adicional seleccionada. Elige al menos dos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque appui passe à la disposition ou page supplémentaire sélectionnée suivante. Choisis-en au moins deux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Tippen wechselt zum nächsten ausgewählten Layout oder zur nächsten Zusatzseite. Wähle mindestens zwei aus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni tocco passa alla disposizione o pagina aggiuntiva selezionata successiva. Scegline almeno due."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada toque avança para a disposição ou página adicional selecionada seguinte. Escolha pelo menos duas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое нажатие переключает на следующую выбранную раскладку или дополнительную страницу. Выберите хотя бы две."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap ketikan beralih ke susun atur atau halaman tambahan dipilih yang seterusnya. Pilih sekurang-kurangnya dua."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden koppintás a következő kiválasztott kiosztásra vagy extra oldalra vált. Válassz legalább kettőt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップするたびに、選択した次の配列や追加ページに切り替わります。2つ以上選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次轻点都会切换到下一个选中的布局或附加页面。请至少选择两个。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭할 때마다 선택한 다음 배열 또는 추가 페이지로 전환합니다. 두 개 이상 선택하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga puudutus lülitab järgmisele valitud paigutusele või lisalehele. Vali vähemalt kaks."
          }
        }
      }
    },
