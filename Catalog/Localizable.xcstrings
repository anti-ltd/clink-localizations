          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold en tast for aksentlinjen, eller sveip rett ned for å skrive den første aksenten umiddelbart."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä sen aksenttipalkin näppäintä painettuna tai pyyhkäise suoraan alas kirjoittaaksesi ensimmäisen korostuksen välittömästi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan tombol untuk bilah aksennya, atau jentikkan lurus ke bawah untuk langsung mengetikkan aksen pertama."
