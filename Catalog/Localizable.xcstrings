        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-urile au nevoie de acces complet pentru a căuta și a copia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF's hebben volledige toegang nodig om te zoeken en te kopiëren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
