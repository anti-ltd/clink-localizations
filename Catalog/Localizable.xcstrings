    "Cling keeps the clips and saved notes you pin from the keyboard. Enable sharing for either tool above.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cling hou die snitte en gestoorde notas wat jy van die sleutelbord vaspen. Aktiveer deling vir enige nutsding hierbo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling bewahrt Clips und gespeicherte Notizen auf, die du über die Tastatur anheftest. Aktiviere oben die Freigabe für eines der beiden Werkzeuge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling guarda los clips y las notas que fijes desde el teclado. Activa arriba el uso compartido para cualquiera de las dos herramientas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling hoiab klippe ja salvestatud märkmeid, mida sa klaviatuurilt kinnitad. Lülita ülal sisse mõlema tööriista jagamine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling conserve les extraits et les notes enregistrées que tu épingles depuis le clavier. Active le partage pour l’un des deux outils ci-dessus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cling megőrzi a billentyűzetről kitűzött klipeket és mentett jegyzeteket. Kapcsold be fent a megosztást valamelyik eszközhöz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling conserva gli appunti e le note salvate che fissi dalla tastiera. Attiva qui sopra la condivisione per uno dei due strumenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clingは、キーボードからピン留めしたクリップや保存済みメモを保管します。上のいずれかのツールで共有を有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling은 키보드에서 고정한 클립과 저장된 메모를 보관합니다. 위 도구 중 하나에서 공유를 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling menyimpan klip dan nota tersimpan yang anda pin daripada papan kekunci. Dayakan perkongsian untuk salah satu alat di atas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cling guarda os recortes e as notas que afixar a partir do teclado. Ative acima a partilha para uma das ferramentas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling хранит фрагменты и заметки, которые вы закрепляете с клавиатуры. Включите обмен для любого из инструментов выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling 会保存你从键盘置顶的剪贴内容和已存笔记。请为上方任一工具开启共享。"
          }
        }
      }
    },
    "Cling keeps the clips you pin from the keyboard's clipboard panel. Turn on Clipboard history to send to it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cling hou die knipsels wat jy vasspeld van die sleutelbord se knipbordpaneel af. Skakel knipbordgeskiedenis aan om daarnatoe te stuur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling behält die Clips, die du aus der Zwischenablage des Tastatur-Panels anheftest. Schalte den Zwischenablageverlauf ein, um zu senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling guarda los clips que fijas desde el panel del portapapeles del teclado. Activa el historial del portapapeles para enviarlos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling hoiab klippe, mida sa klaviatuuri lõikelaua paneelilt kinnitad. Lülita sisse Lõikelaua ajalugu, et sinna saata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling garde les clips que tu épingles depuis le panneau presse-papiers du clavier. Active l'historique du presse-papiers pour envoyer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cling megőrzi a vágólap-panelből rögzített klippeket. Kapcsold be a Vágólap-előzményeket a küldéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling conserva le clip che fissi dal pannello appunti della tastiera. Attiva la cronologia degli appunti per inviarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clingはキーボードのクリップボードパネルからピン留めしたクリップを保持します。送信するにはクリップボード履歴をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling이 키보드 클립보드 패널에서 고정한 클립을 보관합니다. 보내려면 클립보드 기록을 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling menyimpan klip yang anda semat dari panel papan keratan papan kekunci. Hidupkan Sejarah papan keratan untuk menghantar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cling guarda os clipes que fixas a partir do painel da área de transferência do teclado. Liga o histórico da área de transferência para os enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling хранит фрагменты, которые вы закрепляете в панели буфера обмена. Включите «Историю буфера обмена», чтобы отправлять их туда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling 会保存你从键盘剪贴板面板固定的剪辑。开启剪贴板历史即可发送。"
          }
        }
      }
    },
