        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Sync adalah bagian dari keanggotaan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Sync là một phần của tư cách thành viên."
          }
        }
      }
    },
