        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve per i temi, lo swipe e gli extra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ、スワイプ、追加機能に必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마, 스와이프, 그 밖의 기능에 필요해요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlu untuk tema, leret, dan tambahan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preciso para temas, deslize e extras"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно для тем, скольжения и дополнений"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题、滑动和那些额外功能都需要它"
          }
        }
      }
    },
    "Needs Bloom. Turn it up above.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Benodig Bloei. Draai dit op bo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benötigt Bloom. Dreh es oben auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere Bloom: actívalo arriba."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajab Bloomi. Suurenda seda ülalpool."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite Bloom. Augmente-le ci-dessus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom szükséges hozzá. Tekerd fel fentebb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede Bloom: aumentalo qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブルームが必要です。上でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "블룸이 필요합니다. 위에서 켜 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memerlukan Bloom. Naikkannya di atas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer Bloom. Aumente-o acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно «Свечение». Прибавьте его выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要开启 Bloom，请在上方调高。"
          }
        }
      }
    },
    "Needs Bloom. Turn it up in the Motion popup.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Benodig Bloei. Draai dit op in die Motion-opspringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert Bloom. Erhöhe es im Bewegungs-Popup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita Bloom. Súbelo en la ventana de Movimiento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajab Bloomi. Suurenda seda liikumise hüpikaknas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite Bloom. Augmentez-le dans la fenêtre Mouvement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomot igényel. Növeld a Mozgás felugró ablakban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede Bloom. Alzalo nella finestra Movimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomが必要です。モーションポップアップで上げてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom이 필요합니다. 모션 팝업에서 높여 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memerlukan Bloom. Naikkan dalam pop timbul Gerakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer Bloom. Aumente-o na janela de Movimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется Bloom. Увеличьте его в окне «Движение»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 Bloom。请在动效弹窗中调高。"
          }
