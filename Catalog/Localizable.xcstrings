    "Swipe left on backspace to delete a word. Keep dragging for more.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Swiep links op terugspasie om 'n woord uit te vee. Hou aan sleep vir meer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische auf der Rücktaste nach links, um ein Wort zu löschen. Zieh weiter für mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la izquierda sobre retroceso para borrar una palabra. Sigue arrastrando para borrar más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viipa backspace’is vasakule, et sõna kustutada. Jätka lohistamist, et rohkem kustutada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaie vers la gauche sur retour arrière pour supprimer un mot. Continue à glisser pour en supprimer plus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd balra a törlés gombot egy szó törléséhez. Húzd tovább, ha többet akarsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri verso sinistra sul tasto Backspace per cancellare una parola. Continua a trascinare per cancellarne altre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックスペースを左にスワイプで単語を削除。そのまま引っぱるともっと消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백스페이스를 왼쪽으로 밀면 단어가 지워져요. 계속 끌면 더 지워져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret ke kiri pada backspace untuk padam perkataan. Terus seret untuk lagi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para a esquerda no retrocesso para apagar uma palavra. Continua a arrastar para apagares mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните влево по Backspace, чтобы удалить слово. Ведите дальше — удалятся следующие."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在退格键上向左滑删掉一个词，接着拖能删更多。"
          }
        }
      }
    },
