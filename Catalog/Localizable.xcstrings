    "New words underlined, old ones dropped. Stays readable.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuwe woorde onderstreep, oues laat val. Bly leesbaar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Wörter unterstrichen, alte entfernt. Bleibt gut lesbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Palabras nuevas subrayadas y antiguas eliminadas. Sigue siendo fácil de leer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Uued sõnad allajoonitud, vanad eemaldatud. Jääb loetavaks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouveaux mots soulignés, anciens supprimés. Le texte reste lisible."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az új szavak aláhúzva, a régiek elhagyva. Jól olvasható marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parole nuove sottolineate e vecchie rimosse. Resta leggibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい単語に下線を引き、古い単語は表示しません。読みやすさを保てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 단어에 밑줄을 긋고 이전 단어는 빼요. 읽기 쉬운 상태를 유지해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataan baharu digaris bawah, yang lama dibuang. Kekal mudah dibaca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palavras novas sublinhadas e antigas removidas. Continua fácil de ler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые слова подчёркнуты, старые убраны. Остаётся читаемым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给新词加下划线并移除旧词，保持易读。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuvinte noi subliniate, cele vechi scăpate. Rămâne lizibil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe woorden onderstreept, oude geschrapt. Blijft leesbaar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給新詞加下劃線並移除舊詞，保持易讀。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe słowa podkreślono, stare usunięto. Pozostaje czytelny."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нові слова підкреслені, старі опущені. Залишається читабельним."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni kelimelerin altı çizildi, eskilerin altı çizildi. Okunabilir kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nová slova podtržena, stará vypuštěna. Zůstává čitelný."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nové slová podčiarknuté, staré vypustené. Zostáva čitateľný."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Νέες λέξεις υπογραμμισμένες, παλιές έπεσαν. Παραμένει ευανάγνωστο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nya ord understrukna, gamla tappade. Håller sig läsbar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye ord understreget, gamle faldet. Forbliver læsbar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye ord understreket, gamle falt. Holder seg lesbar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uudet sanat alleviivattu, vanhat pois. Pysyy luettavana."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata-kata baru digarisbawahi, kata-kata lama dihilangkan. Tetap dapat dibaca."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những từ mới được gạch chân, những từ cũ bỏ đi. Vẫn có thể đọc được."
          }
        }
      }
