    "Save the scratch buffer above to keep snippets here.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoor die krapbuffer hierbo om brokkies hier te hou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere den Notizpuffer oben, damit deine Schnipsel hier bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el borrador de arriba para conservar los fragmentos aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvesta ülalolev mustandipuhver, et nipped siia jääksid."
          }
        },
        "fr": {
