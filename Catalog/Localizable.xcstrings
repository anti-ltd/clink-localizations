        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkış, giriş korunarak imlecin bulunduğu yere eklenir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výstup se vloží na kurzor, přičemž se zachová vstup."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Výstup sa vloží na kurzor, pričom sa zachová vstup."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η έξοδος εισάγεται στον κέρσορα, διατηρώντας την είσοδο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utgången infogas vid markören och behåller ingången."
          }
        },
        "da": {
