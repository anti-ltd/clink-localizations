    "Word-pair counts behind next-word prediction. Adapted into Clink's bigram format.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Woordpaar tel agter volgende woord voorspelling. Aangepas in Clink se bigram-formaat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wortpaar-Häufigkeiten hinter der Wortvorhersage. Ins Clink-Bigrammformat übertragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuentos de pares de palabras detrás de la predicción de la siguiente palabra. Adaptados al formato de bigramas de Clink."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sõnapaaride arvud järgmise sõna ennustuse taga. Kohandatud Clinki bigrammi vormingusse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptages de paires de mots à l'origine de la prédiction du mot suivant. Adaptés au format bigramme de Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szópár-gyakoriságok a következő szó előrejelzése mögött. Átalakítva a Clink bigram formátumára."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteggi di coppie di parole alla base della previsione della parola successiva. Adattati al formato bigrammi di Clink."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の単語予測を支える単語ペアの出現回数。Clinkのバイグラム形式に変換済み。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 단어 예측을 뒷받침하는 단어 쌍 빈도입니다. Clink의 바이그램 형식으로 변환했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiraan pasangan perkataan yang menggerakkan ramalan perkataan seterusnya. Disesuaikan kepada format bigram Clink."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Contagens de pares de palavras por trás da previsão da próxima palavra. Adaptadas ao formato de bigramas do Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Частоты пар слов, на которых держится предсказание следующего слова. Переведены в формат биграмм Clink."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支撑下一词预测功能的词对统计，已转换为 Clink 的二元组格式。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Perechile de cuvinte se numără în spatele predicției cuvântului următor. Adaptat în formatul bigram al lui Clink."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Woordparen tellen mee bij de voorspelling van het volgende woord. Aangepast in het bigramformaat van Clink."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支撐下一詞預測功能的詞對統計，已轉換為 Clink 的二元組格式。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Para słów liczy się za przewidywaniem następnego słowa. Dostosowany do formatu bigram Clink."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пара слів зараховується після передбачення наступного слова. Адаптовано до формату біграми Clink."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelime çifti, sonraki kelime tahmininin arkasında sayılır. Clink'in bigram formatına uyarlanmıştır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pár slov se počítá za predikci dalšího slova. Upraveno do formátu bigramu Clink."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pár slov sa počíta za predikciu ďalšieho slova. Prispôsobené do formátu bigramu Clink."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ζεύγος λέξεων μετράει πίσω από την πρόβλεψη της επόμενης λέξης. Προσαρμόστηκε στη μορφή bigram του Clink."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordpar räknas bakom nästa ords förutsägelse. Anpassad till Clink:s bigramformat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ord-par tæller bag næste ord forudsigelse. Tilpasset til Clink's bigram-format."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ord-par teller bak neste ord prediksjon. Tilpasset til Clink sitt bigram-format."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanapari laskee seuraavan sanan ennustamisen takana. Mukautettu Clink:n biggram-muotoon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasangan kata diperhitungkan di belakang prediksi kata berikutnya. Diadaptasi ke dalam format bigram Clink."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số lượng cặp từ đằng sau dự đoán từ tiếp theo. Chuyển thể sang định dạng bigram của Clink."
          }
        }
      }
