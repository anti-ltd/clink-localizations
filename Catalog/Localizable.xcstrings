    "Learning stays on your device. Nothing is uploaded. Clearing removes everything right away.": {
      "extractionState": "stale",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leer bly op jou toestel. Niks word opgelaai nie. Die skoonmaak verwyder alles dadelik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lernen bleibt auf deinem Gerät. Nichts wird hochgeladen. Beim Löschen ist sofort alles weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aprendizaje se queda en tu dispositivo. No se sube nada. Al borrar se elimina todo al momento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Õppimine jääb sinu seadmesse. Midagi ei laadita üles. Tühjendamine eemaldab kõik koheselt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apprentissage reste sur ton appareil. Rien n'est envoyé. L'effacement supprime tout tout de suite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tanulás az eszközödön marad. Semmi nem töltődik fel. A törlés azonnal eltávolít mindent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apprendimento resta sul tuo dispositivo. Niente viene caricato. Cancellando rimuovi tutto all'istante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習はこのデバイスの中だけで行われます。何もアップロードされません。消去するとすぐにすべて消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학습은 기기에만 남아요. 아무것도 올라가지 않아요. 지우면 모든 게 바로 사라져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelajaran kekal pada peranti anda. Tiada apa dimuat naik. Mengosongkannya buang semuanya serta-merta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aprendizagem fica no teu dispositivo. Nada é enviado. Ao limpar, remove tudo logo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обучение не покидает ваше устройство. Ничего не загружается. Очистка удаляет всё сразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学习只留在你的设备上。什么都不会上传。清除会立刻抹掉一切。"
          }
        }
      }
    },
