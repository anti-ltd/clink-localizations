    "Fill the empty bar with your tools. Off keeps it clear until suggestions appear.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt die leere Leiste mit deinen Tools. Deaktiviert bleibt sie leer, bis Vorschläge erscheinen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llena la barra vacía con tus herramientas. Desactivado, permanece despejada hasta que aparezcan sugerencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplit la barre vide avec tes outils. Désactivé, elle reste dégagée jusqu’à l’apparition de suggestions."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitölti az üres sávot az eszközeiddel. Kikapcsolva üres marad, amíg javaslatok nem jelennek meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riempie la barra vuota con i tuoi strumenti. Disattivato, resta sgombra finché non compaiono suggerimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空のバーをツールで埋めます。オフにすると、候補が表示されるまでバーは空のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 바를 도구로 채웁니다. 끄면 제안이 나타나기 전까지 바를 비워 둡니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Isikan bar kosong dengan alat anda. Jika dimatikan, bar kekal kosong sehingga cadangan muncul."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenche a barra vazia com as tuas ferramentas. Desativado, ela fica livre até aparecerem sugestões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполнять пустую строку вашими инструментами. Выключено — строка остаётся пустой, пока не появятся подсказки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你的工具填满空白栏。关闭时，栏会保持空白，直到出现建议为止。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Täida tühi riba oma tööriistadega. Välja lülitatuna jääb see tühjaks, kuni soovitused ilmuvad."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vul die leë balk met jou gereedskap. Af hou dit duidelik totdat voorstelle verskyn."
          }
        }
      }
    },
    "Fills as you use emoji": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt sich, während du Emojis benutzt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se llena a medida que usas emoji"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se remplit au fil de tes emoji"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahogy emojikat használsz, úgy töltődik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si riempie man mano che usi le emoji"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵文字を使うほど埋まっていきます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이모지를 쓸수록 채워져요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terisi sambil anda guna emoji"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai enchendo à medida que usas emoji"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполняется по мере того, как вы пользуетесь эмодзи"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你用得越多，它就越满"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Täitub, kuni kasutad emojisid"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vul soos jy emoji's gebruik"
          }
        }
      }
    },
    "Find a word": {
      "extractionState": "manual",
      "localizations": {
        "de": {
