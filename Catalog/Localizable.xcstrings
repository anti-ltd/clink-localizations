    "The copy on this device stays. Syncing for this one switches off, so it isn't sent back up.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die kopie op hierdie toestel bly. Sinkronisering vir hierdie een skakel af, so dit word nie teruggestuur nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie auf diesem Gerät bleibt. Die Synchronisierung dafür wird ausgeschaltet, damit sie nicht gleich wieder hochgeht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de este dispositivo se queda. Se desactiva su sincronización para que no vuelva a subir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle seadme koopia jääb alles. Selle sünkroonimine lülitub välja, nii et seda tagasi üles ei saadeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie sur cet appareil reste. Sa synchronisation est désactivée pour qu’elle ne remonte pas aussitôt."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközön lévő másolat megmarad. Ehhez a szinkronizálás kikapcsol, hogy ne kerüljön vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia su questo dispositivo resta. La sincronizzazione per questa voce si disattiva, così non torna su."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末のコピーは残ります。再びアップロードされないよう、この項目の同期はオフになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 사본은 그대로 남습니다. 다시 올라가지 않도록 해당 항목의 동기화는 꺼집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan pada peranti ini kekal. Penyegerakan untuk yang satu ini dimatikan supaya ia tidak dihantar semula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia neste dispositivo fica. A sincronização deste item é desligada, para não voltar a subir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия на этом устройстве остаётся. Синхронизация для неё выключается, поэтому обратно она не отправляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备上的副本会保留。该项的同步会关闭，以免再次上传。"
          }
        }
      }
    },
    "The current white icon": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die huidige wit ikoon"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktuelle weiße Symbol"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El icono blanco actual"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Praegune valge ikoon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icône blanche actuelle"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelenlegi fehér ikon"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icona bianca attuale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の白いアイコン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재의 흰색 아이콘"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikon putih semasa"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone branco atual"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущая белая иконка"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前的白色图标"
          }
        }
      }
    },
    "The device is running hot, so the light holds still instead of moving. Presses still light up.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo está caliente, por lo que la luz permanece fija. Las pulsaciones siguen iluminándose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil chauffe, donc la lumière reste fixe. Les touches s’allument toujours à l’appui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät wird heiß, deshalb bleibt das Licht unbewegt. Tastendrücke leuchten weiterhin auf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo è caldo, quindi la luce resta ferma. I tasti si illuminano ancora alla pressione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo está quente, pelo que a luz fica estática. As teclas continuam a iluminar-se ao premir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство нагрелось, поэтому подсветка неподвижна. Нажатия по-прежнему подсвечиваются."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peranti sedang panas, jadi cahaya tidak bergerak. Kekunci masih menyala apabila ditekan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszköz felmelegedett, ezért a fény nem mozog. A leütések továbbra is felvillannak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスが高温のため、光の動きを止めています。キーを押したときの点灯は続きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备温度较高，灯光保持静止。按键按下时仍会亮起。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 뜨거워져 빛이 움직이지 않습니다. 키를 누르면 계속 빛납니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seade on kuum, seega valgus ei liigu. Vajutused süütavad endiselt valguse."
          }
        }
      }
    },
    "The device is running warm. Glass keeps rendering, and the optional effects come back once it cools down.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die toestel loop warm. Glas hou aan om weer te gee, en die opsionele effekte kom terug sodra dit afgekoel het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät ist warm geworden. Das Glas bleibt, und die optionalen Effekte kommen zurück, sobald es abgekühlt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo se ha calentado. El cristal se mantiene y los efectos opcionales vuelven en cuanto se enfríe."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seade on soojaks läinud. Klaas jätkab renderdamist ja valikulised efektid tulevad tagasi, kui ta jahtub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil a chauffé. Le verre reste affiché et les effets facultatifs reviennent dès qu'il a refroidi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A készülék felmelegedett. Az üveg marad, a nem kötelező effektek pedig visszatérnek, amint lehűl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo si è scaldato. Il vetro resta e gli effetti opzionali tornano appena si raffredda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末が熱を持っています。ガラスはそのままで、任意のエフェクトは温度が下がると戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 뜨거워졌습니다. 글래스는 그대로 두고 선택적인 효과는 식으면 다시 돌아옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peranti sedang panas. Kaca kekal dan kesan pilihan kembali sebaik sahaja ia menyejuk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo aqueceu. O vidro continua e os efeitos opcionais voltam assim que arrefecer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство греется. Стекло по-прежнему рисуется, а необязательные эффекты вернутся, когда оно остынет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备有些发热。玻璃继续渲染，可选特效会在降温后恢复。"
          }
        }
      }
    },
    "The downloaded font could not be verified or installed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido verificar o instalar la fuente descargada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier ou d’installer la police téléchargée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die geladene Schrift konnte nicht geprüft oder installiert werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare o installare il font scaricato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar ou instalar o tipo de letra descarregado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить или установить загруженный шрифт."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fon yang dimuat turun tidak dapat disahkan atau dipasang."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A letöltött betűtípust nem sikerült ellenőrizni vagy telepíteni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたフォントを検証またはインストールできませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证或安装下载的字体。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 서체를 확인하거나 설치할 수 없습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Allalaaditud fonti ei saanud kontrollida või installida."
          }
        }
      }
    },
    "The downloaded font did not match the expected hash or size": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente descargada no coincide con el hash o el tamaño esperado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’empreinte ou la taille de la police téléchargée ne correspond pas à celle attendue"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfsumme oder Größe der geladenen Schrift stimmt nicht mit dem erwarteten Wert überein"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’hash o la dimensione del font scaricato non corrisponde al valore previsto"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O hash ou o tamanho do tipo de letra descarregado não corresponde ao esperado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контрольная сумма или размер загруженного шрифта не совпадает с ожидаемым значением"
          }
        },
        "ms": {
          "stringUnit": {
