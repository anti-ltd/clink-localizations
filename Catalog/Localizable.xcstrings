    "%lld more differ from the defaults: layouts, languages, and other settings without a single switch to point at.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld meer verskil van die verstekke: uitlegte, tale en ander instellings sonder 'n enkele skakelaar om na te wys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld weitere weichen von den Standards ab: Layouts, Sprachen und andere Einstellungen ohne einen einzelnen Schalter, auf den man zeigen könnte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otros %lld difieren de los valores por defecto: disposiciones, idiomas y otros ajustes sin un control concreto al que apuntar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld veel erinevad vaikeväärtustest: paigutused, keeled ja muud seaded, millel pole ühte ühist lülitit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld autres diffèrent des valeurs par défaut : dispositions, langues et autres réglages sans un interrupteur précis à montrer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "További %lld tér el az alapértelmezéstől: elrendezések, nyelvek és más beállítások, amikhez nem tartozik egyetlen kapcsoló sem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altre %lld si discostano dai valori predefiniti: disposizioni, lingue e altre impostazioni senza un singolo interruttore da indicare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかに %lld 件が初期値と異なります。レイアウトや言語など、ひとつのスイッチでは示せない設定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 밖에 %lld개가 기본값과 다릅니다. 배열, 언어처럼 스위치 하나로 가리킬 수 없는 설정입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lagi berbeza daripada tetapan asal: susun atur, bahasa dan tetapan lain yang tiada satu suis khusus untuk ditunjuk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Outras %lld diferem das predefinições: esquemas, idiomas e outras definições sem um controlo concreto para apontar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё %lld отличаются от стандартных: раскладки, языки и другие настройки, у которых нет отдельного переключателя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另有 %lld 项与默认值不同：布局、语言，以及其他没有单独开关可指的设置。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld diferă mai mult de valorile implicite: aspecte, limbi și alte setări fără un singur comutator spre care să se îndrepte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld verschilt nog meer van de standaardwaarden: lay-outs, talen en andere instellingen zonder een enkele schakelaar om naar te wijzen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另有 %lld 項與預設值不同：佈局、語言，以及其他沒有單獨開關可指的設定。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld bardziej różni się od ustawień domyślnych: układy, języki i inne ustawienia bez jednego przełącznika, na który można wskazać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld більше відрізняється від стандартних: макети, мови та інші налаштування без жодного перемикача, на який можна вказати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld varsayılanlardan çok daha farklıdır: mizanpajlar, diller ve işaret edilecek tek bir anahtara ihtiyaç duymayan diğer ayarlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld více se liší od výchozích nastavení: rozložení, jazyky a další nastavení bez jediného přepínače, na který by bylo možné ukázat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld viac sa líši od predvolených nastavení: rozloženia, jazyky a ďalšie nastavenia bez jediného prepínača, na ktorý by ste mali ukázať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %lld more διαφέρει από τις προεπιλογές: διατάξεις, γλώσσες και άλλες ρυθμίσεις χωρίς ούτε έναν διακόπτη για να το δείξετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld skiljer sig mer från standardinställningarna: layouter, språk och andra inställningar utan en enda switch att peka på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld adskiller sig mere fra standardindstillingerne: layout, sprog og andre indstillinger uden en enkelt kontakt at pege på."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld mer skiller seg fra standardinnstillingene: layouter, språk og andre innstillinger uten en eneste bryter å peke på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld eroaa enemmän oletusasetuksista: asettelut, kielet ja muut asetukset ilman yhtäkään kytkintä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lebih berbeda dari defaultnya: tata letak, bahasa, dan pengaturan lainnya tanpa satu pun tombol yang dapat ditunjuk."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld khác biệt hơn so với các cài đặt mặc định: bố cục, ngôn ngữ và các cài đặt khác mà không cần một nút chuyển nào để trỏ vào."
          }
        }
      }
    },
