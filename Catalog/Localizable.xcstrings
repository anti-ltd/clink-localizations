    "This NuKey code links to a theme rather than containing one. Clink will download it from %@. You'll see what it looks like before anything is saved.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie NuKey-kode skakel na 'n tema in plaas daarvan om een te bevat. Clink sal dit van %@ af laai. Jy sien hoe dit lyk voordat enigiets gestoor word."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser NuKey-Code verweist auf ein Design, statt eines zu enthalten. Clink lädt es von %@. Du siehst, wie es aussieht, bevor etwas gesichert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código de NuKey enlaza a un tema en lugar de contenerlo. Clink lo descargará de %@. Verás cómo queda antes de guardar nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See NuKey kood viitab teemale, selle asemel et seda sisaldada. Clink laadib selle alla aadressilt %@. Näed, milline see välja näeb, enne kui midagi salvestatakse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code NuKey renvoie à un thème au lieu de le contenir. Clink le téléchargera depuis %@. Vous verrez son apparence avant que quoi que ce soit ne soit enregistré."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a NuKey-kód egy témára hivatkozik, nem tartalmazza azt. A Clink innen tölti le: %@. Mentés előtt látni fogod, hogyan néz ki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice NuKey rimanda a un tema invece di contenerlo. Clink lo scaricherà da %@. Vedrai com'è prima che venga salvato qualcosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このNuKeyコードはテーマそのものではなく、テーマへのリンクです。Clinkは%@からダウンロードします。保存する前に見た目を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 NuKey 코드에는 테마가 아니라 테마 링크가 들어 있습니다. Clink가 %@에서 내려받습니다. 저장하기 전에 어떤 모습인지 확인할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod NuKey ini memaut kepada tema, bukan mengandunginya. Clink akan memuat turunnya daripada %@. Anda akan melihat rupanya sebelum apa-apa disimpan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código do NuKey aponta para um tema em vez de contê-lo. O Clink vai baixá-lo de %@. Você verá como ele fica antes de salvar qualquer coisa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот код NuKey ведёт к теме, а не содержит её. Clink загрузит её с %@. Вы увидите, как она выглядит, прежде чем что-то сохранится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 NuKey 码指向一个主题，而不是包含主题本身。Clink 将从 %@ 下载。保存前你可以先看到效果。"
          }
        }
      }
    },
    "This action requires a user tap or Full Access.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
