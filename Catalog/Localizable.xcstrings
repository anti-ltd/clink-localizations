          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En språktast ved siden av mellomromstasten: trykk for å bytte, hold for å velge (separat modus)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kielinäppäin välilyönnin vieressä: napauta vaihtaaksesi, pidä painettuna valitaksesi (erillinen tila)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
