    "Transform edits the captured draft in place. Replace leads.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Umwandeln“ bearbeitet den erfassten Entwurf direkt. „Ersetzen“ macht das."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformar edita el borrador capturado ahí mismo. Con Reemplazar lo cambias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformer modifie le brouillon capturé sur place. Remplacement en tête."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Átalakítás a rögzített piszkozatot szerkeszti a helyén. A Csere a fő gomb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma modifica la bozza direttamente. Di solito sostituisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「変換」はキャプチャしたドラフトをその場で直します。「置換」が先に出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환은 캡처한 초안을 그 자리에서 고쳐요. 교체로 이어져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transform edit draf yang ditangkap terus di tempatnya. Replace yang utama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformar edita o rascunho capturado no próprio sítio. Substituir fica em primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Преобразовать» правит захваченный черновик на месте. «Заменить» идёт первым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「转换」会直接在原地改你捕获到的草稿。对应「替换」。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teisenda muudab tabatud mustandit kohapeal. Asenda juhib."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transformeer wysig die vasgelegde konsep in plek. Vervang leidrade."
          }
        }
      }
    },
