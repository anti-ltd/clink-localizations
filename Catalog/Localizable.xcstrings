    "When you transform a selection, send the whole text too so the edit fits in.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer jy 'n seleksie verander, stuur ook die hele teks sodat die wysiging inpas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine Auswahl umwandelst, schick auch den ganzen Text mit, damit die Änderung reinpasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando transformas una selección, envía también todo el texto para que la edición encaje."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui sa valikut teisendad, saada kaasa kogu tekst, et muudatus sobituks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand tu transformes une sélection, envoie aussi tout le texte pour que la modification s'y intègre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor átalakítasz egy kijelölést, küldd el a teljes szöveget is, hogy a szerkesztés beleilljen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando trasformi una selezione, invia anche tutto il testo così la modifica si inserisce bene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択部分を変換するとき、文章全体も一緒に送って、手直しがまわりに合うようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 항목을 변환할 때 전체 텍스트도 보내서 수정이 잘 맞게 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila anda transform satu pilihan, hantar keseluruhan teks juga supaya suntingan sesuai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando transformas uma seleção, envia também o texto todo para a edição encaixar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При работе с выделением передавать и весь текст, чтобы правка вписалась."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你转换一个选区时，把整段文本也一起发送，让修改能贴合进去。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când transformați o selecție, trimiteți și tot textul, astfel încât editarea să se potrivească."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer u een selectie transformeert, verzendt u ook de hele tekst, zodat de bewerking erin past."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當你轉換一個選區時，把整段文字也一起傳送，讓修改能貼合進去。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy przekształcasz zaznaczenie, wyślij także cały tekst, aby edycja się zmieściła."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ви трансформуєте виділення, надішліть також увесь текст, щоб редагування відповідало."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir seçimi dönüştürdüğünüzde, düzenlemenin uyum sağlaması için metnin tamamını da gönderin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když transformujete výběr, pošlete také celý text, aby se úprava vešla."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď transformujete výber, pošlite aj celý text, aby sa úprava zmestila."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν μετασχηματίζετε μια επιλογή, στείλτε επίσης ολόκληρο το κείμενο, ώστε να ταιριάζει η επεξεργασία."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du omvandlar ett urval, skicka hela texten också så att redigeringen passar in."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du transformerer en markering, skal du også sende hele teksten, så redigeringen passer ind."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du forvandler et utvalg, sender du også hele teksten slik at redigeringen passer inn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun muutat valintaa, lähetä myös koko teksti, jotta muokkaus sopii."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Anda mengubah pilihan, kirimkan juga seluruh teks agar hasil editnya sesuai."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn chuyển đổi vùng chọn, hãy gửi toàn bộ văn bản để chỉnh sửa phù hợp."
          }
        }
      }
    },
    "When you transform a selection, the whole text is sent to the model too so the edit fits in. Also toggleable from the keyboard's AI Tools options.": {
      "extractionState": "stale",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer jy 'n seleksie transformeer, word die hele teks ook na die model gestuur sodat die wysiging inpas. Ook wisselbaar vanaf die sleutelbord se KI Tools opsies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine Auswahl umwandelst, wird auch der ganze Text an das Modell geschickt, damit die Änderung reinpasst. Lässt sich auch in den KI-Werkzeuge-Optionen der Tastatur umschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando transformas una selección, también se envía todo el texto al modelo para que la edición encaje. También se puede activar desde las opciones de Herramientas de IA del teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui sa valikut teisendad, saadetakse ka kogu tekst mudelile, et muudatus sobituks. Lülitatav ka klaviatuuri TI-tööriistade valikutest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand tu transformes une sélection, tout le texte est aussi envoyé au modèle pour que la modification s'y intègre. Activable aussi depuis les options Outils IA du clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor átalakítasz egy kijelölést, a teljes szöveg is elmegy a modellhez, hogy a szerkesztés beleilljen. A billentyűzet MI-eszközök beállításai közt is kapcsolható."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando trasformi una selezione, tutto il testo viene inviato anche al modello così la modifica si inserisce bene. Attivabile anche dalle opzioni Strumenti AI della tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択部分を変換するとき、文章全体もモデルに送られて、手直しがまわりに合うようにします。キーボードの AI ツールのオプションからも切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 항목을 변환할 때 전체 텍스트도 모델에 보내서 수정이 잘 맞게 해요. 키보드의 AI 도구 옵션에서도 켜고 끌 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila anda transform satu pilihan, keseluruhan teks turut dihantar ke model supaya suntingan sesuai. Juga boleh ditogol dari pilihan Alat AI papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando transformas uma seleção, o texto todo também é enviado ao modelo para a edição encaixar. Também podes ligar/desligar nas opções de Ferramentas de IA do teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При работе с выделением модели передаётся и весь текст, чтобы правка вписалась. Переключается и в настройках «Инструментов ИИ» на клавиатуре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你转换一个选区时，整段文本也会一起发给模型，让修改贴合进去。也可以在键盘的 AI 工具选项里开关。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când transformați o selecție, întregul text este trimis și către model, astfel încât editarea să se potrivească. De asemenea, poate fi comutată din opțiunile Instrumente AI ale tastaturii."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer u een selectie transformeert, wordt de hele tekst ook naar het model verzonden, zodat de bewerking erin past. Ook schakelbaar via de AI Tools-opties van het toetsenbord."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當你轉換一個選區時，整段文字也會一起發給模型，讓修改貼合進去。也可以在鍵盤的 AI 工具選項裡開關。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy przekształcasz zaznaczenie, cały tekst jest również wysyłany do modelu, tak aby edycja się zmieściła. Można to również przełączać za pomocą opcji narzędzi AI na klawiaturze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ви трансформуєте виділення, весь текст також надсилається до моделі, щоб редагування вписалося в нього. Також можна перемикати з параметрів AI Tools на клавіатурі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir seçimi dönüştürdüğünüzde, düzenlemenin uyum sağlaması için metnin tamamı da modele gönderilir. Ayrıca klavyenin AI Tools seçeneklerinden de değiştirilebilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když transformujete výběr, celý text se také odešle do modelu, takže úprava zapadne. Lze také přepínat z možností AI Tools na klávesnici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď transformujete výber, do modelu sa odošle aj celý text, takže úprava zapadne. Dá sa prepínať aj z možností nástrojov AI na klávesnici."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν μετασχηματίζετε μια επιλογή, ολόκληρο το κείμενο αποστέλλεται επίσης στο μοντέλο, ώστε να ταιριάζει η επεξεργασία. Επίσης, με δυνατότητα εναλλαγής από τις επιλογές AI Tools του πληκτρολογίου."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du transformerar ett urval skickas hela texten till modellen också så att redigeringen passar in. Går även att växla från tangentbordets AI-verktygsalternativ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du transformerer en markering, sendes hele teksten også til modellen, så redigeringen passer ind. Kan også skiftes fra tastaturets AI Tools-indstillinger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du transformerer et utvalg, sendes hele teksten til modellen også slik at redigeringen passer inn. Kan også byttes fra tastaturets AI Tools-alternativer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun muunnat valinnan, koko teksti lähetetään myös malliin, jotta muokkaus mahtuu mukaan. Voidaan myös vaihtaa näppäimistön AI Tools -asetuksista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Anda mengubah pilihan, seluruh teks juga dikirim ke model sehingga pengeditannya sesuai. Juga dapat diubah dari opsi Alat AI pada keyboard."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn chuyển đổi một lựa chọn, toàn bộ văn bản cũng được gửi đến mô hình để chỉnh sửa phù hợp. Bạn cũng có thể chuyển đổi từ các tùy chọn Công cụ AI của bàn phím."
          }
        }
      }
    },
