    "Metal keys use their finish, so key colors won't show. Glyph and outline colors still apply.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Metaalsleutels gebruik hul afwerking, so sleutelkleure sal nie wys nie. Glyph- en buitelynkleure geld steeds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal-Tasten benutzen ihr eigenes Finish, deshalb greifen Tastenfarben hier nicht. Zeichen- und Konturfarben schon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas Metal usan su propio acabado, así que el color de tecla no se ve. Los colores de glifo y contorno sí se aplican."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Metallist klahvid kasutavad oma viimistlust, seega klahvivärve ei näidata. Sümboli ja kontuuri värvid kehtivad ikka."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches Metal gardent leur finition, la couleur de touche ne s’affiche donc pas. Les couleurs de symbole et de contour, si."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Metal billentyűk a saját felületüket használják, ezért a billentyűszín nem látszik. A jel és a körvonal színe viszont igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti Metal usano la loro finitura, quindi il colore del tasto non si vede. I colori di simbolo e contorno funzionano lo stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal のキーは独自の質感を使うため、キーの色は反映されません。文字とアウトラインの色は反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal 키는 고유한 질감을 쓰기 때문에 키 색상은 나타나지 않아요. 글자와 윤곽선 색상은 그대로 적용돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci Metal guna kemasannya sendiri, jadi warna kekunci takkan kelihatan. Warna glif dan garis luar masih berfungsi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas Metal usam o seu próprio acabamento, por isso a cor da tecla não aparece. As cores de glifo e contorno continuam a aplicar-se."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Металлические клавиши используют своё покрытие, поэтому цвета клавиш не видны. Цвета символов и контура по-прежнему работают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal 按键使用自身的材质效果，所以按键颜色不会显示。字符和描边颜色仍然有效。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheile metalice își folosesc finisajul, astfel încât culorile cheie nu se vor afișa. Culorile pentru glif și contur se aplică în continuare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Metalen toetsen hebben hun afwerking, zodat de toetskleuren niet zichtbaar zijn. Glyph- en omtrekkleuren zijn nog steeds van toepassing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal 按鍵使用自身的材質效果，所以按鍵顏色不會顯示。字元和描邊顏色仍然有效。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Metalowe klucze mają swoje wykończenie, więc kolory klawiszy nie będą widoczne. Kolory glifów i konturów nadal obowiązują."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Металеві ключі використовують свою обробку, тому кольори клавіш не відображатимуться. Кольори гліфів і контуру все ще застосовуються."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal tuşlar kaplamalarını kullandığından tuş renkleri görünmez. Glif ve anahat renkleri hala geçerlidir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kovové klávesy mají svou povrchovou úpravu, takže barvy kláves se nezobrazují. Barvy glyfů a obrysů stále platí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kovové klávesy používajú svoju povrchovú úpravu, takže farby kláves sa nezobrazia. Farby glyfov a obrysov stále platia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μεταλλικά πλήκτρα χρησιμοποιούν το φινίρισμά τους, έτσι τα χρώματα των πλήκτρων δεν θα εμφανίζονται. Τα χρώματα γλυφών και περιγράμματος εξακολουθούν να ισχύουν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Metallnycklar använder sin finish, så nyckelfärger visas inte. Glyf- och konturfärger gäller fortfarande."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Metalnøgler bruger deres finish, så nøglefarverne vises ikke. Glyffer og konturfarver gælder stadig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Metallnøkler bruker sin finish, så nøkkelfarger vises ikke. Glyf- og konturfarger gjelder fortsatt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Metalliset avaimet käyttävät viimeistelyään, joten avainten värit eivät näy. Glyph- ja ääriviivavärit ovat edelleen voimassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci logam menggunakan lapisan akhir, sehingga warna kunci tidak akan terlihat. Warna mesin terbang dan garis luar masih berlaku."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím kim loại được hoàn thiện nên các màu chính sẽ không hiển thị. Màu glyph và đường viền vẫn được áp dụng."
          }
        }
      }
    },
