    "\"%@\" won't be suggested again unless you type it twice.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" sal nie weer voorgestel word nie, tensy jy dit twee keer tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird nicht mehr vorgeschlagen, es sei denn, du tippst es zweimal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” no volverá a sugerirse a menos que lo escribas dos veces."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ei soovitata enam, kui just ei tippi seda kaks korda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne sera plus suggéré, sauf si tu le tapes deux fois."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ többé nem lesz felajánlva, hacsak nem gépeled be kétszer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non verrà più suggerito, a meno che non lo digiti due volte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は、2回入力しない限り今後提案されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」은(는) 두 번 입력하지 않는 한 다시 제안되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” tidak akan dicadangkan lagi melainkan anda menaipnya dua kali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não voltará a ser sugerido, a menos que o escreva duas vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» больше не будет предлагаться, пока вы не наберёте его дважды."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 将不再被建议，除非您再次输入两次。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nu va fi sugerat din nou decât dacă îl tastați de două ori."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" wordt niet opnieuw voorgesteld, tenzij u het twee keer typt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 將不再被建議，除非您再次輸入兩次。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nie zostanie ponownie zasugerowany, chyba że wpiszesz go dwukrotnie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" не буде запропоновано знову, якщо ви не введете його двічі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki kez yazmadığınız sürece \"%@\" bir daha önerilmez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ nebude znovu navrženo, pokud jej nezadáte dvakrát."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ sa znova nenavrhne, pokiaľ ho nezadáte dvakrát."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το \"%@\" δεν θα προταθεί ξανά εκτός και αν το πληκτρολογήσετε δύο φορές."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" kommer inte att föreslås igen om du inte skriver det två gånger."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" vil ikke blive foreslået igen, medmindre du skriver det to gange."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" vil ikke bli foreslått igjen med mindre du skriver det to ganger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ei ehdoteta uudelleen, ellet kirjoita sitä kahdesti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" tidak akan disarankan lagi kecuali Anda mengetiknya dua kali."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" sẽ không được đề xuất lại trừ khi bạn nhập hai lần."
          }
        }
      }
    },
