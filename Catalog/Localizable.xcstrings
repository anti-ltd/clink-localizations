          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto l'emoji per sentirlo. Trascina i segni per cambiare la durata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵文字を長押しすると体感できます。目盛りをドラッグすると長さを変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이모지를 꾹 눌러 보세요. 눈금을 끌면 길이를 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan emoji untuk merasainya. Seret tanda untuk ubah tempohnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o emoji premido para sentires. Arrasta as marcas para mudares a duração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержите эмодзи, чтобы почувствовать. Двигайте метки, чтобы изменить длительность."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住表情就能体验。拖动刻度可以改时长。"
          }
        }
      }
    },
    "Hold the globe key, switch to another keyboard and back, so Clink reloads.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou die aardbolsleutel vas, skakel oor na 'n ander sleutelbord en terug, sodat Clink herlaai."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Globustaste, wechsle zu einer anderen Tastatur und wieder zurück, damit Clink neu lädt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la tecla del globo, cambia a otro teclado y vuelve, para que Clink se recargue."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia gloobusklahvi, vaheta teisele klaviatuurile ja tagasi, et Clink uuesti laadiks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens la touche globe, passe à un autre clavier puis reviens : Clink se recharge."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd nyomva a földgömb gombot, válts át másik billentyűzetre, majd vissza, hogy a Clink újratöltsön."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto il tasto globo, passa a un'altra tastiera e torna indietro, così Clink si ricarica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地球儀キーを長押しして別のキーボードに切り替え、また戻します。これでClinkが読み込み直されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지구본 키를 길게 눌러 다른 키보드로 갔다가 돌아오면 Clink가 다시 불러옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan kekunci globe, tukar ke papan kekunci lain dan kembali, supaya Clink dimuat semula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a tecla do globo premida, muda para outro teclado e volta, para o Clink recarregar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержите клавишу глобуса, переключитесь на другую клавиатуру и обратно, чтобы Clink перезагрузился."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住地球键，切到别的键盘再切回来，Clink 就会重新加载。"
          }
        }
      }
    },
