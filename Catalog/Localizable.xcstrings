    "Steps in on the corrections the keyboard isn't sure about, so the close calls land right more often.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stap in op die regstellings waaroor die sleutelbord nie seker is nie, so die close calls land meer gereeld reg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Greift bei Korrekturen ein, bei denen sich die Tastatur unsicher ist, damit knappe Fälle öfter richtig landen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Echa una mano en las correcciones de las que el teclado no está seguro, para que los casos dudosos acierten más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekkab parandustesse, mille suhtes klaviatuur pole kindel, nii et kahtlased juhtumid tabavad sagedamini õigesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne un coup de main sur les corrections dont le clavier n'est pas sûr, pour que les cas limites tombent juste plus souvent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Besegít azoknál a javításoknál, amikben a billentyűzet nem biztos, így a bizonytalan esetek gyakrabban lesznek helyesek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interviene sulle correzioni di cui la tastiera non è sicura, così i casi incerti vanno a buon fine più spesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードが迷っている修正に手を貸して、際どいものもより正しく直るようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 긴가민가하는 수정에 끼어들어서, 애매한 경우를 더 자주 제대로 맞춰요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Campur tangan bila papan kekunci tak pasti dengan pembetulan, supaya keputusan rapat lebih kerap betul."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra em ação nas correções sobre as quais o teclado não tem a certeza, para que os casos duvidosos acertem mais vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вмешивается там, где клавиатура не уверена в исправлении, чтобы спорные случаи чаще решались верно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘拿不准的更正上多帮一把，让那些没把握的情况更常改对。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți un pas asupra corecțiilor despre care tastatura nu este sigură, așa că apelurile apropiate ajung mai des."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voert de correcties uit waar het toetsenbord niet zeker van is, zodat de close calls vaker goed terechtkomen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鍵盤拿不準的更正上多幫一把，讓那些沒把握的情況更常改對。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadza poprawki, co do których klawiatura nie jest pewna, więc bliskie połączenia częściej trafiają w prawo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Втручається в ті виправлення, у яких клавіатура не впевнена, тому виклики «закриття» частіше потрапляють правильно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyenin emin olmadığı düzeltmelere adım atın, böylece yakın çağrılar daha sık gerçekleşir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasahuje do korekcí, kterými si klávesnice není jistá, takže zavřené hovory dopadnou častěji."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps in on the corrections the keyboard isn't sure about, so the close calls land right more often."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι διορθώσεις για τις οποίες το πληκτρολόγιο δεν είναι σίγουρο για τις διορθώσεις, επομένως οι κλήσεις κλεισίματος γίνονται πιο συχνά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Går in på korrigeringarna som tangentbordet inte är säker på, så de nära samtalen landar rätt oftare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Går ind på de rettelser, tastaturet ikke er sikker på, så de tætte opkald lander rigtigt oftere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Går inn på rettelsene tastaturet ikke er sikker på, så de nærgående samtalene lander riktig oftere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettelee korjauksiin, joista näppäimistö ei ole varma, joten läheiset puhelut osuvat oikeaan useammin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melakukan koreksi yang tidak diketahui secara pasti oleh keyboard, sehingga panggilan akrab lebih sering terjadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bước sửa lỗi mà bàn phím không chắc chắn sẽ xảy ra, do đó lệnh gọi đóng sẽ xảy ra thường xuyên hơn."
          }
        }
      }
    },
