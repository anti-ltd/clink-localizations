    "Needs Bloom. Turn it up above.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Benodig Bloei. Draai dit op bo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benötigt Bloom. Dreh es oben auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere Bloom: actívalo arriba."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajab Bloomi. Suurenda seda ülalpool."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite Bloom. Augmente-le ci-dessus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom szükséges hozzá. Tekerd fel fentebb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede Bloom: aumentalo qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブルームが必要です。上でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "블룸이 필요합니다. 위에서 켜 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memerlukan Bloom. Naikkannya di atas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer Bloom. Aumente-o acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно «Свечение». Прибавьте его выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要开启 Bloom，请在上方调高。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Are nevoie de Bloom. Întoarce-l mai sus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft bloei nodig. Draai het hierboven omhoog."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要開啟 Bloom，請在上方調高。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebuje Blooma. Włącz to powyżej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потребує Блума. Підніміть вище."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom'a ihtiyacı var. Yukarıya çevir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potřebuje Bloom. Otočte to výše."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebuje Bloom. Otočte to hore."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρειάζεται Bloom. Γυρίστε το παραπάνω."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behöver Bloom. Vrid upp det ovan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trænger til Bloom. Skru den op ovenfor."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenger Bloom. Skru den opp ovenfor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarvitsee Bloomin. Käännä se ylös."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membutuhkan Bloom. Naikkan ke atas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần Hoa. Bật nó lên ở trên."
          }
        }
      }
    },
