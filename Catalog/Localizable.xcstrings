        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На anti.ltd откройте Аккаунт → Связанные приложения и введите этот код."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Di anti.ltd, buka Akaun → Aplikasi terpaut dan masukkan kod ini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az anti.ltd oldalon nyisd meg a Fiók → Kapcsolt alkalmazások menüt, és add meg ezt a kódot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "anti.ltdで「アカウント」→「連携アプリ」を開き、このコードを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 anti.ltd 上打开“账户”→“已关联的应用”，然后输入此验证码。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "anti.ltd에서 계정 → 연결된 앱을 열고 이 코드를 입력해 주세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava anti.ltd lehel Konto → Seotud rakendused ja sisesta see kood."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe anti.ltd, deschide Cont → Aplicații asociate și introdu acest cod."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open op anti.ltd Account → Gekoppelde apps en voer deze code in."
          }
        },
        "zh-Hant": {
          "stringUnit": {
