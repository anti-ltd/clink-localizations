    "Memory use, keyboard restarts and test timings from this iPhone. Never anything you typed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso de memoria, reinicios del teclado y tiempos de las pruebas de este iPhone. Nunca nada de lo que hayas escrito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémoire utilisée, redémarrages du clavier et temps des tests sur cet iPhone. Jamais ce que tu as tapé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichernutzung, Tastatur-Neustarts und Testzeiten von diesem iPhone. Nie etwas, das du getippt hast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso della memoria, riavvii della tastiera e tempi dei test di questo iPhone. Mai nulla di ciò che hai scritto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilização de memória, reinícios do teclado e tempos dos testes deste iPhone. Nunca nada do que escreveste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использование памяти, перезапуски клавиатуры и время тестов с этого iPhone. Никогда ничего из того, что вы вводили."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penggunaan memori, mula semula papan kekunci dan masa ujian daripada iPhone ini. Bukan apa-apa yang anda taip."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Memóriahasználat, a billentyűzet újraindulásai és a tesztek időadatai erről az iPhone-ról. Soha semmi, amit begépeltél."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone のメモリ使用量、キーボードの再起動、テストの所要時間。入力した内容は一切含まれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 的内存占用、键盘重启和测试耗时。绝不包含你输入的任何内容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 메모리 사용량, 키보드 재시작 횟수, 테스트 소요 시간. 입력한 내용은 절대 포함되지 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle iPhone’i mälukasutus, klaviatuuri taaskäivitused ja testide ajad. Mitte kunagi midagi, mida sa kirjutasid."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizarea memoriei, repornirea tastaturii și timpii de testare de pe acest iPhone. Niciodată nimic din ce ai tastat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geheugengebruik, opnieuw opstarten van het toetsenbord en testtijden van deze iPhone. Nooit iets dat je hebt getypt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 的記憶體佔用、鍵盤重啟和測試耗時。絕不包含你輸入的任何內容。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geheuegebruik, sleutelbordherbeginnings en toetstye vanaf hierdie iPhone. Nooit enigiets wat jy getik het nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użycie pamięci, ponowne uruchomienie klawiatury i testowanie czasów z tego iPhone'a. Nigdy nic, co wpisałeś."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використання пам’яті, перезавантаження клавіатури та час тестування з цього iPhone. Ніколи нічого, що ви ввели."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone'daki bellek kullanımı, klavye yeniden başlatmaları ve test zamanlamaları. Asla yazdığınız hiçbir şey."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Využití paměti, restartování klávesnice a testovací časování z tohoto iPhone. Nikdy nic, co jsi napsal."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Využitie pamäte, reštartovanie klávesnice a testovanie na tomto iPhone. Nikdy nič, čo ste napísali."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρήση μνήμης, επανεκκινήσεις πληκτρολογίου και δοκιμή χρονισμών από αυτό το iPhone. Ποτέ τίποτα που πληκτρολογήσατε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minnesanvändning, tangentbordsomstarter och testtider från denna iPhone. Aldrig något du skrivit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hukommelsesbrug, tastaturgenstarter og testtidspunkter fra denne iPhone. Aldrig noget du har skrevet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Minnebruk, omstart av tastatur og testtid fra denne iPhone. Aldri noe du har skrevet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistin käyttö, näppäimistön uudelleenkäynnistykset ja testiajoitukset tästä iPhonesta. Ei koskaan mitään kirjoittamaasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penggunaan memori, pengaktifan ulang keyboard, dan pengaturan waktu pengujian dari iPhone ini. Tidak pernah apa pun yang Anda ketik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng bộ nhớ, khởi động lại bàn phím và kiểm tra thời gian từ iPhone này. Không bao giờ bất cứ điều gì bạn gõ."
          }
        }
      }
    },
    "No tests have been run yet, so only the restart and memory history goes with it. Run the tests in Beta Lab for the full picture.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se han hecho pruebas, así que solo se envía el historial de reinicios y memoria. Haz las pruebas en el Laboratorio beta para tener la imagen completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun test n’a encore été lancé : seul l’historique des redémarrages et de la mémoire sera joint. Lance les tests dans le Labo bêta pour une vue complète."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurden noch keine Tests ausgeführt, also geht nur der Verlauf von Neustarts und Speicher mit. Führ die Tests im Beta-Labor aus, um das ganze Bild zu senden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora eseguito test, quindi viene inviata solo la cronologia di riavvii e memoria. Esegui i test in Beta Lab per il quadro completo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foram feitos testes, por isso só segue o histórico de reinícios e memória. Faz os testes no Laboratório beta para teres o quadro completo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тесты ещё не запускались, поэтому будет отправлена только история перезапусков и памяти. Запустите тесты в Бета-лаборатории, чтобы получить полную картину."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada ujian dijalankan, jadi hanya sejarah mula semula dan memori yang dihantar. Jalankan ujian dalam Makmal Beta untuk gambaran penuh."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nem futtattál tesztet, ezért csak az újraindulások és a memória előzményei mennek vele. Futtasd a teszteket a Béta laborban a teljes képért."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだテストを実行していないため、再起動とメモリの履歴のみ送信されます。全体を把握するにはベータラボでテストを実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未运行测试，因此只会附上重启和内存记录。在 Beta 实验室运行测试可获得完整信息。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 테스트를 실행하지 않아 재시작 및 메모리 기록만 함께 보내집니다. 전체 정보를 보내려면 베타 실험실에서 테스트를 실행하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste pole veel tehtud, nii et kaasa läheb ainult taaskäivituste ja mälu ajalugu. Täieliku pildi saamiseks tee testid Beetalaboris."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu au fost efectuate teste, așa că doar repornirea și istoricul memoriei merg cu el. Rulați testele în Beta Lab pentru o imagine completă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn nog geen tests uitgevoerd, dus alleen het opnieuw opstarten en de geheugengeschiedenis horen erbij. Voer de tests uit in Beta Lab voor een volledig beeld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未執行測試，因此只會附上重啟和記憶體記錄。在 Beta 實驗室執行測試可獲得完整資訊。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toetse is nog uitgevoer nie, so slegs die herbegin- en geheuegeskiedenis word saamgestuur. Voer die toetse in Beta Lab uit vir die volledige prentjie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie przeprowadzono jeszcze żadnych testów, więc dotyczy to tylko ponownego uruchomienia i historii pamięci. Aby uzyskać pełny obraz, przeprowadź testy w Beta Lab."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодних тестів ще не проводилося, тому з ним йде лише перезапуск і історія пам’яті. Виконайте тести в Beta Lab, щоб отримати повну картину."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz hiçbir test yapılmadığından yalnızca yeniden başlatma ve hafıza geçmişi onunla birlikte gider. Resmin tamamını görmek için testleri Beta Lab'da çalıştırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nebyly spuštěny žádné testy, takže s tím jde pouze restart a historie paměti. Pro úplný obrázek spusťte testy v Beta Lab."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ neboli spustené žiadne testy, takže ide iba o reštart a históriu pamäte. Pre úplný obraz spustite testy v Beta Lab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχουν εκτελεστεί ακόμη δοκιμές, επομένως συνοδεύεται μόνο από την επανεκκίνηση και το ιστορικό μνήμης. Εκτελέστε τις δοκιμές στο Beta Lab για την πλήρη εικόνα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga tester har körts än, så bara omstarten och minneshistoriken följer med. Kör testerna i Beta Lab för hela bilden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen test er blevet kørt endnu, så kun genstart og hukommelseshistorik følger med. Kør testene i Beta Lab for at få det fulde billede."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tester er kjørt ennå, så bare omstart og minnehistorikk følger med. Kjør testene i Beta Lab for å få hele bildet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Testejä ei ole vielä ajettu, joten vain uudelleenkäynnistys ja muistihistoria kulkevat mukana. Suorita testit Beta Labissa saadaksesi koko kuvan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada pengujian yang dijalankan, jadi hanya restart dan riwayat memori yang menyertainya. Jalankan pengujian di Beta Lab untuk gambaran lengkap."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có thử nghiệm nào được thực hiện nên chỉ có lịch sử khởi động lại và bộ nhớ đi kèm với nó. Chạy thử nghiệm trong Beta Lab để có bức tranh toàn cảnh."
          }
        }
      }
    },
    "What you send is private. If it becomes a card on the public board, the team writes that card and leaves out anything personal.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que envías es privado. Si se convierte en una tarjeta del tablero público, el equipo la redacta y deja fuera todo lo personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tu envoies reste privé. Si ça devient une fiche sur le tableau public, l’équipe la rédige et retire tout ce qui est personnel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du sendest, bleibt privat. Wird daraus eine Karte auf dem öffentlichen Board, schreibt das Team sie selbst und lässt alles Persönliche weg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che invii è privato. Se diventa una scheda nella bacheca pubblica, il team la scrive e lascia fuori tutto ciò che è personale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que envias é privado. Se passar a cartão no quadro público, a equipa escreve-o e deixa de fora tudo o que for pessoal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, что вы отправляете, остаётся приватным. Если из этого появится карточка на общей доске, команда напишет её сама и уберёт всё личное."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang anda hantar adalah peribadi. Jika ia menjadi kad di papan awam, pasukan akan menulis kad itu dan meninggalkan apa-apa yang bersifat peribadi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amit küldesz, az privát. Ha kártya lesz belőle a nyilvános táblán, azt a csapat írja meg, és kihagy belőle minden személyeset."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信した内容は非公開です。公開ボードのカードになる場合は、チームが内容を書き起こし、個人的な情報は含めません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你发送的内容是私密的。如果它成为公开看板上的卡片，团队会重新撰写，并略去任何个人信息。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보낸 내용은 비공개입니다. 공개 보드의 카드가 되면 팀이 직접 작성하며 개인적인 내용은 모두 뺍니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See, mida saadad, jääb privaatseks. Kui sellest saab avaliku tahvli kaart, kirjutab meeskond selle ise ja jätab isikliku välja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceea ce trimiteți este privat. Dacă devine o carte pe tabla publică, echipa scrie acel card și omite orice lucru personal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat u verzendt, is privé. Als het een kaart op het openbare bord wordt, schrijft het team die kaart en laat alles wat persoonlijk is achterwege."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你傳送的內容是私密的。如果它成為公開看板上的卡片，團隊會重新撰寫，並略去任何個人資訊。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat jy stuur, is privaat. Indien dit 'n kaartjie op die openbare bord word, stel die span daardie kaartjie op en laat enige persoonlike inligting weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co wysyłasz, jest prywatne. Jeśli stanie się to kartą na tablicy publicznej, zespół zapisuje tę kartę i pomija wszelkie informacje osobiste."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що ви надсилаєте, є приватним. Якщо це стає карткою на загальнодоступній дошці, команда записує цю картку та пропускає все особисте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderdikleriniz özeldir. Eğer bu, genel panoda bir kart haline gelirse, ekip o kartı yazar ve kişisel herhangi bir şeyi dışarıda bırakır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co posíláte, je soukromé. Pokud se stane kartou na veřejné desce, tým tuto kartu zapíše a vynechá cokoliv osobního."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "To, čo posielate, je súkromné. Ak sa stane kartou na verejnej tabuli, tím túto kartu zapíše a vynechá čokoľvek osobné."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό που στέλνετε είναι ιδιωτικό. Αν γίνει κάρτα στον δημόσιο πίνακα, η ομάδα γράφει αυτή την κάρτα και αφήνει έξω οτιδήποτε προσωπικό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du skickar är privat. Om det blir ett kort på den offentliga styrelsen skriver laget det kortet och utelämnar allt personligt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du sender er privat. Hvis det bliver et kort på den offentlige bestyrelse, skriver holdet det kort og udelader alt personligt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du sender er privat. Hvis det blir et kort på det offentlige styret, skriver laget det kortet og utelater noe personlig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettämäsi on yksityistä. Jos siitä tulee kortti julkisella taululla, joukkue kirjoittaa sen ja jättää pois mitään henkilökohtaista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang Anda kirim bersifat pribadi. Jika kartu tersebut menjadi sebuah kartu di papan umum, tim akan menulis kartu tersebut dan tidak memasukkan hal-hal yang bersifat pribadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì bạn gửi là riêng tư. Nếu nó trở thành một tấm thẻ trên bảng công cộng, đội sẽ viết tấm thẻ đó và bỏ đi những thông tin cá nhân."
          }
        }
      }
    },
    "What happened, and what did you expect? Which app were you typing in?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué ha pasado y qué esperabas? ¿En qué app estabas escribiendo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que s’est-il passé, et à quoi t’attendais-tu ? Dans quelle app tapais-tu ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist passiert, und was hast du erwartet? In welcher App hast du getippt?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cos’è successo e cosa ti aspettavi? In quale app stavi scrivendo?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que aconteceu e o que esperavas? Em que app estavas a escrever?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что произошло и чего вы ожидали? В каком приложении вы печатали?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang berlaku, dan apa yang anda jangkakan? Anda menaip dalam app apa?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi történt, és mire számítottál? Melyik appban gépeltél?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何が起きて、本来どうなるはずでしたか？どのアプリで入力していましたか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发生了什么？你原本期望怎样？当时在哪个 App 里输入？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무슨 일이 있었고 원래 어떻게 되길 기대했나요? 어떤 앱에서 입력하고 있었나요?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis juhtus ja mida sa ootasid? Millises äpis sa kirjutasid?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce s-a întâmplat și la ce te așteptai? În ce aplicație ai tastat?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat is er gebeurd en wat had je verwacht? In welke app was je aan het typen?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發生了什麼？你原本期望怎樣？當時在哪個 App 裡輸入？"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat het gebeur en wat het jy verwag? In watter toepassing het jy getik?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co się stało i czego się spodziewałeś? W jakiej aplikacji pisałeś?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що сталося і чого ви очікували? У якому додатку ви вводили текст?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne oldu ve ne bekliyordun? Hangi uygulamayı yazıyordunuz?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co se stalo a co jste očekávali? V jaké aplikaci jste psali?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čo sa stalo a čo ste očakávali? V ktorej aplikácii ste písali?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι συνέβη και τι περιμένατε; Σε ποια εφαρμογή πληκτρολογούσες;"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad hände och vad förväntade du dig? Vilken app skrev du i?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad skete der, og hvad forventede du? Hvilken app skrev du i?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva skjedde, og hva forventet du? Hvilken app skrev du inn?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä tapahtui ja mitä odotit? Millä sovelluksella kirjoitit?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang terjadi dan apa yang Anda harapkan? Aplikasi mana yang Anda ketik?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyện gì đã xảy ra và bạn mong đợi điều gì? Bạn đang gõ ứng dụng nào?"
          }
        }
      }
    },
    "What would you like Clink to do, and when would you use it?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué te gustaría que hiciera Clink y cuándo lo usarías?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu’aimerais-tu que Clink fasse, et quand t’en servirais-tu ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was soll Clink können, und wann würdest du es nutzen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa vorresti che facesse Clink, e quando lo useresti?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que gostavas que o Clink fizesse e quando o usarias?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что бы вы хотели, чтобы делал Clink, и когда бы вы этим пользовались?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang anda mahu Clink lakukan, dan bila anda akan menggunakannya?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit csináljon a Clink, és mikor használnád?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink にどんなことをしてほしいですか？どんなときに使いますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你希望 Clink 做什么？你会在什么时候用到？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink가 무엇을 해 주면 좋겠나요? 언제 사용하게 될까요?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mida sa tahaksid, et Clink teeks, ja millal sa seda kasutaksid?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce ați dori să facă Clink și când l-ați folosi?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat wil je dat Clink doet, en wanneer zou je het gebruiken?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你希望 Clink 做什麼？你會在什麼時候用到？"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat wil jy hê moet Clink doen, en wanneer sou jy dit gebruik?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co chciałbyś, aby Clink robił i kiedy byś go używał?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що б ви хотіли, щоб Clink зробив, і коли б ви його використовували?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink'in ne yapmasını istersiniz ve onu ne zaman kullanırsınız?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co byste chtěli, aby Clink dělal a kdy byste jej použili?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čo by ste chceli, aby Clink robil a kedy by ste ho použili?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι θα θέλατε να κάνει το Clink και πότε θα το χρησιμοποιούσατε;"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad skulle du vilja att Clink skulle göra, och när skulle du använda den?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad vil du gerne have Clink til at gøre, og hvornår vil du bruge det?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva vil du at Clink skal gjøre, og når vil du bruke den?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä haluaisit Clink:n tekevän ja milloin käyttäisit sitä?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda ingin Clink melakukan apa, dan kapan Anda akan menggunakannya?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn muốn Clink làm gì và khi nào bạn sẽ sử dụng nó?"
          }
        }
      }
    },
    "Tell us anything.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos lo que quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis-nous tout ce que tu veux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzähl uns, was du möchtest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccontaci quello che vuoi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta-nos o que quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расскажите нам что угодно."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beritahu kami apa sahaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írj bármit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何でもお聞かせください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想说什么都可以。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이든 알려 주세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Räägi meile mida tahes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spune-ne orice."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
