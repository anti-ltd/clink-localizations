    "Jot in any app, drop it in anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skryf enige toepassing in, gooi dit enige plek in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiere in jeder App, füge es überall ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota en cualquier app y suéltalo donde quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee märkmeid igas rakenduses ja sisesta need kuhu iganes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note dans n'importe quelle app, dépose-le où tu veux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jegyzetelj bármelyik appban, illeszd be bárhová."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annota in qualsiasi app, inseriscilo ovunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリでもメモして、どこへでも入れられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 앱에서든 적어 두고, 어디에나 넣으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat dalam mana-mana apl, letakkan di mana-mana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota em qualquer app e larga-o onde quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте в любом приложении и вставляйте куда угодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何应用里记下，随处放入。"
          }
        }
      }
    },
    "Jot text from any app, then drop it wherever you type. Adds a notepad to the panel button.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skryf teks van enige toepassing af en los dit dan waar jy ook al tik. Voeg 'n notaboek by die paneelknoppie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiere Text aus jeder App und setz ihn ein, wo du gerade tippst. Fügt der Panel-Taste einen Notizblock hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota texto desde cualquier app y suéltalo donde escribas. Añade un bloc de notas al botón del panel."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee teksti märkmeid igast rakendusest ja sisesta need sinna, kuhu tipid. Lisab paneelinupule märkmiku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note du texte depuis n'importe quelle app, puis dépose-le là où tu tapes. Ajoute un bloc-notes au bouton du panneau."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jegyzetelj bármelyik appból, aztán dobd be oda, ahol épp gépelsz. Jegyzettömböt tesz a panel gombhoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendi appunti da qualsiasi app, poi incollali dove scrivi. Aggiunge un blocco note al pulsante del pannello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリからでもテキストをメモして、入力したい場所に貼り付けられます。パネルボタンにメモ帳を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 앱에서든 텍스트를 적어 두고, 입력하는 곳 어디에나 붙여넣어요. 패널 버튼에 메모장을 넣어 줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat teks dari mana-mana apl, kemudian letak di mana sahaja anda menaip. Tambah pad nota pada butang panel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota texto a partir de qualquer app e larga-o onde escreveres. Adiciona um bloco de notas ao botão do painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте текст из любого приложения и вставляйте его там, где печатаете. Добавляет блокнот к кнопке панелей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何应用里记点文字，再粘到你要打字的地方。会在面板按钮里加一个记事本。"
          }
        }
      }
    },
