    "Yours for life. Nothing to renew.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für immer deins. Nichts zu verlängern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuyo de por vida. Nada que renovar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À toi à vie. Rien à renouveler."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Örökre a tiéd. Nincs mit megújítani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo per sempre. Niente da rinnovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生涯ご利用いただけます。更新は不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평생 사용할 수 있습니다. 갱신할 것이 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Milik anda seumur hidup. Tiada apa untuk diperbaharui."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu para sempre. Nada para renovar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше навсегда. Продлевать нечего."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终身拥有，无需续订。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu eluaegselt. Midagi uuendada pole."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Joune lewenslank. Niks om te hernu nie."
          }
        }
      }
    },
