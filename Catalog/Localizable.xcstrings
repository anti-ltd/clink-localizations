    "Your letters become a new font of your own. The font you started from isn’t changed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus letras se convierten en una fuente nueva y propia. La fuente de partida no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos lettres deviennent une nouvelle police bien à vous. La police de départ n’est pas modifiée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Buchstaben werden zu einer eigenen, neuen Schrift. Die Ausgangsschrift bleibt unverändert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue lettere diventano un nuovo font tutto tuo. Il font di partenza non viene modificato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas letras viram uma fonte nova, só sua. A fonte de partida não é alterada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши буквы станут вашим собственным новым шрифтом. Исходный шрифт не изменится."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Huruf anda menjadi fon baharu milik anda sendiri. Fon asal tidak diubah."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A betűidből egy saját, új betűtípus lesz. A kiinduló betűtípus nem változik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "描いた文字はあなただけの新しいフォントになります。元のフォントは変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的字母会成为一款属于你的新字体。起始字体不会被更改。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그린 글자는 나만의 새 서체가 됩니다. 시작한 서체는 바뀌지 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu tähtedest saab sinu enda uus font. Lähtefonti ei muudeta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Literele tale devin un nou font al tău. Fontul de la care ați început nu este schimbat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw letters worden een nieuw eigen lettertype. Het lettertype waarmee u bent begonnen, is niet gewijzigd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的字母會成為一款屬於你的新字型。起始字型不會被更改。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou letters word 'n nuwe, eie lettertipe. Die lettertipe waarmee jy begin het, verander nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje litery staną się Twoją nową czcionką. Czcionka, od której zacząłeś, nie ulega zmianie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші літери стають новим власним шрифтом. Шрифт, з якого ви почали, не змінено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mektuplarınız kendinize ait yeni bir yazı tipi haline gelir. Başladığınız yazı tipi değişmedi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše písmena se stanou novým vlastním písmem. Písmo, ze kterého jste začali, se nezměnilo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše písmená sa stanú novým vlastným písmom. Písmo, z ktorého ste začali, sa nezmení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα γράμματά σας γίνονται μια νέα δική σας γραμματοσειρά. Η γραμματοσειρά από την οποία ξεκινήσατε δεν έχει αλλάξει."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina bokstäver blir ett nytt eget typsnitt. Teckensnittet du började från ändras inte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine bogstaver bliver din egen nye skrifttype. Den skrifttype, du startede fra, ændres ikke."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bokstavene dine blir en ny font for deg selv. Skriften du startet fra er ikke endret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjeistäsi tulee uusi oma fonttisi. Fontti, josta aloitit, ei muutu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Surat Anda menjadi font baru Anda sendiri. Font tempat Anda memulai tidak berubah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những bức thư của bạn sẽ trở thành một phông chữ mới của riêng bạn. Phông chữ bạn bắt đầu không thay đổi."
          }
        }
      }
    },
