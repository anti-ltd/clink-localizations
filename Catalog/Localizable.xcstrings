    "One sweep. One word. Two thumbs.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een sweep. Een woord. Twee duime."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wisch. Ein Wort. Zwei Daumen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un desliz. Una palabra. Dos pulgares."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üks pühk. Üks sõna. Kaks pöialt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un balayage. Un mot. Deux pouces."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy húzás. Egy szó. Két hüvelykujj."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gesto. Una parola. Due pollici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとスワイプ。ひとつの言葉。両方の親指。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 스와이프. 한 단어. 두 엄지."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu leret. Satu perkataan. Dua ibu jari."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um deslize. Uma palavra. Dois polegares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один взмах. Одно слово. Два больших пальца."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次滑动。一个词。两枚拇指。"
          }
        }
      }
    },
    "One tap recolors the whole keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een tik herkleur die hele sleutelbord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipp färbt die ganze Tastatur neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque recolorea todo el teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühe puudutusega värvad ümber kogu klaviatuuri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul geste recolore tout le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy koppintás átszínezi az egész billentyűzetet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco ricolora l’intera tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップでキーボード全体の色が変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 탭으로 키보드 전체 색상이 바뀝니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu ketikan mewarnakan semula seluruh papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque recolore o teclado inteiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно нажатие перекрашивает всю клавиатуру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一下即可为整个键盘重新配色。"
          }
        }
      }
    },
