    "Swipe up on the Return key to change language. The keys change with it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Swiep op op die Return-sleutel om taal te verander. Die sleutels verander daarmee saam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streich auf der Eingabetaste nach oben, um die Sprache zu wechseln. Die Tasten wechseln mit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia arriba en la tecla de retorno para cambiar de idioma. Las teclas cambian con él."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viipa sisestusklahvil üles, et keelt vahetada. Klahvid vahetuvad kaasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaie vers le haut sur la touche Retour pour changer de langue. Les touches changent avec elle."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd felfelé az Enteren a nyelvváltáshoz. A billentyűk vele együtt váltanak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri verso l’alto sul tasto Invio per cambiare lingua. I tasti cambiano con lei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リターンキーを上にスワイプすると言語が切り替わります。キーもいっしょに変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Return 키를 위로 쓸어올리면 언어가 바뀝니다. 키도 함께 바뀝니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret ke atas pada kekunci Return untuk menukar bahasa. Kekuncinya bertukar sekali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para cima na tecla Return para mudar de idioma. As teclas mudam com ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните вверх по клавише Return, чтобы сменить язык. Клавиши поменяются вместе с ним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Return 键上向上轻扫即可切换语言，按键也会跟着换。"
          }
        }
      }
    },
    "Swipe up on the Return key to open a language switcher.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Swiep op op die Return-sleutel om 'n taalwisselaar oop te maak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wisch auf der Eingabetaste nach oben, um den Sprachwechsler zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia arriba en la tecla Retorno para abrir el selector de idioma."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viipa sisestusklahvil üles, et avada keelevalija."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaye vers le haut sur la touche Retour pour ouvrir le sélecteur de langue."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd fel az Enter billentyűt, és megnyílik a nyelvváltó."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri in su sul tasto Invio per aprire il selettore della lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リターンキーを上にスワイプすると言語の切り替えが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Return 키에서 위로 쓸어올리면 언어 전환 화면이 열려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
