          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les statistiques sont désactivées"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A statisztikák ki vannak kapcsolva"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le statistiche sono disattivate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力統計はオフです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통계가 꺼져 있어요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik dimatikan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As estatísticas estão desativadas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аналитика выключена"
          }
        },
        "zh-Hans": {
