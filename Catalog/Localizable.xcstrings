    "Scroll down the page to the cards with a dashed outline, and tap one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll auf der Seite nach unten zu den Karten mit gestricheltem Rand und tippe eine an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja por la página hasta las tarjetas de contorno discontinuo y toca una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Descends la page jusqu'aux cartes au contour en pointillés et touches-en une."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Görgess lejjebb a szaggatott keretű kártyákig, és koppints az egyikre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri la pagina fino alle schede con il bordo tratteggiato e toccane una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページを下にスクロールし、破線の枠のカードをタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지를 내려 점선 테두리 카드까지 간 다음, 하나를 누르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatal ke bawah halaman sehingga kad bergaris putus, dan ketik satu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desce a página até aos cartões de contorno tracejado e toca num."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутите страницу до карточек с пунктирной рамкой и нажмите на любую."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "往下滚到有虚线边框的卡片，点一下。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Keri lehel alla kaartideni katkendjoonelise äärisega ja puuduta üht."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rollees op die bladsy af na die kaarte met 'n stippellyn, en tik op een."
          }
        }
      }
    },
