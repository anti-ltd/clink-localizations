          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakendub"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique à"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Érvényes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica a"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用先"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용 대상"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan pada"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Относится к"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于"
          }
        }
      }
    },
    "Applies to every letter set to match the font. A letter with its own spacing keeps it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a todas las letras configuradas para seguir la fuente. Una letra con su propio espaciado lo conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique à toutes les lettres réglées pour suivre la police. Une lettre ayant son propre espacement le conserve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für alle Buchstaben, die der Schrift folgen. Ein Buchstabe mit eigenem Abstand behält ihn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica a ogni lettera impostata per seguire il font. Una lettera con spaziatura propria la mantiene."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a todas as letras definidas para acompanhar a fonte. Uma letra com espaçamento próprio mantém-no."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется ко всем буквам, следующим за шрифтом. Буква с собственными отступами сохраняет их."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan pada setiap huruf yang ditetapkan mengikut fon. Huruf dengan jarak sendiri mengekalkannya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden olyan betűre vonatkozik, amely a betűtípust követi. A saját térközzel rendelkező betű megtartja azt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォントに合わせる設定のすべての文字に適用されます。独自の字間を持つ文字はそのままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于所有设为跟随字体的字母。设有独立间距的字母会保留自己的间距。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글꼴을 따르도록 설정된 모든 글자에 적용됩니다. 자체 간격이 있는 글자는 그대로 유지됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehtib kõigile tähtedele, mis järgivad fonti. Oma vahedega täht säilitab need."
          }
        }
      }
    },
    "Applies to every reel. The stage hides its own controls a couple of seconds after you stop touching it, so a screen recording starts clean.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Van toepassing op elke katrol. Die verhoog versteek sy eie kontroles 'n paar sekondes nadat jy opgehou het om daaraan te raak, so 'n skermopname begin skoon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für jedes Reel. Die Bühne blendet ihre eigenen Regler ein paar Sekunden nach dem letzten Tippen aus, damit die Aufnahme sauber startet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale para cada reel. El escenario esconde sus controles un par de segundos después de dejar de tocarlo, para que la grabación empiece limpia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakendub igale rullile. Lava peidab oma juhtelemendid mõni sekund pärast seda, kui lakkad teda puudutamast, et ekraanisalvestus algaks puhtalt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à chaque reel. La scène cache ses commandes deux secondes après que tu as arrêté de la toucher, pour que l’enregistrement parte propre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden reelre vonatkozik. A színpad pár másodperc után elrejti a saját vezérlőit, hogy a képernyőfelvétel tisztán induljon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale per ogni reel. Il palco nasconde i suoi comandi un paio di secondi dopo che smetti di toccarlo, così la registrazione parte pulita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのリールに適用されます。触るのをやめて数秒すると操作が隠れるので、画面収録がきれいに始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 릴에 적용됩니다. 손을 뗀 지 몇 초면 조작이 숨어서, 화면 녹화가 깔끔하게 시작됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan pada setiap reel. Pentas menyembunyikan kawalannya beberapa saat selepas anda berhenti menyentuhnya, supaya rakaman skrin bermula bersih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a cada reel. O palco esconde os controlos uns segundos depois de parares de o tocar, para a gravação começar limpa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется к каждому ролику. Сцена прячет свои элементы управления через пару секунд после того, как вы перестаёте её касаться, так что запись экрана начинается чисто."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于每条 reel。停止触摸一两秒后，舞台会藏起自己的控件，方便录屏从干净画面开始。"
          }
        }
      }
    },
    "Applies your keyboard setup": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica la configuración del teclado"
          }
        },
        "fr": {
