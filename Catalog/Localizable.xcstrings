    "Keep this plugin's settings and data on this device between sessions.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva los ajustes y datos de este plugin en el dispositivo entre sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve les réglages et les données de ce plugin sur cet appareil entre les sessions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert Einstellungen und Daten dieses Plugins zwischen Sitzungen auf diesem Gerät."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni le impostazioni e i dati di questo plugin sul dispositivo tra una sessione e l’altra."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha as definições e os dados deste plugin no dispositivo entre sessões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять настройки и данные плагина на устройстве между сеансами."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan tetapan dan data pemalam ini pada peranti antara sesi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bővítmény beállításai és adatai maradjanak az eszközön a munkamenetek között."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッション間で、このプラグインの設定とデータをデバイスに保存します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在不同会话之间，将插件的设置和数据保留在此设备上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 사이에 플러그인의 설정과 데이터를 이 기기에 보관합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilitab pistikprogrammi seaded ja andmed seadmes seansside vahel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this plugin's settings and data on this device between sessions."
          }
        }
      }
    },
    "Keep what this panel holds between openings, and between keyboard launches.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep what this panel holds between openings, and between keyboard launches."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou wat hierdie paneel bevat tussen kere wat dit oopgemaak word, en tussen sleutelbordsessies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält den Inhalt dieses Panels, wenn du es schließt und wieder öffnest – auch über Tastatursitzungen hinweg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva lo que contiene este panel al cerrarlo y volver a abrirlo, y entre sesiones del teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoiab selle paneeli sisu alles sulgemiste vahel ja ka klaviatuuri uuesti avamisel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve le contenu de ce panneau d'une ouverture à l'autre, et d'une session du clavier à l'autre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megőrzi a panel tartalmát a megnyitások között, és a billentyűzet újraindítása után is."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva il contenuto di questo pannello tra un'apertura e l'altra, e tra le sessioni della tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパネルの内容を、閉じて開き直しても、キーボードを起動し直しても保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 패널의 내용을 다시 열 때도, 키보드를 다시 실행할 때도 그대로 유지합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekalkan kandungan panel ini antara setiap kali dibuka, dan antara sesi papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o que este painel contém entre aberturas e entre sessões do teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет содержимое панели между открытиями и между запусками клавиатуры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在关闭后重新打开，以及键盘重新启动后，都保留此面板中的内容。"
          }
        }
      }
    },
    "Keeps the tool on but takes it out of the panel button and the slide-up list.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou die instrument aan, maar haal dit uit die paneelknoppie en die opskuiflys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt das Werkzeug an, nimmt es aber aus dem Panel-Button und der Liste heraus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la herramienta activada pero la quita del botón de paneles y de la lista."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoiab tööriista sees, aga võtab selle paneelinupust ja üleslibisevate loendist välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde l'outil activé mais le retire du bouton de panneaux et de la liste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolva hagyja az eszközt, de kiveszi a panelgombból és a listából."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene lo strumento attivo ma lo toglie dal pulsante dei pannelli e dall'elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールはオンのまま、パネルボタンと一覧からだけ外します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구는 켠 채로, 패널 버튼과 목록에서만 빼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengekalkan alat ini hidup tetapi mengeluarkannya daripada butang panel dan senarai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a ferramenta ligada, mas tira-a do botão de painéis e da lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставляет инструмент включённым, но убирает его из кнопки панелей и списка по подъёму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具仍然开着，只是从面板按钮和列表里移除。"
          }
        }
      }
    },
