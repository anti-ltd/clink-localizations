    "1024×1024 for App Store Connect ▸ Promoted In-App Purchases. The app tile on the graphite stage, plan name, one keyboard. Share → Save Image.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 para App Store Connect ▸ Compras dentro de la app promocionadas. El mosaico de la app sobre el escenario grafito, el nombre del plan, un teclado. Compartir → Guardar imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 pour App Store Connect ▸ Achats intégrés promus. La vignette de l'app sur la scène graphite, le nom du plan, un clavier. Partager → Enregistrer l'image."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 für App Store Connect ▸ Beworbene In-App-Käufe. Die App-Kachel auf der Graphit-Bühne, der Plan-Name, eine Tastatur. Teilen → Bild speichern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 per App Store Connect ▸ Acquisti in-app promossi. La tile dell'app sul palco grafice, il nome del piano, una tastiera. Condividi → Salva immagine."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 para App Store Connect ▸ Compras dentro da app promovidas. O mosaico da app no palco grafite, o nome do plano, um teclado. Partilhar → Guardar imagem."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 untuk App Store Connect ▸ Pembelian dalam apl dipromosikan. Jubin apl pada pentas grafit, nama pelan, satu papan kekunci. Kongsi → Simpan Imej."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 az App Store Connect ▸ Népszerűsített alkalmazáson belüli vásárlásokhoz. Az alkalmazáscsempe a grafit színpadon, a terv neve, egy billentyűzet. Megosztás → Kép mentése."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Connect ▸ プロモーション対象のアプリ内課金用の 1024×1024。グラファイトのステージ上のアプタイル、プラン名、キーボード1台。共有 → 画像を保存。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 用于 App Store Connect ▸ 推广的应用内购买。石墨舞台上的应用磁贴、方案名称、一个键盘。分享 → 保存图片。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Connect ▸ 프로모션된 앱 내 구입용 1024×1024. 그라파이트 무대 위 앱 타일, 요금제 이름, 키보드 하나. 공유 → 이미지 저장."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 App Store Connecti ▸ Reklaamitud rakendusesiseste ostude jaoks. Rakenduse paan grafiitlaval, plaani nimi, üks klaviatuur. Jaga → Salvesta pilt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1024×1024 для App Store Connect ▸ Продвигаемые покупки в приложении. Плитка приложения на графитовой сцене, название плана, одна клавиатура. Поделиться → Сохранить изображение."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1024×1024 vir App Store Connect ▸ Bevorderde In-App-aankope. Die app-teël op die grafietverhoog, plannaam, een sleutelbord. Deel → Stoor prent."
          }
        }
      }
    },
