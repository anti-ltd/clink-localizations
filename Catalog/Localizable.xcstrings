    "Make one, then import a dictionary for it if you have a word list.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maak een, voer dan 'n woordeboek daarvoor in as jy 'n woordelys het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg eine an und importier ein Wörterbuch dafür, falls du eine Wortliste hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea uno y, si tienes una lista de palabras, impórtala como diccionario."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loo üks ja impordi sellele sõnaraamat, kui sul on sõnaloend."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crées-en une, puis importe un dictionnaire si tu as une liste de mots."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozz létre egyet, majd importálj hozzá szótárat, ha van szólistád."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creane una, poi importa un dizionario se hai un elenco di parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つ作成し、単語リストがあれば辞書として読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나 만든 다음, 단어 목록이 있다면 사전으로 가져오세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipta satu, kemudian import kamus untuknya jika anda ada senarai perkataan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria um e, se tiveres uma lista de palavras, importa-a como dicionário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте его, а потом импортируйте словарь, если у вас есть список слов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先建一个，如果手里有词表，再作为词典导进去。"
          }
        }
      }
    },
    "Make your keyboard\nyours, everywhere.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teclado, a tu manera.\nEn todas partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton clavier, à ton image.\nPartout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tastatur. Dein Stil.\nÜberall."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua tastiera, a modo tuo.\nOvunque."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu teclado, à sua medida.\nEm todo o lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша клавиатура, ваш стиль.\nВезде."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci mengikut gaya anda.\nDi mana-mana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A te billentyűzeted, a te stílusod.\nMindenhol."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこでも、自分らしい\nキーボードに。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让键盘随处\n都属于你。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서나 나만의\n키보드로."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu klaviatuur, sinu moodi.\nKõikjal."
          }
        }
      }
    },
    "Making a light, sharp ringing sound.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Que produce un sonido tintineante, ligero y agudo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui produit un son clair et léger de tintement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen hellen, klirrenden Klang erzeugend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Che produce un suono tintinnante, leggero e acuto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que produz um som tilintante, leve e agudo."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghasilkan bunyi denting yang halus dan nyaring."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Könnyed, éles csengő hangot adó."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軽く澄んだ、チリンという音を立てること。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发出轻快清脆的叮当声。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가볍고 맑게 쨍그랑거리는 소리를 내는."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerget ja teravat kõlisevat heli tekitav."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Издающий лёгкий, звонкий звенящий звук."
          }
        }
      }
    },
