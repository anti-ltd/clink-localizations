          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε οποιαδήποτε εφαρμογή, πατήστε το πλήκτρο 🌐 υδρόγειο για να μεταβείτε στο Clink."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
