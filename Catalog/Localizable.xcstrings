    "Browse clips in a grid. Tap one to paste.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Blaai deur snitte in 'n rooster. Tik een om te plak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchstöbere Clips im Raster. Tippe einen zum Einfügen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora los clips en una cuadrícula: toca uno para pegar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirvi klippe ruudustikus. Puuduta üht kleepimiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcours tes clips dans une grille. Touche l'un d'eux pour coller."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Böngészd az elemeket rácsban. Koppints egyre a beillesztéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfoglia le clip in una griglia: toccane una per incollare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップをグリッドで一覧。タップで貼り付け。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립을 그리드로 살펴보세요. 하나를 탭하면 붙여넣기돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak imbas klip dalam grid. Ketik satu untuk tampal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegue pelos clips numa grade. Toque num para colar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте фрагменты сеткой. Нажмите на любой, чтобы вставить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以网格浏览剪贴内容，点按其中一条即可粘贴。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răsfoiți clipuri într-o grilă. Atingeți unul pentru a lipi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blader door clips in een raster. Tik op een om te plakken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以網格瀏覽剪貼內容，點按其中一條即可貼上。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądaj klipy w siatce. Kliknij jeden, aby wkleić."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядайте кліпи в сітці. Торкніться одного, щоб вставити."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliplere bir ızgarada göz atın. Yapıştırmak için birine dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Procházejte klipy v mřížce. Klepnutím na jeden vložíte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prehliadajte klipy v mriežke. Klepnutím na jeden ho prilepíte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιηγηθείτε στα κλιπ σε ένα πλέγμα. Πατήστε ένα για επικόλληση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bläddra bland klipp i ett rutnät. Tryck på en för att klistra in."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemse klip i et gitter. Tryk på en for at indsætte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bla gjennom klipp i et rutenett. Trykk på en for å lime inn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selaa leikkeitä ruudukossa. Liitä napauttamalla yhtä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Telusuri klip dalam kotak. Ketuk satu untuk ditempel."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Duyệt các clip trong một lưới. Nhấn vào một để dán."
          }
        }
      }
    },
