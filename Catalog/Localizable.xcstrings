    "Back to the letters. Always shown when the category tabs are off.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Terug na die briewe. Word altyd gewys wanneer die kategorie-oortjies af is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück zu den Buchstaben. Wird immer angezeigt, wenn die Kategorie-Tabs aus sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a las letras. Siempre se ve cuando las pestañas de categorías están apagadas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagasi tähtede juurde. Alati nähtav, kui kategooriakaardid on välja lülitatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour aux lettres. Toujours affichée quand les onglets de catégories sont désactivés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissza a betűkhöz. Mindig látszik, ha a kategóriafülek ki vannak kapcsolva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna alle lettere. Resta sempre visibile quando le schede delle categorie sono spente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字に戻ります。カテゴリタブをオフにしているときは常に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자로 돌아가요. 카테고리 탭을 꺼두면 항상 보여요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali ke huruf. Sentiasa ditunjukkan apabila tab kategori dimatikan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta às letras. Aparece sempre quando os separadores de categorias estão desligados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назад к буквам. Всегда видна, когда вкладки категорий выключены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到字母。关掉分类栏时会一直显示。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înapoi la litere. Afișat întotdeauna când filele categorie sunt dezactivate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terug naar de brieven. Wordt altijd weergegeven als de categorietabbladen zijn uitgeschakeld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到字母。關掉分類欄時會一直顯示。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wracając do liter. Wyświetlane zawsze, gdy karty kategorii są wyłączone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернемося до листів. Завжди відображається, коли вкладки категорій вимкнено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mektuplara geri dönelim. Her zaman kategori sekmeleri kapalıyken gösterilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zpět k dopisům. Vždy se zobrazí, když jsou karty kategorií vypnuté."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Späť k listom. Vždy sa zobrazí, keď sú karty kategórií vypnuté."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιστροφή στα γράμματα. Εμφανίζεται πάντα όταν οι καρτέλες κατηγορίας είναι απενεργοποιημένες."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillbaka till bokstäverna. Visas alltid när kategoriflikarna är avstängda."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbage til bogstaverne. Vises altid, når kategorifanerne er slået fra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbake til bokstavene. Vises alltid når kategorifanene er av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Takaisin kirjaimiin. Näytetään aina, kun luokkavälilehdet ovat pois päältä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali ke surat-surat. Selalu ditampilkan ketika tab kategori tidak aktif."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trở lại với những lá thư. Luôn hiển thị khi các tab danh mục bị tắt."
          }
        }
      }
    },
