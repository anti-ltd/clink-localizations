    "Do the same on the other device, signed in to the same Apple Account.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Doen dieselfde op die ander toestel, aangemeld by dieselfde Apple-rekening."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach dasselbe auf dem anderen Gerät, angemeldet mit demselben Apple-Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz lo mismo en el otro dispositivo, con la misma cuenta de Apple iniciada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee sama teises seadmes, logitud samasse Apple'i kontosse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais pareil sur l'autre appareil, connecté au même compte Apple."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugyanezt tedd meg a másik eszközön is, ugyanazzal az Apple-fiókkal bejelentkezve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai lo stesso sull'altro dispositivo, con lo stesso account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じApple アカウントでサインインした別の端末でも、同じ操作をします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 Apple 계정으로 로그인한 다른 기기에서도 똑같이 하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat perkara yang sama pada peranti satu lagi, dengan Akaun Apple yang sama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz o mesmo no outro dispositivo, com sessão iniciada na mesma conta Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте то же самое на другом устройстве, войдя в тот же аккаунт Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一台设备上用同一个 Apple 账户登录，做同样的操作。"
          }
        }
      }
    },
