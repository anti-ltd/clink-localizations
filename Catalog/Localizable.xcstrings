    "Also load the other languages' on-device sentence models, so a word in your second language is judged by its own model. Uses about 5 MB more memory per language.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga también los modelos de frases de los otros idiomas para evaluar cada palabra con su modelo correspondiente. Usa unos 5 MB más de memoria por idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge aussi les modèles de phrases des autres langues sur l’appareil, pour évaluer chaque mot avec le modèle de sa langue. Utilise environ 5 Mo de mémoire de plus par langue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt auch die lokalen Satzmodelle der anderen Sprachen, damit jedes Wort vom passenden Sprachmodell bewertet wird. Benötigt etwa 5 MB zusätzlichen Speicher pro Sprache."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica anche i modelli locali delle frasi per le altre lingue, così ogni parola viene valutata dal modello della sua lingua. Usa circa 5 MB di memoria in più per lingua."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega também os modelos de frases locais dos outros idiomas, para avaliar cada palavra com o modelo do respetivo idioma. Usa cerca de mais 5 MB de memória por idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также загружает на устройстве модели предложений для других языков, чтобы каждое слово оценивалось моделью своего языка. Требует около 5 МБ дополнительной памяти на язык."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muatkan juga model ayat pada peranti bagi bahasa lain supaya setiap perkataan dinilai oleh model bahasanya sendiri. Menggunakan kira-kira 5 MB memori tambahan bagi setiap bahasa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A többi nyelv helyi mondatmodelljét is betölti, így minden szót a saját nyelvének modellje értékel. Nyelvenként körülbelül 5 MB többletmemóriát használ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの言語のオンデバイス文モデルも読み込み、各単語をその言語のモデルで評価します。言語ごとに約5 MBの追加メモリを使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时加载其他语言的本地句子模型，让每个词都由对应语言的模型评估。每种语言约多用 5 MB 内存。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 언어의 온디바이스 문장 모델도 불러와 각 단어를 해당 언어의 모델로 평가합니다. 언어마다 메모리를 약 5MB 더 사용합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadib ka teiste keelte kohalikud lausemudelid, et iga sõna hindaks selle keele mudel. Kasutab iga keele kohta umbes 5 MB lisamälu."
          }
        }
      }
    },
    "Always show 1–0 above the letters.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toon altyd 1–0 bo die letters."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1–0 immer über den Buchstaben zeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra siempre del 1 al 0 encima de las letras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva alati 1–0 tähtede kohal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours afficher 1–0 au-dessus des lettres."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A betűk felett mindig ott legyen az 1–0."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra sempre 1–0 sopra le lettere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字の上に 1〜0 をいつも表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자 위에 1–0을 항상 보여줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentiasa tunjuk 1–0 di atas huruf."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar sempre 1–0 por cima das letras."
          }
        },
        "ru": {
