    "Custom layouts are part of the membership. Subscribe to move keys, add rows and keep the arrangement.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pasgemaakte uitlegte is deel van die lidmaatskap. Teken in om sleutels te skuif, rye by te voeg en die rangskikking te behou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzerdefinierte Layouts sind Teil der Mitgliedschaft. Abonniere, um Tasten zu verschieben, Zeilen hinzuzufügen und die Anordnung zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los diseños personalizados son parte de la membresía. Suscríbete para mover teclas, añadir filas y conservar la disposición."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohandatud paigutused on osa liikmelisusest. Telli, et liigutada klahve, lisada ridu ja säilitada paigutus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dispositions personnalisées font partie de l'abonnement. Abonne-toi pour déplacer les touches, ajouter des rangées et garder la disposition."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyéni elrendezések a tagság részét képezik. Iratkozz fel, hogy mozgathasd a billentyűket, sorokat adj hozzá, és megtartsd az elrendezést."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I layout personalizzati fanno parte dell'abbonamento. Abbonati per spostare i tasti, aggiungere righe e conservare la disposizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムレイアウトはメンバーシップに含まれます。サブスクリプションでキーを移動し、行を追加して、配置を維持できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 키보드는 멤버십의 일부입니다. 구독하여 키를 이동하고, 행을 추가하고, 배열을 유지하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun atur tersuai adalah sebahagian daripada keahlian. Langgan untuk menggerakkan kekunci, menambah baris dan mengekalkan susunan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os esquemas personalizados fazem parte da subscrição. Subscreve para mover teclas, adicionar filas e manter a disposição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свои раскладки — часть членства. Оформите подписку, чтобы перемещать клавиши, добавлять ряды и сохранять расстановку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义布局属于会员功能。订阅后即可移动按键、添加行并保留布局。"
          }
        }
      }
    },
