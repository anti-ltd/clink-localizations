    "Warp the glass under your finger as you press each key, like the shift key.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Draai die glas onder jou vinger terwyl jy elke sleutel druk, soos die shift-sleutel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzieht das Glas unter deinem Finger, während du jede Taste drückst, wie bei der Umschalttaste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deforma el cristal bajo tu dedo al pulsar cada tecla, como la de mayúsculas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonutab klaasi su sõrme all, kui iga klahvi vajutad, nagu tõstuklahvi puhul."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déforme le verre sous ton doigt à chaque appui sur une touche, comme la touche Majuscule."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomd meg a billentyűt, és az üveg behajlik az ujjad alatt, ahogy a Shiftnél is."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Deforma il vetro sotto il dito quando premi un tasto, come fa il tasto Maiuscole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフトキーのように、キーを押すと指の下のガラスがへこみます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 키처럼 키를 누를 때마다 손가락 아래 유리가 눌리듯 휘어져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lentikkan kaca di bawah jari anda setiap kali tekan kekunci, macam kekunci shift."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Distorce o vidro debaixo do teu dedo ao carregar em cada tecla, como a tecla Shift."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Искажать стекло под пальцем при нажатии каждой клавиши — как у клавиши Shift."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下每个键时，让手指下方的玻璃轻轻变形，就像 Shift 键那样。"
          }
        }
      }
    },
