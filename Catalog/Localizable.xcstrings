            "state": "translated",
            "value": "Kallistaa jokaisen näppäimen poispäin rivin keskeltä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Condongkan setiap kunci menjauh dari tengah barisnya."
