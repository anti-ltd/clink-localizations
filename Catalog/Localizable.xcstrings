            "state": "translated",
            "value": "iCloud Sync'te pano senkronizasyonunu açmadığınız sürece telefondan asla ayrılmaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdy neopustí telefon, pokud v iCloud Sync nezapnete synchronizaci schránky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdy neopustí telefón, pokiaľ nezapnete synchronizáciu schránky v iCloud Sync."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν φεύγει ποτέ από το τηλέφωνο εκτός και αν ενεργοποιήσετε τον συγχρονισμό του προχείρου στο iCloud Sync."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lämnar aldrig telefonen om du inte slår på klippbordssynkronisering i iCloud Sync."
          }
        },
        "da": {
