    "Draw your own letters, or take them from a font.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja tus propias letras o tómalas de una fuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez vos propres lettres ou reprenez-les d’une police."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne eigene Buchstaben oder übernimm sie aus einer Schrift."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna le tue lettere o prendile da un font."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe suas próprias letras ou use as de uma fonte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нарисуйте свои буквы или возьмите их из шрифта."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukis huruf anda sendiri atau ambil daripada fon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajzold meg a saját betűidet, vagy vedd át őket egy betűtípusból."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で文字を描くか、フォントから取り込みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘制你自己的字母，或从字体中选取。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자를 직접 그리거나 서체에서 가져오세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Joonista oma tähed või võta need fondist."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenați-vă propriile litere sau luați-le dintr-un font."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken je eigen letters, of neem ze uit een lettertype."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繪製你自己的字母，或從字型中選取。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken jou eie letters, of kies hulle uit 'n lettertipe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narysuj własne litery lub pobierz je z czcionki."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Намалюйте власні букви або візьміть їх зі шрифту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi harflerinizi çizin veya bunları bir yazı tipinden alın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakreslete si vlastní písmena nebo je vezměte z písma."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakreslite si vlastné písmená alebo ich vezmite z písma."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδιάστε τα δικά σας γράμματα ή πάρτε τα από μια γραμματοσειρά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rita dina egna bokstäver, eller ta dem från ett typsnitt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn dine egne bogstaver, eller tag dem fra en skrifttype."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn dine egne bokstaver, eller ta dem fra en font."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirrä omat kirjaimet tai ota ne kirjasimesta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambarlah huruf Anda sendiri, atau ambil dari font."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẽ các chữ cái của riêng bạn hoặc lấy chúng từ một phông chữ."
          }
        }
      }
    },
