    "Heat rises and flickers from the bottom row.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitte styg en flikker vanaf die onderste ry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitze steigt flackernd aus der unteren Reihe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calor sube y titila desde la fila inferior."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soojus tõuseb ja virvendab alumisest reast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La chaleur monte et vacille depuis la rangée du bas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hő az alsó sorból emelkedik és pislákol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il calore sale e tremola dalla riga inferiore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "熱が最下段から立ち上がり、揺らめきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맨 아랫줄에서 열이 올라와 흔들립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Panas naik dan berkelip dari baris bawah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O calor sobe e tremula a partir da fila de baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жар поднимается и мерцает от нижнего ряда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热气从底排升起并闪动。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Căldura crește și pâlpâie din rândul de jos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warmte stijgt op en flikkert vanaf de onderste rij."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "熱氣從底排升起並閃動。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciepło unosi się i migocze z dolnego rzędu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепло піднімається і мерехтить від нижнього ряду."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt sıradan ısı yükseliyor ve titriyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teplo stoupá a bliká ze spodní řady."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teplo stúpa a bliká zo spodného radu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η θερμότητα ανεβαίνει και τρεμοπαίζει από την κάτω σειρά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Värmen stiger och flimrar från den nedre raden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmen stiger og flimrer fra nederste række."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmen stiger og flimrer fra nederste rad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämpö nousee ja välkkyy alimmasta rivistä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panas naik dan berkedip dari baris paling bawah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệt tăng lên và nhấp nháy từ hàng dưới cùng."
          }
        }
      }
    },
