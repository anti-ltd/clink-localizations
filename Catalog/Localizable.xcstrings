    "Float each word above a slightly inset target key.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra cada palabra sobre su tecla de destino, ligeramente hundida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche chaque mot au-dessus de sa touche cible, légèrement enfoncée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt jedes Wort über einer leicht abgesenkten Zieltaste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra ogni parola sopra il tasto di destinazione, leggermente incassato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra cada palavra sobre a tecla de destino, ligeiramente rebaixada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает каждое слово над слегка утопленной целевой клавишей."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Paparkan setiap perkataan di atas kekunci sasaran yang sedikit tenggelam."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden szó a kissé besüllyesztett célbillentyűje fölött jelenik meg."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少しへこんだ入力先のキーの上に、各単語を表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将每个词显示在略微下陷的目标按键上方。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
