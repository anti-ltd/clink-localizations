    "Neither is required. Here's what each one actually does.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie een word vereis nie. Hier is wat elkeen eintlik doen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beides ist optional. Hier steht, was es jeweils wirklich bewirkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna es obligatoria. Esto es lo que hace cada una."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumbagi pole vaja. Siin on, mida kumb tegelikult teeb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune n'est obligatoire. Voici ce que chacune fait vraiment."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyik sem kötelező. Íme, mit csinálnak valójában."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna delle due è obbligatoria. Ecco cosa fa davvero ciascuna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらも必須ではありません。それぞれの実際の役割はこちらです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다 필수는 아닙니다. 각각이 실제로 무엇을 하는지 알려드릴게요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua-duanya tidak diwajibkan. Ini yang setiap satu benar-benar lakukan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma é obrigatória. Veja o que cada uma faz de verdade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни то, ни другое не обязательно. Вот что каждое из них на самом деле делает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两者都不是必需的。以下是它们各自的实际作用。"
          }
        }
      }
    },
