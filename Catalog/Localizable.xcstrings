    "Bento stacks notes in two columns, each card as tall as its note, so you can read one without loading it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bento stapel notas in twee kolomme, elke kaart so lank soos sy noot, sodat jy een kan lees sonder om dit te laai."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento stapelt Notizen in zwei Spalten – jede Karte so hoch wie ihre Notiz, sodass du sie lesen kannst, ohne sie zu laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento apila las notas en dos columnas, con cada tarjeta tan alta como su nota, así puedes leerla sin cargarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento virnab märkused kahes veerus, iga kaart sama kõrge kui oma märkus, nii et sa saad ühe neist lugeda seda avamata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento empile les notes sur deux colonnes, chaque carte à la hauteur de sa note : tu peux la lire sans la charger."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Bento két oszlopba rendezi a jegyzeteket, minden kártya akkora, mint a jegyzete – így betöltés nélkül is elolvashatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento impila le note su due colonne, ogni scheda alta quanto la sua nota: così la leggi senza caricarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベントーはメモを2列に並べ、カードの高さをメモに合わせます。読み込まなくても全文が読めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벤토는 메모를 두 열로 쌓고 카드 높이를 메모에 맞춰요. 불러오지 않아도 전체를 읽을 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento menyusun nota dalam dua lajur, setiap kad setinggi notanya — jadi anda boleh membacanya tanpa memuatkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bento empilha as notas em duas colunas, cada cartão tão alto quanto a sua nota, para a leres sem a carregar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Бенто» складывает заметки в две колонки, и высота карточки равна длине заметки — можно прочитать её, не открывая."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "便当网格把备忘分成两列，卡片高度随备忘伸展，不用载入就能读完整条。"
          }
        }
      }
    },
