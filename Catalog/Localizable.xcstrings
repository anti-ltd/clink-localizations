    "It backlights the keys the way a mechanical keyboard does.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verlig die sleutels soos 'n meganiese sleutelbord dit doen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie hinterleuchtet die Tasten wie bei einer mechanischen Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina las teclas por detrás como un teclado mecánico."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See valgustab klahve tahapoolt nagu mehaaniline klaviatuur."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rétroéclaire les touches comme sur un clavier mécanique."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Úgy világítja meg hátulról a billentyűket, mint egy mechanikus billentyűzet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroillumina i tasti come una tastiera meccanica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メカニカルキーボードのように、キーを背面から光らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기계식 키보드처럼 키를 뒤에서 밝혀 줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia menyinari kekunci dari belakang seperti papan kekunci mekanikal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina as teclas por trás como um teclado mecânico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она подсвечивает клавиши, как механическая клавиатура."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它像机械键盘那样给按键打背光。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Iluminează tastele așa cum o face o tastatură mecanică."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verlicht de toetsen zoals een mechanisch toetsenbord dat doet."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它像機械鍵盤那樣給按鍵打背光。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podświetla klawisze w taki sam sposób, w jaki robi to klawiatura mechaniczna."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він підсвічує клавіші, як це робить механічна клавіатура."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşları mekanik bir klavyenin yaptığı gibi arkadan aydınlatır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesy podsvítí stejně jako mechanická klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesy podsvieti tak, ako to robí mechanická klávesnica."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φωτίζει τα πλήκτρα όπως κάνει ένα μηχανικό πληκτρολόγιο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den belyser tangenterna på samma sätt som ett mekaniskt tangentbord gör."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den belyser tasterne, som et mekanisk tastatur gør."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den belyser tastene slik et mekanisk tastatur gjør."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se valaisee näppäimet mekaanisen näppäimistön tapaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menerangi tombol seperti yang dilakukan keyboard mekanis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó chiếu sáng các phím giống như bàn phím cơ."
          }
        }
      }
    },
    "It becomes its own entry in the language list, for a language Clink doesn’t ship.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit word sy eie inskrywing in die taallys, vir 'n taal wat Clink nie stuur nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird ein eigener Eintrag in der Sprachliste – für eine Sprache, die Clink nicht mitliefert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa a ser su propia entrada en la lista de idiomas, para un idioma que Clink no incluye."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellest saab omaette kirje keeleloendis, keele jaoks, mida Clink ei paku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il devient une entrée à part dans la liste des langues, pour une langue que Clink ne fournit pas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Külön bejegyzés lesz a nyelvek listáján, egy olyan nyelvhez, amit a Clink nem tartalmaz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diventa una voce a sé nell’elenco delle lingue, per una lingua che Clink non include."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink に入っていない言語として、言語リストに独立した項目が追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink에 없는 언어로서 언어 목록에 별도 항목이 추가됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia menjadi entri tersendiri dalam senarai bahasa, untuk bahasa yang tiada dalam Clink."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa a ser uma entrada própria na lista de idiomas, para um idioma que o Clink não inclui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он станет отдельным пунктом в списке языков — для языка, которого нет в Clink."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会作为独立条目出现在语言列表中，用于 Clink 未收录的语言。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta devine propria sa intrare în lista de limbi, pentru o limbă pe care Clink nu este livrat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wordt zijn eigen vermelding in de talenlijst, voor een taal die Clink niet verzendt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會作為獨立條目出現在語言列表中，用於 Clink 未收錄的語言。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staje się oddzielnym wpisem na liście języków, ponieważ Clink nie jest dostarczany."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він стає власним записом у списку мов, оскільки Clink не поставляє мову."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink'in göndermediği bir dil için dil listesinde kendi girişi haline gelir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stane se vlastní položkou v seznamu jazyků, pro jazyk, který Clink nedodává."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stane sa vlastnou položkou v zozname jazykov, pre jazyk sa Clink nedodáva."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γίνεται η δική του καταχώριση στη λίστα γλωσσών, γιατί μια γλώσσα που δεν αποστέλλεται στο Clink."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det blir en egen post i språklistan, för ett språk som Clink inte levereras."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det bliver sin egen post i sproglisten, for et sprog Clink ikke sendes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det blir sin egen oppføring i språklisten, for et språk som Clink ikke sendes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siitä tulee oma merkintä kieliluettelossa, sillä kielelle Clink:tä ei toimiteta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menjadi entri tersendiri dalam daftar bahasa, karena bahasa yang tidak dikirimkan Clink."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó trở thành mục nhập riêng trong danh sách ngôn ngữ, đối với ngôn ngữ mà Clink không cung cấp."
          }
        }
      }
    },
    "It lets the keyboard read the storage it shares with this app: your themes, layouts, learned words and clipboard. Without it, the keyboard opens with none of your settings. Nothing you type leaves the device either way.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit laat die sleutelbord die berging wat dit met hierdie toepassing deel, lees: jou temas, uitlegte, aangeleerde woorde en knipbord. Daarsonder maak die sleutelbord oop met geen van jou instellings nie. Niks wat jy tik verlaat die toestel op enige manier nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit kommt die Tastatur an den Speicher, den sie sich mit dieser App teilt: deine Designs, Layouts, gelernten Wörter und die Zwischenablage. Ohne Vollzugriff startet sie ohne all deine Einstellungen. Was du tippst, bleibt so oder so auf dem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite al teclado leer el almacenamiento que comparte con esta app: tus temas, disposiciones, palabras aprendidas y el portapapeles. Sin él, el teclado se abre sin ninguno de tus ajustes. Lo que escribes no sale del dispositivo en ningún caso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See laseb klaviatuuril lugeda salvestusruumi, mida ta jagab selle rakendusega: sinu teemad, paigutused, õpitud sõnad ja lõikelaud. Ilma selleta avaneb klaviatuur ilma sinu seadeteta. Midagi, mida tipid, ei lahku seadmest kummagi juhul."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il permet au clavier de lire l'espace qu'il partage avec cette app : tes thèmes, tes dispositions, les mots appris et le presse-papiers. Sans lui, le clavier s'ouvre sans aucun de tes réglages. Ce que tu tapes ne quitte l'appareil dans aucun cas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel éri el a billentyűzet azt a tárhelyet, amit ezzel az alkalmazással közösen használ: a témákat, elrendezéseket, a tanult szavakat és a vágólapot. Nélküle a billentyűzet a beállításaid egyike nélkül indul. Amit gépelsz, így is, úgy is az eszközön marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permette alla tastiera di leggere lo spazio che condivide con quest'app: i tuoi temi, i layout, le parole apprese e gli appunti. Senza, la tastiera si apre priva di tutte le tue impostazioni. Quello che scrivi non lascia il dispositivo in nessun caso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードがこのアプリと共有している保存領域（テーマ、レイアウト、学習した単語、クリップボード）を読むために使います。許可しないと、設定が何も反映されないキーボードが開きます。入力した内容は、いずれの場合も端末の外には出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 이 앱과 함께 쓰는 저장 공간, 즉 테마와 레이아웃, 학습된 단어, 클립보드를 읽는 데 쓰입니다. 허용하지 않으면 설정이 하나도 반영되지 않은 키보드가 열립니다. 입력한 내용은 어느 쪽이든 기기를 벗어나지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia membolehkan papan kekunci membaca storan yang dikongsi dengan apl ini: tema, susun atur, perkataan yang dipelajari dan papan keratan anda. Tanpanya, papan kekunci dibuka tanpa satu pun tetapan anda. Apa yang anda taip tetap tidak meninggalkan peranti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa o teclado ler o espaço que partilha com esta app: os teus temas, esquemas, palavras aprendidas e a área de transferência. Sem isso, o teclado abre sem nenhuma das tuas definições. O que escreves não sai do dispositivo de qualquer forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он позволяет клавиатуре читать хранилище, общее с этим приложением: ваши темы, раскладки, выученные слова и буфер обмена. Без него клавиатура открывается вообще без ваших настроек. Напечатанное не покидает устройство в любом случае."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它让键盘能读取与本 App 共用的存储：你的主题、布局、已学习的单词和剪贴板。不给的话，键盘打开时你的设置一个都不会生效。无论给不给，你输入的内容都不会离开这台设备。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite tastaturii să citească spațiul de stocare pe care îl partajează cu această aplicație: temele, machetele, cuvintele învățate și clipboard-ul. Fără ea, tastatura se deschide fără nicio setări. Nimic din ceea ce tastați nu părăsește dispozitivul în niciun caz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het laat het toetsenbord de opslagruimte lezen die het met deze app deelt: uw thema's, lay-outs, geleerde woorden en klembord. Zonder dit wordt het toetsenbord geopend zonder uw instellingen. Niets dat u typt, verlaat het apparaat hoe dan ook."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它讓鍵盤能讀取與本 App 共用的儲存：你的主題、佈局、已學習的單詞和剪貼簿。不給的話，鍵盤開啟時你的設定一個都不會生效。無論給不給，你輸入的內容都不會離開這臺裝置。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala klawiaturze odczytać pamięć współdzieloną z tą aplikacją: motywy, układy, wyuczone słowa i schowek. Bez tego klawiatura otworzy się bez żadnych ustawień. Nic, co wpiszesz, nie opuści urządzenia w żaden sposób."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це дозволяє клавіатурі зчитувати пам’ять, яку вона спільно використовує з цією програмою: ваші теми, макети, вивчені слова та буфер обміну. Без нього клавіатура відкривається без ваших налаштувань. Ніщо, що ви вводите, не залишає пристрій у жодному разі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyenin bu uygulamayla paylaştığı depolama alanını okumasını sağlar: temalarınız, düzenleriniz, öğrendiğiniz kelimeler ve panonuz. Bu olmadan, klavye ayarlarınızın hiçbiriyle açılmaz. Yazdığınız hiçbir şey cihazdan çıkmaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožňuje klávesnici číst úložiště, které sdílí s touto aplikací: vaše motivy, rozvržení, naučená slova a schránku. Bez něj se klávesnice otevře bez žádného z vašich nastavení. Nic, co napíšete, neopustí zařízení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožňuje klávesnici čítať úložisko, ktoré zdieľa s touto aplikáciou: vaše témy, rozloženia, naučené slová a schránku. Bez nej sa klávesnica otvorí bez akýchkoľvek nastavení. Nič, čo zadáte, neopustí zariadenie v oboch smeroch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέπει στο πληκτρολόγιο να διαβάζει τον αποθηκευτικό χώρο που μοιράζεται με αυτήν την εφαρμογή: τα θέματα, τις διατάξεις, τις μαθημένες λέξεις και το πρόχειρο. Χωρίς αυτό, το πληκτρολόγιο ανοίγει χωρίς καμία από τις ρυθμίσεις σας. Τίποτα που πληκτρολογείτε δεν φεύγει από τη συσκευή σε καμία περίπτωση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det låter tangentbordet läsa lagringen det delar med den här appen: dina teman, layouter, inlärda ord och urklipp. Utan det öppnas tangentbordet utan några av dina inställningar. Inget du skriver lämnar enheten på något sätt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det lader tastaturet læse det lager, det deler med denne app: dine temaer, layouts, indlærte ord og udklipsholder. Uden det åbner tastaturet uden nogen af ​​dine indstillinger. Intet, du skriver, forlader enheden på nogen måde."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lar tastaturet lese lagringen det deler med denne appen: temaene dine, oppsettene, innlærte ord og utklippstavlen. Uten den åpnes tastaturet uten noen av innstillingene dine. Ingenting du skriver forlater enheten uansett."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen avulla näppäimistö voi lukea tämän sovelluksen kanssa jakamaa tallennustilaa: teemoja, asetteluja, opittuja sanoja ja leikepöytää. Ilman sitä näppäimistö avautuu ilman asetuksiasi. Mikään kirjoittamasi ei poistu laitteesta kumpaankaan suuntaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memungkinkan keyboard membaca penyimpanan yang dibagikannya dengan aplikasi ini: tema, tata letak, kata-kata yang dipelajari, dan papan klip. Tanpanya, keyboard akan terbuka tanpa pengaturan apa pun. Tidak ada yang Anda ketik yang akan meninggalkan perangkat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó cho phép bàn phím đọc bộ nhớ mà nó chia sẻ với ứng dụng này: chủ đề, bố cục, từ đã học và bảng nhớ tạm. Không có nó, bàn phím sẽ mở mà không có cài đặt nào của bạn. Dù sao đi nữa, không có gì bạn nhập sẽ rời khỏi thiết bị."
          }
        }
      }
    },
    "It never leaves the phone unless you turn clipboard sync on in iCloud Sync.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verlaat nooit die foon nie, tensy jy knipbordsinkronisering in iCloud Sync aanskakel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts davon verlässt das Gerät, es sei denn, du schaltest die Zwischenablage-Synchronisierung in „iCloud-Sync“ ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada sale del teléfono salvo que actives la sincronización del portapapeles en Sincronización con iCloud."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See ei lahku kunagi telefonist, välja arvatud juhul, kui lülidad lõikelaua sünkroonimise sisse jaotises iCloudi sünkroonimine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne quitte le téléphone, sauf si tu actives la synchro du presse-papiers dans Synchronisation iCloud."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi nem hagyja el a telefont, hacsak be nem kapcsolod a vágólap szinkronizálását az iCloud-szinkronban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non esce mai dal telefono, a meno che tu non attivi la sincronizzazione degli appunti in Sincronizzazione iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「iCloud同期」でクリップボードの同期をオンにしない限り、端末の外には出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화에서 클립보드 동기화를 켜지 않는 한, 기기 밖으로 나가지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia tidak pernah keluar dari telefon melainkan anda hidupkan penyegerakan papan keratan dalam Penyegerakan iCloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca sai do telemóvel, a não ser que ligues a sincronização da área de transferência na Sincronização iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он не покидает телефон, пока вы не включите синхронизацию буфера обмена в разделе «Синхронизация с iCloud»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你在“iCloud 同步”里开了剪贴板同步，否则这些内容不会离开手机。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu părăsește telefonul decât dacă activați sincronizarea clipboard-ului în iCloud Sync."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verlaat de telefoon nooit, tenzij u klembordsynchronisatie inschakelt in iCloud Sync."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你在“iCloud 同步”裡開了剪貼簿同步，否則這些內容不會離開手機。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy nie opuszcza telefonu, chyba że włączysz synchronizację schowka w iCloud Sync."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він ніколи не залишає телефон, якщо ви не ввімкнете синхронізацію буфера обміну в iCloud Sync."
          }
        },
        "tr": {
