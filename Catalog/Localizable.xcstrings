    "An end time before the start time continues past midnight.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la hora de fin es anterior a la de inicio, el intervalo continúa después de medianoche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l’heure de fin précède l’heure de début, la plage se prolonge après minuit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liegt die Endzeit vor der Startzeit, reicht der Zeitraum über Mitternacht hinaus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se l’ora di fine precede l’inizio, la fascia prosegue oltre mezzanotte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a hora de fim for anterior à de início, o intervalo prolonga-se para lá da meia-noite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если время окончания раньше начала, диапазон продолжается после полуночи."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika waktu tamat mendahului waktu mula, julat berterusan selepas tengah malam."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a záró időpont korábbi a kezdésnél, a tartomány éjfélen átnyúlik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了時刻が開始時刻より前の場合、時間帯は翌日まで続きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束时间早于开始时间时，时间范围将跨越午夜。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시간이 시작 시간보다 이르면 자정을 넘어 계속됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui lõppaeg on algusajast varasem, jätkub ajavahemik üle kesköö."
          }
        }
      }
    },
    "Analytics": {
      "extractionState": "manual",
      "localizations": {
        "af": {
