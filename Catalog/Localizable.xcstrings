    "How the delete key reacts to each deletion, including every step while held down.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe die delete-sleutel op elke uitvee reageer, insluitend elke stap terwyl dit ingehou word."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie die Löschtaste auf jedes Löschen reagiert, einschließlich jedes Schritts beim Gedrückthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo reacciona la tecla de eliminar a cada eliminación, incluido cada paso mientras la mantienes pulsada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuidas kustutusklahv reageerib igale kustutamisele, sealhulgas igale sammule allhoidmise ajal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment la touche Supprimer réagit à chaque suppression, y compris à chaque étape lorsqu'elle est maintenue."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Így reagál a törlőgomb minden törlésre, a nyomva tartás minden lépését is beleértve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come il tasto elimina reagisce a ogni cancellazione, compreso ogni passaggio mentre lo tieni premuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除のたびに削除キーがどう反応するか。長押し中の各ステップにも適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제할 때마다 삭제 키가 반응하는 방식으로, 길게 누르는 동안의 모든 단계에도 적용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cara kekunci padam bertindak balas pada setiap pemadaman, termasuk setiap langkah semasa ditekan lama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como a tecla Eliminar reage a cada eliminação, incluindo cada passo enquanto é mantida premida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как клавиша удаления отзывается на каждое удаление, в том числе на каждом шаге при удержании."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除键对每次删除的反应方式，包括长按期间的每一步。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cum reacționează tasta de ștergere la fiecare ștergere, inclusiv la fiecare pas când este apăsată."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe de verwijdertoets reageert op elke verwijdering, inclusief elke stap terwijl u deze ingedrukt houdt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除鍵對每次刪除的反應方式，包括長按期間的每一步。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak klawisz usuwania reaguje na każde usunięcie, w tym na każdy krok, gdy jest wciśnięty."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як клавіша видалення реагує на кожне видалення, включаючи кожен крок під час утримання."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silme tuşunun, basılı tutulduğunda her adım da dahil olmak üzere her silme işlemine nasıl tepki vereceği."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak klávesa Delete reaguje na každé mazání, včetně každého kroku, když je podrženo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako kláves Delete reaguje na každé vymazanie vrátane každého kroku, keď je stlačené."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πώς αντιδρά το κλειδί διαγραφής σε κάθε διαγραφή, συμπεριλαμβανομένου κάθε βήματος ενώ κρατάτε πατημένο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur raderingstangenten reagerar på varje radering, inklusive varje steg när den hålls nedtryckt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan slettetasten reagerer på hver sletning, inklusive hvert trin, mens den holdes nede."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan slettetasten reagerer på hver sletting, inkludert hvert trinn mens den holdes nede."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka poistonäppäin reagoi kuhunkin poistoon, mukaan lukien jokainen vaihe, kun sitä pidetään painettuna."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimana tombol hapus bereaksi terhadap setiap penghapusan, termasuk setiap langkah saat ditekan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cách phím xóa phản ứng với mỗi lần xóa, bao gồm mọi bước khi nhấn giữ."
          }
        }
      }
    },
    "How the key moves when pressed. Only applies when Bloom is on.": {
