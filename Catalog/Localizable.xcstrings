    "Hold a clip and drag it to reorder. Swipe left for copy, pin, or delete; swipe right to assign a group.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén un recorte y arrástralo para reordenar. Desliza a la izquierda para copiar, fijar o borrar; a la derecha para asignar un grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens un extrait et glisse-le pour réordonner. Balaye à gauche pour copier, épingler ou supprimer ; à droite pour l’assigner à un groupe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen Clip und zieh ihn zum Umsortieren. Wisch nach links für Kopieren, Anheften oder Löschen; nach rechts, um eine Gruppe zuzuweisen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un clip e trascinalo per riordinare. Scorri a sinistra per copiare, fissare o eliminare; a destra per assegnare un gruppo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém um clip e arrasta-o para reordenar. Desliza para a esquerda para copiar, afixar ou apagar; para a direita para atribuir um grupo."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan klip dan seret untuk susun semula. Leret kiri untuk salin, semat atau padam; leret kanan untuk tetapkan kumpulan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd a klipet, és húzd az átrendezéshez. Balra húzás: másolás, kitűzés, törlés; jobbra: csoportba sorolás."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップを長押ししてドラッグすると並べ替え。左スワイプでコピー・ピン・削除、右スワイプでグループ分け。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住一条再拖动即可重排。左滑复制、钉住或删除；右滑分到一组。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립을 길게 눌러 끌어 순서를 바꿉니다. 왼쪽 쓸면 복사·고정·삭제, 오른쪽 쓸면 그룹에 넣습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia klippi ja lohista see ümber. Viipa vasakule kopeerimiseks, kinnitamiseks või kustutamiseks; viipa paremale grupi määramiseks."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержите фрагмент и перетащите, чтобы изменить порядок. Свайп влево — копировать, закрепить или удалить; свайп вправо — назначить группу."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou 'n snit vas en sleep dit om te herrangskik. Swiep links vir kopieer, speld vas of vee uit; swiep regs om 'n groep toe te wys."
          }
        }
      }
    },
