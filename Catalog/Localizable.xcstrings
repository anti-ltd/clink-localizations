          }
        }
      }
    },
    "A layout belongs to the language that types on it, so you change it inside the language.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Uitleg behoort aan die taal wat daarop tik, so jy verander dit binne die taal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Layout gehört zu der Sprache, die darauf tippt, du änderst es also in der Sprache selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una distribución pertenece al idioma que escribe con ella, así que se cambia dentro del idioma."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paigutus kuulub keelele, mis sellega tipitakse, seega muudad seda keele seest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une disposition appartient à la langue qui écrit dessus : tu la changes donc dans la langue."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elrendezés ahhoz a nyelvhez tartozik, amelyik rajta gépel, ezért a nyelven belül változtatod meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una disposizione appartiene alla lingua che ci scrive, quindi la cambi dentro la lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配列は、それで入力する言語に属しています。そのため言語の中で変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배열은 그 위에서 입력하는 언어에 속하므로, 언어 안에서 바꿉니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun atur milik bahasa yang menaip padanya, jadi anda menukarnya di dalam bahasa itu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma disposição pertence ao idioma que escreve nela, por isso mudas dentro do idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раскладка принадлежит языку, на котором печатают, поэтому меняется внутри языка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排列方式属于在它上面打字的那种语言，所以要进到语言里改。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aspect aparține limbii care scrie pe el, așa că îl schimbați în interiorul limbii."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een lay-out hoort bij de taal waarin erop wordt getypt, dus u wijzigt deze binnen de taal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排列方式屬於在它上面打字的那種語言，所以要進到語言裡改。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Układ należy do języka, w którym się go pisze, więc zmieniasz go wewnątrz tego języka."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Макет належить до мови, яка друкує на ньому, тому ви змінюєте його всередині мови."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzen, üzerine yazılan dile aittir, dolayısıyla onu dilin içinde değiştirirsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozvržení patří k jazyku, který na něm píše, takže jej můžete změnit uvnitř jazyka."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozloženie patrí k jazyku, ktorý na ňom píše, takže ho môžete zmeniť v jazyku."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια διάταξη ανήκει στη γλώσσα που πληκτρολογεί σε αυτήν, επομένως την αλλάζετε μέσα στη γλώσσα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En layout tillhör språket som skriver på den, så du ändrar den inuti språket."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et layout hører til det sprog, der skriver på det, så du ændrer det inde i sproget."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et layout tilhører språket som skriver på det, så du endrer det inne i språket."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettelu kuuluu siihen kirjoittavalle kielelle, joten vaihdat sen kielen sisällä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tata letak milik bahasa yang mengetiknya, jadi Anda mengubahnya di dalam bahasa tersebut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bố cục thuộc về ngôn ngữ gõ trên đó, vì vậy bạn thay đổi bố cục bên trong ngôn ngữ đó."
          }
        }
      }
    },
