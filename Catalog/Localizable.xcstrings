    "How the delete key reacts to each deletion, including every step while held down.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoe die delete-sleutel op elke uitvee reageer, insluitend elke stap terwyl dit ingehou word."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie die Löschtaste auf jedes Löschen reagiert, einschließlich jedes Schritts beim Gedrückthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo reacciona la tecla de eliminar a cada eliminación, incluido cada paso mientras la mantienes pulsada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuidas kustutusklahv reageerib igale kustutamisele, sealhulgas igale sammule allhoidmise ajal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment la touche Supprimer réagit à chaque suppression, y compris à chaque étape lorsqu'elle est maintenue."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Így reagál a törlőgomb minden törlésre, a nyomva tartás minden lépését is beleértve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come il tasto elimina reagisce a ogni cancellazione, compreso ogni passaggio mentre lo tieni premuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除のたびに削除キーがどう反応するか。長押し中の各ステップにも適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제할 때마다 삭제 키가 반응하는 방식으로, 길게 누르는 동안의 모든 단계에도 적용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cara kekunci padam bertindak balas pada setiap pemadaman, termasuk setiap langkah semasa ditekan lama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como a tecla Eliminar reage a cada eliminação, incluindo cada passo enquanto é mantida premida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как клавиша удаления отзывается на каждое удаление, в том числе на каждом шаге при удержании."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除键对每次删除的反应方式，包括长按期间的每一步。"
          }
        }
      }
    },
    "How the key moves when pressed. Only applies when Bloom is on.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
