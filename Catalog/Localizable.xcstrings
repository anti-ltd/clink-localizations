          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy sorban mutatja a legutóbbi emojikat. Állítsd be, hányat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le emoji recenti in fila. Scegli quante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近使った絵文字を横一列に並べます。個数を選べます。"
