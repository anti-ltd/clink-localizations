    "Learned words show up in the suggestion bar as you type.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangeleerde woorde verskyn in die voorstelbalk terwyl jy tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelernte Wörter erscheinen beim Tippen in der Vorschlagsleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras aprendidas aparecen en la barra de sugerencias mientras escribes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Õpitud sõnad ilmuvad tipimise ajal soovituseribale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots appris apparaissent dans la barre de suggestions pendant que tu tapes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megtanult szavak gépelés közben megjelennek a javaslatsávban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole apprese compaiono nella barra dei suggerimenti mentre scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習した単語は入力中に変換候補バーに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학습한 단어는 입력할 때 추천 바에 나타나요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataan yang dipelajari muncul pada bar cadangan semasa anda menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras aprendidas aparecem na barra de sugestões enquanto escreves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выученные слова появляются в строке подсказок по ходу печати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学会的词会在你输入时出现在候选栏。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuvintele învățate apar în bara de sugestii pe măsură ce tastați."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geleerde woorden verschijnen in de suggestiebalk terwijl u typt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "學會的詞會在你輸入時出現在候選欄。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauczone słowa pojawiają się na pasku sugestii podczas pisania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивчені слова відображаються на панелі пропозицій під час введення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğrenilen kelimeler siz yazdıkça öneri çubuğunda görünür."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naučená slova se během psaní zobrazují na liště návrhů."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naučené slová sa počas písania zobrazujú na paneli návrhov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι μαθημένες λέξεις εμφανίζονται στη γραμμή προτάσεων καθώς πληκτρολογείτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inlärda ord visas i förslagsfältet medan du skriver."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lærte ord vises i forslagslinjen, mens du skriver."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lærte ord vises i forslagslinjen mens du skriver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Opitut sanat näkyvät ehdotuspalkissa kirjoittaessasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata-kata yang dipelajari muncul di bilah saran saat Anda mengetik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các từ đã học sẽ hiển thị trên thanh gợi ý khi bạn nhập."
          }
        }
      }
    },
