            "state": "translated",
            "value": "Largeur totale de la bande. Les autres touches de la rangée cèdent la place."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sáv teljes szélessége. A sor többi billentyűje helyet ad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Larghezza totale della striscia. Gli altri tasti della riga fanno spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "帯全体の幅です。同じ行のほかのキーが場所を譲ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "띠 전체 너비입니다. 같은 줄의 다른 키가 자리를 내줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar keseluruhan jalur. Kekunci lain dalam baris memberi laluan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Largura total da faixa. As outras teclas da fila cedem espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общая ширина полосы. Остальные клавиши в ряду уступают место."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整条的总宽度。同一行的其他按键会让出空间。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lățimea totală a benzii. Celelalte chei din rând cedează."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Totale breedte van de strip. De andere toetsen in de rij wijken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整條的總寬度。同一行的其他按鍵會讓出空間。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Całkowita szerokość paska. Pozostałe klucze w rzędzie ustępują."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Загальна ширина смуги. Інші клавіші в рядку поступаються."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şeridin toplam genişliği. Sıradaki diğer anahtarlar yol veriyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celková šířka pásu. Ostatní klávesy v řadě ustupují."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Celková šírka pásu. Ostatné klávesy v rade ustúpia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνολικό πλάτος της λωρίδας. Τα άλλα πλήκτρα στη σειρά υποχωρούν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandets totala bredd. De andra nycklarna i raden ger vika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strimlens samlede bredde. De andre nøgler i rækken giver efter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Total bredde på stripen. De andre nøklene i rekken gir etter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhan kokonaisleveys. Muut rivin näppäimet antavat periksi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar total strip. Kunci lain di baris itu memberi jalan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng chiều rộng của dải. Các phím khác trong hàng nhường chỗ."
          }
        }
      }
