    "Typed text stays in this test and is discarded when you close it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Eingabe bleibt in diesem Test und wird beim Schließen gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typed text stays in this test and is discarded when you close it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que escribes permanece en esta prueba y se elimina cuando la cierras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisestatud tekst jääb ainult sellesse testi ja kustutatakse testi sulgemisel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte saisi reste dans ce test et sera effacé à sa fermeture."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beírt szöveg csak ebben a tesztben marad meg, és a teszt bezárásakor törlődik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo digitato rimane in questo test e viene eliminato quando lo chiudi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力した文章はこのテスト内でのみ使用され、テストを閉じると消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력한 내용은 이 테스트에서만 사용되며, 테스트를 닫으면 삭제됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang anda taip hanya digunakan dalam ujian ini dan dipadam apabila ujian ditutup."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que escreves fica apenas neste teste e é apagado quando o fechas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введённый текст используется только в этом тесте и удаляется при его закрытии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入的文字仅用于本次测试，关闭测试后即会清除。"
          }
        }
      }
    },
