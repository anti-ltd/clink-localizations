    "Type a sentence with Clink and leave any mistakes. Then enter what you meant below.": {
      "comment": "Manual Test Lab: explicitly submitted sentence pair, separate from automatic diagnostics.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik ’n sin met Clink en los enige foute. Tik dan hieronder wat jy bedoel het."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napište větu pomocí Clink a případné chyby ponechte. Pak níže napište, co jste měli na mysli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv en sætning med Clink, og lad eventuelle fejl stå. Skriv derefter nedenfor, hvad du mente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib einen Satz mit Clink und lass alle Fehler stehen. Schreib dann darunter, was du gemeint hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γράψτε μια πρόταση με το Clink και αφήστε τυχόν λάθη. Έπειτα γράψτε παρακάτω τι εννοούσατε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una frase con Clink y deja los errores tal como están. Después, escribe debajo lo que querías decir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjuta Clinkiga lause ja jäta vead alles. Seejärel kirjuta allpool, mida tegelikult mõtlesid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita lause Clinkillä ja jätä mahdolliset virheet ennalleen. Kirjoita sitten alle, mitä tarkoitit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris une phrase avec Clink et laisse les erreurs telles quelles. Puis écris en dessous ce que tu voulais dire."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írj egy mondatot a Clinkkel, és hagyd benne a hibákat. Ezután írd le alább, mire gondoltál."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kalimat dengan Clink dan biarkan kesalahannya. Lalu tulis maksud Anda di bawah ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi una frase con Clink e lascia gli eventuali errori. Poi scrivi sotto cosa intendevi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkで文を入力し、間違いがあってもそのままにしてください。その下に、本来入力したかった文を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink로 문장을 입력하고 오류가 있어도 그대로 두세요. 그런 다음 아래에 원래 입력하려던 문장을 적어 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip ayat dengan Clink dan biarkan sebarang kesilapan. Kemudian taip maksud sebenar anda di bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv en setning med Clink, og la eventuelle feil stå. Skriv deretter nedenfor hva du mente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ een zin met Clink en laat eventuele fouten staan. Typ daarna hieronder wat je bedoelde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz zdanie za pomocą Clink i pozostaw ewentualne błędy. Następnie wpisz poniżej, co miało być napisane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve uma frase com o Clink e deixa os erros como estão. Depois, escreve abaixo o que querias dizer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrie o propoziție cu Clink și lasă eventualele greșeli. Apoi scrie mai jos ce ai vrut să spui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишите предложение с помощью Clink и оставьте ошибки как есть. Затем ниже напишите то, что вы имели в виду."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíšte vetu pomocou Clink a prípadné chyby ponechajte. Potom nižšie napíšte, čo ste mali na mysli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv en mening med Clink och låt eventuella fel vara kvar. Skriv sedan nedan vad du menade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ile bir cümle yazın ve hataları olduğu gibi bırakın. Ardından aşağıya ne demek istediğinizi yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишіть речення за допомогою Clink і залиште помилки як є. Потім нижче напишіть те, що ви мали на увазі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập một câu bằng Clink và giữ nguyên các lỗi. Sau đó nhập nội dung bạn muốn viết vào bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Clink 输入一个句子，保留其中的错误。然后在下方输入你原本想表达的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Clink 輸入一個句子，保留其中的錯誤。然後在下方輸入你原本想表達的內容。"
          }
        }
      }
    },
    "Submitting sends both sentences and device details privately to the team. Avoid personal information.": {
      "comment": "Manual Test Lab: explicitly submitted sentence pair, separate from automatic diagnostics.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer jy indien, word albei sinne en toestelbesonderhede privaat aan die span gestuur. Vermy persoonlike inligting."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odesláním se obě věty a údaje o zařízení soukromě předají týmu. Neuvádějte osobní údaje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du sender, deles begge sætninger og enhedsoplysninger privat med teamet. Undgå personlige oplysninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Senden erhält das Team beide Sätze und Geräteinformationen vertraulich. Gib keine persönlichen Informationen ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με την υποβολή, οι δύο προτάσεις και τα στοιχεία της συσκευής αποστέλλονται ιδιωτικά στην ομάδα. Αποφύγετε προσωπικές πληροφορίες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al enviar, las dos frases y los datos del dispositivo se comparten de forma privada con el equipo. Evita incluir información personal."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatmisel edastatakse mõlemad laused ja seadme andmed privaatselt meeskonnale. Ära lisa isiklikke andmeid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun lähetät testin, molemmat lauseet ja laitteen tiedot välitetään yksityisesti tiimille. Älä sisällytä henkilötietoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi transmet les deux phrases et les informations sur l’appareil à l’équipe, en privé. Évite les informations personnelles."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beküldéskor a két mondatot és az eszköz adatait privát módon kapja meg a csapat. Ne adj meg személyes adatokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat dikirim, kedua kalimat dan detail perangkat dibagikan secara pribadi kepada tim. Hindari informasi pribadi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’invio condivide privatamente con il team entrambe le frasi e i dettagli del dispositivo. Evita informazioni personali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信すると、両方の文と端末情報がチームに非公開で共有されます。個人情報は入力しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제출하면 두 문장과 기기 정보가 팀에 비공개로 전달됩니다. 개인정보는 입력하지 마세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila dihantar, kedua-dua ayat dan butiran peranti dikongsi secara peribadi dengan pasukan. Elakkan maklumat peribadi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du sender inn, deles begge setningene og enhetsopplysninger privat med teamet. Unngå personopplysninger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij het versturen worden beide zinnen en apparaatgegevens privé met het team gedeeld. Vermijd persoonlijke informatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po wysłaniu oba zdania i dane urządzenia trafią prywatnie do zespołu. Nie podawaj danych osobowych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao enviar, ambas as frases e os dados do dispositivo são partilhados em privado com a equipa. Evita informações pessoais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La trimitere, cele două propoziții și detaliile dispozitivului sunt partajate în privat cu echipa. Evită informațiile personale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При отправке оба предложения и сведения об устройстве передаются команде конфиденциально. Не указывайте личную информацию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odoslaním sa obe vety a údaje o zariadení súkromne odovzdajú tímu. Neuvádzajte osobné údaje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du skickar delas båda meningarna och enhetsinformationen privat med teamet. Undvik personuppgifter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderdiğinizde her iki cümle ve cihaz bilgileri ekiple özel olarak paylaşılır. Kişisel bilgi eklemeyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після надсилання обидва речення та відомості про пристрій конфіденційно передаються команді. Не вказуйте особисту інформацію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi gửi, cả hai câu và thông tin thiết bị sẽ được chia sẻ riêng với nhóm. Tránh nhập thông tin cá nhân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交后，这两个句子和设备信息将私下发送给团队。请勿包含个人信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提交後，這兩個句子和裝置資訊將私下傳送給團隊。請勿包含個人資訊。"
          }
        }
      }
    },
