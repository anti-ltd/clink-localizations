    "Learns where you personally tap vs the key center": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leer waar jy persoonlik tik teenoor die sleutelsentrum"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lernt, wo du persönlich tippst, im Vergleich zur Tastenmitte"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende dónde tocas tú en comparación con el centro de la tecla"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Õpib, kus sa isiklikult vajutad, võrreldes klahvi keskmega"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprend où tu appuies personnellement par rapport au centre de la touche"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megtanulja, hova koppintasz te személyesen a billentyű közepéhez képest"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impara dove tocchi tu rispetto al centro del tasto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの中心に対して、あなたが実際にどこをタップするかを学習します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 중앙 대비 내가 실제로 어디를 누르는지 배워요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belajar di mana anda secara peribadi ketik berbanding tengah kekunci"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende onde tu tocas em comparação com o centro da tecla"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запоминает, куда именно вы нажимаете относительно центра клавиши"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学习你个人点按的位置与键中心的差别"
          }
        }
      }
    },
    "Leave the label blank to show what the key types.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laat die etiket leeg om te wys wat die sleuteltipes is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass die Beschriftung leer, dann zeigt die Taste, was sie tippt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja la etiqueta en blanco para mostrar lo que escribe la tecla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jäta pealdis tühjaks, et näidata, mida klahv sisestab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse l'étiquette vide pour afficher ce que la touche tape."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagyd üresen a címkét, ha azt akarod látni, mit ír a billentyű."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia l'etichetta vuota per mostrare cosa scrive il tasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベルを空欄にすると、そのキーが入力する文字が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이블을 비워 두면 키가 입력하는 내용이 보여요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biar label kosong untuk tunjuk apa yang kekunci itu taip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa a etiqueta em branco para mostrar o que a tecla escreve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте подпись пустой, чтобы показывать то, что клавиша вводит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签留空，就显示这个键打出来的内容。"
          }
        }
      }
    },
    "Leave the label blank to show what the shift key types.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laat die etiket leeg om te wys wat die skuifsleutel tipes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass die Beschriftung leer, um anzuzeigen, was die Umschalttaste eingibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja la etiqueta en blanco para mostrar lo que escribe la tecla de mayúsculas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jäta pealdis tühjaks, et näidata, mida tõstuklahv sisestab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse l'étiquette vide pour afficher ce que la touche Maj saisit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagyd üresen a címkét, hogy a shift billentyű által begépelt karakter jelenjen meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuota l’etichetta per mostrare cosa digita il tasto maiuscole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベルを空にすると、Shiftキーが入力する文字が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라벨을 비워두면 Shift 키가 입력하는 글자가 보여요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biar label kosong untuk tunjuk apa yang ditaip oleh kekunci shift."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa o rótulo em branco para mostrar o que a tecla shift escreve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте подпись пустой, чтобы показывать то, что клавиша вводит с Shift."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签留空，就会显示 Shift 键实际打出来的内容。"
          }
        }
      }
    },
