        }
      }
    },
    "Every letter you type triggers a quick check against the dictionary, language rules, and words you've taught it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke letter wat jy tik veroorsaak 'n vinnige tjek teen die woordeboek, taalreëls en woorde wat jy dit geleer het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Buchstabe, den du tippst, löst eine schnelle Prüfung gegen das Wörterbuch, die Sprachregeln und die Wörter aus, die du ihr beigebracht hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada letra que escribes lanza una comprobación rápida contra el diccionario, las reglas del idioma y las palabras que le has enseñado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga täht, mida tipid, käivitab kiire kontrolli sõnaraamatu, keeli reeglite ja sõnade vastu, mida talle õpetanud oled."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque lettre que tu tapes déclenche une vérif rapide avec le dictionnaire, les règles de langue et les mots que tu lui as appris."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden beírt betű gyors ellenőrzést indít a szótár, a nyelvi szabályok és az általad megtanított szavak alapján."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni lettera che digiti fa scattare un rapido controllo con il dizionario, le regole della lingua e le parole che le hai insegnato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字を打つたびに、辞書、言語ルール、あなたが教えた単語に照らして素早くチェックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자를 하나 칠 때마다 사전, 언어 규칙, 그리고 알려준 단어를 상대로 빠르게 확인해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap huruf yang anda taip mencetuskan semakan pantas terhadap kamus, peraturan bahasa, dan perkataan yang anda ajarkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada letra que escreves aciona uma verificação rápida contra o dicionário, as regras do idioma e as palavras que lhe ensinaste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая напечатанная буква запускает быструю сверку со словарём, правилами языка и словами, которым вы его научили."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打的每个字母都会触发一次快速检查，对照词典、语言规则和你教过它的词。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare literă pe care o introduceți declanșează o verificare rapidă cu dicționarul, regulile de limbă și cuvintele pe care le-ați predat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke letter die u typt, zorgt voor een snelle controle aan de hand van het woordenboek, de taalregels en de woorden die u erin hebt geleerd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你打的每個字母都會觸發一次快速檢查，對照詞典、語言規則和你教過它的詞。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda wpisana litera powoduje szybkie sprawdzenie słownika, zasad języka i słów, których się nauczyłeś."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна літера, яку ви вводите, запускає швидку перевірку за словником, правилами мови та словами, яким ви його навчили."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazdığınız her harf, sözlüğe, dil kurallarına ve öğrettiğiniz kelimelere göre hızlı bir kontrolü tetikler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé písmeno, které napíšete, spustí rychlou kontrolu slovníku, jazykových pravidel a slov, která jste ho naučili."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé zadané písmeno spustí rýchlu kontrolu so slovníkom, jazykovými pravidlami a slovami, ktoré ste ho naučili."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε γράμμα που πληκτρολογείτε ενεργοποιεί έναν γρήγορο έλεγχο σε σχέση με το λεξικό, τους γλωσσικούς κανόνες και τις λέξεις που το έχετε διδάξει."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje bokstav du skriver utlöser en snabb kontroll mot ordboken, språkreglerna och orden du har lärt ut den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert bogstav, du skriver, udløser en hurtig kontrol i forhold til den ordbog, sprogregler og ord, du har lært den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver bokstav du skriver utløser en rask sjekk mot ordboken, språkreglene og ordene du har lært den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen kirjoittamasi kirjain käynnistää nopean tarkistuksen sanakirjan, kielisääntöjen ja sille opettamiesi sanojen suhteen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap huruf yang Anda ketik memicu pemeriksaan cepat terhadap kamus, aturan bahasa, dan kata-kata yang telah Anda ajarkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi chữ cái bạn nhập sẽ kích hoạt việc kiểm tra nhanh từ điển, quy tắc ngôn ngữ và những từ bạn đã dạy."
          }
        }
      }
    },
