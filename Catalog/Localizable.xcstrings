    "Shrink the keyboard and push it to one edge.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Krimp die sleutelbord en druk dit na een kant toe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkleinert die Tastatur und schiebt sie an einen Rand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce el teclado y llévalo a un lado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kahanda klaviatuur ja lükka see ühte serva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétrécit le clavier et le pousse vers un bord."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Összezsugorítja a billentyűzetet, és az egyik szélhez tolja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimpicciolisce la tastiera e la spinge verso un bordo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードを縮めて片側に寄せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드를 줄여서 한쪽 가장자리로 붙입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecilkan papan kekunci dan tolak ia ke satu tepi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encolhe o teclado e empurra-o para uma margem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уменьшает клавиатуру и прижимает её к краю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把键盘缩小并推到一边。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Micșorați tastatura și împingeți-o pe o margine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verklein het toetsenbord en duw het naar één rand."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把鍵盤縮小並推到一邊。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmniejsz klawiaturę i przesuń ją do jednej krawędzi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зменшіть клавіатуру та присуньте її до одного краю."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyeyi küçültün ve bir kenara doğru itin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snižte klávesnici a zatlačte ji k jednomu okraji."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmršte klávesnicu a zatlačte ju k jednému okraju."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συρρικνώστε το πληκτρολόγιο και σπρώξτε το στη μία άκρη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Krymp tangentbordet och tryck det till ena kanten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Krymp tastaturet og skub det til den ene kant."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krymp tastaturet og skyv det til en kant."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutista näppäimistöä ja työnnä se toiseen reunaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecilkan keyboard dan dorong ke satu sisi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu nhỏ bàn phím và đẩy nó sang một cạnh."
          }
        }
      }
    },
