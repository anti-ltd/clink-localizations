        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva la Corrección automática y deja la Barra de sugerencias activada si aún quieres las tres sugerencias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita Automaatparandus välja ja jäta Soovituseriba sisse, kui soovid kolm soovitust ikka."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive la Correction automatique, et laisse la Barre de suggestions active si tu veux garder les trois suggestions."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold ki az Automatikus javítást, és hagyd bekapcsolva a Javaslatsávot, ha kellenek a javaslatok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva la Correzione automatica e lascia attiva la Barra dei suggerimenti se vuoi ancora i tre suggerimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動修正」をオフにします。3つの候補を残したいときは「候補バー」はオンのままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 수정을 끄고, 추천 세 개는 계속 보고 싶다면 추천 바는 켠 채로 두세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan Pembetulan automatik, dan biarkan Bar cadangan hidup jika anda masih mahukan tiga cadangan itu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga a Correção automática e deixa a Barra de sugestões ligada se ainda quiseres as três sugestões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите автокоррекцию, а «Строку подсказок» оставьте включённой, если хотите сохранить три варианта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关掉“自动更正”；如果还想要那三个建议，就把“建议栏”留着。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivați corecția automată și lăsați bara de sugestii activată dacă doriți în continuare cele trei sugestii."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel automatische correctie uit en laat de suggestiebalk ingeschakeld als u nog steeds de drie suggesties wilt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關掉“自動更正”；如果還想要那三個建議，就把“建議欄”留著。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz automatyczną korektę i pozostaw pasek sugestii włączony, jeśli nadal chcesz korzystać z trzech sugestii."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкніть автоматичне виправлення та залиште панель пропозицій увімкненою, якщо вам усе ще потрібні три пропозиції."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik düzeltmeyi kapatın ve hâlâ üç öneriyi istiyorsanız Öneri çubuğunu açık bırakın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypněte automatické opravy a ponechte panel návrhů zapnutý, pokud stále chcete tři návrhy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnite automatické opravy a ponechajte panel návrhov zapnutý, ak stále chcete tri návrhy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιήστε την Αυτόματη διόρθωση και αφήστε τη γραμμή προτάσεων ενεργοποιημένη εάν θέλετε ακόμα τις τρεις προτάσεις."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stäng av automatisk korrigering och lämna förslagsfältet på om du fortfarande vill ha de tre förslagen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå automatisk korrektion fra, og lad forslagslinjen være tændt, hvis du stadig vil have de tre forslag."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå av automatisk korrigering, og la forslagslinjen stå på hvis du fortsatt vil ha de tre forslagene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista automaattinen korjaus käytöstä ja jätä ehdotuspalkki päälle, jos haluat edelleen kolme ehdotusta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan Koreksi Otomatis, dan biarkan bilah Saran tetap menyala jika Anda masih menginginkan ketiga saran tersebut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt Tự động sửa và bật thanh Đề xuất nếu bạn vẫn muốn có ba đề xuất."
          }
        }
      }
    },
