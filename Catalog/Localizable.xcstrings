            "state": "translated",
            "value": "Las teclas centellean al azar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvid vilguvad juhuslikult sisse ja välja."
          }
        },
        "fr": {
