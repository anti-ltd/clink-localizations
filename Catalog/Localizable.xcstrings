        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点工具即可打开。"
          }
        }
      }
    },
    "Tap a tool to set it up, tap its status for on/off and picker visibility, hold and drag to reorder.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik 'n nutsding om dit op te stel, tik sy status vir aan/af en kiesersigbaarheid, hou en sleep om te herrangskik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Tool, um es einzurichten, tippe auf seinen Status für An/Aus und Sichtbarkeit im Picker, halte und ziehe zum Umsortieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una herramienta para configurarla, toca su estado para activarla/desactivarla y su visibilidad en el selector, mantén pulsado y arrastra para reordenar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta tööriistal, et see seadistada, puuduta selle olekul sisse/välja ja valija nähtavuse jaoks, hoia ja lohista järjestamiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un outil pour le configurer, touche son statut pour l'activer/désactiver et sa visibilité dans le sélecteur, maintiens et fais glisser pour réordonner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy eszközre a beállításához, koppints az állapotára a be/ki kapcsoláshoz és a választóban való láthatósághoz, tartsd lenyomva és húzd az átrendezéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca uno strumento per configurarlo, tocca il suo stato per attivarlo/disattivarlo e per la visibilità nel selettore, tieni premuto e trascina per riordinare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールをタップして設定、ステータスをタップしてオン/オフとピッカーへの表示を切り替え、長押ししてドラッグで並べ替えできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구를 탭해서 설정하고, 상태를 탭해서 켜기/끄기와 피커 표시 여부를 바꾸고, 꾹 눌러서 드래그하면 순서를 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik alat untuk sediakannya, ketik statusnya untuk hidup/mati dan keterlihatan pemilih, tahan dan seret untuk susun semula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca numa ferramenta para a configurares, toca no estado para ligar/desligar e visibilidade no seletor, mantém premido e arrasta para reordenar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на инструмент, чтобы настроить его; нажмите на его состояние, чтобы включить или выключить и задать видимость в выборе; удерживайте и перетаскивайте, чтобы изменить порядок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下工具进行设置，点它的状态可以开关并控制是否在选择器中显示，按住拖动可调整顺序。"
          }
        }
      }
    },
    "Tap a tool to set it up, tap its status to choose where it shows up, hold and drag to reorder.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik 'n instrument om dit op te stel, tik op sy status om te kies waar dit verskyn, hou en sleep om te herrangskik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp auf ein Werkzeug, um es einzurichten, tipp auf seinen Status, um zu wählen, wo es auftaucht, halte und zieh es, um die Reihenfolge zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una herramienta para configurarla, toca su estado para elegir dónde aparece, y mantén pulsado y arrastra para reordenar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta tööriistal, et see seadistada, puuduta selle olekul, et valida, kus see ilmub, hoia ja lohista järjestamiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un outil pour le configurer, touche son état pour choisir où il apparaît, maintiens et fais glisser pour réorganiser."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy eszközre a beállításához, koppints az állapotára, hogy megválaszd, hol jelenjen meg, és tartsd nyomva, majd húzd az átrendezéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca uno strumento per configurarlo, tocca il suo stato per scegliere dove compare, tieni premuto e trascina per riordinare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールをタップすると設定でき、ステータスをタップすると表示場所を選べます。長押しでドラッグすれば並べ替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구를 누르면 설정하고, 상태를 누르면 어디에 나타날지 고르고, 길게 눌러 끌면 순서를 바꿉니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik alat untuk menyediakannya, ketik statusnya untuk memilih tempat ia muncul, tekan dan seret untuk menyusun semula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca numa ferramenta para a configurar, toca no estado para escolher onde aparece, e mantém premido e arrasta para reordenar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на инструмент, чтобы настроить его; нажмите на его состояние, чтобы выбрать, где он появляется; удерживайте и перетаскивайте, чтобы изменить порядок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按工具进行设置，点按状态选择它出现的位置，长按拖动可调整顺序。"
          }
        }
      }
    },
    "Tap a tool's status to quickly modify it": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
