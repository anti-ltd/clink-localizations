    "Warp the glass under your finger as you press each key, like the shift key.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai die glas onder jou vinger terwyl jy elke sleutel druk, soos die shift-sleutel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzieht das Glas unter deinem Finger, während du jede Taste drückst, wie bei der Umschalttaste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deforma el cristal bajo tu dedo al pulsar cada tecla, como la de mayúsculas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonutab klaasi su sõrme all, kui iga klahvi vajutad, nagu tõstuklahvi puhul."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déforme le verre sous ton doigt à chaque appui sur une touche, comme la touche Majuscule."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomd meg a billentyűt, és az üveg behajlik az ujjad alatt, ahogy a Shiftnél is."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Deforma il vetro sotto il dito quando premi un tasto, come fa il tasto Maiuscole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフトキーのように、キーを押すと指の下のガラスがへこみます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 키처럼 키를 누를 때마다 손가락 아래 유리가 눌리듯 휘어져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lentikkan kaca di bawah jari anda setiap kali tekan kekunci, macam kekunci shift."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Distorce o vidro debaixo do teu dedo ao carregar em cada tecla, como a tecla Shift."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Искажать стекло под пальцем при нажатии каждой клавиши — как у клавиши Shift."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下每个键时，让手指下方的玻璃轻轻变形，就像 Shift 键那样。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deformați sticla sub deget în timp ce apăsați fiecare tastă, cum ar fi tasta Shift."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervorm het glas onder uw vinger terwijl u op elke toets drukt, zoals de Shift-toets."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下每個鍵時，讓手指下方的玻璃輕輕變形，就像 Shift 鍵那樣。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas naciskania każdego klawisza, na przykład klawisza Shift, wyginaj szkło pod palcem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деформуйте скло під пальцем, натискаючи кожну клавішу, як клавішу shift."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift tuşu gibi her tuşa bastığınızda camı parmağınızın altına doğru bükün."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při stisku každé klávesy pokřivte sklo pod prstem, jako je klávesa Shift."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri stláčaní jednotlivých klávesov pokrčte sklo pod prstom, napríklad kláves Shift."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στραβώστε το γυαλί κάτω από το δάχτυλό σας καθώς πατάτε κάθε πλήκτρο, όπως το πλήκτρο Shift."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Böj glaset under fingret när du trycker på varje tangent, som skifttangenten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordrej glasset under din finger, mens du trykker på hver tast, ligesom Shift-tasten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vri glasset under fingeren når du trykker på hver tast, som shift-tasten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taivuta lasia sormesi alla, kun painat kutakin näppäintä, kuten vaihtonäppäintä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengkungkan kaca di bawah jari Anda saat Anda menekan setiap tombol, seperti tombol shift."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm cong mặt kính dưới ngón tay của bạn khi bạn nhấn từng phím, giống như phím shift."
          }
        }
      }
    },
