    "One dial takes them from fully rounded to square-edged.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem einzigen Drehregler wechselst du von vollständig abgerundeten zu eckigen Tasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo dial permite pasar de bordes totalmente redondeados a esquinas rectas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühe nupuga saad muuta kuju täiesti ümarast kandiliseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule commande rotative permet de passer de bords entièrement arrondis à des angles droits."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen tárcsával állíthatod a formát a teljesen lekerekítettől a szögletesig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo selettore permette di passare da bordi completamente arrotondati ad angoli retti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つのダイヤルで、丸みのある形から角ばった形まで調整できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다이얼 하나로 둥근 모양부터 각진 모양까지 조절할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu dail melaraskannya daripada bulat sepenuhnya hingga bersudut tepat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um único seletor permite passar de bordos totalmente arredondados a cantos retos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одним регулятором можно менять форму от полностью скруглённой до прямоугольной."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个旋钮就能将按键从圆润调到方正。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cadran le duce de la rotunjite complet la marginile pătrate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén wijzerplaat brengt ze van volledig afgerond naar vierkant."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個旋鈕就能將按鍵從圓潤調到方正。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Een draaiknop verander hulle van heeltemal rond na vierkantig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno pokrętło zmienia je z całkowicie zaokrąglonych na kwadratowe."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один циферблат змінює їх від повністю закруглених до квадратних."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kadran onları tam yuvarlaktan kare kenarlıya götürür."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden ciferník je převede od zcela zaoblených po hranaté."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden ciferník ich prevedie od úplne zaoblených po hranaté."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα καντράν τα παίρνει από πλήρως στρογγυλεμένα σε τετράγωνα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En urtavla tar dem från helt rundade till fyrkantiga kanter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En urskive tager dem fra helt afrundede til firkantede."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En urskive tar dem fra helt avrundet til firkantet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi kellotaulu vie ne täysin pyöristetystä neliömäiseen."
          }
        },
        "id": {
