    "Flag and code fall back to the globe for a language with no flag artwork or no region code.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlag en kode val terug na die wêreld vir 'n taal met geen vlagkunswerk of geen streekkode nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagge und Kürzel weichen auf den Globus aus, wenn eine Sprache kein Flaggenbild oder keinen Regionscode hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bandera y el código pasan al globo terráqueo cuando un idioma no tiene ilustración de bandera ni código de región."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipp ja kood taanduvad gloobusele keele puhul, millel pole lipu pilti ega piirkonnakoodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le drapeau et le code laissent place au globe pour une langue sans visuel de drapeau ni code de région."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A zászló és a kód helyett a földgömb jelenik meg, ha egy nyelvhez nincs zászlókép vagy régiókód."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandiera e codice lasciano il posto al globo per una lingua senza immagine della bandiera o senza codice di regione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旗の絵や地域コードがない言語では、フラッグやコードの代わりに地球儀が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국기 이미지나 지역 코드가 없는 언어에서는 국기와 코드 대신 지구본이 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bendera dan kod bertukar kepada glob bagi bahasa yang tiada imej bendera atau tiada kod wilayah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A bandeira e o código dão lugar ao globo num idioma sem imagem de bandeira ou sem código de região."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если у языка нет флага или кода региона, вместо них показывается глобус."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若某种语言没有国旗图案或地区代码，国旗和代码会改用地球图标。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Steagul și codul se întorc pe glob pentru o limbă fără ilustrație de steag sau fără cod de regiune."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlag en code vallen terug op de wereldbol voor een taal zonder vlagillustraties of regiocode."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若某種語言沒有國旗圖案或地區程式碼，國旗和程式碼會改用地球圖示。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaga i kod odnoszą się do całego świata w przypadku języka bez grafiki flagi lub kodu regionu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прапор і код повертаються до земної кулі для мови без зображення прапора чи коду регіону."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayrak resmi veya bölge kodu olmayan bir dil için bayrak ve kod dünyaya aittir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlajka a kód spadají zpět do zeměkoule pro jazyk bez kresby vlajky nebo kódu regionu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlajka a kód spadajú späť do zemegule pre jazyk bez obrázka vlajky alebo kódu regiónu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σημαία και ο κωδικός επιστρέφουν στον κόσμο για μια γλώσσα χωρίς έργο τέχνης σημαίας ή χωρίς κωδικό περιοχής."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagga och kod faller tillbaka till världen för ett språk utan flaggkonstverk eller ingen regionkod."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flag og kode falder tilbage til kloden for et sprog uden flagkunst eller ingen regionskode."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagg og kode faller tilbake til kloden for et språk uten flaggkunstverk eller ingen regionkode."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lippu ja koodi palautuvat maapallolle kielelle, jossa ei ole lippukuviota tai aluekoodia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bendera dan kode kembali ke globe untuk bahasa tanpa karya seni bendera atau tanpa kode wilayah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cờ và mã rơi trở lại hình ảnh địa cầu đối với một ngôn ngữ không có hình ảnh cờ hoặc không có mã vùng."
          }
        }
      }
    },
