        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão abaixo leva-te até lá"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка ниже приведёт вас туда"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
