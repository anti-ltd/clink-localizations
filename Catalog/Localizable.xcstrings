          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A setting(), a set_setting() és a release() ugyanezeket az azonosítókat fogadja. A szürke szöveg mutatja, mit fogad el mindegyik."
          }
        },
        "it": {
          "stringUnit": {
