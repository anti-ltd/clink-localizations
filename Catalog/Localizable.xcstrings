    "Instant highlight on · no linger · no min highlight · bloom off. Stock-keyboard snap.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iluminación instantánea · sin persistencia ni duración mínima · resplandor desactivado. Respuesta como el teclado del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éclairage instantané · sans maintien ni durée minimale · halo désactivé. Réactivité du clavier système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofortiges Aufleuchten · kein Nachleuchten · keine Mindestdauer · Bloom aus. Direkt wie die Systemtastatur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Illuminazione istantanea · nessuna persistenza o durata minima · bagliore disattivato. Reattività da tastiera di sistema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iluminação instantânea · sem persistência nem duração mínima · brilho difuso desligado. Resposta do teclado do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мгновенная подсветка · без задержки и минимальной длительности · свечение выключено. Отклик как у системной клавиатуры."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorotan serta-merta · tiada pengekalan atau tempoh minimum · cahaya kembang dimatikan. Respons seperti papan kekunci sistem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azonnali kiemelés · nincs késleltetés vagy minimális időtartam · ragyogás kikapcsolva. A rendszerbillentyűzet közvetlen reakciója."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "即時ハイライト・余韻なし・最短表示時間なし・ブルームオフ。標準キーボードのような素早い反応です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即时高亮开启，无停留、无最短高亮时间，泛光关闭。响应如系统键盘般利落。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 강조 켜짐 · 잔상 및 최소 표시 시간 없음 · 블룸 꺼짐. 기본 키보드처럼 즉각 반응합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohene esiletõst · järelhelenduseta · miinimumkestuseta · kuma väljas. Vahetu nagu süsteemiklaviatuur."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Evidențiere instantanee · nu zăbovi · fără evidențiere minimă · înflorire oprit. Snap de tastatură."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instant hoogtepunt aan · geen blijven hangen · geen min hoogtepunt · bloei uit. Standaard toetsenbordmodule."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時高亮開啟，無停留、無最短高亮時間，泛光關閉。響應如系統鍵盤般利落。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Onmiddellike uitlig aan · geen vertraging · geen minimum uitlig · gloed af. Standaard-sleutelbord-snap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiastowe rozjaśnienie · bez opóźnień · bez min. · rozkwit. Zatrzask klawiatury."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Миттєве підсвічування · без затримки · без мінімального підсвічування · вимкнення розквіту. Прив'язка стандартної клавіатури."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anında vurgulama açık · oyalanma yok · en az vurgulama yok · çiçek açma. Stok klavye eki."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Okamžité zvýraznění · žádné prodlévání · žádné minimální zvýraznění · odkvetlé. Pažba-klávesnice snap."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Okamžité zvýraznenie · bez zdržania · bez minimálneho zvýraznenia · odkvitnutie. Skladová klávesnica."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άμεση επισήμανση ενεργή · χωρίς καθυστέρηση · χωρίς ελάχιστη επισήμανση · άνθηση απενεργοποιημένη. Στιγμιότυπο στοκ-πληκτρολόγιο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omedelbar highlight på · ingen dröja · ingen min highlight · blomma av. Stock-tangentbordssnäpp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Øjeblikkelig fremhævning på · ingen dvælende · ingen min fremhævning · blomstrer af. Stock-tastatur snap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Øyeblikkelig fremheving på · ingen dveling · ingen min fremheving · blomstrer av. Lager-tastatur snap."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välitön korostus päällä · ei viipyä · ei min korostus · kukinta pois päältä. Stock-näppäimistön napsautus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorotan instan aktif · tidak berlama-lama · tidak ada sorotan minimum · mekar. Jepretan keyboard stok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm nổi bật ngay lập tức · không nán lại · không cần làm nổi bật phút · phai màu. Snap bàn phím chứng khoán."
          }
        }
      }
    },
