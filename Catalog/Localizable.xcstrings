    "This is an event action. Closing a panel or running a command does not create an undo rule.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una acción de evento. Cerrar un panel o ejecutar un comando no crea una regla para deshacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est une action d’événement. Fermer un panneau ou exécuter une commande ne crée pas de règle d’annulation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine Ereignisaktion. Das Schließen eines Panels oder Ausführen eines Befehls erstellt keine Rückgängig-Regel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è un’azione su evento. Chiudere un pannello o eseguire un comando non crea una regola di annullamento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma ação de evento. Fechar um painel ou executar um comando não cria uma regra para anular a ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это действие по событию. Закрытие панели или выполнение команды не создаёт правило отмены."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tindakan peristiwa. Menutup panel atau menjalankan arahan tidak mencipta peraturan buat asal."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez egy eseményművelet. A panel bezárása vagy parancs futtatása nem hoz létre visszavonási szabályt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはイベントアクションです。パネルを閉じたりコマンドを実行したりしても、元に戻すルールは作成されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是事件操作。关闭面板或运行命令不会创建撤销规则。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트 동작입니다. 패널을 닫거나 명령을 실행해도 되돌리기 규칙이 생성되지는 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on sündmuse toiming. Paneeli sulgemine või käsu käivitamine ei loo tagasivõtmisreeglit."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta este o acțiune de eveniment. Închiderea unui panou sau rularea unei comenzi nu creează o regulă de anulare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een evenementenactie. Het sluiten van een paneel of het uitvoeren van een opdracht creëert geen regel voor ongedaan maken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是事件操作。關閉面板或執行命令不會建立撤銷規則。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is 'n gebeurtenisaksie. Die sluiting van 'n paneel of die uitvoering van 'n opdrag skep nie 'n \"ontdoen\"-reël nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jest akcja eventowa. Zamknięcie panelu lub uruchomienie polecenia nie powoduje utworzenia reguły cofania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це подія. Закриття панелі або виконання команди не створює правило скасування."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir etkinlik eylemidir. Bir paneli kapatmak veya bir komutu çalıştırmak geri alma kuralı oluşturmaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je akce události. Zavření panelu nebo spuštění příkazu nevytvoří pravidlo vrácení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je akcia udalosti. Zatvorenie panelu alebo spustenie príkazu nevytvorí pravidlo vrátenia späť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή είναι μια δράση εκδήλωσης. Το κλείσιμο ενός πίνακα ή η εκτέλεση μιας εντολής δεν δημιουργεί κανόνα αναίρεσης."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta är en händelseåtgärd. Att stänga en panel eller köra ett kommando skapar ingen ångraregel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en begivenhedshandling. At lukke et panel eller køre en kommando opretter ikke en fortrydelsesregel."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en hendelseshandling. Å lukke et panel eller kjøre en kommando oppretter ikke en angreregel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on tapahtumatoiminto. Paneelin sulkeminen tai komennon suorittaminen ei luo kumoamissääntöä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah tindakan acara. Menutup panel atau menjalankan perintah tidak membuat aturan pembatalan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là một hành động sự kiện. Việc đóng một bảng điều khiển hoặc chạy một lệnh không tạo ra quy tắc hoàn tác."
          }
        }
      }
    },
    "This is the instruction handed to the on-device model. Edit it to change how this action behaves.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is die instruksie wat aan die model op die toestel gegee word. Wysig dit om te verander hoe hierdie handeling optree."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist die Anweisung, die an das Modell auf dem Gerät geht. Bearbeite sie, um zu ändern, wie sich diese Aktion verhält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es la instrucción que recibe el modelo del dispositivo. Edítala para cambiar cómo se comporta esta acción."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on juhis, mis antakse seadmesisesele mudelile. Muuda seda, et muuta selle tegevuse käitumist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est l'instruction envoyée au modèle sur l'appareil. Modifie-la pour changer le comportement de cette action."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt az utasítást kapja az eszközön futó modell. Szerkeszd, ha meg akarod változtatni, hogyan működik ez a művelet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è l’istruzione che passi al modello sul dispositivo. Modificala per cambiare il comportamento di questa azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはデバイス内のモデルに渡す指示です。編集するとこのアクションの動きが変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이건 기기 안의 모델에 전달되는 지시문이에요. 이 동작이 어떻게 작동할지 바꾸려면 여기를 고치세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini arahan yang diberi kepada model dalam peranti. Edit untuk ubah cara tindakan ini berfungsi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a instrução dada ao modelo no dispositivo. Edita-a para mudar como esta ação se comporta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это указание, которое передаётся модели на устройстве. Измените его, чтобы поменять поведение действия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是给设备上模型的指令。改一改，就能改变这个操作的行为。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta este instrucțiunea transmisă modelului de pe dispozitiv. Editați-l pentru a schimba modul în care se comportă această acțiune."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is de instructie die wordt gegeven aan het model op het apparaat. Bewerk het om te wijzigen hoe deze actie zich gedraagt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是給裝置上模型的指令。改一改，就能改變這個操作的行為。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jest instrukcja przekazywana modelowi na urządzeniu. Edytuj go, aby zmienić sposób działania tej akcji."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це інструкція, передана моделі пристрою. Відредагуйте його, щоб змінити спосіб поведінки цієї дії."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, cihazdaki modele verilen talimattır. Bu eylemin nasıl davranacağını değiştirmek için düzenleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je instrukce předaná modelu na zařízení. Upravte jej, abyste změnili chování této akce."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je pokyn odovzdaný modelu na zariadení. Upravte ho, aby ste zmenili správanie tejto akcie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή είναι η οδηγία που δίνεται στο μοντέλο της συσκευής. Επεξεργαστείτε το για να αλλάξετε τον τρόπο συμπεριφοράς αυτής της ενέργειας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta är instruktionen som lämnas till modellen på enheten. Redigera den för att ändra hur den här åtgärden beter sig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er instruktionen, der gives til modellen på enheden. Rediger den for at ændre, hvordan denne handling opfører sig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er instruksjonene som leveres til modellen på enheten. Rediger den for å endre hvordan denne handlingen oppfører seg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on laitteen mallille annettu ohje. Muokkaa sitä muuttaaksesi tämän toiminnon toimintaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah instruksi yang diserahkan ke model pada perangkat. Edit untuk mengubah perilaku tindakan ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là hướng dẫn được cung cấp cho kiểu máy trên thiết bị. Chỉnh sửa nó để thay đổi cách hành động này hoạt động."
          }
        }
      }
    },
