        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 빠르고 분주하게, 더 작은 조각으로."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih pantas dan sibuk, dalam cebisan lebih kecil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais rápido e movimentado, em peças mais pequenas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрее и живее, мелкими кусочками."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更快更热闹，颗粒更小。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiirem ja tihedam, väiksemates osades."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vinniger en besiger, in kleiner stukke."
          }
        }
