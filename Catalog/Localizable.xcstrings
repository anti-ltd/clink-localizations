    "Each background has a unique reaction.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke agtergrond het 'n unieke reaksie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Hintergrund hat seine eigene Reaktion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada fondo tiene una reacción única."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Igal taustal on oma ainulaadne reaktsioon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fond a sa propre réaction."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden háttérnek egyedi reakciója van."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni sfondo ha una reazione unica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景ごとに独自の反応があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경마다 고유한 반응이 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap latar belakang mempunyai reaksi yang unik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada fundo tem uma reação única."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждой фоновой темы своя уникальная реакция."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个背景都有独特的反应。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare fundal are o reacție unică."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke achtergrond heeft een unieke reactie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個背景都有獨特的反應。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde tło ma wyjątkową reakcję."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен фон має унікальну реакцію."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her arka planın benzersiz bir tepkisi vardır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé pozadí má jedinečnou reakci."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé pozadie má jedinečnú reakciu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε φόντο έχει μια μοναδική αντίδραση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje bakgrund har en unik reaktion."
          }
        },
