    "Edit this layout right in the preview above. Tap a key to change it, drag keys to rearrange, and use the + buttons to add keys and rows.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wysig hierdie uitleg reg in die voorskou hierbo. Tik 'n sleutel om dit te verander, sleep sleutels om te herrangskik, en gebruik die +-knoppies om sleutels en rye by te voeg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeite dieses Layout direkt in der Vorschau oben. Tipp auf eine Taste, um sie zu ändern, zieh Tasten zum Umsortieren und nimm die +-Tasten, um Tasten und Reihen hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita este diseño aquí mismo, en la vista previa de arriba. Toca una tecla para cambiarla, arrastra las teclas para reordenarlas y usa los botones + para añadir teclas y filas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuda seda paigutust otse ülalolevas eelvaates. Puuduta klahvi selle muutmiseks, lohista klahve ümberkorraldamiseks ja kasuta + nuppe klahvide ning ridade lisamiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie cette disposition directement dans l'aperçu au-dessus. Touche une touche pour la changer, fais glisser les touches pour les réorganiser, et sers-toi des boutons + pour ajouter des touches et des rangées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szerkeszd ezt az elrendezést egyből a fenti előnézetben. Koppints egy billentyűre, hogy megváltoztasd, húzd a billentyűket az átrendezéshez, a + gombokkal pedig új billentyűt és sort adhatsz hozzá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica questo layout direttamente nell'anteprima qui sopra. Tocca un tasto per cambiarlo, trascina i tasti per spostarli e usa i pulsanti + per aggiungere tasti e righe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレイアウトは上のプレビューでそのまま編集できます。キーをタップして変更し、ドラッグして並べ替え、+ ボタンでキーや行を追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 미리보기에서 바로 이 레이아웃을 편집하세요. 키를 탭해서 바꾸고, 드래그해서 옮기고, + 버튼으로 키와 줄을 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunting susun atur ini terus dalam pratonton di atas. Ketik kekunci untuk ubah, seret kekunci untuk susun semula, dan guna butang + untuk tambah kekunci dan baris."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita este esquema já aqui na pré-visualização acima. Toca numa tecla para a mudar, arrasta as teclas para as reorganizar e usa os botões + para acrescentar teclas e linhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правьте эту раскладку прямо в предпросмотре выше. Нажмите на клавишу, чтобы её изменить, перетаскивайте клавиши, чтобы поменять порядок, а кнопками + добавляйте клавиши и ряды."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接在上面的预览里改这个布局。点一个键就能改，拖动按键能重新排，用 + 按钮加键、加行。"
          }
        }
      }
    },
