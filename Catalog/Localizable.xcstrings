    "Turn the Profile Switcher on and you can swap profiles from the keyboard itself.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte den Profilwechsler ein, dann tauschst du Profile direkt auf der Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el Cambio de perfil y podrás cambiar de perfil desde el propio teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active le Changeur de profil et tu changes de profil depuis le clavier lui-même."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a Profilváltót, és magáról a billentyűzetről válthatsz profilt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva il Cambio profilo e puoi passare da un profilo all'altro dalla tastiera stessa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「プロファイル切り替え」をオンにすると、キーボード上でプロファイルを切り替えられます。"
