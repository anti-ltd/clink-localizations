        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op de dop is precies te zien welke toetssoorten er zijn. Kies het personage uit het Actiepalet."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
