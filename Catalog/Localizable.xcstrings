        }
      }
    },
    "Yes. Tools only swaps the whole app for one screen: a pad you can talk into, the AI tools, and whichever tools you've turned on.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja. Gereedskap verruil net die hele toepassing vir een skerm: 'n blok waarmee jy kan praat, die KI-nutsgoed, en watter nutsgoed jy ook al aangeskakel het."
          }
        },
        "de": {
          "stringUnit": {
