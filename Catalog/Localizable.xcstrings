    "Tap reset on its row, or reset the lot if it's got away from you.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in ihrer Zeile auf Zurücksetzen, oder setz gleich alles zurück, wenn es zu viel geworden ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca restablecer en su fila, o restablécelo todo si se te ha ido de las manos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Réinitialiser sur sa ligne, ou remets tout à zéro si ça t'a échappé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a sorában a visszaállításra, vagy állítsd vissza az egészet, ha elszaladt a dolog."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ripristina sulla sua riga, o ripristina tutto se ti è sfuggito di mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その行のリセットをタップします。収拾がつかないときは、まとめてリセットもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 줄의 되돌리기를 누르세요. 너무 많이 손댔다면 전체를 되돌려도 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik tetapkan semula pada barisnya, atau tetapkan semula kesemuanya jika ia sudah terlalu jauh."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em repor na linha dela, ou repõe tudo se a coisa te fugiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Сбросить» в её строке — или сбросьте всё, если дело зашло далеко."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点这一行的还原；要是改得太乱，也可以整体还原。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta selle real Lähtesta või lähtesta kõik, kui see on kontrollist väljunud."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik terugstel op sy ry, of stel die lot terug as dit van jou af weggekom het."
