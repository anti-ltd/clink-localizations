          "stringUnit": {
            "state": "translated",
            "value": "CC-BY-SA-leksikons is ook in die Clink-iOS-repo sonder DRM."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die CC-BY-SA-Lexika liegen auch im Clink-iOS-Repo, ohne DRM."
