        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írj egy kicsit részletesebben: egy-két mondat bőven elég."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう少し詳しく書いてください。1〜2文で十分です。"
