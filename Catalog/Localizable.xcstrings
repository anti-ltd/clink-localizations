    "Do my settings follow me to my other devices?": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg my instellings my na my ander toestelle?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommen meine Einstellungen auf meine anderen Geräte?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Mis ajustes me siguen a mis otros dispositivos?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas mu seaded järgnevad mulle teistesse seadmetesse?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes réglages me suivent-ils sur mes autres appareils ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Átjönnek a beállításaim a többi eszközömre?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie impostazioni mi seguono sugli altri dispositivi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定はほかの端末にも引き継がれますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 설정이 다른 기기에도 따라오나요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah tetapan saya ikut ke peranti lain?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As minhas definições vão comigo para os outros dispositivos?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переезжают ли мои настройки на другие устройства?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的设置会跟到别的设备上吗？"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setările mele mă urmăresc pe celelalte dispozitive ale mele?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volgen mijn instellingen mij naar mijn andere apparaten?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我的設定會跟到別的裝置上嗎？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy moje ustawienia śledzą mnie na innych urządzeniach?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи відображаються мої налаштування на інших пристроях?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarım beni diğer cihazlarıma kadar takip ediyor mu?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasledují mě moje nastavení na ostatní zařízení?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasledujú moje nastavenia do ostatných zariadení?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ρυθμίσεις μου με ακολουθούν στις άλλες συσκευές μου;"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följer mina inställningar mig till mina andra enheter?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følger mine indstillinger mig til mine andre enheder?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følger innstillingene mine meg til de andre enhetene mine?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraavatko asetukseni minua muille laitteilleni?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah pengaturan saya mengikuti saya ke perangkat saya yang lain?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt của tôi có theo tôi đến các thiết bị khác không?"
