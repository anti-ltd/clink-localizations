            "value": "Затем продлевается ежемесячно. Отмена в любое время."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemudian diperbaharui setiap bulan. Batalkan pada bila-bila masa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezután havonta megújul. Bármikor lemondható."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その後は毎月更新されます。いつでも解約できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
