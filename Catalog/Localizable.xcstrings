    "Taller keys are easier to tap accurately. Shorter keys give more screen room.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhere Tasten triffst du leichter genau. Niedrigere Tasten geben mehr Platz auf dem Bildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas más altas son más fáciles de tocar bien. Las más bajas dejan más espacio en pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches plus hautes sont plus faciles à toucher juste. Les plus basses laissent plus de place à l'écran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A magasabb gombokat könnyebb pontosan eltalálni. Az alacsonyabbak több helyet hagynak a képernyőn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti più alti sono più facili da toccare con precisione. Quelli più bassi lasciano più spazio sullo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーが高いほど正確にタップしやすくなります。低いと画面が広く使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 높을수록 정확하게 탭하기 쉬워요. 키가 낮으면 화면이 더 넓어져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci lebih tinggi senang diketik dengan tepat. Kekunci lebih pendek beri lebih ruang skrin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas mais altas são mais fáceis de acertar. As mais baixas deixam mais espaço no ecrã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По высоким клавишам легче попадать точно. Низкие оставляют больше места на экране."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键越高越好点准，越矮屏幕空间越大。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
