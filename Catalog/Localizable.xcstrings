          }
        }
      }
    },
    "Restores Clink to factory defaults and permanently removes your custom content and saved profiles.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt Clink auf Werkseinstellungen zurück und entfernt dauerhaft eigene Inhalte und gespeicherte Profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece Clink a los valores de fábrica y elimina permanentemente tu contenido personalizado y los perfiles guardados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taastab Clinki tehase vaikeseaded ning eemaldab jäädavalt sinu kohandatud sisu ja salvestatud profiilid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit les réglages d’usine de Clink et supprime définitivement votre contenu personnalisé et vos profils enregistrés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítja a Clink gyári beállításait, és végleg eltávolítja az egyéni tartalmakat és mentett profilokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina Clink alle impostazioni di fabbrica e rimuove definitivamente contenuti personalizzati e profili salvati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkを工場出荷時設定に戻し、カスタムコンテンツと保存済みプロファイルを完全に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink을 공장 기본값으로 복원하고 사용자 설정 콘텐츠와 저장된 프로필을 영구적으로 제거합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulihkan Clink kepada tetapan kilang serta mengalih keluar kandungan tersuai dan profil tersimpan anda secara kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura o Clink para as predefinições de fábrica e remove permanentemente o seu conteúdo personalizado e perfis guardados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает заводские настройки Clink и безвозвратно удаляет ваш пользовательский контент и сохранённые профили."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Clink 恢复为出厂默认设置，并永久移除你的自定内容和已保存的配置文件。"
          }
        }
      }
    },
