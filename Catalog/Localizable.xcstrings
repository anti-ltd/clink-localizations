          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни тут застосовуються лише до цього варіанта."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buradaki değişiklikler yalnızca bu görünüme uygulanır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny zde se vztahují jen na tento vzhled."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
