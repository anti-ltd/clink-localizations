    "Remove a clip from history after pasting it. Pinned clips are never deleted.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwyder 'n snit uit die geskiedenis nadat jy dit geplak het. Vasgespelde snitte word nooit uitgevee nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt einen Eintrag nach dem Einfügen aus dem Verlauf. Angeheftete Einträge werden nie gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita un fragmento del historial al pegarlo. Los fragmentos fijados no se borran nunca."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemaldab klipi ajaloost pärast selle kleepimist. Kinnitatud klippe ei kustutata kunagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire un élément de l'historique après l'avoir collé. Les éléments épinglés ne sont jamais supprimés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beillesztés után törli a klipet az előzményekből. A rögzített klipek soha nem törlődnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toglie un elemento dalla cronologia dopo che l'hai incollato. Quelli fissati non vengono mai eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼り付けたクリップは履歴から消します。ピン留めしたクリップは消えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붙여넣은 클립은 기록에서 지워요. 고정한 클립은 지워지지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buang keratan dari sejarah selepas anda tampal. Keratan yang dipin tak akan dipadam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira um item do histórico depois de o colares. Os itens fixados nunca são apagados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убирать фрагмент из истории после вставки. Закреплённые не удаляются никогда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴后把这条从历史里移除。固定的条目不会删。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminați un clip din istoric după ce îl lipiți. Clipurile fixate nu sunt niciodată șterse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder een fragment uit de geschiedenis nadat u het hebt geplakt. Vastgezette clips worden nooit verwijderd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上後把這條從歷史裡移除。固定的條目不會刪。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń klip z historii po jego wklejeniu. Przypięte klipy nigdy nie są usuwane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити кліп з історії після його вставлення. Закріплені кліпи ніколи не видаляються."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir klibi yapıştırdıktan sonra geçmişten kaldırın. Sabitlenen klipler hiçbir zaman silinmez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po vložení klip z historie odeberte. Připnuté klipy se nikdy nesmažou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po vložení klip odstráňte z histórie. Pripnuté klipy sa nikdy neodstránia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαιρέστε ένα κλιπ από το ιστορικό αφού το επικολλήσετε. Τα καρφιτσωμένα κλιπ δεν διαγράφονται ποτέ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort ett klipp från historiken efter att ha klistrat in det. Fästa klipp tas aldrig bort."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern et klip fra historikken, når du har indsat det. Fastgjorte klip slettes aldrig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern et klipp fra loggen etter å ha limt det inn. Festede klipp slettes aldri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista leike historiasta sen liittämisen jälkeen. Kiinnitettyjä leikkeitä ei koskaan poisteta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus klip dari riwayat setelah menempelkannya. Klip yang disematkan tidak pernah dihapus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa clip khỏi lịch sử sau khi dán nó. Các clip đã ghim sẽ không bao giờ bị xóa."
          }
        }
      }
    },
