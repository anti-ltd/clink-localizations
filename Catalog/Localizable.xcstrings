    "How every keypress feels.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoe elke sleuteldruk voel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie sich jeder Tastendruck anfühlt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo se siente cada pulsación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuidas iga klahvivajutus tundub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sensation de chaque appui."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden gombnyomás érzete."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sensazione di ogni tasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを押すたびの感触。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누를 때의 느낌."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasa setiap tekanan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sensação de cada toque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как ощущается каждое нажатие."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次按键的手感。"
          }
        }
      }
    },
    "How every keypress sounds.": {
      "extractionState": "manual",
      "localizations": {
