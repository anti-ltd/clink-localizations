    "Select text. Tap Shift to toggle the first letter’s case; double-tap to toggle all selected text. Keep tapping to repeat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select text. Tap Shift to toggle the first letter’s case; double-tap to toggle all selected text. Keep tapping to repeat."
