    "Punctuation that loses the space in front of it, the way a comma does.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Leestekens wat die spasie voor dit verloor, soos 'n komma."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Satzzeichen, vor denen das Leerzeichen wegfällt – wie beim Komma."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Signos que pierden el espacio de delante, como hace la coma."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjavahemärgid, mis eelnevast tühikust ilma jäävad, nagu koma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponctuation qui perd l’espace qui la précède, comme la virgule."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írásjelek, amik elől eltűnik a szóköz – ahogy a vesszőnél."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punteggiatura che perde lo spazio che la precede, come la virgola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直前のスペースが消える約物です（読点と同じ扱い）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞의 공백이 사라지는 문장 부호입니다. 쉼표와 같은 방식입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda baca yang menghilangkan ruang di hadapannya, seperti koma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontuação que perde o espaço à frente, como faz a vírgula."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знаки, перед которыми пробел убирается, — как перед запятой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会吃掉前面空格的标点，就像逗号那样。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Punctuație care pierde spațiul din față, așa cum o face o virgulă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leestekens waarbij de spatie ervoor verloren gaat, zoals een komma dat doet."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會吃掉前面空格的標點，就像逗號那樣。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Interpunkcja, która traci spację przed sobą, tak jak robi to przecinek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розділові знаки, які втрачають пробіл перед собою, як це робить кома."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Virgülün yaptığı gibi önündeki boşluğu kaybeden noktalama işareti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Interpunkce, která ztrácí mezeru před sebou, jako to dělá čárka."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Interpunkcia, ktorá stráca miesto pred sebou, ako to robí čiarka."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σημεία στίξης που χάνει το χώρο μπροστά του, όπως κάνει ένα κόμμα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skiljetecken som tappar utrymmet framför sig, som ett kommatecken gör."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegnsætning, der mister pladsen foran sig, som et komma gør."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegnsetting som mister plassen foran seg, slik et komma gjør."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välimerkit, jotka menettävät välilyönnin eteensä, kuten pilkku tekee."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda baca yang menghilangkan spasi di depannya, seperti halnya koma."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dấu câu làm mất khoảng trắng ở phía trước, giống như dấu phẩy."
          }
        }
      }
    },
    "Punctuation, plus the \"um\"s, stutters and false starts that come with talking out loud.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Leestekens, plus die \"um\"'s, hakkel en vals begin wat gepaard gaan met hardop praat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichensetzung, plus die „ähm\"s, Stotterer und Fehlstarts, die beim lauten Sprechen passieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntuación, más los «eh», tartamudeos y falsos arranques de hablar en voz alta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjavahemärgid, lisaks „ee\"-d, komistused ja valed algused, mis kaasnevad valju häälega rääkimisega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponctuation, plus les « euh », bégaiements et faux départs qui viennent avec le fait de parler à voix haute."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Központozás, plusz a „öö\"-zések, dadogások és hamis kezdések, amik a hangos beszéddel járnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punteggiatura, più i «mmh», le balbettii e i falsi inizi che arrivano parlando ad alta voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "句読点に加え、「えーっと」などの言い淀みや、話し声に伴う吃りや言い間違いも除去。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구두점, 그리고 말할 때 나오는 \"음\" 하는 소리, 더듬거림, 헛시작까지."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda baca, ditambah dengan \"um\", gagap dan permulaan palsu yang datang dengan bercakap kuat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontuação, mais os «huns», gaguejos e falsos começos que vêm com falar em voz alta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пунктуация, плюс «э-э», запинки и ложные начала, которые бывают при разговоре вслух."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标点，以及说话时出现的\"嗯\"、结巴和重新起头。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Punctuația, plus „um”, bâlbâiile și începuturile false care vin cu vorbirea cu voce tare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Interpunctie, plus de 'eh'-tekens, het stotteren en valse starts die gepaard gaan met hardop praten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標點，以及說話時出現的\"嗯\"、結巴和重新起頭。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Interpunkcja, a także „um”, zacinanie się i falstarty towarzyszące mówieniu na głos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розділові знаки, а також «гм», заїкання та фальстарти, які виникають під час розмови вголос."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noktalama işaretlerine ek olarak yüksek sesle konuşmanın getirdiği \"hı\"lar, kekemeler ve yanlış başlangıçlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Interpunkce plus „ehm“, koktání a falešné začátky, které přicházejí s mluvením nahlas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Interpunkcia plus „ehm“, koktanie a falošné začiatky, ktoré prichádzajú s hlasným rozprávaním."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα σημεία στίξης, καθώς και τα \"χμ\", τα τραύλισμα και οι λανθασμένες εκκινήσεις που έρχονται με το να μιλάμε δυνατά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skiljetecken, plus \"um\", stammar och falska starter som kommer med att prata högt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegnsætning plus \"um\"-erne, hakken og falske starter, der følger med at tale højt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegnsetting, pluss \"um\"-ene, hakking og falske starter som følger med å snakke høyt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välimerkit sekä \"um\":t, änkytykset ja väärät alkavat, jotka tulevat ääneen puhumisesta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda baca, ditambah \"um\", kegagapan, dan awalan yang salah yang muncul saat berbicara dengan suara keras."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dấu câu, cộng với các âm \"ừm\", lắp bắp và bắt đầu sai khi nói to."
          }
        }
      }
    },
    "Push the boundary letter to the hand opposite your last key: tap a left-side key and the edge letter hops right (and vice versa). It holds until you switch hands, not flipping every press.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk die grensletter na die hand oorkant jou laaste sleutel: tik 'n linkerkantsleutel en die randletter spring regs (en omgekeerd). Dit hou totdat jy van hande wissel, nie elke druk omdraai nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiebt den Randbuchstaben zur Hand gegenüber deiner letzten Taste: tipp eine Taste links und der Randbuchstabe springt nach rechts (und umgekehrt). Er bleibt, bis du die Hand wechselst, statt bei jedem Druck umzuschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja la letra del borde hacia la mano opuesta a tu última tecla: toca una tecla del lado izquierdo y la letra del borde salta a la derecha (y al revés). Se mantiene hasta que cambias de mano, no cambia en cada pulsación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lükkab servatähe vastaskätte sinu viimasest klahvist: vajuta vasakpoolset klahvi ja servatähe hüppab paremale (ja vastupidi). Ta püsib, kuni vahetad kätt, mitte ei pööra iga vajutusega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie la lettre de bord vers la main opposée à ta dernière touche : appuie à gauche et la lettre du bord saute à droite (et inversement). Ça tient jusqu'à ce que tu changes de main, sans basculer à chaque appui."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A határoló betűt az utolsó billentyűddel ellentétes kézhez tolja: koppints egy bal oldali billentyűre, és a szélső betű átugrik jobbra (és fordítva). Addig marad, amíg kezet nem váltasz, nem fordul meg minden lenyomásnál."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spinge la lettera di bordo verso la mano opposta al tuo ultimo tasto: tocca un tasto a sinistra e la lettera di bordo salta a destra (e viceversa). Resta finché non cambi mano, non si ribalta a ogni pressione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "境界の文字を、最後に押したキーと反対の手に寄せます。左側のキーを押すと端の文字が右に移ります（逆も同様）。毎回切り替わるのではなく、手を替えるまでそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경계 글자를 마지막 키의 반대쪽 손으로 밀어요. 왼쪽 키를 누르면 가장자리 글자가 오른쪽으로 뛰고(반대도 마찬가지). 손을 바꿀 때까지 유지되고, 누를 때마다 뒤집히진 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tolak huruf sempadan ke tangan bertentangan dengan kekunci terakhir anda: ketik kekunci sebelah kiri dan huruf tepi melompat ke kanan (dan sebaliknya). Ia kekal sehingga anda tukar tangan, bukan bertukar setiap tekanan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurra a letra da fronteira para a mão oposta à da tua última tecla: toca numa tecla do lado esquerdo e a letra da borda salta para a direita (e vice-versa). Mantém-se até trocares de mão, sem virar a cada toque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлять граничную букву к руке, противоположной последней клавише: нажали слева — крайняя буква перепрыгивает вправо (и наоборот). Она держится, пока вы не смените руку, а не прыгает при каждом нажатии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把边界字母推到你上一个键的另一只手那侧：点左边的键，边缘字母就跳到右边（反之亦然）。它会保持到你换手，而不是每按一次就翻。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Împingeți litera de delimitare în mâna opusă ultimei taste: atingeți o tastă din partea stângă și litera de margine sare spre dreapta (și invers). Se menține până când schimbi mâinile, nu răsturnând fiecare apăsare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duw de grensletter naar de hand tegenover je laatste toets: tik op een linkertoets en de randletter springt naar rechts (en omgekeerd). Het blijft zitten totdat je van hand wisselt, en niet bij elke druk omdraait."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把邊界字母推到你上一個鍵的另一隻手那側：點左邊的鍵，邊緣字母就跳到右邊（反之亦然）。它會保持到你換手，而不是每按一次就翻。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń literę graniczną do ręki znajdującej się naprzeciwko ostatniego klawisza: naciśnij lewy klawisz, a litera krawędziowa przeskoczy w prawo (i odwrotnie). Utrzymuje się do momentu zmiany rąk, a nie odwracania każdego naciśnięcia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть обмежувальну літеру до руки, протилежної вашій останній клавіші: торкніться лівої клавіші, і крайова літера перескочить праворуч (і навпаки). Він тримається, поки ви не поміняєте руку, не перевертаючи кожне натискання."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınır harfini son anahtarınızın karşısındaki elinize doğru itin: sol taraftaki tuşlardan birine dokunduğunuzda kenar harfi sağa sıçrar (veya tam tersi). Her bastığınızda çevirmek yerine el değiştirene kadar tutar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuňte ohraničující písmeno do ruky naproti vaší poslední klávese: klepněte na klávesu na levé straně a písmeno na okraji skočí doprava (a naopak). Drží, dokud nevyměníte ruce, nepřevracíte při každém stisknutí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuňte hraničné písmeno do ruky oproti vášmu poslednému klávesu: klepnite na kláves na ľavej strane a písmeno na okraji preskočí doprava (a naopak). Drží, kým si nevymeníte ruky, nie preklopenie pri každom stlačení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σπρώξτε το οριακό γράμμα στο χέρι που βρίσκεται απέναντι από το τελευταίο σας πλήκτρο: πατήστε ένα πλήκτρο στην αριστερή πλευρά και το γράμμα της άκρης αναπηδά δεξιά (και αντίστροφα). Κρατάει μέχρι να αλλάξετε τα χέρια, χωρίς να αναποδογυρίζετε κάθε πάτημα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på gränsbokstaven till handen mitt emot din senaste tangent: tryck på en vänsterknapp och kantbokstaven hoppar åt höger (och vice versa). Den håller tills du byter händer, inte vänder varje tryckning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skub grænsebogstavet til hånden modsat din sidste tast: Tryk på en tast i venstre side, og kantbogstavet hopper til højre (og omvendt). Den holder, indtil du skifter hænder, og vender ikke for hvert tryk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skyv grensebokstaven til hånden på motsatt side av den siste tasten: trykk på en venstretast og kantbokstaven hopper til høyre (og omvendt). Den holder til du bytter hender, ikke snur hvert trykk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työnnä rajakirjain viimeistä näppäintä vastapäätä olevaan käteen: napauta vasemmanpuoleista näppäintä ja reunakirjain hyppää oikealle (ja päinvastoin). Se pysyy, kunnes vaihdat kättä, ei käännä jokaista painallusta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorong huruf batas ke tangan yang berlawanan dengan kunci terakhir Anda: ketuk tombol sebelah kiri dan huruf tepi melompat ke kanan (dan sebaliknya). Ini bertahan sampai Anda berpindah tangan, bukan membalik setiap tekanan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đẩy chữ cái ranh giới sang tay đối diện với phím cuối cùng của bạn: nhấn vào một phím bên trái và chữ cái ở cạnh nhảy sang phải (và ngược lại). Nó giữ cho đến khi bạn đổi tay, không lật mỗi lần nhấn."
          }
        }
      }
    },
    "Put everything back?": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles terugsit?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles zurücksetzen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Devolver todo a su sitio?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paned kõik tagasi?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout remettre comme avant ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítsunk mindent?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimettere tutto com’era?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて元に戻しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전부 되돌릴까요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembalikan semuanya?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pôr tudo como estava?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуть всё на место?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要把所有设置还原吗？"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pune totul înapoi?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles terugzetten?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要把所有設定還原嗎？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłożyć wszystko z powrotem?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернути все назад?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herşeyi geri mi koyacağım?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dát všechno zpátky?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátiť všetko späť?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να τα βάλεις όλα πίσω;"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg tillbaka allt?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sætte alt tilbage?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sette alt tilbake?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita kaikki takaisin?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembalikan semuanya?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt mọi thứ trở lại?"
          }
        }
      }
    },
    "Put your finger on the first letter of the word.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaas jou vinger op die eerste letter van die woord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz den Finger auf den ersten Buchstaben des Wortes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon el dedo en la primera letra de la palabra."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta sõrm sõna esimesele tähele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose ton doigt sur la première lettre du mot."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tedd az ujjad a szó első betűjére."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia il dito sulla prima lettera della parola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語の最初の文字に指を置きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어의 첫 글자에 손가락을 올리세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan jari anda pada huruf pertama perkataan itu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Põe o dedo na primeira letra da palavra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставьте палец на первую букву слова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手指放在这个词的第一个字母上。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pune degetul pe prima literă a cuvântului."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg uw vinger op de eerste letter van het woord."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手指放在這個詞的第一個字母上。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połóż palec na pierwszej literze słowa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покладіть палець на першу букву слова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmağınızı kelimenin ilk harfine koyun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položte prst na první písmeno slova."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Položte prst na prvé písmeno slova."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλτε το δάχτυλό σας στο πρώτο γράμμα της λέξης."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätt fingret på den första bokstaven i ordet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt fingeren på det første bogstav i ordet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett fingeren på den første bokstaven i ordet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta sormesi sanan ensimmäisen kirjaimen päälle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan jari Anda pada huruf pertama kata tersebut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt ngón tay của bạn vào chữ cái đầu tiên của từ."
          }
        }
      }
    },
    "Puts a space after every emoji, so a run of them doesn’t come out as one solid block.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaas 'n spasie na elke emoji, so 'n reeks van hulle kom nie as een soliede blok uit nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt nach jedem Emoji ein Leerzeichen, damit mehrere hintereinander nicht als ein Klumpen ankommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone un espacio después de cada emoji, para que varios seguidos no salgan pegados en un bloque."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisab iga emoji järel tühiku, nii et mitu järjest ei tule ühe tükina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met un espace après chaque emoji, pour que plusieurs à la suite ne forment pas un pavé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden emoji után szóközt tesz, így több egymás után nem folyik össze egy tömbbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mette uno spazio dopo ogni emoji, così una fila di emoji non esce tutta attaccata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵文字ごとに後ろへスペースを入れるので、続けて送ってもひと塊になりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이모지마다 뒤에 띄어쓰기를 넣어서, 여러 개를 이어 보내도 한 덩어리로 붙지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Letak ruang selepas setiap emoji, jadi beberapa emoji berturut-turut tak jadi satu blok padat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Põe um espaço depois de cada emoji, para que vários seguidos não saiam colados num bloco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставит пробел после каждого эмодзи, чтобы их вереница не слипалась в один ком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个表情后面加一个空格，连着发好几个也不会挤成一团。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pune un spațiu după fiecare emoji, astfel încât o serie de ele nu iese ca un bloc solid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaatst een spatie na elke emoji, zodat er niet één geheel uit één blok komt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個表情後面加一個空格，連著發好幾個也不會擠成一團。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umieszcza spację po każdym emoji, więc seria z nich nie wygląda jak jeden solidny blok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставить пробіл після кожного емодзі, щоб їх серія не вийшла як один суцільний блок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her emojiden sonra bir boşluk bırakır, böylece bir dizi tek bir blok halinde ortaya çıkmaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za každým emoji vloží mezeru, takže řada z nich nevyjde jako jeden pevný blok."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umiestňuje medzeru za každým emoji, takže séria z nich nevyjde ako jeden pevný blok."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάζει ένα κενό μετά από κάθε emoji, ώστε μια σειρά από αυτά να μην εμφανίζεται ως ένα συμπαγές μπλοκ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägger ett mellanslag efter varje emoji, så att en serie av dem inte kommer ut som ett enda block."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sætter et mellemrum efter hver emoji, så en række af dem ikke kommer ud som én solid blok."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Setter et mellomrom etter hver emoji, slik at en serie med dem ikke kommer ut som en solid blokk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää välilyönnin jokaisen emojin perään, jotta niistä ei tule yhtenäistä lohkoa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memberi spasi setelah setiap emoji, sehingga rangkaian emoji tidak akan terlihat seperti satu blok padat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt một khoảng trắng sau mỗi biểu tượng cảm xúc để một loạt biểu tượng cảm xúc không xuất hiện dưới dạng một khối liền mạch."
          }
        }
      }
    },
    "Puts the keyboard away, the same as swiping it down.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Tastatur aus, wie ein Wischen nach unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta el teclado, igual que deslizarlo hacia abajo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peidab klaviatuuri, nagu alla pühkimine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Range le clavier, comme un balayage vers le bas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elrejti a billentyűzetet, mint a lefelé húzás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde la tastiera, come uno scorrimento verso il basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下にスワイプしたときと同じように、キーボードを閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래로 쓸어내린 것처럼 키보드를 내립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan papan kekunci, sama seperti meleretnya ke bawah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esconde o teclado, como deslizar para baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убирает клавиатуру, как смахивание вниз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起键盘，和向下轻扫一样。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pune tastatura deoparte, la fel ca cu glisarea în jos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt het toetsenbord weg, hetzelfde als het naar beneden vegen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收起鍵盤，和向下輕掃一樣。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Bêre die sleutelbord weg; dieselfde as om dit af te swiep."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkładanie klawiatury w taki sam sposób, jak przesuwanie jej w dół."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкладає клавіатуру, так само, як змахнути її вниз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağı kaydırmayla aynı şekilde klavyeyi uzaklaştırır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odloží klávesnici, stejně jako ji přejetím dolů."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odloží klávesnicu, rovnako ako ju potiahnete nadol."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαιρεί το πληκτρολόγιο, το ίδιο με το να το σύρετε προς τα κάτω."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägger bort tangentbordet, samma sak som att svepa ner det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lægger tastaturet væk, det samme som at stryge det ned."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legger bort tastaturet, det samme som å sveipe det ned."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laittaa näppäimistön pois, kuten pyyhkäisemällä sitä alaspäin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Singkirkan keyboard, sama seperti menggeseknya ke bawah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt bàn phím đi, giống như thao tác vuốt xuống."
          }
        }
      }
    },
    "Puts the tabs back, and the keyboard back on the keys. Your themes, layouts and tools are all where you left them.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaas die oortjies terug, en die sleutelbord terug op die sleutels. Jou temas, uitlegte en gereedskap is alles waar jy dit gelos het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Holt die Tabs zurück und die Tastatur zurück auf die Tasten. Deine Themes, Layouts und Tools sind alle da, wo du sie gelassen hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Devuelve las pestañas, y el teclado vuelve a las teclas. Tus temas, distribuciones y herramientas siguen donde los dejaste."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneb kaardid tagasi ja klaviatuuri klahvidele. Sinu teemad, paigutused ja tööriistad on kõik seal, kus nad jätsid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remet les onglets, et le clavier revient sur les touches. Tes thèmes, dispositions et outils sont là où tu les as laissés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszahozza a füleket, a billentyűzetet pedig a billentyűkhöz. A témáid, kiosztásaid és eszközeid mind ott vannak, ahol hagytad őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimette le schede, e la tastiera torna sui tasti. Temi, layout e strumenti sono tutti dove li hai lasciati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブが戻り、キーボードもキーの画面に戻ります。テーマもレイアウトもツールも、置いたままの場所にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭이 돌아오고, 키보드도 다시 키 화면으로 돌아옵니다. 테마와 레이아웃, 도구는 모두 두었던 그대로예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengembalikan tab, dan papan kekunci kembali kepada kekunci. Tema, susun atur dan alat anda semuanya di tempat anda tinggalkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Devolve os separadores, e o teclado volta às teclas. Os teus temas, esquemas e ferramentas estão todos onde os deixaste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает вкладки, а клавиатуру — к клавишам. Ваши темы, раскладки и инструменты остаются там, где вы их оставили."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把标签页放回来，键盘也回到按键。你的主题、布局和工具都在原来的位置。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pune filele înapoi și tastatura înapoi pe taste. Temele, machetele și instrumentele dvs. sunt acolo unde le-ați lăsat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaatst de lipjes terug en het toetsenbord terug op de toetsen. Uw thema's, lay-outs en hulpmiddelen zijn allemaal waar u ze achterliet."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把標籤頁放回來，鍵盤也回到按鍵。你的主題、佈局和工具都在原來的位置。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakłada z powrotem zakładki i klawiaturę z powrotem na klawisze. Twoje motywy, układy i narzędzia są tam, gdzie je zostawiłeś."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повертає вкладки, а клавіатуру на клавіші. Ваші теми, макети та інструменти там, де ви їх залишили."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekmeleri ve klavyeyi tekrar tuşlara yerleştirir. Temalarınız, düzenleriniz ve araçlarınız bıraktığınız yerdedir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vloží záložky zpět a klávesnici zpět na klávesy. Vaše motivy, rozvržení a nástroje jsou tam, kde jste je nechali."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vloží záložky späť a klávesnicu späť na klávesy. Vaše motívy, rozloženia a nástroje sú tam, kde ste ich nechali."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφέρει τις καρτέλες και το πληκτρολόγιο στα πλήκτρα. Τα θέματα, οι διατάξεις και τα εργαλεία σας βρίσκονται εκεί που τα αφήσατε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätter tillbaka flikarna och tangentbordet tillbaka på tangenterna. Dina teman, layouter och verktyg finns där du lämnade dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sætter tapperne tilbage, og tastaturet tilbage på tasterne. Dine temaer, layout og værktøjer er alle, hvor du efterlod dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Setter tappene tilbake, og tastaturet tilbake på tastene. Temaene, layoutene og verktøyene dine er der du la dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettaa kielekkeet takaisin ja näppäimistön takaisin näppäinten päälle. Teemasi, asettelusi ja työkalusi ovat kaikki sinne, mihin jätit ne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang kembali tabnya, dan kembalikan keyboard ke tombolnya. Tema, tata letak, dan alat Anda semuanya ada di tempat Anda meninggalkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt các tab trở lại và bàn phím trở lại các phím. Tất cả các chủ đề, bố cục và công cụ của bạn vẫn ở nguyên vị trí cũ."
          }
        }
      }
    },
    "Puts the tool back in the panel button and the slide-up list.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaas die instrument terug in die paneelknoppie en die opskuiflys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt das Werkzeug wieder in den Panel-Button und die Liste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Devuelve la herramienta al botón de paneles y a la lista."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneb tööriista tagasi paneelinuppu ja üleslibisevasse loendisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remet l'outil dans le bouton de panneaux et dans la liste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszateszi az eszközt a panelgombba és a listába."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimette lo strumento nel pulsante dei pannelli e nell'elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールをパネルボタンと一覧に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구를 패널 버튼과 목록에 다시 넣어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengembalikan alat ini ke butang panel dan senarai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Repõe a ferramenta no botão de painéis e na lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает инструмент в кнопку панелей и в список по подъёму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把工具放回面板按钮和列表里。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pune instrumentul înapoi în butonul panoului și în lista glisantă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaatst het gereedschap terug in de paneelknop en de schuiflijst."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把工具放回面板按鈕和列表裡。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umieszcza narzędzie z powrotem na przycisku panelu i liście wysuwanej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повертає інструмент до кнопки панелі та розсувного списку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aracı tekrar panel düğmesine ve kayan listeye yerleştirir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátí nástroj zpět do tlačítka panelu a do vysouvacího seznamu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vráti nástroj späť do tlačidla panela a do vysúvacieho zoznamu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφέρει το εργαλείο στο κουμπί του πίνακα και στη λίστα slide-up."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätter tillbaka verktyget i panelknappen och i listan som glider upp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sætter værktøjet tilbage i panelknappen og slide-up-listen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Setter verktøyet tilbake i panelknappen og skyve opp-listen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijoittaa työkalun takaisin paneelipainikkeeseen ja liukuvaan luetteloon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan kembali alat tersebut di tombol panel dan daftar geser ke atas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đưa công cụ trở lại nút bảng điều khiển và danh sách trượt lên."
          }
        }
      }
    },
    "Puts ١٢٣ on the 123 page of the Arabic keyboard. The number row keeps 123, and holding a digit gives you the other set.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaas ١٢٣ op die 123 bladsy van die Arabiese sleutelbord. Die nommerry hou 123, en as jy 'n syfer hou, kry jy die ander stel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt ١٢٣ auf die 123-Ebene der arabischen Tastatur. Die Zahlenreihe behält 123, und wenn du eine Ziffer gedrückt hältst, bekommst du den anderen Satz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone ١٢٣ en la página 123 del teclado árabe. La fila de números mantiene 123, y si mantienes pulsada una cifra tienes el otro conjunto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneb ١٢٣ araabia klaviatuuri 123-lehele. Numbridrida hoiab 123 ja numbri hoidmisel saad teise komplekti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met ١٢٣ sur la page 123 du clavier arabe. La rangée de chiffres garde 123, et maintenir un chiffre te donne l’autre série."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A ١٢٣ jegyeket teszi az arab billentyűzet 123-as lapjára. A számsor marad 123, és egy számjegyet nyomva tartva megkapod a másik készletet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mette ١٢٣ nella pagina 123 della tastiera araba. La riga dei numeri resta 123 e tenendo premuta una cifra ottieni l’altra serie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラビア語キーボードの「123」ページを ١٢٣ にします。数字行は 123 のままで、数字キーを長押しするともう一方の数字が出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아랍어 키보드의 123 페이지를 ١٢٣ 으로 바꿉니다. 숫자 행은 123 그대로이며, 숫자를 길게 누르면 다른 쪽 숫자가 나옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Meletakkan ١٢٣ pada halaman 123 papan kekunci Arab. Baris nombor kekal 123, dan tekan lama sesuatu digit untuk mendapatkan set yang satu lagi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca ١٢٣ na página 123 do teclado árabe. A linha de números mantém 123 e, se mantiveres um algarismo premido, obténs o outro conjunto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставит ١٢٣ на страницу 123 арабской клавиатуры. В ряду цифр остаются 123, а по удержанию цифры выдаётся другой набор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把阿拉伯语键盘的 123 页换成 ١٢٣。数字行仍是 123，长按数字键可得到另一组。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pune ١٢٣ pe pagina 123 a tastaturii arabe. Rândul de numere păstrează 123, iar menținerea unei cifre vă oferă celălalt set."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet ١٢٣ op pagina 123 van het Arabische toetsenbord. De getallenrij behoudt 123, en als je een cijfer vasthoudt, krijg je de andere set."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把阿拉伯語鍵盤的 123 頁換成 ١٢٣。數字行仍是 123，長按數字鍵可得到另一組。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umieszcza ١٢٣ na 123 stronie klawiatury arabskiej. W wierszu liczb pozostaje 123, a przytrzymanie cyfry daje drugi zestaw."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розміщує ١٢٣ на 123 сторінці арабської клавіатури. Числовий рядок зберігає 123, а утримання цифри дає вам інший набір."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arapça klavyenin 123 sayfasına ١٢٣ koyar. Sayı satırı 123'ü tutar ve bir rakamı tutmak size diğer seti verir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vloží ١٢٣ na 123 stránku arabské klávesnice. V řadě čísel zůstává 123 a podržením číslice získáte druhou sadu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vloží ١٢٣ na 123 stránku arabskej klávesnice. V číselnom rade zostáva 123 a podržaním číslice získate druhú množinu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάζει το ١٢٣ στη σελίδα 123 του αραβικού πληκτρολογίου. Η αριθμητική σειρά διατηρεί το 123 και κρατώντας ένα ψηφίο σας δίνει το άλλο σύνολο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätter ١٢٣ på sidan 123 på det arabiska tangentbordet. Sifferraden behåller 123, och om du håller en siffra får du den andra uppsättningen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sætter ١٢٣ på 123-siden af det arabiske tastatur. Talrækken beholder 123, og hvis du holder et ciffer nede, får du det andet sæt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Setter ١٢٣ på 123-siden på det arabiske tastaturet. Tallraden beholder 123, og ved å holde et siffer får du det andre settet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta ١٢٣ arabiankielisen näppäimistön 123-sivulle. Numerorivi säilyttää 123:n, ja jos pidät numeroa, saat toisen joukon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menempatkan ١٢٣ pada halaman 123 papan ketik Arab. Baris bilangan tetap 123, dan menahan satu digit akan menghasilkan himpunan lainnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt ١٢٣ trên trang 123 của bàn phím tiếng Ả Rập. Hàng số giữ nguyên 123 và giữ một chữ số sẽ cho bạn tập hợp còn lại."
          }
        }
      }
    },
