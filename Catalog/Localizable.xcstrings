    "Feedback is taking a short break. Try again in a few minutes.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comentarios están en pausa un momento. Vuelve a intentarlo en unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les avis font une petite pause. Réessaie dans quelques minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback macht gerade eine kurze Pause. Versuch es in ein paar Minuten noch einmal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il feedback è in pausa per un momento. Riprova tra qualche minuto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os comentários estão numa pequena pausa. Tenta novamente daqui a uns minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приём отзывов ненадолго приостановлен. Попробуйте через несколько минут."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Maklum balas sedang berehat sebentar. Cuba lagi dalam beberapa minit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A visszajelzés most rövid szünetet tart. Próbáld újra néhány perc múlva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックは一時的に停止しています。数分後にもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反馈暂时休息一下。请几分钟后再试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드백이 잠시 쉬고 있습니다. 몇 분 후에 다시 시도해 주세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagasiside peab lühikest pausi. Proovi mõne minuti pärast uuesti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
