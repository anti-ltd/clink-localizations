    "Trims this pack against the others, so switching packs doesn't change how loud typing is.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleicht dieses Paket an die anderen an, damit ein Paketwechsel die Tipplautstärke nicht verändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta este paquete respecto a los demás, para que cambiar de paquete no cambie el volumen al escribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste ce pack par rapport aux autres, pour que changer de pack ne change pas le volume de la frappe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A többi csomaghoz igazítja ezt, így csomagváltáskor nem változik a gépelés hangereje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allinea questo pacchetto agli altri, così cambiare pacchetto non cambia il volume della digitazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのパックと音量をそろえます。パックを切り替えても、タイプ音の大きさは変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 팩에 맞춰 음량을 고릅니다. 팩을 바꿔도 타이핑 소리 크기는 그대로예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Melaraskan pek ini berbanding yang lain, supaya menukar pek tidak mengubah kekuatan bunyi menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerta este pacote em relação aos outros, para que mudar de pacote não mude o volume da escrita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подгоняет громкость этого набора под остальные, чтобы при смене набора печать не становилась громче или тише."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这个包和其他包对齐音量，换包时打字的响度不会跟着变。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohendab seda pakki teiste suhtes, nii et pakkide vahetamine ei muuda tipimise valjust."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Knip hierdie pakket teen die ander af, so om van pakkies om te skakel, verander nie hoe hard tik is nie."
          }
        }
      }
    },
