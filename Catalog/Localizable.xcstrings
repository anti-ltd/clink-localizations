          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de mult se umflă fiecare cheie în afară când degetul trece peste ea."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel elke toets naar buiten uitstulpt als uw vinger eroverheen gaat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手指劃過時，每個鍵往外鼓起來多少。"
