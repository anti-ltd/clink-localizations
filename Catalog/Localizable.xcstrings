          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um a um esquema personalizado em Esquema, Organizar, Elemento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте его в свою раскладку через «Раскладка», «Расположение», «Элемент»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
