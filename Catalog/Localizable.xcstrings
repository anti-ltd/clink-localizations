    "Shared changes apply unless customized in Light or Dark.": {
      "extractionState": "manual",
      "comment": "Paired theme editor: one shared design with independent light and dark settings.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios comunes se aplican salvo que los personalices en Claro u Oscuro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements communs s’appliquent sauf si tu les personnalises dans Clair ou Sombre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeinsame Änderungen gelten, sofern du sie nicht unter Hell oder Dunkel angepasst hast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche condivise si applicano salvo personalizzazioni in Chiaro o Scuro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações partilhadas aplicam-se, exceto quando personalizadas em Claro ou Escuro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общие изменения применяются, если для светлого или тёмного варианта не заданы свои настройки."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan bersama digunakan melainkan disesuaikan dalam Cerah atau Gelap."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A közös módosítások érvényesülnek, kivéve a Világos vagy Sötét nézetben testreszabott beállításokat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共通の変更は、ライトまたはダークで個別に設定した項目を除いて適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共用更改会应用到两种外观，但在浅色或深色中单独自定义的设置除外。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공통 변경 사항은 라이트 또는 다크에서 개별 설정한 항목을 제외하고 적용됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühised muudatused rakenduvad, kui heleda või tumeda variandi seadeid pole eraldi kohandatud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările comune se aplică dacă nu ai personalizat setările în varianta luminoasă sau întunecată."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedeelde wijzigingen gelden tenzij je ze bij Licht of Donker hebt aangepast."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共用變更會套用至兩種外觀，但在淺色或深色中個別自訂的設定除外。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedeelde veranderinge geld tensy dit onder Lig of Donker aangepas is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wspólne zmiany są stosowane, chyba że ustawienia dostosowano osobno w wariancie jasnym lub ciemnym."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спільні зміни застосовуються, якщо для світлого або темного варіанта не задано власних налаштувань."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortak değişiklikler, Açık veya Koyu bölümünde özelleştirilmedikleri sürece uygulanır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Společné změny se použijí, pokud nastavení nebyla upravena zvlášť ve světlé nebo tmavé variantě."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoločné zmeny sa použijú, pokiaľ nastavenia neboli upravené zvlášť vo svetlom alebo tmavom variante."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι κοινές αλλαγές εφαρμόζονται εκτός αν έχουν προσαρμοστεί στη φωτεινή ή τη σκοτεινή εμφάνιση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemensamma ändringar gäller om de inte har anpassats under Ljust eller Mörkt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fælles ændringer gælder, medmindre de er tilpasset under Lys eller Mørk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Felles endringer gjelder med mindre de er tilpasset under Lys eller Mørk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteiset muutokset otetaan käyttöön, ellei asetuksia ole mukautettu erikseen vaaleassa tai tummassa tilassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan bersama berlaku kecuali sudah disesuaikan di Terang atau Gelap."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thay đổi chung được áp dụng trừ khi đã tùy chỉnh riêng trong Sáng hoặc Tối."
          }
        }
      }
    },
    "Changes here apply only to this appearance.": {
      "extractionState": "manual",
      "comment": "Paired theme editor: one shared design with independent light and dark settings.",
      "localizations": {
        "es": {
