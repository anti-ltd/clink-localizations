    "Hold a clip and drag it to reorder. Pinned clips stay on top.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou 'n snit vas en sleep dit om te herrangskik. Vasgespelde snitte bly bo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen Clip gedrückt und zieh ihn an eine neue Stelle. Angeheftete Clips bleiben oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un clip y arrástralo para cambiar el orden. Los fijados se quedan arriba."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia klippi ja lohista see ümber. Kinnitatud klipid jäävad üles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens un élément et fais-le glisser pour le déplacer. Les éléments épinglés restent en haut."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarts nyomva egy klipet, és húzd a helyére. A rögzítettek felül maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta una clip e trascinala per cambiare l’ordine. Quelle bloccate restano in alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップを長押しして動かすと、並び順を変えられます。ピン留めしたクリップは上のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립을 길게 눌러 끌면 순서를 바꿀 수 있어요. 고정한 클립은 계속 맨 위에 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan satu klip dan seret untuk menyusun semula. Klip yang dipin kekal di atas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha um clip premido e arraste-o para mudar a ordem. Os fixados ficam no topo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержите фрагмент и перетащите, чтобы изменить порядок. Закреплённые остаются наверху."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按剪贴内容再拖动即可调整顺序，固定的始终排在最上面。"
          }
        }
      }
    },
    "Hold a clip and drag it to reorder. Swipe left for copy, pin, or delete; swipe right to assign a group.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou 'n snit vas en sleep dit om te herrangskik. Swiep links vir kopieer, speld vas of vee uit; swiep regs om 'n groep toe te wys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen Clip und zieh ihn zum Umsortieren. Wisch nach links für Kopieren, Anheften oder Löschen; nach rechts, um eine Gruppe zuzuweisen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén un recorte y arrástralo para reordenar. Desliza a la izquierda para copiar, fijar o borrar; a la derecha para asignar un grupo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia klippi ja lohista see ümber. Viipa vasakule kopeerimiseks, kinnitamiseks või kustutamiseks; viipa paremale grupi määramiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens un extrait et glisse-le pour réordonner. Balaye à gauche pour copier, épingler ou supprimer ; à droite pour l’assigner à un groupe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd a klipet, és húzd az átrendezéshez. Balra húzás: másolás, kitűzés, törlés; jobbra: csoportba sorolás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un clip e trascinalo per riordinare. Scorri a sinistra per copiare, fissare o eliminare; a destra per assegnare un gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップを長押ししてドラッグすると並べ替え。左スワイプでコピー・ピン・削除、右スワイプでグループ分け。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립을 길게 눌러 끌어 순서를 바꿉니다. 왼쪽 쓸면 복사·고정·삭제, 오른쪽 쓸면 그룹에 넣습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan klip dan seret untuk susun semula. Leret kiri untuk salin, semat atau padam; leret kanan untuk tetapkan kumpulan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém um clip e arrasta-o para reordenar. Desliza para a esquerda para copiar, afixar ou apagar; para a direita para atribuir um grupo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержите фрагмент и перетащите, чтобы изменить порядок. Свайп влево — копировать, закрепить или удалить; свайп вправо — назначить группу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住一条再拖动即可重排。左滑复制、钉住或删除；右滑分到一组。"
          }
        }
      }
    },
