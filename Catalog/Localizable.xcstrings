          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öneri çubuğunun sunmayı bıraktığı kelimeler"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slova, která panel návrhů přestane nabízet"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Slová, panel návrhov prestane ponúkať"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λέξεις που η γραμμή προτάσεων σταματά να προσφέρει"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ord som förslagsfältet slutar erbjuda"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ord, som forslagslinjen stopper med at tilbyde"
          }
        },
        "nb": {
          "stringUnit": {
