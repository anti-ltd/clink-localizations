          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "CC-BY-SA sõnastikud, rakendusest väljaspool"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die CC-BY-SA leksikons, buite die toepassing"
          }
        }
      }
    },
    "The Clink keyboard opens on the mic too, so you can talk straight into any app.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch die Clink-Tastatur öffnet sich mit dem Mikrofon, du kannst also direkt in jede App sprechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado de Clink también se abre en el micro, así que puedes hablar directamente en cualquier app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier Clink s'ouvre lui aussi sur le micro, tu peux donc parler directement dans n'importe quelle app."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink billentyűzet is a mikrofonnal nyílik, így bármelyik appba beszélhetsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche la tastiera Clink si apre sul microfono, così puoi parlare direttamente in qualsiasi app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink キーボードもマイクの画面で開くので、どのアプリでもそのまま話せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 키보드도 마이크 화면으로 열려서, 어떤 앱에서든 바로 말할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci Clink turut dibuka pada mikrofon, jadi anda boleh terus bercakap dalam mana-mana app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado Clink também abre no microfone, por isso podes falar diretamente em qualquer app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура Clink тоже открывается на микрофоне, так что говорить можно прямо в любом приложении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 键盘也会直接打开麦克风，所以你可以直接对任何应用说话。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinki klaviatuur avaneb samuti mikrofonil, nii et sa saad otse mis tahes rakendusse rääkida."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Clink-sleutelbord maak ook op die mikrofoon oop, sodat jy reguit in enige toepassing kan praat."
          }
        }
      }
    },
    "The Layout editor builds keys, rows and whole extra pages.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Layout-Editor entstehen Tasten, Reihen und ganze Zusatzseiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El editor de disposición construye teclas, filas y páginas enteras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'éditeur de disposition fabrique des touches, des rangées et des pages entières."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elrendezésszerkesztőben billentyűk, sorok és egész extra oldalak készülnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'editor del layout costruisce tasti, righe e intere pagine in più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトエディタでは、キーや行、追加のページまで作れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이아웃 편집기에서는 키와 행, 추가 페이지까지 만들 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor susun atur membina kekunci, baris dan halaman tambahan sepenuhnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O editor de esquemas constrói teclas, linhas e páginas inteiras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В редакторе раскладки собираются клавиши, ряды и целые дополнительные страницы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布局编辑器能造按键、造整行，甚至整页。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paigutuse redaktoris ehitatakse klahvid, read ja terved lisalehed."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die uitlegredigeerder bou sleutels, rye en hele ekstra bladsye."
          }
        }
      }
    },
    "The Learning tab lists what Clink has picked up from your typing, so a word it learned by mistake can go from there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tab „Lernen“ listet, was Clink von deinem Tippen aufgeschnappt hat: ein versehentlich gelerntes Wort löschst du dort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pestaña Aprendizaje muestra lo que Clink ha cogido de tu escritura, así que una palabra que aprendió por error se borra ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’onglet Apprentissage liste ce que Clink a attrapé en te lisant : un mot appris par erreur se supprime là."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tanulás fülön látod, mit szedett fel a Clink a gépelésedből, így a tévedésből tanult szó onnan törölhető."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scheda Apprendimento elenca quello che Clink ha preso da come scrivi, così una parola imparata per errore si toglie da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「学習」タブにClinkがあなたの入力から覚えた単語が並ぶので、誤って学習したものはそこから削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학습 탭에 Clink이 입력에서 익힌 단어가 나열되니, 잘못 학습한 단어는 거기서 지우면 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab Pembelajaran menyenaraikan apa yang Clink pungut daripada taipan anda, jadi perkataan yang tersilap dipelajari boleh dibuang dari situ."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O separador Aprendizagem lista o que o Clink apanhou da tua escrita, por isso uma palavra aprendida por engano sai dali."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На вкладке «Обучение» перечислено то, что Clink подхватил из вашей печати, — слово, выученное по ошибке, можно убрать оттуда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“学习”标签列出了 Clink 从你打字中学到的词，学错的可以在那里删掉。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaart Õppimine loetleb, mida Clink sinu tipimisest üles on võtnud, seega ekslikult õpitud sõna saab sealt minna."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Leer-oortjie lys wat Clink van jou tik opgetel het, so 'n woord wat dit per ongeluk geleer het, kan daarvandaan gaan."
          }
        }
      }
    },
    "The Profile Switcher puts your saved setups in the keyboard's tools menu, so a swap takes two taps mid-conversation.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Profilwechsler legt deine gespeicherten Setups ins Tools-Menü der Tastatur — ein Wechsel mitten im Gespräch sind zwei Tipper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Cambio de perfil pone tus configuraciones guardadas en el menú de herramientas del teclado: cambiar en mitad de una conversación son dos toques."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Changeur de profil place tes configurations enregistrées dans le menu des outils du clavier : changer en pleine conversation prend deux touchers."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Profilváltó a mentett beállításaidat a billentyűzet eszközök menüjébe teszi, így beszélgetés közben két koppintás a váltás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Cambio profilo mette le tue configurazioni salvate nel menu strumenti della tastiera: cambiare a metà conversazione sono due tocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「プロファイル切り替え」は保存した設定一式をキーボードのツールメニューに置きます。会話の途中でも2タップで切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필 전환은 저장해 둔 설정들을 키보드 도구 메뉴에 올려 둡니다. 대화 도중에도 두 번만 누르면 바뀝니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penukar Profil meletakkan persediaan tersimpan anda dalam menu alat papan kekunci, jadi bertukar di tengah perbualan hanya dua ketikan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Troca de perfil põe as tuas configurações guardadas no menu de ferramentas do teclado: trocar a meio de uma conversa são dois toques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключатель профилей кладёт ваши сохранённые настройки в меню инструментов на клавиатуре, так что смена посреди разговора — два нажатия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“配置文件切换”把你保存的整套设置放进键盘的工具菜单，聊天中间两下就能换。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiilivahetaja paneb sinu salvestatud seadistused klaviatuuri tööriistade menüüsse, nii et vahetus võtab vestluse keskel kaks puudutust."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die profielskakelaar plaas u gestoorde opstellings in die sleutelbord se nutsgoedkieslys, so 'n ruil neem twee tikte mid-gesprek."
          }
        }
      }
    },
    "The arrangement this language types on. Build your own on the Layout screen first if none of these fit, since a made-up script usually wants its own keys.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anordnung, auf der diese Sprache getippt wird. Passt keine davon, bau dir zuerst auf dem Layout-Bildschirm eine eigene, denn eine erfundene Schrift will meist eigene Tasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposición con la que se escribe este idioma. Si ninguna encaja, créate una en la pantalla Disposición: una escritura inventada suele querer sus propias teclas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposition sur laquelle cette langue s’écrit. Si aucune ne convient, créez la vôtre depuis l’écran Disposition : une écriture inventée réclame en général ses propres touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elrendezés, amin ez a nyelv íródik. Ha egyik sem jó, előbb készíts sajátot az Elrendezés képernyőn, hiszen egy kitalált írás általában saját billentyűket kíván."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposizione su cui si scrive questa lingua. Se nessuna va bene, creane una tua nella schermata Disposizione: una scrittura inventata di solito vuole i suoi tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語を入力するキー配列です。合うものがなければ、先に「配列」画面で自作してください。つくった文字体系にはたいてい専用のキーが要ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 언어를 입력할 자판 배열입니다. 맞는 게 없으면 먼저 ‘배열’ 화면에서 직접 만드세요. 새로 만든 문자 체계에는 대개 전용 키가 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Susunan kekunci untuk menaip bahasa ini. Jika tiada yang sesuai, bina sendiri di skrin Susun Atur dahulu, kerana tulisan ciptaan biasanya mahukan kekuncinya sendiri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A disposição em que este idioma se escreve. Se nenhuma servir, cria a tua no ecrã Disposição: uma escrita inventada costuma querer teclas próprias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расположение клавиш, на котором печатает этот язык. Если ничего не подходит, сначала соберите своё на экране «Раскладка»: придуманной письменности обычно нужны свои клавиши."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这门语言使用的键位排布。若都不合适，先到「排布」页自己做一套，自造的文字通常需要专属按键。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paigutus, milles see keel tipitakse. Kui ükski ei sobi, ehita kõigepealt oma Paigutuse lehel, sest väljamõeldud kiri tahab tavaliselt oma klahve."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die rangskikking waarop hierdie taal tik. Bou eers jou eie op die uitlegskerm as nie een van hierdie pas nie, aangesien 'n opgemaakte skrif gewoonlik sy eie sleutels wil hê."
          }
        }
      }
    },
    "The bar suggests as you type, and misspellings fix themselves on the next space.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leiste schlägt beim Tippen vor, und Tippfehler korrigieren sich beim nächsten Leerzeichen von selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra sugiere mientras escribes y los errores se corrigen solos en el siguiente espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre propose des mots pendant que tu écris, et les fautes se corrigent toutes seules à l'espace suivant."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sáv gépelés közben javasol, az elgépelések pedig a következő szóköznél maguktól kijavulnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra suggerisce mentre scrivi e gli errori si correggono da soli allo spazio successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力に合わせてバーが候補を出し、打ち間違いは次のスペースで自動的に直ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력하는 동안 바가 단어를 추천하고, 오타는 다음 띄어쓰기에서 저절로 고쳐져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bar mencadangkan semasa anda menaip, dan kesilapan ejaan membetulkan diri pada ruang seterusnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra sugere enquanto escreves e os erros corrigem-se sozinhos no espaço seguinte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка подсказывает по ходу печати, а опечатки исправляются сами на следующем пробеле."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打字时建议栏会给出候选，拼错的词在下一个空格时自动改正。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Riba soovitab tipimise ajal ja eksitused parandavad end järgmise tühiku juures."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die balk stel voor terwyl jy tik, en spelfoute maak hulself reg op die volgende spasie."
          }
        }
      }
    },
    "The bubble a key shows while you hold it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Blase, die eine Taste zeigt, solange du sie hältst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La burbuja que muestra una tecla mientras la mantienes pulsada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bulle qu'affiche une touche tant que tu la maintiens"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A buborék, amit a billentyű mutat, amíg nyomva tartod"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La bolla che un tasto mostra mentre lo tieni premuto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを押している間に出る吹き出し"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누르고 있는 동안 나타나는 말풍선"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelembung yang ditunjukkan kekunci semasa kamu menahannya"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O balão que uma tecla mostra enquanto a manténs premida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пузырёк, который клавиша показывает во время удержания"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住按键时冒出的气泡"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mull, mida klahv hoidmise ajal näitab"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die borrel wat 'n sleutel wys terwyl jy dit vashou"
          }
        }
      }
    },
    "The button below takes you there": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón de abajo te lleva allí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton ci-dessous t'y emmène"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Taste unten kommst du direkt dorthin"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pulsante qui sotto ti porta lì"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão abaixo leva-te até lá"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Butang di bawah akan membawa anda ke sana"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alábbi gomb odavisz"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のボタンから開けます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击下方按钮即可前往"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 버튼을 누르면 바로 이동해요"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alumine nupp viib sind sinna"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка ниже приведёт вас туда"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die knoppie hieronder neem jou daarheen"
          }
        }
      }
    },
    "The cap shows exactly what the key types. Tap a character below to set both at once.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kappe zeigt genau, was die Taste tippt. Tipp unten auf ein Zeichen, um beides auf einmal festzulegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La leyenda muestra exactamente lo que escribe la tecla. Toca un carácter abajo para configurar ambos a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La légende montre exactement ce que la touche tape. Touche un caractère ci-dessous pour régler les deux d'un coup."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sapka pontosan azt mutatja, amit a billentyű beír. Koppints alul egy karakterre, hogy mindkettőt egyszerre beállítsd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La legenda mostra esattamente ciò che il tasto digita. Tocca un carattere qui sotto per impostare entrambi in una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キートップにはキーが入力する文字がそのまま表示されます。下の文字をタップすると両方を一度に設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키캡에는 키가 입력하는 문자가 그대로 표시돼요. 아래 문자를 탭하면 둘을 한 번에 설정할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muka kekunci menunjukkan tepat apa yang ditaip kekunci. Ketik aksara di bawah untuk tetapkan kedua-duanya sekali gus."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A legenda mostra exatamente o que a tecla escreve. Toca num caráter abaixo para definir ambos de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надпись показывает ровно то, что клавиша вводит. Нажмите на символ ниже, чтобы задать сразу и то и другое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键帽显示的就是按键输入的内容。点下面的字符可以一次设置两者。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kate näitab täpselt, mida klahv sisestab. Puuduta all märgile, et mõlemad korraga määrata."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die doppie wys presies wat die sleuteltipes is. Tik 'n karakter hieronder om albei gelyktydig te stel."
          }
        }
      }
    },
    "The colour behind the keys comes from your theme.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Farbe hinter den Tasten kommt von deinem Design."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El color detrás de las teclas viene de tu tema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur derrière les touches vient de ton thème."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk mögötti szín a témádból jön."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore dietro i tasti viene dal tuo tema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの後ろの色はテーマで決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 뒤의 색상은 테마에서 가져옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna di belakang kekunci datang daripada tema anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cor por trás das teclas vem do teu tema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвет за клавишами берётся из вашей темы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键后方的颜色来自你的主题。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Värv klahvide taga tuleb sinu teemast."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die kleur agter die sleutels kom van jou tema af."
          }
        }
      }
    },
    "The colour, gradient or photo itself belongs to the theme, so you set it in the theme builder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Farbe, der Verlauf oder das Foto selbst gehören zum Design — die stellst du im Design-Baukasten ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El color, el degradado o la foto en sí pertenecen al tema, así que se ajustan en el creador de temas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur, le dégradé ou la photo appartiennent au thème : tu les règles dans le créateur de thèmes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Maga a szín, a színátmenet vagy a fotó a témához tartozik, így azt a témaszerkesztőben állítod be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore, il gradiente o la foto appartengono al tema, quindi li imposti nel costruttore di temi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色やグラデーション、写真そのものはテーマのものなので、テーマビルダーで設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상, 그러데이션, 사진 자체는 테마의 것이라 테마 편집기에서 설정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna, gradien atau foto itu sendiri milik tema, jadi anda tetapkannya dalam pembina tema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cor, o gradiente ou a fotografia pertencem ao tema, por isso defines isso no criador de temas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сам цвет, градиент или фото принадлежат теме, поэтому задаются в редакторе тем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色、渐变和照片本身属于主题，在主题编辑器里设置。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Värv, üleminek või foto ise kuulub teemale, seega määrad sa selle teema ehitajas."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die kleur, gradiënt of foto self behoort aan die tema, so jy stel dit in die temabouer."
          }
        }
      }
    },
    "The copy on this device stays. Syncing for this one switches off, so it isn't sent back up.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie auf diesem Gerät bleibt. Die Synchronisierung dafür wird ausgeschaltet, damit sie nicht gleich wieder hochgeht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de este dispositivo se queda. Se desactiva su sincronización para que no vuelva a subir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie sur cet appareil reste. Sa synchronisation est désactivée pour qu’elle ne remonte pas aussitôt."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközön lévő másolat megmarad. Ehhez a szinkronizálás kikapcsol, hogy ne kerüljön vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia su questo dispositivo resta. La sincronizzazione per questa voce si disattiva, così non torna su."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末のコピーは残ります。再びアップロードされないよう、この項目の同期はオフになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 사본은 그대로 남습니다. 다시 올라가지 않도록 해당 항목의 동기화는 꺼집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan pada peranti ini kekal. Penyegerakan untuk yang satu ini dimatikan supaya ia tidak dihantar semula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia neste dispositivo fica. A sincronização deste item é desligada, para não voltar a subir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия на этом устройстве остаётся. Синхронизация для неё выключается, поэтому обратно она не отправляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备上的副本会保留。该项的同步会关闭，以免再次上传。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle seadme koopia jääb alles. Selle sünkroonimine lülitub välja, nii et seda tagasi üles ei saadeta."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die kopie op hierdie toestel bly. Sinkronisering vir hierdie een skakel af, so dit word nie teruggestuur nie."
          }
        }
      }
    },
    "The device is running warm. Glass keeps rendering, and the optional effects come back once it cools down.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät ist warm geworden. Das Glas bleibt, und die optionalen Effekte kommen zurück, sobald es abgekühlt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo se ha calentado. El cristal se mantiene y los efectos opcionales vuelven en cuanto se enfríe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil a chauffé. Le verre reste affiché et les effets facultatifs reviennent dès qu'il a refroidi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A készülék felmelegedett. Az üveg marad, a nem kötelező effektek pedig visszatérnek, amint lehűl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo si è scaldato. Il vetro resta e gli effetti opzionali tornano appena si raffredda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末が熱を持っています。ガラスはそのままで、任意のエフェクトは温度が下がると戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 뜨거워졌습니다. 글래스는 그대로 두고 선택적인 효과는 식으면 다시 돌아옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peranti sedang panas. Kaca kekal dan kesan pilihan kembali sebaik sahaja ia menyejuk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo aqueceu. O vidro continua e os efeitos opcionais voltam assim que arrefecer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство греется. Стекло по-прежнему рисуется, а необязательные эффекты вернутся, когда оно остынет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备有些发热。玻璃继续渲染，可选特效会在降温后恢复。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seade on soojaks läinud. Klaas jätkab renderdamist ja valikulised efektid tulevad tagasi, kui ta jahtub."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die toestel loop warm. Glas hou aan om weer te gee, en die opsionele effekte kom terug sodra dit afgekoel het."
          }
        }
      }
    },
    "The emoji stay in their normal categories. Only the set goes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Emojis bleiben in ihren normalen Kategorien. Nur das Set verschwindet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los emoji siguen en sus categorías de siempre. Solo desaparece el conjunto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les emoji restent dans leurs catégories habituelles. Seul le set disparaît."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az emojik a szokásos kategóriáikban maradnak. Csak a készlet tűnik el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le emoji restano nelle loro categorie di sempre. Sparisce solo il set."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵文字は元のカテゴリに残ります。なくなるのはセットだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이모지는 원래 카테고리에 그대로 있어요. 세트만 사라져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji kekal dalam kategori biasa. Hanya set itu yang hilang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os emoji ficam nas categorias normais. Só o conjunto desaparece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эмодзи остаются в своих обычных категориях. Исчезает только набор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表情还在原来的分类里，消失的只是这个合集。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Emojid jäävad oma tavakategooriatesse. Ainult komplekt läheb."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die emoji's bly in hul normale kategorieë. Net die stel gaan."
          }
        }
      }
    },
    "The entire contents of the field.": {
      "extractionState": "manual",
      "localizations": {
