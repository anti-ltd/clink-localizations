    "%@ stored, out of the 1 MB iCloud allows. Clink has no server, so none of it passes through us.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gestoor, uit die 1 MB wat iCloud toelaat. Clink het geen bediener nie, so niks daarvan gaan deur ons nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gespeichert, von dem 1 MB, das iCloud erlaubt. Clink hat keinen Server, also läuft nichts davon über uns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ guardados, del 1 MB que permite iCloud. Clink no tiene servidor, así que nada de esto pasa por nosotros."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ salvestatud iCloudi lubatud 1 MB-st. Clinkil pole serverit, seega ei lähe mitte midagi meie kaudu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stockés, sur le 1 Mo autorisé par iCloud. Clink n’a pas de serveur, donc rien de tout cela ne passe par nous."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tárolva az iCloud által engedélyezett 1 MB-ból. A Clinknek nincs szervere, így semmi sem halad át rajtunk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ salvati, su 1 MB consentito da iCloud. Clink non ha server, quindi nulla passa da noi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudが認めている1 MBのうち%@を使用しています。Clinkにはサーバーがないため、当社を経由するものは何もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud가 허용하는 1MB 중 %@를 사용 중입니다. Clink에는 서버가 없어 어떤 데이터도 저희를 거치지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disimpan, daripada 1 MB yang dibenarkan iCloud. Clink tiada pelayan, jadi tiada apa-apa melaluinya kami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ guardados, do 1 MB que o iCloud permite. O Clink não tem servidor, por isso nada disto passa por nós."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Занято %@ из 1 МБ, которые даёт iCloud. У Clink нет сервера, так что через нас ничего не проходит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储 %@，iCloud 允许 1 MB。Clink 没有服务器，因此这些内容都不会经过我们。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stocat, din cei 1 MB permisi de iCloud. Clink nu are server, așa că niciunul nu trece prin noi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opgeslagen, van de 1 MB die iCloud toestaat. Clink heeft geen server, dus niets ervan gaat via ons."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存 %@，iCloud 允許 1 MB。Clink 沒有伺服器，因此這些內容都不會經過我們。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zapisane, z 1 MB, na jakie pozwala iCloud. Clink nie ma serwera, więc nic przez nas nie przechodzi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stored, out of the 1 MB iCloud allows. Clink не має сервера, тому нічого з цього не проходить через нас."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ depolanan, 1 MB'lık iCloud'in dışına izin verir. Clink'in sunucusu yok, dolayısıyla hiçbiri bizim aracılığımızla geçmiyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uloženo, z 1 MB, které iCloud umožňuje. Clink nemá žádný server, takže přes nás žádný neprochází."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uložené, z 1 MB, ktoré iCloud umožňuje. Clink nemá server, takže žiadny z nich cez nás neprechádza."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ είναι αποθηκευμένο, από το 1 MB που επιτρέπει το iCloud. Το Clink δεν έχει διακομιστή, επομένως κανένας από αυτούς δεν περνάει από εμάς."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lagras, av 1 MB iCloud tillåter. Clink har ingen server, så ingen av den går igenom oss."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lagret, ud af de 1 MB iCloud tillader. Clink har ingen server, så intet af det passerer gennem os."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lagret, av de 1 MB iCloud tillater. Clink har ingen server, så ingen av dem går gjennom oss."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tallennettu, iCloud:n sallimasta 1 Mt:sta. Clink:llä ei ole palvelinta, joten mikään niistä ei kulje meidän kauttamme."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disimpan, dari 1 MB iCloud memungkinkan. Clink tidak memiliki server, jadi tidak ada satupun yang melewati kami."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ được lưu trữ, trong số 1 MB iCloud cho phép. Clink không có máy chủ nên không có máy chủ nào đi qua chúng tôi."
          }
        }
      }
