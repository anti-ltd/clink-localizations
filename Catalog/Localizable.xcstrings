    "Nothing is sent to anti.ltd or a third-party LLM.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niks word na anti.ltd of 'n derdeparty LLM gestuur nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird an anti.ltd oder ein fremdes LLM geschickt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se envía nada a anti.ltd ni a ningún LLM de terceros."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Midagi ei saadeta anti.ltd-le ega kolmanda osapoole LLM-ile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est envoyé à anti.ltd ni à un LLM tiers."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmit nem küldünk az anti.ltd-nek vagy külső LLM-nek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene inviato niente a anti.ltd o a un LLM di terze parti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "anti.ltd にも、他社の LLM にも、何も送られません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "anti.ltd나 다른 회사 LLM으로는 아무것도 보내지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa dihantar ke anti.ltd atau LLM pihak ketiga."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é enviado para a anti.ltd nem para um LLM de terceiros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не отправляется ни в anti.ltd, ни в сторонние языковые модели."
