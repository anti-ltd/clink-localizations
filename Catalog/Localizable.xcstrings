    "Neither is required. Here's what each one actually does.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie een word vereis nie. Hier is wat elkeen eintlik doen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beides ist optional. Hier steht, was es jeweils wirklich bewirkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna es obligatoria. Esto es lo que hace cada una."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumbagi pole vaja. Siin on, mida kumb tegelikult teeb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune n'est obligatoire. Voici ce que chacune fait vraiment."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyik sem kötelező. Íme, mit csinálnak valójában."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna delle due è obbligatoria. Ecco cosa fa davvero ciascuna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらも必須ではありません。それぞれの実際の役割はこちらです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다 필수는 아닙니다. 각각이 실제로 무엇을 하는지 알려드릴게요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua-duanya tidak diwajibkan. Ini yang setiap satu benar-benar lakukan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma é obrigatória. Veja o que cada uma faz de verdade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни то, ни другое не обязательно. Вот что каждое из них на самом деле делает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两者都不是必需的。以下是它们各自的实际作用。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nici unul nu este necesar. Iată ce face fiecare de fapt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen van beide is vereist. Dit is wat iedereen feitelijk doet."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩者都不是必需的。以下是它們各自的實際作用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne nie jest wymagane. Oto, co faktycznie robi każdy z nich."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ні того, ні іншого не потрібно. Ось що насправді робить кожен із них."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkisi de gerekli değil. İşte her birinin aslında yaptığı şey."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ani jedno není vyžadováno. Tady je to, co vlastně každý dělá."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevyžaduje sa ani jedno ani druhé. Tu je to, čo každý z nich skutočne robí."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κανένα από τα δύο δεν απαιτείται. Εδώ είναι τι κάνει ο καθένας στην πραγματικότητα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingetdera krävs. Här är vad var och en faktiskt gör."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen af dem er påkrævet. Her er hvad hver enkelt faktisk gør."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen av delene er påkrevd. Her er hva hver enkelt faktisk gjør."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpaakaan ei vaadita. Tässä on mitä kukin itse asiassa tekee."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keduanya tidak diperlukan. Inilah yang sebenarnya dilakukan masing-masing orang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần thiết. Đây là những gì mỗi người thực sự làm."
          }
        }
      }
    },
