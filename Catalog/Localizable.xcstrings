          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 내용을 읽고 바꿉니다. 전체 접근이 필요합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loeb ja asendab lõikelaua sisu. Vajab täielikku juurdepääsu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read and replace clipboard contents. Requires Full Access."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citiți și înlocuiți conținutul clipboard-ului. Necesită acces complet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees en vervang de inhoud van het klembord. Vereist volledige toegang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取和替換剪貼簿內容。需要完整取用許可權。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees en vervang knipbordinhoud. Vereis volle toegang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeczytaj i zamień zawartość schowka. Wymaga pełnego dostępu."
