        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τρέχει ακριβώς έξω από την άκρη, ώστε το κλειδί να διατηρεί το πλήρες μέγεθός του."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Går precis utanför kanten, så nyckeln behåller sin fulla storlek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kører lige uden for kanten, så nøglen holder sin fulde størrelse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Går like utenfor kanten, så nøkkelen beholder sin fulle størrelse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulkee aivan reunan ulkopuolella, joten avain säilyttää täyden kokonsa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
