          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI-Werkzeuge arbeiten, solange Clink geöffnet ist. Prüfe das Ergebnis, bevor du es kopierst oder deinen Text damit ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas de IA funcionan mientras Clink está abierto. Revisa el resultado antes de copiarlo o sustituir tu texto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehisintellekti tööriistad töötavad, kui Clink on avatud. Vaata tulemus üle, enne kui selle kopeerid või oma teksti asendad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils d’IA fonctionnent tant que Clink est ouvert. Vérifie le résultat avant de le copier ou de remplacer ton texte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az MI-eszközök akkor működnek, amikor a Clink meg van nyitva. Ellenőrizd az eredményt, mielőtt másolod vagy lecseréled vele a szöveget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli strumenti IA funzionano mentre Clink è aperto. Controlla il risultato prima di copiarlo o sostituire il testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIツールはClinkを開いている間に動作します。結果を確認してから、コピーするか元のテキストを置き換えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 도구는 Clink가 열려 있는 동안 작동합니다. 결과를 확인한 뒤 복사하거나 원래 텍스트를 바꾸세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat AI berfungsi semasa Clink dibuka. Semak hasilnya sebelum menyalin atau menggantikan teks anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ferramentas de IA funcionam enquanto o Clink está aberto. Revê o resultado antes de o copiares ou de substituíres o teu texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструменты ИИ работают, пока Clink открыт. Проверьте результат, прежде чем копировать его или заменять исходный текст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 工具会在 Clink 打开时运行。请先检查结果，再复制或替换原文。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrumentele AI funcționează cât timp Clink este deschis. Verifică rezultatul înainte de a-l copia sau de a înlocui textul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De AI-tools werken zolang Clink open is. Controleer het resultaat voordat je het kopieert of je tekst ermee vervangt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 工具會在 Clink 開啟時執行。請先檢查結果，再複製或取代原文。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narzędzia AI działają, gdy Clink jest otwarty. Sprawdź wynik, zanim go skopiujesz lub zastąpisz nim swój tekst."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інструменти ШІ працюють, поки Clink відкрито. Перевірте результат, перш ніж копіювати його або замінювати початковий текст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI araçları Clink açıkken çalışır. Metninizi kopyalamadan veya değiştirmeden önce sonucu gözden geçirin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nástroje AI fungují, když je Clink otevřený. Než výsledek zkopírujete nebo jím nahradíte text, zkontrolujte ho."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nástroje AI fungujú, keď je Clink otvorený. Pred skopírovaním výsledku alebo nahradením textu si výsledok skontrolujte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα εργαλεία AI λειτουργούν όσο το Clink είναι ανοιχτό. Έλεγξε το αποτέλεσμα πριν το αντιγράψεις ή αντικαταστήσεις το κείμενό σου."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-verktygen fungerar medan Clink är öppet. Granska resultatet innan du kopierar det eller ersätter din text."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-værktøjerne virker, mens Clink er åbent. Gennemgå resultatet, før du kopierer det eller erstatter din tekst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-verktøyene fungerer mens Clink er åpent. Se gjennom resultatet før du kopierer det eller erstatter teksten din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoälytyökalut toimivat, kun Clink on avoinna. Tarkista tulos ennen sen kopioimista tai tekstin korvaamista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat AI bekerja saat Clink terbuka. Periksa hasilnya sebelum menyalin atau mengganti teks Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ AI hoạt động khi Clink đang mở. Hãy kiểm tra kết quả trước khi sao chép hoặc thay thế văn bản."
          }
        }
      }
    },
    "Gemini Nano edits text on this device. Download its models from Google before first use.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano wysig teks op hierdie toestel. Laai die modelle voor die eerste gebruik by Google af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano bearbeitet Text auf diesem Gerät. Lade vor der ersten Nutzung die Modelle von Google herunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano edita el texto en este dispositivo. Descarga sus modelos de Google antes de usarlo por primera vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano muudab teksti selles seadmes. Enne esimest kasutamist laadi mudelid Google’ist alla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano modifie le texte sur cet appareil. Télécharge ses modèles depuis Google avant la première utilisation."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gemini Nano ezen az eszközön szerkeszti a szöveget. Az első használat előtt töltsd le a modelljeit a Google-tól."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano modifica il testo su questo dispositivo. Scarica i suoi modelli da Google prima del primo utilizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nanoはこのデバイス上でテキストを編集します。初めて使う前に、Googleからモデルをダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano는 이 기기에서 텍스트를 편집합니다. 처음 사용하기 전에 Google에서 모델을 다운로드하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano menyunting teks pada peranti ini. Muat turun modelnya daripada Google sebelum penggunaan pertama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gemini Nano edita o texto neste dispositivo. Descarrega os modelos da Google antes da primeira utilização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano редактирует текст на этом устройстве. Перед первым использованием скачайте модели с серверов Google."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano 会在此设备上编辑文本。首次使用前，请从 Google 下载所需模型。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano editează textul pe acest dispozitiv. Descarcă modelele de la Google înainte de prima utilizare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano bewerkt tekst op dit apparaat. Download de modellen van Google voordat je de functie voor het eerst gebruikt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano 會在這部裝置上編輯文字。首次使用前，請從 Google 下載所需模型。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano edytuje tekst na tym urządzeniu. Przed pierwszym użyciem pobierz modele z Google."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano редагує текст на цьому пристрої. Перед першим використанням завантажте моделі із серверів Google."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano metni bu cihazda düzenler. İlk kullanımdan önce modellerini Google’dan indirin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano upravuje text v tomto zařízení. Před prvním použitím si stáhněte modely od Googlu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano upravuje text v tomto zariadení. Pred prvým použitím si stiahnite modely od Googlu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Gemini Nano επεξεργάζεται κείμενο σε αυτή τη συσκευή. Κατέβασε τα μοντέλα του από την Google πριν από την πρώτη χρήση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano redigerar text på den här enheten. Ladda ner modellerna från Google före första användningen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano redigerer tekst på denne enhed. Download modellerne fra Google før første brug."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano redigerer tekst på denne enheten. Last ned modellene fra Google før første bruk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano muokkaa tekstiä tällä laitteella. Lataa mallit Googlelta ennen ensimmäistä käyttökertaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano menyunting teks di perangkat ini. Unduh modelnya dari Google sebelum penggunaan pertama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano chỉnh sửa văn bản trên thiết bị này. Hãy tải các mô hình từ Google trước lần sử dụng đầu tiên."
          }
        }
      }
