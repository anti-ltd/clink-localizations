            "state": "translated",
            "value": "Sederet angka di atas huruf."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một hàng chữ số phía trên các chữ cái."
          }
        }
      }
    },
    "A small hint on each key shows what holding it gives you.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleiner Hinweis auf jeder Taste zeigt, was Gedrückthalten bringt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pequeña pista en cada tecla muestra lo que obtienes al mantenerla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Väike vihje igal klahvil näitab, mida selle all hoidmine annab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit indice sur chaque touche montre ce que donne un appui prolongé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy kis jelzés minden billentyűn megmutatja, mit ad a nyomva tartás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un piccolo suggerimento su ogni tasto mostra cosa ottieni tenendolo premuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーの小さなヒントで、長押しで出る文字がわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 키의 작은 힌트로 길게 누르면 무엇이 나오는지 보여줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Petunjuk kecil pada setiap kekunci menunjukkan apa yang anda dapat apabila menahannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pequena dica em cada tecla mostra o que obténs ao mantê-la premida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маленькая подсказка на клавише показывает, что даёт удержание."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个按键上的小提示会显示长按可输入的内容。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mic indiciu pe fiecare tastă arată ce vă oferă ținerea ei."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een kleine hint op elke toets laat zien wat het vasthouden ervan je oplevert."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個按鍵上的小提示會顯示長按可輸入的內容。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "‘n Klein wenk op elke sleutel wys wat dit jou gee as jy dit hou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mała wskazówka na każdym klawiszu pokazuje, co daje trzymanie go."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невелика підказка на кожній клавіші показує, яке утримання вона дає."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her tuşun üzerindeki küçük bir ipucu, onu tutmanın size ne kazandırdığını gösterir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Malá nápověda na každé klávese ukazuje, jaké držení vám dává."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Malá nápoveda na každej klávese ukazuje, čo vám dáva jej držanie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια μικρή υπόδειξη σε κάθε πλήκτρο δείχνει τι σας δίνει το κράτημα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En liten ledtråd på varje tangent visar vilken hållning den ger dig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et lille tip på hver tast viser, hvilken holding den giver dig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et lite hint på hver tast viser hvilken holding den gir deg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieni vihje kussakin näppäimessä näyttää, mitä sen pitäminen antaa sinulle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Petunjuk kecil pada setiap tombol menunjukkan apa yang diberikannya kepada Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một gợi ý nhỏ trên mỗi phím cho biết việc giữ nó sẽ mang lại cho bạn những gì."
          }
        }
      }
    },
    "A smooth ribbon with a travelling glint of light.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Gladde lint met 'n reisende glinster van lig."
