    "Translate typed or pasted text into another language, right inside the keyboard. Adds a translate panel to the panel button.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vertaal getikte of geplakte teks in 'n ander taal, reg binne die sleutelbord. Voeg 'n vertaalpaneel by die paneelknoppie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetze getippten oder eingefügten Text direkt in der Tastatur in eine andere Sprache. Fügt der Bedienfeldtaste einen Übersetzungsbereich hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce a otro idioma el texto que escribas o pegues, ahí mismo en el teclado. Añade un panel de traducción al botón de paneles."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlgi sisestatud või kleepitud tekst teise keelde otse klaviatuuril. Lisab paneelinupule tõlkepaneeli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduis le texte saisi ou collé dans une autre langue, directement dans le clavier. Ajoute un panneau de traduction au bouton de panneaux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordítsd le a beírt vagy beillesztett szöveget másik nyelvre, egyből a billentyűzeten belül. Egy fordítópanelt tesz a panelgombra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduci il testo che digiti o incolli in un'altra lingua, direttamente nella tastiera. Aggiunge un pannello di traduzione al pulsante dei pannelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力した文字やペーストした文字を、キーボードの中でそのまま別の言語に翻訳します。パネルボタンに翻訳パネルを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력하거나 붙여넣은 텍스트를 키보드 안에서 바로 다른 언어로 번역해요. 패널 버튼에 번역 패널이 생겨요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemah teks yang ditaip atau ditampal ke bahasa lain, terus dalam papan kekunci. Menambah panel terjemah pada butang panel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduz texto escrito ou colado para outro idioma, mesmo dentro do teclado. Adiciona um painel de tradução ao botão de painéis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводите напечатанный или вставленный текст на другой язык прямо в клавиатуре. Добавляет панель перевода к кнопке панелей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘里就能把打的或粘贴的文字翻译成另一种语言。会给面板按钮加上一个翻译面板。"
          }
        }
      }
    },
    "Translate what?": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vertaal wat?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was übersetzen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué traducimos?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mida tõlkida?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduire quoi ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit fordítsunk?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa traduciamo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を翻訳しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 번역할까요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemah apa?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduzir o quê?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что перевести?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译什么？"
          }
        }
      }
    },
    "Translate with Apple Intelligence instead of Apple's offline language packs. Reads better, especially on idioms. Turn it off for faster translations and more languages.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vertaal met Apple Intelligence in plaas van Apple se vanlyn taalpakkette. Lees beter, veral oor idiome. Skakel dit af vir vinniger vertalings en meer tale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Apple Intelligence übersetzen statt mit Apples Offline-Sprachpaketen. Liest sich besser, vor allem bei Redewendungen. Ausschalten für schnellere Übersetzungen und mehr Sprachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce con Apple Intelligence en vez de con los paquetes de idioma sin conexión de Apple. Suena mejor, sobre todo con las expresiones hechas. Desactívalo para traducir más rápido y en más idiomas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlgi Apple Intelligence’iga Apple’i ühenduseta keelepakettide asemel. Loeb paremini, eriti väljendite puhul. Lülita välja kiiremate tõlgete ja rohkemate keelte jaoks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduit avec Apple Intelligence plutôt qu’avec les modules linguistiques hors ligne d’Apple. Le rendu est meilleur, surtout pour les expressions idiomatiques. Désactive-le pour des traductions plus rapides et plus de langues."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordítás Apple Intelligence-szel az Apple offline nyelvi csomagjai helyett. Jobban olvasható, főleg a szófordulatoknál. Kapcsold ki a gyorsabb fordításért és a több nyelvért."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce con Apple Intelligence invece che con i pacchetti lingua offline di Apple. Si legge meglio, soprattutto con i modi di dire. Disattivalo per traduzioni più veloci e più lingue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleのオフライン言語パックではなく Apple Intelligence で翻訳します。特に慣用表現が自然になります。オフにすると翻訳が速くなり、対応言語も増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple의 오프라인 언어 팩 대신 Apple Intelligence로 번역합니다. 특히 관용 표현이 훨씬 자연스럽습니다. 끄면 더 빠르게, 더 많은 언어로 번역할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemah dengan Apple Intelligence dan bukan pek bahasa luar talian Apple. Bacaannya lebih baik, terutama untuk simpulan bahasa. Matikan untuk terjemahan lebih pantas dan lebih banyak bahasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduz com a Apple Intelligence em vez dos pacotes de idioma offline da Apple. Fica mais bem escrito, sobretudo nas expressões idiomáticas. Desative para traduções mais rápidas e mais idiomas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводить через Apple Intelligence, а не через офлайн-пакеты Apple. Читается лучше, особенно на устойчивых выражениях. Выключите, если нужны более быстрый перевод и больше языков."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple Intelligence 翻译，而不是 Apple 的离线语言包。译文更通顺，尤其是习语。关闭后翻译更快，支持的语言也更多。"
          }
        }
      }
    },
