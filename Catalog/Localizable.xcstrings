    "Nudge each tap toward where you mean to hit. No effect until enough is learned": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiebt jeden Tipp dorthin, wo du treffen willst. Keine Wirkung, bis genug gelernt ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja cada toque hacia donde querías dar. Sin efecto hasta que aprenda lo suficiente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste chaque appui vers l'endroit que tu vises. Aucun effet tant que le clavier n'a pas assez appris"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden koppintást afelé tol, ahová célzol. Nincs hatása, amíg elég adat össze nem gyűlik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta ogni tocco verso dove vuoi colpire. Nessun effetto finché non ha imparato abbastanza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各タップを、狙った場所に寄せます。十分に学習するまでは効果がありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 탭을 노리는 곳으로 살짝 밀어줘요. 충분히 배우기 전까진 효과가 없어요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tolak setiap ketikan ke arah tempat anda nak kena. Tiada kesan sehingga cukup dipelajari"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurra cada toque para onde querias acertar. Sem efeito até aprender o suficiente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтягивать каждое нажатие туда, куда вы целитесь. Ничего не изменится, пока не накопится достаточно данных"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把每次点按往你真正想点的位置推一点。学得不够多时没效果"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Nihuta iga vajutust sinna, kuhu tabada tahtsid. Mõju puudub, enne kui on piisavalt õpitud"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Druk elke tik na die plek waar jy wil slaan. Geen effek totdat genoeg geleer is nie"
          }
        }
      }
    },
