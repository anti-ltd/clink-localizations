    "Hold the space bar and slide. Tap with another finger while dragging to start highlighting.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou die spasiebalk vas en skuif. Tik met 'n ander vinger terwyl jy sleep om te begin uitlig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Leertaste und schiebe. Tippe mit einem anderen Finger während des Ziehens, um zu markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la barra espaciadora y desliza. Toca con otro dedo mientras arrastras para empezar a marcar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia tühikuklahvi ja libise. Puuduta lohistamise ajal teise sõrmega, et alustada esiletõstmist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la barre d'espace et faites glisser. Touchez avec un autre doigt pendant le glissement pour commencer à sélectionner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd a szóközt, és csúsztasd. Koppints a másik ujjaddal húzás közben, és onnan jelöl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta la barra spaziatrice e fai scorrere. Tocca con un altro dito mentre trascini per iniziare a selezionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースバーを押しながらスライド。ドラッグ中にもう一方の指でタップすると選択が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 바를 누른 채 미세요. 끄는 동안 다른 손가락으로 탭하면 선택이 시작됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan bar ruang dan seret. Ketik dengan jari lain semasa menyeret untuk mula menonjolkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a barra de espaço e desliza. Toca com outro dedo enquanto arrastas para começar a destacar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте пробел и ведите. Коснитесь другим пальцем во время перетаскивания, чтобы начать выделение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住空格键滑动。拖动时用另一根手指点按即可开始选中。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți bara de spațiu și glisați. Atingeți cu un alt deget în timp ce trageți pentru a începe evidențierea."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de spatiebalk ingedrukt en schuif. Tik met een andere vinger terwijl u sleept om te beginnen met markeren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住空格鍵滑動。拖動時用另一根手指點按即可開始選中。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj spację i przesuń. Stuknij innym palcem podczas przeciągania, aby rozpocząć wyróżnianie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте пробіл і ковзайте. Торкніться іншим пальцем під час перетягування, щоб почати виділення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluk çubuğunu basılı tutun ve kaydırın. Vurgulamayı başlatmak için sürüklerken başka bir parmağınızla dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte mezerník a posuňte. Klepnutím dalším prstem při přetahování zahájíte zvýrazňování."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte medzerník a posuňte sa. Tap with another finger while dragging to start highlighting."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε το πλήκτρο διαστήματος και σύρετε. Πατήστε με ένα άλλο δάχτυλο ενώ σύρετε για να ξεκινήσετε την επισήμανση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll i mellanslagstangenten och skjut. Tryck med ett annat finger medan du drar för att börja markera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold mellemrumstasten og skub. Tryk med en anden finger, mens du trækker for at begynde at fremhæve."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold mellomromstasten og skyv. Trykk med en annen finger mens du drar for å begynne å utheve."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä välilyöntinäppäintä painettuna ja liu'uta. Aloita korostus napauttamalla toisella sormella vetäessäsi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan bilah spasi dan geser. Ketuk dengan jari lainnya sambil menyeret untuk mulai menyorot."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ phím cách và trượt. Nhấn bằng một ngón tay khác trong khi kéo để bắt đầu đánh dấu."
          }
        }
      }
    },
    "Hold the space bar and slide. Tap with another finger while holding space to start highlighting.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou die spasiebalk vas en skuif. Tik met 'n ander vinger terwyl jy spasie hou om te begin uitlig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Leertaste und schiebe. Tippe mit einem anderen Finger, während du sie hältst, um zu markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la barra espaciadora y desliza. Toca con otro dedo mientras la mantienes para empezar a marcar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia tühikuklahvi ja libise. Puuduta tühiku hoidmise ajal teise sõrmega, et alustada esiletõstmist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens la barre d’espace et fais glisser ton doigt. Sans la relâcher, touche l’écran avec un autre doigt pour commencer à sélectionner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd a szóközt, és csúsztasd. Koppints a másik ujjaddal tartás közben, és onnan jelöl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta la barra spaziatrice e fai scorrere. Tocca con un altro dito mentre la tieni premuta per iniziare a selezionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースバーを押しながらスライド。押したままもう一方の指でタップすると選択が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 바를 누른 채 미세요. 누르고 있는 동안 다른 손가락으로 탭하면 선택이 시작됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan bar ruang dan seret. Ketik dengan jari lain semasa menahannya untuk mula menonjolkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a barra de espaço e desliza. Toca com outro dedo enquanto a manténs para começar a destacar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте пробел и ведите. Коснитесь другим пальцем, удерживая пробел, чтобы начать выделение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住空格键滑动。按住时用另一根手指点按即可开始选中。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți bara de spațiu și glisați. Atingeți cu un alt deget în timp ce țineți spațiu pentru a începe evidențierea."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de spatiebalk ingedrukt en schuif. Tik met een andere vinger terwijl u de spatiebalk ingedrukt houdt om te beginnen met markeren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住空格鍵滑動。按住時用另一根手指點按即可開始選中。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj spację i przesuń. Stuknij innym palcem, przytrzymując spację, aby rozpocząć wyróżnianie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте пробіл і ковзайте. Торкніться іншим пальцем, утримуючи пробіл, щоб розпочати виділення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluk çubuğunu basılı tutun ve kaydırın. Vurgulamayı başlatmak için boşluk tutarken başka bir parmağınızla dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte mezerník a posuňte. Klepnutím dalším prstem při podržení mezery zahájíte zvýrazňování."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte medzerník a posuňte sa. Tap with another finger while holding space to start highlighting."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε το πλήκτρο διαστήματος και σύρετε. Πατήστε με ένα άλλο δάχτυλο ενώ κρατάτε κενό για να ξεκινήσετε την επισήμανση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll i mellanslagstangenten och skjut. Tryck med ett annat finger samtidigt som du håller mellanslag för att börja markera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold mellemrumstasten og skub. Tryk med en anden finger, mens du holder mellemrummet for at begynde at fremhæve."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold mellomromstasten og skyv. Trykk med en annen finger mens du holder mellomrom for å begynne å utheve."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä välilyöntinäppäintä painettuna ja liu'uta. Aloita korostus napauttamalla toisella sormella samalla, kun pidät välilyönnin painettuna."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan bilah spasi dan geser. Ketuk dengan jari lainnya sambil menahan spasi untuk mulai menyorot."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ phím cách và trượt. Nhấn bằng một ngón tay khác trong khi giữ phím cách để bắt đầu đánh dấu."
