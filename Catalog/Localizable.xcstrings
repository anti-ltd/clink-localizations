    "Lower priorities receive higher-ranked suggestions.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores de prioridad más bajos reciben las sugerencias mejor clasificadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs de priorité les plus basses reçoivent les suggestions les mieux classées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedrigere Prioritätswerte erhalten höher eingestufte Vorschläge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori di priorità più bassi ricevono i suggerimenti meglio classificati."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores de prioridade mais baixos recebem as sugestões mais bem classificadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем меньше значение приоритета, тем выше рейтинг назначенной подсказки."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai keutamaan yang lebih rendah menerima cadangan berkedudukan lebih tinggi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alacsonyabb prioritásértékek kapják az előrébb sorolt javaslatokat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "優先順位の数値が小さいほど、上位の候補が割り当てられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先级数值越低，分配到的候选词排名越高。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우선순위 값이 낮을수록 순위가 높은 추천이 배정됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Väiksema prioriteediväärtusega sihtmärgid saavad kõrgemal kohal olevad soovitused."
          }
        }
      }
    },
