    "Future taps get nudged back toward the target.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Toekomstige krane word teruggestoot na die teiken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spätere Tipper werden wieder Richtung Ziel geschoben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los toques siguientes se empujan de vuelta hacia el objetivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulevased vajutused nihutatakse tagasi sihi poole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appuis suivants sont ramenés vers la cible."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A későbbi koppintásokat visszatereli a cél felé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tocchi successivi vengono spinti di nuovo verso il bersaglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以降のタップは狙った位置へ寄せて補正されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이후의 탭은 목표 지점 쪽으로 살짝 당겨집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketikan seterusnya ditolak semula ke arah sasaran."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os toques seguintes são empurrados de volta para o alvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующие нажатия подтягиваются обратно к цели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后的点按会被往目标方向拉回。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Viitoarele atingeri sunt împinse înapoi spre țintă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toekomstige tikken worden teruggeduwd naar het doel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後的點按會被往目標方向拉回。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyszłe dotknięcia będą przesuwane z powrotem w stronę celu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Майбутні крани штовхають назад до цілі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelecekteki dokunuşlar hedefe doğru geri itilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Budoucí klepnutí se šťouchnou zpět k cíli."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Budúce kohútiky sa posunú späť k cieľu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μελλοντικά χτυπήματα σπρώχνονται πίσω προς τον στόχο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Framtida kranar knuffas tillbaka mot målet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fremtidige haner bliver skubbet tilbage mod målet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fremtidige kraner blir dyttet tilbake mot målet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulevat napautukset työnnetään takaisin kohti kohdetta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketukan di masa depan akan didorong kembali ke target."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lần nhấn trong tương lai sẽ bị đẩy lùi về phía mục tiêu."
          }
        }
      }
    },
