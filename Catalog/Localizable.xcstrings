    "Come back after a couple of days to see your weekly trend.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kom terug na 'n paar dae om jou weeklikse neiging te sien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau in ein paar Tagen wieder vorbei, um deinen Wochentrend zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve dentro de un par de días para ver la tendencia de la semana."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tule mõne päeva pärast tagasi, et näha oma nädalatrendi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviens dans quelques jours pour voir ta tendance de la semaine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézz vissza pár nap múlva a heti trendért."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna tra un paio di giorni per vedere l'andamento della settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数日後に戻ると、週間の傾向を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "며칠 뒤에 다시 오면 주간 추이를 볼 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Datang semula selepas beberapa hari untuk melihat trend mingguan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta daqui a alguns dias para veres a tendência da semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернитесь через пару дней, чтобы увидеть свою недельную динамику."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过几天再来看看本周趋势。"
          }
        }
      }
    },
