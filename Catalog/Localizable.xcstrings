    "Reopen on the category you used last.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Heropen op die kategorie wat jy laas gebruik het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet wieder die Kategorie, die du zuletzt benutzt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a abrirse en la categoría que usaste la última vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaneb uuesti viimati kasutatud kategoorial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvre sur la catégorie que tu as utilisée en dernier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azt a kategóriát nyitja meg újra, amit utoljára használtál."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si riapre sulla categoria che hai usato per ultima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に使ったカテゴリを開き直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막에 쓴 카테고리로 다시 열려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka semula pada kategori yang anda guna terakhir."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta a abrir na categoria que usaste por último."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывать на той категории, где вы были в прошлый раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
