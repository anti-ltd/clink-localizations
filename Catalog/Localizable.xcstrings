    "Finger-write and Clink types it out": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Finger schreiben – Clink tippt es"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe con el dedo y Clink lo teclea"
          }
        },
        "fr": {
