          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na výsledok otvoríte jeho stránku a zobrazíte zodpovedajúce ovládacie prvky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ένα αποτέλεσμα για να ανοίξετε τη σελίδα του και να αποκαλύψετε τα στοιχεία ελέγχου που ταιριάζουν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ett resultat för att öppna dess sida och visa de matchande kontrollerna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på et resultat for at åbne dets side og afsløre de matchende kontroller."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på et resultat for å åpne siden og avsløre de samsvarende kontrollene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta tulosta avataksesi sen sivun ja paljastaaksesi vastaavat ohjaimet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk hasil untuk membuka halamannya dan menampilkan kontrol yang cocok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào một kết quả để mở trang của nó và hiển thị các điều khiển phù hợp."
          }
        }
      }
    },
    "Tap a spot on the bar to type that emoji.": {
      "extractionState": "manual",
      "localizations": {
