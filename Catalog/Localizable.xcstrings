    "Matches this theme's haptic strength and key volume.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas hierdie tema se haptiese sterkte en sleutelvolume toe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimmt Haptikstärke und Tastenlautstärke dieses Designs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica la intensidad háptica y el volumen de teclas de este tema."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võtab üle selle teema puutetagasiside tugevuse ja klahvide helitugevuse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprend l'intensité haptique et le volume des touches de ce thème."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Átveszi a téma rezgéserősségét és billentyűhangerejét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applica l'intensità aptica e il volume dei tasti di questo tema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテーマの触覚フィードバックの強さとキー音量に合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 테마의 햅틱 강도와 키 음량을 적용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyamai kekuatan haptik dan kelantangan kekunci tema ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica a intensidade háptica e o volume das teclas deste tema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задаёт силу вибрации и громкость клавиш из этой темы."
          }
        },
        "zh-Hans": {
