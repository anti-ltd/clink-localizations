    "Clipboard history can include private text like passwords. It's encrypted before it leaves and only ever goes through your own iCloud account.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zwischenablage-Verlauf kann private Texte wie Passwörter enthalten. Er wird vor dem Versand verschlüsselt und läuft nur über deinen eigenen iCloud-Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial del portapapeles puede incluir texto privado, como contraseñas. Se cifra antes de salir y solo pasa por tu propia cuenta de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique du presse-papiers peut contenir du texte privé, comme des mots de passe. Il est chiffré avant de partir et ne passe que par ton propre compte iCloud."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágólap-előzmények bizalmas szöveget, például jelszavakat is tartalmazhatnak. Indulás előtt titkosítjuk, és csak a saját iCloud-fiókodon halad át."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia degli appunti può contenere testo privato, come le password. Viene cifrata prima di partire e passa solo dal tuo account iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード履歴にはパスワードなどの個人的な文字列が含まれることがあります。送信前に暗号化され、あなた自身のiCloudアカウントだけを通ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 기록에는 비밀번호 같은 개인적인 텍스트가 들어 있을 수 있습니다. 전송 전에 암호화되며, 사용자의 iCloud 계정만 거칩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejarah papan keratan boleh mengandungi teks peribadi seperti kata laluan. Ia disulitkan sebelum keluar dan hanya melalui akaun iCloud anda sendiri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico da área de transferência pode incluir texto privado, como palavras-passe. É encriptado antes de sair e passa apenas pela tua própria conta iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В истории буфера обмена может оказаться личное — например, пароли. Она шифруется перед отправкой и проходит только через ваш собственный аккаунт iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板历史可能包含密码等私密文字。它在离开设备前就已加密，并且只经过你自己的 iCloud 账户。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lõikelaua ajalugu võib sisaldada privaatset teksti nagu paroolid. See krüptitakse enne saatmist ja läheb ainult sinu enda iCloudi konto kaudu."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Knipbordgeskiedenis kan privaat teks soos wagwoorde insluit. Dit word geënkripteer voordat dit vertrek en gaan slegs deur jou eie iCloud-rekening."
          }
        }
      }
    },
    "Clipboard history is off. Turn it on to use and customize it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zwischenablage-Verlauf ist aus. Schalte ihn ein, um ihn zu nutzen und anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial del portapapeles está desactivado. Actívalo para usarlo y personalizarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historique du presse-papiers est désactivé. Active-le pour l'utiliser et le personnaliser."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágólap-előzmények ki vannak kapcsolva. Kapcsold be, hogy használhasd és beállíthasd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia degli appunti è disattivata. Attivala per usarla e personalizzarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード履歴はオフです。オンにすると使えて、設定も変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 기록이 꺼져 있어요. 켜면 쓰고 설정도 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejarah papan keratan dimatikan. Hidupkannya untuk guna dan sesuaikannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico da área de transferência está desligado. Liga-o para o usares e personalizares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История буфера обмена выключена. Включите её, чтобы пользоваться и настраивать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板历史已关闭。打开后就能使用并调整设置。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lõikelaua ajalugu on väljas. Lülita see sisse, et kasutada ja kohandada."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Knipbordgeskiedenis is af. Skakel dit aan om dit te gebruik en aan te pas."
          }
        }
      }
    },
    "Clipboard history needs Full Access to read what you've copied.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zwischenablage-Verlauf braucht Vollzugriff, um zu lesen, was du kopiert hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial del portapapeles necesita acceso completo para leer lo que has copiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historique du presse-papiers a besoin de l'accès complet pour lire ce que tu as copié."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágólap-előzményekhez Teljes hozzáférés kell, hogy lássa, mit másoltál."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia degli appunti ha bisogno dell'accesso completo per leggere ciò che hai copiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード履歴では、コピーした内容を読み取るためにフルアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 기록은 복사한 내용을 읽어야 해서 전체 접근이 필요해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejarah papan keratan perlukan Akses Penuh untuk baca apa yang anda salin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico da área de transferência precisa de acesso total para ler o que copiaste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Истории буфера обмена нужен полный доступ, чтобы читать скопированное."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板历史需要完全访问权限，才能读到你复制的内容。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lõikelaua ajalugu vajab täisjuurdepääsu, et lugeda seda, mida oled kopeerinud."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Knipbordgeskiedenis benodig Volle Toegang om te lees wat jy gekopieer het."
          }
        }
      }
    },
    "Clipboard history only runs when the panel is on and Full Access is granted.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zwischenablageverlauf läuft nur, wenn das Panel an ist und du Vollzugriff erlaubt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial del portapapeles solo funciona con el panel activado y el acceso completo dado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historique du presse-papiers ne marche que si le panneau est activé et l'accès complet accordé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágólap-előzmények csak akkor futnak, ha be van kapcsolva a panel, és megadtad a teljes hozzáférést."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia appunti funziona solo con il pannello attivo e l'accesso completo concesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード履歴は、パネルがオンでフルアクセスも許可されているときだけ動きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 기록은 패널이 켜져 있고 전체 접근이 허용됐을 때만 돌아가요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejarah papan keratan cuma berjalan bila panel dihidupkan dan Akses Penuh diberikan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico da área de transferência só corre com o painel ligado e o acesso total concedido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История буфера обмена работает, только когда включена панель и выдан полный доступ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有开了面板并给了完全访问，剪贴板历史才会运行。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lõikelaua ajalugu töötab ainult siis, kui paneel on sees ja täisjuurdepääs on antud."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Knipbordgeskiedenis loop slegs wanneer die paneel aan is en volle toegang verleen word."
          }
        }
      }
    },
