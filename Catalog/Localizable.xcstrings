    "Horizontal gap between adjacent keys in the same row.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Horisontale gaping tussen aangrensende sleutels in dieselfde ry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der waagerechte Abstand zwischen zwei Tasten in derselben Reihe."
