        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 이상에서는 AI 도움이 휴대폰의 Apple Intelligence를 써요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada iOS 26+, bantuan AI guna Apple Intelligence pada telefon anda."
