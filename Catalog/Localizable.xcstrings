        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성된 초안을 검증할 수 없습니다. 다른 방식으로 설명해 보세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loodud mustandit ei saanud valideerida. Proovi seda teisiti kirjeldada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schița generată nu a putut fi validată. Încercați să o descrieți altfel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gegenereerde concept kan niet worden gevalideerd. Probeer het eens anders te omschrijven."
