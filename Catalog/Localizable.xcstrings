    "Keeps the tool on but takes it out of the panel button and the slide-up list.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou die instrument aan, maar haal dit uit die paneelknoppie en die opskuiflys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt das Werkzeug an, nimmt es aber aus dem Panel-Button und der Liste heraus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la herramienta activada pero la quita del botón de paneles y de la lista."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoiab tööriista sees, aga võtab selle paneelinupust ja üleslibisevate loendist välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde l'outil activé mais le retire du bouton de panneaux et de la liste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolva hagyja az eszközt, de kiveszi a panelgombból és a listából."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene lo strumento attivo ma lo toglie dal pulsante dei pannelli e dall'elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールはオンのまま、パネルボタンと一覧からだけ外します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구는 켠 채로, 패널 버튼과 목록에서만 빼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengekalkan alat ini hidup tetapi mengeluarkannya daripada butang panel dan senarai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a ferramenta ligada, mas tira-a do botão de painéis e da lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставляет инструмент включённым, но убирает его из кнопки панелей и списка по подъёму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具仍然开着，只是从面板按钮和列表里移除。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Menține instrumentul pornit, dar îl scoate din butonul panoului și din lista glisantă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt de tool ingeschakeld, maar haalt deze uit de paneelknop en de schuiflijst."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具仍然開著，只是從面板按鈕和列表裡移除。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuje narzędzie włączone, ale usuwa je z przycisku panelu i listy wysuwanej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає інструмент увімкненим, але вилучає його з кнопки панелі та списку слайдів."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aracı açık tutar ancak panel düğmesinin ve kayan listenin dışına çıkarır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechá nástroj zapnutý, ale odstraní jej z tlačítka panelu a vysouvacího seznamu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechá nástroj zapnutý, ale odstráni ho z tlačidla panela a vysúvacieho zoznamu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατηρεί το εργαλείο ενεργοποιημένο, αλλά το βγάζει από το κουμπί του πίνακα και τη λίστα slide-up."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåller verktyget på men tar bort det från panelknappen och listan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Holder værktøjet tændt, men tager det ud af panelknappen og slide-up-listen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Holder verktøyet på, men tar det ut av panelknappen og skyvelisten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitää työkalun päällä, mutta poistaa sen paneelipainikkeesta ja liukuluettelosta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap mengaktifkan alat tetapi mengeluarkannya dari tombol panel dan daftar geser ke atas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
