    "Learned words show up in the suggestion bar as you type.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aangeleerde woorde verskyn in die voorstelbalk terwyl jy tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelernte Wörter erscheinen beim Tippen in der Vorschlagsleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras aprendidas aparecen en la barra de sugerencias mientras escribes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Õpitud sõnad ilmuvad tipimise ajal soovituseribale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots appris apparaissent dans la barre de suggestions pendant que tu tapes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megtanult szavak gépelés közben megjelennek a javaslatsávban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole apprese compaiono nella barra dei suggerimenti mentre scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習した単語は入力中に変換候補バーに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학습한 단어는 입력할 때 추천 바에 나타나요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
