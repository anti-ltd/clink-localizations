    "Tools fill the keyboard as a grid of tiles.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werkzeuge füllen die Tastatur als Kachelraster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas llenan el teclado como una cuadrícula de mosaicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils remplissent le clavier sous forme de grille de tuiles."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközök csempékből álló rácsként töltik ki a billentyűzetet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli strumenti riempiono la tastiera come una griglia di riquadri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールがタイル状に並んでキーボードいっぱいに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구가 타일 격자로 키보드를 가득 채워요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alatan memenuhi papan kekunci sebagai grid jubin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ferramentas preenchem o teclado como uma grelha de mosaicos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструменты заполняют клавиатуру сеткой плиток."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具以方块网格铺满整个键盘。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tööriistad täidavad klaviatuuri plaatide ruudustikuna."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gereedskap vul die sleutelbord as 'n rooster van teëls."
          }
        }
      }
    },
