    "Pin something in Cling and it shows up here.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Speld iets in Cling vas en dit verskyn hier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinne etwas in Cling an, und es erscheint hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda algo en Cling y aparecerá aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinnita midagi Clingis ja see ilmub siia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épingle quelque chose dans Cling et ça apparaîtra ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzíts valamit a Clingben, és itt megjelenik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi qualcosa in Cling e comparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling に何かピン留めすると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling에 무언가를 고정하면 여기에 나타납니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan sesuatu dalam Cling dan ia muncul di sini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe algo no Cling e aparece aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
