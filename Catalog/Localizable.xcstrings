          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na nástroj nebo podržte tlačítko a přejeďte na něj jediným pohybem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnite na nástroj alebo podržte tlačidlo a posuňte sa naň jedným pohybom."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ένα εργαλείο ή κρατήστε πατημένο το κουμπί και σύρετε σε ένα με μία κίνηση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ett verktyg, eller håll nere knappen och glid på ett i ett enda drag."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på et værktøj, eller hold knappen nede, og glid ned på et værktøj i et enkelt træk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på et verktøy, eller hold nede knappen og skyv på et verktøy i et enkelt trekk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta työkalua tai pidä painiketta painettuna ja liu'uta työkalun päälle yhdellä liikkeellä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk alat, atau tahan tombol dan geser ke salah satu alat dalam satu gerakan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào một công cụ hoặc giữ nút và trượt lên một công cụ chỉ bằng một lần di chuyển."
          }
        }
      }
    },
    "Tap an item on the bar above to change it. Hold the bar to move items around.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Element in der Leiste oben, um es zu ändern. Halte die Leiste gedrückt, um Elemente zu verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un elemento de la barra de arriba para cambiarlo. Mantén pulsada la barra para mover elementos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta ülal ribal üksust, et seda muuta. Hoia riba all, et üksusi liigutada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un élément de la barre ci-dessus pour le modifier. Maintenez la barre pour déplacer les éléments."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy elemre a fenti sávon a módosításához. Tartsd nyomva a sávot az elemek áthelyezéséhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un elemento nella barra in alto per modificarlo. Tieni premuta la barra per spostare gli elementi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上のバーの項目をタップして変更します。バーを長押しすると項目を移動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 막대의 항목을 탭해 변경하세요. 막대를 길게 누르면 항목을 옮길 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik item pada bar di atas untuk menukarnya. Tahan bar untuk mengalihkan item."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num item da barra acima para alterá-lo. Mantenha a barra pressionada para mover itens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь элемента на панели выше, чтобы изменить его. Удерживайте панель, чтобы перемещать элементы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点上方栏中的项目即可更改。按住栏可移动项目。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți un element din bara de mai sus pentru a-l schimba. Țineți bara pentru a muta obiectele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een item in de balk hierboven om het te wijzigen. Houd de balk vast om items te verplaatsen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點上方欄中的專案即可更改。按住欄可移動專案。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op 'n item op die balk hierbo om dit te verander. Hou die balk in om items te verskuif."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij element na pasku powyżej, aby go zmienić. Przytrzymaj pasek, aby przesuwać przedmioty."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться елемента на панелі вище, щоб змінити його. Утримуйте панель, щоб переміщати предмети."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirmek için yukarıdaki çubuktaki bir öğeye dokunun. Öğeleri hareket ettirmek için çubuğu basılı tutun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na položku na liště výše ji změníte. Chcete-li položky přesouvat, držte lištu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na položku na paneli vyššie ju zmeníte. Ak chcete presúvať položky, podržte lištu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ένα στοιχείο στη γραμμή παραπάνω για να το αλλάξετε. Κρατήστε τη μπάρα για να μετακινήσετε αντικείμενα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ett objekt i fältet ovan för att ändra det. Håll i stången för att flytta runt föremål."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på et element på bjælken ovenfor for at ændre det. Hold stangen for at flytte rundt på genstande."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på et element på linjen ovenfor for å endre det. Hold stangen for å flytte rundt på elementer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta kohdetta yllä olevassa palkissa muuttaaksesi sitä. Pidä palkkia siirtääksesi kohteita."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk item pada bilah di atas untuk mengubahnya. Tahan bilah untuk memindahkan item."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào một mục trên thanh phía trên để thay đổi mục đó. Giữ thanh để di chuyển các mục xung quanh."
          }
        }
      }
    },
    "Tap anything to change it. Hold and drag to move it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf etwas, um es zu ändern. Halten und ziehen, um es zu verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cualquier cosa para cambiarla. Mantén pulsado y arrastra para moverla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta, et muuta. Hoia ja lohista, et liigutada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un élément pour le modifier. Maintiens-le et fais-le glisser pour le déplacer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints bármire a módosításhoz. Tartsd lenyomva és húzd az áthelyezéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un elemento per cambiarlo. Tieni premuto e trascina per spostarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップで変更、長押ししてドラッグで移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 눌러 바꾸고, 길게 눌러 드래그하면 옮길 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik apa-apa untuk mengubahnya. Tahan dan seret untuk mengalihkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num elemento para o alterar. Mantenha-o premido e arraste para o mover."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на элемент, чтобы изменить его. Удерживайте и тяните, чтобы переместить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点即可更改，按住并拖动即可移动。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge orice pentru a-l schimba. Țineți apăsat și trageți pentru ao muta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op iets om het te wijzigen. Houd ingedrukt en sleep om het te verplaatsen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點即可更改，按住並拖動即可移動。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op enigiets om dit te verander. Hou in en sleep om dit te verskuif."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij cokolwiek, aby to zmienić. Przytrzymaj i przeciągnij, aby go przesunąć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть будь-що, щоб змінити це. Утримуйте та перетягуйте, щоб перемістити його."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirmek için herhangi bir şeye dokunun. Taşımak için basılı tutun ve sürükleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na cokoli to změníte. Podržením a přetažením jej přesunete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na čokoľvek to zmeníte. Podržaním a potiahnutím ho presuniete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε οτιδήποτε για να το αλλάξετε. Κρατήστε και σύρετε για να το μετακινήσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på vad som helst för att ändra det. Håll och dra för att flytta den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på hvad som helst for at ændre det. Hold og træk for at flytte den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på hva som helst for å endre det. Hold og dra for å flytte den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta mitä tahansa muuttaaksesi sitä. Pidä ja vedä siirtääksesi sitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk apa pun untuk mengubahnya. Tahan dan seret untuk memindahkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào bất cứ điều gì để thay đổi nó. Giữ và kéo để di chuyển nó."
          }
        }
      }
    },
    "Tap anywhere with another finger while dragging to start highlighting.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik enige plek met 'n ander vinger terwyl jy sleep om te begin uitlig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe während des Ziehens mit einem anderen Finger irgendwo hin, um zu markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca en cualquier parte con otro dedo mientras arrastras para empezar a marcar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta lohistamise ajal teise sõrmega kuskil, et alustada esiletõstmist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez n'importe où avec un autre doigt pendant le glissement pour commencer à sélectionner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints máshova a másik ujjaddal húzás közben, és onnan jelöl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ovunque con un altro dito mentre trascini per iniziare a selezionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグ中にもう一方の指でどこかをタップすると選択が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄는 동안 다른 손가락으로 아무 곳이나 탭하면 선택이 시작됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik di mana-mana dengan jari lain semasa menyeret untuk mula menonjolkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em qualquer lado com outro dedo enquanto arrastas para começar a destacar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь в любом месте другим пальцем во время перетаскивания, чтобы начать выделение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动时用另一根手指点按任意处即可开始选中。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți oriunde cu un alt deget în timp ce trageți pentru a începe evidențierea."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik ergens met een andere vinger terwijl u sleept om te beginnen met markeren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動時用另一根手指點按任意處即可開始選中。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij w dowolnym miejscu innym palcem podczas przeciągania, aby rozpocząć wyróżnianie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться будь-де іншим пальцем під час перетягування, щоб почати виділення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vurgulamayı başlatmak için sürüklerken başka bir parmağınızla herhangi bir yere dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím kamkoli jiným prstem při přetahování zahájíte zvýrazňování."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknutím kdekoľvek iným prstom počas ťahania spustíte zvýrazňovanie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε οπουδήποτε με ένα άλλο δάχτυλο ενώ σύρετε για να ξεκινήσετε την επισήμανση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck var som helst med ett annat finger medan du drar för att börja markera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk hvor som helst med en anden finger, mens du trækker for at begynde at fremhæve."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk hvor som helst med en annen finger mens du drar for å begynne å utheve."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita korostus napauttamalla mitä tahansa toisella sormella samalla kun vedät."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk di mana saja dengan jari lainnya sambil menyeret untuk mulai menyorot."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào bất kỳ đâu bằng ngón tay khác trong khi kéo để bắt đầu đánh dấu."
          }
        }
      }
    },
