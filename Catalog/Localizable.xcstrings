    "Translate is off. Turn it on to use and customize it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertaal is af. Skakel dit aan om dit te gebruik en aan te pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzen ist aus. Schalte es ein, um es zu nutzen und anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción está desactivada. Actívala para usarla y personalizarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlge on väljas. Lülita see sisse, et kasutada ja kohandada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction est désactivée. Active-la pour l'utiliser et la personnaliser."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fordítás ki van kapcsolva. Kapcsold be, hogy használhasd és beállíthasd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione è disattivata. Attivala per usarla e personalizzarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳はオフです。オンにすると使えて、設定も変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역이 꺼져 있어요. 켜면 쓰고 설정도 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemah dimatikan. Hidupkannya untuk guna dan sesuaikannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução está desligada. Liga-a para a usares e personalizares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод выключен. Включите его, чтобы пользоваться и настраивать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译已关闭。打开后就能使用并调整设置。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducerea este dezactivată. Porniți-l pentru ao utiliza și personalizați."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertalen staat uit. Schakel het in om het te gebruiken en aan te passen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻譯已關閉。開啟後就能使用並調整設定。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tłumacz jest wyłączony. Włącz go, aby go używać i dostosowywać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переклад вимкнено. Увімкніть його, щоб використовувати та налаштовувати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri kapalı. Kullanmak ve özelleştirmek için açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překladač je vypnutý. Zapněte jej, abyste jej mohli používat a přizpůsobovat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekladač je vypnutý. Zapnite ho, aby ste ho mohli používať a prispôsobovať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μετάφραση είναι απενεργοποιημένη. Ενεργοποιήστε το για να το χρησιμοποιήσετε και να το προσαρμόσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Översätt är avstängt. Slå på den för att använda och anpassa den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oversæt er slået fra. Tænd den for at bruge og tilpasse den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oversett er av. Slå den på for å bruke og tilpasse den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käännös on pois päältä. Ota se käyttöön, jotta voit käyttää ja muokata sitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan tidak aktif. Aktifkan untuk menggunakan dan menyesuaikannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch đã tắt. Bật nó lên để sử dụng và tùy chỉnh nó."
          }
        }
      }
    },
