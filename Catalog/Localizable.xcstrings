    "Commands run once per event. Configuration overrides last until the keyboard closes or you clear them.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comandos se ejecutan una vez por evento. Los cambios temporales duran hasta que cierres el teclado o los borres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes s’exécutent une fois par événement. Les réglages temporaires restent jusqu’à la fermeture du clavier ou leur effacement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehle laufen einmal pro Ereignis. Temporäre Einstellungen gelten bis zum Schließen der Tastatur oder bis du sie zurücksetzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I comandi vengono eseguiti una volta per evento. Le modifiche temporanee restano finché chiudi la tastiera o le rimuovi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os comandos são executados uma vez por evento. As alterações temporárias duram até fechares o teclado ou as limpares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команды выполняются один раз на событие. Временные настройки действуют до закрытия клавиатуры или их сброса."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahan berjalan sekali bagi setiap peristiwa. Tetapan sementara kekal sehingga papan kekunci ditutup atau anda mengosongkannya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A parancsok eseményenként egyszer futnak. Az ideiglenes beállítások a billentyűzet bezárásáig vagy törlésükig maradnak érvényben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドはイベントごとに1回実行されます。一時設定は、キーボードを閉じるか解除するまで有効です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个事件执行一次命令。临时配置持续到键盘关闭或手动清除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령은 이벤트마다 한 번 실행됩니다. 임시 설정은 키보드를 닫거나 직접 해제할 때까지 유지됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Käsud käivitatakse üks kord sündmuse kohta. Ajutised seaded kehtivad klaviatuuri sulgemise või nende tühjendamiseni."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comenzile rulează o dată pe eveniment. Configurația înlocuiește ultimele până când tastatura se închide sau le ștergeți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Commando's worden één keer per gebeurtenis uitgevoerd. Configuratieoverschrijvingen duren totdat het toetsenbord wordt gesloten of u deze wist."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個事件執行一次命令。臨時配置持續到鍵盤關閉或手動清除。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdragte word een keer per gebeurtenis uitgevoer. Konfigurasie-oorskrywings hou aan totdat die sleutelbord sluit of jy dit uitvee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polecenia są uruchamiane raz na zdarzenie. Zastąpienia konfiguracji obowiązują do momentu zamknięcia klawiatury lub ich wyczyszczenia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Команди запускаються один раз на подію. Перевизначення конфігурації триває, доки клавіатура не закриється або ви не очистите їх."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komutlar olay başına bir kez çalıştırılır. Yapılandırma geçersiz kılmaları, klavye kapatılana veya siz bunları temizleyene kadar sürer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příkazy se spouštějí jednou za událost. Přepisy konfigurace trvají, dokud se klávesnice nezavře nebo je nevymažete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príkazy sa spúšťajú raz za udalosť. Prepisy konfigurácie trvajú dovtedy, kým sa klávesnica nezatvorí alebo kým ich nevymažete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εντολές εκτελούνται μία φορά ανά συμβάν. Οι παρακάμψεις διαμόρφωσης διαρκούν μέχρι να κλείσει το πληκτρολόγιο ή να τις διαγράψετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandon körs en gång per händelse. Konfigurationen åsidosätter sist tills tangentbordet stängs eller du rensar dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandoer kører én gang pr. begivenhed. Konfigurationstilsidesættelser varer indtil tastaturet lukker, eller du rydder dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandoer kjøres én gang per hendelse. Konfigurasjonsoverstyringer varer til tastaturet lukkes eller du sletter dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Komennot suoritetaan kerran tapahtumaa kohden. Määritysten ohitukset kestävät, kunnes näppäimistö sulkeutuu tai tyhjennät ne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perintah dijalankan satu kali per acara. Pengabaian konfigurasi berlangsung hingga keyboard ditutup atau Anda menghapusnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lệnh chạy một lần cho mỗi sự kiện. Việc ghi đè cấu hình kéo dài cho đến khi bàn phím đóng lại hoặc bạn xóa chúng."
          }
        }
      }
    },
