            "state": "translated",
            "value": "Begynn å skrive med Clink og statistikken din vises her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita kirjoittaminen Clink:llä, niin tilastosi näkyvät täällä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulailah mengetik dengan Clink dan statistik Anda akan muncul di sini."
          }
        },
        "vi": {
