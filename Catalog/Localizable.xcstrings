            "value": "いつも隣のキーを押してしまいます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자꾸 옆에 있는 키가 눌립니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya asyik tertekan kekunci sebelah"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerto sempre na tecla ao lado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я всё время попадаю по соседней клавише"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "老是按到旁边那个键"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot apăs pe tasta de lângă cea pe care o vreau"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik druk steeds op de sleutel naast degene die ik wil"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "老是按到旁邊那個鍵"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciągle naciskam klawisz obok tego, który chcę"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я постійно натискаю клавішу поруч із тією, яку хочу"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğim tuşun yanındaki tuşa basmaya devam ediyorum"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stále mačkám klíč vedle toho, co chci"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stále stláčam kľúč vedľa toho, čo chcem"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνεχίζω να χτυπάω το κλειδί δίπλα σε αυτό που θέλω"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag fortsätter att trycka på knappen bredvid den jag vill ha"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I keep hitting the key next to the one I want"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg fortsetter å trykke på tasten ved siden av den jeg vil ha"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Painan jatkuvasti avainta haluamani vieressä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya terus menekan tombol di sebelah yang saya inginkan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi tiếp tục nhấn phím bên cạnh cái tôi muốn"
          }
        }
      }
    },
    "I only want the dictation and the tools. Can I hide the rest?": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ek wil net die diktee en die gereedskap hê. Kan ek die res wegsteek?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich will nur das Diktat und die Werkzeuge. Kann ich den Rest ausblenden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quiero el dictado y las herramientas. ¿Puedo ocultar lo demás?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma tahan ainult dikteerimist ja tööriistu. Kas ma saan ülejäänu peita?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je veux seulement la dictée et les outils. Puis-je masquer le reste ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a diktálás és az eszközök kellenek. El tudom rejteni a többit?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Voglio solo la dettatura e gli strumenti. Posso nascondere il resto?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力とツールだけ使いたいのですが、ほかは隠せますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기와 도구만 쓰고 싶어요. 나머지는 숨길 수 있나요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya mahu imlak dan alat sahaja. Boleh sembunyikan yang lain?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só quero o ditado e as ferramentas. Posso esconder o resto?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мне нужны только диктовка и инструменты. Можно спрятать остальное?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我只想要口述输入和工具，其他能藏起来吗？"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vreau doar dictatul și instrumentele. Pot ascunde restul?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik wil alleen het dictaat en de hulpmiddelen. Kan ik de rest verbergen?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我只想要口述輸入和工具，其他能藏起來嗎？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcę tylko dyktando i narzędzia. Czy mogę ukryć resztę?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мені потрібні лише диктант та інструменти. Чи можу я сховати решту?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece dikteyi ve araçları istiyorum. Gerisini gizleyebilir miyim?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chci jen diktát a nástroje. Můžu zbytek schovat?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcem len diktát a nástroje. Môžem skryť zvyšok?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλω μόνο την υπαγόρευση και τα εργαλεία. Μπορώ να κρύψω τα υπόλοιπα;"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag vill bara ha diktatet och verktygen. Kan jag dölja resten?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I only want the dictation and the tools. Kan jeg skjule resten?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg vil bare ha diktatet og verktøyene. Kan jeg skjule resten?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluan vain sanelun ja työkalut. Voinko piilottaa loput?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya hanya ingin dikte dan alatnya. Bisakah saya menyembunyikan sisanya?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi chỉ muốn chính tả và các công cụ. Tôi có thể giấu phần còn lại không?"
          }
        }
      }
    },
