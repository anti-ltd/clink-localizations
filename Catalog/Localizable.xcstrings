        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 입력하면 됩니다. 두 언어를 동시에 검사합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mula menaip. Kedua-duanya disemak serentak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa a escrever. Os dois são verificados ao mesmo tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начинайте печатать. Орфография проверяется сразу в обоих."
