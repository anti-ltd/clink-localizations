        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스를 두 번 눌렀을 때 입력되는 기호입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda yang ditulis oleh pintasan ruang dua kali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O sinal que o atalho do espaço duplo escreve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знак, который ставит двойной пробел."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连按两次空格时输入的符号。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märk, mille topelttühiku otsetee sisestab."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die merk wat die dubbelspasie-kortpad skryf."
          }
        }
      }
    },
    "The model is still getting ready. Try again in a bit.": {
