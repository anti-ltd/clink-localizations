          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista da a cada nota una fila de ancho completo con las primeras líneas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste donne à chaque note une ligne pleine largeur avec les premières lignes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista minden jegyzetnek teljes szélességű sort ad az első pár sorral."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco dà a ogni nota una riga a tutta larghezza con le prime righe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストは各メモを全幅の行に並べ、冒頭の数行を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록은 메모마다 전체 너비 행을 주고 앞부분 몇 줄을 보여줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai memberi setiap nota satu baris selebar skrin dengan beberapa baris pertama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista dá a cada nota uma linha de largura total com as primeiras linhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Список» отводит каждой заметке строку во всю ширину с первыми парой строк текста."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表让每条备忘占满一行，显示开头几行。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loend annab igale märkmele täislaiuses rea esimeste ridadega."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lys gee elke noot 'n volwydte ry met die eerste paar reëls."
          }
        }
      }
    },
