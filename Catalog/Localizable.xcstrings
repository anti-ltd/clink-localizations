        }
      }
    },
    "Tap or drag to select keys. Tap again to deselect.": {
      "comment": "Canvas keyboard selection control.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap or drag to select keys. Tap again to deselect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca o arrastra para seleccionar teclas. Toca de nuevo para deseleccionarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche les touches ou fais glisser ton doigt pour les sélectionner. Touche-les à nouveau pour les désélectionner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Tasten oder streiche darüber, um sie auszuwählen. Tippe erneut, um die Auswahl aufzuheben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca o trascina per selezionare i tasti. Tocca di nuovo per deselezionarli."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ou arrasta para selecionar teclas. Toca novamente para anular a seleção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Касайтесь клавиш или проводите по ним, чтобы выбрать. Коснитесь ещё раз, чтобы снять выделение."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik atau seret untuk memilih kekunci. Ketik sekali lagi untuk membatalkan pilihan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a billentyűkre, vagy húzd végig rajtuk az ujjad a kijelöléshez. A kijelölés törléséhez koppints újra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップまたはドラッグしてキーを選択します。もう一度タップすると選択を解除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点或拖动以选择按键，再次轻点可取消选择。"
