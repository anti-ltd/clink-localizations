            "value": "Voeg 'n toegewyde 🙂-sleutel langs die 123-sleutel by. Dit verwyder emoji uit die paneelkieser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg eine eigene 🙂-Taste neben die 123-Taste. Damit verschwinden die Emojis aus der Panel-Auswahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una tecla 🙂 propia junto a la tecla 123. Así quitas los emoji del selector del panel."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa eraldi klahv 🙂 123-klahvi kõrvale. See eemaldab emoji paneelivalijast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une touche 🙂 dédiée à côté de la touche 123. Ça retire les emoji du sélecteur du panneau."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegyél egy külön 🙂 billentyűt a 123-as billentyű mellé. Ezzel eltűnik az emoji a panelválasztóból."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un tasto 🙂 accanto al tasto 123. Così le emoji spariscono dal selettore del pannello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "123キーの横に専用の🙂キーを追加します。これで、パネルの絵文字ピッカーから絵文字がなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "123 키 옆에 🙂 키를 따로 넣어요. 그러면 패널 선택기에서 이모지는 빠져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah kekunci 🙂 khas di sebelah kekunci 123. Ini keluarkan emoji daripada pemilih panel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona uma tecla 🙂 dedicada ao lado da tecla 123. Assim os emoji saem do seletor do painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить отдельную клавишу 🙂 рядом с клавишей 123. Эмодзи при этом уйдут из выбора панелей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 123 键旁边加个专门的 🙂 键。这样面板选择器里就没有表情了。"
          }
        }
      }
    },
