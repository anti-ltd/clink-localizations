    "Optional. iOS only allows haptics and pasteboard reads when Full Access is on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. iOS erlaubt Haptik und Zugriff auf die Zwischenablage nur mit Vollzugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. iOS solo permite vibración y leer el portapapeles con el acceso completo activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. iOS n'autorise les vibrations et la lecture du presse-papiers qu'avec l'accès complet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem kötelező. Az iOS csak teljes hozzáféréssel enged rezgést és vágólap-olvasást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. iOS permette vibrazioni e lettura degli appunti solo con l'accesso completo attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使うかどうかは自由です。iOS では、フルアクセスがオンのときだけ触覚とペーストボードの読み取りができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택이에요. iOS는 전체 접근을 켰을 때만 햅틱과 클립보드 읽기를 허용해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan. iOS cuma benarkan haptik dan bacaan papan keratan apabila Akses Penuh dihidupkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. O iOS só permite háptica e leitura da área de transferência com o acesso total ligado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не обязательно. iOS разрешает тактильную отдачу и чтение буфера обмена только при включённом полном доступе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。iOS 只有在开了完全访问时才允许触觉反馈和读取剪贴板。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valikuline. iOS lubab haptikat ja lõikelaua lugemist ainult siis, kui täisjuurdepääs on sees."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opsioneel. iOS laat slegs haptiese en plakbordlees toe wanneer Volle Toegang aan is."
          }
        }
      }
    },
    "Options": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
