    "Beside the space bar on every layout, presets included.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neben der Leertaste in jedem Layout, auch in den integrierten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Junto a la barra espaciadora en todas las distribuciones, incluidas las predefinidas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tühikuklahvi kõrval igas paigutuses, ka eelseadistatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À côté de la barre d’espace sur toutes les dispositions, y compris les intégrées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szóköz mellett minden kiosztáson, a beépítetteken is."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accanto alla barra spaziatrice in ogni layout, inclusi quelli predefiniti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての配列でスペースバーの横に表示します（内蔵配列も含む）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 배열에서 스페이스 바 옆에 표시됩니다(기본 배열 포함)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Di sebelah bar ruang pada setiap susun atur, termasuk pratetap."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao lado da barra de espaço em todos os layouts, incluindo os predefinidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядом с пробелом во всех раскладках, включая встроенные."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每个布局的空格键旁显示，包括内置布局。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe lângă bara de spațiu pe fiecare aspect, presetări incluse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naast de spatiebalk op elke lay-out zijn er voorinstellingen inbegrepen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每個佈局的空格鍵旁顯示，包括內建佈局。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Langs die spasiebalk op elke uitleg, voorafinstellings ingesluit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprócz spacji w każdym układzie, dostępne są gotowe ustawienia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поряд з пробілом на кожному макеті, включно зі стандартними налаштуваннями."
          }
        },
        "tr": {
          "stringUnit": {
