    "“%@” is a built-in layout. This creates an editable custom copy and adds %@.": {
      "comment": "Layout page, Customize part: alert message before adding a quick preset to a built-in layout. First %@ is the layout's name, second the preset's description in lowercase. Translations drafted for the Android port (batch B7); native-speaker review required before release. Add to clink-index.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is ’n ingeboude uitleg. Dit skep ’n wysigbare eie kopie en voeg %2$@ by."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ je vestavěné rozložení. Vytvoří se upravitelná vlastní kopie a přidá se %2$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” er et indbygget layout. Der oprettes en redigerbar kopi, og %2$@ tilføjes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist ein integriertes Layout. So entsteht eine bearbeitbare eigene Kopie mit %@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%1$@» είναι ενσωματωμένη διάταξη. Δημιουργείται ένα επεξεργάσιμο προσαρμοσμένο αντίγραφο και προστίθεται %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” es una distribución integrada. Se creará una copia personalizada editable y se añadirá: %@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” on sisseehitatud paigutus. Luuakse muudetav koopia ja lisatakse: %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” on sisäänrakennettu asettelu. Tästä luodaan muokattava oma kopio, johon lisätään %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est une disposition intégrée. Une copie modifiable sera créée, avec : %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” beépített kiosztás. Szerkeszthető saját másolat készül, ezzel: %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” adalah tata letak bawaan. Ini membuat salinan kustom yang dapat diedit dan menambahkan %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” è un layout integrato. Verrà creata una copia personalizzata modificabile con: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は内蔵レイアウトです。編集できるカスタムコピーを作成し、次を追加します：%@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) 기본 레이아웃입니다. 편집 가능한 사본을 만들고 다음을 추가합니다: %@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ialah susun atur terbina dalam. Salinan tersuai yang boleh diedit akan dibuat dan ditambah: %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» er et innebygd oppsett. Dette lager en redigerbar egen kopi og legger til %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’ is een ingebouwde indeling. Er wordt een bewerkbare eigen kopie gemaakt waaraan %2$@ wordt toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” to wbudowany układ. Zostanie utworzona edytowalna kopia własna z dodanym elementem: %2$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” é um esquema incorporado. Será criada uma cópia personalizada editável com: %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” este un aspect integrat. Se creează o copie personalizată editabilă și se adaugă %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — встроенная раскладка. Будет создана редактируемая копия, и в неё добавится: %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ je vstavané rozloženie. Vytvorí sa upraviteľná vlastná kópia a pridá sa %2$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” är en inbyggd layout. En redigerbar egen kopia skapas och %2$@ läggs till."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” yerleşik bir düzen. Düzenlenebilir özel bir kopya oluşturulur ve %2$@ eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» — вбудована розкладка. Буде створено редаговану власну копію з доданим елементом: %2$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” là bố cục có sẵn. Thao tác này tạo một bản sao tùy chỉnh có thể chỉnh sửa và thêm %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是内置布局。将创建可编辑的自定义副本并添加：%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」是內建鍵盤配置。這會建立一份可編輯的自訂副本，並加入%2$@。"
          }
        }
      }
    },
