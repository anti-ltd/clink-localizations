      }
    },
    "A spacer is invisible. It reserves width to push keys apart but draws nothing and ignores taps. Only its width matters.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Spasieerder is onsigbaar. Dit behou breedte om sleutels uitmekaar te druk, maar trek niks en ignoreer krane. Net sy breedte maak saak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Abstandshalter ist unsichtbar. Er reserviert Breite, um Tasten auseinanderzuschieben, zeichnet aber nichts und ignoriert Tipps. Nur seine Breite zählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espaciador es invisible: reserva ancho para separar las teclas, pero no dibuja nada ni responde a los toques. Solo importa su ancho."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eraldaja on nähtamatu. See reserveerib laiust, et klahve lahutada, aga ei joonista midagi ja eirab puudutusi. Loeb ainult selle laius."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espaceur est invisible : il réserve de la largeur pour écarter les touches mais ne dessine rien et ignore les appuis. Seule sa largeur compte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A távtartó láthatatlan. Helyet foglal, hogy széthúzza a billentyűket, de nem látszik és nem reagál az érintésre. Csak a szélessége számít."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno spaziatore è invisibile, tiene lo spazio per allontanare i tasti ma non mostra nulla e ignora i tocchi. Conta solo la sua larghezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペーサーは見えません。幅だけ確保してキーを離しますが、何も表示せずタップも反応しません。大事なのは幅だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이서는 눈에 안 보여요. 자리만 차지해서 키를 밀어낼 뿐, 그려지지도 않고 탭도 안 먹어요. 너비만 중요해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengisi ruang tak kelihatan. Ia simpan lebar untuk jarakkan kekunci tapi tak lukis apa-apa dan abaikan ketukan. Cuma lebarnya yang penting."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um espaçador é invisível. Reserva largura para afastar as teclas, mas não desenha nada e ignora toques. Só a largura conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделитель невидим. Он занимает ширину, чтобы раздвинуть клавиши, но ничего не рисует и не реагирует на нажатия. Важна только его ширина."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "占位符是看不见的，它只占出宽度把按键撑开，什么都不画，也不理会点击。只有它的宽度有用。"
          }
        }
      }
    },
    "A strip of digits above the letters.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Strook syfers bokant die letters."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ziffernleiste über den Buchstaben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fila de dígitos sobre las letras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Numbirida tähtede kohal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une rangée de chiffres au-dessus des lettres."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy számsor a betűk fölött."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una striscia di cifre sopra le lettere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字の上に数字の列を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자 위에 숫자 줄을 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu jalur digit di atas huruf."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma faixa de dígitos acima das letras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полоса цифр над буквами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在字母上方显示一排数字。"
          }
        }
      }
    },
    "A subtle tap on each keypress.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Subtiele tik op elke sleuteldruk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein leichter Tap bei jedem Tastendruck."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vibración suave en cada pulsación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerge kopinus iga klahvivajutusega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une légère vibration à chaque appui."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy finom koppintás minden gombnyomásnál."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una leggera vibrazione a ogni tasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを押すたびに、そっと軽く振動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누를 때마다 은은하게 톡."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketikan halus setiap kali anda tekan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vibração subtil a cada toque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лёгкий отклик на каждое нажатие."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次按键都轻轻震一下。"
          }
        }
      }
    },
    "A tab of the emoji you actually use. Drag it anywhere on Categories.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Oortjie van die emoji wat jy eintlik gebruik. Sleep dit enige plek op Kategorieë."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tab mit den Emoji, die du wirklich nutzt. Verschieb ihn unter „Kategorien“ wohin du willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pestaña con los emojis que de verdad usas. Muévela donde quieras en Categorías."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaart teiste emojidega, mida sa tegelikult kasutad. Lohista see kuhu iganes kaardile „Kategooriad\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un onglet avec les emoji que tu utilises vraiment. Place-le où tu veux dans Catégories."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy fül a tényleg használt emodzsikkal. A Kategóriák fülön bárhová húzhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scheda con gli emoji che usi davvero. Spostala dove vuoi in Categorie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う絵文字だけのタブです。「カテゴリ」で好きな位置に動かせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 쓰는 이모지만 모은 탭이에요. 카테고리에서 원하는 자리로 옮길 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab berisi emoji yang anda betul-betul guna. Seret ke mana-mana dalam Kategori."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um separador com os emojis que usas mesmo. Move-o para onde quiseres em Categorias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка с эмодзи, которыми вы действительно пользуетесь. Перетащите её в любое место в «Категориях»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个只放你常用表情的标签页。在“分类”里可以随意挪位置。"
          }
        }
      }
    },
