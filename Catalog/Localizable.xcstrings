    "Give the language letters of its own. Draw them with a finger, take them from a font you import, or type characters that already exist.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale al idioma letras propias. Dibújalas con el dedo, tómalas de una fuente que importes o escribe caracteres que ya existen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez à la langue ses propres lettres. Dessinez-les du doigt, reprenez-les d’une police importée ou saisissez des caractères qui existent déjà."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib der Sprache eigene Buchstaben. Zeichne sie mit dem Finger, übernimm sie aus einer importierten Schrift oder tippe Zeichen ein, die es schon gibt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai alla lingua lettere tutte sue. Disegnale con il dito, prendile da un font che importi o digita caratteri che esistono già."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê ao idioma letras próprias. Desenhe-as com o dedo, use as de uma fonte importada ou digite caracteres que já existem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте языку собственные буквы. Нарисуйте их пальцем, возьмите из импортированного шрифта или введите уже существующие символы."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berikan bahasa ini huruf tersendiri. Lukis dengan jari, ambil daripada fon yang anda import atau taip aksara yang sedia ada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj a nyelvnek saját betűket. Rajzold meg őket az ujjaddal, vedd át egy importált betűtípusból, vagy írj be már létező karaktereket."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語に独自の文字を。指で描く、読み込んだフォントから取り込む、または既存の文字を入力できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为这门语言创造专属字母。可以用手指绘制、从导入的字体中选取，或输入已有的字符。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 언어만의 글자를 만들어 보세요. 손가락으로 그리거나, 가져온 서체에서 고르거나, 이미 있는 문자를 입력할 수 있습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna keelele oma tähed. Joonista need sõrmega, võta imporditud fondist või sisesta juba olemasolevad märgid."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oferă litere proprii limbii. Desenați-le cu un deget, luați-le dintr-un font pe care îl importați sau introduceți caractere care există deja."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef de taal zijn eigen letters. Teken ze met een vinger, haal ze uit een lettertype dat u importeert of typ tekens die al bestaan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為這門語言創造專屬字母。可以用手指繪製、從匯入的字型中選取，或輸入已有的字元。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gee die taal sy eie letters. Teken dit met 'n vinger, neem dit uit 'n lettertipe wat jy invoer, of tik karakters wat reeds bestaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj własne litery języka. Narysuj je palcem, pobierz je z importowanej czcionki lub wpisz znaki, które już istnieją."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надайте власні літери мови. Намалюйте їх пальцем, візьміть із імпортованого шрифту або введіть уже існуючі символи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilin kendine ait harflerini verin. Bunları parmağınızla çizin, içe aktardığınız bir yazı tipinden alın veya zaten var olan karakterleri yazın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejte jazykovým písmenům vlastní. Nakreslete je prstem, převezměte je z importovaného písma nebo zadejte znaky, které již existují."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dajte jazykom vlastné písmená. Nakreslite ich prstom, zoberte ich z importovaného písma alebo zadajte znaky, ktoré už existujú."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δώστε τα δικά του γράμματα της γλώσσας. Σχεδιάστε τα με ένα δάχτυλο, πάρτε τα από μια γραμματοσειρά που εισάγετε ή πληκτρολογήστε χαρακτήρες που υπάρχουν ήδη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge språket egna bokstäver. Rita dem med ett finger, ta dem från ett teckensnitt du importerar eller skriv tecken som redan finns."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv sproget sine egne bogstaver. Tegn dem med en finger, tag dem fra en skrifttype, du importerer, eller skriv tegn, der allerede findes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi språket egne bokstaver. Tegn dem med en finger, ta dem fra en skrift du importerer, eller skriv inn tegn som allerede finnes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna kielelle omat kirjaimet. Piirrä ne sormella, ota ne tuomastasi kirjasimesta tai kirjoita jo olemassa olevia merkkejä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berikan huruf bahasa tersendiri. Gambarlah dengan jari, ambil dari font yang Anda impor, atau ketik karakter yang sudah ada."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cung cấp các chữ cái ngôn ngữ của riêng mình. Vẽ chúng bằng ngón tay, lấy chúng từ phông chữ bạn nhập hoặc nhập các ký tự đã tồn tại."
          }
        }
      }
    },
