    "Sure, I'll have it over by then.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar, bis dahin ist es bei dir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claro, para entonces lo tienes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien sûr, tu l'auras d'ici là."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Persze, addigra átküldöm."
