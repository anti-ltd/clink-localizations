    "Learning happens entirely on this device. Nothing you type is uploaded, and clearing wipes the learned words immediately.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leer vind geheel en al op hierdie toestel plaas. Niks wat jy tik word opgelaai nie, en uitvee vee die aangeleerde woorde onmiddellik uit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lernen passiert komplett auf diesem Gerät. Nichts, was du tippst, wird hochgeladen, und beim Löschen sind die gelernten Wörter sofort weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aprendizaje ocurre entero en este dispositivo. Nada de lo que escribes se sube, y al borrar se van las palabras aprendidas al momento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Õppimine toimub täielikult selles seadmes. Midagi, mida tipid, ei laadita üles ja tühjendamine kustutab õpitud sõnad koheselt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apprentissage se fait entièrement sur cet appareil. Rien de ce que tu tapes n'est envoyé, et l'effacement supprime les mots appris tout de suite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tanulás teljes egészében ezen az eszközön történik. Semmi nem kerül fel a netre abból, amit írsz, és ha törlöd, a megtanult szavak azonnal eltűnnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apprendimento avviene tutto su questo dispositivo. Nulla di ciò che scrivi viene caricato, e cancellando elimini subito le parole imparate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習はすべてこのデバイスの中だけで行われます。入力した内容はアップロードされませんし、消去すると学習した単語はすぐに消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학습은 전부 이 기기에서만 이뤄져요. 입력한 내용은 어디에도 올라가지 않고, 지우면 배운 단어도 바로 사라져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelajaran berlaku sepenuhnya pada peranti ini. Apa yang anda taip tak dimuat naik, dan mengosongkannya padam perkataan yang dipelajari serta-merta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aprendizagem acontece toda neste dispositivo. Nada do que escreves é enviado, e ao limpar apagas logo as palavras aprendidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обучение целиком проходит на этом устройстве. Ничего из напечатанного не загружается, а очистка стирает выученные слова сразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学习全在这台设备上进行。你打的东西一点都不会上传，清除会立刻抹掉学过的词。"
          }
        }
      }
    },
    "Learning is optional. Words you teach Clink stay in the App Group.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leer is opsioneel. Woorde wat jy vir Clink leer bly in die App Group."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lernen ist optional. Wörter, die du Clink beibringst, bleiben in der App Group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aprendizaje es opcional. Las palabras que le enseñas a Clink se quedan en el App Group."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Õppimine on valikuline. Sõnad, mida sa Clinkile õpetad, jäävad App Groupi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apprentissage est facultatif. Les mots que tu apprends à Clink restent dans l'App Group."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tanulás nem kötelező. Amit megtanítasz a Clinknek, az az App Groupban marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imparare è facoltativo. Le parole che insegni a Clink restano nell'App Group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習を使うかどうかは自由です。Clink に教えた単語は App Group の中に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학습은 선택이에요. Clink에 알려준 단어는 App Group 안에만 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelajaran ini pilihan. Perkataan yang anda ajar Clink kekal dalam App Group."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprender é opcional. As palavras que ensinas ao Clink ficam no App Group."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обучение необязательно. Слова, которым вы научили Clink, остаются в App Group."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学词是可选的。你教给 Clink 的词只留在 App Group 里。"
          }
        }
      }
    },
