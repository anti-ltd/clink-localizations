        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narzędzia te znajdują się w klawiaturze. Dodaj je w Ustawieniach, aby móc z nich korzystać podczas pisania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці інструменти знаходяться на клавіатурі. Додайте його в налаштуваннях, щоб використовувати їх під час введення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu araçlar klavyede bulunur. Yazarken bunları kullanmak için bunu Ayarlar'a ekleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto nástroje žijí v klávesnici. Přidejte si jej do Nastavení, abyste je mohli používat při psaní."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto nástroje žijú v klávesnici. Pridajte si ho do Nastavenia, aby ste ich mohli používať pri písaní."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτά τα εργαλεία ζουν στο πληκτρολόγιο. Προσθέστε το στις Ρυθμίσεις για να τις χρησιμοποιήσετε ενώ πληκτρολογείτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessa verktyg finns i tangentbordet. Lägg till det i Inställningar för att använda dem medan du skriver."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse værktøjer bor i tastaturet. Tilføj det i Indstillinger for at bruge dem, mens du skriver."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse verktøyene bor i tastaturet. Legg den til i Innstillinger for å bruke dem mens du skriver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä työkalut sijaitsevat näppäimistössä. Lisää se asetuksiin, jotta voit käyttää niitä kirjoittaessasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat-alat ini ada di keyboard. Tambahkan di Pengaturan untuk menggunakannya saat Anda mengetik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những công cụ này sống trong bàn phím. Thêm nó vào Cài đặt để sử dụng chúng khi bạn nhập."
          }
        }
      }
    },
