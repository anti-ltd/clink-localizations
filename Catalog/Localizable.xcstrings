            "value": "Kapcsold be a Clinket a Clingben, a Beállítások ▸ Csatlakoztatott appok alatt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Clink in Cling, in Impostazioni ▸ App connesse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling の設定 ▸ 連携アプリ で Clink をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling의 설정 ▸ 연결된 앱에서 Clink를 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Clink dalam Cling di Tetapan ▸ Apl bersambung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Clink no Cling em Definições ▸ Apps ligadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Clink в Cling, в разделе «Настройки» ▸ «Подключённые приложения»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Cling 的「设置 ▸ 已连接的 App」中打开 Clink。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita Clink sisse Clingis jaotises Seaded ▸ Ühendatud rakendused."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel Clink aan in Cling onder Instellings ▸ Gekoppelde toepassings."
          }
        }
      }
    },
    "Turn Key popups off, or leave them on and set how they spring.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte die Tasten-Popups aus — oder lass sie an und stell ein, wie stark sie federn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva las ventanas emergentes de tecla, o déjalas y ajusta cómo rebotan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive les bulles de touche, ou garde-les et règle leur rebond."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold ki a Kulcs felugró ablakokat, vagy hagyd bekapcsolva, és állítsd be, hogyan rugóznak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva i Popup dei tasti, oppure lasciali attivi e regola il loro rimbalzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キーのポップアップ」をオフにするか、オンのままで弾み方を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 팝업을 끄거나, 켜 둔 채 튀어오르는 정도를 조절하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan Pop timbul kekunci, atau biarkan hidup dan laraskan lantunannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga os Balões de tecla, ou deixa-os ligados e ajusta o salto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите всплывающие клавиши — или оставьте их и настройте, как они пружинят."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关掉“按键弹出框”，或者留着它，调一下弹跳的感觉。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita Klahvide hüpikud välja või jäta nad sisse ja määra nende vedrustus."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel sleutelopspringers af, of laat hulle aan en stel in hoe hulle spring."
          }
        }
      }
    },
    "Turn Key press haptics on and set the strength.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte die Haptik beim Tastendruck ein und stell die Stärke ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la Vibración al pulsar tecla y ajusta la intensidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active le Retour haptique à la frappe et règle l'intensité."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a Billentyűnyomás haptikát, és állítsd be az erősségét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva il Feedback aptico alla pressione e regola l'intensità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キー押下時の触覚フィードバック」をオンにして、強さを調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 입력 햅틱을 켜고 세기를 조절하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Haptik tekanan kekunci dan tetapkan kekuatannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga a Vibração ao premir tecla e ajusta a intensidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите тактильную отдачу при нажатии и задайте силу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“按键触感反馈”，调好强度。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita sisse Klahvivajutuse haptika ja määra tugevus."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel sleuteldruk-haptics aan en stel die sterkte in."
          }
        }
      }
    },
    "Turn Key sounds on and choose a sound pack.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte die Tastentöne ein und wähle ein Klangpaket."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa los Sonidos de tecla y elige un paquete de sonidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active les Sons de touche et choisis un pack de sons."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a Kulcshangokat, és válassz hangcsomagot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva i Suoni dei tasti e scegli un pacchetto suoni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
