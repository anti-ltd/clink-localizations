    "Written on your phone from the answers below. It can get things wrong, so the pages it used are the ones to trust.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geskryf op jou foon vanaf die antwoorde hieronder. Dit kan dinge verkeerd maak, so die bladsye wat dit gebruik het, is diegene om te vertrou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem Gerät aus den Antworten unten geschrieben. Es kann danebenliegen, verlässlich sind die Seiten, aus denen es stammt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrito en tu teléfono a partir de las respuestas de abajo. Puede equivocarse, así que lo fiable son las páginas que ha usado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjutatud sinu telefonis alltoodud vastustest. Ta võib eksida, seega usaldusväärsed on lehed, millest ta pärineb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit sur ton téléphone à partir des réponses ci-dessous. Il peut se tromper, ce sont les pages utilisées qui font foi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telefonodon készült az alábbi válaszokból. Tévedhet is, ezért a felhasznált oldalak a mérvadóak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scritto sul tuo telefono a partire dalle risposte qui sotto. Può sbagliare, quindi a fare fede sono le pagine che ha usato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下に挙げた回答をもとに、端末内で書かれた文章です。間違えることもあるので、確かなのは参照元のページのほうです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 답변들을 바탕으로 기기 안에서 작성된 글입니다. 틀릴 수도 있으니 믿을 것은 참고한 페이지 쪽입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditulis dalam telefon anda daripada jawapan di bawah. Ia boleh tersilap, jadi halaman yang digunakannya itulah yang boleh dipercayai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrito no teu telemóvel a partir das respostas abaixo. Pode enganar-se, por isso as páginas que usou é que são de confiança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Составлено на вашем телефоне по ответам ниже. Здесь бывают ошибки, поэтому доверять стоит страницам, на которые оно опиралось."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段话是依据下面这些答案、在你手机上生成的。它可能出错，真正可靠的是它引用的那几页。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scris pe telefon din răspunsurile de mai jos. Poate greși lucrurile, așa că paginile pe care le-a folosit sunt cele de încredere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschreven op je telefoon met de onderstaande antwoorden. Het kan dingen verkeerd doen, dus de pagina's die het gebruikt zijn degenen die u kunt vertrouwen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這段話是依據下面這些答案、在你手機上生成的。它可能出錯，真正可靠的是它引用的那幾頁。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisano na Twoim telefonie na podstawie odpowiedzi poniżej. Może popełnić błąd, dlatego należy ufać stronom, z których korzysta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Написано на вашому телефоні з наведених нижче відповідей. Він може помилятися, тому сторінкам, які він використовує, варто довіряти."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki cevaplardan telefonunuzda yazılmıştır. İşleri yanlış anlayabilir, bu nedenle kullandığı sayfalar güvenilecek sayfalardır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsáno na vašem telefonu z odpovědí níže. Může se to pokazit, takže stránky, které použil, jsou ty, kterým lze věřit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napísané na telefóne z odpovedí nižšie. Môže sa to pokaziť, takže stránky, ktoré použil, sú tie, ktorým dôverujete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γράφτηκε στο τηλέφωνό σας από τις παρακάτω απαντήσεις. Μπορεί να κάνει τα πράγματα στραβά, επομένως οι σελίδες που χρησιμοποίησε είναι αυτές που πρέπει να εμπιστευτούν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivet på din telefon från svaren nedan. Det kan göra saker fel, så sidorna som den använde är de att lita på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrevet på din telefon fra nedenstående svar. Det kan gå galt, så de sider, det brugte, er dem, man kan stole på."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrevet på telefonen din fra svarene nedenfor. Det kan gå galt, så sidene den brukte er de du kan stole på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoitettu puhelimeesi alla olevista vastauksista. Se voi mennä pieleen, joten sen käyttämiin sivuihin kannattaa luottaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditulis di ponsel Anda dari jawaban di bawah. Hal ini bisa saja menimbulkan kesalahan, sehingga halaman yang digunakan adalah halaman yang dapat dipercaya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được viết trên điện thoại của bạn từ các câu trả lời dưới đây. Nó có thể gây ra lỗi nên những trang nó sử dụng là những trang đáng tin cậy."
          }
        }
      }
    },
