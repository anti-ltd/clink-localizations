    "After flipping back, insert a space so you can keep typing.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadat jy teruggeblaai het, voeg 'n spasie in sodat jy kan aanhou tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Zurückwechseln ein Leerzeichen setzen, damit du weitertippen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al volver, mete un espacio para que sigas escribiendo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pärast tagasilülitamist lisa tühik, et saaksid jätkata tipimist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après être revenu, insère une espace pour que tu puisses continuer à taper."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Miután visszalapoztál, szúrj be egy szóközt, hogy gépelhess tovább."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando torni indietro, inserisce uno spazio così continui a scrivere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻ったあとにスペースを入れて、そのまま入力を続けられるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 돌아온 뒤에 공백을 넣어서 계속 입력할 수 있게 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas berbalik, sisipkan ruang supaya anda boleh terus menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de voltares, insere um espaço para continuares a escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После возврата вставлять пробел, чтобы можно было печатать дальше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切回去以后插个空格，你就能接着打。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După ce răsturnați înapoi, introduceți un spațiu pentru a putea continua să tastați."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadat u teruggebladerd hebt, voegt u een spatie in, zodat u kunt blijven typen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切回去以後插個空格，你就能接著打。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po przewróceniu strony wstaw spację, aby móc pisać dalej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернувшись назад, вставте пробіл, щоб продовжувати вводити текст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geriye doğru çevirdikten sonra yazmaya devam edebilmek için bir boşluk ekleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po otočení zpět vložte mezeru, abyste mohli pokračovat v psaní."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po otočení späť vložte medzeru, aby ste mohli pokračovať v písaní."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφού γυρίσετε πίσω, εισαγάγετε ένα κενό για να συνεχίσετε να πληκτρολογείτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du har vänt tillbaka, infoga ett mellanslag så att du kan fortsätta skriva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du har vendt tilbage, skal du indsætte et mellemrum, så du kan fortsætte med at skrive."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du har snudd tilbake, setter du inn et mellomrom slik at du kan fortsette å skrive."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun käännät taaksepäin, lisää välilyönti, jotta voit jatkaa kirjoittamista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah membalik kembali, masukkan spasi agar Anda dapat terus mengetik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi lật lại, hãy chèn một khoảng trắng để bạn có thể tiếp tục gõ."
          }
        }
      }
    },
    "After typing punctuation on the symbols page, flip back to letters.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadat jy leestekens op die simbole-bladsy getik het, blaai terug na letters."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einem Satzzeichen auf der Symbolseite zurück zu den Buchstaben wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de escribir un signo en la página de símbolos, vuelve a las letras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pärast kirjavahemärgi tipimist sümbolilehel lülita tagasi tähtedele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir tapé une ponctuation sur la page des symboles, revient aux lettres."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Miután beírtad az írásjelet a szimbólumoldalon, lapozz vissza a betűkre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver messo un segno di punteggiatura nella pagina dei simboli, torna alle lettere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記号ページで句読点を入力したら、文字に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기호 페이지에서 문장 부호를 입력한 뒤 글자로 다시 돌아가요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas menaip tanda baca pada halaman simbol, berbalik ke huruf."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de escreveres pontuação na página de símbolos, volta às letras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После знака препинания на странице символов возвращаться к буквам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在符号页打完标点后，自动切回字母。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După ce ați introdus semnele de punctuație pe pagina cu simboluri, întoarceți înapoi la litere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadat u leestekens op de symbolenpagina hebt getypt, gaat u terug naar letters."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在符號頁打完標點後，自動切回字母。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po wpisaniu znaków interpunkcyjnych na stronie symboli wróć do liter."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після введення розділових знаків на сторінці символів поверніться до літер."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Semboller sayfasında noktalama işaretlerini yazdıktan sonra harflere geri dönün."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zadání interpunkce na stránce se symboly přejděte zpět na písmena."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po napísaní interpunkcie na stránke so symbolmi sa vráťte späť na písmená."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφού πληκτρολογήσετε σημεία στίξης στη σελίδα συμβόλων, γυρίστε πίσω στα γράμματα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter att ha skrivit skiljetecken på symbolsidan, vänd tillbaka till bokstäverna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du har indtastet tegnsætning på symbolsiden, skal du vende tilbage til bogstaver."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter å ha skrevet inn tegnsetting på symbolsiden, bla tilbake til bokstaver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun olet kirjoittanut välimerkit symbolisivulle, siirry takaisin kirjaimiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah mengetikkan tanda baca pada halaman simbol, balik ke huruf."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi gõ dấu câu trên trang ký hiệu, hãy quay lại các chữ cái."
          }
        }
      }
    },
