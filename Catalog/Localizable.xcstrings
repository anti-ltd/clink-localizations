    "Space between the suggestion bar and the top row of keys.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abstand zwischen der Vorschlagsleiste und der oberen Tastenreihe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacio entre la barra de sugerencias y la fila de arriba de las teclas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace entre la barre de suggestions et la première rangée de touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Térköz a javaslatsáv és a felső gombsor között."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio tra la barra dei suggerimenti e la fila di tasti in alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補バーとキーの一番上の段のあいだの間隔です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천 바와 맨 윗줄 키 사이 간격이에요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang antara bar cadangan dan baris atas kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço entre a barra de sugestões e a fila de teclas de cima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расстояние между строкой подсказок и верхним рядом клавиш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "候选栏和最上排按键之间的间距。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahe soovituseriba ja ülemise klahvireas."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spasie tussen die voorstelbalk en die boonste ry sleutels."
          }
        }
