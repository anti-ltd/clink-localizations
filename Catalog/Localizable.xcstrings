        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 열고 한 손 모드를 켠 다음, 어느 쪽으로 모을지 고르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Kekunci, hidupkan Mod satu tangan, dan pilih sebelah mana."
