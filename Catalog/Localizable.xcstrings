          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji-urile rămân în categoriile lor normale. Doar setul merge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De emoji blijven in hun normale categorieën. Enkel de set gaat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "表情還在原來的分類裡，消失的只是這個合集。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
