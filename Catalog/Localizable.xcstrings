    "Start from any layout above, then move keys and add rows on the Keys tab.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fang mit einem Layout von oben an und verschieb dann Tasten oder füg im Tab „Tasten“ Reihen hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza por cualquier disposición de arriba y luego mueve teclas y añade filas en la pestaña Teclas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pars d’une disposition ci-dessus, puis déplace des touches et ajoute des rangées dans l’onglet Touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Indulj el a fenti elrendezések bármelyikéből, majd a Billentyűk fülön mozgasd a billentyűket és adj hozzá sorokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parti da una delle disposizioni qui sopra, poi sposta i tasti e aggiungi righe nella scheda Tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上のレイアウトのどれかから始めて、「キー」タブでキーを動かしたり行を足したりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위의 배열 중 하나로 시작한 다음 ‘키’ 탭에서 키를 옮기고 행을 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulakan daripada mana-mana susun atur di atas, kemudian alihkan kekunci dan tambah baris dalam tab Kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa por qualquer esquema acima e depois move teclas e acrescenta linhas no separador Teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возьмите любую раскладку выше за основу, а потом двигайте клавиши и добавляйте ряды на вкладке «Клавиши»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先从上面任选一套布局，然后在「按键」标签页里移动按键、添加行。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alusta mistahes ülalolevast paigutusest, seejärel liiguta klahve ja lisa ridu kaardil Klahvid."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Begin vanaf enige uitleg hierbo, skuif dan sleutels en voeg rye op die Sleutels-oortjie by."
          }
        }
      }
    },
