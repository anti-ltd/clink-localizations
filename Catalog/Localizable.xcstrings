    "Your ink, shown live. Swipe it to change style.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou ink, regstreeks gewys. Swiep dit om styl te verander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tinte, live. Wisch darüber, um den Stil zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tinta, en vivo. Deslízala para cambiar de estilo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu tint, reaalajas. Viipa sellel, et stiili vahetada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton encre, en direct. Balaie-la pour changer de style."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tintád, élőben. Húzd el az ujjad rajta a stílusváltáshoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo inchiostro, dal vivo. Scorri per cambiare stile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インクのプレビューです。スワイプするとスタイルを変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잉크를 실시간으로 보여줘요. 쓸어넘기면 스타일이 바뀌어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dakwat anda, secara langsung. Leret untuk tukar gaya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua tinta, ao vivo. Desliza para mudares de estilo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши чернила вживую. Смахните, чтобы сменить стиль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是你的墨迹效果。左右滑动就能换风格。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerneala ta, afișată în direct. Glisați-l pentru a schimba stilul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw inkt, live getoond. Veeg erover om van stijl te veranderen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是你的墨跡效果。左右滑動就能換風格。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój atrament pokazany na żywo. Przesuń, aby zmienić styl."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші чорнила, показані в прямому ефірі. Проведіть по ньому, щоб змінити стиль."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mürekkebiniz canlı olarak gösteriliyor. Stili değiştirmek için kaydırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš inkoust zobrazený živě. Přejetím prstem změníte styl."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš atrament zobrazený naživo. Prejdením prstom zmeníte štýl."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μελάνι σας, εμφανίζεται ζωντανά. Σύρετε το για να αλλάξετε στυλ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt bläck, visas live. Svep den för att ändra stil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit blæk, vist live. Stryg den for at ændre stil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt blekk, vist live. Sveip den for å endre stil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mustesi, näytetään livenä. Vaihda tyyliä pyyhkäisemällä sitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinta Anda, ditampilkan secara langsung. Gesek untuk mengubah gaya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mực của bạn, được hiển thị trực tiếp. Vuốt nó để thay đổi phong cách."
          }
        }
      }
    },
    "Your instructions, run on every dictation. Tell Clink how to write out what you say, and it handles the rest.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou instruksies, hardloop op elke diktaat. Sê vir Clink hoe om uit te skryf wat jy sê, en dit hanteer die res."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Anweisung, bei jedem Diktat angewendet. Sag Clink, wie es das Gesprochene aufschreiben soll, und den Rest übernimmt es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus instrucciones, aplicadas a cada dictado. Dile a Clink cómo escribir lo que dices y él se encarga del resto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu juhised, rakendatud igale dikteerimisele. Ütle Clinkile, kuidas see üteldu üles kirjutada, ja ta teeb ülejäänu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta consigne, appliquée à chaque dictée. Dis à Clink comment écrire ce que tu dis et il s'occupe du reste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A te utasításod, minden diktáláskor. Mondd meg Clinknek, hogyan írja le, amit mondasz, a többit pedig elintézi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue istruzioni, applicate a ogni dettatura. Dì a Clink come scrivere ciò che dici e al resto pensa lui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの指示を、口述のたびに適用します。話した内容をどう書き起こすか伝えれば、あとはClinkにおまかせ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기할 때마다 적용되는 내 지시. 말한 내용을 어떻게 옮길지 알려주면 나머지는 Clink가 알아서 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahan anda, digunakan pada setiap imlak. Beritahu Clink cara menulis apa yang anda sebut dan selebihnya diuruskan olehnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas instruções, aplicadas a cada ditado. Diz ao Clink como escrever o que dizes e do resto trata ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши указания применяются к каждой диктовке. Скажите Clink, как записывать сказанное, — остальное он берёт на себя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的指令，每次口述都会套用。告诉 Clink 怎么把你说的写出来，剩下的交给它。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrucțiunile tale, rulează pe fiecare dictare. Spune-i lui Clink cum să scrie ceea ce spui și se ocupă de restul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw instructies worden bij elk dictaat uitgevoerd. Vertel Clink hoe u moet opschrijven wat u zegt, en de rest wordt afgehandeld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的指令，每次口述都會套用。告訴 Clink 怎麼把你說的寫出來，剩下的交給它。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje instrukcje, działają na każdym dyktandzie. Powiedz Clink, jak ma zapisywać to, co mówisz, a on zajmie się resztą."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші вказівки, виконувати кожен диктант. Скажіть Clink, як писати те, що ви говорите, і він впорається з рештою."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Talimatlarınız, her diktede çalıştırın. Clink'e söylediklerinizi nasıl yazacağını söyleyin, gerisini o halleder."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše pokyny, běžte na každý diktát. Řekněte Clink, jak má napsat, co říkáte, a ono se postará o zbytek."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše pokyny, spustite každý diktát. Povedzte Clink, ako má napísať, čo hovoríte, a on sa postará o zvyšok."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι οδηγίες σας, τρέχουν σε κάθε υπαγόρευση. Πείτε στο Clink πώς να γράψει αυτό που λέτε και θα χειριστεί τα υπόλοιπα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina instruktioner, kör på varje diktat. Berätta för Clink hur man skriver ut vad du säger, så tar den hand om resten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine instruktioner, kør på hver diktat. Fortæl Clink, hvordan du skriver, hvad du siger, og den klarer resten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine instruksjoner, kjør på hver diktat. Fortell Clink hvordan du skal skrive ut det du sier, og den håndterer resten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinun ohjeesi, toimivat kaikissa saneluissa. Kerro Clink:lle, kuinka kirjoittaa sanomasi, ja se hoitaa loput."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instruksi Anda diterapkan setiap kali Anda mendikte. Beri tahu Clink cara menuliskan ucapan Anda, dan sisanya akan ditangani secara otomatis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hướng dẫn của bạn, chạy trên mọi chính tả. Hãy cho Clink biết cách viết ra những gì bạn nói và nó sẽ xử lý phần còn lại."
          }
        }
      }
    },
