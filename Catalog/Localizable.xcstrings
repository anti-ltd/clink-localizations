    "Your description and the current draft are included in the request. Review the result before applying it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud incluye tu descripción y el borrador actual. Revisa el resultado antes de aplicarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta description et le brouillon actuel sont inclus dans la requête. Vérifie le résultat avant de l’appliquer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Beschreibung und der aktuelle Entwurf werden mitgesendet. Prüfe das Ergebnis, bevor du es übernimmst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La richiesta include la tua descrizione e la bozza attuale. Controlla il risultato prima di applicarlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O pedido inclui a sua descrição e o rascunho atual. Reveja o resultado antes de o aplicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В запрос включены ваше описание и текущий черновик. Проверьте результат перед применением."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan merangkumi penerangan anda dan draf semasa. Semak hasil sebelum menggunakannya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kérés tartalmazza a leírásodat és az aktuális vázlatot. Alkalmazás előtt ellenőrizd az eredményt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "説明と現在の下書きがリクエストに含まれます。適用する前に結果を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求中会包含你的描述和当前草稿。应用前请检查结果。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청에는 설명과 현재 초안이 포함됩니다. 적용하기 전에 결과를 검토하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Päring sisaldab sinu kirjeldust ja praegust mustandit. Vaata tulemus enne rakendamist üle."
          }
        }
      }
    },
    "Your edits since you applied %@ will be discarded.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou wysigings sedert jy %@ toegepas het, sal weggegooi word."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Änderungen seit dem Anwenden von %@ werden verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descartarán los cambios que hayas hecho desde que aplicaste %@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu muudatused pärast %@ rakendamist hüljatakse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes modifications depuis l'application de %@ seront annulées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ alkalmazása óta végzett módosításaid elvesznek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche apportate da quando hai applicato %@ verranno scartate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を適用してから行った変更は破棄されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 적용한 이후의 변경 사항은 사라져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Suntingan anda sejak anda menggunakan %@ akan dibuang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações que fizeste desde que aplicaste %@ vão ser descartadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правки, сделанные после применения «%@», будут отменены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自从应用 %@ 之后的更改都会被放弃。"
          }
        }
      }
    },
    "Your edits to this action will be discarded.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou wysigings aan hierdie handeling sal weggegooi word."
          }
        },
        "de": {
