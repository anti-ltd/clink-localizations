    "Touch and hold a GIF to add it to Favorites.": {
      "comment": "GIF browser UI and accessibility. Native-speaker editorial sign-off for this release is tracked in docs/gif-tool-localization-review.md.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold a GIF to add it to Favorites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un GIF para añadirlo a Favoritos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie longuement sur un GIF pour l’ajouter aux favoris."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein GIF gedrückt, um es zu deinen Favoriten hinzuzufügen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta una GIF per aggiungerla ai preferiti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém um GIF premido para o adicionares aos Favoritos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте GIF, чтобы добавить его в избранное."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentuh dan tahan GIF untuk menambahkannya pada Kegemaran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd nyomva a GIF-et, hogy a kedvencekhez add."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFを長押しすると、お気に入りに追加できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按 GIF 即可将其加入收藏。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF를 길게 눌러 즐겨찾기에 추가하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lemmikutesse lisamiseks puuduta GIF-i ja hoia sõrme sellel."
          }
        }
      }
    },
