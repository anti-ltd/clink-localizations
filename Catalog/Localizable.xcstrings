    "Spring response time for the popup appearing and disappearing.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lente-reaksietyd vir die opspringer wat verskyn en verdwyn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaktionszeit der Feder beim Erscheinen und Verschwinden des Pop-ups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo de respuesta del resorte al aparecer y desaparecer la ventana."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedru reageerimisaeg hüpiku ilmumisel ja kaomisel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps de réponse du ressort quand la bulle apparaît et disparaît."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felugró ablak megjelenésének és eltűnésének rugós válaszideje."
          }
        },
