    "Low Power Mode is on, so the light holds still instead of moving. Presses still light up.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de bajo consumo está activado, por lo que la luz permanece fija. Las pulsaciones siguen iluminándose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode économie d’énergie est activé, donc la lumière reste fixe. Les touches s’allument toujours à l’appui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stromsparmodus ist aktiv, deshalb bleibt das Licht unbewegt. Tastendrücke leuchten weiterhin auf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il risparmio energetico è attivo, quindi la luce resta ferma. I tasti si illuminano ancora alla pressione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo de baixo consumo está ativo, pelo que a luz fica estática. As teclas continuam a iluminar-se ao premir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включён режим энергосбережения, поэтому подсветка неподвижна. Нажатия по-прежнему подсвечиваются."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mod Kuasa Rendah dihidupkan, jadi cahaya tidak bergerak. Kekunci masih menyala apabila ditekan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Alacsony töltöttségű mód be van kapcsolva, ezért a fény nem mozog. A leütések továbbra is felvillannak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低電力モードがオンのため、光の動きを止めています。キーを押したときの点灯は続きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低电量模式已开启，灯光保持静止。按键按下时仍会亮起。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저전력 모드가 켜져 있어 빛이 움직이지 않습니다. 키를 누르면 계속 빛납니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vähese energiatarbega režiim on sisse lülitatud, seega valgus ei liigu. Vajutused süütavad endiselt valguse."
          }
        }
      }
    },
    "Low Power Mode is on. Glass keeps rendering, but the glow, bloom, and ambient motion pause to save battery.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laekragmodus is aan. Glas hou aan om weer te gee, maar die gloei, bloei en omringende beweging pouse om battery te bespaar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stromsparmodus ist an. Das Glas bleibt, aber Leuchten, Aufblühen und Umgebungsbewegung pausieren, um Akku zu sparen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de bajo consumo está activado. El cristal se mantiene, pero el brillo, el destello y el movimiento ambiental se pausan para ahorrar batería."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Energiasäästurežiim on sees. Klaas jätkab renderdamist, aga sära, bloom ja õhustikuliikumine peatuvad aku säästmiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode économie d'énergie est activé. Le verre reste affiché, mais la lueur, la floraison et le mouvement d'ambiance se mettent en pause pour économiser la batterie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az energiatakarékos mód be van kapcsolva. Az üveg marad, de a ragyogás, a felvillanás és a háttérmozgás szünetel, hogy kímélje az akkumulátort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il risparmio energetico è attivo. Il vetro resta, ma bagliore, fioritura e movimento ambientale si mettono in pausa per risparmiare batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低電力モードがオンです。ガラスはそのままで、グロー、ブルーム、環境アニメーションはバッテリー節約のため停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저전력 모드가 켜져 있습니다. 글래스는 그대로 두고 글로우, 블룸, 배경 움직임은 배터리 절약을 위해 멈춥니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mod Kuasa Rendah dihidupkan. Kaca kekal, tetapi cahaya, kembang dan gerakan latar dijeda untuk menjimatkan bateri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo de baixo consumo está ativado. O vidro continua, mas o brilho, o realce e o movimento ambiente pausam para poupar bateria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включён режим энергосбережения. Стекло по-прежнему рисуется, но сияние, свечение и фоновое движение приостановлены ради батареи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低电量模式已开启。玻璃继续渲染，但光晕、绽放和环境动效会暂停以省电。"
          }
        }
      }
    },
