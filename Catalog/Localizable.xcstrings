        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть, щоб змінити порядок, або торкніться мінуса, щоб вилучити щось."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden sıralamak için sürükleyin veya bir şeyi çıkarmak için eksiye dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetažením změňte pořadí nebo klepnutím na mínus něco odeberte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnutím zmeníte poradie alebo klepnutím na mínus niečo vyberiete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε για αναδιάταξη ή πατήστε το μείον για να βγάλετε κάτι."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att ändra ordning eller tryck på minus för att ta ut något."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at omarrangere, eller tryk på minus for at tage noget ud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å omorganisere, eller trykk på minus for å ta ut noe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestä uudelleen vetämällä tai ota jotain pois napauttamalla miinusmerkkiä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk menyusun ulang, atau ketuk tanda minus untuk mengambil sesuatu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo để sắp xếp lại hoặc nhấn vào dấu trừ để lấy thứ gì đó ra."
          }
        }
      }
    },
    "Drag to reorder, switch off what you never use. A tab with nothing in it is left out of the keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om te herrangskik, skakel af wat jy nooit gebruik nie. 'n Oortjie met niks daarin nie, word uit die sleutelbord gelaat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh sie in die Reihenfolge, die du willst, und schalte aus, was du nie brauchst. Ein leerer Tab taucht auf der Tastatur gar nicht erst auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrástralas para ordenarlas y apaga las que no uses nunca. Una pestaña vacía no aparece en el teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista järjestamiseks, lülita välja see, mida sa kunagi ei kasuta. Tühi kaart jäetakse klaviatuurilt ära."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais-les glisser pour les ranger et désactive celles que tu n'utilises jamais. Un onglet vide n'apparaît pas sur le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd őket a kívánt sorrendbe, és kapcsold ki, amit sosem használsz. Az üres fül meg sem jelenik a billentyűzeten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascinale per riordinarle e spegni quelle che non usi mai. Una scheda vuota non compare sulla tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替え、使わないものはオフにできます。中身が空のタブはキーボードには出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끌어서 순서를 바꾸고, 안 쓰는 건 꺼두세요. 비어 있는 탭은 키보드에 나오지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk susun semula, matikan yang anda tak pernah guna. Tab yang kosong tak muncul pada papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta para reordenar e desliga o que nunca usas. Um separador vazio não aparece no teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскиванием задайте порядок и выключите то, чем не пользуетесь. Пустая вкладка на клавиатуру не попадает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动排序，用不上的直接关掉。空的分类不会出现在键盘上。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trageți pentru a reordona, dezactivați ceea ce nu utilizați niciodată. O filă fără nimic în ea este lăsată în afara tastaturii."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om opnieuw te ordenen, schakel uit wat u nooit gebruikt. Een tabblad waar niets in staat, wordt buiten het toetsenbord gelaten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動排序，用不上的直接關掉。空的分類不會出現在鍵盤上。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zmienić kolejność i wyłączyć to, czego nigdy nie używasz. Zakładka, w której nic się nie znajduje, pozostaje poza klawiaturą."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть, щоб змінити порядок, вимкніть те, що ви ніколи не використовуєте. За межами клавіатури залишається вкладка, на якій нічого немає."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden sıralamak için sürükleyin, hiç kullanmadıklarınızı kapatın. İçinde hiçbir şey olmayan bir sekme klavyenin dışında bırakılır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetažením změníte pořadí, vypněte to, co nikdy nepoužíváte. Z klávesnice je vynechána karta, na které není nic."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnutím zmeníte poradie, vypnite to, čo nikdy nepoužívate. Z klávesnice je vynechaná karta, na ktorej nie je nič."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε για αναδιάταξη, απενεργοποιήστε ό,τι δεν χρησιμοποιείτε ποτέ. Μια καρτέλα που δεν περιέχει τίποτα παραμένει εκτός πληκτρολογίου."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att ändra ordning, stäng av det du aldrig använder. En flik med ingenting i den lämnas utanför tangentbordet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at omarrangere, sluk det, du aldrig bruger. En fane uden noget i er udeladt af tastaturet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å omorganisere, slå av det du aldri bruker. En fane uten noe i er utelatt fra tastaturet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestä uudelleen vetämällä ja sammuta asiat, joita et koskaan käytä. Näppäimistöstä jätetään välilehti, jossa ei ole mitään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk menyusun ulang, matikan yang tidak pernah Anda gunakan. Tab yang tidak berisi apa pun tertinggal dari keyboard."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo để sắp xếp lại, tắt những gì bạn không bao giờ sử dụng. Một tab không có gì trong đó sẽ bị loại khỏi bàn phím."
          }
        }
      }
    },
    "Drag to reorder. The suggestions stretch to fill whatever room is left.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Neuordnen ziehen. Die Vorschläge füllen den restlichen Platz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Las sugerencias ocupan el espacio que quede."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestuse muutmiseks lohista. Soovitused täidavad ülejäänud ruumi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser pour réorganiser. Les suggestions occupent l’espace restant."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd az átrendezéshez. A javaslatok kitöltik a maradék helyet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. I suggerimenti occupano lo spazio rimasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで並べ替え。候補は残りのスペースいっぱいに広がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그해서 순서를 바꾸세요. 추천 단어가 남은 공간을 채웁니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk susun semula. Cadangan mengisi ruang yang tinggal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. As sugestões ocupam o espaço que sobrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы изменить порядок. Подсказки занимают всё оставшееся место."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以重新排序。建议会填满剩余空间。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trageți pentru a reordona. Sugestiile se întind pentru a umple orice cameră rămasă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om de volgorde te wijzigen. De suggesties strekken zich uit tot het opvullen van de ruimte die nog over is."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動以重新排序。建議會填滿剩餘空間。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om te herskik. Die voorstelle strek om die oorblywende ruimte te vul."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zmienić kolejność. Sugestie rozciągają się, aby wypełnić całe pozostałe miejsce."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть, щоб змінити порядок. Пропозиції розтягуються, щоб заповнити всю кімнату, що залишилася."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden sıralamak için sürükleyin. Öneriler, kalan odayı dolduracak kadar genişliyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetažením změníte pořadí. Návrhy se rozšíří tak, aby zaplnily jakoukoli zbývající místnost."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presunutím zmeníte poradie. Návrhy sa rozšíria tak, aby zaplnili akúkoľvek zostávajúcu miestnosť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε για αναδιάταξη. Οι προτάσεις απλώνονται για να γεμίσουν ό,τι χώρο έχει απομείνει."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att ändra ordning. Förslagen sträcker sig för att fylla det utrymme som finns kvar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at omarrangere. Forslagene strækker sig til at fylde det rum, der er tilbage."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å omorganisere. Forslagene strekker seg til å fylle det rommet som er igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestä uudelleen vetämällä. Ehdotukset ulottuvat täyttämään jäljellä olevan tilan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik untuk menyusun ulang. Saran-sarannya diperluas untuk mengisi ruang apa pun yang tersisa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo để sắp xếp lại. Những lời đề nghị sẽ lấp đầy những khoảng trống còn lại."
          }
        }
      }
    },
    "Drag to reposition. Pinch to zoom.": {
      "comment": "Instructions for the theme background or shared key-image framing preview. Drag the image to reposition its visible area; move two fingers together or apart to change its scale. This does not alter the original image.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Verschieben ziehen. Zum Zoomen zwei Finger auseinander- oder zusammenziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reposition. Pinch to zoom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para mover. Pellizca para ajustar el zoom."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista liigutamiseks. Suurendamiseks või vähendamiseks vii kaks sõrme lahku või kokku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser pour déplacer. Pince pour zoomer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd el a mozgatáshoz. Két ujjal csippentve nagyíthatsz vagy kicsinyíthetsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per spostare. Pizzica per regolare lo zoom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして移動できます。ピンチして拡大・縮小できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 이동하세요. 두 손가락을 오므리거나 벌려 확대 또는 축소하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk mengalih. Cubit untuk mengezum."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta para mover. Junta ou afasta dois dedos para ajustar o zoom."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте, чтобы переместить. Сводите и разводите пальцы, чтобы изменить масштаб."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
