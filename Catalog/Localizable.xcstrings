    "Show a small glyph on each key previewing its first long-press alternate, and pick which corner of the cap it sits in.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra en cada tecla un pequeño símbolo con la primera alternativa de pulsación prolongada y elige en qué esquina aparece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez sur chaque touche un petit symbole indiquant sa première variante d’appui prolongé et choisissez dans quel coin il apparaît."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige auf jeder Taste ein kleines Symbol für ihre erste Gedrückthalten-Alternative und wähle die Ecke der Tastenkappe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra su ogni tasto un piccolo simbolo dell’alternativa del primo tocco prolungato e scegli in quale angolo posizionarlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra em cada tecla um pequeno símbolo da primeira alternativa de toque longo e escolhe em que canto fica."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Paparkan pada setiap kekunci ikon kecil bagi alternatif tekan lama pertama dan pilih sudut letaknya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeleníts meg minden billentyűn egy kis jelet az első hosszan nyomásos alternatívához, és válaszd ki a billentyűsapkán elfoglalt sarkát."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーに最初の長押し代替を示す小さな記号を表示し、キーキャップのどの角に置くかを選びます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每个按键上显示一个小图标来预览其首个长按替代项，并选择它位于键帽的哪个角落。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 키에 첫 번째 길게 누르기 대체 항목을 미리 보는 작은 기호를 표시하고 키캡의 어느 모서리에 둘지 선택하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva igal klahvil väike sümbol, mis näitab selle esimest pikalt vajutamise alternatiivi, ja vali, millises klahvinurgas see asub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите на каждой клавише маленький символ для первого варианта удержания и выберите угол клавиши, где он будет расположен."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wys 'n klein gly op elke sleutel en kyk na die eerste langdruk-alternatiewe, en kies in watter hoek van die dop dit sit."
          }
        }
      }
    },
