        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto obrazovka teraz funguje. Pridajte si klávesnicu do Nastavenia, aby ste mohli hovoriť aj v iných aplikáciách."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η οθόνη λειτουργεί τώρα. Προσθέστε το πληκτρολόγιο στις Ρυθμίσεις για να μιλήσετε και σε άλλες εφαρμογές."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här skärmen fungerar nu. Lägg till tangentbordet i Inställningar för att prata i andra appar också."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne skærm virker nu. Tilføj tastaturet i Indstillinger for også at tale i andre apps."
