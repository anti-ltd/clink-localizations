          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji dimatikan. Hidupkannya untuk guna dan sesuaikannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os emojis estão desligados. Liga-os para os usares e personalizares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эмодзи выключены. Включите их, чтобы пользоваться и настраивать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
