    "Open this tab after the repository has published a release.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne diesen Tab, sobald das Repository eine Version veröffentlicht hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre esta pestaña cuando el repositorio haya publicado una versión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava see kaart pärast seda, kui hoidla on väljalaske avaldanud."
          }
        },
        "fr": {
          "stringUnit": {
