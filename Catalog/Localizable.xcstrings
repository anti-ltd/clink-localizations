            "value": "모든 배열"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap susunan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as disposições"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все раскладки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有排列"
          }
        }
      }
    },
    "Every letter blank. Draw the ones you want.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las letras en blanco. Dibuja las que quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les lettres sont vides. Dessine celles que tu veux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Buchstaben leer. Zeichne die, die du willst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le lettere vuote. Disegna quelle che vuoi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as letras vazias. Desenhe as que quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все буквы пустые. Нарисуйте те, что нужны."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua huruf kosong. Lukis yang anda mahu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden betű üres. Rajzold meg, amelyiket akarod."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての文字が空です。必要なものを描いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有字母都是空白。想画哪个就画哪个。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 글자가 비어 있습니다. 원하는 글자를 그리세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik tähed on tühjad. Joonista need, mida soovid."
          }
        }
      }
    },
    "Every letter you type triggers a quick check against the dictionary, language rules, and words you've taught it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke letter wat jy tik veroorsaak 'n vinnige tjek teen die woordeboek, taalreëls en woorde wat jy dit geleer het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Buchstabe, den du tippst, löst eine schnelle Prüfung gegen das Wörterbuch, die Sprachregeln und die Wörter aus, die du ihr beigebracht hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada letra que escribes lanza una comprobación rápida contra el diccionario, las reglas del idioma y las palabras que le has enseñado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga täht, mida tipid, käivitab kiire kontrolli sõnaraamatu, keeli reeglite ja sõnade vastu, mida talle õpetanud oled."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque lettre que tu tapes déclenche une vérif rapide avec le dictionnaire, les règles de langue et les mots que tu lui as appris."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden beírt betű gyors ellenőrzést indít a szótár, a nyelvi szabályok és az általad megtanított szavak alapján."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni lettera che digiti fa scattare un rapido controllo con il dizionario, le regole della lingua e le parole che le hai insegnato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字を打つたびに、辞書、言語ルール、あなたが教えた単語に照らして素早くチェックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자를 하나 칠 때마다 사전, 언어 규칙, 그리고 알려준 단어를 상대로 빠르게 확인해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap huruf yang anda taip mencetuskan semakan pantas terhadap kamus, peraturan bahasa, dan perkataan yang anda ajarkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada letra que escreves aciona uma verificação rápida contra o dicionário, as regras do idioma e as palavras que lhe ensinaste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая напечатанная буква запускает быструю сверку со словарём, правилами языка и словами, которым вы его научили."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打的每个字母都会触发一次快速检查，对照词典、语言规则和你教过它的词。"
          }
        }
      }
    },
    "Every minute while visible": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada minuto mientras esté visible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque minute tant que le clavier est visible"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Minute, solange sichtbar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni minuto mentre è visibile"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada minuto enquanto está visível"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждую минуту, пока клавиатура видна"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap minit semasa kelihatan"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Percenként, amíg látható"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中は毎分"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示期间每分钟"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 표시되는 동안 매분"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga minut, kui klaviatuur on nähtav"
          }
        }
      }
    },
    "Every page opens on the settings most people want and keeps the rest folded away.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke bladsy maak oop op die instellings wat die meeste mense wil hê en hou die res weggevou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Seite startet mit dem, was die meisten brauchen, und hält den Rest eingeklappt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada página se abre con los ajustes que quiere casi todo el mundo y guarda el resto plegado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga leht avaneb seadistustega, mida enamik tahab, ja hoiab ülejäänu kokku voldituna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque page s'ouvre sur les réglages que veulent la plupart des gens et garde le reste replié."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden oldal azzal nyit, amit a legtöbben keresnek, a többit pedig összecsukva tartja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni pagina si apre sulle impostazioni che vuole la maggior parte delle persone e tiene il resto ripiegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ページは多くの人が使う設定で開き、それ以外は畳んだままにしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 페이지는 대부분이 쓰는 설정으로 열리고, 나머지는 접어 둡니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap halaman dibuka dengan tetapan yang dimahukan kebanyakan orang dan menyimpan selebihnya dalam lipatan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada página abre com as definições que quase toda a gente quer e mantém o resto dobrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая страница открывается на настройках, нужных большинству, а остальные держит свёрнутыми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个页面都从大多数人要用的设置开始，其余的先收起来。"
          }
        }
      }
    },
    "Every preset theme, layout and sound stays free too. The tools, custom looks, and custom themes and layouts need a membership.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke voorafingestelde tema, uitleg en klank bly ook gratis. Die gereedskap, pasgemaakte voorkoms en pasgemaakte temas en uitlegte het 'n lidmaatskap nodig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch jedes Design, Layout und jeder Sound aus den Presets bleibt kostenlos. Die Tools, eigene Looks sowie eigene Designs und Layouts erfordern eine Mitgliedschaft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los temas, diseños y sonidos predefinidos también siguen siendo gratis. Las herramientas, los looks personalizados y los temas y diseños personalizados requieren una suscripción."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik eelseadistatud teemad, paigutused ja helid on samuti tasuta. Tööriistad, kohandatud välimused ning kohandatud teemad ja paigutused nõuavad liikmelisust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les thèmes, dispositions et sons prédéfinis restent gratuits. Les outils, les looks personnalisés et les thèmes et dispositions personnalisés nécessitent un abonnement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden beépített téma, elrendezés és hang ingyenes marad. Az eszközök, az egyedi megjelenések, valamint az egyedi témák és elrendezések előfizetést igényelnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche tutti i temi, i layout e i suoni predefiniti restano gratuiti. Gli strumenti, gli stili personalizzati e i temi e layout personalizzati richiedono un abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットのテーマ、レイアウト、サウンドもすべて無料のままです。ツール、カスタムルック、カスタムテーマ・レイアウトにはメンバーシップが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리셋 테마, 레이아웃, 사운드도 모두 무료로 유지됩니다. 도구, 맞춤 스타일, 맞춤 테마와 레이아웃은 멤버십이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua tema, susun atur dan bunyi pratetap juga kekal percuma. Alatan, rupa tersuai serta tema dan susun atur tersuai memerlukan keahlian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os temas, layouts e sons predefinidos também continuam gratuitos. As ferramentas, os visuais personalizados e os temas e layouts personalizados exigem uma assinatura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все готовые темы, раскладки и звуки тоже остаются бесплатными. Инструменты, свои стили, свои темы и раскладки требуют членства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有预设主题、布局和声音也保持免费。工具、自定义外观以及自定义主题和布局需要会员资格。"
          }
        }
      }
    },
    "Every reaction is optional. They run on press or appearance only, so the keyboard stays fast.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke reaksie is opsioneel. Hulle werk slegs op druk of voorkoms, so die sleutelbord bly vinnig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Reaktion ist optional. Sie laufen nur beim Drücken oder Einblenden, damit die Tastatur schnell bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada reacción es opcional. Solo se ejecutan al pulsar o al aparecer, así que el teclado sigue yendo rápido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga reaktsioon on valikuline. Need töötavad ainult vajutusel või ilmumisel, nii et klaviatuur jääb kiireks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque réaction est facultative. Elles ne tournent qu'à l'appui ou à l'apparition, comme ça le clavier reste rapide."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden reakció opcionális. Csak megnyomáskor vagy megjelenéskor futnak, így a billentyűzet gyors marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni reazione è facoltativa. Partono solo alla pressione o alla comparsa, così la tastiera resta veloce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反応はどれもお好みです。押したときや表示されたときだけ動くので、キーボードは速いままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반응은 모두 선택이에요. 누르거나 나타날 때만 돌아서 키보드가 계속 빨라요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap reaksi bersifat pilihan. Ia jalan semasa ditekan atau muncul sahaja, jadi papan kekunci kekal pantas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada reação é opcional. Só correm ao premires ou ao aparecerem, por isso o teclado mantém-se rápido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все реакции необязательны. Они срабатывают только при нажатии или появлении, поэтому клавиатура остаётся быстрой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每种反应都是可选的。它们只在按下或出现时运行，所以键盘一直很快。"
          }
        }
      }
    },
    "Every sample learned for this layout & language is discarded. Other profiles keep theirs.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke monster wat vir hierdie uitleg en taal geleer word, word weggegooi. Ander profiele behou hulle s'n."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle für dieses Layout & diese Sprache gelernten Beispiele werden verworfen. Andere Profile behalten ihre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descartan todas las muestras aprendidas para esta distribución e idioma. Otros perfiles conservan las suyas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga selle paigutuse ja keele jaoks õpitud näidis hüljatakse. Teised profiilid peavad omad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les échantillons appris pour cette disposition et cette langue sont supprimés. Les autres profils gardent les leurs."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ehhez a kiosztáshoz és nyelvhez tanult minden minta törlődik. A többi profil megtartja a sajátját."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i campioni appresi per questo layout e questa lingua vengono eliminati. Gli altri profili mantengono i propri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレイアウトと言語で学習したサンプルはすべて破棄されます。他のプロファイルのものはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 레이아웃과 언어로 학습한 샘플이 모두 사라져요. 다른 프로필의 학습 내용은 그대로 남아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua sampel yang dipelajari untuk susun atur & bahasa ini dibuang. Profil lain kekalkan sampel mereka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as amostras aprendidas para este esquema e idioma são descartadas. Os outros perfis mantêm as deles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все образцы, выученные для этой раскладки и языка, будут отброшены. У других профилей свои остаются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "针对这个布局和语言学到的所有样本都会被清空。其他配置文件的学习内容不受影响。"
          }
        }
      }
    },
