            "state": "translated",
            "value": "마지막에 보던 곳부터"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambung dari tempat terakhir"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar onde ficaste"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжите с того места, где остановились"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从上次的位置继续"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätka sealt, kus pooleli jäid"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou aan waar jy opgehou het"
          }
        }
      }
    },
    "Pick your colours, drop in a background, choose a font. Save the looks you like and swap between them anytime.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl deine Farben, setz einen Hintergrund ein, such eine Schrift aus. Sichere die Looks, die dir gefallen, und wechsle jederzeit zwischen ihnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tus colores, pon un fondo, escoge una fuente. Guarda los estilos que te gusten y cambia entre ellos cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis tes couleurs, ajoute un arrière-plan, choisis une police. Enregistre les styles que tu aimes et passe de l'un à l'autre quand tu veux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki a színeidet, tegyél be egy hátteret, válassz betűtípust. Mentsd el a kedvenc megjelenéseidet, és bármikor válts köztük."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli i colori, metti uno sfondo, scegli un carattere. Salva i look che ti piacciono e passa dall'uno all'altro quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色を選び、背景を入れ、フォントを選びます。気に入った見た目を保存して、いつでも切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색을 고르고, 배경을 넣고, 글꼴을 골라요. 마음에 드는 모습을 저장해 두고 언제든 바꿔가며 쓰세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih warna anda, letak latar, pilih fon. Simpan rupa yang anda suka dan tukar antaranya bila-bila masa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe as tuas cores, mete um fundo, escolhe um tipo de letra. Guarda os visuais de que gostas e troca entre eles quando quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите цвета, поставьте фон, подберите шрифт. Сохраняйте понравившиеся варианты и меняйте их когда угодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑你的颜色，放个背景，选个字体。喜欢的样式存下来，随时换着用。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali oma värvid, lisa taust, vali font. Salvesta meeldivad ilmed ja vaheta neid igal ajal."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies jou kleure, plaas 'n agtergrond, kies 'n lettertipe. Stoor die voorkoms waarvan jy hou en ruil enige tyd tussen hulle."
          }
        }
      }
    },
    "Picks the most natural word, not just the most common": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt das natürlichste Wort, nicht nur das häufigste"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la palabra más natural, no solo la más común"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisit le mot le plus naturel, pas seulement le plus courant"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legtermészetesebb szót választja, nem csak a leggyakoribbat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sceglie la parola più naturale, non solo la più comune"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん多い単語ではなく、いちばん自然な単語を選びます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 흔한 단어가 아니라 가장 자연스러운 단어를 골라요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih perkataan paling semula jadi, bukan sekadar yang paling biasa"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe a palavra mais natural, não só a mais comum"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирает самое естественное слово, а не просто самое частое"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑最自然的词，不只是最常见的"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valib kõige loomulikuma sõna, mitte ainult kõige sagedasema"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies die mees natuurlike woord, nie net die algemeenste nie"
          }
        }
      }
    },
