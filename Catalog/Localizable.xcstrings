    "Turn off “Pick up where you left off” to always open on one category.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel \"Gaan aan waar jy opgehou het\" af om altyd op een kategorie oop te maak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte „Da weitermachen, wo du warst“ aus, um immer dieselbe Kategorie zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva «Seguir donde lo dejaste» para abrir siempre en la misma categoría."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita välja „Jätka sealt, kus pooleli jäid”, et avada alati ühes kategoorias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive « Reprendre où tu t'es arrêté » pour toujours ouvrir sur la même catégorie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold ki a „Ott folytasd, ahol abbahagytad” opciót, ha mindig ugyanazzal a kategóriával szeretnéd kezdeni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva «Riprendi da dove eri» per aprire sempre sulla stessa categoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に同じカテゴリで開きたいときは「前の続きから開く」をオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 같은 카테고리로 열려면 ‘마지막에 보던 곳부터’를 꺼주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan “Sambung dari tempat terakhir” untuk sentiasa buka pada satu kategori."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga «Continuar onde ficaste» para abrir sempre na mesma categoria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите «Продолжить с того места, где остановились», чтобы всегда открываться на одной категории."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想每次都从同一个分类打开，就关掉「从上次的位置继续」。"
          }
        }
      }
    },
