    "Set the color and the speed underneath.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel die kleur en die spoed daaronder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbe und Tempo stellst du darunter ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debajo ajustas el color y la velocidad."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Määra allpool värv ja kiirus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle la couleur et la vitesse en dessous."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alatta állítsd be a színt és a sebességet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sotto imposti il colore e la velocità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その下で色と速さを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 아래에서 색과 속도를 정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan warna dan kelajuan di bawahnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Define a cor e a velocidade por baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте цвет и скорость ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下面设置颜色和速度。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setați culoarea și viteza dedesubt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel hieronder de kleur en de snelheid in."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下面設定顏色和速度。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw kolor i prędkość poniżej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановіть колір і швидкість під ним."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altındaki rengi ve hızı ayarlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte barvu a rychlost pod ním."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte farbu a rýchlosť pod ním."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρυθμίστε το χρώμα και την ταχύτητα από κάτω."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in färgen och hastigheten under."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstil farven og hastigheden nedenunder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Still inn fargen og hastigheten under."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta väri ja nopeus alla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur warna dan kecepatan di bawahnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt màu sắc và tốc độ bên dưới."
          }
        }
      }
    },
