    "Started from %@. Your font stays on this device: fonts made here aren't attached to shared themes.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creada a partir de %@. Tu fuente se queda en este dispositivo: las fuentes hechas aquí no se adjuntan a los temas compartidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créée à partir de %@. Ta police reste sur cet appareil : les polices créées ici ne sont pas jointes aux thèmes partagés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgehend von %@ erstellt. Deine Schrift bleibt auf diesem Gerät: hier erstellte Schriften werden geteilten Themes nicht beigefügt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creato a partire da %@. Il tuo font resta su questo dispositivo: i font creati qui non vengono allegati ai temi condivisi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Criada a partir de %@. A sua fonte fica neste dispositivo: as fontes feitas aqui não são anexadas a temas partilhados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создан на основе %@. Ваш шрифт остаётся на этом устройстве: созданные здесь шрифты не прикрепляются к общим темам."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimulakan daripada %@. Fon anda kekal pada peranti ini: fon yang dibuat di sini tidak dilampirkan pada tema yang dikongsi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ alapján készült. A betűtípusod ezen az eszközön marad: az itt készített betűtípusok nem csatolódnak a megosztott témákhoz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をもとに作成しました。このフォントは端末内にとどまり、共有するテーマには添付されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 %@ 创建。你的字体保留在此设备上：在此制作的字体不会随分享的主题一起发送。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 시작했습니다. 만든 글꼴은 이 기기에만 남으며, 공유하는 테마에는 첨부되지 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loodud fondi %@ põhjal. Sinu font jääb sellesse seadmesse: siin tehtud fonte ei lisata jagatavatele teemadele."
          }
        }
      }
    },
