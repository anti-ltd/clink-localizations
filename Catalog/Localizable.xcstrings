    "Adapt your keyboard with conditions, events, and plugin actions.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapta el teclado con condiciones, eventos y acciones de plugins."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapte ton clavier grâce à des conditions, des événements et des actions de plugins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe deine Tastatur mit Bedingungen, Ereignissen und Plugin-Aktionen an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Adatta la tastiera con condizioni, eventi e azioni dei plugin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapta o teclado com condições, eventos e ações de plugins."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настраивайте клавиатуру с помощью условий, событий и действий плагинов."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan papan kekunci dengan syarat, peristiwa dan tindakan pemalam."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alakítsd a billentyűzetet feltételekkel, eseményekkel és bővítményműveletekkel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "条件、イベント、プラグインのアクションでキーボードを調整できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过条件、事件和插件操作调整键盘。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조건, 이벤트 및 플러그인 동작으로 키보드를 조정하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohanda klaviatuuri tingimuste, sündmuste ja pistikprogrammide toimingutega."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptați-vă tastatura cu condiții, evenimente și acțiuni de plugin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas uw toetsenbord aan met voorwaarden, gebeurtenissen en plug-inacties."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過條件、事件和外掛操作調整鍵盤。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas jou sleutelbord aan met toestande, gebeurtenisse en inpropaksies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj klawiaturę do warunków, zdarzeń i działań wtyczek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адаптуйте свою клавіатуру за допомогою умов, подій і дій плагіна."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyenizi koşullara, olaylara ve eklenti eylemlerine göre uyarlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přizpůsobte klávesnici podmínkám, událostem a akcím pluginu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prispôsobte svoju klávesnicu podmienkam, udalostiam a akciám doplnkov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσαρμόστε το πληκτρολόγιό σας με συνθήκες, συμβάντα και ενέργειες προσθηκών."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassa ditt tangentbord med villkor, händelser och plugin-åtgärder."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpas dit tastatur med betingelser, begivenheder og plugin-handlinger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpass tastaturet ditt med forhold, hendelser og plugin-handlinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukauta näppäimistösi ehtojen, tapahtumien ja laajennustoimintojen mukaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan keyboard Anda dengan kondisi, peristiwa, dan tindakan plugin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều chỉnh bàn phím của bạn với các điều kiện, sự kiện và hành động plugin."
          }
        }
      }
    },
