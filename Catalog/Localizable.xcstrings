    "Nothing I change in the app reaches the keyboard": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ich in der App ändere, kommt nicht auf der Tastatur an"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que cambio en la app no llega al teclado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que je change dans l'app n'arrive pas au clavier"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amit az appban átállítok, nem jelenik meg a billentyűzeten"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che cambio nell'app non arriva alla tastiera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリで変えた設定がキーボードに反映されません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 바꾼 설정이 키보드에 반영되지 않아요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang saya ubah dalam app tidak sampai ke papan kekunci"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que mudo na app não chega ao teclado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего из того, что я меняю в приложении, не доходит до клавиатуры"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App 里改的设置没有生效"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Midagi, mida ma rakenduses muudan, ei jõua klaviatuurini"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niks wat ek in die toepassing verander, bereik die sleutelbord nie"
