            "state": "translated",
            "value": "Effekte bei Belastung reduzieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducir efectos con mucha carga"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vähenda efekte koormuse all"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire les effets en cas de charge"
          }
        },
        "hu": {
