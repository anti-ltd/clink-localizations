    "Sort clips into groups, then swipe a clip right in the keyboard panel to assign it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiere Clips in Gruppen und wisch einen Clip im Tastaturpanel nach rechts, um ihn zuzuordnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena los clips en grupos y desliza un clip a la derecha en el panel del teclado para asignarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trie tes clips en groupes, puis balaie un clip vers la droite dans le panneau du clavier pour l'assigner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendezd a vágólap-elemeket csoportokba, majd húzz egy elemet jobbra a billentyűzet panelén a hozzárendeléshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordina le clip in gruppi, poi scorri una clip verso destra nel pannello della tastiera per assegnarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップをグループに整理して、キーボードパネルでクリップを右にスワイプすると割り当てられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립을 그룹으로 정리한 다음, 키보드 패널에서 클립을 오른쪽으로 밀어 그룹에 넣으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun klip ke dalam kumpulan, kemudian leret klip ke kanan dalam panel papan kekunci untuk masukkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize os clips em grupos e deslize um clip para a direita no painel do teclado para atribuí-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разложите фрагменты по группам, а затем смахните фрагмент вправо в панели на клавиатуре, чтобы отнести его к группе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把剪贴内容整理到分组中，然后在键盘面板里向右滑动某条即可归类。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorteeri klipid gruppidesse ja viipa seejärel klipid klaviatuuri paneelil paremale, et need määrata."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorteer snitte in groepe en vee dan 'n snit regs in die sleutelbordpaneel om dit toe te wys."
          }
        }
      }
    },
    "Sort saved notes into groups, then swipe a note right in the keyboard panel to assign it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiere gespeicherte Notizen in Gruppen. Wische dann im Tastaturbereich eine Notiz nach rechts, um sie zuzuweisen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza las notas guardadas en grupos y desliza una nota a la derecha en el panel del teclado para asignarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Classe les notes enregistrées en groupes, puis balaie une note vers la droite dans le panneau du clavier pour l’y placer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendezd csoportokba a mentett jegyzeteket, majd a hozzárendeléshez húzd jobbra a jegyzetet a billentyűzet paneljén."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizza le note salvate in gruppi, poi scorri una nota verso destra nel pannello della tastiera per assegnarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みメモをグループに整理し、キーボードパネルでメモを右にスワイプして割り当てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 메모를 그룹으로 정리한 다음 키보드 패널에서 메모를 오른쪽으로 쓸어 그룹에 넣으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun nota tersimpan kepada kumpulan, kemudian leret nota ke kanan dalam panel papan kekunci untuk menetapkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize as notas guardadas em grupos e, no painel do teclado, deslize uma nota para a direita para a atribuir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разложите сохранённые заметки по группам, а затем смахните заметку вправо в панели на клавиатуре, чтобы отнести её к группе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将已存笔记整理到不同组中，然后在键盘面板中向右轻扫笔记即可分组。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorteeri salvestatud märkmed gruppidesse ja viipa seejärel märge klaviatuuri paneelil paremale, et see määrata."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorteer gestoorde notas in groepe, vee dan 'n nota regs in die sleutelbordpaneel om dit toe te wys."
          }
        }
      }
    },
