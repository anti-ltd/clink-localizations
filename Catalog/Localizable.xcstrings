          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzeten nyisd meg az eszközmenüből, és kezdj beszélni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulla tastiera, aprila dal menu strumenti e comincia a parlare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードではツールメニューから開き、話し始めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드에서는 도구 메뉴로 열고 말하기 시작하면 됩니다."
