    "Width of each letter key within its grid cell. Lower values add more space between keys.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite jeder Buchstabentaste in ihrer Gitterzelle. Kleinere Werte lassen mehr Platz zwischen den Tasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancho de cada tecla de letra dentro de su celda. Cuanto más bajo, más espacio deja entre teclas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur de chaque touche de lettre dans sa cellule. Plus la valeur est basse, plus il y a d'espace entre les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy betűbillentyű szélessége a rácscellán belül. Kisebb érték több helyet hagy a billentyűk közt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Larghezza di ogni tasto lettera nella sua cella. Valori più bassi lasciano più spazio tra i tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリッド内での文字キー1つの幅です。小さくするとキーの間隔が広がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "칸 안에서 글자 키가 차지하는 너비예요. 값이 작을수록 키 사이가 더 벌어져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar setiap kekunci huruf dalam sel gridnya. Nilai lebih rendah beri lebih ruang antara kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Largura de cada tecla de letra dentro da sua célula. Valores mais baixos deixam mais espaço entre as teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ширина буквенной клавиши внутри её ячейки. Меньше — больше места между клавишами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个字母键在格子里的宽度。值越小，键之间的空隙越大。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga täheklahvi laius võrgulahtris. Madalamad väärtused lisavad klahvide vahele rohkem ruumi."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Breedte van elke lettersleutel binne sy roostersel. Laer waardes voeg meer spasie tussen sleutels by."
          }
        }
      }
    },
    "Width of the shift and backspace keys relative to a standard letter key.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite der Umschalt- und Rücktaste im Verhältnis zu einer normalen Buchstabentaste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancho de las teclas de mayúsculas y retroceso respecto a una tecla de letra normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur des touches Majuscule et Retour arrière par rapport à une touche de lettre normale."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Shift és a Backspace szélessége egy sima betűbillentyűhöz képest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Larghezza dei tasti Maiuscole e Backspace rispetto a un normale tasto lettera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ふつうの文字キーに対する shift キーと backspace キーの幅です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 글자 키에 견준 Shift 키와 백스페이스 키의 너비예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar kekunci shift dan backspace berbanding kekunci huruf biasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Largura das teclas Shift e Backspace em relação a uma tecla de letra normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ширина клавиш Shift и Backspace относительно обычной буквенной."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 键和退格键的宽度，相对于普通字母键。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõstu- ja backspace-klahvide laius võrreldes tavalise täheklahviga."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Breedte van die shift- en backspace-sleutels relatief tot 'n standaardlettersleutel."
          }
        }
      }
    },
    "Width of the space bar in key units. Narrower leaves room for keys on either side.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite der Leertaste in Tasteneinheiten. Schmaler lässt Platz für Tasten an beiden Seiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancho de la barra espaciadora en unidades de tecla. Más estrecha deja sitio para teclas a los lados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur de la barre d'espace en unités de touche. Plus étroite, ça laisse de la place pour des touches de chaque côté."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szóköz szélessége billentyűegységben. Ha keskenyebb, mindkét oldalon marad hely a billentyűknek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Larghezza della barra spaziatrice in unità di tasto. Più stretta, più spazio per i tasti ai lati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー単位で見たスペースバーの幅です。狭くすると両側にキーを置くスペースができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 바 너비를 키 개수로 나타내요. 좁게 하면 양옆에 키를 둘 자리가 생겨요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar bar ruang dalam unit kekunci. Lebih sempit beri ruang untuk kekunci di kiri kanan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Largura da barra de espaço em unidades de tecla. Mais estreita deixa espaço para teclas de cada lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ширина пробела в клавишах. Уже — остаётся место для клавиш по бокам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空格键的宽度，以键为单位。窄一点，就能给两边的键留出地方。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tühikuklahvi laius klahviühikutes. Kitsam jättab mõlemale poole ruumi klahvidele."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Breedte van die spasiebalk in sleuteleenhede. Smaller laat ruimte vir sleutels aan weerskante."
          }
        }
      }
    },
    "Width of the trail line drawn under your finger while swiping.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite der Spurlinie, die beim Wischen unter deinem Finger gezeichnet wird."
