        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas se juntam de um lado, ao alcance de um polegar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши сдвигаются к одному краю, под один большой палец."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
