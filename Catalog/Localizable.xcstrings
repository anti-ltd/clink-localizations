            "value": "%@ ialah susun atur siap sedia. Buat salinan anda sendiri untuk mengekalkan kekunci pada susun atur ini sahaja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é um esquema integrado. Faz uma cópia tua para manteres teclas só neste esquema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — встроенная раскладка. Сделайте свою копию, чтобы клавиши остались только в ней."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是内置布局。复制一份，就能只在这个布局上留按键了。"
