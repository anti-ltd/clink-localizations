          "stringUnit": {
            "state": "translated",
            "value": "Ingenting driver bak tastene før dette er på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään ei ajaudu näppäinten taakse ennen kuin tämä on päällä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang tertinggal di belakang tombol sampai ini aktif."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì trôi ra sau các phím cho đến khi tính năng này được bật."
          }
        }
      }
    },
    "Nothing else changes. Your layout, tools, stickers and pets stay as they are.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Niks anders verander nie. Jou uitleg, gereedskap, plakkers en troeteldiere bly soos hulle is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonst ändert sich nichts. Layout, Werkzeuge, Sticker und Haustiere bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambia nada más. Tu disposición, herramientas, pegatinas y mascotas se mantienen igual."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muud ei muutu. Paigutus, tööriistad, kleepsud ja lemmikloomad jäävad samaks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d'autre ne change. Votre disposition, vos outils, vos autocollants et vos compagnons restent tels quels."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi más nem változik. Az elrendezés, az eszközök, a matricák és a kisállatok érintetlenek maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non cambia nient'altro. Layout, strumenti, adesivi e animaletti restano come sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかは変わりません。レイアウト、ツール、ステッカー、ペットはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 외에는 바뀌지 않습니다. 레이아웃, 도구, 스티커, 펫은 그대로 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa lagi berubah. Susun atur, alat, pelekat dan peliharaan anda kekal sama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada mais muda. Seu esquema, ferramentas, adesivos e mascotes ficam como estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше ничего не меняется. Раскладка, инструменты, стикеры и питомцы останутся прежними."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他内容不变。你的布局、工具、贴纸和宠物都保持原样。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic altceva nu se schimbă. Aspectul, instrumentele, autocolantele și animalele de companie rămân așa cum sunt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verder verandert er niets. Je lay-out, gereedschappen, stickers en huisdieren blijven zoals ze zijn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他內容不變。你的佈局、工具、貼紙和寵物都保持原樣。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic innego się nie zmienia. Twój układ, narzędzia, naklejki i zwierzęta pozostają bez zmian."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більше нічого не змінюється. Ваш макет, інструменти, наклейки та домашні тварини залишаються такими, як вони є."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka hiçbir şey değişmiyor. Düzeniniz, araçlarınız, çıkartmalarınız ve evcil hayvanlarınız oldukları gibi kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic jiného se nemění. Vaše rozložení, nástroje, nálepky a mazlíčci zůstanou tak, jak jsou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič iné sa nemení. Vaše rozloženie, nástroje, nálepky a domáce zvieratá zostanú tak, ako sú."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα άλλο δεν αλλάζει. Η διάταξη, τα εργαλεία, τα αυτοκόλλητα και τα κατοικίδια σας παραμένουν ως έχουν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget annat förändras. Din layout, verktyg, klistermärken och husdjur förblir som de är."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet andet ændrer sig. Dit layout, værktøjer, klistermærker og kæledyr forbliver, som de er."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting annet endres. Din layout, verktøy, klistremerker og kjæledyr forblir som de er."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään muu ei muutu. Asettelusi, työkalusi, tarrasi ja lemmikkisi pysyvät sellaisina kuin ne ovat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada hal lain yang berubah. Tata letak, peralatan, stiker, dan hewan peliharaan Anda tetap apa adanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì khác thay đổi. Bố cục, công cụ, nhãn dán và thú cưng của bạn vẫn giữ nguyên như cũ."
          }
        }
      }
    },
    "Nothing here is uploaded, and turning it off deletes what it collected.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Niks hier word opgelaai nie, en as jy dit afskakel, word dit wat dit ingesamel is, uitgevee."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts davon wird hochgeladen, und wenn du es ausschaltest, wird das Gesammelte gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de esto se sube a ningún sitio, y al desactivarlo se borra lo recogido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Midagi siit ei laadita üles ja selle väljalülitamine kustutab kogutu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est envoyé nulle part, et le désactiver supprime ce qui a été collecté."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi nem töltődik fel sehová, és ha kikapcsolod, az összegyűjtött adat törlődik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente di tutto questo viene caricato da qualche parte, e disattivarlo cancella ciò che è stato raccolto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらがどこかに送信されることはなく、オフにすると集めたデータは削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 내용은 어디에도 업로드되지 않으며, 끄면 모아 둔 데이터도 삭제됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa di sini dimuat naik, dan mematikannya akan memadam data yang dikumpul."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada disto é enviado para lado nenhum, e desligá-lo apaga o que foi recolhido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсюда ничего не загружается, а при выключении собранное удаляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些都不会上传，关掉它还会把已收集的数据一并删除。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic aici nu este încărcat, iar dezactivarea acestuia șterge ceea ce a colectat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt hier niets geüpload en als u dit uitschakelt, wordt verwijderd wat er is verzameld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些都不會上傳，關掉它還會把已收集的資料一併刪除。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic tutaj nie jest przesyłane, a wyłączenie tej opcji powoduje usunięcie zebranych informacji."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сюди нічого не завантажується, а вимикання видаляє те, що було зібрано."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buraya hiçbir şey yüklenmez ve kapatıldığında toplananlar silinir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem se nic nenahrává a jeho vypnutím se smaže to, co bylo shromážděno."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič sa tu neodovzdáva a jeho vypnutím sa vymaže to, čo zhromaždilo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μεταφορτώνεται τίποτα εδώ και η απενεργοποίησή του διαγράφει ό,τι έχει συλλέξει."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget här laddas upp, och om du stänger av det raderas det som samlats in."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet her uploades, og at slå det fra sletter det indsamlede."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting her lastes opp, og hvis du slår det av, slettes det det har samlet inn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään tänne ei ladata, ja sen poistaminen käytöstä poistaa sen keräämät tiedot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada apa pun di sini yang diunggah, dan mematikannya akan menghapus apa yang dikumpulkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì ở đây được tải lên và việc tắt nó sẽ xóa những gì nó đã thu thập."
          }
        }
      }
    },
    "Nothing here yet. Pick emoji below and they land in this set, in the order you tap them.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niks hier nie. Kies emoji hieronder en hulle land in hierdie stel, in die volgorde waarin jy daarop tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts drin. Wähl unten Emojis aus – sie landen in der Reihenfolge im Set, in der du sie antippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí todavía no hay nada. Elige emoji abajo y se van al conjunto en el orden en que los toques."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Siin pole veel midagi. Vali all emojisid ja need maanduvad sellesse komplekti selles järjekorras, nagu neid puudutad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l'instant. Choisis des emoji en dessous : ils rejoignent le set dans l'ordre où tu les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt még nincs semmi. Válassz lentről emojikat – abban a sorrendben kerülnek a készletbe, ahogy megérinted őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non c'è ancora niente. Scegli le emoji qui sotto: entrano nel set nell'ordine in cui le tocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ空です。下から絵文字を選ぶと、タップした順にこのセットへ入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 비어 있어요. 아래에서 이모지를 고르면 누른 순서대로 이 세트에 들어가요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada apa-apa. Pilih emoji di bawah dan ia masuk ke set ini mengikut susunan anda ketik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nada aqui. Escolhe emoji abaixo e entram no conjunto pela ordem em que lhes tocas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока пусто. Выбирайте эмодзи ниже — они попадут в этот набор в том порядке, в котором вы их нажмёте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里还是空的。在下面挑表情，按你点的顺序加进这个合集。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic aici încă. Alegeți emoji de mai jos și vor ajunge în acest set, în ordinea în care le atingeți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier nog niets. Kies hieronder emoji en ze landen in deze set, in de volgorde waarin je erop tikt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡還是空的。在下面挑表情，按你點的順序加進這個合集。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nic tu nie ma. Wybierz emoji poniżej, a wylądują w tym zestawie, w kolejności, w jakiej je dotykasz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут ще нічого немає. Виберіть смайли нижче, і вони потраплять у цей набір у тому порядку, у якому ви їх натискаєте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada henüz bir şey yok. Aşağıdan emojiyi seçtiğinizde, onlara dokunma sıranıza göre bu sete yerleşirler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tady zatím nic. Vyberte emotikony níže a přistanou v této sadě v pořadí, v jakém na ně klepnete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ tu nič nie je. Vyberte si emotikony nižšie a pristanú v tejto súprave v poradí, v akom na ne klepnete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα εδώ ακόμα. Επιλέξτε emoji παρακάτω και προσγειώνονται σε αυτό το σετ, με τη σειρά που θα τα πατήσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget här ännu. Välj emoji nedan och de landar i den här uppsättningen, i den ordning du trycker på dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet her endnu. Vælg emoji nedenfor, og de lander i dette sæt, i den rækkefølge, du trykker på dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting her ennå. Velg emoji nedenfor, og de lander i dette settet, i den rekkefølgen du trykker på dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei täällä vielä mitään. Valitse alta emoji, niin ne päätyvät tähän sarjaan siinä järjestyksessä, jossa napautat niitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada apa pun di sini. Pilih emoji di bawah dan emoji tersebut akan muncul di kumpulan ini, sesuai urutan Anda mengetuknya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì ở đây. Chọn biểu tượng cảm xúc bên dưới và chúng sẽ xuất hiện trong bộ này, theo thứ tự bạn nhấn vào chúng."
          }
        }
      }
    },
    "Nothing in that backup could be restored.": {
