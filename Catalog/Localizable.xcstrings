    "Recent copied text. Tap a chip to paste. Needs Full Access.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onlangse gekopieerde teks. Tik 'n skyfie om te plak. Benodig volle toegang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kürzlich kopierter Text. Tippe einen Chip zum Einfügen. Voller Zugriff nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto copiado reciente. Toca un chip para pegar. Necesita Acceso total."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiljuti kopeeritud tekst. Puuduta kiipi kleepimiseks. Vajab täisjuurdepääsu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte copié récent. Touchez une puce pour coller. Accès complet requis."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemrég másolt szöveg. Koppints a chipre a beillesztéshez. Teljes hozzáférés kell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo copiato di recente. Tocca un chip per incollare. Serve Accesso completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近コピーしたテキスト。チップをタップで貼り付け。フルアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 복사한 텍스트. 칩을 탭하면 붙여넣습니다. 전체 접근 필요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks disalin terkini. Ketik cip untuk tampal. Perlukan Akses Penuh."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto copiado recente. Toca um chip para colar. Precisa de Acesso total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недавно скопированный текст. Коснитесь чипа, чтобы вставить. Требуется полный доступ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近复制的文字。点碎片即可粘贴。需要完全访问权限。"
          }
        }
      }
    },
