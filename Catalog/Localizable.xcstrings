    "Smoothing tidies the traced outline. Keep it low to hold on to the wobble of your own hand.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El suavizado ordena el contorno trazado. Mantenlo bajo para conservar el temblor de tu propia mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lissage régularise le contour. Garde une valeur faible pour préserver les irrégularités naturelles de ton tracé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Glättung räumt die erzeugte Kontur auf. Niedrig halten, um das Zittern deiner Hand zu bewahren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ammorbidimento ripulisce il contorno ricavato. Tienilo basso per conservare il tremolio della tua mano."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A suavização limpa o contorno traçado. Mantenha-a baixa para preservar o tremor da sua própria mão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сглаживание упорядочивает полученный контур. Оставьте его слабым, чтобы сохранить дрожь вашей руки."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelicinan mengemas garis luar yang dihasilkan. Kekalkan rendah untuk mengekalkan getaran tangan anda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A simítás rendezi a kapott körvonalat. Tartsd alacsonyan, hogy megmaradjon a saját kezed remegése."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スムージングは生成された輪郭を整えます。手の揺らぎを残したいときは低めにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑会整理描摹出的轮廓。想保留手绘的自然抖动就调低一些。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다듬기는 추출된 윤곽을 정리합니다. 손의 떨림을 남기려면 낮게 유지하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Silumine korrastab saadud kontuuri. Hoia see madal, et säilitada oma käe värin."
          }
        }
      }
    },
