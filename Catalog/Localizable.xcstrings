    "Sharp, springy click with a crisp tail.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skerp, veerkragtig klik met 'n skerp stert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scharfer, federnder Klick mit klarem Ausklang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic agudo y elástico con un final nítido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Terav, vedrust klõps puhta sabaga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic vif et rebondissant, avec une fin nette."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Éles, ruganyos kattanás tiszta lecsengéssel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic secco ed elastico con una coda nitida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鋭く弾む、キレのあるクリック音。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날카롭고 통통 튀며 끝이 또렷한 클릭 소리."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik tajam dan anjal dengan hujung yang jelas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique agudo e elástico com final nítido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резкий упругий клик с чётким хвостом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
