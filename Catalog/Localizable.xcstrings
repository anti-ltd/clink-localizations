    "Full Access is optional. Clink works offline and your keystrokes never leave your phone.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Volledige toegang is opsioneel. Clink werk vanlyn en jou toetsaanslagen verlaat nooit jou foon nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollzugriff ist optional. Clink funktioniert offline und deine Tastenanschläge verlassen nie dein iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso total es opcional. Clink funciona sin conexión y tus pulsaciones nunca salen de tu iPhone."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Täisjuurdepääs on valikuline. Clink töötab ühenduseta ja sinu klahvivajutused ei lahku kunagi telefonist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès complet est facultatif. Clink fonctionne hors ligne et tes frappes ne quittent jamais ton iPhone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Teljes hozzáférés nem kötelező. A Clink offline működik, és a leütéseid sosem hagyják el az iPhone-odat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso completo è facoltativo. Clink funziona offline e ciò che digiti non lascia mai il tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルアクセスは任意です。Clinkはオフラインで動作し、キー入力がiPhoneの外に出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 접근 허용은 선택 사항이에요. Clink는 오프라인으로 작동하며 키 입력은 iPhone 밖으로 나가지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses Penuh tidak wajib. Clink berfungsi di luar talian dan ketukan kekunci tidak pernah keluar daripada iPhone anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso total é opcional. O Clink funciona offline e o que escreves nunca sai do teu iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный доступ необязателен. Clink работает офлайн, и ваши нажатия никогда не покидают телефон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全访问是可选的。Clink 可离线运行，你的按键内容绝不会离开 iPhone。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul complet este opțional. Clink funcționează offline, iar apăsările de taste nu părăsesc telefonul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volledige toegang is optioneel. Clink werkt offline en uw toetsaanslagen verlaten uw telefoon nooit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完整取用是可選的。Clink 可離線執行，你的按鍵內容絕不會離開 iPhone。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełny dostęp jest opcjonalny. Clink działa w trybie offline, a naciśnięcia klawiszy nigdy nie opuszczają telefonu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повний доступ необов’язковий. Clink працює в автономному режимі, і ваші натискання клавіш ніколи не залишають ваш телефон."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam Erişim isteğe bağlıdır. Clink çevrimdışı çalışır ve tuş vuruşlarınız asla telefonunuzdan ayrılmaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plný přístup je volitelný. Clink funguje offline a vaše stisknuté klávesy nikdy neopustí váš telefon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Úplný prístup je voliteľný. Clink funguje offline a vaše stlačenia kláves nikdy neopustia váš telefón."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πλήρης πρόσβαση είναι προαιρετική. Το Clink λειτουργεί εκτός σύνδεσης και τα πλήκτρα σας δεν φεύγουν ποτέ από το τηλέφωνό σας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Full åtkomst är valfritt. Clink fungerar offline och dina tangenttryckningar lämnar aldrig din telefon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuld adgang er valgfri. Clink fungerer offline, og dine tastetryk forlader aldrig din telefon."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Full tilgang er valgfritt. Clink fungerer offline og tastetrykkene dine forlater aldri telefonen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täysi käyttöoikeus on valinnainen. Clink toimii offline-tilassa ja näppäinpainallukset eivät koskaan poistu puhelimestasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses Penuh adalah opsional. Clink bekerja offline dan penekanan tombol Anda tidak pernah lepas dari ponsel Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toàn quyền truy cập là tùy chọn. Clink hoạt động ngoại tuyến và thao tác nhấn phím của bạn sẽ không bao giờ rời khỏi điện thoại."
          }
        }
      }
    },
