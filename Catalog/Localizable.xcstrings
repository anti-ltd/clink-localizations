    "Plugins run as you type and can change what the keyboard shows. Only allow repositories you trust.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins laufen, während du tippst, und können ändern, was die Tastatur anzeigt. Erlaube nur Repositorys, denen du vertraust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los plugins se ejecutan mientras escribes y pueden cambiar lo que muestra el teclado. Permite solo repositorios en los que confíes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pistikprogrammid töötavad tippimise ajal ja võivad muuta seda, mida klaviatuur näitab. Luba ainult hoidlaid, mida usaldad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plugins s’exécutent pendant que tu tapes et peuvent modifier l’affichage du clavier. N’autorise que les dépôts auxquels tu fais confiance."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bővítmények gépelés közben futnak, és megváltoztathatják, amit a billentyűzet mutat. Csak megbízható tárolókat engedélyezz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I plugin girano mentre scrivi e possono cambiare ciò che la tastiera mostra. Consenti solo i repository di cui ti fidi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインは入力中に動作し、キーボードの表示を変えられます。信頼できるリポジトリだけを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인은 입력하는 동안 실행되며 키보드에 보이는 내용을 바꿀 수 있습니다. 신뢰하는 저장소만 허용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugin berjalan semasa anda menaip dan boleh mengubah apa yang dipaparkan papan kekunci. Benarkan hanya repositori yang anda percayai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os plugins correm enquanto escreve e podem mudar o que o teclado mostra. Permita apenas repositórios em que confia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плагины работают во время набора и могут менять то, что показывает клавиатура. Разрешайте только репозитории, которым доверяете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插件在你输入时运行，还能改变键盘显示的内容。只允许你信任的仓库。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pluginurile rulează pe măsură ce tastați și pot schimba ceea ce arată tastatura. Permiteți numai depozitele în care aveți încredere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plug-ins worden uitgevoerd terwijl u typt en kunnen wijzigen wat het toetsenbord toont. Sta alleen opslagplaatsen toe die u vertrouwt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外掛在你輸入時執行，還能改變鍵盤顯示的內容。只允許你信任的倉庫。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Inproppe loop terwyl jy tik en kan verander wat die sleutelbord wys. Laat slegs bewaarplekke toe wat jy vertrou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wtyczki działają podczas pisania i mogą zmieniać to, co wyświetla klawiatura. Zezwalaj tylko na repozytoria, którym ufasz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плагіни запускаються під час введення тексту та можуть змінювати те, що відображається на клавіатурі. Дозволяйте лише ті сховища, яким ви довіряєте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklentiler siz yazdıkça çalışır ve klavyenin gösterdiği şeyi değiştirebilir. Yalnızca güvendiğiniz depolara izin verin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pluginy se spouštějí při psaní a mohou měnit to, co klávesnice zobrazuje. Povolte pouze úložiště, kterým důvěřujete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zásuvné moduly sa spúšťajú počas písania a môžu zmeniť to, čo zobrazuje klávesnica. Povoľte iba úložiská, ktorým dôverujete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προσθήκες εκτελούνται καθώς πληκτρολογείτε και μπορούν να αλλάξουν αυτό που δείχνει το πληκτρολόγιο. Επιτρέψτε μόνο τα αποθετήρια που εμπιστεύεστε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins körs medan du skriver och kan ändra vad tangentbordet visar. Tillåt endast arkiv som du litar på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins kører, mens du skriver og kan ændre, hvad tastaturet viser. Tillad kun depoter, du har tillid til."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins kjører mens du skriver og kan endre hva tastaturet viser. Tillat bare depoter du stoler på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laajennukset toimivat kirjoittaessasi ja voivat muuttaa näppäimistön näyttöä. Salli vain arkistot, joihin luotat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugin berjalan saat Anda mengetik dan dapat mengubah tampilan keyboard. Hanya izinkan repositori yang Anda percayai."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các plugin chạy khi bạn nhập và có thể thay đổi nội dung bàn phím hiển thị. Chỉ cho phép các kho lưu trữ mà bạn tin tưởng."
          }
        }
      }
    },
