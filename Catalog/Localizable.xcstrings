    "Dvorak, Colemak and the non-Latin arrangements are in the same list.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dvorak, Colemak en die nie-Latynse verwerkings is in dieselfde lys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvorak, Colemak und die nicht-lateinischen Anordnungen stehen in derselben Liste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvorak, Colemak y las distribuciones no latinas están en la misma lista."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvorak, Colemak ja mitte-Ladina paigutused asuvad samas loendis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvorak, Colemak et les agencements non latins sont dans la même liste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Dvorak, a Colemak és a nem latin kiosztások ugyanabban a listában vannak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvorak, Colemak e le disposizioni non latine sono nello stesso elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvorak、Colemak、非ラテン文字の配列も同じ一覧にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvorak과 Colemak, 라틴 문자가 아닌 배열도 같은 목록에 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvorak, Colemak dan susunan bukan Latin ada dalam senarai yang sama."
          }
        },
        "pt": {
