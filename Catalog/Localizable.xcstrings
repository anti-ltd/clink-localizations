          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지구본 키를 눌러 Clink까지 넘어갑니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kekunci glob sehingga sampai ke Clink."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca na tecla do globo até chegares ao Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажимайте клавишу глобуса, пока не дойдёте до Clink."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点地球键，切换到 Clink。"
          }
        }
      }
    },
    "Tap the language button at the end of the suggestion bar for the next language, or hold it to pick one.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik die taalknoppie aan die einde van die voorstelbalk vir die volgende taal, of hou dit vas om een ​​te kies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe die Sprachtaste am Ende der Vorschlagsleiste für die nächste Sprache an, oder halte sie, um eine auszuwählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de idioma al final de la barra de sugerencias para pasar al siguiente idioma, o manténlo pulsado para elegir uno."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta soovituseriba lõpus keeleklahvile järgmise keele jaoks või hoia teda, et üks valida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche le bouton de langue au bout de la barre de suggestions pour la langue suivante, ou maintiens-le pour en choisir une."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a javaslatsáv végén lévő nyelvgombra a következő nyelvhez, vagy tartsd nyomva, és válassz a listából."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante lingua in fondo alla barra dei suggerimenti per passare alla lingua successiva, oppure tienilo premuto per sceglierne una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補バーの端にある言語ボタンをタップすると次の言語に、長押しすると一覧から選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천 바 끝의 언어 버튼을 누르면 다음 언어로, 길게 누르면 목록에서 고를 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik butang bahasa di hujung bar cadangan untuk bahasa seterusnya, atau tahan untuk memilih satu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca no botão de idioma no fim da barra de sugestões para passares ao idioma seguinte, ou mantém premido para escolheres um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку языка в конце строки подсказок, чтобы перейти к следующему языку, или удержите её, чтобы выбрать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点候选栏末尾的语言按钮切到下一个语言，长按则从列表里挑。"
          }
        }
      }
    },
    "Tap the mic and talk.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik die mikrofoon en praat."
          }
