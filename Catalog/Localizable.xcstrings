    "Couldn't confirm it's you, so the contents stayed hidden.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kon nie bevestig dat dit jy is nie, so die inhoud het versteek gebly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten nicht bestätigen, dass du es bist – der Inhalt bleibt verborgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido confirmar que eres tú, así que el contenido sigue oculto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei saanud kinnitada, et see oled sina, seega sisu jäi peidetud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de confirmer que c’est bien toi : le contenu est resté masqué."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült igazolni, hogy te vagy az, ezért a tartalom rejtve maradt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile confermare che sei tu, quindi il contenuto è rimasto nascosto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人であることを確認できなかったため、内容は表示していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인 확인에 실패해 내용을 표시하지 않았습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengesahkan bahawa ini anda, jadi kandungannya kekal tersembunyi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar que és tu, por isso o conteúdo ficou oculto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить, что это вы, поэтому содержимое осталось скрытым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认是你本人，内容已保持隐藏。"
          }
        }
      }
    },
