    "Show this key beside the space bar on every layout, presets included. Set it up once instead of adding it to each layout.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wys hierdie sleutel langs die spasiebalk op elke uitleg, voorafinstellings ingesluit. Stel dit een keer op in plaas daarvan om dit by elke uitleg te voeg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt diese Taste in jedem Layout neben der Leertaste, auch in den Voreinstellungen. Einmal einrichten, statt sie zu jedem Layout hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra esta tecla junto a la barra espaciadora en todas las disposiciones, preajustes incluidos. Configúrala una vez en lugar de añadirla a cada disposición."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva seda klahvi tühikuklahvi kõrval igas paigutuses, eelseadistused kaasa arvatud. Seadista see üks kord, selle asemel et igasse paigutusse lisada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche cette touche à côté de la barre d'espace sur toutes les dispositions, préréglages compris. Configure-la une fois au lieu de l'ajouter à chaque disposition."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelenítsd meg ezt a billentyűt a szóköz mellett minden elrendezésen, az előbeállításokat is beleértve. Állítsd be egyszer, ahelyett, hogy minden elrendezéshez hozzáadnád."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra questo tasto accanto alla barra spaziatrice in ogni layout, preset compresi. Impostalo una volta invece di aggiungerlo a ogni layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーを、プリセットを含むすべてのレイアウトでスペースバーの横に表示します。レイアウトごとに追加せず、一度だけ設定すれば済みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 레이아웃에서 스페이스 바 옆에 이 키를 보여줘요, 프리셋 포함이에요. 레이아웃마다 넣는 대신 한 번만 설정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjuk kekunci ini di sebelah bar ruang pada setiap susun atur, termasuk praset. Sediakan sekali sahaja, bukannya menambahnya pada setiap susun atur."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra esta tecla ao lado da barra de espaços em todos os esquemas, predefinições incluídas. Configura uma vez em vez de a adicionar a cada esquema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать эту клавишу рядом с пробелом во всех раскладках, включая пресеты. Настраивается один раз вместо добавления в каждую раскладку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每个布局的空格键旁边都显示这个键，包括预设。设一次就行，不用往每个布局里都加。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișați această tastă lângă bara de spațiu pe fiecare aspect, inclusiv presetări. Configurați-l o dată în loc să îl adăugați la fiecare aspect."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon deze sleutel naast de spatiebalk in elke lay-out, inclusief voorinstellingen. Stel het één keer in in plaats van het aan elke lay-out toe te voegen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每個佈局的空格鍵旁邊都顯示這個鍵，包括預設。設一次就行，不用往每個佈局裡都加。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż ten klawisz obok spacji w każdym układzie, łącznie z ustawieniami wstępnymi. Skonfiguruj go raz, zamiast dodawać go do każdego układu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати цю клавішу поруч із пробілом на кожній розкладці, включно зі стилями. Налаштуйте його один раз замість того, щоб додавати до кожного макета."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tuşu, ön ayarlar dahil her düzende boşluk çubuğunun yanında gösterin. Her düzene eklemek yerine bir kez ayarlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukažte tuto klávesu vedle mezerníku na každém rozvržení, včetně předvoleb. Nastavte jej jednou místo přidávání do každého rozvržení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukážte tento kláves vedľa medzerníka na každom rozložení vrátane predvolieb. Namiesto pridávania do každého rozloženia ho nastavte raz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση αυτού του πλήκτρου δίπλα στη γραμμή διαστήματος σε κάθε διάταξη, συμπεριλαμβανομένης της προεπιλογής. Ρυθμίστε το μία φορά αντί να το προσθέσετε σε κάθε διάταξη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa denna tangent bredvid mellanslagstangenten på varje layout, inklusive förinställningar. Ställ in den en gång istället för att lägga till den i varje layout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis denne tast ved siden af mellemrumstasten på hvert layout, forudindstillinger inkluderet. Sæt det op én gang i stedet for at tilføje det til hvert layout."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis denne tasten ved siden av mellomromstasten på hver layout, inkludert forhåndsinnstillinger. Sett den opp én gang i stedet for å legge den til hver layout."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä tämä näppäin välilyöntinäppäimen vieressä kaikissa asetteluissa, esiasetukset mukaan lukien. Määritä se kerran sen sijaan, että lisäisit sen jokaiseen asetteluun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan tombol ini di samping bilah spasi di setiap tata letak, termasuk preset. Atur sekali alih-alih menambahkannya ke setiap tata letak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị phím này bên cạnh thanh dấu cách trên mọi bố cục, bao gồm cả các cài đặt trước. Thiết lập nó một lần thay vì thêm nó vào từng bố cục."
          }
        }
      }
    },
