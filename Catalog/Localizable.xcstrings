    "Edit this layout right in the preview above. Tap a key to change it, drag keys to rearrange, and use the + buttons to add keys and rows.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysig hierdie uitleg reg in die voorskou hierbo. Tik 'n sleutel om dit te verander, sleep sleutels om te herrangskik, en gebruik die +-knoppies om sleutels en rye by te voeg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeite dieses Layout direkt in der Vorschau oben. Tipp auf eine Taste, um sie zu ändern, zieh Tasten zum Umsortieren und nimm die +-Tasten, um Tasten und Reihen hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita este diseño aquí mismo, en la vista previa de arriba. Toca una tecla para cambiarla, arrastra las teclas para reordenarlas y usa los botones + para añadir teclas y filas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuda seda paigutust otse ülalolevas eelvaates. Puuduta klahvi selle muutmiseks, lohista klahve ümberkorraldamiseks ja kasuta + nuppe klahvide ning ridade lisamiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie cette disposition directement dans l'aperçu au-dessus. Touche une touche pour la changer, fais glisser les touches pour les réorganiser, et sers-toi des boutons + pour ajouter des touches et des rangées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szerkeszd ezt az elrendezést egyből a fenti előnézetben. Koppints egy billentyűre, hogy megváltoztasd, húzd a billentyűket az átrendezéshez, a + gombokkal pedig új billentyűt és sort adhatsz hozzá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica questo layout direttamente nell'anteprima qui sopra. Tocca un tasto per cambiarlo, trascina i tasti per spostarli e usa i pulsanti + per aggiungere tasti e righe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレイアウトは上のプレビューでそのまま編集できます。キーをタップして変更し、ドラッグして並べ替え、+ ボタンでキーや行を追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 미리보기에서 바로 이 레이아웃을 편집하세요. 키를 탭해서 바꾸고, 드래그해서 옮기고, + 버튼으로 키와 줄을 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunting susun atur ini terus dalam pratonton di atas. Ketik kekunci untuk ubah, seret kekunci untuk susun semula, dan guna butang + untuk tambah kekunci dan baris."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita este esquema já aqui na pré-visualização acima. Toca numa tecla para a mudar, arrasta as teclas para as reorganizar e usa os botões + para acrescentar teclas e linhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правьте эту раскладку прямо в предпросмотре выше. Нажмите на клавишу, чтобы её изменить, перетаскивайте клавиши, чтобы поменять порядок, а кнопками + добавляйте клавиши и ряды."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接在上面的预览里改这个布局。点一个键就能改，拖动按键能重新排，用 + 按钮加键、加行。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Editați acest aspect chiar în previzualizarea de mai sus. Atingeți o tastă pentru a o modifica, trageți tastele pentru a rearanja și utilizați butoanele + pentru a adăuga chei și rânduri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerk deze lay-out rechtstreeks in het bovenstaande voorbeeld. Tik op een toets om deze te wijzigen, sleep de toetsen om ze opnieuw te rangschikken en gebruik de knoppen + om toetsen en rijen toe te voegen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接在上面的預覽裡改這個佈局。點一個鍵就能改，拖動按鍵能重新排，用 + 按鈕加鍵、加行。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytuj ten układ bezpośrednio w podglądzie powyżej. Stuknij klawisz, aby go zmienić, przeciągnij klawisze, aby zmienić ich rozmieszczenie, i użyj przycisków +, aby dodać klawisze i wiersze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відредагуйте цей макет безпосередньо в попередньому перегляді вище. Торкніться клавіші, щоб змінити її, перетягніть клавіші, щоб змінити порядок, і використовуйте кнопки +, щоб додати клавіші та рядки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu düzeni doğrudan yukarıdaki önizlemede düzenleyin. Değiştirmek için bir tuşa dokunun, yeniden düzenlemek için tuşları sürükleyin ve tuşlar ve satırlar eklemek için + düğmelerini kullanın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravte toto rozložení přímo v náhledu výše. Klepnutím na klávesu ji změníte, přetažením kláves změníte jejich uspořádání a pomocí tlačítek + přidáte klávesy a řádky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravte toto rozloženie priamo v ukážke vyššie. Klepnutím na kláves ho zmeníte, potiahnutím kláves zmeníte usporiadanie a pomocou tlačidiel + pridáte klávesy a riadky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επεξεργαστείτε αυτήν τη διάταξη απευθείας στην παραπάνω προεπισκόπηση. Πατήστε ένα πλήκτρο για να το αλλάξετε, σύρετε τα πλήκτρα για αναδιάταξη και χρησιμοποιήστε τα κουμπιά + για να προσθέσετε κλειδιά και σειρές."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigera denna layout direkt i förhandsvisningen ovan. Tryck på en tangent för att ändra den, dra nycklar för att ordna om och använd +-knapparna för att lägga till nycklar och rader."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger dette layout direkte i forhåndsvisningen ovenfor. Tryk på en tast for at ændre den, træk tasterne for at omarrangere, og brug + knapperne til at tilføje taster og rækker."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger dette oppsettet rett i forhåndsvisningen ovenfor. Trykk på en tast for å endre den, dra tastene for å omorganisere, og bruk +-knappene for å legge til taster og rader."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muokkaa tätä asettelua suoraan yllä olevassa esikatselussa. Muuta näppäintä napauttamalla sitä, järjestä näppäimiä uudelleen vetämällä ja lisää näppäimiä ja rivejä käyttämällä + -painikkeita."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit tata letak ini tepat di pratinjau di atas. Ketuk tombol untuk mengubahnya, seret tombol untuk mengatur ulang, dan gunakan tombol + untuk menambahkan tombol dan baris."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉnh sửa bố cục này ngay trong bản xem trước ở trên. Nhấn vào một phím để thay đổi, kéo các phím để sắp xếp lại và sử dụng các nút + để thêm phím và hàng."
          }
        }
      }
    },
