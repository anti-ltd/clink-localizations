    "Hit space and Clink applies its best guess. Text shortcuts always win. Tap the bar to undo.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik spasie en Clink pas sy beste raaiskoot toe. Tekskortpaaie wen altyd. Tik die balk om te ontdoen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück die Leertaste und Clink wendet seine beste Vermutung an. Textkürzel gewinnen immer. Tipp auf die Leiste zum Rückgängigmachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa espacio y Clink aplica su mejor conjetura. Los atajos de texto siempre ganan. Toca la barra para deshacer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajuta tühikut ja Clink rakendab oma parima pakkumise. Teksti otseteed võidavad alati. Puuduta riba, et tagasi võtta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur espace et Clink applique sa meilleure proposition. Les raccourcis de texte l'emportent toujours. Touche la barre pour annuler."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomj szóközt, és a Clink alkalmazza a legjobb tippjét. A szövegrövidítések mindig nyernek. Koppints a sávra a visszavonáshoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi spazio e Clink applica la sua ipotesi migliore. Le scorciatoie di testo vincono sempre. Tocca la barra per annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースを押すと、Clink がいちばんの予測を適用します。テキストショートカットが常に優先されます。バーをタップすると取り消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스를 누르면 Clink가 가장 그럴듯한 추측을 적용해요. 텍스트 단축어가 항상 우선이에요. 바를 탭하면 되돌려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan ruang dan Clink guna tekaan terbaiknya. Pintasan teks sentiasa menang. Ketik bar untuk buat asal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega no espaço e o Clink aplica o seu melhor palpite. Os atalhos de texto ganham sempre. Toca na barra para desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите пробел — и Clink применит лучший вариант. Сокращения текста всегда в приоритете. Нажмите на строку, чтобы отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按空格，Clink 就用它最好的猜测。文本快捷替换总是优先。点候选栏可以撤销。"
          }
        }
      }
    },
