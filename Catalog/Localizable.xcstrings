    "No trail, no ripple. Cleanest.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen spoor, geen rimpeling. Skoonste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Spur, keine Welle. Am aufgeräumtesten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin estela, sin onda. El más limpio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jälge pole, laineid pole. Puhtaim."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune traînée, aucune ondulation. Le plus net."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs nyom, nincs hullám. A legtisztább."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna scia, nessuna onda. Il più pulito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軌跡なし、波紋なし。いちばんすっきり。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔상도 물결도 없어요. 가장 깔끔해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada jejak, tiada riak. Paling bersih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem rasto, sem ondulação. O mais limpo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без следа и без волны. Самый чистый вариант."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无拖尾、无涟漪。最干净。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără urmă, fără undă. Cel mai curat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen spoor, geen rimpel. Schoonste."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無拖尾、無漣漪。最乾淨。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadnego śladu, żadnych fal. Najczystszy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ні сліду, ні хвилі. Найчистіший."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İz yok, dalgalanma yok. En temiz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádná stopa, žádné vlnění. Nejčistší."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadna stopa, žiadne vlnenie. Najčistejšie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς ίχνος, χωρίς κυματισμό. Πιο καθαρό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget spår, ingen krusning. Renaste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen spor, ingen krusning. Reneste."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen sti, ingen krusning. Reneste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei polkua, ei aaltoilua. Puhtain."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada jejak, tidak ada riak. Terbersih."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có dấu vết, không có gợn sóng. Sạch sẽ nhất."
