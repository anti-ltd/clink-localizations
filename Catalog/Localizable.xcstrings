    "Corner radius of each key. 0 is square, higher values make rounder caps.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoek radius van elke sleutel. 0 is vierkantig, hoër waardes maak ronder pette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eckenradius jeder Taste. 0 ist eckig, höhere Werte machen die Tasten runder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Radio de las esquinas de cada tecla. 0 es cuadrado, cuanto más alto, más redondas quedan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga klahvi nurgaraadius. 0 on kandiline, suuremad väärtused teevad katted ümaramaks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rayon des coins de chaque touche. 0 pour du carré, plus la valeur monte plus les touches sont arrondies."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyes billentyűk sarkának lekerekítése. A 0 szögletes, a nagyobb érték kerekebb billentyűket ad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggio degli angoli di ogni tasto. 0 è quadrato, valori più alti li rendono più arrotondati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーの角の丸みです。0だと四角、大きくするほどキャップが丸くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 키의 모서리 둥글기예요. 0은 각지고, 값이 클수록 키캡이 더 둥글어져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejari sudut setiap kekunci. 0 buat segi empat, nilai lebih tinggi buat penutup lebih bulat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Raio dos cantos de cada tecla. 0 é quadrado, valores mais altos deixam as teclas mais redondas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Радиус скругления клавиши. 0 — квадратные, чем больше, тем круглее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个按键的圆角大小。0 是方角，数值越大键帽越圆。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Raza colțului fiecărei taste. 0 este pătrat, valorile mai mari fac majuscule mai rotunjite."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoekradius van elke sleutel. 0 is vierkant, hogere waarden zorgen voor rondere hoofdletters."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個按鍵的圓角大小。0 是方角，數值越大鍵帽越圓。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Promień narożnika każdego klawisza.0 jest kwadratowe, wyższe wartości powodują, że czapki są zaokrąglone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Радіус кута кожної клавіші. 0 — це квадрат, більші значення роблять шапки круглішими."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her tuşun köşe yarıçapı. 0 karedir, daha yüksek değerler daha yuvarlak büyük harfler oluşturur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poloměr rohu každého klíče. 0 je čtverec, vyšší hodnoty znamenají kulatější čepice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Polomer rohu každého kľúča. 0 je štvorec, vyššie hodnoty spôsobujú okrúhlejšie čiapočky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γωνιακή ακτίνα κάθε κλειδιού. Το 0 είναι τετράγωνο, οι υψηλότερες τιμές κάνουν πιο στρογγυλά καπάκια."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hörnradien för varje nyckel. 0 är fyrkantig, högre värden ger rundare kepsar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjørneradius for hver nøgle. 0 er firkantet, højere værdier giver rundere hætter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjørneradius for hver nøkkel. 0 er kvadratisk, høyere verdier gir rundere caps."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisen avaimen kulman säde. 0 on neliö, suuremmat arvot tekevät pyöreämmistä korkista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jari-jari sudut setiap tuts. 0 berbentuk persegi, nilai yang lebih tinggi membuat topi menjadi bulat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bán kính góc của mỗi phím. 0 là hình vuông, giá trị cao hơn làm cho mũ tròn hơn."
          }
        }
      }
    },
