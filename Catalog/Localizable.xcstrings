    "Open the Search tab and enter the setting or feature you want.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne den Tab Suchen und gib die gewünschte Einstellung oder Funktion ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la pestaña Buscar e introduce el ajuste o la función que quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava vahekaart „Otsi” ja sisesta soovitud seade või funktsioon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l’onglet Rechercher et saisis le réglage ou la fonction que tu cherches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Keresés lapot, és írd be a keresett beállítást vagy funkciót."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri il pannello Cerca e digita l’impostazione o la funzione che cerchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「検索」タブを開き、探したい設定や機能を入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘검색’ 탭을 열고 찾고 싶은 설정이나 기능을 입력하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka tab Cari dan masukkan tetapan atau ciri yang anda mahu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o separador Pesquisar e introduz a definição ou funcionalidade que procuras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте вкладку «Поиск» и введите название нужной настройки или функции."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“搜索”标签页，输入想找的设置或功能。"
          }
        }
      }
    },
