        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire-le quand tu veux dans Réglages → Général → Clavier → Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármikor visszavonhatod itt: Beállítások → Általános → Billentyűzet → Clink."
          }
        },
