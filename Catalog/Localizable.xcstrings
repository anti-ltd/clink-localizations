    "Up to %@ groups. Swipe a clip right in the keyboard panel to assign it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu %@ Gruppen. Wisch einen Clip nach rechts, um ihn zuzuordnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta %@ grupos. Desliza un clip a la derecha en el panel del teclado para asignarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'à %@ groupes. Balaie un clip vers la droite dans le panneau du clavier pour l'assigner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb %@ csoport. Húzz egy vágólap-elemet jobbra a billentyűzet panelén, hogy hozzárendeld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a %@ gruppi. Scorri una clip verso destra nel pannello della tastiera per assegnarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループは最大 %@ 個までです。キーボードパネルでクリップを右にスワイプすると割り当てられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹은 최대 %@개예요. 키보드 패널에서 클립을 오른쪽으로 밀면 그룹에 넣을 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehingga %@ kumpulan. Leret klip ke kanan dalam panel papan kekunci untuk masukkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até %@ grupos. Desliza um clipe para a direita no painel do teclado para o atribuíres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До %@ групп. Смахните фрагмент вправо в панели на клавиатуре, чтобы отнести его к группе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %@ 个分组。在键盘面板里把剪贴内容向右滑，就能分到组里。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuni %@ gruppi. Viipa klipid klaviatuuri paneelil paremale, et need määrata."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tot %@ groepe. Swiep 'n snit regs in die sleutelbordpaneel om dit toe te wys."
          }
        }
      }
    },
    "Up to %@ groups. Swipe a saved note right in the keyboard panel to assign it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu %@ Gruppen. Streich im Tastaturpanel auf einer gespeicherten Notiz nach rechts, um sie zuzuordnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta %@ grupos. Desliza a la derecha una nota guardada en el panel del teclado para asignarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à %@ groupes. Balaie vers la droite une note enregistrée dans le panneau du clavier pour l’affecter."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb %@ csoport. A billentyűzetpanelen húzd jobbra a mentett jegyzetet, hogy csoportba tedd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a %@ gruppi. Nel pannello della tastiera scorri verso destra una nota salvata per assegnarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループは最大 %@ 個です。キーボードのパネルで保存済みのメモを右にスワイプすると振り分けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹은 최대 %@개입니다. 키보드 패널에서 저장한 메모를 오른쪽으로 쓸면 그룹에 넣을 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehingga %@ kumpulan. Leret nota tersimpan ke kanan dalam panel papan kekunci untuk menetapkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até %@ grupos. No painel do teclado, desliza uma nota guardada para a direita para a atribuir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До %@ групп. Смахните сохранённую заметку вправо в панели на клавиатуре, чтобы отнести её к группе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %@ 个分组。在键盘面板里把已保存的备忘向右轻扫即可归入分组。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuni %@ gruppi. Viipa salvestatud märge klaviatuuri paneelil paremale, et see määrata."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tot %@ groepe. Swiep 'n gestoorde nota regs in die sleutelbordpaneel om dit toe te wys."
          }
        }
      }
    },
