          }
        }
      }
    },
    "Add names, slang, or jargon the keyboard keeps fighting.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füg Namen, Slang oder Fachbegriffe hinzu, gegen die die Tastatur ständig ankämpft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade nombres, jerga o argot con los que el teclado no para de pelearse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute les noms, l'argot ou le jargon que le clavier n'arrête pas de corriger."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedd fel a neveket, szlenget vagy szakszavakat, amikkel a billentyűzet folyton harcol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi nomi, slang o gergo che la tastiera continua a correggerti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードがいつも直してしまう名前やスラング、専門用語を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 자꾸 바꾸려 드는 이름, 속어, 전문 용어를 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah nama, slanga, atau jargon yang papan kekunci asyik tolak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona nomes, calão ou jargão que o teclado teima em corrigir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте имена, сленг или жаргон, с которыми клавиатура постоянно спорит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把键盘老爱改掉的名字、俚语或行话加进来。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa nimesid, slängi või žargooni, millega klaviatuur pidevalt võitleb."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg name, sleng of jargon by die sleutelbord bly veg."
          }
        }
      }
    },
    "Add names, slang, or jargon the keyboard keeps fighting. They show up as you type, stay correctly spelled, and survive a learned-words reset.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Namen, Slang oder Fachwörter hinzu, gegen die die Tastatur ankämpft. Sie erscheinen beim Tippen, bleiben richtig geschrieben und überstehen das Löschen gelernter Wörter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade nombres, jerga o tecnicismos contra los que pelea el teclado. Aparecen mientras escribes, se mantienen bien escritos y sobreviven al borrado de palabras aprendidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute les noms, l'argot ou le jargon que le clavier n'arrête pas de corriger. Ils apparaissent pendant la frappe, gardent leur orthographe et survivent à l'effacement des mots appris."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add hozzá azokat a neveket, szlenget vagy szakszavakat, amiket a billentyűzet folyton javít. Gépelés közben megjelennek, helyesen maradnak, és a tanult szavak törlését is túlélik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi nomi, slang o gergo contro cui la tastiera continua a lottare. Compaiono mentre scrivi, restano scritti bene e sopravvivono alla cancellazione delle parole imparate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードが直そうとする名前やスラング、専門用語を追加できます。入力中に候補として出て、つづりもそのまま、学習した単語を消しても残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 자꾸 고치려는 이름, 은어, 전문 용어를 추가하세요. 입력할 때 후보로 나오고, 철자도 그대로 유지되며, 학습된 단어를 지워도 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah nama, slanga atau jargon yang sentiasa dibetulkan papan kekunci. Ia muncul semasa awak menaip, kekal ejaannya dan tidak hilang apabila perkataan yang dipelajari dibersihkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona nomes, gíria ou jargão contra os quais o teclado insiste. Aparecem enquanto escreves, mantêm a grafia e sobrevivem à limpeza das palavras aprendidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте имена, сленг или жаргон, с которыми клавиатура постоянно спорит. Они появляются в подсказках, пишутся правильно и переживают сброс выученных слов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把键盘老想改掉的名字、俚语或行话加进来。它们会在你打字时出现，拼写保持不变，清空已学词汇后也还在。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa nimesid, slängi või žargooni, millega klaviatuur pidevalt võitleb. Need ilmuvad tipimise ajal, jäävad õigesti kirjutatud ja säilivad õpitud sõnade lähtestamisel."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg name, sleng of jargon by die sleutelbord bly veg. Hulle verskyn terwyl jy tik, bly korrek gespel, en oorleef 'n aangeleerde woorde-terugstelling."
          }
        }
      }
    },
    "Add one to the left or right of space, and give it what it should do.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg eine links oder rechts von der Leertaste an und gib ihr eine Aufgabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una a la izquierda o a la derecha del espacio y dile qué debe hacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutes-en une à gauche ou à droite de l'espace, et dis-lui quoi faire."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegyél fel egyet a szóköz bal vagy jobb oldalára, és add meg, mit csináljon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungine uno a sinistra o a destra dello spazio e assegnagli cosa fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースの左か右に1つ追加して、そのキーの役割を決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 왼쪽이나 오른쪽에 하나 추가하고, 무슨 일을 할지 정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah satu di kiri atau kanan ruang, dan tetapkan apa yang perlu dilakukannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona uma à esquerda ou à direita do espaço e define o que ela faz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте её слева или справа от пробела и задайте, что она делает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在空格左边或右边加一个，再给它指定要做的事。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa üks tühikust vasakule või paremale ja anna talle ülesanne."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg een links of regs van spasie by en gee dit wat dit moet doen."
          }
        }
      }
    },
    "Add one: the shortcut, then the phrase it turns into.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg eine an: das Kürzel und den Text, der daraus wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una: el atajo y la frase en la que se convierte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutes-en un : le raccourci, puis le texte qu'il devient."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegyél fel egyet: a rövidítést, majd a szöveget, amivé válik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungine una: la scorciatoia e la frase in cui si trasforma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しく1つ追加します。短縮形と、それが展開される文章を入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나 추가하세요. 짧은 말과, 그것이 바뀔 문구를 넣으면 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah satu: pintasannya, kemudian frasa yang terhasil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona uma: o atalho e a frase em que se transforma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте пару: сокращение, а затем фразу, в которую оно превращается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建一条：缩写，以及它要变成的内容。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa üks: otsetee ja siis fraas, milleks see muutub."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg een by: die kortpad, dan die frase waarin dit verander."
          }
        }
      }
    },
    "Add punctuation and capitals only. Leave my words exactly as I said them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Zeichensetzung und Großschreibung. Lass meine Worte genau so, wie ich sie gesagt habe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade solo puntuación y mayúsculas. Deja mis palabras tal como las dije."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute seulement la ponctuation et les majuscules. Laisse mes mots exactement comme je les ai dits."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a központozást és a nagybetűket tedd hozzá. A szavaimat hagyd pontosan úgy, ahogy mondtam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi solo punteggiatura e maiuscole. Lascia le mie parole esattamente come le ho dette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "句読点だけ補って、言葉は話したとおりそのまま残して。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문장부호만 넣고, 내 말은 말한 그대로 남겨 둬."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah tanda baca dan huruf besar sahaja. Biarkan perkataan saya betul-betul seperti yang saya sebut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona só pontuação e maiúsculas. Deixa as minhas palavras tal como as disse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только знаки препинания и заглавные буквы. Слова оставить ровно такими, как сказано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只加标点，我说的字句原样保留。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa ainult kirjavahemärgid ja suurtähed. Jäta mu sõnad täpselt nii, nagu ma ütlesin."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg slegs leestekens en hoofletters by. Los my woorde presies soos ek dit gesê het."
          }
        }
      }
    },
