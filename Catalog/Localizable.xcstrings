    "%@ stored, out of the 1 MB iCloud allows. Clink has no server, so none of it passes through us.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gespeichert, von dem 1 MB, das iCloud erlaubt. Clink hat keinen Server, also läuft nichts davon über uns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ guardados, del 1 MB que permite iCloud. Clink no tiene servidor, así que nada de esto pasa por nosotros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stockés, sur le 1 Mo autorisé par iCloud. Clink n’a pas de serveur, donc rien de tout cela ne passe par nous."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tárolva az iCloud által engedélyezett 1 MB-ból. A Clinknek nincs szervere, így semmi sem halad át rajtunk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ salvati, su 1 MB consentito da iCloud. Clink non ha server, quindi nulla passa da noi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudが認めている1 MBのうち%@を使用しています。Clinkにはサーバーがないため、当社を経由するものは何もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud가 허용하는 1MB 중 %@를 사용 중입니다. Clink에는 서버가 없어 어떤 데이터도 저희를 거치지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disimpan, daripada 1 MB yang dibenarkan iCloud. Clink tiada pelayan, jadi tiada apa-apa melaluinya kami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ guardados, do 1 MB que o iCloud permite. O Clink não tem servidor, por isso nada disto passa por nós."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Занято %@ из 1 МБ, которые даёт iCloud. У Clink нет сервера, так что через нас ничего не проходит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储 %@，iCloud 允许 1 MB。Clink 没有服务器，因此这些内容都不会经过我们。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ salvestatud iCloudi lubatud 1 MB-st. Clinkil pole serverit, seega ei lähe mitte midagi meie kaudu."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ gestoor, uit die 1 MB wat iCloud toelaat. Clink het geen bediener nie, so niks daarvan gaan deur ons nie."
          }
        }
      }
    },
