            "value": "Con qué rapidez se asienta el resorte de la barra espaciadora. Más bajo va más ágil."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui kiiresti tühikuklahvi vedru raugab. Madalam on nobedam."
          }
        },
        "fr": {
          "stringUnit": {
