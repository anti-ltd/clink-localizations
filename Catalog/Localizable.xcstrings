        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы перейти к следующему языку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点它切到下一种语言。"
