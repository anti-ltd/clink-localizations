    "Needed for themes, swipe, and the extras": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Benodig vir temas, swiep en die ekstras"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nötig für Themes, Wischen und die Extras"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace falta para los temas, el deslizamiento y los extras"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajalik teemade, pühkimise ja lisade jaoks"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour les thèmes, le glissement et les extras"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kell a témákhoz, a csúsztatáshoz és az extrákhoz"
