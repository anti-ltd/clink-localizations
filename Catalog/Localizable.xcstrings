    "Reach emoji from the Tools menu. Off removes emoji entirely. Want a dedicated 🙂 key? Add one from Layout → Quick presets.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji über das Werkzeug-Menü erreichen. Aus entfernt Emoji vollständig. Lieber eine eigene 🙂-Taste? Füge sie unter Layout → Schnellvorlagen hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accede a los emojis desde el menú de herramientas. Desactivado, los emojis desaparecen por completo. ¿Prefieres una tecla 🙂 propia? Añádela en Diseño → Ajustes rápidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accède aux emojis depuis le menu Outils. Désactivé, les emojis disparaissent entièrement. Tu préfères une touche 🙂 dédiée ? Ajoute-la dans Disposition → Préréglages."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az emojikat az Eszközök menüből éred el. Kikapcsolva az emojik teljesen eltűnnek. Inkább külön 🙂 gombot szeretnél? Add hozzá az Elrendezés → Gyors sablonok alatt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggiungi le emoji dal menu Strumenti. Se disattivato, le emoji spariscono del tutto. Preferisci un tasto 🙂 dedicato? Aggiungilo da Layout → Preimpostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵文字はツールメニューから開けます。オフにすると絵文字は完全に非表示になります。専用の🙂キーが欲しい場合は「レイアウト」→「クイックプリセット」から追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이모지는 도구 메뉴에서 열 수 있습니다. 끄면 이모지가 완전히 사라집니다. 전용 🙂 키를 원하시나요? 레이아웃 → 빠른 프리셋에서 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Capai emoji daripada menu Alatan. Jika dimatikan, emoji hilang sepenuhnya. Mahu kekunci 🙂 khusus? Tambahkannya dari Susun Atur → Pratetap Pantas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceda aos emojis pelo menu de ferramentas. Desligado, os emojis desaparecem por completo. Prefere uma tecla 🙂 dedicada? Adicione uma em Esquema → Predefinições rápidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывать эмодзи из меню инструментов. Выключено — эмодзи убираются совсем. Нужна отдельная клавиша 🙂? Добавьте её в «Раскладке» → «Быстрые пресеты»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从工具菜单进入表情。关闭后将完全移除表情。想要专属的 🙂 键？可在「布局」→「快捷预设」中添加。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji Tööriistade menüüst. Väljas eemaldab emoji täielikult. Tahad eraldi klahvi 🙂? Lisa see jaotisest Paigutus → Kiirmallid."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bereik emoji's vanaf die Tools-kieslys. Af verwyder emoji heeltemal. Wil jy 'n toegewyde 🙂-sleutel hê? Voeg een by uitleg → Vinnige voorafinstellings."
          }
        }
      }
    },
