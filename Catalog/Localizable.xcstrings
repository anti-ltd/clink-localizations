          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikkuvat tehosteet, jotka toistavat teeman taustan päällä näppäinten alla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
