    "Evaluate arithmetic and insert the result wherever you type. Adds a calculator to the panel button.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Evalueer rekenkunde en voeg die resultaat in waar jy ook al tik. Voeg 'n sakrekenaar by die paneelknoppie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechnet Ausdrücke aus und setzt das Ergebnis dort ein, wo du tippst. Legt einen Rechner auf den Panel-Button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve operaciones y pone el resultado donde escribes. Añade una calculadora al botón del panel."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvuta avaldisi ja sisesta tulemus sinna, kuhu tipid. Lisab paneelinupule kalkulaatori."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule les opérations et insère le résultat là où tu écris. Ajoute une calculatrice au bouton du panneau."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiszámolja a műveleteket, és beszúrja az eredményt oda, ahol írsz. Számológépet tesz a panel gombjára."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcola le operazioni e scrive il risultato dove stai scrivendo. Aggiunge una calcolatrice al pulsante del pannello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算式を計算して、入力中の場所に結果を差し込みます。パネルボタンに電卓を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "산술식을 계산해서 입력하는 자리에 결과를 넣어줘요. 패널 버튼에 계산기가 생겨요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kira aritmetik dan masukkan hasilnya di mana sahaja anda menaip. Ini menambah kalkulator pada butang panel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz contas e mete o resultado onde estás a escrever. Adiciona uma calculadora ao botão do painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считает выражения и вставляет результат туда, где вы печатаете. Добавляет калькулятор к кнопке панелей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "算出算术表达式，把结果直接插到你输入的地方。会在面板按钮里加个计算器。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Evaluați aritmetica și introduceți rezultatul oriunde introduceți. Adaugă un calculator la butonul panoului."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Evalueer de rekenkunde en voeg het resultaat in, waar u ook typt. Voegt een rekenmachine toe aan de paneelknop."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "算出算術表示式，把結果直接插到你輸入的地方。會在面板按鈕里加個計算器。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oceń arytmetykę i wstaw wynik w dowolnym miejscu, w którym piszesz. Dodaje kalkulator do przycisku panelu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцініть арифметику та вставте результат, куди б ви не вводили текст. Додає калькулятор до кнопки панелі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aritmetiği değerlendirin ve sonucu yazdığınız yere ekleyin. Panel düğmesine bir hesap makinesi ekler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhodnoťte aritmetiku a vložte výsledek kamkoli píšete. Přidá k tlačítku panelu kalkulačku."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhodnoťte aritmetiku a vložte výsledok kamkoľvek píšete. Pridá na tlačidlo panela kalkulačku."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αξιολογήστε την αριθμητική και εισάγετε το αποτέλεσμα όπου πληκτρολογείτε. Προσθέτει μια αριθμομηχανή στο κουμπί του πίνακα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utvärdera aritmetiken och infoga resultatet var du än skriver. Lägger till en kalkylator till panelknappen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Evaluer aritmetik og indsæt resultatet, uanset hvor du skriver. Tilføjer en lommeregner til panelknappen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vurder aritmetikk og sett inn resultatet uansett hvor du skriver. Legger til en kalkulator til panelknappen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvioi aritmetiikka ja lisää tulos minne tahansa kirjoitat. Lisää laskimen paneelipainikkeeseen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Evaluasi aritmatika dan masukkan hasilnya di mana pun Anda mengetik. Menambahkan kalkulator ke tombol panel."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh giá số học và chèn kết quả vào bất cứ nơi nào bạn gõ. Thêm một máy tính vào nút bảng điều khiển."
          }
        }
      }
    },
