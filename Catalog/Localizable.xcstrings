            "value": "Lisa klaviatuur seadetes, et hakata sellega tipitama."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg die sleutelbord in Instellings by om daarmee te begin tik."
          }
        }
      }
    },
