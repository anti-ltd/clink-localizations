            "value": "setting(), set_setting() und release() nehmen dieselben IDs. Der graue Text zeigt, was jede annimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "setting(), set_setting() y release() aceptan los mismos IDs. El texto gris indica qué admite cada uno."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "setting(), set_setting() ja release() võtavad samu ID-sid. Hall tekst näitab, mida igaüks lubab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
