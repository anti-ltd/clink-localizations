    "This profile temporarily supplies its supported settings. Your saved profile and theme stay unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil aplica temporalmente sus ajustes compatibles. El perfil y el tema guardados no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce profil fournit temporairement ses réglages compatibles. Le profil et le thème enregistrés restent inchangés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
