    "Built-in themes can’t be changed. We’ll make an editable copy of it for you to tweak.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Integrierte Themes lassen sich nicht ändern. Wir erstellen dir eine bearbeitbare Kopie zum Anpassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los temas integrados no se pueden modificar. Te haremos una copia editable para que la ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les thèmes intégrés ne peuvent pas être modifiés. On va t'en faire une copie modifiable à personnaliser."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beépített témák nem módosíthatók. Készítünk belőle egy szerkeszthető másolatot, amit már alakíthatsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I temi integrati non si possono modificare. Ne creeremo una copia modificabile per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵テーマは変更できません。編集できるコピーを作成するので、そちらを調整してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 테마는 수정할 수 없어요. 편집 가능한 복사본을 만들어 드릴 테니 그걸 손보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema terbina dalam tidak boleh diubah. Kami akan buat salinan boleh edit untuk anda ubah suai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os temas integrados não podem ser alterados. Vamos criar-te uma cópia editável para ajustares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенные темы менять нельзя. Мы сделаем её копию, которую можно править."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置主题不能修改。我们会给你生成一份可编辑的副本，随便调整。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisseehitatud teemasid ei saa muuta. Me teeme sinu jaoks muudetava koopia, mida kohandada."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingeboude temas kan nie verander word nie. Ons sal 'n redigeerbare kopie daarvan maak vir jou om aan te pas."
          }
        }
      }
    },
