        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하거나 드래그하여 키를 선택하세요. 다시 탭하면 선택이 해제됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvide valimiseks puuduta neid või lohista sõrmega üle nende. Valiku tühistamiseks puuduta uuesti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți sau trageți pentru a selecta tastele. Atingeți din nou pentru a deselecta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik of sleep om toetsen te selecteren. Tik nogmaals om de selectie ongedaan te maken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
