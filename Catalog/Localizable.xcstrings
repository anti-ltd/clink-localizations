        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema renginizde temiz bir çizgi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna čistá linie v barvě vašeho motivu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna čistá línia vo farbe vašej témy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια καθαρή γραμμή στο χρώμα του θέματός σας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ren linje i din temafärg."
