    "Curated presets and the controls that matter most.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Samegestelde voorafinstellings en die kontroles wat die meeste saak maak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Voreinstellungen und die wichtigsten Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preajustes seleccionados y los controles más importantes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitud eelseadistused ja kõige olulisemad juhtelemendid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des préréglages soignés et les commandes qui comptent le plus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válogatott előbeállítások és a legfontosabb vezérlők."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preset curati e i controlli che contano di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厳選したプリセットと、いちばん大切なコントロール"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엄선한 프리셋과 가장 중요한 설정만 모았어요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Praset terpilih dan kawalan yang paling penting."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinições selecionadas e os controlos mais importantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отобранные пресеты и самые важные регуляторы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精选预设和最重要的控件"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Presetări selectate și comenzile care contează cel mai mult."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samengestelde presets en de bedieningselementen die er het meest toe doen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "精選預設和最重要的控制元件"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyselekcjonowane ustawienia wstępne i najważniejsze elementy sterujące."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підібрані стилі та найважливіші елементи керування."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel olarak hazırlanmış ön ayarlar ve en önemli kontroller."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrané předvolby a ovládací prvky, na kterých záleží nejvíce."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrané predvoľby a ovládacie prvky, na ktorých záleží najviac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιμελημένες προεπιλογές και τα στοιχεία ελέγχου που έχουν μεγαλύτερη σημασία."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utvalda förinställningar och kontrollerna som betyder mest."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurerede forudindstillinger og de kontroller, der betyder mest."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurserte forhåndsinnstillinger og kontrollene som betyr mest."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuroidut esiasetukset ja tärkeimmät säätimet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Preset yang dikurasi dan kontrol yang paling penting."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cài đặt trước được tuyển chọn và các điều khiển quan trọng nhất."
          }
        }
      }
    },
    "Curl straight quotes (“'” → ’, “\"” → “”). Turn off for languages that need straight apostrophes.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Krul reguit aanhalingstekens (“'” → ’, “”” → “”). Skakel af vir tale wat reguit apostrof benodig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandelt gerade Anführungszeichen in typografische um (“'” → ’, “\"” → “”). Schalt es für Sprachen aus, die gerade Apostrophe brauchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte las comillas rectas (“'” → ’, “\"” → “”). Desactívalo para los idiomas que necesitan apóstrofos rectos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muundab sirged ülakoma- ja jutumärgid tüpograafilisteks (' → ’, \" → “”). Lülita välja keelte jaoks, mis vajavad sirgeid ülakomasid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme les guillemets droits (« ' » → ’, « \" » → « »). Désactive-le pour les langues qui ont besoin d'apostrophes droites."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megformálja az egyenes idézőjeleket („'” → ’, „\"” → „”). Kapcsold ki azoknál a nyelveknél, amelyeknek egyenes aposztróf kell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrotonda le virgolette dritte (“'” → ’, “\"” → “”). Disattivalo per le lingue che hanno bisogno di apostrofi dritti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まっすぐな引用符を丸めます（“'” → ’、“\"” → “”）。まっすぐなアポストロフィが必要な言語ではオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곧은 따옴표를 둥글게 바꿔요 (“'” → ’, “\"” → “”). 곧은 아포스트로피가 필요한 언어에서는 꺼주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengkukkan tanda kutip lurus (“'” → ’, “\"” → “”). Matikan untuk bahasa yang perlukan tanda kutip lurus."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva as aspas retas (“'” → ’, “\"” → “”). Desliga para idiomas que precisam de apóstrofos retos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменять прямые кавычки на типографские (“'” → ’, “\"” → “”). Выключите для языков, где нужны прямые апострофы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把直引号弯化（“'” → ’，“\"” → “”）。需要直撇号的语言请关掉。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Curlează ghilimele drepte (“'” → ’, “”” → “”). Dezactivați pentru limbile care au nevoie de apostrofe drepte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krul rechte aanhalingstekens (“'” → ’, “”” → “”). Schakel dit uit voor talen die rechte apostrofs nodig hebben."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把直引號彎化（“'” → ’，“\"” → “”）。需要直撇號的語言請關掉。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwijaj proste cudzysłowy („'” → ’, „”” → „”). Wyłącz w przypadku języków wymagających prostych apostrofów."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Згорнути прямі лапки («'» → ’, «\"» → «»). Вимкніть для мов, де потрібні прямі апострофи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düz tırnakları kıvırın (“'” → ’, “\"” → “”). Düz kesme işareti gerektiren diller için kapatın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Natočte rovné uvozovky („'“ → ’, „““ → „“). Vypněte u jazyků, které potřebují rovné apostrofy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáčajte rovné úvodzovky („'“ → ', „““ → „“). Vypnite pre jazyky, ktoré potrebujú rovné apostrofy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κουρλώστε τα ίσια εισαγωγικά (\"\"\" → \", \"\"\" → \"\"). Απενεργοποιήστε τις γλώσσες που χρειάζονται ευθεία απόστροφα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Böj raka citattecken (\"'\" → ', \"\"\" → \"\"). Stäng av för språk som behöver raka apostrof."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Krølle lige citater (\"'\" → ', \"\"\" → \"\"). Sluk for sprog, der har brug for lige apostrof."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krølle rette anførselstegn (\"'\" → ', \"\"\" → \"\"). Slå av for språk som trenger rette apostrof."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käännä suorat lainausmerkit (\"'\" → ', \"\"\" → \"\"). Poista käytöstä kielissä, jotka tarvitsevat suoria heittomerkkejä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda kutip lurus (“'” → ’, “\"” → “”). Nonaktifkan untuk bahasa yang memerlukan apostrof lurus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trích dẫn thẳng (“'” → ’, “\"” → “”). Tắt đối với những ngôn ngữ cần dấu nháy đơn thẳng."
          }
        }
      }
    },
