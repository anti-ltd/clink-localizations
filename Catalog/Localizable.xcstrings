    "Turn off the animated background in Themes, under Backdrop.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte unter „Themen“ > „Hintergrund“ den animierten Hintergrund aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva el fondo animado en Temas, en Fondo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita jaotises Teemad > Taust animeeritud taust välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez l’arrière-plan animé dans Thèmes, sous Arrière-plan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold ki az animált hátteret a Témák Háttér részében."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva lo sfondo animato in Temi, sotto Sfondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
