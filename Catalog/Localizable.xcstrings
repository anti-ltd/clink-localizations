    "Search finds settings, tools, and answers across Clink.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche findet Einstellungen, Werkzeuge und Antworten in ganz Clink."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda encuentra ajustes, herramientas y respuestas en todo Clink."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsing leiab seadeid, tööriistu ja vastuseid kogu Clinkist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche trouve des réglages, des outils et des réponses dans tout Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kereséssel a Clink összes beállítását, eszközét és súgóválaszát megtalálod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca trova impostazioni, strumenti e risposte in tutto Clink."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索では、Clink全体の設定、ツール、質問への回答を探せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색으로 Clink의 설정, 도구, 질문에 대한 답변을 찾을 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari tetapan, alat dan jawapan di seluruh Clink."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A pesquisa encontra definições, ferramentas e respostas em todo o Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск находит настройки, инструменты и ответы во всём Clink."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过搜索，可以找到 Clink 中的设置、工具和问题解答。"
          }
        }
      }
    },
    "Search for a word to define it.": {
      "extractionState": "manual",
      "localizations": {
