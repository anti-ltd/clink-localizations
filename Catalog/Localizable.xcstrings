            "value": "Parandab näpuvead tipimise ajal nendes keeltes, mille oled sisse lülitanud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige les fautes de frappe pendant que tu tapes, dans les langues que tu as activées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gépelés közben javítja az elgépeléseket a bekapcsolt nyelveiden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corregge i refusi mentre scrivi, nelle lingue che hai attivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにしている言語で、入力しながら打ち間違いを直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜 둔 언어에서 입력하는 동안 오타를 고쳐요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membetulkan silap taip semasa anda menaip, dalam bahasa yang anda hidupkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige gralhas enquanto escreves, nos idiomas que tens ligados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправляет опечатки по ходу печати, в тех языках, которые вы включили."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你开启的语言里，一边打字一边改正错字。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Remediați greșelile de scriere pe măsură ce introduceți text, în limbile pe care le-ați activat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigeer typefouten terwijl u typt, in de talen die u heeft ingeschakeld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你開啟的語言裡，一邊打字一邊改正錯字。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel tikfoute soos jy tik, in die tale wat jy aangeskakel het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naprawiaj literówki podczas pisania w włączonych językach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виправляйте помилки під час введення на мовах, які ви ввімкнули."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açtığınız dillerde yazarken yazım hatalarını düzeltin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravte překlepy při psaní v jazycích, které jste zapnuli."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravte preklepy pri písaní v jazykoch, ktoré ste zapli."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διορθώστε τα τυπογραφικά λάθη καθώς πληκτρολογείτε, στις γλώσσες που έχετε ενεργοποιήσει."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtgärda stavfel medan du skriver, på de språk du har aktiverat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ret stavefejl, mens du skriver, på de sprog, du har slået til."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rett opp skrivefeil mens du skriver, på språkene du har slått på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korjaa kirjoitusvirheet kirjoittaessasi kielillä, jotka olet ottanut käyttöön."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbaiki kesalahan ketik saat Anda mengetik, dalam bahasa yang Anda aktifkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sửa lỗi chính tả khi bạn nhập bằng các ngôn ngữ bạn đã bật."
          }
        }
      }
    },
