            "state": "translated",
            "value": "Ajoute une touche, ou une rangée, à l'endroit voulu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegyél fel egy billentyűt vagy egy sort oda, ahová szeretnéd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un tasto, o una riga, dove ti serve."
          }
        },
