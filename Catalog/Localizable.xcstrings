    "The keys you use most stay the warmest.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die sleutels wat jy die meeste gebruik, bly die warmste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tasten, die du am häufigsten nutzt, bleiben am wärmsten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas que más usas se mantienen más cálidas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvid, mida sa kõige rohkem kasutad, püsivad kõige soojemad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches les plus utilisées restent les plus chaudes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legtöbbet használt gombok maradnak a legmelegebbek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti che usi di più restano i più caldi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使うキーがいちばん暖かい色のままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 많이 쓰는 키가 가장 뜨겁게 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci yang paling anda guna kekal paling panas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas que usas mais ficam mais quentes."
          }
        },
        "ru": {
