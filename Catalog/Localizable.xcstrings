    "Add a space after punctuation. Press Backspace to remove it.": {
      "comment": "Keyboard typing setting. Applies to Latin and Arabic punctuation; full-width East Asian punctuation is unchanged. Backspace means the keyboard delete key.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg ’n spasie ná leestekens by. Druk Backspace om dit te verwyder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge nach Satzzeichen ein Leerzeichen ein. Mit der Rücktaste entfernst du es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un espacio después de los signos de puntuación. Pulsa Retroceso para quitarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa kirjavahemärgi järele tühik. Selle eemaldamiseks vajuta tagasilükkeklahvi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une espace après les signes de ponctuation. Appuie sur Retour arrière pour la supprimer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szóköz beszúrása az írásjelek után. A törléséhez nyomd meg a visszatörlés billentyűt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi uno spazio dopo i segni di punteggiatura. Premi il tasto di cancellazione per rimuoverlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "句読点の後にスペースを挿入します。削除キーで取り消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문장 부호 뒤에 공백을 넣습니다. 지우기 키를 눌러 공백을 지울 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah ruang selepas tanda baca. Tekan Backspace untuk membuangnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um espaço após os sinais de pontuação. Prime a tecla de apagar para o remover."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлять пробел после знаков препинания. Чтобы убрать его, нажмите клавишу удаления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在标点后添加空格。按退格键可删除空格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在標點後加入空格。按退格鍵即可刪除空格。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă un spațiu după semnele de punctuație. Apasă tasta Backspace pentru a-l elimina."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een spatie toe na leestekens. Druk op Backspace om de spatie te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawaj spację po znakach interpunkcyjnych. Naciśnij Backspace, aby ją usunąć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавати пробіл після розділових знаків. Щоб прибрати його, натисніть клавішу видалення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noktalama işaretlerinden sonra boşluk ekle. Kaldırmak için geri silme tuşuna bas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za interpunkční znaménka přidá mezeru. Klávesou Backspace ji odstraníš."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Za interpunkčné znamienka pridá medzeru. Klávesom Backspace ju odstrániš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθήκη κενού μετά τα σημεία στίξης. Πάτησε το πλήκτρο διαγραφής για να το αφαιρέσεις."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till ett blanksteg efter skiljetecken. Tryck på backsteg för att ta bort det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj et mellemrum efter tegnsætningstegn. Tryk på tilbagetasten for at fjerne det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til et mellomrom etter skilletegn. Trykk på slettetasten for å fjerne det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää välilyönti välimerkin jälkeen. Poista se askelpalauttimella."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan spasi setelah tanda baca. Tekan Backspace untuk menghapusnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm dấu cách sau dấu câu. Nhấn phím xóa lùi để bỏ dấu cách đó."
          }
        }
      }
    },
