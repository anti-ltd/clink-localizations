          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Până la 32 de caractere. Lăsați necompletat pentru eticheta implicită."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaal 32 tekens. Laat leeg voor het standaardlabel."
          }
        },
        "zh-Hant": {
