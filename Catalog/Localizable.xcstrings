    "The device is running hot, so the light holds still instead of moving. Presses still light up.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo está caliente, por lo que la luz permanece fija. Las pulsaciones siguen iluminándose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil chauffe, donc la lumière reste fixe. Les touches s’allument toujours à l’appui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät wird heiß, deshalb bleibt das Licht unbewegt. Tastendrücke leuchten weiterhin auf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo è caldo, quindi la luce resta ferma. I tasti si illuminano ancora alla pressione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo está quente, pelo que a luz fica estática. As teclas continuam a iluminar-se ao premir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство нагрелось, поэтому подсветка неподвижна. Нажатия по-прежнему подсвечиваются."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peranti sedang panas, jadi cahaya tidak bergerak. Kekunci masih menyala apabila ditekan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszköz felmelegedett, ezért a fény nem mozog. A leütések továbbra is felvillannak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスが高温のため、光の動きを止めています。キーを押したときの点灯は続きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备温度较高，灯光保持静止。按键按下时仍会亮起。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 뜨거워져 빛이 움직이지 않습니다. 키를 누르면 계속 빛납니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seade on kuum, seega valgus ei liigu. Vajutused süütavad endiselt valguse."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispozitivul este fierbinte, așa că lumina rămâne nemișcată în loc să se miște. Presele încă se aprind."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het apparaat wordt heet, dus het licht blijft stilstaan in plaats van bewegen. Drukken lichten nog steeds op."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置溫度較高，燈光保持靜止。按鍵按下時仍會亮起。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die toestel raak warm, daarom bly die lig stilstaan ​​in plaas daarvan om te beweeg. Sleuteldrukke laat die ligte steeds brand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenie nagrzewa się, więc lampka stoi nieruchomo, zamiast się poruszać. Prasy nadal się świecą."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пристрій нагрівається, тому світло тримається, а не рухається. Преси ще світяться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz ısınıyor, dolayısıyla ışık hareket etmek yerine sabit duruyor. Presler hala yanıyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zařízení je zahřáté, takže světlo nehybně drží, místo aby se pohybovalo. Lisy stále svítí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zariadenie je horúce, takže svetlo nehybne drží, namiesto toho, aby sa pohybovalo. Lisy stále svietia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συσκευή είναι ζεστή, επομένως το φως παραμένει ακίνητο αντί να κινείται. Τα πατήματα συνεχίζουν να ανάβουν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten är varm, så lampan håller stilla istället för att röra sig. Pressar lyser fortfarande."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheden er ved at blive varm, så lyset holder stille i stedet for at bevæge sig. Pressene lyser stadig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten blir varm, så lyset holder stille i stedet for å bevege seg. Trykkene lyser fortsatt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laite käy kuumana, joten valo pysyy paikallaan sen sijaan, että se liikkuisi. Painekkeet palavat edelleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat sedang panas, jadi lampunya tetap diam dan tidak bergerak. Mesin press masih menyala."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy đang nóng nên đèn đứng yên thay vì di chuyển. Máy ép vẫn sáng."
          }
        }
      }
    },
    "The device is running warm. Glass keeps rendering, and the optional effects come back once it cools down.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die toestel loop warm. Glas hou aan om weer te gee, en die opsionele effekte kom terug sodra dit afgekoel het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät ist warm geworden. Das Glas bleibt, und die optionalen Effekte kommen zurück, sobald es abgekühlt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo se ha calentado. El cristal se mantiene y los efectos opcionales vuelven en cuanto se enfríe."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seade on soojaks läinud. Klaas jätkab renderdamist ja valikulised efektid tulevad tagasi, kui ta jahtub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil a chauffé. Le verre reste affiché et les effets facultatifs reviennent dès qu'il a refroidi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A készülék felmelegedett. Az üveg marad, a nem kötelező effektek pedig visszatérnek, amint lehűl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo si è scaldato. Il vetro resta e gli effetti opzionali tornano appena si raffredda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末が熱を持っています。ガラスはそのままで、任意のエフェクトは温度が下がると戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 뜨거워졌습니다. 글래스는 그대로 두고 선택적인 효과는 식으면 다시 돌아옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peranti sedang panas. Kaca kekal dan kesan pilihan kembali sebaik sahaja ia menyejuk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo aqueceu. O vidro continua e os efeitos opcionais voltam assim que arrefecer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство греется. Стекло по-прежнему рисуется, а необязательные эффекты вернутся, когда оно остынет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备有些发热。玻璃继续渲染，可选特效会在降温后恢复。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparatul se încălzește. Sticla continuă să redeze, iar efectele opționale revin odată ce se răcește."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het apparaat wordt warm. Glas blijft renderen en de optionele effecten komen terug zodra het is afgekoeld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置有些發熱。玻璃繼續渲染，可選特效會在降溫後恢復。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenie się nagrzewa. Szkło kontynuuje renderowanie, a opcjonalne efekty wracają, gdy ostygnie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пристрій нагрівається. Скло продовжує рендеринг, а додаткові ефекти відновлюються, коли воно охолоне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz ısınıyor. Cam görüntülenmeye devam ediyor ve soğuduktan sonra isteğe bağlı efektler geri geliyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zařízení se zahřívá. Sklo se neustále vykresluje a volitelné efekty se vrátí, jakmile vychladne."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zariadenie sa zahrieva. Sklo pokračuje vo vykresľovaní a po vychladnutí sa voliteľné efekty vrátia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συσκευή λειτουργεί ζεστά. Το γυαλί συνεχίζει να αποδίδει και τα προαιρετικά εφέ επανέρχονται μόλις κρυώσει."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten är varm. Glas fortsätter att renderas och de valfria effekterna kommer tillbaka när det svalnar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheden kører varm. Glas bliver ved med at gengives, og de valgfrie effekter kommer tilbage, når det køles af."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten går varm. Glass fortsetter å gjengis, og de valgfrie effektene kommer tilbake når det avkjøles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laite käy lämpimänä. Lasi jatkaa renderöintiä, ja valinnaiset tehosteet tulevat takaisin, kun se jäähtyy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat menjadi hangat. Kaca terus dirender, dan efek opsional muncul kembali setelah dingin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy đang chạy ấm. Glass tiếp tục hiển thị và các hiệu ứng tùy chọn sẽ quay trở lại sau khi kính nguội."
          }
        }
      }
    },
