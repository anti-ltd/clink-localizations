    },
    "This device is on an older iOS, so the keys use a plain translucent material instead. No lens, no merge, no press bloom.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hierdie toestel is op 'n ouer iOS, so die sleutels gebruik eerder 'n gewone deurskynende materiaal. Geen lens, geen samesmelting, geen persbloei nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät läuft mit einem älteren iOS, deshalb nutzen die Tasten ein einfaches transparentes Material. Keine Linse, kein Verschmelzen, kein Aufblühen beim Tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo tiene una versión anterior de iOS, así que las teclas usan un material translúcido normal. Sin lente, sin fusión y sin destello al pulsar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See seade on vanemal iOS-il, seega kasutavad klahvid hoopis lihtsat läbipaistvat materjali. Läätsi pole, sulamist pole, vajutuse bloomi pole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil utilise une version plus ancienne d'iOS, donc les touches passent à un matériau translucide simple. Sans effet de lentille, sans fusion et sans floraison à l'appui."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen a készüléken régebbi iOS fut, ezért a gombok egyszerű áttetsző anyagot használnak. Nincs lencse, összeolvadás és lenyomási felvillanás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo ha una versione di iOS meno recente, quindi i tasti usano un semplice materiale traslucido. Niente lente, niente fusione, niente bagliore alla pressione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末は以前のiOSのため、キーは通常の半透明マテリアルで表示されます。レンズ効果も融合も、押した瞬間の広がりもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 이전 버전의 iOS라서 키가 일반 반투명 소재로 표시됩니다. 렌즈 효과도, 병합도, 누를 때의 번짐도 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peranti ini menggunakan iOS lama, jadi kekunci menggunakan bahan lut cahaya biasa. Tiada kesan kanta, tiada gabungan, tiada kembang ketika ditekan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está numa versão mais antiga do iOS, por isso as teclas usam um material translúcido simples. Sem lente, sem fusão e sem brilho ao tocar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве более старая версия iOS, поэтому клавиши используют обычный полупрозрачный материал. Без линзы, без слияния, без свечения при нажатии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备的 iOS 版本较旧，因此按键改用普通半透明材质。没有透镜、没有融合，按下时也不会绽放。"
          }
        }
      }
    },
    "This does not read a live keyboard or execute commands. Change the sample conditions, then preview the expected overrides.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no lee el teclado activo ni ejecuta comandos. Cambia las condiciones de ejemplo y previsualiza los cambios temporales previstos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet aperçu ne lit pas le clavier actif et n’exécute aucune commande. Modifie les conditions d’exemple, puis prévisualise les réglages temporaires attendus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschau liest keine Live-Tastatur und führt keine Befehle aus. Ändere die Beispielbedingungen und prüfe dann die erwarteten temporären Einstellungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anteprima non legge la tastiera attiva e non esegue comandi. Modifica le condizioni di esempio e visualizza le modifiche temporanee previste."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A pré-visualização não lê o teclado ativo nem executa comandos. Altera as condições de exemplo e vê as alterações temporárias previstas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпросмотр не считывает данные работающей клавиатуры и не выполняет команды. Измените пример условий и посмотрите ожидаемые временные настройки."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratonton tidak membaca papan kekunci langsung atau menjalankan arahan. Ubah syarat sampel, kemudian pratonton tetapan sementara yang dijangka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előnézet nem olvassa az élő billentyűzetet, és nem futtat parancsokat. Módosítsd a mintafeltételeket, majd nézd meg a várható ideiglenes beállításokat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動作中のキーボードを読み取ったり、コマンドを実行したりすることはありません。サンプルの条件を変更して、一時設定の予想結果を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此预览不会读取正在使用的键盘或执行命令。更改示例条件后，即可预览预期的临时设置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 키보드를 읽거나 명령을 실행하지 않습니다. 예시 조건을 변경한 다음 예상되는 임시 설정을 미리 보세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eelvaade ei loe töötava klaviatuuri olekut ega käivita käske. Muuda näidistingimusi ja vaata eeldatavaid ajutisi seadeid."
          }
        }
      }
    },
    "This draft has changed since the build started. Replace it with the result?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This draft has changed since the build started. Replace it with the result?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Entwurf wurde seit Beginn der Erstellung geändert. Durch das Ergebnis ersetzen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este borrador ha cambiado desde que empezó la creación. ¿Quieres sustituirlo por el resultado?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seda mustandit on pärast koostamise algust muudetud. Kas asendada see tulemusega?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce brouillon a été modifié depuis le début de la création. Le remplacer par le résultat ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a piszkozat a létrehozás indítása óta megváltozott. Lecseréled az eredményre?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa bozza è stata modificata dopo l’avvio della creazione. Vuoi sostituirla con il risultato?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成開始後にこの下書きが変更されました。結果で置き換えますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성을 시작한 후 이 초안이 변경되었습니다. 결과로 바꾸시겠습니까?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Draf ini telah berubah sejak pembinaan bermula. Gantikan dengan hasilnya?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este rascunho foi alterado desde o início da criação. Queres substituí-lo pelo resultado?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот черновик изменился после начала создания. Заменить его результатом?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此草稿在生成开始后已被修改。要用结果替换吗？"
          }
        }
      }
    },
    "This effect brings its own colors. The choice below applies to the other styles.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Effekt bringt eigene Farben mit. Die Auswahl unten gilt für die anderen Stile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este efecto trae sus propios colores. La opción de abajo se aplica a los demás estilos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellel efektil on oma värvid. Allolev valik kehtib teistele stiilidele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet effet a ses propres couleurs. Le choix ci-dessous s’applique aux autres styles."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek az effektnek saját színei vannak. Az alábbi választás a többi stílusra vonatkozik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo effetto ha i suoi colori. La scelta qui sotto vale per gli altri stili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエフェクトには独自の色があります。下の選択は他のスタイルに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 효과는 자체 색상을 사용합니다. 아래 선택은 다른 스타일에 적용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesan ini membawa warnanya sendiri. Pilihan di bawah digunakan untuk gaya lain."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este efeito traz as suas próprias cores. A opção abaixo aplica-se aos outros estilos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого эффекта свои цвета. Выбор ниже относится к остальным стилям."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此效果自带颜色。下方的选择适用于其他样式。"
          }
        }
      }
    },
