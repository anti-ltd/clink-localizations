    "Show a small glyph on each key previewing its first long-press alternate, and pick which corner of the cap it sits in.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wys 'n klein gly op elke sleutel en kyk na die eerste langdruk-alternatiewe, en kies in watter hoek van die dop dit sit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige auf jeder Taste ein kleines Symbol für ihre erste Gedrückthalten-Alternative und wähle die Ecke der Tastenkappe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra en cada tecla un pequeño símbolo con la primera alternativa de pulsación prolongada y elige en qué esquina aparece."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva igal klahvil väike sümbol, mis näitab selle esimest pikalt vajutamise alternatiivi, ja vali, millises klahvinurgas see asub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez sur chaque touche un petit symbole indiquant sa première variante d’appui prolongé et choisissez dans quel coin il apparaît."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeleníts meg minden billentyűn egy kis jelet az első hosszan nyomásos alternatívához, és válaszd ki a billentyűsapkán elfoglalt sarkát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra su ogni tasto un piccolo simbolo dell’alternativa del primo tocco prolungato e scegli in quale angolo posizionarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーに最初の長押し代替を示す小さな記号を表示し、キーキャップのどの角に置くかを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 키에 첫 번째 길게 누르기 대체 항목을 미리 보는 작은 기호를 표시하고 키캡의 어느 모서리에 둘지 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Paparkan pada setiap kekunci ikon kecil bagi alternatif tekan lama pertama dan pilih sudut letaknya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra em cada tecla um pequeno símbolo da primeira alternativa de toque longo e escolhe em que canto fica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите на каждой клавише маленький символ для первого варианта удержания и выберите угол клавиши, где он будет расположен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每个按键上显示一个小图标来预览其首个长按替代项，并选择它位于键帽的哪个角落。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișați un mic glif pe fiecare tastă, previzualând prima sa alternativă de apăsare lungă și alegeți în ce colț al capacului se află."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon een kleine glyph op elke toets, die een voorbeeld geeft van de eerste alternatieve toets die u lang indrukt, en kies in welke hoek van de dop deze zit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每個按鍵上顯示一個小圖示來預覽其首個長按替代項，並選擇它位於鍵帽的哪個角落。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż mały glif na każdym klawiszu, wyświetlając podgląd jego pierwszej alternatywy po długim naciśnięciu, i wybierz, w którym rogu nasadki się znajduje."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажіть маленький гліф на кожній клавіші, щоб переглянути її перше довготривале натискання, і виберіть, у якому куті кришки вона розташована."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her tuşun üzerinde ilk uzun basma alternatifinin ön izlemesini gösteren küçük bir glif gösterin ve bunun başlığın hangi köşesine oturacağını seçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukažte na každé klávese malý glyf s náhledem jejího prvního dlouhého stisku a vyberte, ve kterém rohu čepice sedí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukážte na každom klávese malý piktogram s ukážkou jeho prvého dlhého stlačenia a vyberte si, v ktorom rohu čiapky je umiestnený."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείξτε μια μικρή γλυφή σε κάθε πλήκτρο κάνοντας προεπισκόπηση της πρώτης εναλλακτικής παρατεταμένης πίεσης και επιλέξτε σε ποια γωνία του καλύμματος κάθεται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa en liten glyf på varje tangent och förhandsgranska dess första långtrycksalternativ och välj vilket hörn av locket den sitter i."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis en lille glyf på hver tast, og se en forhåndsvisning af dens første lang-tryk alternativ, og vælg hvilket hjørne af hætten den sidder i."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis en liten glyph på hver tast og forhåndsviser den første langtrykksalternativen, og velg hvilket hjørne av hetten den sitter i."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä pieni kuvio jokaisessa näppäimessä esikatsellaksesi sen ensimmäistä pitkään painallusvaihtoehtoa ja valitse, missä suojuksen kulmassa se on."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan mesin terbang kecil di setiap tombol yang mempratinjau tombol tekan lama yang pertama, dan pilih di sudut mana tombol itu berada."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị một hình tượng nhỏ trên mỗi phím để xem trước lần thay thế nhấn và giữ đầu tiên của nó và chọn góc nào của nắp mà nó nằm."
          }
        }
      }
    },
