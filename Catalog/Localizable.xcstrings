    "Tap to preview. You can change it anytime.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om voorbeskou. Jy kan dit enige tyd verander."
          }
        },
        "de": {
