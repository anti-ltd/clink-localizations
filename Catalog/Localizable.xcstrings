    "Compute delay 200ms. Fewer checks, best battery.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechenverzögerung 200 ms. Weniger Prüfungen, beste Akkulaufzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retardo de cálculo 200ms. Menos comprobaciones, mejor batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai de calcul de 200 ms. Moins de vérifs, meilleure autonomie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Számítási késleltetés 200 ms. Kevesebb ellenőrzés, kímélőbb az akkuval."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritardo di calcolo 200ms. Meno controlli, più batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算の間隔は200ms。チェックが少なく、バッテリーにいちばんやさしい設定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산 지연 200ms. 검사를 덜 하고 배터리가 제일 오래가요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengah kiraan 200ms. Kurang semakan, bateri paling jimat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atraso de cálculo de 200ms. Menos verificações, melhor bateria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержка вычисления 200 мс. Меньше проверок, лучше для батареи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算延迟 200ms。检查更少，最省电。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvutuse viive 200 ms. Vähem kontrolle, parim aku."
          }
        },
        "af": {
          "stringUnit": {
