    "Both accents and a symbol on every letter’s long-press (A → á à â … @)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akzente und ein Symbol beim langen Drücken jedes Buchstabens (A → á à â … @)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acentos y un símbolo en cada pulsación larga de letra (A → á à â … @)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des accents et un symbole sur l'appui long de chaque lettre (A → á à â … @)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ékezetek és egy szimbólum is minden betű hosszú lenyomásán (A → á à â … @)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
