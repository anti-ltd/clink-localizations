    "Your tweaks since you applied %@ will be lost.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou aanpassings sedert jy %@ toegepas het, sal verlore gaan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Anpassungen seit dem Anwenden von %@ gehen verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perderán los ajustes que hayas hecho desde que aplicaste %@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu kohandused pärast %@ rakendamist lähevad kaotsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes ajustements depuis l'application de %@ seront perdus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ alkalmazása óta végzett finomhangolásaid elvesznek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche apportate da quando hai applicato %@ andranno perse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を適用してから行った調整は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 적용한 이후의 조정 내용이 사라져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelarasan anda sejak anda menggunakan %@ akan hilang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus ajustes desde que aplicaste %@ vão perder-se."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения, сделанные после применения «%@», будут потеряны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自从应用 %@ 之后做的调整都会丢失。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările dvs. de când ați aplicat %@ se vor pierde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aanpassingen sinds je %@ hebt toegepast, gaan verloren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自從應用 %@ 之後做的調整都會丟失。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zmiany wprowadzone od czasu zastosowania %@ zostaną utracone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші налаштування після застосування %@ буде втрачено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'i uyguladığınızdan beri yaptığınız ince ayarlar kaybolacak."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše vylepšení od použití %@ budou ztracena."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše vylepšenia od aplikovania %@ sa stratia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τροποποιήσεις σας από τότε που εφαρμόσατε το %@ θα χαθούν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina justeringar sedan du använde %@ kommer att gå förlorade."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine tweaks siden du anvendte %@ vil gå tabt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpasningene dine siden du brukte %@ vil gå tapt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:n käyttöönoton jälkeen tekemäsi mukautukset menetetään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan Anda sejak menerapkan %@ akan hilang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các chỉnh sửa của bạn kể từ khi bạn áp dụng %@ sẽ bị mất."
          }
        }
      }
    },
