          "stringUnit": {
            "state": "translated",
            "value": "Hoia kopeeritud pildid ajaloost eemal. Kopeeritud tekst salvestatakse ikka."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images copiées n'entrent pas dans l'historique. Le texte copié, si."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A másolt képek nem kerülnek az előzményekbe. A másolt szöveg igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini copiate non entrano nella cronologia. Il testo copiato sì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーした画像は履歴に残しません。テキストはこれまでどおり保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 이미지는 기록에 남기지 않아요. 복사한 텍스트는 그대로 저장해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imej yang disalin tak masuk sejarah. Teks yang disalin tetap disimpan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens copiadas não entram no histórico. O texto copiado continua a ser guardado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не пускать скопированные изображения в историю. Текст по-прежнему сохраняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制的图片不进历史记录，复制的文字照常保存。"
          }
        }
      }
    },
    "Keep dictation on (for a custom mic key) but remove it from the panel button / slide-up list.": {
