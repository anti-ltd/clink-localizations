    "Enter owner/repository, github.com/owner/repository, or the full HTTPS URL. Clink verifies every release manifest and file before anything can be downloaded.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce owner/repository, github.com/owner/repository o la URL HTTPS completa. Clink verifica cada manifiesto y archivo de versión antes de permitir cualquier descarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis owner/repository, github.com/owner/repository ou l’URL HTTPS complète. Clink vérifie chaque manifeste et chaque fichier de version avant tout téléchargement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib owner/repository, github.com/owner/repository oder die vollständige HTTPS-URL ein. Clink prüft jedes Release-Manifest und jede Datei, bevor etwas geladen wird."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci owner/repository, github.com/owner/repository o l’URL HTTPS completo. Clink verifica ogni manifest di release e ogni file prima di consentire qualsiasi download."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduz owner/repository, github.com/owner/repository ou o URL HTTPS completo. O Clink verifica todos os manifestos de versão e ficheiros antes de qualquer transferência."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan owner/repository, github.com/owner/repository atau URL HTTPS penuh. Clink mengesahkan setiap manifes keluaran dan fail sebelum apa-apa boleh dimuat turun."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg owner/repository, github.com/owner/repository formában vagy a teljes HTTPS-URL-t. A Clink minden kiadási jegyzéket és fájlt ellenőriz, mielőtt bármit letöltene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "owner/repository、github.com/owner/repository、または完全な HTTPS URL を入力してください。Clink は、何かをダウンロードする前にすべてのリリースマニフェストとファイルを検証します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 owner/repository、github.com/owner/repository 或完整的 HTTPS URL。在下载任何内容之前，Clink 都会验证每个发布清单和文件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "owner/repository, github.com/owner/repository 또는 전체 HTTPS URL을 입력하세요. Clink는 무엇이든 다운로드하기 전에 모든 릴리스 매니페스트와 파일을 검증합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisesta owner/repository, github.com/owner/repository või täielik HTTPS-i URL. Clink kontrollib iga väljalaske manifesti ja faili, enne kui midagi saab alla laadida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите owner/repository, github.com/owner/repository или полный HTTPS-URL. Clink проверяет каждый манифест релиза и каждый файл, прежде что-либо можно будет загрузить."
          }
        }
      }
    },
