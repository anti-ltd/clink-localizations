    "Swipe up on the Return key to change language. The keys change with it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiep op op die Return-sleutel om taal te verander. Die sleutels verander daarmee saam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streich auf der Eingabetaste nach oben, um die Sprache zu wechseln. Die Tasten wechseln mit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia arriba en la tecla de retorno para cambiar de idioma. Las teclas cambian con él."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viipa sisestusklahvil üles, et keelt vahetada. Klahvid vahetuvad kaasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaie vers le haut sur la touche Retour pour changer de langue. Les touches changent avec elle."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd felfelé az Enteren a nyelvváltáshoz. A billentyűk vele együtt váltanak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri verso l’alto sul tasto Invio per cambiare lingua. I tasti cambiano con lei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リターンキーを上にスワイプすると言語が切り替わります。キーもいっしょに変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Return 키를 위로 쓸어올리면 언어가 바뀝니다. 키도 함께 바뀝니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret ke atas pada kekunci Return untuk menukar bahasa. Kekuncinya bertukar sekali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para cima na tecla Return para mudar de idioma. As teclas mudam com ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните вверх по клавише Return, чтобы сменить язык. Клавиши поменяются вместе с ним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Return 键上向上轻扫即可切换语言，按键也会跟着换。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisați în sus pe tasta Return pentru a schimba limba. Cheile se schimbă odată cu el."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg omhoog over de Return-toets om de taal te wijzigen. De sleutels veranderen mee."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Return 鍵上向上輕掃即可切換語言，按鍵也會跟著換。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń w górę klawisz Return, aby zmienić język. Wraz z nim zmieniają się klawisze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведіть пальцем угору по клавіші Return, щоб змінити мову. З ним змінюються ключі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dili değiştirmek için Return tuşunu yukarı kaydırın. Tuşlar onunla birlikte değişir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li změnit jazyk, přejeďte prstem nahoru po klávese Return. S ním se mění i klíče."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazyk zmeníte potiahnutím nahor po klávese Return. S ním sa menia aj kľúče."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε προς τα πάνω στο πλήκτρο Return για να αλλάξετε γλώσσα. Τα κλειδιά αλλάζουν μαζί του."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep uppåt på returtangenten för att ändra språk. Nycklarna ändras med det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stryg op på returtasten for at skifte sprog. Nøglerne ændres med det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip opp på returtasten for å endre språk. Nøklene endres med det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda kieltä pyyhkäisemällä ylös paluunäppäimellä. Avaimet vaihtuvat sen mukana."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser ke atas pada tombol Kembali untuk mengubah bahasa. Kuncinya berubah seiring dengan itu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt lên trên phím Return để thay đổi ngôn ngữ. Các phím thay đổi với nó."
          }
        }
      }
    },
