    "There are no keys, just a mic and something asking me to buy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Tasten, nur ein Mikrofon und eine Kaufaufforderung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay teclas, solo un micro y algo que me pide comprar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a plus de touches, juste un micro et une proposition d'achat"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincsenek billentyűk, csak egy mikrofon és valami, ami vásárlásra kér"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono tasti, solo un microfono e qualcosa che mi chiede di comprare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーがなく、マイクと購入を促す表示だけが出ます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 없고 마이크와 구매하라는 안내만 보여요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada kekunci, hanya mikrofon dan sesuatu yang meminta saya membeli"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há teclas, só um micro e algo a pedir-me para comprar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиш нет — только микрофон и предложение что-то купить"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有按键，只有一个麦克风和让我购买的提示"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahve pole, ainult mikrofon ja midagi, mis palub osta"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Daar is geen sleutels nie, net 'n mikrofoon en iets wat my vra om te koop"
          }
        }
      }
    },
    "There are two, depending on how you're holding the phone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt zwei, je nachdem, wie du das Telefon hältst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay dos, según cómo sujetes el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y en a deux, selon la façon dont tu tiens le téléphone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kettő is van, attól függően, hogyan fogod a telefont."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce ne sono due, a seconda di come tieni il telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "持ち方に応じて2種類あります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 어떻게 쥐느냐에 따라 두 가지가 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada dua, bergantung pada cara anda memegang telefon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Há dois, conforme a forma como pegas no telemóvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Их два — в зависимости от того, как вы держите телефон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有两种，看你怎么拿手机。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Neid on kaks, olenevalt sellest, kuidas sa telefoni hoiad."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Daar is twee, afhangend van hoe jy die foon vashou."
          }
        }
      }
    },
    "There is no Clink cloud and no sync account.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Clink-Cloud und kein Sync-Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna nube de Clink ni cuenta de sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de cloud Clink ni de compte de synchronisation."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs Clink-felhő és nincs szinkronfiók."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è nessun cloud Clink e nessun account di sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink のクラウドも、同期用のアカウントもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 클라우드도, 동기화 계정도 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada awan Clink dan tiada akaun segerak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nuvem do Clink nem conta de sincronização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никакого облака Clink и аккаунта для синхронизации не существует."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
