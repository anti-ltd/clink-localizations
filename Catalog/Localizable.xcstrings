          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份备份里没有可以恢复的内容。"
          }
        }
      }
    },
    "Nothing is charged for 7 days. Cancel anytime.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niks word vir 7 dae gehef nie. Kanselleer enige tyd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "7 Tage lang wird nichts abgebucht. Jederzeit kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se cobra nada durante 7 días. Cancela cuando quieras."
          }
        },
        "et": {
