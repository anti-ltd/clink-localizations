    "Not written down here? Search your own question and Apple Intelligence answers it from this page.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie hier neergeskryf nie? Soek jou eie vraag en Apple Intelligence beantwoord dit vanaf hierdie bladsy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steht hier nicht? Such deine eigene Frage — Apple Intelligence beantwortet sie aus dieser Seite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No está escrito aquí? Busca tu propia pregunta y Apple Intelligence la responde a partir de esta página."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Siin pole kirjas? Otsi oma küsimust ja Apple Intelligence vastab sellelt lehelt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas écrit ici ? Cherche ta propre question : Apple Intelligence y répond à partir de cette page."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs itt leírva? Keress rá a saját kérdésedre, és az Apple Intelligence ebből az oldalból válaszol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è scritto qui? Cerca la tua domanda e Apple Intelligence risponde partendo da questa pagina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに書かれていない場合は、自分の質問を検索してください。Apple Intelligenceがこのページをもとに答えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 없나요? 직접 질문을 검색하면 Apple Intelligence가 이 페이지를 바탕으로 답합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada tertulis di sini? Cari soalan anda sendiri dan Apple Intelligence menjawabnya daripada halaman ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está escrito aqui? Procura a tua própria pergunta e a Apple Intelligence responde a partir desta página."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь про это не написано? Задайте свой вопрос в поиске — Apple Intelligence ответит на него по этой странице."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里没写？直接搜你自己的问题，Apple Intelligence 会依据本页作答。"
          }
        }
      }
    },
