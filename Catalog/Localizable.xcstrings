    "Nudge each tap toward where you mean to hit. No effect until enough is learned": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk elke tik na die plek waar jy wil slaan. Geen effek totdat genoeg geleer is nie"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiebt jeden Tipp dorthin, wo du treffen willst. Keine Wirkung, bis genug gelernt ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja cada toque hacia donde querías dar. Sin efecto hasta que aprenda lo suficiente"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Nihuta iga vajutust sinna, kuhu tabada tahtsid. Mõju puudub, enne kui on piisavalt õpitud"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste chaque appui vers l'endroit que tu vises. Aucun effet tant que le clavier n'a pas assez appris"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden koppintást afelé tol, ahová célzol. Nincs hatása, amíg elég adat össze nem gyűlik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta ogni tocco verso dove vuoi colpire. Nessun effetto finché non ha imparato abbastanza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各タップを、狙った場所に寄せます。十分に学習するまでは効果がありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 탭을 노리는 곳으로 살짝 밀어줘요. 충분히 배우기 전까진 효과가 없어요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tolak setiap ketikan ke arah tempat anda nak kena. Tiada kesan sehingga cukup dipelajari"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurra cada toque para onde querias acertar. Sem efeito até aprender o suficiente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтягивать каждое нажатие туда, куда вы целитесь. Ничего не изменится, пока не накопится достаточно данных"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把每次点按往你真正想点的位置推一点。学得不够多时没效果"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Împingeți fiecare atingere spre locul în care doriți să loviți. Niciun efect până când nu se învață suficient"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef elke tik een duwtje in de richting van de plek waar je wilt slaan. Geen effect totdat er genoeg is geleerd"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把每次點按往你真正想點的位置推一點。學得不夠多時沒效果"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuwaj każde dotknięcie w stronę miejsca, w którym chcesz trafić. Żadnego efektu, dopóki nie nauczysz się wystarczająco dużo"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне натискання штовхайте туди, куди ви збираєтеся вдарити. Немає ефекту, доки не буде вивчено достатньо"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her dokunuşta vurmak istediğiniz yere doğru itin. Yeterince öğrenilene kadar etkisi yok"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuňte každé klepnutí směrem, kam chcete zasáhnout. Žádný efekt, dokud se dostatečně nenaučí"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuňte každé klepnutie smerom, kam chcete udrieť. Žiadny účinok, kým sa dostatočne nenaučí"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σπρώξτε κάθε πάτημα προς το σημείο που θέλετε να χτυπήσετε. Κανένα αποτέλεσμα μέχρι να μαθευτεί αρκετά"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Knuffa varje tryck mot där du vill slå. Ingen effekt förrän tillräckligt mycket är inlärt"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skub hvert tryk mod det sted, hvor du vil slå. Ingen effekt før nok er lært"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skyv hvert trykk mot der du ønsker å slå. Ingen effekt før nok er lært"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työnnä jokaista napausta kohti kohtaa, johon aiot lyödä. Ei vaikutusta ennen kuin on opittu tarpeeksi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorong setiap ketukan ke arah yang ingin Anda pukul. Tidak ada efek sampai cukup dipelajari"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đẩy từng lần nhấn về phía nơi bạn muốn đánh. Không có tác dụng cho đến khi học đủ"
          }
        }
      }
    },
