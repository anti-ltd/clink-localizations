    "Flick straight down on a key to insert its first long-press variant instantly.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische auf einer Taste direkt nach unten, um sofort ihre erste Langdruck-Variante einzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza directamente hacia abajo sobre una tecla para insertar al instante su primera variante de pulsación larga."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Libista sõrmega otse allapoole klahvil, et sisestada kohe selle esimene pika vajutuse variant."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez directement vers le bas sur une touche pour insérer instantanément sa première variante d'appui long."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csúsztasd lefelé egy billentyűn, hogy azonnal beilleszd annak első hosszú nyomásos változatát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri dritto verso il basso su un tasto per inserire all'istante la sua prima variante con pressione prolungata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーをまっすぐ下にフリックすると、そのキーの長押しの最初のバリエーションが即座に入力されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키에서 곧장 아래로 플릭하면 길게 누르기의 첫 번째 변형이 즉시 입력됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret terus ke bawah pada kekunci untuk memasukkan varian tekan lama pertamanya serta-merta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize diretamente para baixo numa tecla para inserir instantaneamente a sua primeira variante de pressão prolongada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在按键上直接向下轻扫，可立即输入其第一个长按变体。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите по клавише прямо вниз, чтобы мгновенно вставить первый вариант её долгого нажатия."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blaai reguit af op 'n sleutel om sy eerste langdrukvariant onmiddellik in te voeg."
          }
        }
      }
    },
