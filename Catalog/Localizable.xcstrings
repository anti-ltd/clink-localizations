    "Copy the text below. Speed uses correct characters; every five counts as one word.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe den Text unten ab. Für das Tempo zählen nur richtige Zeichen. Je fünf Zeichen ergeben ein Wort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the text below. Speed uses correct characters; every five counts as one word."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia el texto de abajo. La velocidad se calcula con los caracteres correctos: cada cinco cuentan como una palabra."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjuta allolev tekst ümber. Kiirust arvutatakse õigesti sisestatud märkide järgi: viis märki loetakse üheks sõnaks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recopie le texte ci-dessous. La vitesse est calculée à partir des caractères corrects : cinq caractères comptent pour un mot."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Másold le az alábbi szöveget. A sebességet a helyesen beírt karakterekből számítjuk: öt karakter egy szónak felel meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricopia il testo qui sotto. La velocità si basa sui caratteri corretti: ogni cinque caratteri contano come una parola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の文章を入力してください。正しく入力した文字で速度を計算し、5文字を1語として数えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 문장을 그대로 입력해 주세요. 속도는 정확히 입력한 글자를 기준으로 계산하며, 다섯 글자를 한 단어로 셉니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip semula teks di bawah. Kelajuan dikira berdasarkan aksara yang betul; setiap lima aksara dikira sebagai satu perkataan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia o texto abaixo. A velocidade é calculada a partir dos caracteres corretos: cada cinco contam como uma palavra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перепечатайте текст ниже. Скорость рассчитывается по верно набранным символам: каждые пять символов считаются одним словом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照着下方的文字输入。速度按正确输入的字符计算，每5个字符计为一个词。"
          }
        }
      }
    },
