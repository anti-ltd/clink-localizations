    "Wipe clipboard or notepad from each panel's settings.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vee knipbord of notaboek uit elke paneel se instellings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenablage oder Notizblock leerst du in den Einstellungen des jeweiligen Panels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacía el portapapeles o el bloc desde los ajustes de cada panel."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tühjenda lõikelaud või märkmik iga paneeli seadetest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vide le presse-papiers ou le bloc-notes depuis les réglages de chaque panneau."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágólapot vagy a jegyzettömböt az adott panel beállításaiból törölheted."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota gli appunti o il blocco note dalle impostazioni di ogni pannello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードやメモは、それぞれのパネルの設定から消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드나 메모장은 각 패널 설정에서 지울 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam papan keratan atau notepad dari tetapan setiap panel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa a área de transferência ou o bloco de notas nas definições de cada painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить буфер обмена или блокнот можно в настройках соответствующей панели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在各个面板的设置里清空剪贴板或记事本。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ștergeți clipboard-ul sau blocnotesul din setările fiecărui panou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wis het klembord of notitieblok uit de instellingen van elk paneel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在各個面板的設定裡清空剪貼簿或記事本。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyczyść schowek lub notatnik z ustawień każdego panelu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистіть буфер обміну або блокнот із налаштувань кожної панелі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her panelin ayarlarından panoyu veya not defterini silin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymažte schránku nebo poznámkový blok z nastavení každého panelu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymažte schránku alebo poznámkový blok z nastavení každého panela."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σκουπίστε το πρόχειρο ή το σημειωματάριο από τις ρυθμίσεις κάθε πίνακα."
          }
        },
        "sv": {
          "stringUnit": {
