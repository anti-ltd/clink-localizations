          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vagy kapcsold ki a világítást a Hatások oldalon, és a Háttérben az effektet — ez a kettő a nagy fogyasztó."
          }
        },
        "it": {
          "stringUnit": {
