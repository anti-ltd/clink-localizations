    "You have Clink Lifetime. Thanks for supporting Clink.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes Clink de por vida. Gracias por apoyar Clink."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as Clink à vie. Merci de soutenir Clink."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast Clink auf Lebenszeit. Danke, dass du Clink unterstützt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai Clink a vita. Grazie per il tuo sostegno."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem Clink vitalício. Obrigado por apoiar o Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас пожизненный доступ к Clink. Спасибо за поддержку!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda memiliki Clink seumur hidup. Terima kasih kerana menyokong Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink örökre a tiéd. Köszönjük, hogy támogatod a Clinket."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkを無期限でご利用いただけます。Clinkへのご支援ありがとうございます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已拥有 Clink 终身版。感谢你支持 Clink。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 평생 이용권을 보유하고 계십니다. Clink를 지원해 주셔서 감사합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul on Clinki eluaegne juurdepääs. Täname Clinki toetamise eest."
          }
        }
      }
    },
    "You slide instead of tapping, one word per stroke.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jy gly in plaas van om te tik, een woord per slag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statt zu tippen, ziehst du: ein Wort pro Zug."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En vez de tocar, deslizas: una palabra por trazo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa libised vajutamise asemel, üks sõna liugude kohta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au lieu de taper, tu glisses : un mot par tracé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintás helyett húzol: egy szó egy vonással."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invece di toccare, scorri: una parola per tratto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップの代わりになぞって、ひと続きで1語を入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두드리는 대신 밀어서, 한 번에 한 단어씩 씁니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda meleret dan bukan mengetik: satu perkataan bagi setiap lerekan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em vez de tocar, deslizas: uma palavra por traço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не нажимаете, а ведёте пальцем — по слову за движение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不用一个个点，改成划：一笔一个词。"
          }
        }
      }
    },
    "You were here before Clink was free. It's yours for life. Thank you.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jy was hier voor Clink vry was. Dit is joune lewenslank. Dankie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du warst dabei, bevor Clink kostenlos wurde. Für dich bleibt alles für immer frei. Danke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estuviste aquí antes de que Clink fuera gratis. Es tuyo para siempre. Gracias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa olid siin enne, kui Clink läks tasuta. Ta on sinu eluaegselt. Aitäh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu étais là avant que Clink soit gratuit. Il est à toi pour toujours. Merci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már akkor itt voltál, amikor a Clink még nem volt ingyenes. Örökre a tiéd. Köszönöm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'eri prima che Clink diventasse gratis. È tuo per sempre. Grazie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkが無料になる前からいてくれました。ずっとあなたのものです。ありがとう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink가 무료가 되기 전부터 함께해 주셨어요. 평생 사용할 수 있어요. 고맙습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda ada sebelum Clink menjadi percuma. Semuanya milik anda selamanya. Terima kasih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiveste aqui antes de o Clink ser grátis. É teu para sempre. Obrigado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы были здесь, когда Clink ещё не был бесплатным. Он ваш навсегда. Спасибо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Clink 免费之前，你就已经在这里。它永远属于你。谢谢。"
          }
        }
      }
    },
