    "This plugin isn't installed or is switched off. The key stays empty until it's back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Plugin ist nicht installiert oder ausgeschaltet. Die Taste bleibt leer, bis es zurück ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plugin no está instalado o está desactivado. La tecla queda vacía hasta que vuelva."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See pistikprogramm pole paigaldatud või on välja lülitatud. Klahv jääb tühjaks, kuni see naaseb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce plugin n'est pas installé ou est désactivé. La touche reste vide jusqu'à son retour."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a bővítmény nincs telepítve, vagy ki van kapcsolva. A billentyű üres marad, amíg vissza nem kerül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo plugin non è installato o è disattivato. Il tasto resta vuoto finché non torna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプラグインは入っていないか、オフになっています。戻るまでキーは空のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 플러그인이 설치되어 있지 않거나 꺼져 있습니다. 돌아올 때까지 키는 비어 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugin ini tidak dipasang atau dimatikan. Kekunci kekal kosong sehingga ia kembali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plugin não está instalado ou está desligado. A tecla fica vazia até voltar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот плагин не установлен или выключен. Клавиша останется пустой, пока он не вернётся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此插件未安装或已关闭。在它回来之前，这个键会保持空白。"
          }
        }
      }
    },
    "This plugin runs automatically when its conditions match.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Plugin wird automatisch ausgeführt, wenn seine Bedingungen erfüllt sind."
          }
        },
        "es": {
          "stringUnit": {
