    "Linger 100ms · repeat after 600ms, 150→60ms. Calm & forgiving.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verlang 100ms · herhaal na 600ms, 150→60ms. Kalm & vergewensgesind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "100ms Verweilen · Wiederholung nach 600ms, 150→60ms. Ruhig und nachsichtig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera 100ms · repite tras 600ms, 150→60ms. Tranquilo e indulgente."
          }
        },
