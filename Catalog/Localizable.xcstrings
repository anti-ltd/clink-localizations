    "No bloom · no lean · firm 0.12s springs. Flattest, most static.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen blom · geen maer · ferm 0.12s vere. Platste, mees statiese."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Aufleuchten · keine Neigung · feste 0,12-s-Federn. Am flachsten und statischsten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin brillo · sin inclinación · resortes firmes de 0,12 s. El más plano y estático."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloomi pole · kallet pole · kindlad 0,12 s vedrud. Kõige lame ja staatilisem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun éclat · aucune inclinaison · ressorts fermes de 0,12 s. Le plus plat et le plus statique."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs duzzadás · nincs dőlés · feszes, 0,12 mp-es rugók. A leglaposabb, legmozdulatlanabb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente bagliore · niente inclinazione · molle rigide da 0,12 s. Il più piatto e statico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブルームなし · 傾きなし · 硬い0.12秒のスプリング。いちばんフラットで動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "블룸 없음 · 기울임 없음 · 단단한 0.12초 스프링. 가장 평평하고 움직임이 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada kembang · tiada condong · spring tegas 0.12s. Paling rata, paling statik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem brilho · sem inclinação · molas firmes de 0,12 s. O mais plano e estático."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без свечения · без наклона · жёсткие пружины 0,12 с. Самый плоский и статичный вариант."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无光晕 · 无倾斜 · 0.12 秒硬弹簧。最平、最静。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără înflorire · fără slabă · primăvară fermă de 0,12 s. Cel mai plat, cel mai static."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen bloei · geen mager · stevige 0,12s veren. Het platste, meest statische."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無光暈 · 無傾斜 · 0.12 秒硬彈簧。最平、最靜。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak rozkwitu · brak chudości · twarde sprężyny 0,12 s. Najbardziej płaski, najbardziej statyczny."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає цвітіння · немає худого · міцні пружини 0,12 с. Найплоскіший, найбільш статичний."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çiçeklenme yok · yalın yok · 0,12 saniyelik sert yaylar. En düz, en statik."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné květy · žádné štíhlé · pevné 0,12s pružiny. Nejplošší, nejstatičtější."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez kvitnutia · bez štíhlosti · pevné 0,12s pružiny. Najplošší, najstatickejší."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς άνθιση · χωρίς άπαχο · σταθερά ελατήρια 0,12s. Το πιο επίπεδο, το πιο στατικό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen blomning · ingen mager · fasta 0,12s fjädrar. Plattast, mest statisk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen blomstring · ingen mager · faste 0,12s fjedre. Fladeste, mest statiske."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen blomstring · ingen mager · faste 0,12s fjærer. Flatest, mest statisk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei kukintaa · ei laihaa · kiinteät 0,12s jouset. Tasaisin, staattisin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak mekar · tidak ramping · pegas 0,12 detik yang kokoh. Paling datar, paling statis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không nở · không nạc · lò xo chắc chắn 0,12s. Bằng phẳng nhất, tĩnh nhất."
          }
        }
      }
    },
