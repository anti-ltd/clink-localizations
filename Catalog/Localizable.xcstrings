    "Couldn't confirm it's you, so the contents stayed hidden.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon nie bevestig dat dit jy is nie, so die inhoud het versteek gebly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten nicht bestätigen, dass du es bist – der Inhalt bleibt verborgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido confirmar que eres tú, así que el contenido sigue oculto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei saanud kinnitada, et see oled sina, seega sisu jäi peidetud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de confirmer que c’est bien toi : le contenu est resté masqué."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült igazolni, hogy te vagy az, ezért a tartalom rejtve maradt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile confermare che sei tu, quindi il contenuto è rimasto nascosto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人であることを確認できなかったため、内容は表示していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인 확인에 실패해 내용을 표시하지 않았습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengesahkan bahawa ini anda, jadi kandungannya kekal tersembunyi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar que és tu, por isso o conteúdo ficou oculto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить, что это вы, поэтому содержимое осталось скрытым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认是你本人，内容已保持隐藏。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am putut confirma că sunteți dvs., așa că conținutul a rămas ascuns."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon niet bevestigen dat jij het bent, dus de inhoud bleef verborgen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認是你本人，內容已保持隱藏。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mogliśmy potwierdzić, że to Ty, więc treść pozostała ukryta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося підтвердити, що це ви, тому вміст залишився прихованим."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz olduğunuz doğrulanamadığı için içerik gizli kaldı."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se potvrdit, že jste to vy, takže obsah zůstal skrytý."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa potvrdiť, že ste to vy, takže obsah zostal skrytý."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η επιβεβαίωση ότι είστε εσείς, επομένως το περιεχόμενο παρέμεινε κρυφό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att bekräfta att det är du, så innehållet förblev dolt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke bekræfte, at det var dig, så indholdet forblev skjult."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke bekrefte at det er deg, så innholdet forble skjult."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Henkilöllisyyttäsi ei voitu vahvistaa, joten sisältö pysyi piilossa."
          }
        },
        "id": {
