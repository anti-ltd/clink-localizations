            "state": "translated",
            "value": "Satu dial mengubahnya dari bulat penuh menjadi bermata persegi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một mặt số chuyển chúng từ tròn hoàn toàn sang cạnh vuông."
          }
        }
      }
    },
    "One full-width row per action — roomier for longer names.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fila de ancho completo por acción, con más espacio para nombres largos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ligne sur toute la largeur par action, avec plus de place pour les noms longs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zeile über die ganze Breite pro Aktion – mehr Platz für lange Namen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riga a tutta larghezza per ogni azione, con più spazio per i nomi lunghi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma fila de largura total por ação, com mais espaço para nomes longos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое действие занимает строку во всю ширину — больше места для длинных названий."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu baris selebar panel bagi setiap tindakan, dengan lebih ruang untuk nama panjang."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Műveletenként egy teljes szélességű sor, több hellyel a hosszú neveknek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションごとに横幅いっぱいの行を使い、長い名前も表示しやすくします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每项操作独占一整行，长名称也有足够空间。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동작마다 전체 너비의 행을 사용해 긴 이름도 여유 있게 표시합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga toiming on täislaiuses real – rohkem ruumi pikkadele nimedele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rând pe toată lățimea per acțiune — mai spațios pentru nume mai lungi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén rij over de volledige breedte per actie – ruimer voor langere namen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每項操作獨佔一整行，長名稱也有足夠空間。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Een volle breedte ry per aksie — ruimer vir langer name."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden rząd o pełnej szerokości na akcję — więcej miejsca w przypadku dłuższych nazw."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один рядок повної ширини для кожної дії — просторіше для довших імен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem başına bir tam genişlikte satır; daha uzun adlar için daha geniştir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna celá řada na akci – prostornější pro delší názvy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden riadok s plnou šírkou na akciu – priestrannejší pre dlhšie názvy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μία σειρά πλήρους πλάτους ανά ενέργεια — πιο ευρύχωρη για μεγαλύτερα ονόματα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En fullbreddsrad per åtgärd — rymligare för längre namn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En række i fuld bredde pr. handling - mere rummelig for længere navne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én rad i full bredde per handling – romsligere for lengre navn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi täysleveä rivi toimintoa kohden – tilavampi pitemmille nimille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu baris dengan lebar penuh per tindakan — lebih luas untuk nama yang lebih panjang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một hàng có chiều rộng đầy đủ cho mỗi hành động — rộng rãi hơn cho các tên dài hơn."
          }
        }
      }
    },
    "One glide can read as several words: a phrase or a whole sentence without touching space.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Geste kann mehrere Wörter ergeben: eine Wendung oder ein ganzer Satz, ohne die Leertaste zu berühren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo trazo puede leerse como varias palabras: una frase o una oración entera sin tocar el espacio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üks libistus võib anda mitu sõna: fraasi või terve lause ilma tühikut puudutamata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul glissé peut donner plusieurs mots : une expression ou une phrase entière sans toucher l’espace."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy húzás több szót is jelenthet: egy kifejezést vagy egy egész mondatot a szóköz érintése nélkül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo scorrimento può diventare più parole: una frase o un’intera proposizione senza toccare lo spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回のスワイプで複数の単語を入力できます。スペースに触れずに句や文全体を書けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 스와이프로 여러 단어를 입력할 수 있습니다. 스페이스를 누르지 않고 구나 문장 전체를 쓸 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu leretan boleh dibaca sebagai beberapa perkataan: frasa atau seluruh ayat tanpa menyentuh ruang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um único deslizar pode virar várias palavras: uma expressão ou uma frase inteira sem tocar no espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один свайп может дать несколько слов: фразу или целое предложение без нажатия пробела."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次滑行可以识别为多个词：不碰空格也能输入短语或整句。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O glisare poate citi ca mai multe cuvinte: o frază sau o propoziție întreagă fără a atinge spațiul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén glijdende beweging kan als meerdere woorden worden gelezen: een zin of een hele zin zonder de spatie aan te raken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次滑行可以識別為多個詞：不碰空格也能輸入短語或整句。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Een glybalk kan as verskeie woorde lees: 'n frase of 'n hele sin sonder om spasie te raak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden slajd można odczytać jako kilka słów: frazę lub całe zdanie bez dotykania spacji."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один слайд можна читати як кілька слів: фразу або ціле речення без пробілу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kaydırma birkaç kelime olarak okunabilir: bir cümle veya boşluğa dokunmadan bir cümlenin tamamı."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno tažení může číst jako několik slov: frázi nebo celou větu, aniž byste se dotkli mezery."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno potiahnutie môže čítať ako niekoľko slov: frázu alebo celú vetu bez toho, aby ste sa dotkli medzery."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ολίσθηση μπορεί να διαβαστεί ως πολλές λέξεις: μια φράση ή μια ολόκληρη πρόταση χωρίς να αγγίζει το κενό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En glidning kan läsas som flera ord: en fras eller en hel mening utan att röra mellanslag."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et glid kan læses som flere ord: en sætning eller en hel sætning uden at røre mellemrum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En gli kan leses som flere ord: en setning eller en hel setning uten å berøre mellomrom."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi liuku voi lukea useana sanana: lauseen tai kokonaisen lauseen koskematta tilaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu luncuran dapat dibaca sebagai beberapa kata: satu frase atau satu kalimat utuh tanpa menyentuh spasi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần lướt có thể đọc thành nhiều từ: một cụm từ hoặc cả câu mà không cần chạm vào dấu cách."
          }
        }
      }
    },
