          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuur ja emotikonid on igas rakenduses tasuta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier et les emojis sont gratuits dans chaque app"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzet és az emodzsik minden alkalmazásban ingyenesek"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
