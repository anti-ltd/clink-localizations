    "Swipe horizontally through up to ten suggestions instead of showing only three.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza horizontalmente para ver hasta diez sugerencias en vez de solo tres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais défiler jusqu’à dix suggestions horizontalement, au lieu d’en afficher seulement trois."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische horizontal durch bis zu zehn Vorschläge statt nur drei anzuzeigen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri in orizzontale fino a dieci suggerimenti anziché mostrarne solo tre."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize horizontalmente por até dez sugestões, em vez de mostrar apenas três."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Листайте по горизонтали до десяти подсказок вместо трёх."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret mendatar untuk melihat sehingga sepuluh cadangan, bukan hanya tiga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vízszintes húzással akár tíz javaslatot is láthatsz három helyett."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横にスワイプして、3件ではなく最大10件の候補を確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横向滑动可浏览最多十个候选词，而不只显示三个。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가로로 쓸어넘겨 세 개 대신 최대 열 개의 추천을 확인하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainult kolme soovituse asemel saad horisontaalselt sirvida kuni kümmet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisați pe orizontală până la zece sugestii în loc să afișați doar trei."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg horizontaal door maximaal tien suggesties in plaats van er slechts drie weer te geven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "橫向滑動可瀏覽最多十個候選詞，而不只顯示三個。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiep horisontaal deur tot tien voorstelle in plaas daarvan om net drie te wys."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuwaj poziomo maksymalnie dziesięć sugestii, zamiast wyświetlać tylko trzy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
