          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesaba bağlı satın alım yok."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K tomuto účtu nejsou připojeny žádné nákupy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "K tomuto účtu nie sú pripojené žiadne nákupy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν αγορές συνδεδεμένες με αυτόν τον λογαριασμό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga köp är kopplade till det här kontot."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen køb tilknyttet denne konto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kjøp er knyttet til denne kontoen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähän tiliin ei ole liitetty ostoksia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada pembelian yang tertaut ke akun ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có giao dịch mua nào được liên kết với tài khoản này."
          }
        }
      }
    },
    "Share purchases between iOS and Android. Internet verification is required.": {
      "comment": "Private account purchase sharing: subscriptions, lifetime purchases and original paid-app access.",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel aankope tussen iOS en Android. Internetverifikasie word vereis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile Käufe zwischen iOS und Android. Eine Überprüfung über das Internet ist erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte compras entre iOS y Android. Se requiere verificación por internet."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga oste iOS-i ja Androidi vahel. Vajalik on kinnitamine interneti kaudu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage tes achats entre iOS et Android. Une vérification par Internet est nécessaire."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszd meg vásárlásaidat iOS és Android között. Internetes ellenőrzés szükséges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi gli acquisti tra iOS e Android. È necessaria una verifica tramite Internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSとAndroidの間で購入を共有できます。インターネットでの確認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS와 Android 간에 구매를 공유할 수 있습니다. 인터넷을 통한 확인이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kongsi pembelian antara iOS dan Android. Pengesahan melalui internet diperlukan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Partilha compras entre iOS e Android. É necessária uma verificação pela Internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте покупки на iOS и Android. Требуется проверка через интернет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 和 Android 之间共享购买。需要联网验证。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Partajează achizițiile între iOS și Android. Este necesară verificarea prin internet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel aankopen tussen iOS en Android. Verificatie via internet is vereist."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 和 Android 之間共享購買。需要連線驗證。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępniaj zakupy między iOS a Androidem. Wymagana jest weryfikacja przez internet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте покупки на iOS та Android. Потрібна перевірка через інтернет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alımları iOS ve Android arasında paylaşın. İnternet üzerinden doğrulama gerekir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílejte nákupy mezi iOS a Androidem. Je vyžadováno ověření přes internet."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdieľajte nákupy medzi iOS a Androidom. Vyžaduje sa overenie cez internet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μοιραστείτε αγορές μεταξύ iOS και Android. Απαιτείται επαλήθευση μέσω διαδικτύου."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela köp mellan iOS och Android. Verifiering via internet krävs."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del køb mellem iOS og Android. Bekræftelse via internettet er påkrævet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Del kjøp mellom iOS og Android. Bekreftelse via internett er påkrevd."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaa ostokset iOS:n ja Androidin välillä. Vahvistus internetin kautta vaaditaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagikan pembelian antara iOS dan Android. Verifikasi melalui internet diperlukan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ giao dịch mua giữa iOS và Android. Cần xác minh qua internet."
          }
        }
      }
    },
