    "Layers that move the color travel through these, in order. Hold a color to remove it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebenen, die die Farbe bewegen, laufen der Reihe nach durch diese Farben. Halte eine Farbe gedrückt, um sie zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capas que mueven el color recorren estos colores en orden. Mantén pulsado un color para quitarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Värvi liigutavad kihid läbivad need järjest. Hoia värvi all, et see eemaldada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les calques qui font varier la couleur parcourent celles-ci dans l’ordre. Maintiens une couleur pour la retirer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A színt mozgató rétegek sorban végighaladnak ezeken. Tartsd lenyomva a színt az eltávolításhoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I livelli che muovono il colore scorrono questi colori in ordine. Tieni premuto un colore per rimuoverlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色を動かすレイヤーはこれらの色を順番に巡ります。色を長押しすると削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상을 움직이는 레이어는 이 색상들을 순서대로 지나갑니다. 색상을 길게 눌러 제거하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapisan yang menggerakkan warna melalui warna-warna ini mengikut urutan. Tahan warna untuk membuangnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As camadas que movem a cor percorrem estas cores por ordem. Mantenha premida uma cor para a remover."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слои, меняющие цвет, проходят эти цвета по порядку. Удерживайте цвет, чтобы удалить его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改变颜色的图层会依次经过这些颜色。长按某个颜色可将其移除。"
          }
        }
      }
    },
