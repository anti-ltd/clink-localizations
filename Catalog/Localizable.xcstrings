    "Swipe across the scroll direction to switch emoji tabs.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiep dwars oor die rolrigting om emoji-oortjies te wissel."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezi panely emoji přepínejte přejetím kolmo ke směru posouvání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift emoji-fane ved at stryge på tværs af rulleretningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische quer zur Scrollrichtung, um zwischen Emoji-Tabs zu wechseln."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σαρώστε κάθετα προς την κατεύθυνση κύλισης για να αλλάξετε καρτέλα emoji."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza en perpendicular a la dirección de desplazamiento para cambiar de pestaña de emojis."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Emotikonide vahekaardi vahetamiseks viipa kerimissuunaga risti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda emojivälilehteä pyyhkäisemällä poikittain vierityssuuntaan nähden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez perpendiculairement au défilement pour changer d’onglet d’emojis."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az emojilapok váltásához húzd az ujjad a görgetés irányára merőlegesen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser tegak lurus terhadap arah gulir untuk berpindah tab emoji."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri in direzione perpendicolare allo scorrimento per cambiare scheda emoji."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロール方向と直角にスワイプすると、絵文字のタブを切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤 방향과 수직으로 쓸어넘겨 이모티콘 탭을 전환하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret secara berserenjang dengan arah tatal untuk menukar tab emoji."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt emoji-fane ved å sveipe på tvers av rulleretningen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg dwars op de scrollrichting om van emojitab te wisselen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń palcem w poprzek kierunku przewijania, aby zmienić kartę emoji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize na perpendicular à direção de deslocamento para mudar de separador de emojis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisează perpendicular pe direcția de derulare pentru a schimba fila de emoji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните поперёк направления прокрутки, чтобы переключить вкладку эмодзи."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Medzi kartami emoji prepínajte potiahnutím kolmo na smer posúvania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byt emojiflik genom att svepa på tvären mot rullriktningen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji sekmesini değiştirmek için kaydırma yönüne dik olarak parmağınızı kaydırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведіть пальцем упоперек напрямку прокручування, щоб перемкнути вкладку емодзі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt vuông góc với hướng cuộn để chuyển thẻ biểu tượng cảm xúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿垂直于滚动的方向轻扫，即可切换表情符号标签页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沿垂直於捲動的方向滑動，即可切換表情符號標籤頁。"
          }
        }
      }
    },
    "Remove clips after the chosen time. Pinned clips are kept.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwyder knipsels ná die gekose tyd. Vasgespelde knipsels bly behoue."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zvolené době odstranit položky. Připnuté položky zůstanou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern udklip efter det valgte tidsrum. Fastgjorte udklip beholdes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne Einträge nach der gewählten Zeit. Angeheftete Einträge bleiben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαίρεση αποκομμάτων μετά τον επιλεγμένο χρόνο. Τα καρφιτσωμένα αποκόμματα διατηρούνται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina los recortes pasado el tiempo elegido. Los fijados se conservan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemalda lõiked valitud aja möödudes. Kinnitatud lõiked säilivad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista leikkeet valitun ajan kuluttua. Kiinnitetyt leikkeet säilytetään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les extraits après le délai choisi. Les extraits épinglés sont conservés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A választott idő elteltével törli az elemeket. A rögzített elemek megmaradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus klip setelah waktu yang dipilih. Klip yang disematkan tetap disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi gli appunti dopo il tempo scelto. Gli appunti fissati vengono conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定した時間が経過するとクリップを削除します。ピン留めしたクリップは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 시간이 지나면 클립을 삭제합니다. 고정한 클립은 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buang klip selepas tempoh yang dipilih. Klip yang dipinkan dikekalkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern utklipp etter den valgte tiden. Festede utklipp beholdes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder fragmenten na de gekozen tijd. Vastgezette fragmenten blijven bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwaj wycinki po wybranym czasie. Przypięte wycinki zostaną zachowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover os recortes após o tempo escolhido. Os recortes afixados são mantidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină fragmentele după timpul ales. Fragmentele fixate sunt păstrate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалять фрагменты через выбранное время. Закреплённые фрагменты сохраняются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zvolenom čase odstrániť výstrižky. Pripnuté výstrižky zostanú zachované."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort urklipp efter den valda tiden. Fästa urklipp behålls."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen süre dolduğunda kupürleri sil. Sabitlenmiş kupürler korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляти фрагменти через вибраний час. Закріплені фрагменти зберігаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa đoạn lưu sau thời gian đã chọn. Các đoạn đã ghim sẽ được giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所选时间后删除剪贴项。已固定的剪贴项会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在所選時間後刪除剪貼項目。已釘選的剪貼項目會保留。"
          }
        }
      }
    },
    "Show the copied item above the keys so you can tap to paste it.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wys die gekopieerde item bo die sleutels sodat jy daarop kan tik om dit te plak."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit zkopírovanou položku nad klávesami, odkud ji klepnutím vložíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis det kopierede element over tasterne, så du kan trykke for at indsætte det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige den kopierten Inhalt über den Tasten an, damit du ihn durch Antippen einfügen kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση του αντιγραμμένου στοιχείου πάνω από τα πλήκτρα, για επικόλληση με ένα πάτημα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el elemento copiado encima de las teclas para pegarlo con un toque."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva kopeeritud üksus klahvide kohal, et saaksid selle puudutusega kleepida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä kopioitu kohde näppäinten yläpuolella, jotta voit liittää sen napauttamalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche l’élément copié au-dessus des touches pour le coller d’un toucher."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjeleníti a másolt elemet a billentyűk felett, ahonnan koppintással beillesztheted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan item yang disalin di atas tombol agar dapat ditempel dengan mengetuknya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra l’elemento copiato sopra i tasti per incollarlo con un tocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーした項目をキーの上に表示し、タップで貼り付けられるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 항목을 키 위에 표시하여 탭 한 번으로 붙여넣을 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Paparkan item yang disalin di atas kekunci supaya anda boleh mengetik untuk menampalnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis det kopierte elementet over tastene, slik at du kan trykke for å lime det inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon het gekopieerde item boven de toetsen, zodat je het met een tik kunt plakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż skopiowany element nad klawiszami, aby można go było wkleić stuknięciem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar o item copiado acima das teclas para o colar com um toque."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează elementul copiat deasupra tastelor, ca să îl poți lipi printr-o atingere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать скопированный элемент над клавишами, чтобы вставить его касанием."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobraziť skopírovanú položku nad klávesmi, odkiaľ ju klepnutím vložíte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa det kopierade objektet ovanför tangenterna så att du kan trycka för att klistra in det."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalanan öğeyi tuşların üzerinde göstererek dokunup yapıştırmanı sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати скопійований елемент над клавішами, щоб вставити його дотиком."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị mục đã sao chép phía trên các phím để bạn chạm và dán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在按键上方显示已复制的项目，轻点即可粘贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在按鍵上方顯示已複製的項目，點一下即可貼上。"
          }
        }
      }
    },
    "Requires Clink open": {
      "comment": "Android AI provider availability. Nano requires the Clink app in the foreground; Gemma and cloud providers also work inside the keyboard.",
      "extractionState": "manual",
      "localizations": {
        "af": {
