            "state": "translated",
            "value": "둘 다 ‘느낌’ 페이지에 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua-duanya ada pada halaman Rasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos estão na página Sensação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оба параметра находятся на странице «Ощущения»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这两项都在“触感”页面中。"
          }
        }
      }
