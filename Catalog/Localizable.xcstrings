    "Gemini Nano isn't available for this action and language on this device.": {
      "comment": "Android on-device writing availability; refers only to Gemini Nano for the selected action and language, not to all AI providers.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano is nie op hierdie toestel vir hierdie handeling en taal beskikbaar nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano ist auf diesem Gerät für diese Aktion und Sprache nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano no está disponible para esta acción y este idioma en este dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano pole selles seadmes selle toimingu ja keele jaoks saadaval."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano n’est pas disponible pour cette action et cette langue sur cet appareil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gemini Nano ezen az eszközön nem érhető el ehhez a művelethez és nyelvhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano non è disponibile per questa azione e questa lingua su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは、この操作と言語でGemini Nanoを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 해당 작업과 언어에 Gemini Nano를 사용할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano tidak tersedia untuk tindakan dan bahasa ini pada peranti ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gemini Nano não está disponível para esta ação e este idioma neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Nano недоступен для этого действия и языка на этом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
