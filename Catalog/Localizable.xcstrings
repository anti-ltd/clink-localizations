            "value": "Begge hastighetene er i bevegelser, under tasterepetisjon."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Molemmat nopeudet ovat kohdassa Näppäimen toisto -kohdassa Eleet."
          }
        },
        "id": {
