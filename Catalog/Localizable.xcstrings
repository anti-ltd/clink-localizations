    "The text you copy, ready on every device. Copied images stay on the device that saved them.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die teks wat jy kopieer, gereed op elke toestel. Gekopieerde beelde bly op die toestel wat hulle gestoor het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text, den du kopierst, steht auf jedem Gerät bereit. Kopierte Bilder bleiben auf dem Gerät, das sie gespeichert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto que copias, listo en todos tus dispositivos. Las imágenes copiadas se quedan en el dispositivo que las guardó."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst, mida kopeerid, on valmis igas seadmes. Kopeeritud pildid jäävad seadmesse, mis need salvestas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte que tu copies, prêt sur chaque appareil. Les images copiées restent sur l’appareil qui les a enregistrées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A másolt szöveged minden eszközön kéznél van. A másolt képek azon az eszközön maradnak, amelyik elmentette őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo che copi, pronto su ogni dispositivo. Le immagini copiate restano sul dispositivo che le ha salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたテキストをすべてのデバイスで使えます。コピーした画像は保存したデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 텍스트를 모든 기기에서 바로 사용할 수 있습니다. 복사한 이미지는 저장한 기기에 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang anda salin, tersedia pada setiap peranti. Imej yang disalin kekal pada peranti yang menyimpannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto que copias, pronto em todos os dispositivos. As imagens copiadas ficam no dispositivo que as guardou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопированный текст доступен на всех устройствах. Скопированные изображения остаются на том устройстве, где были сохранены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你复制的文本可在每台设备上随时取用。复制的图片则保留在保存它的设备上。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Textul pe care îl copiați, gata pe fiecare dispozitiv. Imaginile copiate rămân pe dispozitivul care le-a salvat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tekst die u kopieert, klaar op elk apparaat. Gekopieerde afbeeldingen blijven op het apparaat staan ​​waarop ze zijn opgeslagen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你複製的文字可在每臺裝置上隨時取用。複製的圖片則保留在儲存它的裝置上。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst, który kopiujesz, gotowy na każdym urządzeniu. Skopiowane obrazy pozostają na urządzeniu, na którym je zapisano."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст, який ви копіюєте, готовий на кожному пристрої. Скопійовані зображення залишаються на пристрої, на якому вони були збережені."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyaladığınız metin her cihazda hazır. Kopyalanan görüntüler, onları kaydeden cihazda kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text, který zkopírujete, připravený na každém zařízení. Zkopírované obrázky zůstanou v zařízení, které je uložilo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Text, ktorý skopírujete, pripravený na každom zariadení. Skopírované obrázky zostanú v zariadení, ktoré ich uložilo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κείμενο που αντιγράφετε, έτοιμο σε κάθε συσκευή. Οι αντιγραμμένες εικόνες παραμένουν στη συσκευή που τις αποθήκευσε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Texten du kopierar, redo på alla enheter. Kopierade bilder stannar på enheten som sparade dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den tekst, du kopierer, er klar på alle enheder. Kopierede billeder forbliver på den enhed, der gemte dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksten du kopierer, klar på alle enheter. Kopierte bilder blir værende på enheten som lagret dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioimasi teksti on valmis kaikilla laitteilla. Kopioidut kuvat pysyvät laitteella, jolla ne on tallennettu."
