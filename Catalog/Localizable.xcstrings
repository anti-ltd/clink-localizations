    "Analytics counts your speed, your corrections and the keys you miss, and keeps all of it on the phone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Statistiken zählen dein Tempo, deine Korrekturen und die Tasten, die du verfehlst — alles bleibt auf dem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estadísticas cuentan tu velocidad, tus correcciones y las teclas que fallas, y lo guardan todo en el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les statistiques comptent ta vitesse, tes corrections et les touches que tu rates, et gardent tout sur le téléphone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Statisztikák számolják a sebességedet, a javításaidat és az elvétett billentyűket — mindez a telefonon marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le statistiche contano la tua velocità, le correzioni e i tasti che sbagli, e tengono tutto sul telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「入力統計」は速度・修正回数・押し間違えたキーを数えます。データはすべて端末内に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통계는 속도와 수정 횟수, 잘못 누른 키를 세어 둡니다. 모두 기기 안에만 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik mengira kelajuan anda, pembetulan anda dan kekunci yang tersasar, dan menyimpan semuanya dalam telefon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As estatísticas contam a tua velocidade, as tuas correcções e as teclas que falhas, e guardam tudo no telemóvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статистика считает вашу скорость, исправления и промахи по клавишам — и всё это остаётся на телефоне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“统计”会记录你的速度、改了多少次、常按错哪些键，所有数据都留在手机上。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistika loendab sinu kiiruse, parandused ja klahvid, mida mööda lubad, ja hoiab kõik selle telefonis."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analytics tel jou spoed, jou regstellings en die sleutels wat jy mis, en hou dit alles op die foon."
          }
        }
      }
    },
