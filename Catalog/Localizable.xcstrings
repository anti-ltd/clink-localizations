          }
        }
      }
    },
    "The cap shows exactly what the key types. Choose its character from the Action palette.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tecla muestra exactamente lo que escribe. Elige su carácter en la paleta de acciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La touche affiche exactement ce qu’elle saisit. Choisis son caractère dans la palette d’actions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Taste zeigt genau das Zeichen, das sie eingibt. Wähle es in der Aktionspalette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasto mostra esattamente ciò che digita. Scegli il carattere dalla tavolozza delle azioni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tecla mostra exatamente o que escreve. Escolha o caráter na paleta de ações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На клавише показан именно тот символ, который она вводит. Выберите символ в палитре действий."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci memaparkan aksara yang ditaipnya. Pilih aksara daripada palet Tindakan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyű azt mutatja, amit beír. A karaktert a Művelet palettán választhatod ki."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーには入力する文字がそのまま表示されます。アクションパレットから文字を選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键帽显示的内容与按键输入的内容完全一致。请在操作面板中选择字符。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키에는 실제로 입력되는 문자가 표시됩니다. 동작 팔레트에서 문자를 선택하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahv näitab täpselt seda, mida see sisestab. Vali märk toimingupaletist."
          }
        }
      }
    },
    "The cap shows exactly what the key types. Tap a character below to set both at once.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die doppie wys presies wat die sleuteltipes is. Tik 'n karakter hieronder om albei gelyktydig te stel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kappe zeigt genau, was die Taste tippt. Tipp unten auf ein Zeichen, um beides auf einmal festzulegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La leyenda muestra exactamente lo que escribe la tecla. Toca un carácter abajo para configurar ambos a la vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kate näitab täpselt, mida klahv sisestab. Puuduta all märgile, et mõlemad korraga määrata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La légende montre exactement ce que la touche tape. Touche un caractère ci-dessous pour régler les deux d'un coup."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sapka pontosan azt mutatja, amit a billentyű beír. Koppints alul egy karakterre, hogy mindkettőt egyszerre beállítsd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La legenda mostra esattamente ciò che il tasto digita. Tocca un carattere qui sotto per impostare entrambi in una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キートップにはキーが入力する文字がそのまま表示されます。下の文字をタップすると両方を一度に設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키캡에는 키가 입력하는 문자가 그대로 표시돼요. 아래 문자를 탭하면 둘을 한 번에 설정할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muka kekunci menunjukkan tepat apa yang ditaip kekunci. Ketik aksara di bawah untuk tetapkan kedua-duanya sekali gus."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A legenda mostra exatamente o que a tecla escreve. Toca num caráter abaixo para definir ambos de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надпись показывает ровно то, что клавиша вводит. Нажмите на символ ниже, чтобы задать сразу и то и другое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键帽显示的就是按键输入的内容。点下面的字符可以一次设置两者。"
          }
        }
      }
    },
    "The clipboard is empty. Copy your assistant's whole reply first.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles está vacío. Copia primero toda la respuesta de tu asistente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers est vide. Copiez d’abord toute la réponse de votre assistant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zwischenablage ist leer. Kopiere zuerst die gesamte Antwort deines Assistenten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli appunti sono vuoti. Copia prima l’intera risposta del tuo assistente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A área de transferência está vazia. Copie primeiro toda a resposta do seu assistente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер обмена пуст. Сначала скопируйте весь ответ ассистента."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan keratan kosong. Salin keseluruhan jawapan pembantu anda dahulu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágólap üres. Először másold ki az asszisztens teljes válaszát."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードが空です。まずアシスタントの返答全体をコピーしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板为空。请先复制助手的完整回复。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드가 비어 있습니다. 먼저 어시스턴트의 답변 전체를 복사하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lõikelaud on tühi. Kopeeri kõigepealt assistendi kogu vastus."
          }
        }
      }
    },
