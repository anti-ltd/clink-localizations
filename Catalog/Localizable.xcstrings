        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio orizzontale tra tasti vicini nella stessa riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ行で隣り合うキーどうしの横のすき間です。"
