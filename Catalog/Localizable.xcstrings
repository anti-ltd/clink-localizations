    "After flipping back, insert a space so you can keep typing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Zurückwechseln ein Leerzeichen setzen, damit du weitertippen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al volver, mete un espacio para que sigas escribiendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après être revenu, insère une espace pour que tu puisses continuer à taper."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Miután visszalapoztál, szúrj be egy szóközt, hogy gépelhess tovább."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando torni indietro, inserisce uno spazio così continui a scrivere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻ったあとにスペースを入れて、そのまま入力を続けられるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 돌아온 뒤에 공백을 넣어서 계속 입력할 수 있게 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas berbalik, sisipkan ruang supaya anda boleh terus menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de voltares, insere um espaço para continuares a escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После возврата вставлять пробел, чтобы можно было печатать дальше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切回去以后插个空格，你就能接着打。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pärast tagasilülitamist lisa tühik, et saaksid jätkata tipimist."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nadat jy teruggeblaai het, voeg 'n spasie in sodat jy kan aanhou tik."
          }
        }
      }
    },
    "After typing punctuation on the symbols page, flip back to letters.": {
