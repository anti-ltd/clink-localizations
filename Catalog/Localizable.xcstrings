    "Your clips ride the suggestion bar. Tap to paste.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou snitte ry die voorstelbalk. Tik om te plak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Clips liegen in der Vorschlagsleiste. Tippe zum Einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus clips van en la barra de sugerencias: toca para pegar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu klipid sõidavad soovituseribal. Puuduta, et kleepida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes clips s'affichent dans la barre de suggestions. Touche pour coller."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágólap-elemek a javaslatsávban. Koppints a beillesztéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue clip stanno nella barra dei suggerimenti: tocca per incollare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップは変換候補バーに表示されます。タップで貼り付け。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립이 추천 바에 표시돼요. 탭하면 붙여넣기돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip anda berada pada bar cadangan. Ketik untuk tampal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus clips ficam na barra de sugestões. Toque para colar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши фрагменты едут в строке подсказок. Нажмите, чтобы вставить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴内容显示在候选栏，点按即可粘贴。"
          }
        }
      }
    },
    "Your conversation stays on your device. GIF searches and selections go to KLIPY.": {
      "comment": "GIF browser UI and accessibility. Native-speaker editorial sign-off for this release is tracked in docs/gif-tool-localization-review.md.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your conversation stays on your device. GIF searches and selections go to KLIPY."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu conversación se queda en tu dispositivo. Las búsquedas y selecciones de GIFs se envían a KLIPY."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta conversation reste sur ton appareil. Tes recherches et tes choix de GIFs sont envoyés à KLIPY."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Unterhaltung bleibt auf deinem Gerät. GIF-Suchanfragen und deine GIF-Auswahl werden an KLIPY gesendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversazione resta sul tuo dispositivo. Le ricerche e le selezioni di GIF vengono inviate a KLIPY."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua conversa fica no teu dispositivo. As pesquisas e seleções de GIFs são enviadas à KLIPY."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша переписка остаётся на устройстве. В KLIPY отправляются поисковые запросы и сведения о выбранных GIF."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbualan anda kekal pada peranti anda. Carian dan pilihan GIF dihantar kepada KLIPY."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszélgetésed az eszközödön marad. A GIF-kereséseket és a kiválasztott GIF-ek adatait elküldjük a KLIPY-nek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話の内容はデバイス上に保たれます。GIFの検索内容と選択情報はKLIPYに送信されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话内容保留在你的设备上。GIF 搜索和选择信息会发送给 KLIPY。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화 내용은 기기에만 남아요. GIF 검색 내용과 선택 정보는 KLIPY로 전송돼요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu vestlus jääb seadmesse. GIF-ide otsingud ja valikud saadetakse KLIPY-le."
          }
        }
      }
    },
    "Your current settings stay as they are.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou huidige instellings bly soos dit is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine aktuellen Einstellungen bleiben, wie sie sind."
          }
        },
        "es": {
