    "Lighting borrows a color your theme already uses, so the theme still looks like itself.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Beligting leen 'n kleur wat jou tema reeds gebruik, so die tema lyk steeds soos homself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beleuchtung leiht sich eine Farbe, die dein Theme schon nutzt – so bleibt es sich selbst treu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La iluminación toma un color que ya usa tu tema, así el tema sigue siendo el mismo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgustus laenab värvi, mida sinu teema juba kasutab, nii et teema näeb ikka välja nagu ise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’éclairage reprend une couleur de ton thème pour en garder le style."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megvilágítás a téma egyik meglévő színét használja, így a téma önmaga marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'illuminazione prende in prestito un colore già usato dal tema, così il tema resta sé stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマがすでに使っている色を借りるので、テーマの印象はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마가 이미 쓰는 색을 빌려 오므로 테마는 그대로 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencahayaan meminjam warna yang sudah digunakan tema anda, jadi tema kekal seperti asalnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A iluminação empresta uma cor que o teu tema já usa, para o tema continuar a ser ele mesmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсветка берёт цвет, который ваша тема уже использует, так что тема остаётся сама собой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯光沿用主题已有的颜色，主题依旧是它本来的样子。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Iluminarea împrumută o culoare pe care tema dvs. o folosește deja, astfel încât tema încă arată ca ea însăși."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlichting leent een kleur die je thema al gebruikt, zodat het thema nog steeds op zichzelf lijkt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "燈光沿用主題已有的顏色，主題依舊是它本來的樣子。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oświetlenie zapożycza kolor, którego już używa Twój motyw, więc motyw nadal wygląda identycznie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Освітлення запозичує колір, який уже використовує ваша тема, тому тема все ще виглядає як сама по собі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aydınlatma, temanızın halihazırda kullandığı bir rengi ödünç alır, böylece tema hâlâ kendisi gibi görünür."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Osvětlení si vypůjčí barvu, kterou vaše téma již používá, takže téma stále vypadá jako samo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Osvetlenie si požičiava farbu, ktorú už téma používa, takže téma stále vyzerá ako sama osebe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο φωτισμός δανείζεται ένα χρώμα που χρησιμοποιεί ήδη το θέμα σας, επομένως το θέμα εξακολουθεί να μοιάζει με τον εαυτό του."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Belysning lånar en färg som ditt tema redan använder, så temat ser fortfarande ut som sig självt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Belysning låner en farve dit tema allerede bruger, så temaet stadig ligner sig selv."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Belysning låner en farge som temaet ditt allerede bruker, så temaet ser fortsatt ut som seg selv."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valaistus lainaa värin, jota teemasi jo käyttää, joten teema näyttää edelleen omalta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencahayaan meminjam warna yang sudah digunakan tema Anda, sehingga tema tetap terlihat seperti aslinya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ánh sáng mượn màu mà chủ đề của bạn đã sử dụng nên chủ đề vẫn trông giống như chính nó."
          }
        }
      }
    },
