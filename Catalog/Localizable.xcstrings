        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți această filă după ce depozitul a publicat o versiune."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open dit tabblad nadat de repository een release heeft gepubliceerd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "倉庫釋出版本後，再開啟此標籤頁。"
