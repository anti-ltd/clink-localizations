    "Distance you drag to delete each additional word. Lower deletes words faster.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Afstand wat jy sleep om elke bykomende woord uit te vee. Laer verwyder woorde vinniger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit du ziehst, um jedes weitere Wort zu löschen. Kürzer löscht die Wörter schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La distancia que arrastras para borrar cada palabra de más. Cuanto más baja, más rápido las borras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahemaa, mida lohistad iga lisasõna kustutamiseks. Väiksem väärtus kustutab sõnu kiiremini."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance à glisser pour supprimer chaque mot en plus. Plus c'est bas, plus les mots partent vite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyit kell húznod minden további szó törléséhez. Kisebb érték gyorsabban töröl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto devi trascinare per eliminare ogni parola in più. Più basso, più veloce cancelli le parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語を1つ多く削除するのにドラッグする距離です。短くするほど速く削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어를 하나 더 지울 때 드래그하는 거리예요. 짧을수록 단어가 더 빨리 지워져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jarak seret untuk padam setiap perkataan tambahan. Lebih rendah, lebih laju padam perkataan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Distância que arrastas para apagar cada palavra a mais. Mais baixo, apaga as palavras mais depressa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расстояние, которое нужно провести, чтобы удалить очередное слово. Меньше — слова удаляются быстрее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每多删一个词你要拖的距离。数值越小删得越快。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Distanța pe care trageți pentru a șterge fiecare cuvânt suplimentar. Mai jos șterge cuvintele mai repede."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De afstand die u sleept om elk extra woord te verwijderen. Lager verwijdert woorden sneller."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每多刪一個詞你要拖的距離。數值越小刪得越快。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odległość, którą przeciągasz, aby usunąć każde dodatkowe słowo. Niższy usuwa słowa szybciej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстань, яку ви перетягуєте, щоб видалити кожне додаткове слово. Lower видаляє слова швидше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ek kelimeyi silmek için sürüklediğiniz mesafe. Düşük, kelimeleri daha hızlı siler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzdálenost, kterou přetáhnete, abyste odstranili každé další slovo. Nižší maže slova rychleji."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzdialenosť, ktorú potiahnete, aby ste odstránili každé ďalšie slovo. Nižšie vymaže slová rýchlejšie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απόσταση που σύρετε για να διαγράψετε κάθε επιπλέον λέξη. Το Lower διαγράφει τις λέξεις πιο γρήγορα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avstånd du drar för att radera varje ytterligare ord. Lägre raderar ord snabbare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afstand du trækker for at slette hvert ekstra ord. Lavere sletter ord hurtigere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avstand du drar for å slette hvert ekstra ord. Lavere sletter ord raskere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Etäisyys, jonka vedät poistaaksesi jokaisen lisäsanan. Alempi poistaa sanat nopeammin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jarak yang Anda seret untuk menghapus setiap kata tambahan. Lebih rendah menghapus kata-kata lebih cepat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng cách bạn kéo để xóa từng từ bổ sung. Hạ xóa từ nhanh hơn."
          }
        }
      }
    },
