          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止 Clink 的麥克風會話。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Clink se mikrofonsessie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymuje sesję mikrofonu Clink."
          }
        },
        "uk": {
          "stringUnit": {
