    "Computed on this device. Nothing is uploaded, shared, or sold.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereken op hierdie toestel. Niks word opgelaai, gedeel of verkoop nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auf diesem Gerät berechnet. Nichts wird hochgeladen, geteilt oder verkauft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se calcula en este dispositivo. No se sube, comparte ni vende nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvutatakse selles seadmes. Midagi ei laadita üles, ei jagata ega müüda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé sur cet appareil. Rien n'est envoyé, partagé ou vendu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen a készüléken számoljuk ki. Semmit nem töltünk fel, osztunk meg vagy adunk el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolato su questo dispositivo. Niente viene caricato, condiviso o venduto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末上で計算されます。アップロードも共有も販売も一切しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 계산돼요. 업로드하거나 공유하거나 판매하지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikira pada peranti ini. Tiada apa-apa yang dimuat naik, dikongsi atau dijual."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado neste dispositivo. Nada é enviado, partilhado ou vendido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё считается на этом устройстве. Ничего не загружается, не передаётся и не продаётся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本机计算。不会上传、共享或出售任何数据。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculat pe acest dispozitiv. Nimic nu este încărcat, distribuit sau vândut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berekend op dit apparaat. Er wordt niets geüpload, gedeeld of verkocht."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在本機計算。不會上傳、共享或出售任何資料。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obliczono na tym urządzeniu. Nic nie jest przesyłane, udostępniane ani sprzedawane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обчислено на цьому пристрої. Нічого не завантажується, не ділиться та не продається."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda hesaplandı. Hiçbir şey yüklenmez, paylaşılmaz veya satılmaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítáno na tomto zařízení. Nic se nenahrává, nesdílí ani neprodává."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypočítané na tomto zariadení. Nič sa nenahráva, nezdieľa ani nepredáva."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπολογίστηκε σε αυτήν τη συσκευή. Τίποτα δεν μεταφορτώνεται, κοινοποιείται ή πωλείται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beräknat på den här enheten. Ingenting laddas upp, delas eller säljs."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beregnet på denne enhed. Intet bliver uploadet, delt eller solgt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beregnet på denne enheten. Ingenting blir lastet opp, delt eller solgt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laskettu tällä laitteella. Mitään ei ladata, jaeta tai myydä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dihitung pada perangkat ini. Tidak ada yang diunggah, dibagikan, atau dijual."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính toán trên thiết bị này. Không có gì được tải lên, chia sẻ hoặc bán."
