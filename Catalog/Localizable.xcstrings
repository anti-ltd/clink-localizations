    "Microphone access is off for Clink. Turn it on in Settings to record.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mikrofonzugriff ist für Clink deaktiviert. Schalte ihn in den Einstellungen ein, um aufzunehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al micrófono está desactivado para Clink. Actívalo en Ajustes para grabar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au micro est désactivé pour Clink. Active-le dans Réglages pour enregistrer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofonhoz való hozzáférés ki van kapcsolva a Clinknél. Kapcsold be a Beállításokban, hogy felvehess."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al microfono è disattivato per Clink. Attivalo in Impostazioni per registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink のマイクへのアクセスがオフになっています。録音するには、設定でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink의 마이크 접근 권한이 꺼져 있어요. 녹음하려면 설정에서 켜 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon dimatikan untuk Clink. Hidupkan dalam Tetapan untuk merakam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone está desligado para o Clink. Liga-o nas Definições para gravares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к микрофону для Clink выключен. Включите его в Настройках, чтобы записывать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 的麦克风权限被关掉了。到设置里打开就能录音。"
