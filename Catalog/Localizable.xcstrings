    "Allow Paste in Settings to stop the system asking every time Clink uses copied text.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Pegar en Ajustes para que el sistema deje de preguntar cada vez que Clink usa texto copiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Coller dans Réglages pour que le système ne vous le demande plus chaque fois que Clink utilise du texte copié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Einfügen in den Einstellungen, damit das System nicht jedes Mal nachfragt, wenn Clink kopierten Text verwendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Incolla in Impostazioni per evitare che il sistema chieda ogni volta che Clink usa testo copiato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Colar nas Definições para o sistema deixar de perguntar sempre que o Clink usa texto copiado."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan Tampal dalam Tetapan supaya sistem tidak bertanya setiap kali Clink menggunakan teks yang disalin."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a Beillesztést a Beállításokban, hogy a rendszer ne kérdezzen rá minden alkalommal, amikor a Clink másolt szöveget használ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」でペーストを許可すると、Clinkがコピーしたテキストを使うたびにシステムから確認されなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中允许粘贴后，Clink 每次使用复制的文本时，系统就不会再询问。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 붙여넣기를 허용하면 Clink이 복사한 텍스트를 사용할 때마다 시스템이 묻지 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Luba seadetes kleepimine, et süsteem ei küsiks iga kord, kui Clink kasutab kopeeritud teksti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите вставку в Настройках, чтобы система не спрашивала каждый раз, когда Clink использует скопированный текст."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laat Plak in instellings toe om te keer dat die stelsel vra elke keer as Clink gekopieerde teks gebruik."
          }
        }
      }
    },
