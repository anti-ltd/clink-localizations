        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reescreve, revê e muda o tom"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переписывайте, проверяйте текст и меняйте тон"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改写、校对并调整语气"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescrie, corectează și schimbă tonul"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herschrijf, proeflees en verander van toon"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改寫、校對並調整語氣"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepisz, sprawdź i zmień ton"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перепишіть, відредагуйте та змініть тон"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden yazın, düzeltin ve tonu değiştirin"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepište, zkorigujte a změňte tón"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepíšte, skontrolujte a zmeňte tón"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξαναγράψτε, διορθώστε και αλλάξτε τον τόνο"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv om, korrekturläs och ändra ton"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omskriv, korrektur og skift tone"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Omskriv, korrekturlese og endre tone"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita uudelleen, oikoluku ja muuta sävyä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis ulang, koreksi, dan ubah nada"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết lại, hiệu đính và thay đổi giọng điệu"
          }
        }
      }
    },
    "Rewriting, proofreading and tone changes in AI Tools, and tidying up dictation. That's the lot. It runs on Apple Intelligence, on the phone, and one switch in Integrations turns all of it off.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Herskryf, proeflees en toonveranderinge in KI-nutsgoed, en die opruim van diktee. Dit is die lot. Dit werk op Apple Intelligence, op die telefoon, en een skakelaar in Integrasies skakel dit alles af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umschreiben, Korrekturlesen und Tonwechsel in den KI-Werkzeugen, dazu das Aufräumen des Diktats. Mehr nicht. Es läuft über Apple Intelligence auf dem Gerät, und ein Schalter unter „Integrationen“ schaltet alles ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reescribir, revisar y cambiar el tono en Herramientas de IA, y pulir el dictado. Nada más. Funciona con Apple Intelligence, en el propio teléfono, y un interruptor en Integraciones lo apaga todo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ümberkirjutamine, ülelugemine ja toonivahetused TI-tööriistades ning dikteerimise korrastamine. See on kõik. Töötab Apple Intelligence’iga telefonis ja üks lüliti Integratsioonides lülitab kõik välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réécrire, relire et changer de ton dans les Outils IA, plus le nettoyage de la dictée. C'est tout. Ça passe par Apple Intelligence, sur le téléphone, et un interrupteur dans Intégrations désactive l'ensemble."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Átfogalmazás, korrektúra és hangnemváltás az MI-eszközökben, és a diktálás rendbetétele. Ennyi. Az Apple Intelligence-en, a telefonon fut, és az Integrációk alatt egy kapcsoló mindet kikapcsolja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riscrivere, correggere e cambiare tono negli Strumenti AI, più la pulizia della dettatura. Tutto qui. Gira su Apple Intelligence, sul telefono, e un interruttore in Integrazioni spegne tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIツールでの書き換え・校正・トーン変更と、音声入力の整形です。それだけです。端末上のApple Intelligenceで動作し、「連携」のスイッチひとつで全部オフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 도구의 다시 쓰기, 교정, 어조 바꾸기와 받아쓰기 다듬기입니다. 그게 전부입니다. 기기 안의 Apple Intelligence로 돌아가고, 연동의 스위치 하나로 전부 끌 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menulis semula, menyemak dan menukar nada dalam Alat AI, serta mengemas hasil imlak. Itu sahaja. Ia berjalan pada Apple Intelligence, di telefon, dan satu suis dalam Integrasi mematikan kesemuanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reescrever, rever e mudar o tom nas Ferramentas de IA, e arrumar o ditado. É tudo. Corre no Apple Intelligence, no telemóvel, e um interruptor em Integrações desliga tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переписывание, проверка текста и смена тона в «Инструментах ИИ» плюс приведение диктовки в порядок. Вот и всё. Работает на Apple Intelligence, на телефоне, и один переключатель в «Интеграциях» выключает это целиком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 工具里的改写、校对、语气调整，加上听写的整理。就这些。它在手机上通过 Apple Intelligence 运行，“集成”里有一个开关能全部关掉。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescrierea, corectarea și modificările de ton în Instrumentele AI și ordonarea dictarii. Asta e lotul. Funcționează pe Apple Intelligence, pe telefon, iar un comutator din Integrations o dezactivează pe toate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herschrijven, proeflezen en toonveranderingen in AI Tools, en dictaat opruimen. Dat is het lot. Het draait op Apple Intelligence, op de telefoon, en één schakelaar in Integraties schakelt alles uit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 工具裡的改寫、校對、語氣調整，加上聽寫的整理。就這些。它在手機上透過 Apple Intelligence 執行，“整合”裡有一個開關能全部關掉。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepisywanie, korekta i zmiany tonu w narzędziach AI oraz porządkowanie dyktanda. To tyle. Działa na Apple Intelligence, na telefonie, a jeden przełącznik w integracji wyłącza to wszystko."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переписування, вичитка та зміна тону в інструментах AI, а також приведення в порядок диктанту. Ось і все. Він працює на Apple Intelligence, на телефоні, і один перемикач в Integrations вимикає все це."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Tools'da yeniden yazma, redaksiyon ve ton değişiklikleri ve dikteyi düzenleme. Hepsi bu. Telefondaki Apple Intelligence üzerinde çalışır ve Entegrasyonlar'daki bir anahtar hepsini kapatır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepisování, korektury a změny tónů v nástrojích AI a pořádek v diktátu. To je hodně. Běží na Apple Intelligence na telefonu a jeden přepínač v Integrations to všechno vypne."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepisovanie, korektúry a zmeny tónov v nástrojoch AI a upratanie diktátu. To je veľa. Beží na Apple Intelligence na telefóne a jeden prepínač v Integrations to všetko vypne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναγραφή, διόρθωση και αλλαγές τόνου στα AI Tools και τακτοποίηση της υπαγόρευσης. Αυτή είναι η παρτίδα. Λειτουργεί στο Apple Intelligence, στο τηλέφωνο και ένας διακόπτης στο Integrations τα απενεργοποιεί όλα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omskrivning, korrekturläsning och tonförändringar i AI-verktyg och städning av diktering. Det är mycket. Den körs på Apple Intelligence, på telefonen, och en switch i Integrations stänger av allt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omskrivning, korrekturlæsning og toneændringer i AI-værktøjer og oprydning af diktat. Det er partiet. Den kører på Apple Intelligence, på telefonen, og en kontakt i Integrations slår det hele fra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Omskriving, korrekturlesing og toneendringer i AI-verktøy, og rydde opp i diktat. Det er mye. Den kjører på Apple Intelligence, på telefonen, og én bryter i Integrations slår av alt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uudelleenkirjoittaminen, oikoluku ja sävymuutokset tekoälytyökaluissa sekä sanelun siivoaminen. Se on paljon. Se toimii Apple Intelligence:ssä, puhelimessa, ja yksi integraatioiden kytkin sammuttaa sen kaiken."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menulis ulang, mengoreksi, dan mengubah nada di AI Tools, serta merapikan dikte. Itu saja. Ini berjalan di Apple Intelligence, di telepon, dan satu tombol di Integrasi mematikan semuanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết lại, hiệu đính và thay đổi giọng điệu trong Công cụ AI cũng như sắp xếp lại chính tả. Đó là rất nhiều. Nó chạy trên Apple Intelligence, trên điện thoại và một công tắc trong Tích hợp sẽ tắt tất cả."
          }
        }
      }
    },
