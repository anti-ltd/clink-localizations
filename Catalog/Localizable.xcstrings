            "value": "Analiz kapalı"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics je vypnutá"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Služba Analytics je vypnutá"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Analytics είναι απενεργοποιημένο"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics är avstängt"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics er slået fra"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics er av"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics on pois päältä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisis tidak aktif"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
