            "value": "Váš domáci miláčik zobrazený naživo. Nižšie vyberte druh, roh a veľkosť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κατοικίδιό σας, εμφανίζεται ζωντανά. Επιλέξτε ένα είδος, γωνία και μέγεθος παρακάτω."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt husdjur, visas live. Välj en art, hörn och storlek nedan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kæledyr, vist live. Vælg en art, hjørne og størrelse nedenfor."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjæledyret ditt, vist live. Velg art, hjørne og størrelse nedenfor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lemmikkisi, näytetään livenä. Valitse laji, kulma ja koko alta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hewan peliharaan Anda, ditampilkan secara langsung. Pilih spesies, sudut, dan ukuran di bawah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thú cưng của bạn, được hiển thị trực tiếp. Chọn một loài, góc và kích thước bên dưới."
          }
        }
      }
    },
