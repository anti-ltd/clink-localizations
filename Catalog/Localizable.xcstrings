    "Most of that is animation rather than speed, and you can take it out.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die meeste daarvan is animasie eerder as spoed, en jy kan dit uithaal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das meiste davon ist Animation, nicht Tempo, und du kannst sie herausnehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayor parte de eso es animación, no lentitud, y se puede quitar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Enamik sellest on animatsioon, mitte kiirus, ja sa võid selle eemaldada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'essentiel, c'est de l'animation, pas de la lenteur, et tu peux la retirer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek java része animáció, nem lassúság, és ki lehet venni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In gran parte è animazione, non lentezza, e la puoi togliere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その多くは速度ではなくアニメーションによるもので、取り除けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분은 속도가 아니라 애니메이션 때문이고, 없앨 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebanyakannya animasi dan bukan kelajuan, dan anda boleh membuangnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A maior parte disso é animação, não lentidão, e podes tirá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почти всё это — анимация, а не скорость, и её можно убрать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这多半是动画造成的，不是真的慢，可以去掉。"
          }
        }
      }
    },
