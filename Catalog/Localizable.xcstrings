    },
    "Clips pop in a panel over the keys. Tap to paste.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Knippe verskyn in 'n paneel oor die sleutels. Tik om te plak."
          }
        },
        "de": {
