        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI er tændt, men %@ Offline-forslag fortsætter som normalt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI er på, men %@ Offline-forslag fortsetter som normalt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI on päällä, mutta %@ Offline -ehdotukset jatkuvat normaalisti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AI aktif, namun saran %@ Offline tetap berjalan seperti biasa."
