          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kettő is, mindkettő a törlésgombon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due, entrambi sul tasto di cancellazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つあります。どちらも削除キーの操作です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 가지가 있고, 둘 다 삭제 키에서 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua, kedua-duanya pada kekunci padam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas, ambas na tecla de apagar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два, и оба — на клавише удаления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有两种，都在删除键上。"
          }
        }
      }
    },
