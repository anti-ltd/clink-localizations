    "Metal keys use their finish, so key colors won't show. Glyph and outline colors still apply.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal-Tasten benutzen ihr eigenes Finish, deshalb greifen Tastenfarben hier nicht. Zeichen- und Konturfarben schon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas Metal usan su propio acabado, así que el color de tecla no se ve. Los colores de glifo y contorno sí se aplican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches Metal gardent leur finition, la couleur de touche ne s’affiche donc pas. Les couleurs de symbole et de contour, si."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Metal billentyűk a saját felületüket használják, ezért a billentyűszín nem látszik. A jel és a körvonal színe viszont igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti Metal usano la loro finitura, quindi il colore del tasto non si vede. I colori di simbolo e contorno funzionano lo stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal のキーは独自の質感を使うため、キーの色は反映されません。文字とアウトラインの色は反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal 키는 고유한 질감을 쓰기 때문에 키 색상은 나타나지 않아요. 글자와 윤곽선 색상은 그대로 적용돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci Metal guna kemasannya sendiri, jadi warna kekunci takkan kelihatan. Warna glif dan garis luar masih berfungsi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas Metal usam o seu próprio acabamento, por isso a cor da tecla não aparece. As cores de glifo e contorno continuam a aplicar-se."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Металлические клавиши используют своё покрытие, поэтому цвета клавиш не видны. Цвета символов и контура по-прежнему работают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal 按键使用自身的材质效果，所以按键颜色不会显示。字符和描边颜色仍然有效。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Metallist klahvid kasutavad oma viimistlust, seega klahvivärve ei näidata. Sümboli ja kontuuri värvid kehtivad ikka."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metaalsleutels gebruik hul afwerking, so sleutelkleure sal nie wys nie. Glyph- en buitelynkleure geld steeds."
          }
        }
      }
    },
