          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra os teus emojis recentes numa fila. Escolhe quantos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает недавние эмодзи в ряд. Выберите, сколько."
          }
        },
        "zh-Hans": {
