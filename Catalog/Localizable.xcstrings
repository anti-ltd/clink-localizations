    "Start typing with Clink and your stats will show up here.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Begin tik met Clink en jou statistieke sal hier verskyn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fang an, mit Clink zu tippen, dann erscheinen deine Statistiken hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a escribir con Clink y tus estadísticas aparecerán aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakka Clinkiga tipitama ja sinu statistika ilmub siia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence à taper avec Clink et tes statistiques apparaîtront ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdj el gépelni a Clinkkel, és a statisztikáid itt fognak megjelenni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia a scrivere con Clink e le tue statistiche compariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkで入力を始めると、ここに統計が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink으로 입력을 시작하면, 여기에 통계가 나타나요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mula menaip dengan Clink dan statistik anda akan dipaparkan di sini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa a escrever com o Clink e as tuas estatísticas vão aparecer aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните печатать в Clink — и здесь появится ваша статистика."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始用 Clink 打字吧，你的统计数据会显示在这里。"
          }
        }
      }
    },
    "Start typing. Both are spell-checked at once.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Begin tik. Albei word gelyktydig gekontroleer."
          }
        },
        "de": {
          "stringUnit": {
