    "Account unavailable. Try again after unlocking your device.": {
      "comment": "Optional private app account and purchase sharing. No email or typing data. Recovery key and pairing codes are secrets.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta no está disponible. Desbloquea el dispositivo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte indisponible. Déverrouille ton appareil, puis réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto nicht verfügbar. Entsperre dein Gerät und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Account non disponibile. Sblocca il dispositivo e riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta indisponível. Desbloqueia o dispositivo e tenta novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт недоступен. Разблокируйте устройство и повторите попытку."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun tidak tersedia. Buka kunci peranti anda dan cuba lagi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fiók nem érhető el. Oldd fel az eszköz zárolását, és próbáld újra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを利用できません。デバイスのロックを解除してから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户暂时无法使用。请解锁设备后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정을 사용할 수 없습니다. 기기 잠금을 해제한 후 다시 시도해 주세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto pole saadaval. Ava seadme lukustus ja proovi uuesti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contul nu este disponibil. Deblochează dispozitivul și încearcă din nou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Account niet beschikbaar. Ontgrendel je apparaat en probeer het opnieuw."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法使用帳號。請解鎖裝置後再試一次。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekening nie beskikbaar nie. Ontsluit jou toestel en probeer weer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto jest niedostępne. Odblokuj urządzenie i spróbuj ponownie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обліковий запис недоступний. Розблокуйте пристрій і повторіть спробу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaba ulaşılamıyor. Cihazınızın kilidini açıp tekrar deneyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet není dostupný. Odemkni zařízení a zkus to znovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet nie je dostupný. Odomkni zariadenie a skús to znova."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο λογαριασμός δεν είναι διαθέσιμος. Ξεκλείδωσε τη συσκευή και δοκίμασε ξανά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontot är inte tillgängligt. Lås upp enheten och försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoen er ikke tilgængelig. Lås enheden op, og prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoen er ikke tilgjengelig. Lås opp enheten og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tili ei ole käytettävissä. Avaa laitteen lukitus ja yritä uudelleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun tidak tersedia. Buka kunci perangkat, lalu coba lagi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập tài khoản. Hãy mở khóa thiết bị rồi thử lại."
          }
        }
      }
    },
