    "Stands in for a flag. An emoji, a rune, a letter of the script.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Staan in vir 'n vlag. 'n Emoji, 'n rune, 'n letter van die skrif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steht anstelle einer Flagge: ein Emoji, eine Rune, ein Buchstabe der Schrift."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocupa el lugar de la bandera: un emoji, una runa, una letra del alfabeto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Asendab lippu. Emoji, ruun või kirja täht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace le drapeau : un émoji, une rune, une lettre de l’écriture."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A zászló helyén áll: egy emodzsi, egy rúna, az írás egy betűje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta al posto della bandiera: un’emoji, una runa, una lettera della scrittura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国旗の代わりに表示します。絵文字でも、ルーン文字でも、その文字体系の一文字でも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국기 자리에 들어갑니다. 이모지, 룬 문자, 그 문자 체계의 글자 하나 모두 좋습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggantikan bendera: emoji, rune, atau satu huruf tulisan itu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica no lugar da bandeira: um emoji, uma runa, uma letra da escrita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменяет флаг. Эмодзи, руна или буква нужной письменности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代替国旗显示：一个表情符号、一个符文，或这套文字里的一个字母。"
          }
        }
      }
    },
