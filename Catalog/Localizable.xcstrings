    "Clipboard, notepad, translate, emoji, calculator. Turn on the ones you want and skip the rest.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Klembord, notaboek, vertaal, emoji's, sakrekenaar. Skakel dié aan wat jy wil hê en slaan die res oor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenablage, Notizblock, Übersetzen, Emoji, Rechner. Schalt die ein, die du willst, und lass den Rest weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portapapeles, bloc de notas, traducción, emoji, calculadora. Activa los que quieras y deja el resto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lõikelaud, märkmik, tõlge, emoji, kalkulaator. Lülita sisse need, mida tahad, ja jäta ülejäänud vahele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presse-papiers, bloc-notes, traduction, emoji, calculatrice. Active ceux que tu veux et ignore les autres."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vágólap, jegyzettömb, fordítás, emoji, számológép. Kapcsold be, amelyiket szeretnéd, a többit hagyd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appunti, blocco note, traduzione, emoji, calcolatrice. Attiva quelli che vuoi e lascia perdere il resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード、メモ帳、翻訳、絵文字、電卓。使いたいものだけオンにして、あとは飛ばせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드, 메모장, 번역, 이모지, 계산기. 원하는 것만 켜고 나머지는 건너뛰세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan keratan, pad nota, terjemah, emoji, kalkulator. Hidupkan yang anda mahu dan langkau yang lain."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Área de transferência, bloco de notas, tradução, emoji, calculadora. Liga as que quiseres e ignora as restantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер обмена, блокнот, перевод, эмодзи, калькулятор. Включите нужное, остальное пропустите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板、记事本、翻译、表情、计算器。想要哪个就开哪个，其余的跳过。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard, notepad, traducere, emoji, calculator. Porniți-le pe cele pe care le doriți și săriți peste restul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klembord, notitieblok, vertalen, emoji, rekenmachine. Schakel de gewenste in en sla de rest over."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿、記事本、翻譯、表情、計算器。想要哪個就開哪個，其餘的跳過。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schowek, notatnik, tłumaczenie, emoji, kalkulator. Włącz te, które chcesz i pomiń resztę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер обміну, блокнот, переклад, емодзі, калькулятор. Увімкніть ті, які хочете, і пропустіть решту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pano, not defteri, çeviri, emoji, hesap makinesi. İstediklerinizi açın ve gerisini atlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Schránka, poznámkový blok, překlad, emotikony, kalkulačka. Zapněte ty, které chcete, a přeskočte zbytek."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Schránka, poznámkový blok, preklad, emotikony, kalkulačka. Zapnite tie, ktoré chcete, a preskočte ostatné."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόχειρο, σημειωματάριο, μετάφραση, emoji, αριθμομηχανή. Ενεργοποιήστε αυτά που θέλετε και παραλείψτε τα υπόλοιπα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Urklipp, anteckningsblock, översätt, emoji, kalkylator. Slå på de du vill ha och hoppa över resten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udklipsholder, notesblok, oversæt, emoji, lommeregner. Tænd dem, du ønsker, og spring resten over."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utklippstavle, notisblokk, oversett, emoji, kalkulator. Slå på de du vil ha og hopp over resten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leikepöytä, muistilehtiö, käännös, emoji, laskin. Ota käyttöön haluamasi ja ohita loput."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan klip, notepad, terjemahan, emoji, kalkulator. Nyalakan yang Anda inginkan dan lewati sisanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard, notepad, dịch, biểu tượng cảm xúc, máy tính. Bật những cái bạn muốn và bỏ qua phần còn lại."
          }
        }
      }
    },
    "Clips in this group become ungrouped.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Knipsels in hierdie groep raak ongegroepeer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips in dieser Gruppe sind dann nicht mehr gruppiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips de este grupo se quedan sin grupo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selles grupis olevad klipid muutuvad grupita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clips de ce groupe seront dégroupés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ebben a csoportban lévő elemek kikerülnek a csoportból."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clip di questo gruppo torneranno senza gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループのクリップはグループなしに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹의 클립은 그룹에서 빠져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip dalam kumpulan ini akan keluar dari kumpulan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os clipes deste grupo deixam de estar agrupados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фрагменты из этой группы останутся без группы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个分组里的剪贴内容会变成没分组的状态。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipurile din acest grup devin negrupate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips in deze groep worden gedegroepeerd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個分組裡的剪貼內容會變成沒分組的狀態。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipy w tej grupie zostaną rozgrupowane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кліпи в цій групі розгруповуються."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gruptaki kliplerin grubu çözülür."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipy v této skupině budou seskupeny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipy v tejto skupine sa rozdelia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κλιπ σε αυτήν την ομάδα δεν ομαδοποιούνται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipp i den här gruppen blir ogrupperade."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip i denne gruppe bliver ugrupperet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipp i denne gruppen blir ikke gruppert."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän ryhmän leikkeet ryhmittelevät."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip dalam grup ini menjadi tidak dikelompokkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các clip trong nhóm này sẽ được tách ra."
          }
        }
      }
    },
    "Clips pop in a panel over the keys. Tap to paste.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Knippe verskyn in 'n paneel oor die sleutels. Tik om te plak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips erscheinen in einem Panel über den Tasten. Tippe zum Einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips aparecen en un panel sobre las teclas: toca para pegar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipid hüppavad klahvide kohal olevale paneelile. Puuduta kleepimiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clips apparaissent dans un panneau au-dessus des touches. Touche pour coller."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elemek egy panelen jelennek meg a billentyűk fölött. Koppints a beillesztéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clip compaiono in un pannello sopra i tasti: tocca per incollare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップはキーの上のパネルに表示されます。タップで貼り付け。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립이 키 위의 패널에 표시돼요. 탭하면 붙여넣기돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip muncul dalam panel di atas kekunci. Ketik untuk tampal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os clips aparecem num painel sobre as teclas. Toque para colar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фрагменты появляются в панели поверх клавиш. Нажмите, чтобы вставить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴内容会在按键上方的面板中弹出，点按即可粘贴。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipurile apar într-un panou peste taste. Atingeți pentru a lipi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips verschijnen in een paneel over de toetsen. Tik om te plakken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼內容會在按鍵上方的面板中彈出，點按即可貼上。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipy pojawiają się w panelu nad klawiszami. Kliknij, aby wkleić."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Затискачі з’являються на панелі над клавішами. Торкніться, щоб вставити."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipler tuşların üzerindeki panelde açılır. Yapıştırmak için dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipy se objeví na panelu nad klávesami. Klepnutím vložíte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipy sa objavia na paneli nad klávesmi. Klepnutím prilepíte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κλιπ εμφανίζονται σε ένα πλαίσιο πάνω από τα πλήκτρα. Πατήστε για επικόλληση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipp poppar in i en panel över tangenterna. Tryck för att klistra in."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip popper ind i et panel over tasterne. Tryk for at indsætte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klippene kommer inn i et panel over tastene. Trykk for å lime inn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leikkeet ponnahtavat paneeliin näppäinten päälle. Liitä napauttamalla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip muncul di panel di atas tombol. Ketuk untuk menempelkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các clip bật lên trên một bảng điều khiển trên các phím. Nhấn để dán."
          }
        }
      }
    },
