            "value": "Pulsa la tecla para oír el paquete que has elegido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur la touche pour entendre le pack que tu as choisi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomd meg a billentyűt, és meghallod a kiválasztott csomagot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi il tasto per sentire il pacchetto che hai scelto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを押すと、選んだパックの音が鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누르면 선택한 팩의 소리가 나요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan kekunci untuk mendengar pek yang anda pilih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega na tecla para ouvires o pacote que escolheste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите клавишу, чтобы услышать выбранный набор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下按键，听听你选的声音包。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajuta klahvi, et kuulda valitud pakki."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Druk die sleutel om die pakkie wat jy gekies het te hoor."
          }
        }
      }
    },
    "Press the keys above to see the light react.": {
      "extractionState": "manual",
      "localizations": {
