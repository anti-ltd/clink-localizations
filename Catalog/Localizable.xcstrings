            "value": "Raskere og travlere, i mindre biter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nopeampi ja kiireisempi, pienempinä paloina."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih cepat dan lebih sibuk, dalam potongan yang lebih kecil."
