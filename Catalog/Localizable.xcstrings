    "Theme holds the built-in ones and a builder for your own.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema hou die ingeboude en 'n bouer vir jou eie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter „Design“ liegen die mitgelieferten Designs und ein Editor für deine eigenen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema guarda los que vienen incluidos y un editor para los tuyos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teema hoiab sisseehitatuid ja ehitaja sinu enda jaoks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thème contient ceux fournis et un éditeur pour les tiens."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Téma oldalon vannak a beépítettek és egy szerkesztő a sajátjaidhoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Tema ci sono quelli inclusi e un editor per i tuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「テーマ」には標準のテーマと、自分で作るためのエディタがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마에는 기본 테마들과 직접 만드는 편집기가 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema menyimpan yang terbina dalam dan pembina untuk tema anda sendiri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema tem os que vêm de origem e um editor para os teus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Темах» лежат встроенные варианты и редактор для своих."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“主题”里有内置主题，也有做自己主题的编辑器。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema le deține pe cele încorporate și un constructor pentru al tău."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het thema bevat de ingebouwde en een eigen bouwer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“主題”裡有內建主題，也有做自己主題的編輯器。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motyw zawiera wbudowane i narzędzie do tworzenia własnych."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема містить вбудовані та власний конструктор."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema, yerleşik olanları ve kendinize ait bir oluşturucuyu içerir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Téma obsahuje ty vestavěné a stavitel pro vaše vlastní."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Téma obsahuje vstavané a staviteľa pre vaše vlastné."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το θέμα περιέχει τα ενσωματωμένα και ένα οικοδόμο για το δικό σας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema håller de inbyggda och en byggare för din egen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema holder de indbyggede og en bygherre til din egen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema holder de innebygde og en byggmester for din egen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teema sisältää sisäänrakennetut ja rakentajan omallesi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema berisi tema bawaan dan pembuatnya sendiri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ đề chứa những cái được tích hợp sẵn và một công cụ xây dựng cho riêng bạn."
          }
        }
      }
    },
