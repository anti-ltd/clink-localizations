        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belajar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Học tập"
          }
        }
      }
    },
    "Learning stays on your device. Nothing is uploaded. Clearing removes everything right away.": {
      "extractionState": "stale",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer bly op jou toestel. Niks word opgelaai nie. Die skoonmaak verwyder alles dadelik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lernen bleibt auf deinem Gerät. Nichts wird hochgeladen. Beim Löschen ist sofort alles weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aprendizaje se queda en tu dispositivo. No se sube nada. Al borrar se elimina todo al momento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Õppimine jääb sinu seadmesse. Midagi ei laadita üles. Tühjendamine eemaldab kõik koheselt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apprentissage reste sur ton appareil. Rien n'est envoyé. L'effacement supprime tout tout de suite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tanulás az eszközödön marad. Semmi nem töltődik fel. A törlés azonnal eltávolít mindent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apprendimento resta sul tuo dispositivo. Niente viene caricato. Cancellando rimuovi tutto all'istante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習はこのデバイスの中だけで行われます。何もアップロードされません。消去するとすぐにすべて消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학습은 기기에만 남아요. 아무것도 올라가지 않아요. 지우면 모든 게 바로 사라져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelajaran kekal pada peranti anda. Tiada apa dimuat naik. Mengosongkannya buang semuanya serta-merta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aprendizagem fica no teu dispositivo. Nada é enviado. Ao limpar, remove tudo logo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обучение не покидает ваше устройство. Ничего не загружается. Очистка удаляет всё сразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学习只留在你的设备上。什么都不会上传。清除会立刻抹掉一切。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Învățarea rămâne pe dispozitivul dvs. Nu este încărcat nimic. Ștergerea elimină totul imediat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leren blijft op uw apparaat. Er wordt niets geüpload. Door te wissen wordt alles meteen verwijderd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "學習只留在你的裝置上。什麼都不會上傳。清除會立刻抹掉一切。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauka pozostaje na Twoim urządzeniu. Nic nie zostało przesłane. Czyszczenie usuwa wszystko od razu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навчання залишається на вашому пристрої. Нічого не завантажено. Очищення знімає все відразу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğrenme cihazınızda kalır. Hiçbir şey yüklenmedi. Temizleme her şeyi anında kaldırır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Učení zůstává na vašem zařízení. Nic není nahráno. Vymazáním se vše okamžitě odstraní."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Učenie zostáva na vašom zariadení. Nič sa neodovzdáva. Vymazaním sa všetko okamžite odstráni."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μάθηση παραμένει στη συσκευή σας. Δεν έχει ανέβει τίποτα. Η εκκαθάριση αφαιρεί τα πάντα αμέσως."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inlärningen stannar på din enhet. Ingenting laddas upp. Rensning tar bort allt direkt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læring forbliver på din enhed. Intet er uploadet. Rydning fjerner alt med det samme."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Læring forblir på enheten din. Ingenting er lastet opp. Rydding fjerner alt med en gang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppiminen pysyy laitteessasi. Mitään ei ole ladattu. Tyhjennys poistaa kaiken heti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelajaran tetap ada di perangkat Anda. Tidak ada yang diunggah. Kliring menghapus semuanya dengan segera."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc học vẫn ở trên thiết bị của bạn. Không có gì được tải lên. Việc xóa sẽ loại bỏ mọi thứ ngay lập tức."
          }
        }
      }
    },
