          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka paljon kukin näppäin pullistuu ulospäin sormesi kulkiessa sen yli."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa menonjol setiap tuts ke luar saat jari Anda melewatinya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi phím phình ra bao nhiêu khi ngón tay bạn lướt qua nó."
          }
        }
      }
    },
    "How much keys wobble before they settle. None settles cleanly.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark Tasten nachschwingen, bevor sie zur Ruhe kommen. Ohne kommt sie sauber zur Ruhe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto se tambalean las teclas antes de asentarse. Ninguno se asienta limpio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui palju klahvid enne paigale jäämist võnguvad. Puudub tähendab sujuvat peatumist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quel point les touches oscillent avant de se stabiliser. Aucun se stabilise net."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyire rezegnek a billentyűk, mielőtt megállnak. A Nincs simán áll meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto oscillano i tasti prima di fermarsi. Nessuno si ferma in modo pulito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーが止まるまでにどれだけ揺れるか。なしはぴたっと止まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 멈추기 전에 얼마나 흔들릴지 정해요. 없음은 깔끔하게 멈춰요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Betapa banyak kekunci bergoyang sebelum berhenti. Tiada berhenti dengan kemas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto as teclas oscilam antes de assentar. Nenhum assenta de forma limpa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько клавиши колеблются, прежде чем успокоиться. «Нет» — без колебаний."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键停稳前晃动的程度。“无”表示干脆停下。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de mult se clătinesc cheile înainte să se așeze. Niciunul nu se așează curat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel sleutels wiebelen voordat ze vastlopen. Geen enkele vestigt zich netjes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵停穩前晃動的程度。“無”表示乾脆停下。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel sleutels wieg voordat hulle tot stilstand kom. Geen kom netjies tot stilstand nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak bardzo klawisze się chwieją, zanim się ustabilizują. Żaden nie osadza się czysto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки хитаються ключі, перш ніж вони осідають. Жоден не осідає чисто."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerleşmeden önce ne kadar çok anahtar sallanıyor. Hiçbiri temiz bir şekilde yerleşmez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak moc se klíče chvějí, než se usadí. Žádný se neusazuje čistě."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Koľko kľúčov sa kolíše, kým sa usadí. Žiadna sa neusadí čisto."
