    "Build a tab from whichever emoji you actually send. The ones you react with, the ones your group chat runs on.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bou 'n oortjie van watter emoji jy ook al stuur. Diegene waarmee jy reageer, dié waarop jou groepklets loop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bau dir einen Tab aus den Emoji, die du wirklich verschickst. Die, mit denen du reagierst, die, von denen dein Gruppenchat lebt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una pestaña con los emoji que de verdad envías. Los de tus reacciones, los que sostienen tu grupo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehita kaart nendest emojidest, mida sa tegelikult saadad. Need, millega sa reageerid, need, mille pealt sinu rühmavestlus käib."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose un onglet avec les émojis que tu envoies vraiment. Ceux de tes réactions, ceux qui font tourner ta conversation de groupe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakj össze egy fület azokból az emodzsikból, amiket tényleg küldesz. Amikkel reagálsz, amiken a csoportos csevegésed elvan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una scheda con le emoji che mandi davvero. Quelle delle tue reazioni, quelle che tengono in piedi la chat di gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際に送っている絵文字だけでタブをつくれます。リアクションに使うもの、グループチャットで飛び交うもの。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제로 보내는 이모지만 모아 탭을 만드세요. 반응할 때 쓰는 것, 단체 대화방을 굴러가게 하는 것."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bina tab daripada emoji yang anda betul-betul hantar. Yang anda guna untuk bertindak balas, yang menghidupkan sembang kumpulan anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Monta um separador com os emoji que envias mesmo. Os das tuas reações, os que sustentam o teu grupo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соберите вкладку из тех эмодзи, которые вы правда отправляете. Тех, которыми реагируете, и тех, на которых держится ваш чат."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你真正会发的表情组一个标签页。你常拿来回应的那些，你的群聊离不开的那些。"
          }
        }
      }
    },
    "Build a whole keyboard UI in Python": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bou 'n hele sleutelbord-UI in Python"
          }
