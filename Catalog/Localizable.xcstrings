    "Trims this pack against the others, so switching packs doesn't change how loud typing is.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Knip hierdie pakket teen die ander af, so om van pakkies om te skakel, verander nie hoe hard tik is nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleicht dieses Paket an die anderen an, damit ein Paketwechsel die Tipplautstärke nicht verändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta este paquete respecto a los demás, para que cambiar de paquete no cambie el volumen al escribir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohendab seda pakki teiste suhtes, nii et pakkide vahetamine ei muuda tipimise valjust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste ce pack par rapport aux autres, pour que changer de pack ne change pas le volume de la frappe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A többi csomaghoz igazítja ezt, így csomagváltáskor nem változik a gépelés hangereje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allinea questo pacchetto agli altri, così cambiare pacchetto non cambia il volume della digitazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのパックと音量をそろえます。パックを切り替えても、タイプ音の大きさは変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 팩에 맞춰 음량을 고릅니다. 팩을 바꿔도 타이핑 소리 크기는 그대로예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Melaraskan pek ini berbanding yang lain, supaya menukar pek tidak mengubah kekuatan bunyi menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerta este pacote em relação aos outros, para que mudar de pacote não mude o volume da escrita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подгоняет громкость этого набора под остальные, чтобы при смене набора печать не становилась громче или тише."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这个包和其他包对齐音量，换包时打字的响度不会跟着变。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Decupează acest pachet față de celelalte, astfel încât schimbarea pachetelor nu schimbă cât de tare este tastarea."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimt dit pakket ten opzichte van de anderen, zodat het wisselen van pakket niets verandert aan hoe luid typen is."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把這個包和其他包對齊音量，換包時打字的響度不會跟著變。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przycina ten pakiet do innych, więc przełączanie pakietów nie zmienia głośności pisania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порівнює цей пакет з іншими, тому зміна пакетів не змінює гучність набору тексту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu paketi diğerlerine göre kısaltır, böylece paketleri değiştirmek yazmanın yüksek sesini değiştirmez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ořízne tento balíček proti ostatním, takže přepínání balíčků nezmění hlasitost psaní."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Orezáva tento balík oproti ostatným, takže prepínanie balíkov nemení hlasitosť písania."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περικόπτει αυτό το πακέτο σε σχέση με τα άλλα, ώστε η εναλλαγή πακέτων να μην αλλάζει το πόσο δυνατή είναι η πληκτρολόγηση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimmar det här paketet mot de andra, så att byta paket ändrar inte hur högt du skriver."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimmer denne pakke mod de andre, så skift af pakke ændrer ikke, hvor højt du skriver."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimmer denne pakken mot de andre, så å bytte pakke endrer ikke hvor høyt du skriver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leikkaa tämän paketin muita vasten, joten pakettien vaihtaminen ei muuta kirjoittamisen voimakkuutta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memangkas paket ini dibandingkan paket lainnya, jadi berpindah paket tidak mengubah seberapa kerasnya mengetik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắt bớt gói này so với các gói khác, vì vậy việc chuyển đổi gói không làm thay đổi âm lượng gõ phím."
          }
        }
      }
    },
