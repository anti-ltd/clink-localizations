    "123, space, and return go with it. Add keys back from Key if you want them.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "123, spasie, en terugkeer gaan daarmee saam. Voeg sleutels terug vanaf Key as jy dit wil hê."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "123, Leertaste und Return verschwinden mit. Du kannst sie unter Tasten wieder hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "123, espacio y retorno desaparecen con ella. Puedes volver a añadirlos desde Teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "123, tühik ja Enter kaovad koos sellega. Saad need klahvid uuesti lisada menüüs Klahvid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "123, espace et retour disparaissent avec eux. Vous pouvez les rajouter depuis Touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A 123, a szóköz és az Enter vele megy. A Billentyűk menüpontban veheted vissza őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "123, spazio e invio spariscono con loro. Puoi riaggiungerli da Tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "123、スペース、Return も一緒に消えます。必要なキーは「キー」から追加し直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "123, 스페이스, Return 키도 함께 사라집니다. 키 메뉴에서 다시 추가할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "123, bar ruang dan return turut hilang. Tambah semula daripada Kekunci jika anda mahu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "123, espaço e retorno vão junto. Você pode adicioná-los novamente em Teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "123, пробел и возврат исчезнут вместе с ней. Вернуть их можно в разделе «Клавиши»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "123、空格和回车键会一起移除。如需保留可在“按键”中重新添加。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "123, spațiu și întoarcere du-te cu el. Adăugați cheile înapoi de la Key dacă le doriți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "123, spatie en return horen daarbij. Voeg sleutels terug van Key als je ze wilt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "123、空格和回車鍵會一起移除。如需保留可在“按鍵”中重新新增。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "123, spacja i powrót idą z tym. Jeśli chcesz, dodaj klucze z powrotem do Key."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "123, пробіл, і повернутися разом з ним. Додайте ключі назад із Key, якщо хочете."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "123, boşluk ve dönüş de onunla birlikte gelir. İsterseniz anahtarları Key'den geri ekleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "123, prostor a návrat jdi s tím. Pokud je chcete, přidejte klíče zpět z Key."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "123, priestor a návrat choďte s ním. Ak chcete, pridajte kľúče späť z kľúča."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "123, διάστημα, και η επιστροφή πηγαίνετε μαζί του. Προσθέστε κλειδιά πίσω από το Key αν τα θέλετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "123, rymden, och retur gå med det. Lägg tillbaka nycklar från Key om du vill ha dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "123, mellemrum, og retur gå med det. Tilføj nøgler tilbage fra Key, hvis du vil have dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "123, mellomrom og retur gå med det. Legg til nøkler tilbake fra Key hvis du vil ha dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "123, välilyönti ja paluu menevät mukana. Lisää avaimet takaisin Keystä, jos haluat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "123, spasi, dan kembali ikut serta. Tambahkan kunci kembali dari Key jika Anda menginginkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "123, dấu cách và quay trở lại với nó. Thêm lại các khóa từ Key nếu bạn muốn."
          }
        }
      }
    },
