    "Thick trail · strong, wide ripple.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicke Spur · starke, breite Welle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trazo grueso · onda fuerte y amplia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace épaisse · ondulation forte et large."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastag nyom · erős, széles hullám."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scia spessa · onda forte e ampia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "太い軌跡 · 強く広い波紋。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두꺼운 궤적 · 강하고 넓은 물결."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejak tebal · riak kuat, luas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasto espesso · ondulação forte e larga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Толстый след · сильная широкая волна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粗轨迹 · 又强又宽的涟漪。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paks jälg · tugev, lai laine."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dik spoor · sterk, wye rimpeling."
          }
        }
      }
    },
