    "Tap reset on its row, or reset the lot if it's got away from you.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik terugstel op sy ry, of stel die lot terug as dit van jou af weggekom het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in ihrer Zeile auf Zurücksetzen, oder setz gleich alles zurück, wenn es zu viel geworden ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca restablecer en su fila, o restablécelo todo si se te ha ido de las manos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta selle real Lähtesta või lähtesta kõik, kui see on kontrollist väljunud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Réinitialiser sur sa ligne, ou remets tout à zéro si ça t'a échappé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a sorában a visszaállításra, vagy állítsd vissza az egészet, ha elszaladt a dolog."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ripristina sulla sua riga, o ripristina tutto se ti è sfuggito di mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その行のリセットをタップします。収拾がつかないときは、まとめてリセットもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 줄의 되돌리기를 누르세요. 너무 많이 손댔다면 전체를 되돌려도 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik tetapkan semula pada barisnya, atau tetapkan semula kesemuanya jika ia sudah terlalu jauh."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em repor na linha dela, ou repõe tudo se a coisa te fugiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Сбросить» в её строке — или сбросьте всё, если дело зашло далеко."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点这一行的还原；要是改得太乱，也可以整体还原。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți resetare pe rândul său sau resetați lotul dacă a fost îndepărtat de dvs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op 'reset' in de rij, of reset het perceel als het bij je vandaan is."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點這一行的還原；要是改得太亂，也可以整體還原。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij resetuj w jego rzędzie lub zresetuj parcelę, jeśli ci uciekła."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться скинути його рядок або скиньте лот, якщо він утік від вас."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sırasında sıfırla'ya dokunun veya sizden uzaklaşmışsa partiyi sıfırlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na reset na jeho řádku nebo resetujte pozemek, pokud se od vás dostal pryč."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnite na reset na jeho riadku alebo resetujte pozemok, ak sa od vás dostal preč."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε επαναφορά στη σειρά του ή επαναφέρετε την παρτίδα εάν έχει απομακρυνθεί από εσάς."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på återställ på dess rad, eller återställ partiet om det har kommit ifrån dig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på nulstil på dens række, eller nulstil partiet, hvis det er blevet væk fra dig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på tilbakestill på raden, eller tilbakestill partiet hvis det har kommet bort fra deg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta nollaa sen rivillä tai nollaa tontti, jos se on kaukana sinusta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk setel ulang pada barisnya, atau setel ulang lot jika sudah jauh dari Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào đặt lại trên hàng của nó hoặc đặt lại lô nếu nó rời xa bạn."
          }
        }
      }
    },
    "Tap space on any number or symbol page to return to letters.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap space on any number or symbol page to return to letters."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einer Zahlen- oder Symbolseite auf die Leertaste, um zu den Buchstaben zurückzukehren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa espacio en cualquier página de números o símbolos para volver a las letras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähtede juurde naasmiseks vajuta numbri- või sümbolilehel tühikuklahvi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur espace depuis une page de chiffres ou de symboles pour revenir aux lettres."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A betűkhöz való visszatéréshez koppints a szóközre bármelyik szám- vagy szimbólumoldalon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la barra spaziatrice in qualsiasi pagina di numeri o simboli per tornare alle lettere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数字や記号のページでスペースキーをタップすると、文字のページに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자 또는 기호 페이지에서 스페이스 키를 누르면 문자 페이지로 돌아갑니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik bar ruang pada mana-mana halaman nombor atau simbol untuk kembali ke huruf."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca na barra de espaços em qualquer página de números ou símbolos para voltar às letras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите пробел на любой странице цифр или символов, чтобы вернуться к буквам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意数字或符号页面轻点空格键，即可返回字母页面。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți spațiu pe orice pagină de număr sau simbol pentru a reveni la litere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de spatiebalk op een cijfer- of symboolpagina om terug te keren naar letters."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意數字或符號頁面輕點空格鍵，即可返回字母頁面。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op die spasiebalk op enige syfer- of simboolbladsy om na letters terug te keer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij spację na dowolnej stronie z liczbami lub symbolami, aby powrócić do liter."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть пробіл на будь-якій сторінці з цифрами чи символами, щоб повернутися до літер."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harflere dönmek için herhangi bir sayı veya sembol sayfasındaki boşluk tuşuna basın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na mezeru na libovolné stránce s číslem nebo symbolem se vrátíte k písmenům."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na medzeru na ľubovoľnej stránke s číslom alebo symbolom sa vrátite k písmenám."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε το διάστημα σε οποιονδήποτε αριθμό ή σελίδα συμβόλων για να επιστρέψετε στα γράμματα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på blanksteg på valfri siffra eller symbolsida för att återgå till bokstäver."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på mellemrumstasten på et vilkårligt tal eller symbolside for at vende tilbage til bogstaver."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk mellomrom på en tall- eller symbolside for å gå tilbake til bokstaver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta minkä tahansa numero- tai symbolisivun välilyöntiä palataksesi kirjaimiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk spasi pada halaman nomor atau simbol mana pun untuk kembali ke huruf."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào dấu cách trên bất kỳ trang số hoặc ký hiệu nào để quay lại các chữ cái."
          }
        }
      }
    },
    "Tap the canvas to drop points, then Close to join the last one back to the first.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el lienzo para ir dejando puntos y luego pulsa Cerrar para unir el último con el primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la zone de dessin pour poser des points, puis Fermer pour relier le dernier au premier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Zeichenfläche, um Punkte zu setzen, dann „Schließen“, um den letzten mit dem ersten zu verbinden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca l'area di disegno per posare i punti, poi Chiudi per unire l'ultimo al primo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na área de desenho para colocar pontos e depois em Fechar para ligar o último ao primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Касайтесь холста, чтобы расставлять точки, затем нажмите «Замкнуть», чтобы соединить последнюю с первой."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kanvas untuk meletakkan titik, kemudian Tutup untuk menyambungkan yang terakhir kepada yang pertama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a vászonra a pontok elhelyezéséhez, majd a Lezárás gombbal kösd az utolsót az elsőhöz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスをタップして点を置き、「閉じる」で最後の点を最初の点につなぎます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点画布依次放置节点，然后点“闭合”把最后一个连回第一个。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스를 탭해 점을 찍은 다음 '닫기'로 마지막 점을 첫 점에 잇습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta lõuendit punktide asetamiseks ja seejärel „Sulge“, et ühendada viimane esimesega."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți pânza pentru a arunca puncte, apoi Închideți pentru a le alătura pe ultimul înapoi la primul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het canvas om punten neer te zetten en vervolgens op Sluiten om de laatste weer bij de eerste te voegen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點畫布依次放置節點，然後點“閉合”把最後一個連回第一個。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op die doek om punte te plaas, en dan op \"Sluit\" om die laaste punt met die eerste te verbind."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij płótno, aby upuścić punkty, a następnie Zamknij, aby połączyć ostatni z powrotem z pierwszym."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться полотна, щоб відкинути точки, а потім натисніть «Закрити», щоб приєднати останню до першої."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puan bırakmak için tuvale dokunun, ardından sonuncuyu ilkiyle birleştirmek için Kapat'a dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na plátno přesuňte body a poté klepnutím na tlačítko Zavřít spojte poslední zpět s prvním."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na plátno presuňte body a potom klepnutím na tlačidlo Zavrieť spojte posledný bod späť s prvým."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε τον καμβά για να ρίξετε πόντους και μετά Κλείσιμο για να συνδέσετε τον τελευταίο πίσω στον πρώτο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på duken för att släppa punkter, och sedan på Stäng för att koppla tillbaka den sista till den första."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på lærredet for at slippe punkter, og derefter Luk for at slutte det sidste tilbage til det første."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på lerretet for å slippe poeng, og deretter Lukk for å slå den siste tilbake til den første."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta kangasta pudottaaksesi pisteitä ja sitten Sulje liittääksesi viimeinen takaisin ensimmäiseen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk kanvas untuk melepaskan titik, lalu Tutup untuk menggabungkan titik terakhir kembali ke titik pertama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào khung vẽ để thả điểm, sau đó nhấn Đóng để nối điểm cuối cùng trở lại điểm đầu tiên."
          }
        }
      }
    },
    "Tap the emoji key, or swipe up on 123, to open emoji inside Clink. No second keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik die emoji-sleutel, of swiep op op 123, om emoji binne Clink oop te maak. Geen tweede sleutelbord nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe die Emoji-Taste oder wische auf 123 nach oben, um Emoji in Clink zu öffnen. Keine zweite Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la tecla de emoji, o desliza hacia arriba en 123, para abrir emoji dentro de Clink. Sin un segundo teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta emoji-klahvile või viipa 123-l üles, et avada emoji Clinki sees. Teist klaviatuuri pole vaja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche la touche emoji, ou balaie vers le haut sur 123, pour ouvrir les emoji dans Clink. Pas de second clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Érintse meg az emoji billentyűt, vagy húzza fel a 123-at az emoji Clinkben való megnyitásához. Nincs második billentyűzet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il tasto emoji, o scorri verso l'alto su 123, per aprire le emoji in Clink. Nessuna seconda tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵文字キーをタップするか、123 で上にスワイプして Clink 内で絵文字を開きます。2 つ目のキーボードは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이모지 키를 누르거나 123에서 위로 스와이프해 Clink 안에서 이모지를 여세요. 두 번째 키보드는 필요 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kekunci emoji, atau leret ke atas pada 123, untuk membuka emoji dalam Clink. Tiada papan kekunci kedua."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na tecla de emoji, ou deslize para cima em 123, para abrir emoji no Clink. Sem segundo teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите клавишу эмодзи или смахните вверх по 123, чтобы открыть эмодзи внутри Clink. Вторая клавиатура не нужна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按表情键，或在 123 上向上轻扫，在 Clink 内打开表情。无需第二个键盘。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți tasta emoji sau glisați în sus pe 123 pentru a deschide emoji în interiorul Clink. Fără a doua tastatură."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de emoji-toets of veeg omhoog op 123 om emoji in Clink te openen. Geen tweede toetsenbord."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按表情鍵，或在 123 上向上輕掃，在 Clink 內開啟表情。無需第二個鍵盤。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij klawisz emoji lub przesuń w górę na 123, aby otworzyć emoji w Clink. Brak drugiej klawiatury."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться клавіші емодзі або проведіть пальцем угору по 123, щоб відкрити емодзі в Clink. Немає другої клавіатури."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink içindeki emojiyi açmak için emoji tuşuna dokunun veya 123'te yukarı kaydırın. İkinci klavye yok."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na klávesu emodži nebo přejetím prstem nahoru po 123 otevřete emotikony uvnitř Clink. Žádná druhá klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na kláves emoji alebo potiahnutím prstom nahor po 123 otvoríte emotikony vo vnútri Clink. Žiadna druhá klávesnica."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε το πλήκτρο emoji ή σύρετε προς τα επάνω στο 123, για να ανοίξετε το emoji μέσα στο Clink. Χωρίς δεύτερο πληκτρολόγιο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på emoji-tangenten eller svep uppåt på 123 för att öppna emoji inuti Clink. Inget andra tangentbord."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på emoji-tasten, eller stryg op på 123, for at åbne emoji inde i Clink. Intet andet tastatur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på emoji-tasten, eller sveip opp på 123, for å åpne emoji inne i Clink. Ingen andre tastatur."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta emoji-näppäintä tai pyyhkäise ylöspäin kohdassa 123 avataksesi emojin Clink:n sisällä. Ei toista näppäimistöä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tombol emoji, atau geser ke atas pada 123, untuk membuka emoji di dalam Clink. Tidak ada keyboard kedua."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào phím biểu tượng cảm xúc hoặc vuốt lên trên 123 để mở biểu tượng cảm xúc bên trong Clink. Không có bàn phím thứ hai."
          }
        }
      }
    },
    "Tap the globe key until you reach Clink.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik die aardbolsleutel totdat jy Clink bereik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Globus-Taste, bis du bei Clink bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la tecla del globo hasta llegar a Clink."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta gloobusklahvile, kuni jõuad Clinkini."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche la touche globe jusqu'à arriver sur Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a földgömb billentyűre, amíg el nem éred a Clinket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il tasto del globo finché non arrivi a Clink."
          }
        },
