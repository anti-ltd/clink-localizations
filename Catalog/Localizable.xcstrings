    "Trace a word by gliding across the letters. Lift to insert it. Tapping still works normally.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne ein Wort, indem du über die Buchstaben gleitest. Heb den Finger, um es einzufügen. Tippen geht weiterhin ganz normal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traza una palabra deslizando el dedo por las letras. Levántalo para insertarla. Tocar sigue funcionando igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace un mot en glissant sur les lettres. Lève le doigt pour l'insérer. Le toucher marche toujours normalement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajzolj egy szót úgy, hogy végigcsúszol a betűkön. Emeld fel az ujjad a beszúráshoz. A koppintás továbbra is működik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia una parola scorrendo sulle lettere. Solleva il dito per inserirla. Il tocco funziona ancora come sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字の上を指でなぞって単語を書きます。指を離すと挿入されます。タップも今までどおり使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자 위를 쭉 미끄러뜨려서 단어를 그려요. 손을 떼면 입력돼요. 그냥 톡톡 누르는 것도 잘 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejak perkataan dengan meluncur merentasi huruf. Angkat untuk memasukkannya. Mengetik masih berfungsi seperti biasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traça uma palavra deslizando pelas letras. Levanta o dedo para a inserir. Tocar continua a funcionar como sempre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите по буквам, чтобы очертить слово. Поднимите палец — оно вставится. Обычные нажатия при этом работают как всегда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在字母上滑一下就能划出一个单词，抬起手指就插入。点按照样能用。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Joonista sõna tähtede peal libisedes. Tõsta sõrm, et see sisestada. Puudutamine töötab endiselt tavaliselt."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trek 'n woord na deur oor die letters te gly. Lig om dit in te voeg. Tik werk steeds normaal."
          }
        }
      }
    },
