    "Sync is off. These copies stay in iCloud until you delete them.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronisering is af. Hierdie kopieë bly in iCloud totdat jy dit uitvee."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung ist aus. Diese Kopien bleiben in iCloud, bis du sie löschst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización está desactivada. Estas copias seguirán en iCloud hasta que las borres."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sünkroonimine on väljas. Need koopiad jäävad iCloudi, kuni sa need kustutad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation est désactivée. Ces copies restent dans iCloud jusqu’à ce que tu les supprimes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szinkronizálás ki van kapcsolva. Ezek a másolatok az iCloudban maradnak, amíg nem törlöd őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione è disattivata. Queste copie restano su iCloud finché non le elimini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期はオフです。これらのコピーは削除するまでiCloudに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화가 꺼져 있습니다. 이 사본은 삭제할 때까지 iCloud에 남아 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyegerakan dimatikan. Salinan ini kekal dalam iCloud sehingga anda memadamnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização está desligada. Estas cópias ficam no iCloud até as apagares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация выключена. Эти копии останутся в iCloud, пока вы их не удалите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步已关闭。这些副本会一直留在 iCloud 中，直到你删除。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizarea este dezactivată. Aceste copii rămân în iCloud până când le ștergeți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie is uitgeschakeld. Deze kopieën blijven in iCloud totdat u ze verwijdert."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步已關閉。這些副本會一直留在 iCloud 中，直到你刪除。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja jest wyłączona. Kopie te pozostają w iCloud, dopóki ich nie usuniesz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізацію вимкнено. Ці копії залишаються в iCloud, доки ви їх не видалите."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkronizasyon kapalı. Bu kopyalar siz silinceye kadar iCloud'te kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizace je vypnutá. Tyto kopie zůstanou v iCloud, dokud je neodstraníte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizácia je vypnutá. Tieto kópie zostanú v iCloud, kým ich neodstránite."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο συγχρονισμός είναι απενεργοποιημένος. Αυτά τα αντίγραφα παραμένουν στο iCloud μέχρι να τα διαγράψετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronisering är avstängd. Dessa kopior stannar i iCloud tills du tar bort dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronisering er slået fra. Disse kopier forbliver i iCloud, indtil du sletter dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronisering er av. Disse kopiene forblir i iCloud til du sletter dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronointi on pois päältä. Nämä kopiot pysyvät iCloud:ssä, kunnes poistat ne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronisasi tidak aktif. Salinan ini tetap berada di iCloud sampai Anda menghapusnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ hóa đã tắt. Những bản sao này vẫn còn trong iCloud cho đến khi bạn xóa chúng."
          }
        }
      }
    },
