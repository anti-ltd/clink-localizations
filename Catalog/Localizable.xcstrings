    "Swipe a clip and tap the pin to keep it, while the rest ages out.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wisch über einen Eintrag und tipp auf die Nadel, damit er bleibt, während der Rest altert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza un elemento y toca el pin para conservarlo mientras el resto caduca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaie un élément et touche l'épingle pour le garder pendant que le reste s'efface avec le temps."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd el az elemet, és koppints a gombostűre, hogy megmaradjon, míg a többi idővel kikopik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri un elemento e tocca la puntina per tenerlo, mentre il resto scade col tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目をスワイプしてピンをタップすると、その項目だけ残り、ほかは古いものから消えていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 쓸어 핀을 누르면 그 항목만 남고, 나머지는 오래된 순으로 사라집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret satu item dan ketik pin untuk mengekalkannya, sementara yang lain luput mengikut masa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza um item e toca no pino para o manteres, enquanto os outros vão saindo com o tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните фрагмент и нажмите на булавку, чтобы оставить его, пока остальные устаревают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把某条划开、点一下图钉就能留住它，其余的会随时间被挤掉。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viipa klipi üle ja puuduta nõela, et see hoida, samal ajal kui ülejäänud aeguvad välja."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Swiep 'n skeersel en tik op die pen om dit te hou, terwyl die res verouder."
          }
        }
      }
    },
    "Swipe a saved note right to pin it in Cling. Requires Full Access.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische eine gespeicherte Notiz nach rechts, um sie in Cling anzupinnen. Erfordert Vollzugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza una nota guardada a la derecha para fijarla en Cling. Requiere acceso completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaie une note enregistrée vers la droite pour l’épingler dans Cling. Nécessite l’accès complet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd jobbra a mentett jegyzetet, hogy rögzítsd a Clingben. Teljes hozzáférés szükséges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri una nota salvata verso destra per fissarla in Cling. Richiede l'accesso completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したメモを右にスワイプすると Cling にピン留めされます。フルアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 메모를 오른쪽으로 밀면 Cling에 고정됩니다. 전체 접근 권한이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret nota tersimpan ke kanan untuk menyematnya dalam Cling. Memerlukan Akses Penuh."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize uma nota guardada para a direita para a fixar no Cling. Requer acesso total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните сохранённую заметку вправо, чтобы закрепить её в Cling. Нужен полный доступ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向右滑动已保存的备忘，即可固定到 Cling。需要完全访问权限。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viipa salvestatud märge paremale, et see Clingis kinnitada. Vajab täisjuurdepääsu."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Swiep 'n gestoorde nota regs om dit in Cling vas te pen. Vereis volle toegang."
          }
        }
      }
    },
    "Swipe a text clip right to pin it as a note in Cling. Requires Full Access.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische einen Textschnipsel nach rechts, um ihn als Notiz in Cling anzupinnen. Erfordert Vollzugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza un fragmento de texto a la derecha para guardarlo como nota en Cling. Requiere acceso completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaie un extrait de texte vers la droite pour l’épingler comme note dans Cling. Nécessite l’accès complet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd jobbra a szövegrészletet, hogy jegyzetként rögzítsd a Clingben. Teljes hozzáférés szükséges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri un testo copiato verso destra per salvarlo come nota in Cling. Richiede l'accesso completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストのクリップを右にスワイプすると Cling にメモとしてピン留めされます。フルアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 클립을 오른쪽으로 밀면 Cling에 메모로 고정됩니다. 전체 접근 권한이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret klip teks ke kanan untuk menyematnya sebagai nota dalam Cling. Memerlukan Akses Penuh."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize um excerto de texto para a direita para o fixar como nota no Cling. Requer acesso total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните текстовый фрагмент вправо, чтобы закрепить его заметкой в Cling. Нужен полный доступ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向右滑动文本剪贴内容，即可作为备忘固定到 Cling。需要完全访问权限。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viipa tekstiklipp paremale, et see Clingis märkmena kinnitada. Vajab täisjuurdepääsu."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Swiep 'n tekssnit regs om dit as 'n nota in Cling vas te pen. Vereis volle toegang."
          }
        }
      }
    },
    "Swipe a text clip right to pin it as a note in the Cling app. Requires Full Access.": {
