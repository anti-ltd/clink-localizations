          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj, aby przewijać tekst z powrotem, zwiększając prędkość w miarę upływu czasu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте його, щоб повернутися до тексту, набираючи швидкість."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
