            "value": "Tahan ruang untuk menyeret. Kunci tetap terlihat tetapi tidak bergerak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ khoảng trống để kéo. Các phím vẫn hiển thị nhưng bị trơ."
          }
        }
      }
    },
