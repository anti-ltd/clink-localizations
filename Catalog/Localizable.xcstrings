    "Translate takes what you've typed and puts the translation into the field, ready to send.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Translate neem wat jy getik het en plaas die vertaling in die veld, gereed om te stuur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Übersetzen“ nimmt, was du getippt hast, und setzt die Übersetzung ins Feld — fertig zum Senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducir coge lo que has escrito y deja la traducción en el campo, lista para enviar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlge võtab selle, mida tipid, ja paneb tõlke välja, valmis saatmiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduire reprend ce que tu as tapé et place la traduction dans le champ, prête à envoyer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Fordítás fogja, amit beírtál, és a fordítást teszi a mezőbe, küldésre készen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduci prende quello che hai scritto e mette la traduzione nel campo, pronta da inviare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「翻訳」は入力した文章を訳し、送信できる状態で入力欄に入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역은 입력한 문장을 번역해 그대로 입력란에 넣어 줍니다. 바로 보내면 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemah mengambil apa yang anda taip dan meletakkan terjemahannya dalam medan itu, sedia untuk dihantar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Traduzir pega no que escreveste e põe a tradução no campo, pronta a enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Перевод» берёт напечатанное и кладёт перевод прямо в поле — можно отправлять."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“翻译”会把你写好的内容译好，直接放回输入框，可以直接发。"
          }
        }
      }
    },
