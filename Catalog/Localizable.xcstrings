          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beligtingstyl"
          }
        }
      }
    },
    "Paints": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina"
          }
        },
        "fr": {
          "stringUnit": {
