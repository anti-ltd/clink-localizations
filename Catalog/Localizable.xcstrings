    "Warm and waiting for you to speak": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Warm en wag vir jou om te praat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit und wartet darauf, dass du sprichst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo, esperando a que hables"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmis ja ootab, et sa räägiksid"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt, en attente que tu parles"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Készenlétben, arra vár, hogy megszólalj"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto, in attesa che tu parli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中です。話しかけてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중입니다. 말씀하세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedia menunggu anda bercakap"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto, à espera de que fale"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепло и ждёт, когда вы заговорите"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已就绪，等你开口"
          }
        }
      }
    },
    "Warp Speed": {
