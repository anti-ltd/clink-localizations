        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Werkzeuge, Übersetzung und der KI-Editor nutzen diesen Anbieter. Tippvorschläge und Vorhersagen bleiben auf dem Gerät."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli strumenti IA, la traduzione e il creatore con IA usano questo fornitore. I suggerimenti e le previsioni di scrittura restano sul dispositivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ferramentas de IA, a tradução e o criador com IA usam este fornecedor. As sugestões e previsões de escrita ficam no dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструменты ИИ, перевод и создание с помощью ИИ используют этого провайдера. Подсказки и прогнозы при вводе остаются на устройстве."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat AI, terjemahan dan pencipta AI menggunakan penyedia ini. Cadangan dan ramalan semasa menaip kekal pada peranti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AI-eszközök, a fordítás és az AI-szerkesztő ezt a szolgáltatót használják. A gépelési javaslatok és előrejelzések az eszközön maradnak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIツール、翻訳、AIによる作成には、このプロバイダーを使用します。入力候補や予測はデバイス上で処理されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 工具、翻译和 AI 创建功能使用此提供商。输入建议和预测仍在设备上处理。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 도구, 번역 및 AI 만들기에 이 제공업체를 사용합니다. 입력 제안과 예측은 기기에서 처리됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-tööriistad, tõlge ja AI abil loomine kasutavad seda teenusepakkujat. Tippimissoovitusi ja ennustusi töödeldakse seadmes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrumentele AI, traducerea și creatorul AI folosesc acest furnizor. Sugestiile de tastare și predicțiile rămân pe dispozitiv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Tools, vertaling en de AI-maker maken gebruik van deze provider. Typesuggesties en voorspellingen blijven op het apparaat staan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 工具、翻譯和 AI 建立功能使用此提供商。輸入建議和預測仍在裝置上處理。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "KA-instrumente, vertaling en die KI-skepper gebruik hierdie verskaffer. Tikvoorstelle en voorspellings bly op die toestel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narzędzia AI, tłumaczenia i twórca AI korzystają z tego dostawcy. Sugestie i podpowiedzi dotyczące pisania pozostają na urządzeniu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інструменти AI, переклад і творець AI використовують цього постачальника. Пропозиції щодо введення та передбачення залишаються на пристрої."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Tools, çeviri ve AI yaratıcısı bu sağlayıcıyı kullanır. Yazma önerileri ve tahminler cihazda kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nástroje AI, překlad a tvůrce AI používají tohoto poskytovatele. Návrhy psaní a předpovědi zůstávají v zařízení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nástroje AI, preklad a tvorca AI používajú tohto poskytovateľa. Návrhy na písanie a predpovede zostanú v zariadení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα Εργαλεία AI, η μετάφραση και ο δημιουργός τεχνητής νοημοσύνης χρησιμοποιούν αυτόν τον πάροχο. Οι προτάσεις και οι προβλέψεις πληκτρολόγησης παραμένουν στη συσκευή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-verktyg, översättning och AI-skaparen använder denna leverantör. Skrivförslag och förutsägelser finns kvar på enheten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-værktøjer, oversættelse og AI-skaberen bruger denne udbyder. Indtastningsforslag og forudsigelser forbliver på enheden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-verktøy, oversettelse og AI-skaperen bruker denne leverandøren. Skriveforslag og spådommer forblir på enheten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Tools, käännös ja tekoälyn luoja käyttävät tätä palveluntarjoajaa. Kirjoitusehdotukset ja ennusteet pysyvät laitteella."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat AI, terjemahan, dan pembuat AI menggunakan penyedia ini. Saran pengetikan dan prediksi tetap ada di perangkat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ AI, bản dịch và người tạo AI sử dụng nhà cung cấp này. Đề xuất gõ và dự đoán vẫn còn trên thiết bị."
          }
        }
      }
