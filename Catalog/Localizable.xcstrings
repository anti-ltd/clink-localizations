    "Try Clink right here, no setup needed. Pick a field type and start typing.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Probeer Clink hier, geen opstelling nodig nie. Kies 'n veldtipe en begin tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probier Clink direkt hier aus, ganz ohne Einrichtung. Wähl einen Feldtyp und leg los."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba Clink aquí mismo, sin configurar nada. Elige un tipo de campo y empieza a escribir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Proovi Clinki kohe siin, seadistamiseta. Vali välja tüüp ja hakka tipitama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie Clink ici même, aucune configuration nécessaire. Choisis un type de champ et commence à taper."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbáld ki a Clinket itt, semmit sem kell beállítanod. Válassz mezőtípust, és kezdj el gépelni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova Clink proprio qui, senza dover configurare niente. Scegli un tipo di campo e inizia a scrivere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでClinkをすぐ試せます。設定はいりません。フィールドの種類を選んで入力してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 바로 Clink를 써보세요. 따로 설정할 것 없어요. 필드 종류를 고르고 입력을 시작하면 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuba Clink terus di sini, tak perlu apa-apa persediaan. Pilih jenis medan dan mula menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimenta o Clink mesmo aqui, sem preparação nenhuma. Escolhe um tipo de campo e começa a escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте Clink прямо здесь — настраивать ничего не нужно. Выберите тип поля и начинайте печатать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就在这儿试试 Clink，不用设置。选个字段类型，开始打字吧。"
          }
        }
      }
    },
