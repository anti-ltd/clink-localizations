    "Hitbox 115%. Bigger targets, catches more taps. Best for screen protectors.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitbox 115%. Groter teikens, vang meer krane. Beste vir skermbeskermers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trefferfläche 115 %. Größere Ziele, fängt mehr Tipps. Am besten bei Schutzfolien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Área táctil 115%. Objetivos más grandes, captan más toques. Ideal para protectores de pantalla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabamustsoon 115%. Suuremad sihid, tabab rohkem vajutusi. Parim ekraanikaitsetele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone tactile 115 %. Cibles plus grandes, attrape plus d'appuis. Idéal avec une protection d'écran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitbox 115%. Nagyobb célpontok, több koppintást fog el. Képernyővédő fóliához a legjobb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Area di tocco 115%. Bersagli più grandi, cattura più tocchi. Ideale per le pellicole protettive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒットボックス 115%。ターゲットが大きくなり、より多くのタップを拾います。保護フィルムに最適。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치 영역 115%. 대상이 커서 탭을 더 잘 잡아요. 화면 보호 필름에 좋아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotak sentuh 115%. Sasaran lebih besar, tangkap lebih banyak ketikan. Terbaik untuk pelindung skrin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Área tátil 115%. Zonas maiores, apanha mais toques. Ideal para películas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зона нажатия 115%. Крупнее, ловит больше нажатий. Лучший вариант с защитной плёнкой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控区 115%。判定区更大，能接住更多点按。最适合贴了屏幕膜时用。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitbox 115%. Ținte mai mari, prinde mai multe atingeri. Cel mai bun pentru protectoare de ecran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitbox 115%. Grotere doelen, vangt meer tikken op. Beste voor schermbeschermers."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觸控區 115%。判定區更大，能接住更多點按。最適合貼了螢幕膜時用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trafienie 115%. Większe cele, łapie więcej dotknięć. Najlepsze do ochraniaczy ekranu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хітбокс 115%. Більші цілі, ловить більше кранів. Найкраще підходить для захисту екрану."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsabet kutusu %115. Daha büyük hedefler, daha fazla dokunuş yakalar. Ekran koruyucuları için en iyisi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitbox 115 %. Větší cíle, chytí více kohoutků. Nejlepší na ochranu displeje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitbox 115%. Väčšie ciele, chytí viac kohútikov. Najlepšie na ochranu obrazovky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitbox 115%. Μεγαλύτεροι στόχοι, πιάνει περισσότερα πατήματα. Το καλύτερο για προστατευτικά οθόνης."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitbox 115%. Större mål, fångar fler kranar. Bäst för skärmskydd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitbox 115%. Større mål, fanger flere haner. Bedst til skærmbeskyttere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitbox 115%. Større mål, fanger flere kraner. Best for skjermbeskyttere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitbox 115%. Isommat kohteet, enemmän napautuksia. Paras näytönsuojaksi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotak Pukulan 115%. Target yang lebih besar, menangkap lebih banyak ketukan. Terbaik untuk pelindung layar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hộp truy cập 115%. Mục tiêu lớn hơn, bắt được nhiều cú chạm hơn. Tốt nhất cho bảo vệ màn hình."
          }
        }
      }
    },
