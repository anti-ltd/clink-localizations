    "Turn on Auto-correction (Suggestions) to use this.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel outo-korreksie (voorstelle) aan om dit te gebruik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte die Autokorrektur (Vorschläge) ein, um das zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la autocorrección (Sugerencias) para usar esto."
          }
        },
