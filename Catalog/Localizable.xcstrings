    "Numbers on the top row’s long-press: swipe down or hold for each key’s digit (q → 1, w → 2 … p → 0)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlen beim Halten der oberen Reihe: nach unten wischen oder halten für die Ziffer jeder Taste (q → 1, w → 2 … p → 0)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Números al mantener pulsada la fila superior: desliza hacia abajo o mantén para el dígito de cada tecla (q → 1, w → 2 … p → 0)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffres en appui long sur la rangée du haut : balaie vers le bas ou maintiens pour le chiffre de chaque touche (q → 1, w → 2 … p → 0)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Számok a felső sor hosszú nyomásán: húzd le vagy tartsd nyomva az egyes billentyűk számjegyéért (q → 1, w → 2 … p → 0)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Numeri con la pressione prolungata sulla riga superiore: scorri verso il basso o tieni premuto per la cifra di ogni tasto (q → 1, w → 2 … p → 0)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上段の長押しで数字: 下にスワイプするか長押しすると各キーの数字が入ります（q → 1、w → 2 … p → 0）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윗줄을 길게 누르면 숫자: 아래로 밀거나 길게 눌러 각 키의 숫자를 입력해요 (q → 1, w → 2 … p → 0)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombor pada tekan lama baris atas: leret ke bawah atau tahan untuk digit setiap kekunci (q → 1, w → 2 … p → 0)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Números ao manter premida a linha de cima: desliza para baixo ou mantém para o dígito de cada tecla (q → 1, w → 2 … p → 0)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цифры по долгому нажатию в верхнем ряду: смахните вниз или удержите клавишу, чтобы получить её цифру (q → 1, w → 2 … p → 0)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按顶行出数字：向下滑或长按即可输入各键对应的数字（q → 1、w → 2 … p → 0）"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Numbrid ülemise rea pikkvajutusel: viipa alla või hoia, et saada iga klahvi number (q → 1, w → 2 … p → 0)"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nommers op die boonste ry se langdruk: swiep af of hou vir elke sleutel se syfer (q → 1, w → 2 … p → 0)"
          }
        }
      }
    },
