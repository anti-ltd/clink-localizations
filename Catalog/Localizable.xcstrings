          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Langt tryk på ekstramateriale har brug for en tast, der skriver et enkelt tegn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Langt trykk ekstra trenger en tast som skriver inn et enkelt tegn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitkä painallus tarvitsee näppäimen, joka kirjoittaa yhden merkin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstra yang ditekan lama memerlukan kunci yang mengetikkan satu karakter."
