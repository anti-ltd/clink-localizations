    "Tashkeel replaces this key’s current hold actions with its Arabic marks.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tashkeel vervang hierdie sleutel se huidige hou-aksies met sy Arabiese merke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel ersetzt die aktuellen Halteaktionen dieser Taste durch arabische Zeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel sustituye las acciones actuales al mantener pulsada esta tecla por sus signos árabes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel asendab selle klahvi praegused pikalt vajutamise toimingud araabia märkidega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel remplace les actions d’appui prolongé actuelles de cette touche par ses signes arabes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tashkeel a billentyű jelenlegi hosszan nyomás műveleteit arab jelekre cseréli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel sostituisce le attuali azioni di pressione prolungata di questo tasto con i segni arabi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeelはこのキーの現在の長押しアクションをアラビア語の記号に置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel은 이 키의 현재 길게 누르기 동작을 아랍어 기호로 바꿉니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel menggantikan tindakan tekan lama kekunci ini dengan tanda Arabnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tashkeel substitui as ações atuais de toque longo desta tecla pelos seus sinais árabes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel заменит текущие действия удержания этой клавиши арабскими знаками."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel 会用阿拉伯语符号替换此按键当前的长按操作。"
          }
        }
      }
    },
    "Tashkeel uses the hold bar for its Arabic marks.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel usa la barra de pulsación larga para los signos árabes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel utilise la barre d’appui long pour les signes arabes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel nutzt die Leiste beim Gedrückthalten für arabische Zeichen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel usa la barra della pressione prolungata per i segni arabi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tashkeel usa a barra de pressão prolongada para os sinais árabes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel использует панель долгого нажатия для арабских огласовок."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
