    "Commands run once per event. Configuration overrides last until the keyboard closes or you clear them.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comandos se ejecutan una vez por evento. Los cambios temporales duran hasta que cierres el teclado o los borres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes s’exécutent une fois par événement. Les réglages temporaires restent jusqu’à la fermeture du clavier ou leur effacement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehle laufen einmal pro Ereignis. Temporäre Einstellungen gelten bis zum Schließen der Tastatur oder bis du sie zurücksetzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I comandi vengono eseguiti una volta per evento. Le modifiche temporanee restano finché chiudi la tastiera o le rimuovi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os comandos são executados uma vez por evento. As alterações temporárias duram até fechares o teclado ou as limpares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команды выполняются один раз на событие. Временные настройки действуют до закрытия клавиатуры или их сброса."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahan berjalan sekali bagi setiap peristiwa. Tetapan sementara kekal sehingga papan kekunci ditutup atau anda mengosongkannya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A parancsok eseményenként egyszer futnak. Az ideiglenes beállítások a billentyűzet bezárásáig vagy törlésükig maradnak érvényben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドはイベントごとに1回実行されます。一時設定は、キーボードを閉じるか解除するまで有効です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个事件执行一次命令。临时配置持续到键盘关闭或手动清除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령은 이벤트마다 한 번 실행됩니다. 임시 설정은 키보드를 닫거나 직접 해제할 때까지 유지됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Käsud käivitatakse üks kord sündmuse kohta. Ajutised seaded kehtivad klaviatuuri sulgemise või nende tühjendamiseni."
          }
        }
      }
    },
