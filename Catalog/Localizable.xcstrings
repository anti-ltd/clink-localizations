    "Custom sounds and haptics need Full Access. The standard click works without it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gepasmaakte klanke en haptics benodig volle toegang. Die standaard klik werk daarsonder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Sounds und Haptik brauchen Vollzugriff. Der normale Klick geht auch ohne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sonidos y vibraciones propios necesitan acceso completo. El clic normal funciona sin él."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohandatud helid ja haptiline tagasiside vajavad täisjuurdepääsu. Tavaline klõps töötab ilma selleta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sons et retours haptiques perso ont besoin de l'accès complet. Le clic standard marche sans."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyéni hangokhoz és rezgéshez Teljes hozzáférés kell. A megszokott kattanás enélkül is megy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoni e i feedback personalizzati hanno bisogno dell'accesso completo. Il clic standard funziona anche senza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムのサウンドとハプティクスにはフルアクセスが必要です。標準のクリック音はなくても使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만의 사운드와 햅틱은 전체 접근이 필요해요. 기본 클릭음은 없어도 잘 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunyi dan haptik sendiri perlukan Akses Penuh. Klik biasa berfungsi tanpanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sons e vibrações à tua medida precisam de acesso total. O clique normal funciona sem ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Своим звукам и тактильной отдаче нужен полный доступ. Стандартный щелчок работает и без него."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义声音和触感需要完全访问权限。系统自带的点击声不用它也能响。"
          }
        }
      }
    },
