        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elérhetőséghez ne írj linket. Egy e-mail-cím vagy egy felhasználónév elég."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先にリンクは入れないでください。メールアドレスかユーザ名で十分です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
