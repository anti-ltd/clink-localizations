    "Removes every word Clink picked up from your typing. Custom words stay.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt alle Wörter, die Clink aus deinem Tippen übernommen hat. Eigene Wörter bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todas las palabras que Clink aprendió de tu escritura. Se conservan las palabras personalizadas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemaldab kõik sõnad, mille Clink sinu tippimisest õppis. Kohandatud sõnad jäävad alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime tous les mots que Clink a appris en tapant. Les mots personnalisés restent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolít minden szót, amit Clink a gépelésedből tanult. A saját szavak megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove tutte le parole che Clink ha imparato dalla tua digitazione. Le parole personalizzate restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink が入力から学習した単語をすべて削除します。カスタム単語は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink가 입력에서 학습한 모든 단어를 제거합니다. 사용자 단어는 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengalih keluar semua perkataan yang dipelajari Clink daripada taipan anda. Perkataan tersuai kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove todas as palavras que o Clink aprendeu com a sua digitação. As palavras personalizadas permanecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет все слова, которые Clink выучил из вашего ввода. Пользовательские слова сохраняются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 Clink 从你的输入中学到的所有词语。自定义词语会保留。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwyder elke woord wat geklink word van jou tikwerk. Gepasmaakte woorde bly."
          }
        }
      }
    },
