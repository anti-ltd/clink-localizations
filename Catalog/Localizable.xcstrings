    "Enter a complete HTTPS endpoint without credentials or query parameters.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una URL HTTPS completa sin credenciales ni parámetros de consulta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis une URL HTTPS complète, sans identifiants ni paramètres de requête."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine vollständige HTTPS-Endpunkt-URL ohne Zugangsdaten oder Abfrageparameter ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un endpoint HTTPS completo senza credenziali o parametri di query."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza um endereço HTTPS completo, sem credenciais nem parâmetros de consulta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите полный HTTPS-адрес конечной точки без учётных данных и параметров запроса."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan alamat HTTPS lengkap tanpa bukti kelayakan atau parameter pertanyaan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg egy teljes HTTPS-végpontot hitelesítési adatok és lekérdezési paraméterek nélkül."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報やクエリパラメータを含まない、完全なHTTPSエンドポイントを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入完整的 HTTPS 端点地址，不含凭据或查询参数。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자격 증명이나 쿼리 매개변수 없이 완전한 HTTPS 엔드포인트를 입력하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisesta täielik HTTPS-lõpp-punkt ilma sisselogimisandmete ja päringuparameetriteta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți un punct final HTTPS complet, fără acreditări sau parametri de interogare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een volledig HTTPS-eindpunt in zonder inloggegevens of queryparameters."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入完整的 HTTPS 端點地址，不含憑據或查詢引數。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer 'n volledige HTTPS-eindpunt in sonder geloofsbriewe of navraagparameters."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź kompletny punkt końcowy HTTPS bez poświadczeń i parametrów zapytania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть повну кінцеву точку HTTPS без облікових даних або параметрів запиту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik bilgileri veya sorgu parametreleri olmadan tam bir HTTPS uç noktası girin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte úplný koncový bod HTTPS bez přihlašovacích údajů nebo parametrů dotazu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte úplný koncový bod HTTPS bez poverení alebo parametrov dotazu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε ένα πλήρες τελικό σημείο HTTPS χωρίς διαπιστευτήρια ή παραμέτρους ερωτήματος."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange en komplett HTTPS-slutpunkt utan autentiseringsuppgifter eller frågeparametrar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast et komplet HTTPS-slutpunkt uden legitimationsoplysninger eller forespørgselsparametre."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi et komplett HTTPS-endepunkt uten legitimasjon eller spørringsparametere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna täydellinen HTTPS-päätepiste ilman tunnistetietoja tai kyselyparametreja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan titik akhir HTTPS lengkap tanpa kredensial atau parameter kueri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập điểm cuối HTTPS hoàn chỉnh mà không có thông tin xác thực hoặc tham số truy vấn."
          }
        }
      }
    },
    "Enter owner/repository, github.com/owner/repository, or the full HTTPS URL. Clink verifies every release manifest and file before anything can be downloaded.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib owner/repository, github.com/owner/repository oder die vollständige HTTPS-URL ein. Clink prüft jedes Release-Manifest und jede Datei, bevor etwas geladen wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce owner/repository, github.com/owner/repository o la URL HTTPS completa. Clink verifica cada manifiesto y archivo de versión antes de permitir cualquier descarga."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisesta owner/repository, github.com/owner/repository või täielik HTTPS-i URL. Clink kontrollib iga väljalaske manifesti ja faili, enne kui midagi saab alla laadida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis owner/repository, github.com/owner/repository ou l’URL HTTPS complète. Clink vérifie chaque manifeste et chaque fichier de version avant tout téléchargement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg owner/repository, github.com/owner/repository formában vagy a teljes HTTPS-URL-t. A Clink minden kiadási jegyzéket és fájlt ellenőriz, mielőtt bármit letöltene."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci owner/repository, github.com/owner/repository o l’URL HTTPS completo. Clink verifica ogni manifest di release e ogni file prima di consentire qualsiasi download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "owner/repository、github.com/owner/repository、または完全な HTTPS URL を入力してください。Clink は、何かをダウンロードする前にすべてのリリースマニフェストとファイルを検証します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "owner/repository, github.com/owner/repository 또는 전체 HTTPS URL을 입력하세요. Clink는 무엇이든 다운로드하기 전에 모든 릴리스 매니페스트와 파일을 검증합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan owner/repository, github.com/owner/repository atau URL HTTPS penuh. Clink mengesahkan setiap manifes keluaran dan fail sebelum apa-apa boleh dimuat turun."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduz owner/repository, github.com/owner/repository ou o URL HTTPS completo. O Clink verifica todos os manifestos de versão e ficheiros antes de qualquer transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите owner/repository, github.com/owner/repository или полный HTTPS-URL. Clink проверяет каждый манифест релиза и каждый файл, прежде что-либо можно будет загрузить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 owner/repository、github.com/owner/repository 或完整的 HTTPS URL。在下载任何内容之前，Clink 都会验证每个发布清单和文件。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți proprietar/repository, github.com/owner/repository sau adresa URL HTTPS completă. Clink verifică fiecare manifest și fișier de lansare înainte de a putea descărca orice."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer eigenaar/repository, github.com/owner/repository of de volledige HTTPS-URL in. Clink verifieert elk releasemanifest en bestand voordat er iets kan worden gedownload."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入 owner/repository、github.com/owner/repository 或完整的 HTTPS URL。在下載任何內容之前，Clink 都會驗證每個釋出清單和檔案。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer eienaar/repository, github.com/eienaar/repository, of die volledige HTTPS-URL in. Clink verifieer elke vrystellingsmanifest en lêer voordat enigiets afgelaai kan word."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz właściciel/repozytorium, github.com/owner/repository lub pełny adres URL HTTPS. Clink weryfikuje każdy manifest wydania i plik, zanim będzie można cokolwiek pobrać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть owner/repository, github.com/owner/repository або повну URL-адресу HTTPS. Clink перевіряє кожен маніфест випуску та файл, перш ніж щось можна буде завантажити."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahip/depo, github.com/owner/repository veya tam HTTPS URL'sini girin. Clink, herhangi bir şey indirilmeden önce her sürüm bildirimini ve dosyayı doğrular."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte vlastníka/úložiště, github.com/owner/úložiště nebo úplnou adresu URL HTTPS. Clink ověřuje každý manifest a soubor vydání, než bude možné cokoliv stáhnout."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte vlastníka/úložisko, github.com/owner/úložisko alebo úplnú adresu URL HTTPS. Clink overuje každý manifest a súbor vydania predtým, ako je možné čokoľvek stiahnuť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε ιδιοκτήτη/αποθετήριο, github.com/owner/repository ή την πλήρη διεύθυνση URL HTTPS. Το Clink επαληθεύει κάθε δήλωση και αρχείο έκδοσης προτού γίνει λήψη οτιδήποτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange ägare/repository, github.com/owner/repository eller hela HTTPS-URL. Clink verifierar varje releasemanifest och fil innan något kan laddas ner."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast ejer/lager, github.com/owner/repository eller den fulde HTTPS-URL. Clink verificerer hvert udgivelsesmanifest og -fil, før noget kan downloades."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn eier/repository, github.com/owner/repository, eller hele HTTPS-URLen. Clink verifiserer hvert utgivelsesmanifest og -fil før noe kan lastes ned."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita omistaja/varasto, github.com/owner/repository tai koko HTTPS-URL-osoite. Clink tarkistaa jokaisen julkaisuluettelon ja tiedoston ennen kuin mitään voidaan ladata."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan pemilik/repositori, github.com/owner/repository, atau URL HTTPS lengkap. Clink memverifikasi setiap manifes rilis dan file sebelum apa pun dapat diunduh."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập chủ sở hữu/kho lưu trữ, github.com/owner/repository hoặc URL HTTPS đầy đủ. Clink xác minh mọi tệp kê khai và tệp phát hành trước khi có thể tải xuống bất kỳ thứ gì."
          }
        }
      }
    },
