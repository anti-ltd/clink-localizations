          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda a área de transferência atual quando abres o painel de histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забирать текущее содержимое буфера обмена при открытии панели истории."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开历史面板时，抓取当前剪贴板的内容。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvesta käesolev lõikelaud ajaloo paneeli avamisel."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vang die huidige knipbord vas wanneer die geskiedenispaneel oopgemaak word."
          }
        }
      }
    },
