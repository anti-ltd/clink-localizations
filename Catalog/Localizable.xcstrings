            "value": "Tal for at skrive"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snakk for å skrive"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhu kirjoittaaksesi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bicaralah untuk mengetik"
