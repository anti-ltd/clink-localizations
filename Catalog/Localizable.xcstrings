    "Sort clips into groups, then swipe a clip right in the keyboard panel to assign it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorteer snitte in groepe en vee dan 'n snit regs in die sleutelbordpaneel om dit toe te wys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiere Clips in Gruppen und wisch einen Clip im Tastaturpanel nach rechts, um ihn zuzuordnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena los clips en grupos y desliza un clip a la derecha en el panel del teclado para asignarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorteeri klipid gruppidesse ja viipa seejärel klipid klaviatuuri paneelil paremale, et need määrata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trie tes clips en groupes, puis balaie un clip vers la droite dans le panneau du clavier pour l'assigner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendezd a vágólap-elemeket csoportokba, majd húzz egy elemet jobbra a billentyűzet panelén a hozzárendeléshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordina le clip in gruppi, poi scorri una clip verso destra nel pannello della tastiera per assegnarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップをグループに整理して、キーボードパネルでクリップを右にスワイプすると割り当てられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립을 그룹으로 정리한 다음, 키보드 패널에서 클립을 오른쪽으로 밀어 그룹에 넣으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun klip ke dalam kumpulan, kemudian leret klip ke kanan dalam panel papan kekunci untuk masukkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize os clips em grupos e deslize um clip para a direita no painel do teclado para atribuí-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разложите фрагменты по группам, а затем смахните фрагмент вправо в панели на клавиатуре, чтобы отнести его к группе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把剪贴内容整理到分组中，然后在键盘面板里向右滑动某条即可归类。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortați clipurile în grupuri, apoi glisați un clip direct în panoul de la tastatură pentru a-l atribui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorteer clips in groepen en veeg vervolgens een clip naar rechts in het toetsenbordpaneel om deze toe te wijzen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把剪貼內容整理到分組中，然後在鍵盤面板裡向右滑動某條即可歸類。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortuj klipy w grupy, a następnie przesuń klip w prawo na panelu klawiatury, aby go przypisać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сортуйте кліпи в групи, а потім проведіть пальцем по кліпу праворуч на панелі клавіатури, щоб призначити його."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipleri gruplar halinde sıralayın, ardından atamak için klavye panelinde bir klibi sağa kaydırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seřaďte klipy do skupin a poté klip přiřaďte přejetím prstem doprava na panelu klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoraďte klipy do skupín a potom potiahnite klip doprava na paneli klávesnice a priraďte ho."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ταξινομήστε τα κλιπ σε ομάδες και, στη συνέχεια, σύρετε ένα κλιπ προς τα δεξιά στον πίνακα του πληκτρολογίου για να το αντιστοιχίσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortera klipp i grupper och svep sedan ett klipp åt höger på tangentbordspanelen för att tilldela det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorter klip i grupper, og stryg derefter et klip til højre i tastaturpanelet for at tildele det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorter klipp i grupper, og sveip deretter et klipp til høyre i tastaturpanelet for å tilordne det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lajittele leikkeet ryhmiin ja määritä se pyyhkäisemällä oikealle näppäimistöpaneelissa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Urutkan klip ke dalam grup, lalu geser klip ke kanan di panel keyboard untuk menetapkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắp xếp các clip thành nhóm, sau đó vuốt clip sang phải trong bảng bàn phím để gán clip đó."
          }
        }
      }
    },
    "Sort clips into groups, then swipe a clip right on History or in the keyboard panel to assign it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorteer snitte in groepe, vee dan 'n snit regs op Geskiedenis of in die sleutelbordpaneel om dit toe te wys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiere Clips in Gruppen und wisch dann in Verlauf oder Tastaturpanel nach rechts, um einen zuzuweisen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena los recortes en grupos y luego desliza uno a la derecha en Historial o en el panel del teclado para asignarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorteeri klipid gruppidesse ja viipa seejärel Ajaloos või klaviatuuri paneelil paremale, et see määrata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Classe les extraits en groupes, puis balaye un extrait vers la droite dans l’Historique ou le panneau du clavier pour l’assigner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csoportosítsd a klipeket, majd húzz egyet jobbra az Előzményeken vagy a billentyűzet paneljén a besoroláshoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordina i clip in gruppi, poi scorri a destra su Cronologia o nel pannello della tastiera per assegnarne uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップをグループに分け、履歴またはキーボードのパネルで右にスワイプして割り当てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립을 그룹으로 나눈 뒤, 기록이나 키보드 패널에서 오른쪽으로 쓸어 넣습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Isih klip ke dalam kumpulan, kemudian leret kanan pada Sejarah atau panel papan kekunci untuk menugaskannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza os clips em grupos e depois desliza um para a direita no Histórico ou no painel do teclado para o atribuir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разложите фрагменты по группам, затем проведите по фрагменту вправо в «Истории» или на панели клавиатуры, чтобы назначить его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先把片段分进组里，然后在历史或键盘面板上向右滑一条来归组。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortați clipurile în grupuri, apoi glisați un clip direct pe Istoric sau în panoul de la tastatură pentru a-l atribui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorteer clips in groepen en veeg vervolgens een clip naar rechts in de Geschiedenis of op het toetsenbordpaneel om deze toe te wijzen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先把片段分進組裡，然後在歷史或鍵盤面板上向右滑一條來歸組。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortuj klipy w grupy, a następnie przesuń klip w prawo w Historii lub na panelu klawiatury, aby go przypisać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сортуйте кліпи за групами, а потім проведіть пальцем по кліпу вправо в історії або на панелі клавіатури, щоб призначити його."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipleri gruplar halinde sıralayın, ardından bir klibi atamak için Geçmiş'te veya klavye panelinde sağa kaydırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seřaďte klipy do skupin a poté klip přiřaďte přejetím prstem doprava na Historii nebo na panelu klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoraďte klipy do skupín a potom potiahnite klip doprava na Históriu alebo na paneli klávesnice a priraďte ho."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ταξινομήστε τα κλιπ σε ομάδες και, στη συνέχεια, σύρετε ένα κλιπ προς τα δεξιά στο Ιστορικό ή στον πίνακα του πληκτρολογίου για να το εκχωρήσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortera klipp i grupper och svep sedan ett klipp åt höger på Historik eller på tangentbordspanelen för att tilldela det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorter klip i grupper, og stryg derefter et klip til højre på Historik eller i tastaturpanelet for at tildele det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorter klipp i grupper, og sveip deretter et klipp til høyre på Historie eller i tastaturpanelet for å tilordne det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lajittele leikkeet ryhmiin ja määritä se pyyhkäisemällä oikealle Historia-kohdassa tai näppäimistöpaneelissa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Urutkan klip ke dalam grup, lalu geser klip ke kanan di Riwayat atau di panel keyboard untuk menetapkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắp xếp các clip thành nhóm, sau đó vuốt clip sang phải trên Lịch sử hoặc trong bảng bàn phím để gán."
          }
        }
      }
    },
    "Sort saved notes into groups, then swipe a note right in the keyboard panel to assign it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorteer gestoorde notas in groepe, vee dan 'n nota regs in die sleutelbordpaneel om dit toe te wys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiere gespeicherte Notizen in Gruppen. Wische dann im Tastaturbereich eine Notiz nach rechts, um sie zuzuweisen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza las notas guardadas en grupos y desliza una nota a la derecha en el panel del teclado para asignarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorteeri salvestatud märkmed gruppidesse ja viipa seejärel märge klaviatuuri paneelil paremale, et see määrata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Classe les notes enregistrées en groupes, puis balaie une note vers la droite dans le panneau du clavier pour l’y placer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendezd csoportokba a mentett jegyzeteket, majd a hozzárendeléshez húzd jobbra a jegyzetet a billentyűzet paneljén."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizza le note salvate in gruppi, poi scorri una nota verso destra nel pannello della tastiera per assegnarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みメモをグループに整理し、キーボードパネルでメモを右にスワイプして割り当てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 메모를 그룹으로 정리한 다음 키보드 패널에서 메모를 오른쪽으로 쓸어 그룹에 넣으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun nota tersimpan kepada kumpulan, kemudian leret nota ke kanan dalam panel papan kekunci untuk menetapkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize as notas guardadas em grupos e, no painel do teclado, deslize uma nota para a direita para a atribuir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разложите сохранённые заметки по группам, а затем смахните заметку вправо в панели на клавиатуре, чтобы отнести её к группе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将已存笔记整理到不同组中，然后在键盘面板中向右轻扫笔记即可分组。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortați notele salvate în grupuri, apoi glisați o notă direct în panoul de la tastatură pentru a o atribui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorteer opgeslagen notities in groepen en veeg vervolgens een notitie naar rechts in het toetsenbordpaneel om deze toe te wijzen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將已存筆記整理到不同組中，然後在鍵盤面板中向右輕掃筆記即可分組。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortuj zapisane notatki w grupy, a następnie przesuń notatkę w prawo na panelu klawiatury, aby ją przypisać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сортуйте збережені нотатки в групи, а потім проведіть пальцем праворуч на панелі клавіатури, щоб призначити її."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen notları gruplar halinde sıralayın, ardından bir notu atamak için klavye panelinde sağa kaydırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené poznámky seřaďte do skupin a poté poznámku přiřaďte přejetím prstem doprava na panelu klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoraďte uložené poznámky do skupín a potom potiahnite poznámku doprava na paneli klávesnice a priraďte ju."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ταξινομήστε τις αποθηκευμένες σημειώσεις σε ομάδες και, στη συνέχεια, σύρετε μια σημείωση προς τα δεξιά στο πλαίσιο του πληκτρολογίου για να την αντιστοιχίσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortera sparade anteckningar i grupper och svep sedan en anteckning åt höger på tangentbordspanelen för att tilldela den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorter gemte noter i grupper, og stryg derefter en note til højre i tastaturpanelet for at tildele den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorter lagrede notater i grupper, og sveip deretter et notat til høyre i tastaturpanelet for å tilordne det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lajittele tallennetut muistiinpanot ryhmiin ja määritä muistiinpano pyyhkäisemällä oikealle näppäimistöpaneelissa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Urutkan catatan yang disimpan ke dalam grup, lalu geser catatan ke kanan di panel keyboard untuk menetapkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắp xếp các ghi chú đã lưu thành các nhóm, sau đó vuốt ghi chú ngay trong bảng bàn phím để gán."
          }
        }
      }
    },
