          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Betapa banyak bar ruang bergoyang sebelum berhenti. Tiada berhenti dengan kemas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto a barra de espaço oscila antes de assentar. Nenhum assenta de forma limpa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько пробел колеблется, прежде чем успокоиться. «Нет» — без колебаний."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空格键停稳前晃动的程度。“无”表示干脆停下。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de mult se clătinește bara de spațiu înainte de a se instala. Niciunul nu se așează curat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel de spatiebalk wiebelt voordat hij vast komt te zitten. Geen enkele vestigt zich netjes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空格鍵停穩前晃動的程度。“無”表示乾脆停下。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel die spasiebalk wieg voordat dit tot stilstand kom. Dit kom nie netjies tot stilstand nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak bardzo spacja się chwieje, zanim się uspokoi. Żaden nie osadza się czysto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки коливається пробіл, перш ніж засісти. Жоден не осідає чисто."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerleşmeden önce boşluk çubuğu ne kadar sallanıyor. Hiçbiri temiz bir şekilde yerleşmez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak moc se mezerník zakolísá, než se usadí. Žádný se neusazuje čistě."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako veľmi sa medzerník kýve, kým sa usadí. Žiadna sa neusadí čisto."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο ταλαντεύεται η μπάρα διαστήματος πριν εγκατασταθεί. Κανένα δεν καθιζάνει καθαρά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur mycket mellanslagstangenten vacklar innan den lägger sig. Ingen lägger sig rent."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor meget mellemrumstasten vakler, før den sætter sig. Ingen sætter sig rent."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mye mellomromstasten vingler før den legger seg. Ingen legger seg rent."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka paljon välilyöntinäppäin huojuu ennen kuin se asettuu. Mikään ei laskeudu puhtaaksi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak bilah spasi yang bergetar sebelum menjadi tenang. Tidak ada yang menetap dengan bersih."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh dấu cách dao động bao nhiêu trước khi nó ổn định. Không có giải quyết sạch sẽ."
          }
        }
      }
    },
    "How much the space-bar spring bounces. Lower bounces more, 1.0 settles cleanly.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel die spasiebalkveer bons. Laer bons meer, 1.0 sit skoon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark die Feder der Leertaste nachfedert. Niedriger federt mehr, 1.0 kommt sauber zur Ruhe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto rebota el resorte de la barra espaciadora. Más bajo rebota más, 1.0 se asienta sin más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui palju tühikuklahvi vedru põrkab. Madalam põrkab rohkem, 1.0 raugab puhtalt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De combien le ressort de la barre d'espace rebondit. Plus bas rebondit plus, 1.0 se stabilise net."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyit pattog a szóköz rugója. Az alacsonyabb többet pattog, az 1.0 szépen elül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto rimbalza la molla della barra spaziatrice. Più basso rimbalza di più, 1.0 si assesta netto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースバーのバネの跳ね具合です。低いほど強く跳ね、1.0できれいに収まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스바 스프링이 얼마나 튀는지예요. 낮으면 더 튀고, 1.0이면 깔끔하게 멈춰요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak spring bar ruang melantun. Lagi rendah lagi banyak lantun, 1.0 mengendap kemas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto a mola da barra de espaços ressalta. Mais baixo ressalta mais, 1.0 assenta de forma limpa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько пружинит пробел. Меньше — сильнее отскок, 1,0 — чистая остановка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空格键弹簧弹跳多少。越低弹得越厉害，1.0 干干净净停稳。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de mult sare arcul barei de spațiu. Sări mai mici mai mult, 1.0 se stabilește curat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel de spatiebalkveer stuitert. Lager stuitert meer, 1.0 bezinkt netjes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空格鍵彈簧彈跳多少。越低彈得越厲害，1.0 乾乾淨淨停穩。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak bardzo sprężyna spacji odbija się. Niższe odbija się bardziej, 1,0 osadza się czysto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На скільки відскакує пружина пробілу. Нижче відскакує більше, 1,0 осідає чисто."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluk çubuğu yayı ne kadar zıplıyor. Daha düşük daha fazla sıçrar, 1.0 temiz bir şekilde yerleşir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak moc pružina mezerníku skáče. Nižší odskočí více, 1,0 se usadí čistě."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako veľmi skáče pružina medzerníka. Nižšia odskakuje viac, 1,0 sadne čisto."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο αναπηδά το ελατήριο του space-bar. Χαμηλότερα αναπηδά περισσότερο, το 1,0 εγκαθίσταται καθαρά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur mycket mellanslagstangenten studsar. Lägre studsar mer, 1,0 lägger sig rent."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor meget springer mellemrumstastens fjeder. Lavere hopper mere, 1,0 sætter sig rent."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mye spretter mellomromstasten. Lavere sprett mer, 1,0 legger seg rent."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka paljon välilyöntinäppäimen jousi pomppii. Alempi pomppii enemmän, 1.0 asettuu siististi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak pegas spasi yang memantul. Yang lebih rendah memantul lebih banyak, 1,0 diselesaikan dengan rapi."
