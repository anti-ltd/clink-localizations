            "value": "记事本面板"
          }
        }
      }
    },
    "In Settings, go back to the main list, then open General → Keyboard → Text Replacement.": {
      "comment": "Text replacement settings page. iOS entries are a read-only snapshot shared by the keyboard extension; Settings opens the app settings page.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings, go back to the main list, then open General → Keyboard → Text Replacement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes, vuelve a la lista principal y abre General → Teclado → Sustitución de texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages, reviens à la liste principale, puis ouvre Général → Clavier → Remplacement de texte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe in den Einstellungen zurück zur Hauptübersicht und öffne Allgemein → Tastatur → Textersetzung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Impostazioni, torna all’elenco principale, poi apri Generali → Tastiera → Sostituzione testo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nas Definições, volta à lista principal e abre Geral → Teclado → Substituição de texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Настройках» вернитесь к основному списку и откройте «Основные» → «Клавиатура» → «Замена текста»."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam Seting, kembali ke senarai utama, kemudian buka Umum → Papan Kekunci → Penggantian Teks."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Beállításokban lépj vissza a főlistához, majd nyisd meg az Általános → Billentyűzet → Szövegcsere menüpontot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」の最初の画面に戻り、「一般」→「キーボード」→「ユーザ辞書」を開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中返回主列表，然后打开“通用”→“键盘”→“文本替换”。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정의 처음 화면으로 돌아간 다음 일반 → 키보드 → 텍스트 대치를 여세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mine seadetes tagasi põhiloendisse ning ava Üldine → Klaviatuur → Tekstiasendus."
          }
        }
      }
    },
