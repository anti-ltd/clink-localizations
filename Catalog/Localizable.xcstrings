    "Yours and the ones iOS shares. Off, they stay saved but don't expand.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine und die von iOS geteilten. Ausgeschaltet bleiben sie gespeichert, ersetzen aber nichts mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tuyas y las que comparte iOS. Desactivadas, se conservan pero no se expanden."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu enda ja iOS-i jagatud asendused. Välja lülitatult jäävad need alles, kuid ei rakendu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vôtres et ceux que partage iOS. Désactivés, ils restent enregistrés mais ne se déclenchent plus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sajátjaid és az iOS által megosztottak. Kikapcsolva megmaradnak, de nem cserélődnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue e quelle condivise da iOS. Se disattivate, restano salvate ma non vengono espanse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で追加したものと、iOSのユーザ辞書から共有されたもの。オフにしても保存されたままですが、変換されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 추가한 항목과 iOS에서 공유한 텍스트 대치 항목이에요. 끄면 저장은 유지되지만 바뀌지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Milik anda dan yang dikongsi iOS. Apabila dimatikan, ia kekal disimpan tetapi tidak dikembangkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas e as que o iOS partilha. Desativadas, ficam guardadas mas não são expandidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши и те, что передала iOS. Если выключить, они сохранятся, но не будут срабатывать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己的和 iOS 共享的文本替换。关闭后仍会保留，但不会再展开。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai tăi și celor pe care le distribuie iOS. Dezactivate, rămân salvate, dar nu se extind."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die van jou en die van iOS. Uit: ze blijven opgeslagen, maar breiden niet uit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己的和 iOS 共享的文字替換。關閉後仍會保留，但不會再展開。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Joune en dié wat iOS deel. Indien afgeskakel, bly hulle gestoor maar brei nie uit nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje i te, które udostępnia iOS. Wyłączone, pozostają zapisane, ale nie rozwijają się."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші та ті, якими ділиться iOS. Вимкнено, вони залишаються збереженими, але не розгортаються."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizin ve iOS'in paylaştığı şeyler. Kapalıyken kayıtlı kalırlar ancak genişlemezler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše a ty, které sdílí iOS. Vypnuto, zůstanou uloženy, ale nerozšíří se."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše a tie, ktoré zdieľa iOS. Vypnuté, zostanú uložené, ale nerozšíria sa."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δικά σας και αυτά που μοιράζεται το iOS. Ανενεργό, παραμένουν αποθηκευμένα αλλά δεν επεκτείνονται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din och de iOS delar. Av, de förblir frälsta men expanderar inte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din og dem iOS deler. Off, de forbliver reddet, men udvider sig ikke."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din og de iOS deler. Av, de forblir reddet, men utvider seg ikke."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omasi ja iOS:n jakamat. Pois päältä, ne pysyvät tallennettuina, mutta eivät laajene."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Milik Anda dan yang dibagikan iOS. Mati, mereka tetap disimpan tetapi tidak berkembang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Của bạn và những người iOS chia sẻ. Tắt, chúng vẫn được lưu nhưng không mở rộng."
          }
        }
      }
    },
    "Yours for life. Nothing to renew.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Joune lewenslank. Niks om te hernu nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für immer deins. Nichts zu verlängern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuyo de por vida. Nada que renovar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu eluaegselt. Midagi uuendada pole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À toi à vie. Rien à renouveler."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Örökre a tiéd. Nincs mit megújítani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo per sempre. Niente da rinnovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生涯ご利用いただけます。更新は不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평생 사용할 수 있습니다. 갱신할 것이 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Milik anda seumur hidup. Tiada apa untuk diperbaharui."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu para sempre. Nada para renovar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше навсегда. Продлевать нечего."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终身拥有，无需续订。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Al tău pe viață. Nimic de reînnoit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De jouwe voor het leven. Niets te vernieuwen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終身擁有，無需續訂。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój na całe życie. Nic do odnowienia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш на все життя. Нічого оновлювати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ömür boyu senin. Yenilenecek bir şey yok."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj na celý život. Není co obnovovat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj na celý život. Niet čo obnovovať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δικό σου για μια ζωή. Τίποτα για ανανέωση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din för livet. Inget att förnya."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din for livet. Intet at forny."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din for livet. Ingenting å fornye."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinun loppuelämäksi. Ei mitään uudistettavaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Milikmu seumur hidup. Tidak ada yang perlu diperbarui."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Của bạn suốt đời. Không có gì để làm mới."
          }
        }
      }
    },
