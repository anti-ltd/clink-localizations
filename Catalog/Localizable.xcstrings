        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoe groot elke emoji op sy sel teken."
          }
        }
      }
    },
    "A wash of colour over each cap, like a lit keycap.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un baño de color en cada tecla, como una tecla retroiluminada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voile de couleur sur chaque touche, comme un capuchon éclairé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Farbschleier über jeder Taste, wie eine beleuchtete Tastenkappe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una velatura di colore su ogni tasto, come un keycap illuminato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma camada de cor em cada tecla, como uma keycap iluminada."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapisan warna pada setiap kekunci, seperti kekunci bercahaya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Színréteg minden gombon, mint egy világító gombkupak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーに色を薄くかぶせ、光るキーキャップのように見せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个键帽罩上一层颜色，像发光键帽。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 키캡에 색을 얇게 덮어, 빛나는 키캡처럼 보이게 합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Värvi läige üle iga klahvi, nagu valgustatud klahvikate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заливка цвета по каждой клавише, как будто клавиша подсвечена."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Was van kleur oor elke pet, soos 'n verligte sleutelkap."
          }
        }
      }
    },
    "Backlight the keys as they glow and react": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroilumina las teclas para que brillen y reaccionen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétroéclairez les touches pour qu'elles brillent et réagissent"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasten hinterleuchten, damit sie glühen und reagieren"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroillumina i tasti perché brillino e reagiscano"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroilumina as teclas para brilharem e reagirem"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terangi kekunci supaya bercahaya dan bertindak balas"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Világítsd meg a gombokat, hogy ragyogjanak és reagáljanak"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを光らせ、反応させる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为按键打光，让它发光并作出反应"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키에 조명을 넣어 빛나고 반응하게"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgusta klahve tahapoolt, et need helendaksid ja reageeriksid"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсветите клавиши, чтобы они светились и реагировали"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verlig die sleutels terwyl hulle gloei en reageer"
          }
        }
      }
    },
    "How far the light reaches around the key you press, in key widths.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta dónde llega la luz alrededor de la tecla que pulsas, en anchos de tecla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'où la lumière s'étend autour de la touche frappée, en largeurs de touche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit das Licht um die gedrückte Taste reicht, in Tastenbreiten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fin dove arriva la luce attorno al tasto premuto, in larghezze di tasto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até onde a luz chega em torno da tecla premida, em larguras de tecla."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejauh mana cahaya sampai di sekeliling kekunci yang ditekan, dalam lebar kekunci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddig ér a fény a lenyomott gomb körül, gombszélességben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押したキーの周りに光が届く範囲（キー幅単位）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯光在所按按键周围扩散的范围（以按键宽度计）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누른 키 주변으로 빛이 닿는 범위(키 너비 기준)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui kaugele ulatub valgus vajutatud klahvi ümber, klahvilaiustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько далеко свет достаёт вокруг нажатой клавиши, в ширинах клавиши."
          }
        },
        "af": {
          "stringUnit": {
