    },
    "Hold space to drag. Keys stay visible but go inert.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt die Leertaste zum Ziehen. Die Tasten bleiben sichtbar, reagieren aber nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el espacio para arrastrar. Las teclas se ven pero no responden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens espace pour glisser. Les touches restent visibles mais deviennent inertes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd lenyomva a szóközt a húzáshoz. A gombok láthatók maradnak, de nem reagálnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto spazio per trascinare. I tasti restano visibili ma diventano inattivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースを長押しするとドラッグできます。キーは見えたままですが反応しなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스를 길게 눌러서 끌어보세요. 키는 보이지만 눌러도 반응 안 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan ruang untuk seret. Kekunci kekal nampak tapi jadi tak aktif."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o espaço premido para arrastar. As teclas ficam visíveis mas param de responder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте пробел, чтобы вести. Клавиши остаются видимыми, но перестают реагировать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按空格就能拖动。按键还看得见，但点不动了。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia tühikut, et lohistada. Klahvid jäävad nähtavaks, aga muutuvad inertseks."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou spasie om te sleep. Sleutels bly sigbaar, maar gaan inert."
          }
        }
      }
    },
