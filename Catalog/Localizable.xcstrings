    "App language changes Clink’s menus and screens, not the languages you type in.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Sprache ändert Clinks Menüs und Bildschirme, nicht die Sprachen, in denen du tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma de la app cambia los menús y las pantallas de Clink, no los idiomas en los que escribes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakenduse keel muudab Clinki menüüsid ja ekraane, mitte keeli, milles tipid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue de l’app change les menus et les écrans de Clink, pas celles dans lesquelles vous écrivez."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazás nyelve a Clink menüit és képernyőit módosítja, nem azokat a nyelveket, amelyeken gépelsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua dell’app cambia i menu e le schermate di Clink, non le lingue in cui scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの言語はClinkのメニューや画面の表示を変更します。入力する言語は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 언어는 Clink의 메뉴와 화면을 바꿔요. 입력하는 언어는 바뀌지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahasa apl menukar menu dan skrin Clink, bukan bahasa yang anda taip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma da app muda os menus e ecrãs do Clink, não os idiomas em que escreves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык приложения меняет меню и экраны Clink, но не языки, на которых вы печатаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用语言会更改 Clink 的菜单和界面，不影响你输入所用的语言。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limba aplicației modifică meniurile și ecranele Clink, nu limbile în care tastați."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app-taal verandert de menu's en schermen van Clink, niet de talen waarin u typt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用語言會更改 Clink 的選單和介面，不影響你輸入所用的語言。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "App-taal verander Clink se menus en skerms, nie die tale waarin jy tik nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Język aplikacji zmienia menu i ekrany Clink, a nie języki, w których piszesz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мова програми змінює меню та екрани Clink, а не мови, якими ви вводите текст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama dili, yazdığınız dilleri değil, Clink'in menülerini ve ekranlarını değiştirir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazyk aplikace mění nabídky a obrazovky Clink, nikoli jazyky, které zadáváte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazyk aplikácie mení ponuky a obrazovky Clink, nie jazyky, ktoré zadávate."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γλώσσα της εφαρμογής αλλάζει τα μενού και τις οθόνες του Clink, όχι τις γλώσσες που πληκτρολογείτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appens språk ändrar Clink:s menyer och skärmar, inte språken du skriver in."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "App-sproget ændrer Clink's menuer og skærme, ikke de sprog, du skriver på."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appspråk endrer Clinks menyer og skjermer, ikke språkene du skriver inn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksen kieli muuttaa Clink:n valikoita ja näyttöjä, ei kieliä, joilla kirjoitat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahasa aplikasi mengubah menu dan layar Clink, bukan bahasa yang Anda ketik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngôn ngữ ứng dụng thay đổi menu và màn hình của Clink chứ không phải ngôn ngữ bạn nhập."
          }
        }
      }
    },
