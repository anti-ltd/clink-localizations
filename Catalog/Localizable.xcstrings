    "Overwrite your current settings with this file, or save it as a new profile. Your themes are kept either way.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Oorskryf jou huidige instellings met hierdie lêer, of stoor dit as 'n nuwe profiel. Jou temas word op enige manier gehou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschreib deine aktuellen Einstellungen mit dieser Datei oder speicher sie als neues Profil. Deine Themes bleiben so oder so erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrescribe tus ajustes actuales con este archivo, o guárdalo como perfil nuevo. Tus temas se conservan de todos modos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjuta oma praegused seaded selle failiga üle või salvesta see uue profiilina. Sinu teemad jäävad mõlemal juhul alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrase tes réglages actuels avec ce fichier, ou enregistre-le comme nouveau profil. Tes thèmes sont gardés dans les deux cas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd felül a mostani beállításaidat ezzel a fájllal, vagy mentsd új profilként. A témáid így is, úgy is megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovrascrivi le impostazioni attuali con questo file, o salvalo come nuovo profilo. I tuoi temi restano al loro posto in ogni caso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルで今の設定を上書きするか、新しいプロファイルとして保存できます。どちらを選んでもテーマはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일로 지금 설정을 덮어쓰거나 새 프로필로 저장해 주세요. 어느 쪽이든 테마는 그대로 남아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti tetapan semasa anda dengan fail ini, atau simpan sebagai profil baharu. Tema anda dikekalkan macam mana pun."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui as tuas definições atuais por este ficheiro, ou guarda-o como um novo perfil. Os teus temas ficam guardados de qualquer forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезаписать текущие настройки этим файлом или сохранить его как новый профиль. Темы сохранятся в любом случае."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用这个文件覆盖你现在的设置，或者另存成一个新配置。不管选哪种，你的主题都会留着。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Suprascrieți setările curente cu acest fișier sau salvați-l ca profil nou. Temele tale sunt păstrate în orice caz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overschrijf uw huidige instellingen met dit bestand, of sla het op als een nieuw profiel. Je thema's blijven hoe dan ook behouden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用這個檔案覆蓋你現在的設定，或者另存成一個新配置。不管選哪種，你的主題都會留著。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąp swoje bieżące ustawienia tym plikiem lub zapisz go jako nowy profil. Twoje motywy zostaną zachowane w obu przypadkach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапишіть поточні налаштування цим файлом або збережіть його як новий профіль. Ваші теми зберігаються в будь-якому випадку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosyayı mevcut ayarlarınızın üzerine yazın veya yeni bir profil olarak kaydedin. Temalarınız her iki durumda da korunur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepište aktuální nastavení tímto souborem nebo jej uložte jako nový profil. Vaše témata jsou zachována v obou směrech."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepíšte svoje aktuálne nastavenia týmto súborom alebo ho uložte ako nový profil. Vaše témy sú zachované v oboch smeroch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντικαταστήστε τις τρέχουσες ρυθμίσεις σας με αυτό το αρχείο ή αποθηκεύστε το ως νέο προφίλ. Τα θέματά σας διατηρούνται με κάθε τρόπο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv över dina nuvarande inställningar med den här filen, eller spara den som en ny profil. Dina teman behålls åt båda hållen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Overskriv dine nuværende indstillinger med denne fil, eller gem den som en ny profil. Dine temaer bevares på begge måder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Overskriv gjeldende innstillinger med denne filen, eller lagre den som en ny profil. Temaene dine beholdes uansett."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korvaa nykyiset asetuksesi tällä tiedostolla tai tallenna se uutena profiilina. Teemasi säilytetään joka tapauksessa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timpa pengaturan Anda saat ini dengan file ini, atau simpan sebagai profil baru. Tema Anda tetap dipertahankan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi đè cài đặt hiện tại của bạn bằng tệp này hoặc lưu nó dưới dạng hồ sơ mới. Chủ đề của bạn được giữ theo một trong hai cách."
          }
        }
      }
    },
