    "A theme carries a light look and a dark one, and Clink switches between them with the phone.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Tema het 'n ligte voorkoms en 'n donker een, en Clink skakel tussen hulle met die foon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Design hat einen hellen und einen dunklen Look, und Clink wechselt zusammen mit dem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tema lleva un aspecto claro y otro oscuro, y Clink cambia entre ellos con el teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teema kannab endas heledat ja tumedat ilmet ning Clink vahetab neid koos telefoniga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un thème contient un rendu clair et un sombre, et Clink bascule en même temps que le téléphone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy témában van egy világos és egy sötét változat, a Clink pedig a telefonnal együtt vált köztük."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tema porta con sé un aspetto chiaro e uno scuro, e Clink passa dall'uno all'altro insieme al telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマにはライト用とダーク用の見た目があり、Clinkは端末に合わせて切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마에는 밝은 모습과 어두운 모습이 함께 들어 있고, Clink이 기기에 맞춰 전환합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu tema membawa rupa cerah dan rupa gelap, dan Clink bertukar antara keduanya bersama telefon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um tema traz um aspecto claro e um escuro, e o Clink alterna entre eles com o telemóvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В теме есть светлый вид и тёмный, и Clink переключает их вместе с телефоном."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个主题自带浅色和深色两套外观，Clink 会跟着手机一起切换。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O temă are un aspect deschis și unul întunecat, iar Clink comută între ele cu telefonul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een thema heeft een lichte en een donkere uitstraling, en Clink schakelt ertussen met de telefoon."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個主題自帶淺色和深色兩套外觀，Clink 會跟著手機一起切換。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motyw ma wygląd jasny i ciemny, a Clink przełącza się między nimi za pomocą telefonu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема має світлий і темний вигляд, і Clink перемикається між ними за допомогою телефону."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tema açık ve koyu bir görünüm taşıyor ve Clink telefonla bunlar arasında geçiş yapıyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Motiv má světlý a tmavý vzhled a Clink mezi nimi přepíná pomocí telefonu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Téma má svetlý a tmavý vzhľad a Clink medzi nimi prepína pomocou telefónu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα θέμα έχει μια ανοιχτόχρωμη εμφάνιση και ένα σκούρο, και το Clink εναλλάσσεται μεταξύ τους με το τηλέφωνο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett tema har ett ljust utseende och ett mörkt, och Clink växlar mellan dem med telefonen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et tema har et lyst udseende og et mørkt, og Clink skifter mellem dem med telefonen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et tema har et lyst utseende og et mørkt, og Clink bytter mellom dem med telefonen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teemassa on vaalea ja tumma ilme, ja Clink vaihtaa niiden välillä puhelimen kanssa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah tema memiliki tampilan terang dan gelap, dan Clink beralih di antara keduanya dengan telepon."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một chủ đề mang giao diện sáng và giao diện tối và Clink chuyển đổi giữa chúng bằng điện thoại."
          }
        }
      }
    },
    "A thin tail swelling into a bright head.": {
