    "Sending from the app needs a real iPhone or iPad. Email works from anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para enviar desde la app hace falta un iPhone o iPad de verdad. El correo funciona desde cualquier sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi depuis l’app nécessite un vrai iPhone ou iPad. L’e-mail fonctionne partout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden aus der App geht nur auf einem echten iPhone oder iPad. Per E-Mail geht es überall."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per inviare dall’app serve un vero iPhone o iPad. L’email funziona ovunque."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar a partir da app requer um iPhone ou iPad a sério. O e-mail funciona em qualquer lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка из приложения работает только на настоящем iPhone или iPad. Написать по почте можно откуда угодно."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghantar dari app memerlukan iPhone atau iPad sebenar. E-mel boleh digunakan di mana-mana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appból küldéshez valódi iPhone vagy iPad kell. E-mailben bárhonnan írhatsz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリから送信するには実機の iPhone または iPad が必要です。メールならどこからでも送れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 App 发送需要使用真实的 iPhone 或 iPad。电子邮件则随处可用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 보내려면 실제 iPhone 또는 iPad가 필요합니다. 이메일은 어디서나 보낼 수 있습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Äpist saatmiseks on vaja päris iPhone’i või iPadi. E-post töötab igal pool."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimiterea din aplicație necesită un iPhone sau iPad real. E-mailul funcționează de oriunde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor het verzenden vanuit de app is een echte iPhone of iPad vereist. E-mail werkt overal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 App 傳送需要使用真實的 iPhone 或 iPad。電子郵件則隨處可用。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Om vanaf die toepassing te stuur, is 'n regte iPhone of iPad nodig. E-pos werk van enige plek af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłanie z aplikacji wymaga prawdziwego iPhone'a lub iPada. E-mail działa z dowolnego miejsca."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для надсилання з програми потрібен справжній iPhone або iPad. Електронна пошта працює з будь-якого місця."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadan göndermek için gerçek bir iPhone veya iPad gerekir. E-posta her yerden çalışır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odesílání z aplikace vyžaduje skutečný iPhone nebo iPad. E-mail funguje odkudkoli."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na odosielanie z aplikácie je potrebný skutočný iPhone alebo iPad. E-mail funguje odkiaľkoľvek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποστολή από την εφαρμογή χρειάζεται ένα πραγματικό iPhone ή iPad. Το email λειτουργεί από οπουδήποτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att skicka från appen krävs en riktig iPhone eller iPad. E-post fungerar var som helst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At sende fra appen kræver en rigtig iPhone eller iPad. E-mail virker fra hvor som helst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending fra appen trenger en ekte iPhone eller iPad. E-post fungerer fra hvor som helst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksesta lähettäminen vaatii oikean iPhonen tai iPadin. Sähköposti toimii missä tahansa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengirim dari aplikasi memerlukan iPhone atau iPad asli. Email berfungsi dari mana saja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi từ ứng dụng cần có iPhone hoặc iPad thật. Email hoạt động từ mọi nơi."
          }
        }
      }
    },
    "That’s a lot in a short time. Try again in about %lld min.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es mucho en poco tiempo. Vuelve a intentarlo en unos %lld min."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est beaucoup en peu de temps. Réessaie dans environ %lld min."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist viel in kurzer Zeit. Versuch es in etwa %lld Min. noch einmal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È molto in poco tempo. Riprova tra circa %lld min."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É muito em pouco tempo. Tenta novamente daqui a cerca de %lld min."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много за короткое время. Попробуйте снова примерно через %lld мин."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu terlalu banyak dalam masa yang singkat. Cuba lagi dalam kira-kira %lld min."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez rövid idő alatt sok volt. Próbáld újra kb. %lld perc múlva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短時間に多くの送信がありました。約%lld分後にもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短时间内发送太多了。请大约 %lld 分钟后再试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 시간에 너무 많이 보냈습니다. 약 %lld분 후에 다시 시도해 주세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lühikese aja jooksul on seda palju. Proovi umbes %lld min pärast uuesti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mult într-un timp scurt. Încercați din nou în aproximativ %lld min."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat is veel in korte tijd. Probeer het over ongeveer %lld minuten opnieuw."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "短時間內傳送太多了。請大約 %lld 分鐘後再試。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis baie in 'n kort tydjie. Probeer weer oor ongeveer %lld minute."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To dużo w krótkim czasie. Spróbuj ponownie za około %lld min."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це дуже багато за короткий час. Повторіть спробу приблизно через %lld хв."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısa sürede çok şey ifade ediyor. Yaklaşık %lld dakika sonra tekrar deneyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To je hodně za krátkou dobu. Zkuste to znovu za cca %lld min."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "To je veľa za krátky čas. Skúste to znova o približne %lld min."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι πολλά σε σύντομο χρονικό διάστημα. Δοκιμάστε ξανά σε περίπου %lld λεπτά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är mycket på kort tid. Försök igen om ungefär %lld min."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er meget på kort tid. Prøv igen om ca. %lld min."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er mye på kort tid. Prøv igjen om ca. %lld min."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on paljon lyhyessä ajassa. Yritä uudelleen noin %lld min kuluttua."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu banyak sekali dalam waktu singkat. Coba lagi sekitar %lld mnt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là rất nhiều trong một thời gian ngắn. Hãy thử lại sau khoảng %lld phút."
