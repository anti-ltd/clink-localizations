    "Press the hero key to hear it.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke die große Vorschautaste, um den Klang zu hören."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa la tecla de muestra para escuchar el sonido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Heli kuulamiseks vajuta suurt eelvaateklahvi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur la grande touche de démonstration pour écouter le son."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomd meg a nagy előnézeti billentyűt, hogy meghallgasd a hangját."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi il grande tasto di anteprima per ascoltare il suono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きく表示されたキーを押すと、音を試せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크게 표시된 키를 눌러 소리를 들어 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan kekunci besar pada pratonton untuk mendengar bunyinya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prime a tecla de demonstração para ouvires o som."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на большую клавишу предпросмотра, чтобы послушать звук."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下页面上的大按键即可试听。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați tasta erou pentru a o auzi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op de heldentoets om het te horen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下頁面上的大按鍵即可試聽。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk die hoofsleutel om dit te hoor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij klawisz bohatera, aby go usłyszeć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть клавішу героя, щоб почути це."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duymak için kahraman tuşuna basın."
          }
        },
