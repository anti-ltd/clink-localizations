    "Darkens the key's inner edge, so the cap looks recessed.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maak die sleutel se binnerand donkerder, sodat die doppie ingedruk lyk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkelt die Innenkante ab, sodass die Taste eingelassen wirkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscurece el borde interior para que la tecla parezca hundida."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumestab klahvi sisemise serva, nii et kate näib süvendatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assombrit le bord intérieur pour que la touche paraisse enfoncée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sötétíti a billentyű belső élét, így az bemélyedve hat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scurisce il bordo interno, così il tasto sembra incassato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの内側の縁が暗くなり、へこんで見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 안쪽 가장자리를 어둡게 해서 눌린 것처럼 보여요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggelapkan bibir dalam kekunci supaya ia nampak terbenam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escurece o bordo interior, para a tecla parecer encaixada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемняет внутренний край клавиши, и она выглядит утопленной."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压暗按键内缘，让键帽看起来是嵌进去的。"
          }
        }
      }
    },
