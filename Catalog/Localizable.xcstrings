    "You were here before Clink was free. It's yours for life. Thank you.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy was hier voor Clink vry was. Dit is joune lewenslank. Dankie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du warst dabei, bevor Clink kostenlos wurde. Für dich bleibt alles für immer frei. Danke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estuviste aquí antes de que Clink fuera gratis. Es tuyo para siempre. Gracias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa olid siin enne, kui Clink läks tasuta. Ta on sinu eluaegselt. Aitäh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu étais là avant que Clink soit gratuit. Il est à toi pour toujours. Merci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már akkor itt voltál, amikor a Clink még nem volt ingyenes. Örökre a tiéd. Köszönöm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'eri prima che Clink diventasse gratis. È tuo per sempre. Grazie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkが無料になる前からいてくれました。ずっとあなたのものです。ありがとう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink가 무료가 되기 전부터 함께해 주셨어요. 평생 사용할 수 있어요. 고맙습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda ada sebelum Clink menjadi percuma. Semuanya milik anda selamanya. Terima kasih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiveste aqui antes de o Clink ser grátis. É teu para sempre. Obrigado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы были здесь, когда Clink ещё не был бесплатным. Он ваш навсегда. Спасибо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Clink 免费之前，你就已经在这里。它永远属于你。谢谢。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai fost aici înainte ca Clink să fie liber. Este al tău pe viață. Multumesc."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je was hier voordat Clink gratis was. Het is van jou voor het leven. Bedankt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Clink 免費之前，你就已經在這裡。它永遠屬於你。謝謝。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Byłeś tu zanim Clink był wolny. Jest twoje na całe życie. Dziękuję."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви були тут до того, як Clink звільнився. Це твоє на все життя. дякую"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ücretsiz olmadan önce buradaydınız. Ömür boyu senindir. Teşekkür ederim."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Byli jste tady, než bylo Clink volné. Je to tvoje na celý život. Děkuju."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Boli ste tu predtým, ako bolo Clink zadarmo. Je to tvoje na celý život. dakujem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ήσασταν εδώ πριν το Clink είναι δωρεάν. Είναι δικό σου για μια ζωή. Σας ευχαριστώ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du var här innan Clink var gratis. Det är ditt för livet. Tack."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du var her før Clink var gratis. Det er dit for livet. Tak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du var her før Clink var gratis. Det er ditt for livet. Takk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olit täällä ennen kuin Clink oli vapaa. Se on sinun loppuelämäsi. Kiitos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda berada di sini sebelum Clink gratis. Itu milikmu seumur hidup. Terima kasih."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã ở đây trước khi Clink miễn phí. Nó là của bạn suốt đời. Cảm ơn."
          }
        }
      }
    },
