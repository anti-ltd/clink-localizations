    "Review and save the draft, then enable it in its editor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe und speichere den Entwurf. Aktiviere ihn danach im Editor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa y guarda el borrador; después, actívalo en su editor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaata mustand üle ja salvesta see, seejärel luba see redaktoris."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie et enregistre le brouillon, puis active-le dans son éditeur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizd és mentsd a vázlatot, majd engedélyezd a szerkesztőjében."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla e salva la bozza, poi attivala nel suo editor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きを確認して保存し、エディタで有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초안을 검토하고 저장한 다음 편집기에서 활성화하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak dan simpan draf, kemudian aktifkannya dalam editor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Revê e guarda o rascunho e, depois, ativa-o no editor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте и сохраните черновик, затем включите его в редакторе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查并保存草稿，然后在编辑器中启用。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Examinați și salvați schița, apoi activați-o în editorul său."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer het concept, sla het op en schakel het vervolgens in de editor in."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查並儲存草稿，然後在編輯器中啟用。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hersien en stoor die konsep, en aktiveer dit dan in die redigeerder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejrzyj i zapisz wersję roboczą, a następnie włącz ją w edytorze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляньте та збережіть чернетку, а потім увімкніть її в редакторі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taslağı inceleyip kaydedin, ardından düzenleyicisinde etkinleştirin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte a uložte koncept a poté jej povolte v jeho editoru."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte a uložte koncept a potom ho povoľte v jeho editore."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε και αποθηκεύστε το πρόχειρο και, στη συνέχεια, ενεργοποιήστε το στον επεξεργαστή του."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Granska och spara utkastet och aktivera det sedan i dess redigerare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemgå og gem kladden, og aktiver den derefter i dens editor."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se gjennom og lagre utkastet, og aktiver det deretter i redigeringsprogrammet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista ja tallenna luonnos ja ota se käyttöön sen editorissa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinjau dan simpan draf tersebut, lalu aktifkan di editornya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại và lưu bản nháp, sau đó kích hoạt nó trong trình chỉnh sửa."
          }
        }
      }
    },
