    "Your profiles, themes, and clipboard stay on this device. This clears the copies in iCloud and turns sync off.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou profiele, temas en knipbord bly op hierdie toestel. Dit maak die kopieë in iCloud skoon en skakel sinkronisering af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Profile, Themes und die Zwischenablage bleiben auf diesem Gerät. Das hier löscht die Kopien in iCloud und schaltet die Synchronisierung aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus perfiles, temas y portapapeles se quedan en este dispositivo. Esto borra las copias de iCloud y desactiva la sincronización."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu profiilid, teemad ja lõikelaud jäävad sellesse seadmesse. See tühjendab koopiad iCloudist ja lülitab sünkroonimise välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes profils, tes thèmes et ton presse-papiers restent sur cet appareil. Cette action efface les copies dans iCloud et désactive la synchronisation."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A profiljaid, témáid és a vágólapod ezen az eszközön maradnak. Ez az iCloudban lévő másolatokat törli, és kikapcsolja a szinkronizálást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi profili, i temi e gli appunti restano su questo dispositivo. Questa azione cancella le copie su iCloud e disattiva la sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイル、テーマ、クリップボードはこの端末に残ります。iCloud上のコピーを削除し、同期をオフにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필, 테마, 클립보드는 이 기기에 그대로 남습니다. iCloud에 있는 사본을 지우고 동기화를 끕니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, tema dan papan keratan anda kekal pada peranti ini. Tindakan ini memadam salinan dalam iCloud dan mematikan penyegerakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus perfis, temas e área de transferência ficam neste dispositivo. Isto apaga as cópias no iCloud e desliga a sincronização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши профили, темы и буфер обмена остаются на этом устройстве. Это удалит копии в iCloud и выключит синхронизацию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的配置文件、主题和剪贴板都会保留在这台设备上。此操作会清除 iCloud 中的副本并关闭同步。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilurile, temele și clipboard-ul dvs. rămân pe acest dispozitiv. Aceasta șterge copiile din iCloud și dezactivează sincronizarea."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je profielen, thema's en klembord blijven op dit apparaat staan. Hierdoor worden de kopieën in iCloud gewist en wordt de synchronisatie uitgeschakeld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的配置檔案、主題和剪貼簿都會保留在這臺裝置上。此操作會清除 iCloud 中的副本並關閉同步。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje profile, motywy i schowek pozostają na tym urządzeniu. Spowoduje to usunięcie kopii w iCloud i wyłączenie synchronizacji."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші профілі, теми та буфер обміну залишаються на цьому пристрої. Це очищає копії в iCloud і вимикає синхронізацію."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilleriniz, temalarınız ve panonuz bu cihazda kalır. Bu, iCloud'teki kopyaları temizler ve senkronizasyonu kapatır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše profily, motivy a schránka zůstanou v tomto zařízení. Tím vymažete kopie v iCloud a vypnete synchronizaci."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše profily, motívy a schránka zostanú v tomto zariadení. Tým sa vymažú kópie v iCloud a vypne sa synchronizácia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα προφίλ, τα θέματα και το πρόχειρό σας παραμένουν σε αυτήν τη συσκευή. Αυτό διαγράφει τα αντίγραφα στο iCloud και απενεργοποιεί τον συγχρονισμό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina profiler, teman och urklipp finns kvar på den här enheten. Detta rensar kopiorna i iCloud och stänger av synkroniseringen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine profiler, temaer og udklipsholder forbliver på denne enhed. Dette rydder kopierne i iCloud og slår synkronisering fra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilene, temaene og utklippstavlen forblir på denne enheten. Dette sletter kopiene i iCloud og slår synkronisering av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiilisi, teemasi ja leikepöydäsi pysyvät tällä laitteella. Tämä tyhjentää iCloud:n kopiot ja kytkee synkronoinnin pois päältä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, tema, dan papan klip Anda tetap ada di perangkat ini. Ini menghapus salinan di iCloud dan mematikan sinkronisasi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ, chủ đề và khay nhớ tạm của bạn vẫn ở trên thiết bị này. Thao tác này sẽ xóa các bản sao trong iCloud và tắt đồng bộ hóa."
          }
        }
      }
    },
    "Your recording visual, shown live. Swipe it to change style.": {
