    "Emoji is off. Turn it on to use and customize it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji ist aus. Schalte es ein, um es zu nutzen und anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los emojis están desactivados. Actívalos para usarlos y personalizarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les emoji sont désactivés. Active-les pour les utiliser et les personnaliser."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az emodzsi ki van kapcsolva. Kapcsold be, hogy használhasd és beállíthasd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli emoji sono disattivati. Attivali per usarli e personalizzarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵文字はオフです。オンにすると使えて、設定も変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이모지가 꺼져 있어요. 켜면 쓰고 설정도 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji dimatikan. Hidupkannya untuk guna dan sesuaikannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os emojis estão desligados. Liga-os para os usares e personalizares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эмодзи выключены. Включите их, чтобы пользоваться и настраивать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表情符号已关闭。打开后就能使用并调整设置。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji on väljas. Lülita need sisse, et kasutada ja kohandada."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Emoji is af. Skakel dit aan om dit te gebruik en aan te pas."
          }
        }
      }
    },
