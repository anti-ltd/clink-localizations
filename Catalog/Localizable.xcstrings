    "Apple Intelligence translates for higher-quality, more idiomatic results. On-device; nothing uploaded.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence vertaal vir hoër gehalte, meer idiomatiese resultate. Op die toestel; niks opgelaai nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence übersetzt für bessere, natürlichere Ergebnisse. Alles auf dem Gerät, nichts wird hochgeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence traduce para darte resultados mejores y más naturales. En el dispositivo; no se sube nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence tõlgib kvaliteetsemate ja loomulikumate tulemuste jaoks. Seadmel; midagi ei laadita üles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence traduit pour des résultats plus naturels et de meilleure qualité. Sur l'appareil, rien n'est envoyé en ligne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Intelligence fordít, jobb minőségű, természetesebb eredményért. Az eszközön történik, semmi nem megy fel a netre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence traduce con risultati più naturali e di qualità. Sul dispositivo, non viene caricato niente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceで翻訳すると、もっと質が高く自然な結果になります。デバイス内で処理するので、何もアップロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 번역해서 더 좋고 자연스러운 결과를 만들어줘요. 기기 안에서 처리하니까 밖으로 나가는 건 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence terjemah untuk hasil yang lebih baik dan lebih bersahaja. Dalam peranti; tiada apa dimuat naik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence traduz para dar resultados mais idiomáticos e de melhor qualidade. No dispositivo, nada é enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence переводит качественнее и живее. Всё на устройстве, ничего не загружается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Apple Intelligence 来翻译，质量更高，也更地道。都在设备上完成，不会上传任何东西。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence se traduce pentru rezultate de calitate superioară, mai idiomatice. Pe dispozitiv; nimic încărcat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence vertaalt zich in meer idiomatische resultaten van hogere kwaliteit. Op apparaat; niets geüpload."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Apple Intelligence 來翻譯，質量更高，也更地道。都在裝置上完成，不會上傳任何東西。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence oznacza wyższą jakość i bardziej idiomatyczne wyniki. Na urządzeniu; nic nie zostało przesłane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence перекладає для більш якісних і ідіоматичних результатів. На пристрої; нічого не завантажено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence daha yüksek kaliteli, daha deyimsel sonuçlar anlamına gelir. Cihaz üzerinde; hiçbir şey yüklenmedi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence znamená vyšší kvalitu a více idiomatické výsledky. Na zařízení; nic nahraného."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence znamená vyššiu kvalitu, viac idiomatické výsledky. Na zariadení; nič nahrané."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Intelligence μεταφράζεται για υψηλότερης ποιότητας, πιο ιδιωματικά αποτελέσματα. Στη συσκευή? τίποτα δεν ανέβηκε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence översätts för högre kvalitet, mer idiomatiska resultat. På enheten; inget uppladdat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence oversætter til højere kvalitet, mere idiomatiske resultater. På enheden; intet uploadet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence oversetter for høyere kvalitet, mer idiomatiske resultater. På enheten; ingenting lastet opp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence tarkoittaa laadukkaampia ja idiomaattisempia tuloksia. Laitteessa; mitään ei ladattu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence diterjemahkan untuk hasil yang lebih berkualitas dan idiomatis. Di perangkat; tidak ada yang diunggah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence mang lại kết quả có chất lượng cao hơn, phù hợp hơn. Trên thiết bị; không có gì được tải lên."
          }
        }
      }
    },
    "Apple's on-device language packs translate offline. Fast and wide device support; a pack may download on first use.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple se taalpakkette op die toestel vertaal vanlyn. Vinnige en wye toestelondersteuning; 'n pakkie kan by die eerste gebruik afgelaai word."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples Sprachpakete auf dem Gerät übersetzen offline. Schnell und auf vielen Geräten; ein Paket wird beim ersten Mal vielleicht geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los paquetes de idioma de Apple traducen sin conexión, en el propio dispositivo. Rápidos y compatibles con muchos dispositivos; puede que se descargue un paquete la primera vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple seadmesisesed keelepaketid tõlgivad ühenduseta. Kiire ja lai seadmetoetus; pakett võib esmakordsel kasutamisel alla laadida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modules de langue sur l'appareil d'Apple traduisent hors ligne. Rapides et compatibles avec plein d'appareils ; un module peut se télécharger à la première utilisation."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple eszközön futó nyelvi csomagjai offline fordítanak. Gyors, és sok eszközön megy; a csomag az első használatkor letöltődhet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pacchetti lingua sul dispositivo di Apple traducono offline. Veloci e con ampio supporto; al primo utilizzo un pacchetto potrebbe scaricarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple の端末内の言語パックがオフラインで翻訳します。速くて対応端末も多いですが、初めて使うときはパックのダウンロードが必要な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple의 온디바이스 언어 팩이 오프라인으로 번역해요. 빠르고 지원하는 기기도 많아요. 처음 쓸 때 팩을 내려받을 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek bahasa atas peranti Apple menterjemah secara luar talian. Pantas dengan sokongan peranti luas; sesuatu pek mungkin dimuat turun kali pertama anda guna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pacotes de idioma da Apple traduzem no aparelho, offline. Rápidos e com suporte em muitos aparelhos; um pacote pode ser descarregado na primeira utilização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Языковые пакеты Apple переводят офлайн, прямо на устройстве. Быстро и работает на большинстве устройств; при первом использовании пакет может загрузиться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 的设备端语言包能离线翻译。速度快、支持的设备多；第一次用可能要下个语言包。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pachetele de limbi Apple de pe dispozitiv se traduc offline. Suport rapid și larg pentru dispozitive; un pachet se poate descărca la prima utilizare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De taalpakketten op het apparaat van Apple vertalen offline. Snelle en brede apparaatondersteuning; een pakket kan bij het eerste gebruik worden gedownload."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 的裝置端語言包能離線翻譯。速度快、支援的裝置多；第一次用可能要下個語言包。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakiety językowe Apple na urządzeniu tłumaczą w trybie offline. Szybka i szeroka obsługa urządzeń; pakiet może zostać pobrany przy pierwszym użyciu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мовні пакети Apple на пристрої перекладають офлайн. Швидка і широка підтримка пристроїв; пакет можна завантажити під час першого використання."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple'ın cihazdaki dil paketleri çevrimdışı çeviri yapar. Hızlı ve geniş cihaz desteği; ilk kullanımda bir paket indirilebilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazykové balíčky Apple na zařízení se překládají offline. Rychlá a široká podpora zařízení; balíček lze stáhnout při prvním použití."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazykové balíky Apple na zariadení sa prekladajú offline. Rýchla a široká podpora zariadení; balíček sa môže stiahnuť pri prvom použití."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πακέτα γλώσσας της Apple στη συσκευή μεταφράζονται εκτός σύνδεσης. Γρήγορη και ευρεία υποστήριξη συσκευής. μπορεί να γίνει λήψη ενός πακέτου κατά την πρώτη χρήση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples språkpaket på enheten översätts offline. Snabbt och brett enhetsstöd; ett paket kan laddas ner vid första användningen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples sprogpakker på enheden oversættes offline. Hurtig og bred enhedsunderstøttelse; en pakke kan downloades ved første brug."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples språkpakker på enheten oversettes offline. Rask og bred enhetsstøtte; en pakke kan lastes ned ved første gangs bruk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Applen laitteessa olevat kielipaketit käännetään offline-tilassa. Nopea ja laaja laitetuki; paketin voi ladata ensimmäisellä käyttökerralla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket bahasa di perangkat Apple diterjemahkan secara offline. Dukungan perangkat yang cepat dan luas; satu paket dapat diunduh pada penggunaan pertama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói ngôn ngữ trên thiết bị của Apple dịch ngoại tuyến. Hỗ trợ thiết bị nhanh và rộng; một gói có thể tải xuống trong lần sử dụng đầu tiên."
          }
        }
      }
    },
    "Applied to emoji that can take a skin tone, unless you’ve set one for that emoji by holding it down in the keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegepas op emoji's wat 'n velkleur kan aanneem, tensy jy een vir daardie emoji gestel het deur dit in die sleutelbord te hou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für Emojis, die einen Hautton haben können, außer du hast für dieses Emoji selbst einen festgelegt, indem du es auf der Tastatur gedrückt hältst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a los emoji que admiten tono de piel, salvo que le hayas puesto uno a ese emoji manteniéndolo pulsado en el teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakendub emojidele, mis võivad omada nahatooni, välja arvatud juhul, kui oled selle emoji jaoks ise ühe määranud, klaviatuuril seda all hoides."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique aux emoji qui acceptent une teinte de peau, sauf si tu en as choisi une pour cet emoji en le gardant appuyé dans le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azokra az emojikra vonatkozik, amik felvehetnek bőrtónust, kivéve ha egyet már beállítottál nekik a billentyűzeten lenyomva tartással."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale per le emoji che possono avere una tonalità della pelle, a meno che tu non ne abbia scelta una per quell'emoji tenendola premuta sulla tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肌の色を選べる絵文字に反映されます。ただし、キーボードでその絵文字を長押しして肌の色を決めている場合は、そちらが優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피부색을 넣을 수 있는 이모지에 적용돼요. 키보드에서 그 이모지를 길게 눌러 직접 정해 뒀다면 그건 빼고요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan pada emoji yang boleh terima ton kulit, melainkan anda dah tetapkan satu untuk emoji itu dengan menahannya pada papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se aos emoji que aceitam tom de pele, a não ser que já tenhas definido um para esse emoji, mantendo-o premido no teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется к эмодзи, у которых есть тон кожи, — кроме тех, для которых вы задали свой, удержав их на клавиатуре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用在能设肤色的表情上，除非你在键盘里长按单独给它设过肤色。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplică emoji-urilor care pot lua un ton al pielii, cu excepția cazului în care ați setat unul pentru acel emoji ținând-l apăsat pe tastatură."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegepast op emoji die een huidskleur kunnen aannemen, tenzij je er een voor die emoji hebt ingesteld door deze op het toetsenbord ingedrukt te houden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用在能設膚色的表情上，除非你在鍵盤裡長按單獨給它設過膚色。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy emoji, które mogą przyjmować odcień skóry, chyba że ustawisz go dla tego emoji, przytrzymując go na klawiaturze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосовується до емодзі, які можуть приймати тон шкіри, якщо ви не встановили його для цього емодзі, утримуючи його на клавіатурі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyede basılı tutarak o emoji için bir tane ayarlamadığınız sürece, cilt tonu alabilen emojilere uygulanır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikováno na emotikony, které mohou mít odstín pleti, pokud jste jej pro emotikony nenastavili tak, že jej podržíte na klávesnici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikuje sa na emotikony, ktoré môžu mať tón pleti, pokiaľ ste ho pre toto emodži nenastavili tak, že ho podržíte na klávesnici."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εφαρμόζεται σε emoji που μπορούν να πάρουν έναν τόνο δέρματος, εκτός αν έχετε ορίσει ένα για αυτό το emoji κρατώντας το πατημένο στο πληκτρολόγιο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillämpas på emoji som kan ta en hudton, såvida du inte har ställt in en för den emojin genom att hålla ner den på tangentbordet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anvendt på emoji, der kan have en hudtone, medmindre du har indstillet en til den emoji ved at holde den nede på tastaturet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukes på emoji som kan ha en hudtone, med mindre du har angitt en for den emojien ved å holde den nede på tastaturet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koskee hymiöitä, jotka voivat ottaa ihon sävyn, ellet ole asettanut sitä kyseiselle emojille pitämällä sitä alhaalla näppäimistöllä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diterapkan pada emoji yang dapat mengambil warna kulit, kecuali Anda telah menyetelnya untuk emoji tersebut dengan menahannya di keyboard."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng cho biểu tượng cảm xúc có thể có tông màu da, trừ khi bạn đặt một biểu tượng cảm xúc cho biểu tượng cảm xúc đó bằng cách giữ nó trên bàn phím."
          }
        }
      }
    },
