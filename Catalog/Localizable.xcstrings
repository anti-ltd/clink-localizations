            "value": "Tot 32 karakters. Laat leeg vir die versteketiket."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do 32 znaków. Pozostaw puste dla etykiety domyślnej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До 32 символів. Залиште порожнім для мітки за замовчуванням."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla 32 karakter. Varsayılan etiket için boş bırakın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
