          "stringUnit": {
            "state": "needs_review",
            "value": "Stel sy hoogte en teksgrootte in met die twee skuifknoppies onder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell Höhe und Textgröße mit den zwei Reglern darunter ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta su altura y el tamaño del texto con los dos deslizadores de debajo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Määra selle kõrgus ja teksti suurus kahe allpool oleva liuguriga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle sa hauteur et la taille du texte avec les deux curseurs en dessous."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A magasságát és a szövegméretét az alatta lévő két csúszkával állítsd be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola altezza e dimensione del testo con i due cursori sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その下の2つのスライダーで、高さと文字サイズを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래의 슬라이더 두 개로 높이와 글자 크기를 정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan tingginya dan saiz teks dengan dua peluncur di bawahnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Define a altura e o tamanho do texto com os dois cursores por baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте его высоту и размер текста двумя регуляторами ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用下面两个滑块设定它的高度和字号。"
          }
        }
      }
    },
    "Set not found": {
