    "\"%@\" won't be kept correctly spelled anymore.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird nicht mehr korrekt geschrieben beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» dejará de conservarse con la ortografía correcta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” ei jää enam õigesti kirjutatuks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne sera plus conservé avec son orthographe correcte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” többé nem marad helyesen írva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» non verrà più conservato con l'ortografia corretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は正しいスペルとして保持されなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은 더 이상 올바른 철자로 유지되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” tidak akan dikekalkan dengan ejaan yang betul lagi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» deixará de ser mantido com a ortografia correta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» больше не будет сохраняться с правильным написанием."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将不再保持为正确拼写。"
          }
        }
      }
    },
    "\"%@\" won't be suggested again unless you type it twice.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" sal nie weer voorgestel word nie, tensy jy dit twee keer tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird nicht mehr vorgeschlagen, es sei denn, du tippst es zweimal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” no volverá a sugerirse a menos que lo escribas dos veces."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ei soovitata enam, kui just ei tippi seda kaks korda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne sera plus suggéré, sauf si tu le tapes deux fois."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ többé nem lesz felajánlva, hacsak nem gépeled be kétszer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non verrà più suggerito, a meno che non lo digiti due volte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は、2回入力しない限り今後提案されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」은(는) 두 번 입력하지 않는 한 다시 제안되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” tidak akan dicadangkan lagi melainkan anda menaipnya dua kali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não voltará a ser sugerido, a menos que o escreva duas vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» больше не будет предлагаться, пока вы не наберёте его дважды."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 将不再被建议，除非您再次输入两次。"
          }
        }
      }
    },
