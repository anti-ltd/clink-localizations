    "Keys grow and drift toward where you actually land.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutels groei en dryf na waar jy eintlik land."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasten wachsen und wandern dorthin, wo du wirklich landest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas crecen y se desplazan hacia donde caen tus dedos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvid kasvavad ja triivivad sinna, kuhu sa tegelikult maandud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches s’agrandissent et se déplacent là où tu appuies vraiment."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk megnőnek, és arra vándorolnak, ahová valójában esel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti si ingrandiscono e si spostano dove atterri davvero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーが大きくなり、実際に触れている位置へ寄っていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 커지면서 실제로 누르는 자리 쪽으로 옮겨 갑니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci membesar dan beralih ke tempat ketikan anda benar-benar mendarat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas crescem e deslocam-se para onde de facto tocas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши растут и сдвигаются туда, куда вы на самом деле попадаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键会变大，并朝你真正落指的位置偏移。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheile cresc și se îndreaptă spre locul în care aterizați de fapt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutels groeien en drijven naar de plek waar je daadwerkelijk landt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵會變大，並朝你真正落指的位置偏移。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucze rosną i dryfują w kierunku miejsca, w którym faktycznie wylądujesz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключі ростуть і дрейфують до місця, де ви справді приземляєтеся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarlar büyür ve indiğiniz yere doğru sürüklenir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíče rostou a snášejí se směrem k místu, kde skutečně přistanete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kľúče rastú a unášajú sa smerom k miestu, kde skutočne pristanete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κλειδιά μεγαλώνουν και παρασύρονται προς το μέρος όπου προσγειώνεστε πραγματικά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nycklar växer och driver mot där du faktiskt landar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøgler vokser og driver mod det sted, hvor du rent faktisk lander."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøkler vokser og driver mot der du faktisk lander."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaimet kasvavat ja ajautuvat kohti minne todellisuudessa laskeudut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci tumbuh dan melayang menuju tempat Anda sebenarnya mendarat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chìa khóa phát triển và trôi về phía nơi bạn thực sự hạ cánh."
          }
        }
      }
    },
    "Keys grow and shrink, but their sides stay upright.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasten wachsen und schrumpfen, aber ihre Seiten bleiben senkrecht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas crecen y encogen, pero sus lados siguen rectos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvid kasvavad ja kahanevad, kuid nende küljed jäävad püstiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches grandissent et rétrécissent, mais leurs côtés restent droits."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk nőnek és zsugorodnak, de az oldaluk függőleges marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti si allargano e si restringono, ma i lati restano dritti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーは大きくも小さくもなりますが、側面はまっすぐのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 커지고 작아지지만 옆면은 반듯하게 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci membesar dan mengecil, tetapi sisinya kekal tegak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas crescem e encolhem, mas os lados continuam retos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши растут и сжимаются, но их стороны остаются вертикальными."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键会变大变小，但侧边保持竖直。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheile cresc și se micșorează, dar părțile lor rămân drepte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutels groeien en krimpen, maar hun zijkanten blijven rechtop staan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵會變大變小，但側邊保持豎直。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutels vergroot en verklein, maar hul sye bly regop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucze rosną i kurczą się, ale ich boki pozostają pionowe."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключі ростуть і зменшуються, але їхні сторони залишаються вертикальними."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarlar büyüyüp küçülüyor ama yanları dik kalıyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíče rostou a zmenšují se, ale jejich strany zůstávají vzpřímené."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kľúče rastú a zmenšujú sa, ale ich strany zostávajú vzpriamené."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κλειδιά μεγαλώνουν και συρρικνώνονται, αλλά τα πλευρά τους παραμένουν όρθια."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nycklar växer och krymper, men deras sidor förblir upprätt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøgler vokser og krymper, men deres sider forbliver oprejst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøkler vokser og krymper, men sidene holder seg oppreist."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäimet kasvavat ja kutistuvat, mutta niiden sivut pysyvät pystyssä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci tumbuh dan menyusut, tetapi sisi-sisinya tetap tegak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím phát triển và co lại, nhưng các cạnh của chúng vẫn đứng thẳng."
          }
        }
      }
    },
    "Keys light up at once, with no spring.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasten leuchten sofort auf, ohne Federung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas se iluminan al instante, sin muelle."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvid süttivad kohe, ilma vedruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches s’allument aussitôt, sans ressort."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk azonnal felvillannak, rugózás nélkül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti si illuminano subito, senza molla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーがすぐに点灯し、スプリングはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 스프링 없이 바로 켜져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci menyala serta-merta, tanpa pegas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas acendem de imediato, sem mola."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши подсвечиваются сразу, без пружины."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键立即亮起，没有弹簧效果。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastele se aprind imediat, fără arc."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toetsen lichten meteen op, zonder veer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵立即亮起，沒有彈簧效果。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutels lig onmiddellik op, sonder 'n veereffek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisze świecą od razu, bez sprężyny."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіші світяться відразу, без пружини."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşlar yay olmadan aynı anda yanar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesy se rozsvítí najednou, bez pružiny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesy sa rozsvietia naraz, bez pružiny."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πλήκτρα ανάβουν αμέσως, χωρίς ελατήριο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangenterna lyser på en gång, utan fjäder."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasterne lyser med det samme, uden fjeder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Taster lyser med en gang, uten fjær."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaimet syttyvät heti ilman jousta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol langsung menyala, tanpa pegas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím sáng lên ngay lập tức, không có lò xo."
          }
        }
      }
    },
    "Keys light up the moment you touch them, with no spring. Speed and Bounce then rest.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasten leuchten sofort bei Berührung auf, ohne Federung. Tempo und Federn ruhen dann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas se iluminan en cuanto las tocas, sin muelle. Velocidad y Rebote quedan en pausa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klahvid süttivad puudutamise hetkel, ilma vedruta. Kiirus ja põrge jäävad siis puhkama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches s’allument dès que vous les touchez, sans ressort. Vitesse et Rebond sont alors au repos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk érintésre azonnal felvillannak, rugózás nélkül. A Sebesség és a Pattogás ilyenkor pihen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti si illuminano appena li tocchi, senza molla. Velocità e Rimbalzo restano a riposo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーは触れた瞬間に点灯し、スプリングはありません。スピードとバウンスは使われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누르는 즉시 스프링 없이 켜집니다. 속도와 바운스는 쉬게 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci menyala sebaik disentuh, tanpa pegas. Kelajuan dan Lantunan kemudian berehat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas acendem no instante em que as tocas, sem mola. Velocidade e Ressalto ficam em pausa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши подсвечиваются в момент касания, без пружины. Скорость и отскок при этом не действуют."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键一经触碰立即亮起，不带弹簧效果。此时速度与弹跳不起作用。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastele se aprind în momentul în care le atingeți, fără arc. Speed ​​și Bounce apoi odihnește-te."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toetsen lichten op zodra je ze aanraakt, zonder veer. Snelheid en stuiteren en dan rusten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵一經觸碰立即亮起，不帶彈簧效果。此時速度與彈跳不起作用。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutels lig op sodra jy daaraan raak, sonder 'n veereffek. Spoed en terugspring-effek word dan nie toegepas nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisze świecą w momencie ich dotknięcia, bez sprężyny. Szybkość i odbicie, a następnie odpoczynek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіші підсвічуються, коли ви до них торкаєтеся, без пружини. Швидкість і відскок, потім відпочинок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşlar yaysız olarak dokunduğunuz anda aydınlanır. Hız ve Sıçrama ardından dinlenin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesy se rozsvítí, jakmile se jich dotknete, bez pružiny. Speed ​​and Bounce pak odpočívejte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesy sa rozsvietia v okamihu, keď sa ich dotknete, bez pružiny. Speed ​​and Bounce potom odpočívajte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πλήκτρα ανάβουν τη στιγμή που τα αγγίζετε, χωρίς ελατήριο. Ταχύτητα και αναπήδηση και μετά ξεκουραστείτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangenterna lyser upp när du rör dem, utan fjäder. Speed ​​and Bounce vila sedan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Taster lyser i det øjeblik, du rører ved dem, uden fjeder. Hastighed og Bounce og derefter hvile."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Taster lyser opp i det øyeblikket du berører dem, uten fjær. Hastighet og sprett og hvile."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäimet syttyvät heti, kun kosketat niitä, ilman jousta. Nopeus ja Bounce sitten lepää."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol menyala saat Anda menyentuhnya, tanpa pegas. Kecepatan dan Pantulan lalu istirahat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím sẽ sáng lên ngay khi bạn chạm vào mà không cần lò xo. Tăng tốc và Bounce sau đó nghỉ ngơi."
          }
        }
      }
    },
