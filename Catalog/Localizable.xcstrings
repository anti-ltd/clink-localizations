    "Time between each deletion when rapid-delete starts. Higher is slower.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyd tussen elke uitvee wanneer vinnige uitvee begin. Hoër is stadiger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit zwischen den einzelnen Löschungen, wenn das Schnelllöschen anläuft. Höher heißt langsamer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo entre cada borrado cuando empieza el borrado rápido. Cuanto más alto, más lento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aeg iga kustutuse vahel, kui kiirkustutamine algab. Kõrgem on aeglasem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai entre chaque suppression quand la suppression rapide démarre. Plus c'est élevé, plus c'est lent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyi idő teljen el a törlések között, ha beindul a gyorstörlés. Nagyobb érték lassabb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo tra un'eliminazione e l'altra quando parte la cancellazione rapida. Più alto, più lento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高速削除が始まってからの、1文字ずつ消す間隔です。大きいほどゆっくりになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 삭제가 시작된 뒤 삭제 사이의 간격이에요. 높을수록 느려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa antara setiap padaman apabila padam pantas bermula. Lebih tinggi, lebih perlahan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo entre cada apagamento quando o apagar rápido começa. Mais alto é mais lento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Промежуток между удалениями при быстром удалении. Больше — медленнее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速删除开始后，每次删除之间的间隔。值越大越慢。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Timp între fiecare ștergere când începe ștergerea rapidă. Mai mare este mai lent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd tussen elke verwijdering wanneer snel verwijderen start. Hoger is langzamer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速刪除開始後，每次刪除之間的間隔。值越大越慢。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas między każdym usunięciem, a rozpoczęciem szybkiego usuwania. Wyższa jest wolniejsza."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час між кожним видаленням, коли починається швидке видалення. Що вище, то повільніше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı silme başladığında her silme işlemi arasındaki süre. Daha yüksek daha yavaştır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čas mezi každým mazáním, kdy se spustí rychlé mazání. Vyšší je pomalejší."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čas medzi každým vymazaním, keď sa spustí rýchle vymazanie. Vyššie je pomalšie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρόνος μεταξύ κάθε διαγραφής όταν ξεκινά η ταχεία διαγραφή. Το υψηλότερο είναι πιο αργό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tid mellan varje radering när snabbradering startar. Högre är långsammare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tid mellem hver sletning, når hurtig sletning starter. Højere er langsommere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tid mellom hver sletting når hurtigsletting starter. Høyere er tregere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunkin poiston välinen aika, kun nopea poisto alkaa. Korkeampi on hitaampaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu antara setiap penghapusan saat penghapusan cepat dimulai. Lebih tinggi lebih lambat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian giữa mỗi lần xóa khi quá trình xóa nhanh bắt đầu. Cao hơn là chậm hơn."
          }
        }
      }
    },
