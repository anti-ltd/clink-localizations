    "Restores the default pack and volume. Your custom packs stay.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel die verstekpakket en -volume. Jou pasgemaakte pakke bly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt das Standardpaket und die Lautstärke wieder her. Deine eigenen Pakete bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece el paquete y el volumen predeterminados. Tus paquetes personalizados se conservan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taastab vaikimisi paki ja helitugevuse. Sinu kohandatud pakid jäävad alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit le pack et le volume par défaut. Tes packs personnalisés sont conservés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítja az alapértelmezett csomagot és hangerőt. Az egyedi csomagjaid megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina il pacchetto e il volume predefiniti. I tuoi pacchetti personalizzati restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトのパックと音量に戻します。カスタムパックはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 팩과 볼륨으로 되돌립니다. 사용자 팩은 그대로 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulihkan pek dan kelantangan lalai. Pek tersuai anda kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura o pacote e o volume predefinidos. Os seus pacotes personalizados permanecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает стандартный пакет и громкость. Ваши собственные пакеты остаются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复默认音效包和音量。您的自定义音效包会保留。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restabilește pachetul și volumul implicit. Pachetele tale personalizate rămân."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelt het standaardpakket en volume. Je aangepaste pakketten blijven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復預設音效包和音量。您的自定義音效包會保留。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca domyślny pakiet i wolumin. Twoje niestandardowe pakiety pozostają."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлює стандартний пакет і том. Ваші спеціальні пакети залишаються."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan paketi ve birimi geri yükler. Özel paketleriniz kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoví výchozí balíček a svazek. Vaše vlastní balíčky zůstanou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoví predvolený balík a zväzok. Vaše vlastné balíčky zostávajú."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφέρει το προεπιλεγμένο πακέτο και τον όγκο. Τα προσαρμοσμένα πακέτα σας παραμένουν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställer standardpaketet och -volymen. Dina anpassade paket stannar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendanner standardpakken og volumen. Dine brugerdefinerede pakker bliver."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenoppretter standard pakke og volum. Dine tilpassede pakker blir værende."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palauttaa oletuspaketin ja äänenvoimakkuuden. Mukautetut paketit säilyvät."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengembalikan paket dan volume default. Paket khusus Anda tetap ada."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục gói và âm lượng mặc định. Gói tùy chỉnh của bạn ở lại."
          }
        }
      }
    },
    "Restores the default pack, volume and tuning. Your custom packs stay.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece el paquete, el volumen y el sonido predeterminados. Conserva tus paquetes personalizados."
          }
        },
        "fr": {
