    "What sits behind the keys, still or moving": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wat sit agter die sleutels, stil of beweeg"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was hinter den Tasten liegt — ruhig oder in Bewegung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que hay detrás de las teclas, quieto o en movimiento"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis asub klahvide taga, paigal või liikvel"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu'il y a derrière les touches, fixe ou animé"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ami a billentyűk mögött van — állóban vagy mozgásban"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa c'è dietro i tasti, fermo o in movimento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの後ろにあるもの。静止も、動きも"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 뒤에 있는 것, 멈춰 있거나 움직이거나"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang ada di belakang kekunci, diam atau bergerak"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que está por trás das teclas, parado ou em movimento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что стоит за клавишами — неподвижное или движущееся"
