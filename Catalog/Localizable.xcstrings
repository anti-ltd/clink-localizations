    "No samples yet. Type on the real keyboard and come back.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen monsters nie. Tik op die regte sleutelbord en kom terug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Beispiele. Tippe auf der echten Tastatur und komm wieder vorbei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay muestras. Escribe en el teclado real y vuelve luego."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Näidiseid veel pole. Tipi päris klaviatuuril ja tule tagasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'échantillons. Tape sur le vrai clavier et reviens."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs minta. Gépelj a valódi billentyűzeten, aztán gyere vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun campione. Scrivi sulla tastiera vera e torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだサンプルがありません。実際のキーボードで入力してから戻ってきてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 샘플이 없어요. 실제 키보드로 입력해보고 다시 오세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada sampel. Taip pada papan kekunci sebenar dan kembali semula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem amostras. Escreve no teclado real e volta depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Образцов пока нет. Попечатайте на настоящей клавиатуре и возвращайтесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有样本，先用实际键盘打几下字，再回来看看。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există mostre. Tastați pe tastatura reală și reveniți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen monsters. Typ op het echte toetsenbord en kom terug."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有樣本，先用實際鍵盤打幾下字，再回來看看。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze próbek. Wpisz na prawdziwej klawiaturze i wróć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зразків ще немає. Наберіть на справжній клавіатурі та поверніться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz numune yok. Gerçek klavyede yazın ve geri gelin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné vzorky. Napište na skutečné klávesnici a vraťte se."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ žiadne vzorky. Napíšte na skutočnej klávesnici a vráťte sa."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ακόμη δείγματα. Πληκτρολογήστε στο πραγματικό πληκτρολόγιο και επιστρέψτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga prover ännu. Skriv på det riktiga tangentbordet och kom tillbaka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen prøver endnu. Skriv på det rigtige tastatur og kom tilbage."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen prøver ennå. Skriv på det ekte tastaturet og kom tilbake."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei näytteitä vielä. Kirjoita oikealla näppäimistöllä ja tule takaisin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada sampel. Ketik pada keyboard asli dan kembali."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có mẫu nào. Gõ trên bàn phím thật và quay lại."
          }
        }
      }
    },
