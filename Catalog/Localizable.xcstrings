          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyit pattog a rugó. Az alacsonyabb többet pattog, az 1.0 szépen elül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
