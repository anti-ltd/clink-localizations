    "Undo key left of space, Redo key right of space": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ontdoen sleutel links van spasie, Herhaal sleutel regs van spasie"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rückgängig-Taste links, Wiederholen-Taste rechts von der Leertaste"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecla Deshacer a la izquierda y Rehacer a la derecha de la barra espaciadora"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagasivõtu klahv tühikust vasakul, uuestitegemise klahv paremal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Annuler à gauche de la barre d'espace, touche Rétablir à droite"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszavonás gomb a szóköz bal, Újra gomb a jobb oldalán"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasto Annulla a sinistra e Ripristina a destra della barra spaziatrice"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースバーの左に取り消しキー、右にやり直しキー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스바 왼쪽에 실행 취소 키, 오른쪽에 다시 실행 키"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci Buat asal di kiri, kekunci Buat semula di kanan bar ruang"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecla Desfazer à esquerda e Refazer à direita da barra de espaços"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиша отмены слева от пробела, клавиша возврата — справа"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销键在空格键左侧，重做键在右侧"
          }
        }
      }
    },
