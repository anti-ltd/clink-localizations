            "value": "Upłynął limit czasu żądania. Spróbuj ponownie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час очікування запиту минув. Спробуйте знову."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstek zaman aşımına uğradı. Tekrar deneyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Časový limit požadavku vypršel. Zkuste to znovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Časový limit žiadosti vypršal. Skúste to znova."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το χρονικό όριο του αιτήματος έληξε. Προσπαθήστε ξανά."
          }
        },
        "sv": {
