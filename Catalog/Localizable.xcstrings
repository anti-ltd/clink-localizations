    "Written on your phone from the answers below. It can get things wrong, so the pages it used are the ones to trust.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geskryf op jou foon vanaf die antwoorde hieronder. Dit kan dinge verkeerd maak, so die bladsye wat dit gebruik het, is diegene om te vertrou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem Gerät aus den Antworten unten geschrieben. Es kann danebenliegen, verlässlich sind die Seiten, aus denen es stammt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrito en tu teléfono a partir de las respuestas de abajo. Puede equivocarse, así que lo fiable son las páginas que ha usado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjutatud sinu telefonis alltoodud vastustest. Ta võib eksida, seega usaldusväärsed on lehed, millest ta pärineb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit sur ton téléphone à partir des réponses ci-dessous. Il peut se tromper, ce sont les pages utilisées qui font foi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telefonodon készült az alábbi válaszokból. Tévedhet is, ezért a felhasznált oldalak a mérvadóak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scritto sul tuo telefono a partire dalle risposte qui sotto. Può sbagliare, quindi a fare fede sono le pagine che ha usato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下に挙げた回答をもとに、端末内で書かれた文章です。間違えることもあるので、確かなのは参照元のページのほうです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 답변들을 바탕으로 기기 안에서 작성된 글입니다. 틀릴 수도 있으니 믿을 것은 참고한 페이지 쪽입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditulis dalam telefon anda daripada jawapan di bawah. Ia boleh tersilap, jadi halaman yang digunakannya itulah yang boleh dipercayai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrito no teu telemóvel a partir das respostas abaixo. Pode enganar-se, por isso as páginas que usou é que são de confiança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Составлено на вашем телефоне по ответам ниже. Здесь бывают ошибки, поэтому доверять стоит страницам, на которые оно опиралось."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段话是依据下面这些答案、在你手机上生成的。它可能出错，真正可靠的是它引用的那几页。"
          }
        }
      }
    },
