    "Read and replace clipboard contents. Requires Full Access.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee y reemplaza el contenido del portapapeles. Requiere acceso total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit et remplace le contenu du presse-papiers. Nécessite l’accès complet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest und ersetzt den Inhalt der Zwischenablage. Benötigt vollen Zugriff."
          }
        },
        "it": {
          "stringUnit": {
