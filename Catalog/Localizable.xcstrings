    "Distance you drag to delete each additional word. Lower deletes words faster.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afstand wat jy sleep om elke bykomende woord uit te vee. Laer verwyder woorde vinniger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit du ziehst, um jedes weitere Wort zu löschen. Kürzer löscht die Wörter schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La distancia que arrastras para borrar cada palabra de más. Cuanto más baja, más rápido las borras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahemaa, mida lohistad iga lisasõna kustutamiseks. Väiksem väärtus kustutab sõnu kiiremini."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance à glisser pour supprimer chaque mot en plus. Plus c'est bas, plus les mots partent vite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyit kell húznod minden további szó törléséhez. Kisebb érték gyorsabban töröl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto devi trascinare per eliminare ogni parola in più. Più basso, più veloce cancelli le parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語を1つ多く削除するのにドラッグする距離です。短くするほど速く削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어를 하나 더 지울 때 드래그하는 거리예요. 짧을수록 단어가 더 빨리 지워져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jarak seret untuk padam setiap perkataan tambahan. Lebih rendah, lebih laju padam perkataan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Distância que arrastas para apagar cada palavra a mais. Mais baixo, apaga as palavras mais depressa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расстояние, которое нужно провести, чтобы удалить очередное слово. Меньше — слова удаляются быстрее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每多删一个词你要拖的距离。数值越小删得越快。"
          }
        }
      }
    },
