          "stringUnit": {
            "state": "translated",
            "value": "ツールが名前付きのチップになってバーを占めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구가 이름이 붙은 칩으로 바를 채워요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alatan mengambil alih bar sebagai cip berlabel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
