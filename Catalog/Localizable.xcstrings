        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia vyplní klávesnicu za klávesmi a prepíše prechod."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια φωτογραφία γεμίζει το πληκτρολόγιο πίσω από τα πλήκτρα και παρακάμπτει τη διαβάθμιση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett foto fyller tangentbordet bakom tangenterna och åsidosätter övertoningen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et foto fylder tastaturet bag tasterne og tilsidesætter gradienten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et bilde fyller tastaturet bak tastene og overstyrer gradienten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valokuva täyttää näppäimistön näppäinten takana ja ohittaa gradientin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah foto memenuhi keyboard di belakang tombol dan mengesampingkan gradien."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một bức ảnh lấp đầy bàn phím phía sau các phím và ghi đè dải màu."
          }
        }
      }
    },
    "A plugin hooks into typing and can drive the keyboard's own controls. Install one from a repository, or write your own in Python.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Plugin klinkt sich ins Tippen ein und kann die Bedienelemente der Tastatur selbst steuern. Installiere eines aus einem Repository oder schreibe dein eigenes in Python."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un plugin se engancha a la escritura y puede controlar los propios controles del teclado. Instala uno desde un repositorio o escribe el tuyo en Python."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pistikprogramm haakub tippimisse ja saab juhtida klaviatuuri enda juhtelemente. Paigalda üks hoidlast või kirjuta oma Pythonis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un plugin se branche sur la frappe et peut piloter les propres commandes du clavier. Installez-en un depuis un dépôt, ou écrivez le vôtre en Python."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bővítmény a gépelésbe kapcsolódik, és a billentyűzet saját vezérlőit is irányíthatja. Telepíts egyet egy tárolóból, vagy írd meg a sajátodat Pythonban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un plugin si aggancia alla digitazione e può guidare i controlli della tastiera stessa. Installane uno da un repository, o scrivi il tuo in Python."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインは入力に割り込み、キーボード自身のコントロールを動かせます。リポジトリからインストールするか、Python で自分で書きましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인은 입력에 끼어들어 키보드 자체의 컨트롤을 움직일 수 있습니다. 저장소에서 설치하거나 Python으로 직접 만들어 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugin bersambung ke penaipan dan boleh mengawal kawalan papan kekunci itu sendiri. Pasang satu daripada repositori, atau tulis sendiri dalam Python."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um plugin liga-se à escrita e pode conduzir os próprios controlos do teclado. Instale um a partir de um repositório, ou escreva o seu em Python."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плагин встраивается в набор текста и может управлять собственными элементами клавиатуры. Установите его из репозитория или напишите свой на Python."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插件挂入输入过程，还能驱动键盘自身的控件。从仓库安装一个，或者用 Python 自己写一个。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un plugin se conectează la tastare și poate conduce propriile comenzi ale tastaturii. Instalați unul dintr-un depozit sau scrieți-l pe al dvs. în Python."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een plug-in haakt in op typen en kan de eigen bedieningselementen van het toetsenbord aansturen. Installeer er een vanuit een repository, of schrijf er zelf een in Python."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外掛掛入輸入過程，還能驅動鍵盤自身的控制元件。從倉庫安裝一個，或者用 Python 自己寫一個。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "‘n Inprop koppel aan tikwerk en kan die sleutelbord se eie beheer hê. Installeer een vanaf ’n bewaarplek, of skryf jou eie in Python."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wtyczka umożliwia pisanie i umożliwia sterowanie własnymi elementami sterującymi klawiatury. Zainstaluj jeden z repozytorium lub napisz własny w Pythonie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плагін підключається до введення тексту та може керувати власними елементами керування клавіатури. Встановіть його зі сховища або напишіть власний на Python."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir eklenti yazmaya bağlanır ve klavyenin kendi kontrollerini çalıştırabilir. Bir depodan bir tane yükleyin veya Python'da kendinizinkini yazın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugin se zapojí do psaní a může ovládat vlastní ovládací prvky klávesnice. Nainstalujte si jeden z úložiště nebo si napište vlastní v Pythonu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Doplnok sa zapája do písania a môže ovládať vlastné ovládacie prvky klávesnice. Nainštalujte si jeden z úložiska alebo si napíšte svoj vlastný v Pythone."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα πρόσθετο συνδέεται με την πληκτρολόγηση και μπορεί να οδηγήσει τα χειριστήρια του πληκτρολογίου. Εγκαταστήστε ένα από ένα αποθετήριο ή γράψτε το δικό σας στην Python."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En plugin ansluter till att skriva och kan styra tangentbordets egna kontroller. Installera en från ett arkiv, eller skriv din egen i Python."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et plugin tilsluttes til at skrive og kan styre tastaturets egne kontroller. Installer en fra et lager, eller skriv din egen i Python."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En plugin kobles til skriving og kan drive tastaturets egne kontroller. Installer en fra et depot, eller skriv din egen i Python."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugin kytkeytyy kirjoittamiseen ja voi ohjata näppäimistön omia säätimiä. Asenna sellainen arkistosta tai kirjoita omasi Pythonissa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah plugin terhubung dengan pengetikan dan dapat menggerakkan kontrol keyboard itu sendiri. Instal satu dari repositori, atau tulis sendiri dengan Python."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một plugin liên quan đến việc gõ và có thể điều khiển các điều khiển của bàn phím. Cài đặt một cái từ kho lưu trữ hoặc viết cái của riêng bạn bằng Python."
          }
        }
      }
    },
