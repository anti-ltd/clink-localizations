          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tvätt av färg över varje keps, som en tänd knappsats."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En vask af farve over hver hætte, som en tændt nøglehætte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En vask av farger over hver hette, som en tent nøkkelhette."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesu väriä jokaisen korkin päällä, kuten valaistu avainsuojus."
