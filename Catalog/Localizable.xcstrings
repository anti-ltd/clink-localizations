            "value": "Cling が Clink による変更を許可していません。Cling でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling이 Clink의 변경을 허용하지 않습니다. Cling에서 켜 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling tidak membenarkan Clink membuat perubahan. Hidupkan dalam Cling."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cling não deixa o Clink fazer alterações. Ative isso no Cling."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling не разрешает Clink вносить изменения. Включите это в Cling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling 不允许 Clink 做修改。请在 Cling 中开启。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling nu lasă Clink să facă modificări. Activați asta în Cling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling laat Clink geen wijzigingen aanbrengen. Zet dat aan in Cling."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling 不允許 Clink 做修改。請在 Cling 中開啟。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling nie pozwala Clink na wprowadzanie zmian. Włącz to w Cling."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling не дозволяє Clink вносити зміни. Увімкніть це в Cling."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling, Clink'in değişiklik yapmasına izin vermiyor. Cling'te bunu açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling nedovoluje Clink provádět změny. Zapněte to v Cling."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling neumožňuje Clink vykonávať zmeny. Zapnite to v Cling."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Cling δεν επιτρέπει στο Clink να κάνει αλλαγές. Ενεργοποιήστε το στο Cling."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling låter inte Clink göra ändringar. Slå på det i Cling."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling lader ikke Clink foretage ændringer. Slå det til i Cling."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling lar ikke Clink gjøre endringer. Slå det på i Cling."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling ei anna Clink:n tehdä muutoksia. Ota se käyttöön Cling:ssä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling tidak membiarkan Clink melakukan perubahan. Aktifkan itu di Cling."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling không cho phép Clink thực hiện thay đổi. Bật tính năng đó trong Cling."
          }
        }
      }
    },
