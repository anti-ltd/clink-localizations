    "Speak to type": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Praat om te tik"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich, um zu tippen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla para escribir"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Räägi, et tipida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parle pour écrire"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beszélj a gépeléshez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla per scrivere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話して入力"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말해서 입력"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cakap untuk menaip"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fala para escrever"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорите — и текст напечатается"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话即可输入"
          }
        }
      }
    },
    "Speak to type. Your words are transcribed on-device and streamed straight into whatever field you're typing in.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Praat om te tik. Jou woorde word op die toestel getranskribeer en reguit gestroom na watter veld jy ook al tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich, um zu tippen. Deine Worte werden auf dem Gerät transkribiert und direkt in das Feld gestreamt, in das du gerade tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla para escribir. Tus palabras se transcriben en el dispositivo y se envían directamente al campo en el que estés escribiendo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Räägi, et tipida. Sinu sõnad transkribeeritakse seadmes ja suunatakse otse välja, kus sa tipid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parle pour écrire. Tes mots sont transcrits sur l'appareil et diffusés directement dans le champ où tu es en train de taper."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beszélj, hogy gépelj helyetted. A szavaidat a készüléken írjuk át, és egyenesen abba a mezőbe küldjük, amibe éppen gépelsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla per scrivere. Le tue parole vengono trascritte sul dispositivo e inviate direttamente nel campo in cui stai scrivendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話すだけで入力できます。あなたの言葉は端末上で文字起こしされ、入力中のフィールドへそのまま流し込まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하면 입력이 돼요. 말한 내용은 기기에서 바로 텍스트로 바뀌어, 지금 입력 중인 필드로 곧장 들어가요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bercakap untuk menaip. Perkataan anda ditranskripsikan pada peranti dan dialirkan terus ke mana-mana medan yang sedang anda taip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fala para escrever. As tuas palavras são transcritas no dispositivo e enviadas diretamente para o campo onde estás a escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорите — и текст напечатается. Ваши слова распознаются на устройстве и сразу идут в то поле, где вы печатаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话就能输入。你说的内容会在本机转成文字，直接送进你正在输入的那个文本框。"
          }
        }
      }
    },
    "Speak to type. Your words are transcribed on-device and streamed straight into whatever field you're typing in. Adds a mic to the panel button.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Praat om te tik. Jou woorde word op die toestel getranskribeer en reguit gestroom na watter veld jy ook al intik. Voeg 'n mikrofoon by die paneelknoppie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich statt zu tippen. Deine Worte werden auf dem Gerät transkribiert und direkt in das Feld eingefügt, in dem du gerade schreibst. Fügt dem Panel-Button ein Mikrofon hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla para escribir. Tus palabras se transcriben en el dispositivo y se insertan directamente en el campo en el que estés escribiendo. Añade un micrófono al botón de paneles."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Räägi, et tipida. Sinu sõnad transkribeeritakse seadmes ja sisestatakse otse välja, kuhu kirjutad. Lisab paneelinupule mikrofoni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parle pour écrire. Tes mots sont transcrits sur l'appareil et insérés directement dans le champ où tu écris. Ajoute un micro au bouton des panneaux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beszélj gépelés helyett. A szavaid az eszközön íródnak át, és egyenesen abba a mezőbe kerülnek, amelybe éppen írsz. Mikrofont ad a panelgombhoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla per scrivere. Le tue parole vengono trascritte sul dispositivo e inserite direttamente nel campo in cui stai scrivendo. Aggiunge un microfono al pulsante dei pannelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話して入力。音声はデバイス上で文字に変換され、入力中のフィールドにそのまま挿入されます。パネルボタンにマイクが追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말로 입력하세요. 음성은 기기에서 텍스트로 변환되어 입력 중인 필드에 바로 들어갑니다. 패널 버튼에 마이크가 추가됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bercakap untuk menaip. Kata-kata anda ditranskripsi pada peranti dan terus dimasukkan ke medan yang sedang anda taip. Menambah mikrofon pada butang panel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fala para escrever. As tuas palavras são transcritas no dispositivo e inseridas diretamente no campo onde estás a escrever. Adiciona um microfone ao botão de painéis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорите — и текст напечатается. Ваши слова распознаются на устройстве и сразу идут в то поле, где вы печатаете. Добавляет микрофон к кнопке панелей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开口即输入。语音在设备上转写为文字，直接输入到你正在输入的文本框中。会在面板按钮上添加麦克风。"
          }
        }
      }
    },
