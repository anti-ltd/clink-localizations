            "state": "translated",
            "value": "Thay thế cách sắp xếp nhãn dán hiện tại."
          }
        }
      }
    },
    "Choose Clink from the keyboard picker. You can switch back at any time.": {
      "comment": "Android-only onboarding copy (Android settings terminology). Translations drafted for the Android port; native-speaker review required before release. Add to clink-index.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies Clink in die sleutelbordkieser. Jy kan enige tyd terugskakel."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte Clink ve výběru klávesnice. Kdykoli můžete přepnout zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg Clink i tastaturvælgeren. Du kan skifte tilbage når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Clink in der Tastaturauswahl aus. Du kannst jederzeit zurückwechseln."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε το Clink από την επιλογή πληκτρολογίου. Μπορείτε να επιστρέψετε ανά πάσα στιγμή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Clink en el selector de teclados. Puedes volver a cambiar cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali klaviatuurivalijast Clink. Saad igal ajal tagasi vahetada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse Clink näppäimistön valitsimesta. Voit vaihtaa takaisin milloin tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis Clink dans le sélecteur de clavier. Tu peux revenir à ton ancien clavier à tout moment."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki a Clinket a billentyűzetválasztóban. Bármikor visszaválthatsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Clink dari pemilih keyboard. Anda dapat beralih kembali kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Clink dal selettore delle tastiere. Puoi tornare indietro quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの選択画面で Clink を選んでください。いつでも元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 선택기에서 Clink를 고르세요. 언제든지 다시 바꿀 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Clink daripada pemilih papan kekunci. Anda boleh tukar semula pada bila-bila masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg Clink i tastaturvelgeren. Du kan bytte tilbake når som helst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies Clink in de toetsenbordkiezer. Je kunt altijd terugschakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz Clink w selektorze klawiatury. W każdej chwili możesz wrócić do poprzedniej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe o Clink no seletor de teclados. Podes voltar a mudar quando quiseres."
