          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üks liugur viib need täiesti ümarast kandiliseni."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een skuifbalk neem hulle van volledig afgerond na vierkantige rande."
          }
        }
      }
    },
    "One steady colour across every key.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un color fijo en todas las teclas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une couleur fixe sur toutes les touches."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine gleichmäßige Farbe auf allen Tasten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un colore fisso su tutti i tasti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cor fixa em todas as teclas."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu warna tetap pada setiap kekunci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen állandó szín minden gombon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのキーを一色で静かに。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有按键同一种稳定颜色。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 키에 한 가지 고정된 색."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üks kindel värv üle kõigi klahvide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один ровный цвет на всех клавишах."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een bestendige kleur oor elke sleutel."
          }
        }
      }
    },
    "One tap recolours the whole keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipp färbt die ganze Tastatur neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque recolorea todo el teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul geste recolore tout le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy koppintás átszínezi az egész billentyűzetet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco ricolora l’intera tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップでキーボード全体の色が変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 탭으로 키보드 전체 색상이 바뀝니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu ketikan mewarnakan semula seluruh papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque recolore o teclado inteiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно нажатие перекрашивает всю клавиатуру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一下即可为整个键盘重新配色。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühe puudutusega värvad ümber kogu klaviatuuri."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een tik herkleur die hele sleutelbord."
          }
        }
      }
    },
    "One tap swaps your whole setup: layout, gestures, feel. Your theme stays put.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipp tauscht deine ganze Einrichtung: Layout, Gesten, Gefühl. Dein Design bleibt, wo es ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque cambia toda tu configuración: distribución, gestos, sensación. Tu tema se queda como está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En un tap, toute ta config change : disposition, gestes, ressenti. Ton thème ne bouge pas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy koppintás az egész beállításodat átváltja: kiosztás, gesztusok, érzés. A témád marad, ahol van."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco cambia tutta la tua configurazione: layout, gesti, feeling. Il tuo tema resta dov'è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップで設定をまるごと切り替え。配列もジェスチャーも打ち心地も。テーマはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 탭하면 배열, 제스처, 타건감까지 설정이 통째로 바뀌어요. 테마는 그대로예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu ketukan menukar seluruh persediaan anda: susun atur, gerak isyarat, rasa. Tema anda kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque troca toda a tua configuração: disposição, gestos, sensação. O teu tema fica onde está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно нажатие меняет всю настройку: раскладку, жесты, ощущения. Тема остаётся прежней."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一下，整套设置随之切换：布局、手势、手感。主题保持不变。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üks puudutus vahetab kogu su seadistuse: paigutuse, žestid, tunnetuse. Sinu teema jääb paigale."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een tik ruil jou hele opstelling om: uitleg, gebare, gevoel. Your theme stays put."
          }
        }
      }
    },
