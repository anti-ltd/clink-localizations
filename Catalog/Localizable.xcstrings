    "Themes you've made yourself. Built-in themes are already everywhere.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los temas que has creado. Los integrados ya están en todos tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les thèmes que tu as créés. Les thèmes intégrés sont déjà sur tous tes appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine selbst erstellten Themes. Integrierte Themes sind bereits auf allen Geräten vorhanden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I temi che hai creato. Quelli integrati sono già su tutti i dispositivi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os temas que criou. Os temas integrados já estão em todos os dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Созданные вами темы. Встроенные темы уже есть на всех устройствах."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema yang anda cipta sendiri. Tema terbina dalam sudah tersedia pada semua peranti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A saját készítésű témáid. A beépített témák már minden eszközön elérhetők."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で作成したテーマです。内蔵テーマはすべてのデバイスに用意されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己创建的主题。内置主题已在所有设备上提供。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 만든 테마입니다. 기본 제공 테마는 모든 기기에 이미 있습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu loodud teemad. Sisseehitatud teemad on juba kõigis seadmetes olemas."
          }
        }
      }
    },
    "Themes, layouts, sounds, and scripts are files on your phone.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Temas, uitlegte, klanke en skrifte is lêers op jou foon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Themes, Layouts, Sounds und Skripte sind Dateien auf deinem Handy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Temas, diseños, sonidos y scripts son archivos en tu teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teemad, paigutused, helid ja skriptid on failid sinu telefonis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes thèmes, dispositions, sons et scripts sont des fichiers sur ton téléphone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A témák, elrendezések, hangok és szkriptek fájlként vannak a telefonodon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Temi, layout, suoni e script sono file sul tuo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ、レイアウト、サウンド、スクリプトは、どれも端末の中のファイルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마, 레이아웃, 소리, 스크립트는 다 휴대폰에 있는 파일이에요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema, susun atur, bunyi dan skrip ialah fail pada telefon anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Temas, layouts, sons e scripts são ficheiros no teu telemóvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Темы, раскладки, звуки и скрипты — это файлы на вашем телефоне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题、布局、声音和脚本都是你手机上的文件。"
          }
        }
      }
    },
