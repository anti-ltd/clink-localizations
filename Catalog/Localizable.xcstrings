        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaie une note enregistrée vers la droite pour l’épingler dans Cling. Nécessite l’accès complet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd jobbra a mentett jegyzetet, hogy rögzítsd a Clingben. Teljes hozzáférés szükséges."
