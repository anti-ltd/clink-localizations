          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI はオンですが、%@ オフラインの候補はこれまでどおり使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI는 켜져 있는데, %@ 오프라인 추천은 평소대로 계속돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
