    "Come back after a couple of days to see your weekly trend.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve dentro de un par de días para ver la tendencia de la semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviens dans quelques jours pour voir ta tendance de la semaine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau in ein paar Tagen wieder vorbei, um deinen Wochentrend zu sehen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna tra un paio di giorni per vedere l'andamento della settimana."
          }
