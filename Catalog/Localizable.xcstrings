    "Replacements stay on this device and override Settings shortcuts that share the same trigger.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervangings bly op hierdie toestel en ignoreer Instellingskortpaaie wat dieselfde sneller deel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzungen bleiben auf diesem Gerät und gehen Einstellungen-Kürzeln mit demselben Auslöser vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sustituciones se quedan en este dispositivo y tienen prioridad sobre los atajos de Ajustes con el mismo disparador."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Asendused jäävad sellesse seadmesse ja alistavad Seadete otseteed, millel on sama päästik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les remplacements restent sur cet appareil et l'emportent sur les raccourcis des Réglages qui partagent le même déclencheur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyettesítések ezen az eszközön maradnak, és felülírják a Beállítások azonos rövidítéseit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sostituzioni restano su questo dispositivo e hanno la precedenza sulle scorciatoie di Impostazioni con lo stesso attivatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置き換えはこの端末に留まり、同じきっかけを持つ「設定」のショートカットより優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대체어는 이 기기에만 저장되고, 같은 단축어를 쓰는 설정 항목보다 우선합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penggantian kekal pada peranti ini dan mengatasi pintasan Tetapan yang menggunakan pencetus sama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As substituições ficam neste dispositivo e prevalecem sobre os atalhos dos Ajustes com o mesmo gatilho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замены остаются на этом устройстве и перебивают системные сокращения с тем же триггером."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换项只保存在这台设备上，与“设置”里同名的快捷方式冲突时以它为准。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înlocuitorii rămân pe acest dispozitiv și anulează comenzile rapide ale Configurărilor care au același declanșator."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervangingen blijven op dit apparaat staan en overschrijven instellingensnelkoppelingen die dezelfde trigger delen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "替換項只儲存在這臺裝置上，與“設定”裡同名的快捷方式衝突時以它為準。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamienniki pozostają na tym urządzeniu i zastępują skróty do Ustawień, które korzystają z tego samego wyzwalacza."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заміни залишаються на цьому пристрої та замінюють ярлики налаштувань, які використовують той самий тригер."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler bu cihazda kalır ve aynı tetikleyiciyi paylaşan Ayarlar kısayollarını geçersiz kılar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Náhrady zůstanou na tomto zařízení a přepíší zkratky Nastavení, které sdílejí stejný spouštěč."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Náhrady zostanú na tomto zariadení a prepíšu skratky nastavení, ktoré zdieľajú rovnaký spúšťač."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αντικαταστάσεις παραμένουν σε αυτήν τη συσκευή και παρακάμπτουν τις συντομεύσεις ρυθμίσεων που μοιράζονται τον ίδιο κανόνα ετικέτας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersättningar stannar på den här enheten och åsidosätter genvägar för inställningar som delar samma utlösare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstatninger forbliver på denne enhed og tilsidesætter genveje til indstillinger, der deler den samme trigger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstatninger forblir på denne enheten og overstyrer snarveier for innstillinger som deler samme utløser."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korvaukset pysyvät tällä laitteella ja ohittavat asetusten pikakuvakkeet, joilla on sama laukaisu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengganti tetap ada di perangkat ini dan mengambil alih pintasan Setelan yang memiliki pemicu yang sama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục thay thế vẫn còn trên thiết bị này và ghi đè các phím tắt Cài đặt có chung trình kích hoạt."
          }
        }
      }
    },
