    "Custom layouts are part of the membership.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasgemaakte uitlegte is deel van die lidmaatskap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzerdefinierte Layouts sind Teil der Mitgliedschaft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los diseños personalizados son parte de la membresía."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohandatud paigutused on osa liikmelisusest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dispositions personnalisées font partie de l'abonnement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyéni elrendezések a tagság részét képezik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I layout personalizzati fanno parte dell'abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムレイアウトはメンバーシップに含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 키보드는 멤버십의 일부입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun atur tersuai adalah sebahagian daripada keahlian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os esquemas personalizados fazem parte da subscrição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свои раскладки — часть членства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义布局属于会员功能。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspectele personalizate fac parte din calitatea de membru."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangepaste lay-outs maken deel uit van het lidmaatschap."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自定義佈局屬於會員功能。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niestandardowe układy są częścią członkostwa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спеціальні макети є частиною членства."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel düzenler üyeliğin bir parçasıdır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastní rozložení jsou součástí členství."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastné rozloženia sú súčasťou členstva."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προσαρμοσμένες διατάξεις αποτελούν μέρος της ιδιότητας μέλους."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassade layouter är en del av medlemskapet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brugerdefinerede layout er en del af medlemskabet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Egendefinerte oppsett er en del av medlemskapet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukautetut ulkoasut ovat osa jäsenyyttä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tata letak khusus adalah bagian dari keanggotaan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bố cục tùy chỉnh là một phần của thành viên."
          }
        }
      }
    },
    "Custom layouts are part of the membership. Subscribe to move keys, add rows and keep the arrangement.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasgemaakte uitlegte is deel van die lidmaatskap. Teken in om sleutels te skuif, rye by te voeg en die rangskikking te behou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzerdefinierte Layouts sind Teil der Mitgliedschaft. Abonniere, um Tasten zu verschieben, Zeilen hinzuzufügen und die Anordnung zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los diseños personalizados son parte de la membresía. Suscríbete para mover teclas, añadir filas y conservar la disposición."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohandatud paigutused on osa liikmelisusest. Telli, et liigutada klahve, lisada ridu ja säilitada paigutus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dispositions personnalisées font partie de l'abonnement. Abonne-toi pour déplacer les touches, ajouter des rangées et garder la disposition."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyéni elrendezések a tagság részét képezik. Iratkozz fel, hogy mozgathasd a billentyűket, sorokat adj hozzá, és megtartsd az elrendezést."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I layout personalizzati fanno parte dell'abbonamento. Abbonati per spostare i tasti, aggiungere righe e conservare la disposizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムレイアウトはメンバーシップに含まれます。サブスクリプションでキーを移動し、行を追加して、配置を維持できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 키보드는 멤버십의 일부입니다. 구독하여 키를 이동하고, 행을 추가하고, 배열을 유지하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun atur tersuai adalah sebahagian daripada keahlian. Langgan untuk menggerakkan kekunci, menambah baris dan mengekalkan susunan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os esquemas personalizados fazem parte da subscrição. Subscreve para mover teclas, adicionar filas e manter a disposição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свои раскладки — часть членства. Оформите подписку, чтобы перемещать клавиши, добавлять ряды и сохранять расстановку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义布局属于会员功能。订阅后即可移动按键、添加行并保留布局。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspectele personalizate fac parte din calitatea de membru. Abonați-vă pentru a muta cheile, adăugați rânduri și păstrați aranjamentul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangepaste lay-outs maken deel uit van het lidmaatschap. Abonneer u om toetsen te verplaatsen, rijen toe te voegen en de indeling te behouden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自定義佈局屬於會員功能。訂閱後即可移動按鍵、新增行並保留佈局。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niestandardowe układy są częścią członkostwa. Zapisz się, aby przenosić klucze, dodawać rzędy i zachować aranżację."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спеціальні макети є частиною членства. Підпишіться, щоб переміщувати ключі, додавати рядки та зберігати розташування."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel düzenler üyeliğin bir parçasıdır. Anahtarları taşımak, satır eklemek ve düzenlemeyi korumak için abone olun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastní rozložení jsou součástí členství. Chcete-li přesunout klíče, přidat řádky a zachovat uspořádání, přihlaste se k odběru."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastné rozloženia sú súčasťou členstva. Ak chcete presúvať klávesy, pridávať riadky a udržiavať usporiadanie, prihláste sa na odber."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προσαρμοσμένες διατάξεις αποτελούν μέρος της ιδιότητας μέλους. Εγγραφείτε για να μετακινήσετε κλειδιά, να προσθέσετε σειρές και να διατηρήσετε τη διάταξη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassade layouter är en del av medlemskapet. Prenumerera för att flytta nycklar, lägga till rader och behålla arrangemanget."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brugerdefinerede layout er en del af medlemskabet. Abonner for at flytte nøgler, tilføje rækker og beholde arrangementet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Egendefinerte oppsett er en del av medlemskapet. Abonner for å flytte nøkler, legge til rader og beholde arrangementet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukautetut ulkoasut ovat osa jäsenyyttä. Tilaa siirtääksesi avaimia, lisätäksesi rivejä ja säilyttääksesi järjestelyn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tata letak khusus adalah bagian dari keanggotaan. Berlangganan untuk memindahkan tombol, menambahkan baris, dan mempertahankan pengaturannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bố cục tùy chỉnh là một phần của thành viên. Đăng ký để di chuyển phím, thêm hàng và giữ nguyên sự sắp xếp."
          }
        }
      }
    },
    "Custom panel": {
      "extractionState": "manual",
      "localizations": {
        "af": {
