    "Lift on the last one. The word lands, with a space after it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb den Finger beim letzten Buchstaben. Das Wort steht da, mit Leerzeichen dahinter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta el dedo en la última. La palabra aparece, con un espacio detrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève le doigt sur la dernière. Le mot s'inscrit, suivi d'une espace."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utolsónál emeld fel. A szó megjelenik, utána szóközzel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solleva sull'ultima. La parola compare, con uno spazio dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の文字で指を離します。単語が入力され、後ろに空白が入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 글자에서 손가락을 떼세요. 단어가 입력되고 뒤에 공백이 붙습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Angkat jari pada huruf terakhir. Perkataan itu muncul, dengan ruang selepasnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta o dedo na última. A palavra aparece, com um espaço a seguir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимите палец на последней. Слово встанет на место, а за ним — пробел."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在最后一个字母上抬起手指。词就写好了，后面还带一个空格。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõsta sõrm viimasel. Sõna maandub, järgneb tühik."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lig op die laaste een. Die woord land, met 'n spasie daarna."
          }
        }
      }
    },
    "Lifts every key off the background.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebt jede Taste vom Hintergrund ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despega las teclas del fondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décolle chaque touche du fond."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden billentyűt elemel a háttértől."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stacca ogni tasto dallo sfondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーが背景から浮き上がって見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 배경 위로 떠 보여요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengangkat setiap kekunci daripada latar belakang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta cada tecla do fundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приподнимает каждую клавишу над фоном."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让每个按键从背景上浮起来。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõstab iga klahvi taustast lahti."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lig elke sleutel van die agtergrond af."
          }
        }
      }
    },
    "Lifts the entire keyboard up from the bottom edge of the keyboard extension.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebt die ganze Tastatur vom unteren Rand der Tastaturerweiterung an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube todo el teclado desde el borde inferior de la extensión de teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulève tout le clavier depuis le bord inférieur de l'extension."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Feljebb emeli az egész billentyűzetet a billentyűzet-kiterjesztés alsó szélétől."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solleva tutta la tastiera dal bordo inferiore dell'estensione tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボード拡張機能の下端から、キーボード全体を持ち上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 확장의 아래 가장자리에서 키보드 전체를 위로 올려 줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Angkat seluruh papan kekunci naik dari tepi bawah sambungan papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta o teclado todo a partir da margem de baixo da extensão de teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимает всю клавиатуру над нижним краем расширения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把整个键盘从键盘扩展的底边往上抬。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõstab terve klaviatuuri klaviatuurilaienduse alumisest servast üles."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lig die hele sleutelbord op vanaf die onderste rand van die sleutelborduitbreiding."
          }
        }
      }
    },
