        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε το Clink μία φορά στα πληκτρολόγια τρίτων και θα προσγειωθεί σε αυτήν τη λίστα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till Clink en gång under Tredjeparts tangentbord och det hamnar i den här listan."
          }
        },
        "da": {
