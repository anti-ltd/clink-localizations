            "state": "translated",
            "value": "Füge eines über Layout, Anordnen, Element zu einem eigenen Layout hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade uno a un diseño personalizado desde Diseño, Organizar, Elemento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa see kohandatud paigutusse jaotisest Paigutus, Korralda, Element."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez-en un à une disposition personnalisée depuis Disposition, Agencer, Élément."
          }
