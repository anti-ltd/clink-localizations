    "Send it over and we can tell what ran the keyboard out of memory.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur dit oor en ons kan sien wat die sleutelbord uit die geheue laat loop het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schick ihn uns, dann sehen wir, was der Tastatur den Speicher weggenommen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíanoslo y podremos ver qué dejó al teclado sin memoria."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saada see meile ja me näeme, mis klaviatuuril mälu otsa laskis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie-le-nous et on pourra voir ce qui a vidé la mémoire du clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Küldd el nekünk, és megnézzük, mi fogyasztotta el a billentyűzet memóriáját."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mandacelo e possiamo capire cosa ha esaurito la memoria della tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送っていただければ、何がキーボードのメモリを使い切ったのか調べられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내주시면 무엇이 키보드의 메모리를 다 써버렸는지 확인할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantar kepada kami dan kami boleh lihat apa yang menghabiskan memori papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia-nos e conseguimos ver o que esgotou a memória do teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пришлите его — и мы поймём, из-за чего клавиатуре не хватило памяти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发给我们，我们就能看出是什么耗尽了键盘的内存。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimiteți-l și putem spune ce a epuizat tastatura din memorie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur het op en we kunnen vertellen waardoor het toetsenbord onvoldoende geheugen heeft."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發給我們，我們就能看出是什麼耗盡了鍵盤的記憶體。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij to, a my będziemy mogli stwierdzić, co spowodowało brak pamięci w klawiaturze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надішліть це, і ми зможемо визначити, чому клавіатурі бракує пам’яті."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onu gönderin ve klavyenin belleğinin dolmasına neyin yol açtığını anlayalım."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošlete to dál a můžeme říct, co způsobilo nedostatek paměti v klávesnici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošlite to ďalej a môžeme povedať, čo spôsobilo nedostatok pamäte klávesnice."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στείλτε το και μπορούμε να πούμε τι εξαντλήθηκε η μνήμη του πληκτρολογίου."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka den över så kan vi se vad som fick tangentbordet ur minne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send det over, og vi kan se, hvad der løb tør for hukommelse på tastaturet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Send den over og vi kan se hva som tok tastaturet tom for minne."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä se, niin voimme selvittää, mistä näppäimistön muisti loppui."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirimkan dan kami dapat mengetahui apa yang membuat keyboard kehabisan memori."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi nó qua và chúng tôi có thể biết điều gì đã khiến bàn phím hết bộ nhớ."
          }
        }
      }
    },
    "Send it to us through Support on clinkkeys.app.": {
      "extractionState": "manual",
