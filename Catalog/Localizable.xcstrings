    "Total width of the bar. The other keys in the row give way.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Totale breedte van die staaf. Die ander sleutels in die ry gee pad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamtbreite des Balkens. Die anderen Tasten in der Zeile weichen aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancho total de la barra. Las otras teclas de la fila ceden espacio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Riba kogulaius. Ülejäänud klahvid reas teevad ruumi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur totale de la barre. Les autres touches de la rangée cèdent la place."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sáv teljes szélessége. A sor többi billentyűje helyet ad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Larghezza totale della barra. Gli altri tasti della riga fanno spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バー全体の幅です。同じ行のほかのキーが場所を譲ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바 전체 너비입니다. 같은 줄의 다른 키가 자리를 내줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar keseluruhan bar. Kekunci lain dalam baris memberi laluan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Largura total da barra. As outras teclas da fila cedem espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общая ширина полосы. Остальные клавиши в ряду уступают место."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整条栏的总宽度。同一行的其他按键会让出空间。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lățimea totală a barei. Celelalte chei din rând cedează."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Totale breedte van de balk. De andere toetsen in de rij wijken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整條欄的總寬度。同一行的其他按鍵會讓出空間。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Całkowita szerokość paska. Pozostałe klucze w rzędzie ustępują."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Загальна ширина планки. Інші клавіші в рядку поступаються."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çubuğun toplam genişliği. Sıradaki diğer anahtarlar yol veriyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celková šířka lišty. Ostatní klávesy v řadě ustupují."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Celková šírka lišty. Ostatné klávesy v rade ustúpia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνολικό πλάτος της ράβδου. Τα άλλα πλήκτρα στη σειρά υποχωρούν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stångens totala bredd. De andra nycklarna i raden ger vika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samlet bredde af stangen. De andre nøgler i rækken giver efter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Total bredde på stangen. De andre nøklene i rekken gir etter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palkin kokonaisleveys. Muut rivin näppäimet antavat periksi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar total batang. Kunci lain di baris itu memberi jalan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng chiều rộng của thanh. Các phím khác trong hàng nhường chỗ."
          }
        }
      }
    },
