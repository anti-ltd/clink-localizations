    "Glows where your taps land, hotter with traffic.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gloei waar jou krane land, warmer met verkeer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leuchtet dort, wo deine Tipper landen, und wird mit mehr Verkehr heißer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ilumina donde caen tus toques y se calienta cuanto más pasan por ahí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Särab seal, kus su vajutused maanduvad, ja läheb liiklusega kuumemaks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’illumine là où tes appuis atterrissent, de plus en plus chaud avec le trafic."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ott világít, ahová a koppintásaid esnek, és minél többször, annál forróbban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si illumina dove atterrano i tuoi tocchi, più caldo dove passi di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップが着地した場所が光り、回数が多いほど熱くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭이 닿는 자리가 빛나고, 많이 눌릴수록 더 뜨거워집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersinar di tempat ketikan anda mendarat, makin panas apabila makin kerap."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina onde os teus toques caem, mais quente quanto mais passa por ali."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светится там, куда попадают нажатия, и тем горячее, чем их больше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你点按的落点处发光，落点越多越热。"
          }
        }
      }
    },
