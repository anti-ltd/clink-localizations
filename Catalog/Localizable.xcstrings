    "On the keyboard, open Clipboard from the tools menu and tap a clip to paste it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Op die sleutelbord, maak Klembord oop vanaf die gereedskapkieslys en tik 'n snit om dit te plak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne auf der Tastatur die Zwischenablage im Tools-Menü und tippe einen Eintrag an, um ihn einzusetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el teclado, abre Portapapeles desde el menú de herramientas y toca un elemento para pegarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuuril ava tööriistade menüüst Lõikelaud ja puuduta klippi, et see kleepida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le clavier, ouvre Presse-papiers depuis le menu des outils et touche un élément pour le coller."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzeten nyisd meg a Vágólapot az eszközök menüből, és koppints egy elemre a beillesztéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulla tastiera, apri Appunti dal menu strumenti e tocca un elemento per incollarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードのツールメニューから「クリップボード」を開き、項目をタップすると貼り付けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드의 도구 메뉴에서 클립보드를 열고 항목을 누르면 붙여넣어집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada papan kekunci, buka Papan keratan dari menu alat dan ketik satu item untuk menampalnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No teclado, abre Área de transferência no menu de ferramentas e toca num item para o colares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На клавиатуре откройте «Буфер обмена» из меню инструментов и нажмите на фрагмент, чтобы вставить его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘上从工具菜单打开“剪贴板”，点一条就粘贴进去。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe tastatură, deschide Clipboard din meniul de instrumente și atinge un clip pentru a-l lipi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Klembord op het toetsenbord in het menu Extra en tik op een fragment om het te plakken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鍵盤上從工具選單開啟“剪貼簿”，點一條就貼上進去。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na klawiaturze otwórz Schowek z menu narzędzi i dotknij klipu, aby go wkleić."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На клавіатурі відкрийте буфер обміну з меню інструментів і торкніться кліпу, щоб вставити його."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyede, araçlar menüsünden Pano'yu açın ve yapıştırmak için bir klibe dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na klávesnici otevřete schránku z nabídky nástrojů a klepnutím na klip jej vložte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na klávesnici otvorte schránku z ponuky nástrojov a klepnutím na klip ho prilepte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο πληκτρολόγιο, ανοίξτε το Πρόχειρο από το μενού εργαλείων και πατήστε ένα κλιπ για να το επικολλήσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På tangentbordet öppnar du Urklipp från verktygsmenyn och trycker på ett klipp för att klistra in det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På tastaturet skal du åbne Udklipsholder fra værktøjsmenuen og trykke på et klip for at indsætte det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På tastaturet åpner du utklippstavlen fra verktøymenyen og trykker på et klipp for å lime det inn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa näppäimistön työkaluvalikosta Leikepöytä ja liitä se napauttamalla leikettä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di keyboard, buka Clipboard dari menu alat dan ketuk klip untuk menempelkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên bàn phím, mở Clipboard từ menu công cụ và nhấn vào một clip để dán."
          }
        }
      }
    },
    "On the keyboard, open it from the tools menu and start talking.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Op die sleutelbord, maak dit oop vanaf die gereedskapkieslys en begin praat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne es auf der Tastatur im Werkzeugmenü und leg los."
          }
