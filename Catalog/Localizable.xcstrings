    "Add a dedicated 🙂 key beside the 123 key. This removes emoji from the panel picker.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg 'n toegewyde 🙂-sleutel langs die 123-sleutel by. Dit verwyder emoji uit die paneelkieser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg eine eigene 🙂-Taste neben die 123-Taste. Damit verschwinden die Emojis aus der Panel-Auswahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una tecla 🙂 propia junto a la tecla 123. Así quitas los emoji del selector del panel."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa eraldi klahv 🙂 123-klahvi kõrvale. See eemaldab emoji paneelivalijast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une touche 🙂 dédiée à côté de la touche 123. Ça retire les emoji du sélecteur du panneau."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegyél egy külön 🙂 billentyűt a 123-as billentyű mellé. Ezzel eltűnik az emoji a panelválasztóból."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un tasto 🙂 accanto al tasto 123. Così le emoji spariscono dal selettore del pannello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "123キーの横に専用の🙂キーを追加します。これで、パネルの絵文字ピッカーから絵文字がなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "123 키 옆에 🙂 키를 따로 넣어요. 그러면 패널 선택기에서 이모지는 빠져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah kekunci 🙂 khas di sebelah kekunci 123. Ini keluarkan emoji daripada pemilih panel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona uma tecla 🙂 dedicada ao lado da tecla 123. Assim os emoji saem do seletor do painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить отдельную клавишу 🙂 рядом с клавишей 123. Эмодзи при этом уйдут из выбора панелей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 123 键旁边加个专门的 🙂 键。这样面板选择器里就没有表情了。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați o cheie 🙂 dedicată lângă tasta 123. Aceasta elimină emoji-ul din selectorul de panouri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een speciale 🙂-sleutel toe naast de 123-sleutel. Hiermee worden emoji uit de paneelkiezer verwijderd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 123 鍵旁邊加個專門的 🙂 鍵。這樣面板選擇器裡就沒有表情了。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj dedykowany klawisz 🙂 obok klawisza 123. Spowoduje to usunięcie emoji z selektora paneli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте спеціальну клавішу 🙂 поруч із клавішею 123. Це видалить емодзі з панелі вибору."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "123 tuşunun yanına özel bir 🙂 tuşu ekleyin. Bu, emojiyi panel seçiciden kaldırır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte vyhrazený klíč 🙂 vedle klíče 123. Tím se odstraní emotikony z výběru panelu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte vyhradený kľúč 🙂 vedľa kľúča 123. Týmto odstránite emotikony z výberu panela."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ένα αποκλειστικό κλειδί 🙂 δίπλα στο κλειδί 123. Αυτό αφαιρεί emoji από το εργαλείο επιλογής πίνακα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en dedikerad 🙂-tangent bredvid 123-tangenten. Detta tar bort emoji från panelväljaren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en dedikeret 🙂-tast ved siden af 123-tasten. Dette fjerner emoji fra panelvælgeren."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en dedikert 🙂-tast ved siden av 123-tasten. Dette fjerner emoji fra panelvelgeren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää oma 🙂-avain 123-näppäimen viereen. Tämä poistaa emojit paneelivalitsimesta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan kunci 🙂 khusus di samping kunci 123. Tindakan ini akan menghapus emoji dari pemilih panel."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm phím 🙂 chuyên dụng bên cạnh phím 123. Thao tác này sẽ xóa biểu tượng cảm xúc khỏi bộ chọn bảng điều khiển."
          }
        }
      }
    },
