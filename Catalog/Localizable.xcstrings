    "Replace %@ with %@": {
      "comment": "VoiceOver label on the Sentence suggestion bar: replaces an earlier word (first) with one of its alternatives (second).",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervang %1$@ met %2$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahradit %1$@ slovem %2$@"
          }
        },
        "da": {
