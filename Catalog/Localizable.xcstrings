    "Common punctuation in one bar. Pick how many fit.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Algemene leestekens in een maat. Kies hoeveel pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übliche Satzzeichen in einem Balken. Wähle, wie viele passen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntuación habitual en una barra. Elige cuántos caben."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavalised kirjavahemärgid ühel ribal. Vali, mitu mahub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponctuation courante sur une barre. Choisissez combien."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyakori írásjelek egy sávban. Állítsd be, hány fér el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punteggiatura comune in una barra. Scegli quante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う句読点のバーです。いくつ並べるか選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 쓰는 구두점 한 줄입니다. 몇 칸인지 고르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda baca biasa dalam satu bar. Pilih berapa yang muat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontuação comum numa barra. Escolhe quantos cabem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Частая пунктуация в одной полосе. Выберите, сколько поместится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常用标点一条栏。自己选能放几个。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Punctuația comună într-o singură bară. Alege câte se potrivesc."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Algemene interpunctie in één maat. Kies hoeveel er passen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "常用標點一條欄。自己選能放幾個。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wspólna interpunkcja w jednym takcie. Wybierz, ile pasuje."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Загальні розділові знаки в одному такті. Виберіть, скільки підходить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir çubukta ortak noktalama işareti. Kaç tanesinin uygun olduğunu seçin."
          }
        },
        "cs": {
