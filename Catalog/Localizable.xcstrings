            "state": "translated",
            "value": "Clink mette maiuscole e punteggiatura da solo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkが勝手に大文字にしたり句読点を入れたりします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink이 알아서 대문자로 바꾸고 문장 부호를 넣어요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink menulis huruf besar dan menambah tanda baca sendiri"
