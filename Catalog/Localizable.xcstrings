    "This request is too long. Shorten it and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud es demasiado larga. Acórtala e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette requête est trop longue. Raccourcis-la et réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anfrage ist zu lang. Kürze sie und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La richiesta è troppo lunga. Accorciala e riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O pedido é demasiado longo. Encurte-o e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос слишком длинный. Сократите его и попробуйте снова."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan ini terlalu panjang. Pendekkannya dan cuba lagi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kérés túl hosszú. Rövidítsd le, és próbáld újra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが長すぎます。短くして、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求过长。请缩短后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 너무 깁니다. 줄인 후 다시 시도하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Päring on liiga pikk. Lühenda seda ja proovi uuesti."
          }
        }
      }
    },
    "This screen works now. Add the keyboard in Settings to talk in other apps too.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hierdie skerm werk nou. Voeg die sleutelbord in Instellings by om ook in ander programme te praat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bildschirm funktioniert schon. Füge die Tastatur in den Einstellungen hinzu, dann kannst du auch in anderen Apps sprechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pantalla ya funciona. Añade el teclado en Ajustes para hablar también en otras apps."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See ekraan töötab juba. Lisa klaviatuur seadetes, et rääkida ka teistes rakendustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet écran fonctionne déjà. Ajoute le clavier dans Réglages pour parler aussi dans les autres apps."
          }
