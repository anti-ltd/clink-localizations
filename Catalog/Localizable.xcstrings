          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink はまだ画面キーボードの一覧にありません。ステップ 1 は 20 秒ほどで終わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
