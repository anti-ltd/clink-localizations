    "Spread is how far the light reaches around the key you press, in key widths.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verspreiding is hoe ver die lig om die sleutel wat jy druk, in sleutelwydtes reik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausbreitung ist, wie weit das Licht um die gedrückte Taste herum reicht – in Tastenbreiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensión es hasta dónde llega la luz alrededor de la tecla que pulsas, en anchos de tecla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulatus näitab, kui kaugele valgus vajutatud klahvi ümber ulatub, klahvilaiustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étendue indique jusqu’où la lumière s’étend autour de la touche appuyée, en largeurs de touche."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) Terjedés azt adja meg, milyen messzire ér a fény a lenyomott billentyű körül, billentyűszélességben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffusione è quanto lontano arriva la luce attorno al tasto che premi, in larghezze di tasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「広がり」は、押したキーの周りに光が届く範囲です（キー幅単位）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘퍼짐’은 누른 키 주변으로 빛이 퍼지는 거리입니다(키 너비 기준)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebaran ialah sejauh mana cahaya mencapai di sekeliling kekunci yang anda tekan, dalam lebar kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcance é a distância que a luz alcança à volta da tecla que carregas, em larguras de tecla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Разброс» — насколько далеко свет расходится вокруг нажатой клавиши, в ширинах клавиши."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「扩散范围」是光在所按按键周围扩散的范围，以按键宽度计。"
          }
        }
      }
    },
