    "Import your own word list under Localization. It’s compiled on the phone and stays there.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer jou eie woordelys in onder Lokalisering. Dit word op die telefoon saamgestel en bly daar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere unter „Lokalisierung“ deine eigene Wortliste. Sie wird auf dem Gerät aufbereitet und bleibt dort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa tu propia lista de palabras en Localización. Se compila en el teléfono y ahí se queda."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Impordi oma sõnaloend jaotises Keeled. See kompileeritakse telefonis ja jääb sinna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe ta propre liste de mots dans Localisation. Elle est compilée sur le téléphone et y reste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Importáld a saját szólistádat a Lokalizáció alatt. A telefonon készül el, és ott is marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa il tuo elenco di parole in Localizzazione. Viene compilato sul telefono e resta lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ローカリゼーション」から自分の単語リストを読み込めます。端末上で変換され、そのまま端末に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현지화 화면에서 직접 만든 단어 목록을 가져올 수 있습니다. 기기에서 변환되고 기기에만 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Import senarai perkataan anda sendiri di Penyetempatan. Ia disusun pada telefon dan kekal di situ."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa a tua própria lista de palavras em Localização. É compilada no telemóvel e fica lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте свой список слов в разделе «Локализации». Он собирается на телефоне и там же остаётся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“本地化”中导入你自己的词表。它会在手机上完成编译并只保留在手机里。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Importați propria listă de cuvinte din Localizare. Este compilat pe telefon și rămâne acolo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeer uw eigen woordenlijst onder Lokalisatie. Het wordt op de telefoon samengesteld en blijft daar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在“本地化”中匯入你自己的詞表。它會在手機上完成編譯並只保留在手機裡。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaimportuj własną listę słów w obszarze Lokalizacja. Jest kompilowany na telefonie i tam pozostaje."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортуйте власний список слів у розділі «Локалізація». Він скомпільований на телефоні та залишається там."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerelleştirme altında kendi kelime listenizi içe aktarın. Telefonda derlenir ve orada kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Importujte svůj vlastní seznam slov v části Lokalizace. Zkompiluje se v telefonu a zůstane tam."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Importujte svoj vlastný zoznam slov v časti Lokalizácia. Zostaví sa v telefóne a zostane tam."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε τη δική σας λίστα λέξεων στην περιοχή Τοπική προσαρμογή. Έχει μεταγλωττιστεί στο τηλέφωνο και παραμένει εκεί."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Importera din egen ordlista under Lokalisering. Den sammanställs på telefonen och stannar där."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer din egen ordliste under Lokalisering. Det er kompileret på telefonen og bliver der."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer din egen ordliste under Lokalisering. Den er kompilert på telefonen og blir værende der."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo oma sanaluettelo Lokalisointi-kohtaan. Se on koottu puhelimeen ja pysyy siellä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor daftar kata Anda sendiri di bawah Lokalisasi. Itu dikompilasi di telepon dan tetap di sana."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập danh sách từ của riêng bạn trong Bản địa hóa. Nó được biên dịch trên điện thoại và ở đó."
          }
        }
      }
    },
