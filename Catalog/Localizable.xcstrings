    "Hold space, tap anywhere with another finger, keep dragging to highlight.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hou spasie, tik enige plek met 'n ander vinger, hou aan sleep om uit te lig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Leertaste, tippe mit einem anderen Finger irgendwo hin, ziehe weiter zum Markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén espacio, toca en cualquier parte con otro dedo, sigue arrastrando para marcar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia tühikut, puuduta teise sõrmega kuskil ja jätka lohistamist, et esiletõsta."
