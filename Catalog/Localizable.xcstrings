            "value": "İmleci hareket ettirmek için sola veya sağa dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím doleva nebo doprava přesunete kurzor."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím doľava alebo doprava presuniete kurzor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε αριστερά ή δεξιά για να μετακινήσετε τον κέρσορα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck till vänster eller höger för att flytta markören."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk til venstre eller højre for at flytte markøren."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk til venstre eller høyre for å flytte markøren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta vasemmalle tai oikealle siirtääksesi kohdistinta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk kiri atau kanan untuk memindahkan kursor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn sang trái hoặc phải để di chuyển con trỏ."
          }
        }
      }
    },
    "Tap one to add it to the layout, and again to take it off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eines, um es dem Layout hinzuzufügen, und erneut, um es zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca uno para añadirlo a la distribución y otra vez para quitarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta, et lisada see paigutusse, ja uuesti, et eemaldada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez-en un pour l’ajouter à la disposition, et à nouveau pour le retirer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egyre a kiosztáshoz adáshoz, és újra az eltávolításhoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccane uno per aggiungerlo al layout e di nuovo per toglierlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップで配列に追加、もう一度タップで外します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하면 배열에 추가되고, 다시 탭하면 빠집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik satu untuk menambahnya pada susun atur, dan sekali lagi untuk membuangnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um para adicioná-lo ao layout e de novo para removê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь, чтобы добавить в раскладку, и ещё раз, чтобы убрать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点即可添加到布局，再点一次即可移除。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți unul pentru al adăuga la aspect și din nou pentru a-l scoate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op één om deze aan de lay-out toe te voegen, en nogmaals om deze te verwijderen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點即可新增到佈局，再點一次即可移除。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een om dit by die uitleg te voeg, en weer om dit te verwyder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij jeden, aby dodać go do układu, i ponownie, aby go usunąć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться одного, щоб додати його до макета, і ще раз, щоб видалити."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzene eklemek için birine dokunun, kaldırmak için tekrar dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na jednu ji přidáte do rozvržení a dalším klepnutím ji odeberete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na jeden ho pridáte do rozloženia a ďalším klepnutím ho odoberiete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ένα για να το προσθέσετε στη διάταξη και ξανά για να το αφαιρέσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en för att lägga till den i layouten och igen för att ta bort den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en for at tilføje den til layoutet og igen for at tage den af."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en for å legge den til i oppsettet, og igjen for å ta den av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta yhtä lisätäksesi sen asetteluun ja uudelleen poistaaksesi sen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk satu untuk menambahkannya ke tata letak, dan ketuk lagi untuk menghapusnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào một cái để thêm nó vào bố cục và nhấn lại để tắt nó."
          }
        }
      }
    },
    "Tap one to adjust it, even when it's hidden under another.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe einen an, um ihn anzupassen, auch wenn er unter einem anderen liegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca uno para ajustarlo, aunque esté debajo de otro."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta ühte, et seda kohandada, isegi kui see on teise all peidus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez-en un pour l’ajuster, même s’il est caché sous un autre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egyre a beállításhoz, akkor is, ha egy másik alatt rejtőzik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccane uno per regolarlo, anche se è nascosto sotto un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のステッカーの下に隠れていても、タップで調整できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 스티커 아래에 가려져 있어도 탭하면 조정할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik satu untuk melaraskannya, walaupun tersembunyi di bawah yang lain."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca num para o ajustar, mesmo que esteja escondido debaixo de outro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь, чтобы настроить, даже если стикер скрыт под другим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按即可调整，即使它被别的贴纸挡住。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți unul pentru al ajusta, chiar și atunci când este ascuns sub altul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een ervan om deze aan te passen, zelfs als deze onder een andere verborgen is."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按即可調整，即使它被別的貼紙擋住。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een om dit aan te pas, selfs al is dit onder 'n ander een versteek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij jeden, aby go dostosować, nawet jeśli jest ukryty pod innym."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться одного, щоб налаштувати його, навіть якщо він прихований під іншим."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir başkasının altında gizlenmiş olsa bile ayarlamak için birine dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na jednu ji upravíte, i když je skrytá pod jinou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na jednu ju upravíte, aj keď je skrytá pod inou."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ένα για να το προσαρμόσετε, ακόμα κι όταν είναι κρυμμένο κάτω από ένα άλλο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en för att justera den, även när den är gömd under en annan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en for at justere den, selv når den er skjult under en anden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en for å justere den, selv når den er skjult under en annen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta yhtä säätääksesi sitä, vaikka se olisi piilotettu toisen alle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk salah satu untuk menyesuaikannya, meskipun tersembunyi di bawah yang lain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào một cái để điều chỉnh nó, ngay cả khi nó bị ẩn dưới cái khác."
          }
        }
      }
    },
    "Tap one to go to it, or put it back on its own.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik een om daarna te gaan, of sit dit op sy eie terug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp auf einen Eintrag, um dorthin zu springen, oder stell ihn einzeln zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca uno para ir hasta él, o devuélvelo a su valor por separado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta ühel, et sinna minna, või pane see üksinda tagasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un élément pour y aller, ou remets-le seul comme avant."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egyre, hogy odaugorj, vagy állítsd vissza külön-külön."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una voce per andarci, oppure ripristinala da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目をタップするとその設定に移動できます。ひとつだけ元に戻すこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 누르면 해당 설정으로 이동하고, 하나만 따로 되돌릴 수도 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik satu untuk pergi ke situ, atau kembalikan ia satu per satu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca num para ir até ele, ou repõe-no sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы перейти к настройке, или верните её по отдельности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按其中一项即可跳转，也可以单独把它还原。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți unul pentru a merge la el sau puneți-l înapoi singur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een ervan om ernaar toe te gaan, of zet deze zelfstandig terug."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按其中一項即可跳轉，也可以單獨把它還原。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij jeden, aby do niego przejść, lub odłóż go samodzielnie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться одного, щоб перейти до нього, або поставте його самостійно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ona gitmek için birine dokunun veya kendi başına geri koyun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na jeden přejdete nebo jej vraťte zpět samostatně."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na jeden prejdete naň alebo ho vložíte späť samostatne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ένα για να μεταβείτε σε αυτό ή τοποθετήστε το ξανά μόνο του."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en för att gå till den, eller ställ tillbaka den på egen hand."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en for at gå til den, eller sæt den tilbage alene."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en for å gå til den, eller sett den tilbake alene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirry siihen napauttamalla tai laita se takaisin itsestään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk salah satu untuk membukanya, atau pasang kembali sendiri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào một cái để đi tới nó hoặc đặt nó trở lại."
          }
        }
      }
    },
    "Tap or drag across keys to paint.": {
      "comment": "Canvas paint-tool instruction. Tap individual keyboard keys or drag across multiple keys to apply the selected color.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Tasten oder streiche über sie, um sie zu färben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap or drag across keys to paint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca las teclas o desliza el dedo sobre ellas para pintarlas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta klahve või lohista sõrmega üle nende, et neid värvida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur les touches ou fais glisser ton doigt dessus pour les colorer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a billentyűkre, vagy húzd végig rajtuk az ujjad a színezéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca i tasti o trascinaci sopra il dito per colorarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーをタップするか、指を滑らせると色を塗れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 탭하거나 키 위로 손가락을 드래그하여 색을 칠하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kekunci atau seret jari merentasinya untuk mewarnakannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca nas teclas ou desliza o dedo sobre elas para as pintar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажимайте на клавиши или проводите по ним пальцем, чтобы покрасить их."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按按键或在按键上拖动手指，即可上色。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți sau trageți peste taste pentru a picta."
          }
        },
        "nl": {
          "stringUnit": {
