          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 번역 메뉴의 언어를 드래그해 순서를 바꾸고, 보지 않을 언어는 꺼 주세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista keeli klaviatuuri Tõlgi menüü järjestuse muutmiseks ja lülita välja need, mida sa seal näha ei taha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте, чтобы изменить порядок языков в меню «Перевод» на клавиатуре, и выключайте те, которые не хотите там видеть."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep om die tale in die sleutelbord se Vertaal-kieslys te herrangskik, en skakel enige wat jy nie daar wil sien nie."
          }
        }
      }
    },
    "Drag to reorder, switch off what you never use. A tab with nothing in it is left out of the keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh sie in die Reihenfolge, die du willst, und schalte aus, was du nie brauchst. Ein leerer Tab taucht auf der Tastatur gar nicht erst auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrástralas para ordenarlas y apaga las que no uses nunca. Una pestaña vacía no aparece en el teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais-les glisser pour les ranger et désactive celles que tu n'utilises jamais. Un onglet vide n'apparaît pas sur le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd őket a kívánt sorrendbe, és kapcsold ki, amit sosem használsz. Az üres fül meg sem jelenik a billentyűzeten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascinale per riordinarle e spegni quelle che non usi mai. Una scheda vuota non compare sulla tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替え、使わないものはオフにできます。中身が空のタブはキーボードには出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끌어서 순서를 바꾸고, 안 쓰는 건 꺼두세요. 비어 있는 탭은 키보드에 나오지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk susun semula, matikan yang anda tak pernah guna. Tab yang kosong tak muncul pada papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta para reordenar e desliga o que nunca usas. Um separador vazio não aparece no teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскиванием задайте порядок и выключите то, чем не пользуетесь. Пустая вкладка на клавиатуру не попадает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动排序，用不上的直接关掉。空的分类不会出现在键盘上。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista järjestamiseks, lülita välja see, mida sa kunagi ei kasuta. Tühi kaart jäetakse klaviatuurilt ära."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep om te herrangskik, skakel af wat jy nooit gebruik nie. 'n Oortjie met niks daarin nie, word uit die sleutelbord gelaat."
          }
        }
      }
    },
    "Drag to resize this key. The rest of the row makes room.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
