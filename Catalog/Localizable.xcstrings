    "Keep copied images out of history. Copied text is still saved.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou gekopieerde beelde uit die geskiedenis. Gekopieerde teks is steeds gestoor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierte Bilder landen nicht im Verlauf. Kopierter Text schon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes copiadas no entran en el historial. El texto copiado sí se guarda."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia kopeeritud pildid ajaloost eemal. Kopeeritud tekst salvestatakse ikka."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images copiées n'entrent pas dans l'historique. Le texte copié, si."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A másolt képek nem kerülnek az előzményekbe. A másolt szöveg igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini copiate non entrano nella cronologia. Il testo copiato sì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーした画像は履歴に残しません。テキストはこれまでどおり保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 이미지는 기록에 남기지 않아요. 복사한 텍스트는 그대로 저장해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imej yang disalin tak masuk sejarah. Teks yang disalin tetap disimpan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens copiadas não entram no histórico. O texto copiado continua a ser guardado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не пускать скопированные изображения в историю. Текст по-прежнему сохраняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制的图片不进历史记录，复制的文字照常保存。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrați imaginile copiate în afara istoricului. Textul copiat este încă salvat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd gekopieerde afbeeldingen uit de geschiedenis. Gekopieerde tekst wordt nog steeds opgeslagen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製的圖片不進歷史記錄，複製的文字照常儲存。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzymaj skopiowane obrazy poza historią. Skopiowany tekst jest nadal zapisywany."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігайте скопійовані зображення подалі від історії. Скопійований текст все ще зберігається."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalanan görselleri geçmişin dışında tutun. Kopyalanan metin hâlâ kayıtlıdır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchovávejte zkopírované snímky mimo historii. Zkopírovaný text je stále uložen."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchovávajte skopírované obrázky mimo histórie. Skopírovaný text sa stále uloží."
          }
        },
        "el": {
          "stringUnit": {
