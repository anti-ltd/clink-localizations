      }
    },
    "One glide can read as several words: a phrase or a whole sentence without touching space.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Geste kann mehrere Wörter ergeben: eine Wendung oder ein ganzer Satz, ohne die Leertaste zu berühren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo trazo puede leerse como varias palabras: una frase o una oración entera sin tocar el espacio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üks libistus võib anda mitu sõna: fraasi või terve lause ilma tühikut puudutamata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul glissé peut donner plusieurs mots : une expression ou une phrase entière sans toucher l’espace."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy húzás több szót is jelenthet: egy kifejezést vagy egy egész mondatot a szóköz érintése nélkül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo scorrimento può diventare più parole: una frase o un’intera proposizione senza toccare lo spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回のスワイプで複数の単語を入力できます。スペースに触れずに句や文全体を書けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 스와이프로 여러 단어를 입력할 수 있습니다. 스페이스를 누르지 않고 구나 문장 전체를 쓸 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu leretan boleh dibaca sebagai beberapa perkataan: frasa atau seluruh ayat tanpa menyentuh ruang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um único deslizar pode virar várias palavras: uma expressão ou uma frase inteira sem tocar no espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один свайп может дать несколько слов: фразу или целое предложение без нажатия пробела."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次滑行可以识别为多个词：不碰空格也能输入短语或整句。"
          }
        }
      }
    },
