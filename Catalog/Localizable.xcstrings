    "Park the light after a pause and wake it on your next keystroke, the way a real board sleeps. Nothing runs while you're not typing.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parkeer die lig na 'n pouse en maak dit wakker met jou volgende toetsaanslag, soos 'n regte bord slaap. Niks loop terwyl jy nie tik nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt das Licht nach einer Pause schlafen und weckt es beim nächsten Anschlag – wie eine echte Tastatur. Solange du nicht tippst, läuft nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparca la luz tras una pausa y la despierta con la siguiente tecla, como duerme un teclado de verdad. No se ejecuta nada mientras no escribes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pargib pärast pausi valguse ja äratab selle järgmisel klahvivajutusel, nagu päris klaviatuur magab. Kui sa ei tipi, ei tööta midagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met la lumière en veille après une pause et la réveille à la prochaine frappe, comme un vrai clavier. Rien ne tourne quand vous n'écrivez pas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy szünet után elalszik a fény, és a következő leütésre felébred, ahogy egy igazi billentyűzet. Amíg nem írsz, semmi nem fut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mette la luce in pausa dopo un momento e la risveglia al tasto successivo, come fa una tastiera vera. Quando non scrivi, non gira nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し止まると光もお休みして、次の打鍵で目を覚まします。入力していない間は何も動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 멈추면 조명도 잠들고, 다음 타이핑에 다시 깨어납니다. 입력하지 않는 동안에는 아무것도 돌지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentikan cahaya selepas seketika dan bangunkannya pada ketukan seterusnya, seperti papan kekunci sebenar tidur. Tiada apa berjalan ketika anda tidak menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adormece a luz após uma pausa e acorda-a na próxima tecla, como um teclado a sério. Nada corre enquanto não escreves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гасите свет после паузы и будите его следующим нажатием — как засыпает настоящая клавиатура. Пока вы не печатаете, ничего не работает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停下一会儿灯光就休眠，下一次按键再唤醒，像真正的键盘一样。不打字时什么都不运行。"
          }
        }
      }
    },
