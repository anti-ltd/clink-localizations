    "Feel one tick when holding space enters cursor mode.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voel een regmerkie wanneer jy spasie hou en wysermodus binnegaan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spüre einen Impuls, wenn Gedrückthalten der Leertaste den Cursormodus aktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siente una vibración al mantener pulsado el espacio y entrar en modo cursor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunneta üht võnget, kui tühiku all hoidmine lülitab sisse kursorirežiimi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ressentez une vibration lorsque maintenir l’espace active le mode curseur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Érezz egy rezdülést, amikor a szóköz nyomva tartása kurzormódba lép."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senti un impulso quando tenendo premuta la barra spaziatrice si attiva la modalità cursore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースバーを長押ししてカーソルモードに入ると、一度振動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 바를 길게 눌러 커서 모드로 들어가면 한 번 진동합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasa satu getaran apabila menahan ruang memasuki mod kursor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sente um toque háptico quando manter a barra de espaço ativa o modo de cursor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почувствуйте один отклик, когда удержание пробела включает режим курсора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按空格键进入光标模式时会感到一次振动。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Simțiți o bifă când mențineți spațiu intră în modul cursor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voel één tik wanneer je de spatiebalk ingedrukt houdt, naar de cursormodus gaat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按空格鍵進入游標模式時會感到一次振動。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczuj jedno kliknięcie, gdy przytrzymanie spacji powoduje przejście do trybu kursora."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відчуйте одну галочку, коли утримуйте пробіл, щоб перейти в режим курсору."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluğu basılı tutarken imleç moduna girdiğinde bir onay işareti hissedin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když podržení mezery přejde do režimu kurzoru, ucítíte jedno zaškrtnutí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocíťte jedno tiknutie, keď podržaním medzery prejdete do režimu kurzora."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Νιώστε ένα τικ όταν κρατάτε το διάστημα εισέρχεται σε λειτουργία δρομέα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Känn en bock när du håller mellanslag och går in i markörläge."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mærk et flueben, når du holder mellemrum og skifter til markørtilstand."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Føl ett hake når du holder mellomrom og går inn i markørmodus."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunne yksi rasti, kun välilyönnin pitäminen siirtyy kohdistintilaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasakan satu centang saat menahan spasi memasuki mode kursor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm thấy một tích tắc khi giữ khoảng trắng vào chế độ con trỏ."
          }
        }
      }
    },
