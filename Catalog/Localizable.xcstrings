{
  "sourceLanguage": "en",
  "strings": {
    "Show this option in the keyboard’s Tools menu.": {
      "comment": "Hint under a keyboard tool visibility switch. Toolbar and Tools menu are separate destinations.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wys hierdie opsie in die sleutelbord se Gereedskap-kieslys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí tuto možnost v nabídce Nástroje klávesnice."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis denne mulighed i tastaturets menu Værktøjer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt diese Option im Werkzeuge-Menü der Tastatur."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση αυτής της επιλογής στο μενού Εργαλεία του πληκτρολογίου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra esta opción en el menú Herramientas del teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva see valik klaviatuuri tööriistamenüüs."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä tämä valinta näppäimistön Työkalut-valikossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche cette option dans le menu Outils du clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lehetőség megjelenítése a billentyűzet Eszközök menüjében."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan opsi ini di menu Alat pada papan ketik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra questa opzione nel menu Strumenti della tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの「ツール」メニューにこの項目を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드의 도구 메뉴에 이 옵션을 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan pilihan ini dalam menu Alat papan kekunci."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis dette alternativet i tastaturets Verktøy-meny."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon deze optie in het menu Gereedschap van het toetsenbord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż tę opcję w menu Narzędzia klawiatury."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra esta opção no menu Ferramentas do teclado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează această opțiune în meniul Instrumente al tastaturii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать этот пункт в меню «Инструменты» клавиатуры."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí túto možnosť v ponuke Nástroje klávesnice."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa det här alternativet i tangentbordets Verktyg-meny."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu seçeneği klavyenin Araçlar menüsünde gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати цей пункт у меню «Інструменти» клавіатури."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị tùy chọn này trong menu Công cụ của bàn phím."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘的“工具”菜单中显示此选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鍵盤的「工具」選單中顯示此選項。"
          }
        }
      }
    },
    "Show a shortcut in the bar above the keys.": {
      "comment": "Hint under a keyboard tool visibility switch. Toolbar and Tools menu are separate destinations.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wys ’n kortpad in die balk bo die sleutels."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí zkratku na liště nad klávesami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis en genvej i linjen over tasterne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt eine Verknüpfung in der Leiste über den Tasten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση συντόμευσης στη γραμμή πάνω από τα πλήκτρα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un acceso directo en la barra sobre las teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva otsetee klahvide kohal oleval ribal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä pikakuvake näppäinten yläpuolella olevassa palkissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un raccourci dans la barre au-dessus des touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Parancsikon megjelenítése a billentyűk feletti sávban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan pintasan di bilah di atas tombol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra una scorciatoia nella barra sopra i tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの上のバーにショートカットを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 위의 막대에 바로가기를 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan pintasan pada bar di atas kekunci."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis en snarvei i linjen over tastene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon een snelkoppeling in de balk boven de toetsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż skrót na pasku nad klawiszami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra um atalho na barra acima das teclas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează o scurtătură în bara de deasupra tastelor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать ярлык на панели над клавишами."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí skratku na lište nad klávesmi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa en genväg i fältet ovanför tangenterna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşların üzerindeki çubukta bir kısayol gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати ярлик на панелі над клавішами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị lối tắt trên thanh phía trên các phím."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在按键上方的工具栏中显示快捷方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在按鍵上方的工具列中顯示捷徑。"
          }
        }
      }
    },
