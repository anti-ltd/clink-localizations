            "value": "Ta frappe"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gépelésed"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua scrittura"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの入力"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나의 입력"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taipan anda"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua escrita"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша печать"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的输入"
          }
        }
      }
    },
    "Your typing stats are computed locally and never leave your phone. Nothing is uploaded, shared, or sold.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou tikstatistieke word plaaslik bereken en verlaat nooit jou foon nie. Niks word opgelaai, gedeel of verkoop nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tippstatistiken werden lokal berechnet und verlassen nie dein iPhone. Nichts wird hochgeladen, geteilt oder verkauft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus estadísticas de escritura se calculan en el dispositivo y nunca salen de tu iPhone. No se sube, comparte ni vende nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu tipimisstatistika arvutatakse lokaalselt ega lahku kunagi sinu telefonist. Midagi ei laadita üles, ei jagata ega müüda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes statistiques de frappe sont calculées sur l'appareil et ne quittent jamais ton iPhone. Rien n'est envoyé, partagé ou vendu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gépelési statisztikák helyben készülnek, és sosem hagyják el az iPhone-odat. Semmit sem töltünk fel, osztunk meg vagy adunk el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le statistiche di scrittura vengono calcolate sul dispositivo e non lasciano mai il tuo iPhone. Nulla viene caricato, condiviso o venduto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力統計はデバイス上で計算され、iPhoneの外に出ることはありません。アップロード、共有、販売は一切行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 통계는 기기에서 계산되며 iPhone 밖으로 나가지 않아요. 업로드하거나 공유하거나 판매하지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik menaip dikira secara setempat dan tidak pernah keluar daripada iPhone anda. Tiada apa-apa dimuat naik, dikongsi atau dijual."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As estatísticas de escrita são calculadas no dispositivo e nunca saem do teu iPhone. Nada é enviado, partilhado ou vendido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша статистика набора вычисляется локально и никогда не покидает телефон. Ничего не загружается, не передаётся и не продаётся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入统计数据在设备本地计算，绝不会离开你的 iPhone。不会上传、共享或出售任何内容。"
          }
        }
      }
    },
    "Your whole setup travels as one file. Save it, share it, bring it back anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou hele opstelling reis as een lêer. Stoor dit, deel dit, bring dit enige plek terug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine ganze Einrichtung reist als eine Datei. Sichern, teilen und überall wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda tu configuración viaja en un solo archivo: guárdala, compártela y recupérala donde quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu terve seadistus reisib ühe failina. Salvesta, jaga ja too kusagil tagasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute ta config tient dans un seul fichier. Enregistre-le, partage-le, restaure-le où tu veux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egész beállításod egyetlen fájlban utazik. Mentsd el, oszd meg, és állítsd vissza bárhol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutta la tua configurazione viaggia in un unico file. Salvalo, condividilo, ripristinalo ovunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定はまるごと1つのファイルに。保存して、共有して、どこでも元どおりにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 전체가 파일 하나로 움직여요. 저장하고, 공유하고, 어디서든 다시 불러오세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh persediaan anda bergerak sebagai satu fail. Simpan, kongsi, dan pulihkan di mana-mana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda a tua configuração viaja num único ficheiro. Guarda-o, partilha-o e recupera-o em qualquer lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вся ваша настройка переезжает одним файлом. Сохраните его, поделитесь им, верните где угодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的整套设置就是一个文件，保存、分享，随处找回。"
          }
        }
      }
    },
    "Your words": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou woorde"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Wörter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus palabras"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu sõnad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes mots"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szavaid"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue parole"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの単語"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 단어"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataan anda"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas palavras"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши слова"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的词语"
          }
        }
      }
    },
    "Your words are merged with your other devices, never replaced, so nothing you've taught one gets lost on another. Encrypted before it leaves, through your own iCloud account.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou woorde word saamgevoeg met jou ander toestelle, nooit vervang nie, so niks wat jy die een geleer het, gaan verlore op 'n ander nie. Geënkripteer voordat dit vertrek, deur jou eie iCloud-rekening."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Wörter werden mit deinen anderen Geräten zusammengeführt, nicht ersetzt – was du einem Gerät beigebracht hast, geht auf einem anderen nicht verloren. Verschlüsselt, bevor sie das Gerät verlassen, und nur über deinen eigenen iCloud-Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus palabras se combinan con las de tus otros dispositivos en lugar de sustituirlas, así que nada de lo que le has enseñado a uno se pierde en otro. Se cifran antes de salir y solo pasan por tu propia cuenta de iCloud."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu sõnad ühendatakse sinu teiste seadmetega, mitte ei asendata, nii et midagi, mida sa ühele õpetasid, ei kao teisel. Krüptitakse enne lahkumist, ainult sinu enda iCloudi konto kaudu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes mots sont fusionnés avec ceux de tes autres appareils, jamais remplacés : ce que tu as appris à l'un ne disparaît pas sur l'autre. Chiffrés avant de partir, et uniquement via ton propre compte iCloud."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szavaid összefésülődnek a többi eszközödével, nem íródnak felül, így semmi nem veszik el abból, amit az egyiknek megtanítottál. Titkosítva hagyják el az eszközt, és csak a saját iCloud-fiókodon mennek át."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue parole vengono unite a quelle degli altri dispositivi, non sostituite: quello che hai insegnato a uno non si perde sull'altro. Cifrate prima di partire e solo tramite il tuo account iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語は他のデバイスのものと統合され、上書きはされません。片方に覚えさせた単語がもう片方で消えることはありません。デバイスを出る前に暗号化され、通るのはあなた自身の iCloud アカウントだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어는 다른 기기의 것과 합쳐지고 덮어쓰지 않아요. 한쪽에서 가르친 단어가 다른 쪽에서 사라지지 않아요. 기기를 떠나기 전에 암호화되고, 본인 iCloud 계정만 거쳐요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataan anda digabungkan dengan peranti lain anda, bukan diganti, jadi apa yang anda ajar pada satu peranti tidak hilang pada yang lain. Disulitkan sebelum keluar, dan hanya melalui akaun iCloud anda sendiri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas palavras são combinadas com as dos outros dispositivos, nunca substituídas, por isso nada do que ensinaste a um se perde noutro. São cifradas antes de sair e passam só pela tua conta iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши слова объединяются с другими устройствами, а не заменяются, поэтому ничего из выученного на одном не теряется на другом. Шифруются перед отправкой и идут через ваш собственный аккаунт iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的词会和其他设备上的合并，而不是被覆盖，所以在一台设备上教过的词不会在另一台上丢失。离开设备前先加密，只经过你自己的 iCloud 账户。"
          }
        }
      }
    },
    "Your words, streak, and speed, measured on device and never uploaded.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou woorde, streep en spoed, gemeet op toestel en nooit opgelaai nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Wörter, Serie und Geschwindigkeit, auf dem Gerät gemessen und nie hochgeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus palabras, racha y velocidad, medidas en el dispositivo y nunca subidas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu sõnad, seeria ja kiirus, mõõdetud seadmes ega laadita kunagi üles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes mots, ta série et ta vitesse, mesurés sur l'appareil et jamais envoyés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szavaid, a sorozatod és a sebességed, a készüléken mérve, feltöltés nélkül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue parole, la serie e la velocità, misurate sul dispositivo e mai caricate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力した単語数、連続日数、速度。すべて端末内で計測し、アップロードはしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어 수, 연속 기록, 속도를 기기 안에서만 재고 어디로도 올리지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataan, rentetan hari dan kelajuan anda, diukur pada peranti dan tidak pernah dimuat naik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas palavras, sequência e velocidade, medidas no dispositivo e nunca enviadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши слова, серия дней и скорость — всё измеряется на устройстве и никуда не загружается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的字数、连续天数和速度，都在设备上统计，从不上传。"
          }
        }
      }
    },
