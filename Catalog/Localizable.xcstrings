    "Custom sounds and haptics need Full Access. The standard click works without it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepasmaakte klanke en haptics benodig volle toegang. Die standaard klik werk daarsonder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Sounds und Haptik brauchen Vollzugriff. Der normale Klick geht auch ohne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sonidos y vibraciones propios necesitan acceso completo. El clic normal funciona sin él."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohandatud helid ja haptiline tagasiside vajavad täisjuurdepääsu. Tavaline klõps töötab ilma selleta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sons et retours haptiques perso ont besoin de l'accès complet. Le clic standard marche sans."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyéni hangokhoz és rezgéshez Teljes hozzáférés kell. A megszokott kattanás enélkül is megy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoni e i feedback personalizzati hanno bisogno dell'accesso completo. Il clic standard funziona anche senza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムのサウンドとハプティクスにはフルアクセスが必要です。標準のクリック音はなくても使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만의 사운드와 햅틱은 전체 접근이 필요해요. 기본 클릭음은 없어도 잘 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunyi dan haptik sendiri perlukan Akses Penuh. Klik biasa berfungsi tanpanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sons e vibrações à tua medida precisam de acesso total. O clique normal funciona sem ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Своим звукам и тактильной отдаче нужен полный доступ. Стандартный щелчок работает и без него."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义声音和触感需要完全访问权限。系统自带的点击声不用它也能响。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunetele personalizate și răspunsul haptic necesită acces complet. Sunetul standard al tastelor funcționează și fără acesta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangepaste geluiden en haptiek hebben volledige toegang nodig. De standaardklik werkt zonder."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自定義聲音和觸感需要完整取用許可權。系統自帶的點選聲不用它也能響。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niestandardowe dźwięki i elementy dotykowe wymagają pełnego dostępu. Standardowe kliknięcie działa bez niego."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Користувацькі звуки та тактильні відчуття потребують повного доступу. Стандартний клік працює і без нього."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel sesler ve dokunsal özellikler Tam Erişim gerektirir. Standart tıklama onsuz çalışır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastní zvuky a haptika vyžadují úplný přístup. Standardní kliknutí funguje i bez něj."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastné zvuky a haptika vyžadujú úplný prístup. Štandardné kliknutie funguje aj bez neho."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προσαρμοσμένοι ήχοι και τα απτικά χρειάζονται πλήρη πρόσβαση. Το τυπικό κλικ λειτουργεί χωρίς αυτό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassade ljud och haptik behöver Full Access. Standardklicket fungerar utan det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpassede lyde og haptik kræver fuld adgang. Standardklikket fungerer uden det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpassede lyder og haptikk trenger full tilgang. Standardklikket fungerer uten det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukautetut äänet ja haptiikka tarvitsevat täyden pääsyn. Vakionapsautus toimii ilman sitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara dan haptik khusus memerlukan Akses Penuh. Klik standar berfungsi tanpanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh và xúc giác tùy chỉnh cần có Quyền truy cập đầy đủ. Nhấp chuột tiêu chuẩn hoạt động mà không cần nó."
          }
        }
      }
    },
