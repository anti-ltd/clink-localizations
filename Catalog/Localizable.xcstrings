    "Imported automations stay off. Importing never grants plugin permissions.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las automatizaciones importadas quedan desactivadas. La importación nunca concede permisos a los plugins."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les automatisations importées restent désactivées. L’importation n’accorde jamais d’autorisations aux plugins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importierte Automationen bleiben deaktiviert. Ein Import erteilt Plugins keine Berechtigungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le automazioni importate restano disattivate. L’importazione non concede mai autorizzazioni ai plugin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As automações importadas ficam desativadas. Importar nunca concede permissões aos plugins."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортированные автоматизации остаются выключенными. Импорт не выдаёт разрешений плагинам."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Automasi yang diimport kekal dimatikan. Import tidak memberikan kebenaran pemalam."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az importált automatizálások kikapcsolva maradnak. Az importálás nem ad engedélyt a bővítményeknek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んだオートメーションは無効のままです。読み込みによってプラグインに権限が付与されることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的自动化保持关闭。导入不会授予插件权限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 자동화는 꺼진 상태로 유지됩니다. 가져오기로 플러그인 권한이 부여되지는 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Imporditud automaatikad jäävad välja lülitatuks. Import ei anna pistikprogrammidele õigusi."
          }
        }
      }
    },
