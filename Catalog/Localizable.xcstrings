          }
        }
      }
    },
    "Permanently removes every installed plugin, what it remembered, and any control it was driving.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt dauerhaft jedes installierte Plugin, was es sich gemerkt hat und jedes Bedienelement, das es gesteuert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina de forma permanente todos los plugins instalados, lo que recordaban y cualquier control que estuvieran manejando."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemaldab jäädavalt iga paigaldatud pistikprogrammi, selle meelespeetu ja iga juhtelemendi, mida see juhtis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement chaque plugin installé, ce qu'il avait mémorisé et toute commande qu'il pilotait."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Véglegesen eltávolít minden telepített bővítményt, amit megjegyzett, és minden vezérlőt, amelyet irányított."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove definitivamente ogni plugin installato, ciò che ricordava e qualsiasi controllo che stava guidando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのプラグインすべてと、その記憶していた内容、動かしていたコントロールを完全に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 모든 플러그인과 플러그인이 기억하던 내용, 제어하던 컨트롤을 영구히 제거합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuang secara kekal setiap plugin yang dipasang, apa yang diingatinya, dan sebarang kawalan yang dikendalikannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove permanentemente todos os plugins instalados, o que cada um recordava e qualquer controlo que estivesse a conduzir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Навсегда удаляет все установленные плагины, то, что они запомнили, и все элементы, которыми они управляли."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久移除所有已安装的插件、它们记住的内容，以及它们正在驱动的控件。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină definitiv fiecare plugin instalat, ceea ce și-a amintit și orice control pe care îl conducea."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert permanent elke geïnstalleerde plug-in, wat deze onthoudt en alle besturingselementen die deze aansturen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久移除所有已安裝的外掛、它們記住的內容，以及它們正在驅動的控制元件。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwyder elke geïnstalleerde inprop, die inligting wat dit onthou het, en enige kontrole wat dit beheer het, permanent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwale usuwa każdą zainstalowaną wtyczkę, to, co zapamiętała i kontrolę, którą sterowała."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назавжди видаляє всі встановлені плагіни, те, що він запам’ятав, і будь-який контроль, яким він керував."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü her eklentiyi, hatırladıklarını ve kullandığı tüm kontrolleri kalıcı olarak kaldırır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvale odstraní každý nainstalovaný plugin, to, co si pamatoval, a všechny ovládací prvky, které řídil."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Natrvalo odstráni každý nainštalovaný doplnok, to, čo si pamätal, a všetky ovládacie prvky, ktoré ovládal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταργεί οριστικά κάθε εγκατεστημένη προσθήκη, ό,τι θυμόταν και κάθε στοιχείο ελέγχου που οδηγούσε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar permanent bort varje installerat plugin, vad det kom ihåg och alla kontroller som det körde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner permanent hvert installeret plugin, hvad det huskede, og enhver kontrol det kørte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner permanent alle installerte plugin-moduler, det den husket og alle kontroller den kjørte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa pysyvästi jokaisen asennetun laajennuksen, sen muistin ja ohjauksen, jota se ohjasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus secara permanen setiap plugin yang terpasang, apa yang diingatnya, dan kontrol apa pun yang dijalankannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa vĩnh viễn mọi plugin đã cài đặt, những gì nó ghi nhớ và mọi quyền kiểm soát mà nó đang điều khiển."
          }
        }
      }
    },
