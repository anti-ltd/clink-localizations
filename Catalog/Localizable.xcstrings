    "Copied images. Only the text in your clipboard history can travel.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gekopieerde beelde. Slegs die teks in jou knipbordgeskiedenis kan reis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierte Bilder. Nur der Text aus deinem Zwischenablage-Verlauf kann mitreisen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes copiadas. Solo el texto del historial del portapapeles puede viajar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopeeritud pildid. Ainult sinu lõikelaua ajaloo tekst saab kaasa reisida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images copiées. Seul le texte de ton historique de presse-papiers peut voyager."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A másolt képek. A vágólap-előzményekből csak a szöveg utazhat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini copiate. Solo il testo della cronologia degli appunti può viaggiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーした画像。移動できるのはクリップボード履歴のテキストだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 이미지. 클립보드 기록에서는 텍스트만 이동할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imej yang disalin. Hanya teks dalam sejarah papan keratan anda boleh merentas peranti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens copiadas. Só o texto do histórico da área de transferência pode viajar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопированные изображения. Переехать может только текст из истории буфера обмена."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制的图片。剪贴板历史中只有文字会同步。"
          }
        }
      }
    },
