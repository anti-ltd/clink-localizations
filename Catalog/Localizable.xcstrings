    "Anon tap data makes accuracy better over time": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anon tap-data maak akkuraatheid mettertyd beter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme Tippdaten machen die Genauigkeit mit der Zeit besser"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos anónimos de toques mejoran la precisión con el tiempo"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonüümsed vajutusandmed parandavad täpsust aja jooksul"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des données de frappe anonymes améliorent la précision avec le temps"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A névtelen koppintási adatok idővel javítják a pontosságot"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati anonimi sui tocchi migliorano la precisione col tempo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名のタップデータで、精度がだんだん良くなります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "익명 탭 데이터로 시간이 지날수록 정확도가 좋아져요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data ketikan tanpa nama buat ketepatan lebih baik dari masa ke masa"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados de toque anónimos melhoram a precisão ao longo do tempo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анонимные данные о нажатиях со временем повышают точность"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名点按数据让准确度随时间变好"
          }
        }
      }
    },
    "Another keyboard keeps coming up instead": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Ander sleutelbord bly in plaas daarvan opkom"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kommt immer eine andere Tastatur hoch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre sale otro teclado en su lugar"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekib alati hoopis teine klaviatuur"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est toujours un autre clavier qui s'ouvre"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindig másik billentyűzet jön be helyette"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si apre sempre un'altra tastiera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつも別のキーボードが出てきます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자꾸 다른 키보드가 대신 올라옵니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci lain yang muncul setiap kali"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece sempre outro teclado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместо неё всё время открывается другая клавиатура"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次弹出来的都是别的键盘"
          }
        }
      }
    },
