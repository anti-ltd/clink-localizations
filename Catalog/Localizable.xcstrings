    "Your description and the current draft are included in the request. Review the result before applying it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud incluye tu descripción y el borrador actual. Revisa el resultado antes de aplicarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta description et le brouillon actuel sont inclus dans la requête. Vérifie le résultat avant de l’appliquer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Beschreibung und der aktuelle Entwurf werden mitgesendet. Prüfe das Ergebnis, bevor du es übernimmst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La richiesta include la tua descrizione e la bozza attuale. Controlla il risultato prima di applicarlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O pedido inclui a sua descrição e o rascunho atual. Reveja o resultado antes de o aplicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В запрос включены ваше описание и текущий черновик. Проверьте результат перед применением."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan merangkumi penerangan anda dan draf semasa. Semak hasil sebelum menggunakannya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kérés tartalmazza a leírásodat és az aktuális vázlatot. Alkalmazás előtt ellenőrizd az eredményt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "説明と現在の下書きがリクエストに含まれます。適用する前に結果を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求中会包含你的描述和当前草稿。应用前请检查结果。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청에는 설명과 현재 초안이 포함됩니다. 적용하기 전에 결과를 검토하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Päring sisaldab sinu kirjeldust ja praegust mustandit. Vaata tulemus enne rakendamist üle."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrierea dvs. și schița actuală sunt incluse în cerere. Examinați rezultatul înainte de a-l aplica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw omschrijving en het huidige concept zijn bij de aanvraag inbegrepen. Bekijk het resultaat voordat u het toepast."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求中會包含你的描述和當前草稿。應用前請檢查結果。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou beskrywing en die huidige konsep word by die versoek ingesluit. Gaan die resultaat na voordat jy dit toepas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój opis i aktualny projekt są zawarte w zapytaniu. Przejrzyj wynik przed jego zastosowaniem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш опис і поточна чернетка включені в запит. Перед застосуванням перевірте результат."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıklamanız ve mevcut taslağı talebe dahil edilmiştir. Uygulamadan önce sonucu inceleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš popis a aktuální koncept jsou součástí požadavku. Před aplikací zkontrolujte výsledek."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš popis a aktuálny koncept sú zahrnuté v žiadosti. Pred aplikáciou skontrolujte výsledok."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η περιγραφή σας και το τρέχον προσχέδιο περιλαμβάνονται στο αίτημα. Ελέγξτε το αποτέλεσμα πριν το εφαρμόσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din beskrivning och det aktuella utkastet ingår i begäran. Granska resultatet innan du applicerar det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din beskrivelse og det aktuelle udkast er inkluderet i anmodningen. Gennemgå resultatet, før du anvender det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din beskrivelse og gjeldende utkast er inkludert i forespørselen. Se gjennom resultatet før du bruker det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvauksesi ja nykyinen luonnos sisältyvät pyyntöön. Tarkista tulos ennen sen käyttöä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Deskripsi Anda dan draf saat ini disertakan dalam permintaan. Tinjau hasilnya sebelum menerapkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô tả của bạn và bản nháp hiện tại được bao gồm trong yêu cầu. Xem lại kết quả trước khi áp dụng nó."
          }
        }
      }
    },
