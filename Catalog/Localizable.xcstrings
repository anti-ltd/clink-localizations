    "Loads settings from the file. Your themes are untouched.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laai instellings vanaf die lêer. Jou temas is onaangeraak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt die Einstellungen aus der Datei. Deine Themes bleiben unangetastet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga los ajustes desde el archivo. Tus temas se quedan igual."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadib seaded failist. Sinu teemad jäävad puutumata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge les réglages depuis le fichier. Tes thèmes restent intacts."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Betölti a beállításokat a fájlból. A témáidhoz nem nyúl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica le impostazioni dal file. I tuoi temi restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルから設定を読み込みます。テーマはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에서 설정을 불러와요. 테마는 그대로 둬요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muatkan tetapan dari fail. Tema anda tak diusik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega as definições do ficheiro. Os teus temas ficam intactos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружает настройки из файла. Темы остаются нетронутыми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从文件里加载设置。你的主题不会动。"
          }
        }
      }
    },
