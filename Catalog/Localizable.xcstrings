    "Words you add yourself always apply, and survive a clear.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Woorde wat jy self byvoeg is altyd van toepassing, en oorleef 'n duidelike."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst hinzugefügte Wörter gelten immer und bleiben auch nach dem Löschen erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras que añades tú siempre valen y sobreviven a un borrado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ise lisatud sõnad rakenduvad alati ja jäävad tühjendamisest ellu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots que tu ajoutes toi-même s'appliquent toujours et survivent à un effacement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az általad hozzáadott szavak mindig érvényesek, és a törlés után is megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole che aggiungi tu valgono sempre e sopravvivono a una cancellazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で追加した単語は常に有効で、消去しても残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 추가한 단어는 항상 적용되고, 지워도 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataan yang awak tambah sendiri sentiasa digunakan dan kekal selepas pembersihan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras que adicionas ficam sempre a valer e sobrevivem a uma limpeza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слова, добавленные вами, действуют всегда и переживают очистку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己添加的词始终有效，清空后也还在。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuvintele pe care le adăugați singur se aplică întotdeauna și supraviețuiesc unui clar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Woorden die je zelf toevoegt, zijn altijd van toepassing en overleven een duidelijke."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己新增的詞始終有效，清空後也還在。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słowa, które sam dodasz, zawsze mają zastosowanie i przetrwają."
          }
        },
