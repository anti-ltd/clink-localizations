    "Then renews monthly. Cancel anytime.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después se renueva cada mes. Cancela cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis renouvellement mensuel. Résiliation à tout moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich danach monatlich. Jederzeit kündbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi si rinnova ogni mese. Annulla quando vuoi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois renova mensalmente. Cancele a qualquer momento."
          }
        },
        "ru": {
