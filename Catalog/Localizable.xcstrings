    "Drag 14pt to delete, 26pt per word. Fast deletions.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra 14 pt para borrar, 26 pt por palabra. Borrado rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse de 14 pt pour effacer, puis de 26 pt par mot. Effacement rapide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "14 pt ziehen zum Löschen, 26 pt pro Wort. Schnelles Löschen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina di 14 pt per eliminare, 26 pt per parola. Cancellazione rapida."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste 14 pt para apagar, 26 pt por palavra. Eliminação rápida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите на 14 пт для удаления, по 26 пт на слово. Быстрое удаление."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret 14 pt untuk memadam, 26 pt bagi setiap perkataan. Pemadaman pantas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzz 14 pt-ot a törléshez, szavanként 26 pt-ot. Gyors törlés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "14ptドラッグで開始し、26ptごとに1単語削除します。素早く削除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动 14 pt 开始删除，之后每 26 pt 删除一个词。删除速度快。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "14pt에서 삭제를 시작하고 단어마다 26pt씩 이동합니다. 빠르게 삭제합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutamiseks lohista 14 pt, iga sõna kohta 26 pt. Kiire kustutamine."
          }
        }
      }
    },
