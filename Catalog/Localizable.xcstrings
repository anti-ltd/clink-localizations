    "Overrides disappear when conditions stop matching.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios temporales se eliminan al dejar de cumplirse las condiciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages temporaires disparaissent quand les conditions ne sont plus remplies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Einstellungen enden, sobald die Bedingungen nicht mehr erfüllt sind."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche temporanee terminano quando le condizioni non sono più soddisfatte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações temporárias terminam quando as condições deixam de se verificar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временные настройки снимаются, когда условия перестают выполняться."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapan sementara tamat apabila syarat tidak lagi dipenuhi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ideiglenes beállítások megszűnnek, ha a feltételek már nem teljesülnek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "条件を満たさなくなると、一時設定は解除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条件不再满足时，临时设置即被移除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조건이 더 이상 충족되지 않으면 임시 설정이 해제됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajutised seaded kaovad, kui tingimused pole enam täidetud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulările dispar atunci când condițiile nu se potrivesc."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overschrijvingen verdwijnen wanneer de voorwaarden niet meer overeenkomen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "條件不再滿足時，臨時設定即被移除。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Oorheersings verval wanneer daar nie meer aan die voorwaardes voldoen word nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąpienia znikają, gdy warunki przestają się zgadzać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевизначення зникають, коли умови перестають збігатися."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koşullar eşleşmeyi bıraktığında geçersiz kılmalar kaybolur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepsání zmizí, když podmínky přestanou odpovídat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepisy zmiznú, keď sa podmienky prestanú zhodovať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι παρακάμψεις εξαφανίζονται όταν οι συνθήκες σταματήσουν να ταιριάζουν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åsidosättningar försvinner när förhållandena slutar matcha."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilsidesættelser forsvinder, når forholdene holder op med at matche."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Overstyringer forsvinner når forholdene slutter å matche."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohitukset katoavat, kun olosuhteet lakkaavat vastaamasta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penimpaan hilang ketika kondisi tidak lagi cocok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần ghi đè sẽ biến mất khi các điều kiện ngừng khớp."
          }
        }
      }
    },
