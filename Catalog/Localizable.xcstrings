    "Press Space twice to end the sentence with a period. A space the keyboard added after a swipe never counts as the first press.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweimal Leertaste drücken, um den Satz mit einem Punkt zu beenden. Ein Leerzeichen, das die Tastatur nach einem Wisch selbst eingefügt hat, zählt nie als erster Druck."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Espacio dos veces para terminar la frase con un punto. Un espacio que el teclado añadió tras un deslizamiento nunca cuenta como la primera pulsación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajuta tühikut kaks korda, et lõpetada lause punktiga. Tühik, mille klaviatuur lisas pärast libistamist ise, ei lähe kunagi esimese vajutusena arvesse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie deux fois sur la barre d’espace pour terminer la phrase par un point. Une espace ajoutée par le clavier après un glissement ne compte jamais comme premier appui."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomd meg kétszer a szóközt, hogy a mondat ponttal záruljon. A billentyűzet által csúsztatás után beszúrt szóköz sosem számít első lenyomásnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi Spazio due volte per chiudere la frase con un punto. Uno spazio aggiunto dalla tastiera dopo uno scorrimento non conta mai come prima pressione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースを2回押すと文末にピリオドが入ります。スワイプ後にキーボードが自動で入れたスペースは1回目として数えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스를 두 번 누르면 문장이 마침표로 끝납니다. 스와이프 뒤에 키보드가 스스로 넣은 공백은 첫 번째 입력으로 치지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan Ruang dua kali untuk menamatkan ayat dengan noktah. Ruang yang dimasukkan papan kekunci selepas leretan tidak dikira sebagai tekanan pertama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Espaço duas vezes para terminar a frase com um ponto. Um espaço que o teclado inseriu depois de um deslize nunca conta como o primeiro toque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите пробел дважды, чтобы закончить предложение точкой. Пробел, который клавиатура сама поставила после свайпа, никогда не считается первым нажатием."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按两次空格以句号结束句子。滑动输入后键盘自动添加的空格不算第一次按下。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați Spațiu de două ori pentru a încheia propoziția cu un punct. Un spațiu adăugat de tastatură după o glisare nu contează niciodată ca prima apăsare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk tweemaal op de spatiebalk om de zin met een punt te beëindigen. Een spatie die het toetsenbord na een veegbeweging heeft toegevoegd, telt nooit als de eerste druk."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按兩次空格以句號結束句子。滑動輸入後鍵盤自動新增的空格不算第一次按下。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk die spasiebalk twee keer om die sin met 'n punt te eindig.'n Spasie wat die sleutelbord na 'n swiep byvoeg, tel nooit as die eerste druk nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij dwukrotnie spację, aby zakończyć zdanie kropką. Spacja dodana przez klawiaturę po przesunięciu nigdy nie liczy się jako pierwsze naciśnięcie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Двічі натисніть пробіл, щоб закінчити речення крапкою. Пробіл, доданий клавіатурою після проведення, ніколи не вважається першим натисканням."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cümleyi noktayla bitirmek için Space tuşuna iki kez basın. Klavyenin kaydırma sonrasında eklediği boşluk hiçbir zaman ilk basış olarak sayılmaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojím stisknutím mezerníku ukončíte větu tečkou. Mezera, kterou klávesnice přidá po přejetí, se nikdy nepočítá jako první stisknutí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojitým stlačením medzerníka ukončíte vetu bodkou. Medzera, ktorú klávesnica pridala po potiahnutí, sa nikdy nepočíta ako prvé stlačenie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε το πλήκτρο διαστήματος δύο φορές για να τελειώσετε την πρόταση με τελεία. Ένα διάστημα που πρόσθεσε το πληκτρολόγιο μετά από ένα σάρωση δεν υπολογίζεται ποτέ ως το πρώτο πάτημα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på mellanslag två gånger för att avsluta meningen med en punkt. Ett blanksteg som tangentbordet lade till efter ett svep räknas aldrig som första tryckning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på mellemrumstasten to gange for at afslutte sætningen med et punktum. Et mellemrum, som tastaturet tilføjede efter et swipe, tæller aldrig som det første tryk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk mellomrom to ganger for å avslutte setningen med et punktum. Et mellomrom tastaturet la til etter et sveip, teller aldri som første trykk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina välilyöntiä kahdesti lopettaaksesi lauseen pisteellä. Näppäimistön pyyhkäisyn jälkeen lisäämä välilyönti ei koskaan lasketa ensimmäiseksi painallukseksi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan Spasi dua kali untuk mengakhiri kalimat dengan tanda titik. Spasi yang ditambahkan keyboard setelah gesekan tidak dihitung sebagai penekanan pertama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn Space hai lần để kết thúc câu bằng dấu chấm. Khoảng trống mà bàn phím thêm vào sau khi vuốt không bao giờ được tính là lần nhấn đầu tiên."
          }
        }
      }
    },
    "Press and hold the space bar for a moment.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk en hou die spasiebalk vir 'n oomblik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Leertaste einen Moment gedrückt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la barra espaciadora un momento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia tühikuklahvi hetk all."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie et maintiens la barre d'espace un instant."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd nyomva egy pillanatig a szóközt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta la barra spaziatrice per un attimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースキーを少しのあいだ長押しします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 바를 잠깐 길게 누르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan dan tahan bar ruang seketika."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a barra de espaços premida por um momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и подержите пробел пару мгновений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住空格键一小会儿。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați și mențineți apăsată bara de spațiu pentru un moment."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de spatiebalk even ingedrukt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住空格鍵一小會兒。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij i przytrzymaj przez chwilę spację."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть і утримуйте пробіл на мить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluk çubuğunu bir süre basılı tutun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiskněte a na chvíli podržte mezerník."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stlačte a na chvíľu podržte medzerník."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε και κρατήστε πατημένο το πλήκτρο διαστήματος για λίγο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck och håll ned mellanslagstangenten ett ögonblick."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk og hold mellemrumstasten et øjeblik."
          }
