    "The full hue wheel, ignoring the theme's colors.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die volkleurwiel, ignoreer die tema se kleure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ganze Farbkreis, unabhängig von den Farben des Themes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el círculo de color, sin tener en cuenta los colores del tema."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Terve värviratas, teema värve eirates."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La roue des couleurs complète, sans tenir compte des couleurs du thème."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes színkör, a téma színeit figyelmen kívül hagyva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'intera ruota dei colori, ignorando i colori del tema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマの色に関係なく、色相環をすべて使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마 색과 무관하게 전체 색상환을 사용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Roda warna penuh, tanpa mengira warna tema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O círculo de cores completo, ignorando as cores do tema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный цветовой круг, игнорируя цвета темы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用完整色环，不参考主题配色。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Roata de nuanță completă, ignorând culorile temei."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het volledige tintwiel, waarbij de kleuren van het thema worden genegeerd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用完整色環，不參考主題配色。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełne koło odcieni, ignorując kolory motywu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
