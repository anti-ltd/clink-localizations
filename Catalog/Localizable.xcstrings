    "Your themes, layouts, custom keys and sounds, exactly how you set them up.": {
      "extractionState": "stale",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jou temas, uitlegte, pasgemaakte sleutels en klanke, presies hoe jy dit opgestel het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
