          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードと絵文字はすべてのアプリで無料です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드와 이모지는 모든 앱에서 무료입니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci dan emoji adalah percuma dalam setiap aplikasi"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado e os emojis são gratuitos em todas as apps"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура и эмодзи бесплатны в каждом приложении"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘和表情符号在任何应用中均免费"
          }
        }
      }
    },
    "The keyboard feels slow to respond": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die sleutelbord voel stadig om te reageer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastatur reagiert träge"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado responde con retraso"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuur tundub aeglaselt reageerivat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier semble lent à réagir"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzet lassan reagál"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera sembra lenta a rispondere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの反応が遅く感じます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 반응이 느리게 느껴집니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci terasa lambat bertindak balas"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado parece lento a responder"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура отзывается медленно"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感觉键盘反应慢"
          }
        }
      }
    },
    "The keyboard follows: it opens on the mic, with the keys one tap away on the right. Nothing is switched off.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die sleutelbord volg: dit maak oop op die mikrofoon, met die sleutels een tik weg aan die regterkant. Niks is afgeskakel nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastatur zieht mit: Sie öffnet sich mit dem Mikrofon, die Tasten sind rechts einen Tipp entfernt. Abgeschaltet wird nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado te sigue: se abre en el micro, con las teclas a un toque a la derecha. No se desactiva nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuur järgneb: ta avaneb mikrofonil, klahvid ühe puudutuse kaugusel paremal. Midagi ei lülitata välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier suit : il s'ouvre sur le micro, les touches à une pression sur la droite. Rien n'est désactivé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzet is követi: a mikrofonnal nyílik, a billentyűk jobbra, egy koppintásra vannak. Semmi nem kapcsol ki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera segue: si apre sul microfono, con i tasti a un tocco sulla destra. Non si disattiva nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードも同じように、マイクの画面で開きます。キーは右側からワンタップで出せます。何もオフにはなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드도 따라옵니다. 마이크 화면으로 열리고, 키는 오른쪽에서 한 번만 누르면 나와요. 꺼지는 건 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci turut mengikut: ia dibuka pada mikrofon, dengan kekunci satu ketikan di sebelah kanan. Tiada apa-apa yang dimatikan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado acompanha: abre no microfone, com as teclas a um toque à direita. Não se desliga nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура следует за этим: открывается на микрофоне, а клавиши — в одном нажатии справа. Ничего не выключается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘也跟着走：打开就是麦克风，按键在右边，点一下就有。什么都不会被关掉。"
          }
        }
      }
    },
    "The keyboard is close to its memory limit, so the lighting layer is off until there's room again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado está cerca de su límite de memoria. La iluminación se desactiva hasta que vuelva a haber espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier approche de sa limite de mémoire. L’éclairage est désactivé jusqu’à ce qu’il y ait de nouveau de la place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastatur erreicht ihre Speichergrenze. Die Beleuchtung bleibt aus, bis wieder genug Speicher frei ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera è vicina al limite di memoria. L’illuminazione resta disattivata finché non si libera spazio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado está perto do limite de memória. A iluminação fica desligada até haver espaço livre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура почти достигла лимита памяти. Подсветка отключена, пока не освободится место."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci hampir mencapai had memori. Pencahayaan dimatikan sehingga ruang tersedia semula."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzet közel jár a memóriakorlátjához. A világítás kikapcsolva marad, amíg újra lesz szabad hely."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードのメモリ使用量が上限に近いため、空きができるまで照明をオフにしています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘内存使用量已接近上限，灯光暂时关闭，待内存释放后恢复。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 메모리가 한도에 가까워 여유 공간이 생길 때까지 조명을 끕니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuur on mälupiiri lähedal. Valgustus on välja lülitatud, kuni mälu vabaneb."
          }
        }
      }
    },
    "The keyboard is close to its memory limit. Glass keeps rendering, but the glow, bloom, and background effects run lighter, or pause, until there's room again.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die sleutelbord is naby aan sy geheuelimiet. Glas hou aan om weer te gee, maar die gloei-, blom- en agtergrondeffekte word ligter, of breek, totdat daar weer plek is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastatur ist nah an ihrem Speicherlimit. Das Glas bleibt, aber Leuchten, Aufblühen und Hintergrundeffekte laufen sparsamer oder pausieren, bis wieder Platz ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado está cerca de su límite de memoria. El cristal se mantiene, pero el brillo, el destello y los efectos de fondo funcionan más ligeros, o se pausan, hasta que vuelva a haber espacio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuur on lähedal oma mälupiirile. Klaas jätkab renderdamist, aga sära, bloom ja taustefektid töötavad kergemalt või peatuvad, kuni ruumi on jälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier approche de sa limite de mémoire. Le verre reste affiché, mais la lueur, la floraison et les effets d'arrière-plan tournent au ralenti, voire se mettent en pause, le temps de libérer de la place."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzet közel jár a memóriakorlátjához. Az üveg marad, de a ragyogás, a felvillanás és a háttéreffektek takarékosabban futnak vagy szünetelnek, amíg újra lesz hely."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera è vicina al suo limite di memoria. Il vetro resta, ma bagliore, fioritura ed effetti di sfondo girano più leggeri, o si mettono in pausa, finché non c'è di nuovo spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードがメモリ上限に近づいています。ガラスはそのままで、グロー、ブルーム、背景エフェクトは空きができるまで軽く動くか一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 메모리 한계에 가까워졌습니다. 글래스는 그대로 두고 글로우, 블룸, 배경 효과는 여유가 생길 때까지 가볍게 돌거나 멈춥니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci hampir mencapai had memorinya. Kaca kekal, tetapi cahaya, kembang dan kesan latar berjalan lebih ringan, atau dijeda, sehingga ada ruang semula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado está perto do seu limite de memória. O vidro continua, mas o brilho, o realce e os efeitos de fundo passam a correr mais leves, ou pausam, até haver espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура близка к пределу по памяти. Стекло по-прежнему рисуется, но сияние, свечение и фоновые эффекты идут в облегчённом виде или замирают, пока не освободится место."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘已接近内存上限。玻璃继续渲染，但光晕、绽放和背景特效会转为轻量运行或暂停，直到内存腾出空间。"
          }
        }
      }
    },
    "The keyboard needs Full Access to browse and copy GIFs. Everyday typing works without it.": {
      "comment": "GIF browser UI and accessibility. Native-speaker editorial sign-off for this release is tracked in docs/gif-tool-localization-review.md.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The keyboard needs Full Access to browse and copy GIFs. Everyday typing works without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado necesita Acceso completo para explorar y copiar GIFs. Puedes escribir normalmente sin él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier a besoin de l’Accès complet pour parcourir et copier des GIFs. Tu peux taper normalement sans l’activer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastatur benötigt Vollzugriff, um GIFs zu durchsuchen und zu kopieren. Normales Tippen funktioniert auch ohne Vollzugriff."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera ha bisogno dell’Accesso completo per sfogliare e copiare GIF. Puoi scrivere normalmente anche senza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado precisa de Acesso total para explorar e copiar GIFs. Podes escrever normalmente sem o ativar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для просмотра и копирования GIF клавиатуре нужен Полный доступ. Обычный ввод работает и без него."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci memerlukan Akses penuh untuk melayari dan menyalin GIF. Penaipan biasa berfungsi tanpanya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GIF-ek böngészéséhez és másolásához a billentyűzetnek Teljes hozzáférésre van szüksége. A szokásos gépelés enélkül is működik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFの閲覧とコピーには、キーボードのフルアクセスが必要です。通常の入力はフルアクセスなしでも利用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘需要“完全访问”才能浏览和复制 GIF。日常输入无需开启此权限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF를 찾아보고 복사하려면 키보드에 전체 접근이 필요해요. 일반적인 입력은 전체 접근 없이도 가능해요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-ide sirvimiseks ja kopeerimiseks vajab klaviatuur täisjuurdepääsu. Tavaline kirjutamine töötab ka ilma selleta."
          }
        }
      }
    },
    "The keyboard vanishes mid-sentence": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die sleutelbord verdwyn middel sin"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastatur verschwindet mitten im Satz"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado desaparece a media frase"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuur kaob lause keskel"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier disparaît en plein milieu d'une phrase"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzet eltűnik mondat közben"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera sparisce a metà frase"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文章の途中でキーボードが消えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문장 도중에 키보드가 사라집니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci hilang di tengah ayat"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado desaparece a meio da frase"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура исчезает посреди предложения"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘会在打字打到一半时消失"
          }
        }
      }
    },
    "The keyboard you just tried works everywhere with a membership. Inside this app it stays free.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die sleutelbord wat jy sopas probeer het, werk oral met 'n lidmaatskap. Binne hierdie toepassing bly dit gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einer Mitgliedschaft funktioniert die Tastatur, die du gerade ausprobiert hast, überall. In dieser App bleibt sie kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado que acabas de probar funciona en todas partes con una suscripción. Dentro de esta app seguirá siendo gratis."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuur, mida just proovisid, töötab liikmelisusega kõikjal. Selles rakenduses jääb see tasuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un abonnement, le clavier que tu viens d'essayer fonctionne partout. Dans cette app, il reste gratuit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagsággal az imént kipróbált billentyűzet mindenhol működik. Ebben az appban ingyenes marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un abbonamento, la tastiera che hai appena provato funziona ovunque. Dentro questa app resta gratuita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンバーシップに登録すると、今試したキーボードをどこでも使えます。このアプリ内では無料のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멤버십에 가입하면 방금 써 본 키보드를 어디서나 사용할 수 있어요. 이 앱 안에서는 계속 무료예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan keahlian, papan kekunci yang baru dicuba boleh digunakan di mana-mana. Dalam app ini, ia kekal percuma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma adesão, o teclado que acabaste de experimentar funciona em todo o lado. Nesta app continua grátis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура, которую вы только что попробовали, работает везде с членством. Внутри этого приложения она остаётся бесплатной."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开通会员后，刚刚试用的键盘可在任何地方使用。在此 App 内则会一直免费。"
          }
        }
      }
    },
    "The keyboard's flip button swaps between these two, so a conversation is one tap each way.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die sleutelbord se flip-knoppie ruil tussen hierdie twee, so 'n gesprek is een tik elke kant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tauschtaste der Tastatur wechselt zwischen diesen beiden — ein Gespräch ist also ein Tippen pro Richtung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón de intercambio del teclado alterna entre estos dos, así que una conversación es un toque en cada sentido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuuri vahetusnupp vahetab nende kahe vahel, nii et vestlus on üks puudutus kummaski suunas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton d’inversion du clavier bascule entre ces deux langues : une conversation ne demande qu’un appui dans chaque sens."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzet váltógombja e kettő között vált, így egy beszélgetés mindkét irányban egy koppintás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pulsante di scambio della tastiera alterna queste due lingue, così una conversazione è un tocco per parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの入れ替えボタンはこの2つを切り替えます。会話中もどちらの向きも1タップです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드의 전환 버튼이 이 두 언어를 바꿔 줍니다. 대화 중 어느 방향이든 한 번만 누르면 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Butang tukar pada papan kekunci menyilih antara kedua-duanya, jadi perbualan hanya satu ketikan setiap arah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão de troca do teclado alterna entre estes dois, por isso uma conversa é um toque em cada sentido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка переворота на клавиатуре меняет эти два языка местами, так что разговор — по одному нажатию в каждую сторону."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘上的互换按钮会在这两种语言之间切换，对话时每个方向都只需轻点一次。"
          }
        }
      }
    },
    "The keyboard, emoji and your presets are free in every app. Membership unlocks the tools: dictation, clipboard, AI Tools and more.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die sleutelbord, emoji en jou voorafinstellings is gratis in elke toepassing. Lidmaatskap ontsluit die gereedskap: diktee, knipbord, KI-nutsgoed en meer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastatur, Emoji und deine Vorgaben sind in jeder App kostenlos. Mit der Mitgliedschaft werden die Tools freigeschaltet: Diktat, Zwischenablage, KI-Tools und mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado, los emojis y tus ajustes predefinidos son gratis en todas las apps. La suscripción desbloquea las herramientas: dictado, portapapeles, herramientas de IA y más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuur, emotikonid ja sinu eelseadistused on igas rakenduses tasuta. Liikmelisus avab tööriistad: dikteerimine, lõikelaud, AI-tööriistad ja palju muud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier, les emojis et tes préréglages sont gratuits dans toutes les apps. L’abonnement débloque les outils : dictée, presse-papiers, outils d’IA et plus encore."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzet, az emodzsik és a beállításaid minden alkalmazásban ingyenesek. Az előfizetés feloldja az eszközöket: diktálás, vágólap, AI-eszközök és még több."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera, le emoji e i tuoi preset sono gratuiti in ogni app. L'abbonamento sblocca gli strumenti: dettatura, appunti, strumenti AI e altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボード、絵文字、プリセットはすべてのアプリで無料です。メンバーシップでツール（音声入力、クリップボード、AIツールなど）が使えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드, 이모지, 프리셋은 모든 앱에서 무료입니다. 멤버십으로 받아쓰기, 클립보드, AI 도구 등 도구를 잠금 해제하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci, emoji dan pratetap anda adalah percuma dalam setiap aplikasi. Keahlian membuka kunci alatan: imlak, papan keratan, Alatan AI dan banyak lagi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado, os emojis e os seus predefinidos são gratuitos em todas as apps. A assinatura desbloqueia as ferramentas: ditado, área de transferência, ferramentas de IA e mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура, эмодзи и ваши пресеты бесплатны в каждом приложении. Членство открывает инструменты: диктовку, буфер обмена, инструменты ИИ и другое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘、表情符号和您的预设在任何应用中均免费。会员资格解锁工具：听写、剪贴板、AI 工具等。"
          }
        }
      }
    },
    "The keys are too round for me": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die sleutels is te rond vir my"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mir sind die Tasten zu rund"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas me quedan demasiado redondeadas"
          }
        },
        "et": {
          "stringUnit": {
