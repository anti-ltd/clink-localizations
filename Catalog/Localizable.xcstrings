    "Switch to Notes mode in the General tab to save and browse snippets.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel oor na Notasmodus in die Algemeen-oortjie om brokkies te stoor en te blaai."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle im Tab „Allgemein\" in den Notizen-Modus, um Schnipsel zu speichern und zu durchsuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia al modo Notas en la pestaña General para guardar y ver tus fragmentos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita kaardil Üldine märkmete režiimi, et nippe salvestada ja sirvida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe en mode Notes dans l'onglet Général pour enregistrer et parcourir tes extraits."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válts Jegyzetek módra az Általános fülön, hogy részleteket menthess és nézhess itt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa alla modalità Note nella scheda Generali per salvare e sfogliare i frammenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「一般」タブでメモモードに切り替えると、スニペットの保存や閲覧ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 탭에서 메모 모드로 바꾸면 스니펫을 저장하고 둘러볼 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar ke mod Nota dalam tab Umum untuk simpan dan lihat cebisan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda para o modo Notas no separador Geral para guardares e veres os excertos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдите в режим заметок на вкладке «Общие», чтобы сохранять и просматривать заготовки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到「通用」标签里切到笔记模式，就能保存和翻看片段。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comutați la modul Note în fila General pentru a salva și a răsfoi fragmente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel naar de Notitiemodus op het tabblad Algemeen om fragmenten op te slaan en door te bladeren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到「通用」標籤裡切到筆記模式，就能儲存和翻看片段。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejdź do trybu Notatki na karcie Ogólne, aby zapisywać i przeglądać fragmenty."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдіть у режим нотаток на вкладці «Загальні», щоб зберігати та переглядати фрагменти."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parçacıkları kaydetmek ve bunlara göz atmak için Genel sekmesinde Notlar moduna geçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li ukládat a procházet úryvky, přepněte do režimu Poznámky na kartě Obecné."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete ukladať a prehliadať úryvky, prepnite sa do režimu Poznámky na karte Všeobecné."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταβείτε στη λειτουργία Σημειώσεις στην καρτέλα Γενικά για αποθήκευση και περιήγηση σε αποσπάσματα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växla till anteckningsläge på fliken Allmänt för att spara och bläddra bland utdrag."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift til notetilstand på fanen Generelt for at gemme og gennemse uddrag."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt til notatmodus i kategorien Generelt for å lagre og bla gjennom tekstutdrag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
