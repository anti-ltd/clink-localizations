          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Achtergrond uit, zodat de app waarin u typt zichtbaar is."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉“背景”，即可透過鍵盤看到正在輸入的 App。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel Agtergrond (Backdrop) af sodat die toepassing waarin jy tik, sigbaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz Tło, aby aplikacja, w której piszesz, była widoczna."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкніть заставку, щоб програма, у якій ви вводите текст, відображалася."
