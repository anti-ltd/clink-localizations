          }
        }
      }
    },
    "Tap a key in the preview to paint it. Anything you leave unset stays the theme's color.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik 'n sleutel in die voorskou om dit te verf. Enigiets wat jy ongesteld laat bly die tema se kleur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in der Vorschau auf eine Taste, um sie zu färben. Was du nicht setzt, behält die Farbe des Designs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una tecla en la vista previa para pintarla. Lo que no ajustes conserva el color del tema."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta eelvaates klahvi, et see värvida. Määratlemata jäänud jäävad teema värvi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche une touche dans l’aperçu pour la colorer. Ce que tu ne définis pas garde la couleur du thème."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy billentyűre az előnézetben, és színezd ki. Amit nem állítasz be, megtartja a téma színét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un tasto nell’anteprima per colorarlo. Quello che non imposti mantiene il colore del tema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューのキーをタップすると色を塗れます。設定しなかった部分はテーマの色のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기에서 키를 탭하면 칠할 수 있어요. 설정하지 않은 부분은 테마 색상 그대로예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kekunci dalam pratonton untuk mewarnakannya. Apa yang tidak ditetapkan kekal warna tema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca numa tecla na pré-visualização para pintá-la. O que não definires fica com a cor do tema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на клавишу в предпросмотре, чтобы покрасить её. Всё, что вы не тронете, останется цвета темы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按预览里的按键就能上色。没有设置的地方保持主题颜色。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți o tastă în previzualizare pentru a o picta. Orice lăsați nesetat rămâne culoarea temei."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een toets in het voorbeeld om deze te verven. Alles wat u niet instelt, behoudt de kleur van het thema."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按預覽裡的按鍵就能上色。沒有設定的地方保持主題顏色。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij klawisz w podglądzie, aby go pomalować. Wszystko, co pozostawisz nieskonfigurowane, pozostanie w kolorze motywu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться клавіші в попередньому перегляді, щоб намалювати її. Усе, що ви не налаштували, зберігає колір теми."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyamak için önizlemede bir tuşa dokunun. Ayarlamadan bıraktığınız her şey temanın renginde kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na klávesu v náhledu ji namalujete. Cokoli necháte nenastavené, zůstane barva motivu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na kláves v náhľade ho namaľujete. Všetko, čo necháte nenastavené, zostane farbou témy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ένα πλήκτρο στην προεπισκόπηση για να το ζωγραφίσετε. Οτιδήποτε αφήνετε ακαθόριστο παραμένει στο χρώμα του θέματος."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en tangent i förhandsgranskningen för att måla den. Allt du lämnar oinställt förblir temats färg."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en tast i forhåndsvisningen for at male den. Alt, hvad du lader være uindstillet, forbliver temaets farve."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en tast i forhåndsvisningen for å male den. Alt du lar være uaktivert forblir temaets farge."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta näppäintä esikatselussa maalataksesi sen. Kaikki, jonka jätät määrittämättä, pysyy teeman värinä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tombol di pratinjau untuk melukisnya. Apa pun yang tidak disetel akan tetap menjadi warna tema."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào một phím trong bản xem trước để vẽ nó. Bất cứ điều gì bạn không đặt vẫn giữ nguyên màu của chủ đề."
          }
        }
      }
    },
    "Tap a key to customize its style, colors, or artwork.": {
      "comment": "Canvas editor instruction. Select a keyboard key in the preview to edit its visual appearance; artwork means an image placed on the keycap.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Taste, um ihren Stil, ihre Farben oder ihr Bild anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una tecla para personalizar su estilo, sus colores o su imagen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta klahvi, et kohandada selle stiili, värve või pilti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionne une touche pour personnaliser son style, ses couleurs ou son image."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy billentyűre, és szabd testre a stílusát, a színeit vagy a képét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un tasto per personalizzarne lo stile, i colori o l’immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーをタップすると、スタイルや色、画像をカスタマイズできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 탭하여 스타일, 색상, 이미지를 원하는 대로 설정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kekunci untuk menyesuaikan gaya, warna atau imejnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca numa tecla para personalizares o estilo, as cores ou a imagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на клавишу, чтобы изменить её стиль, цвета или изображение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按按键，自定义样式、颜色或图案。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți o tastă pentru a-i personaliza stilul, culorile sau opera de artă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een toets om de stijl, kleuren of illustraties aan te passen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按按鍵，自定義樣式、顏色或圖案。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op 'n sleutel om die styl, kleure of grafika daarvan aan te pas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij klawisz, aby dostosować jego styl, kolory lub grafikę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться клавіші, щоб налаштувати її стиль, кольори чи зображення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stilini, renklerini veya resmini özelleştirmek için bir tuşa dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na klávesu přizpůsobíte její styl, barvy nebo kresbu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na kláves prispôsobíte jeho štýl, farby alebo kresbu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ένα πλήκτρο για να προσαρμόσετε το στυλ, τα χρώματα ή το έργο τέχνης του."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en tangent för att anpassa dess stil, färger eller konstverk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en tast for at tilpasse dens stil, farver eller illustrationer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en tast for å tilpasse stilen, fargene eller kunstverket."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta näppäintä muokataksesi sen tyyliä, värejä tai taidetta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tombol untuk menyesuaikan gaya, warna, atau karya seninya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào một phím để tùy chỉnh kiểu dáng, màu sắc hoặc tác phẩm nghệ thuật của nó."
          }
        }
      }
    },
    "Tap a key to edit it. Drag keys to move them, and add keys or rows from the bar above.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Taste, um sie zu bearbeiten. Ziehe Tasten, um sie zu verschieben, und füge über die Leiste oben Tasten oder Reihen hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una tecla para editarla. Arrastra las teclas para moverlas y añade teclas o filas desde la barra de arriba."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta klahvi, et seda muuta. Lohista klahve nende liigutamiseks ning lisa klahve või ridu ülal olevalt ribalt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une touche pour la modifier. Faites glisser les touches pour les déplacer, et ajoutez des touches ou des rangées depuis la barre ci-dessus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy billentyűre a szerkesztéséhez. Húzd a billentyűket az áthelyezéshez, és a fenti sávból adj hozzá billentyűket vagy sorokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un tasto per modificarlo. Trascina i tasti per spostarli e aggiungi tasti o file dalla barra in alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーをタップして編集します。ドラッグで移動し、上のバーからキーや行を追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 탭해 편집하세요. 드래그해 옮기고, 위의 막대에서 키나 줄을 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kekunci untuk menyuntingnya. Seret kekunci untuk mengalihkannya, dan tambah kekunci atau baris dari bar di atas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque numa tecla para editá-la. Arraste as teclas para movê-las e adicione teclas ou fileiras pela barra acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь клавиши, чтобы изменить её. Перетаскивайте клавиши, чтобы переместить их, и добавляйте клавиши или ряды на панели сверху."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点按键即可编辑。拖动按键可移动位置，并可从上方栏添加按键或行。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți o tastă pentru a o edita. Trageți tastele pentru a le muta și adăugați chei sau rânduri din bara de mai sus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een toets om deze te bewerken. Versleep toetsen om ze te verplaatsen en voeg toetsen of rijen toe vanuit de balk erboven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點按鍵即可編輯。拖動按鍵可移動位置，並可從上方欄新增按鍵或行。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op 'n sleutel om dit te wysig. Sleep sleutels om hulle te verskuif, en voeg sleutels of rye by vanaf die balk hierbo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij klawisz, aby go edytować. Przeciągnij klawisze, aby je przenieść, i dodaj klucze lub wiersze z paska powyżej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться клавіші, щоб відредагувати її. Перетягуйте клавіші, щоб перемістити їх, і додайте клавіші або рядки з панелі вище."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenlemek için bir tuşa dokunun. Tuşları taşımak için sürükleyin ve yukarıdaki çubuktan tuşları veya satırları ekleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na klávesu ji upravíte. Přetažením kláves je přesuňte a přidejte klávesy nebo řádky z lišty výše."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na kláves ho upravíte. Potiahnutím kláves ich premiestnite a pridajte klávesy alebo riadky z panela vyššie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ένα πλήκτρο για να το επεξεργαστείτε. Σύρετε τα πλήκτρα για να τα μετακινήσετε και προσθέστε πλήκτρα ή σειρές από την παραπάνω γραμμή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en tangent för att redigera den. Dra tangenter för att flytta dem och lägg till nycklar eller rader från fältet ovan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en tast for at redigere den. Træk tasterne for at flytte dem, og tilføj nøgler eller rækker fra bjælken ovenfor."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en tast for å redigere den. Dra tastene for å flytte dem, og legg til taster eller rader fra linjen ovenfor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta näppäintä muokataksesi sitä. Siirrä näppäimiä vetämällä ja lisää avaimia tai rivejä yllä olevasta palkista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk salah satu tombol untuk mengeditnya. Seret tombol untuk memindahkannya, dan tambahkan tombol atau baris dari bilah di atas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào một phím để chỉnh sửa nó. Kéo các phím để di chuyển chúng và thêm các phím hoặc hàng từ thanh phía trên."
          }
        }
      }
    },
    "Tap a key to edit it. This layout is built in, so your first change makes an editable copy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Taste, um sie zu bearbeiten. Dieses Layout ist integriert, daher erstellt deine erste Änderung eine bearbeitbare Kopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una tecla para editarla. Esta distribución viene incluida, así que tu primer cambio crea una copia editable."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta klahvi, et seda muuta. See paigutus on sisseehitatud, seega loob esimene muudatus muudetava koopia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une touche pour la modifier. Cette disposition est intégrée : votre première modification crée une copie modifiable."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy billentyűre a szerkesztéséhez. Ez a kiosztás beépített, így az első változtatás szerkeszthető másolatot hoz létre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un tasto per modificarlo. Questo layout è integrato, quindi la prima modifica crea una copia modificabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーをタップして編集します。この配列は内蔵のため、最初の変更で編集可能なコピーが作られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 탭해 편집하세요. 기본 제공 배열이라 첫 변경 시 편집 가능한 사본이 만들어집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kekunci untuk menyuntingnya. Susun atur ini terbina dalam, jadi perubahan pertama anda membuat salinan yang boleh disunting."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque numa tecla para editá-la. Este layout é integrado, então sua primeira alteração cria uma cópia editável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь клавиши, чтобы изменить её. Это встроенная раскладка, поэтому первое изменение создаст редактируемую копию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点按键即可编辑。这是内置布局，首次更改会创建可编辑的副本。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți o tastă pentru a o edita. Acest aspect este încorporat, astfel încât prima dvs. modificare face o copie editabilă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een toets om deze te bewerken. Deze lay-out is ingebouwd, zodat uw eerste wijziging een bewerkbare kopie oplevert."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點按鍵即可編輯。這是內建佈局，首次更改會建立可編輯的副本。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op 'n sleutel om dit te wysig. Hierdie uitleg is ingebou, so jou eerste verandering skep 'n kopie wat gewysig kan word."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij klawisz, aby go edytować. Ten układ jest wbudowany, więc pierwsza zmiana tworzy edytowalną kopię."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться клавіші, щоб відредагувати її. Цей макет є вбудованим, тому ваша перша зміна робить копію, яку можна редагувати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenlemek için bir tuşa dokunun. Bu düzen yerleşiktir, dolayısıyla ilk değişikliğiniz düzenlenebilir bir kopya oluşturur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na klávesu ji upravíte. Toto rozvržení je zabudováno, takže první změnou vytvoříte upravitelnou kopii."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na kláves ho upravíte. Toto rozloženie je zabudované, takže vaša prvá zmena vytvorí upraviteľnú kópiu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ένα πλήκτρο για να το επεξεργαστείτε. Αυτή η διάταξη είναι ενσωματωμένη, επομένως η πρώτη σας αλλαγή δημιουργεί ένα επεξεργάσιμο αντίγραφο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en tangent för att redigera den. Den här layouten är inbyggd, så din första ändring gör en redigerbar kopia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en tast for at redigere den. Dette layout er indbygget, så din første ændring laver en redigerbar kopi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en tast for å redigere den. Denne layouten er innebygd, så den første endringen gjør en redigerbar kopi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta näppäintä muokataksesi sitä. Tämä asettelu on sisäänrakennettu, joten ensimmäinen muutos tekee muokattavan kopion."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk salah satu tombol untuk mengeditnya. Tata letak ini sudah ada di dalamnya, jadi perubahan pertama Anda membuat salinan dapat diedit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào một phím để chỉnh sửa nó. Bố cục này được tích hợp sẵn nên thay đổi đầu tiên của bạn sẽ tạo thành một bản sao có thể chỉnh sửa được."
          }
        }
      }
    },
    "Tap a point to select it. Its curve handles appear alongside — drag them to bend the line.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un punto para seleccionarlo. Sus manejadores de curva aparecen al lado: arrástralos para curvar la línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un point pour le sélectionner. Ses poignées de courbe apparaissent à côté : faites-les glisser pour courber le tracé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Punkt, um ihn auszuwählen. Seine Kurvengriffe erscheinen daneben – ziehe sie, um die Linie zu biegen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un punto per selezionarlo. Le sue maniglie di curva compaiono accanto: trascinale per piegare la linea."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num ponto para o selecionar. As pegas da curva aparecem ao lado — arraste-as para curvar a linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь точки, чтобы выбрать её. Рядом появятся рычаги кривой — потяните их, чтобы изогнуть линию."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik satu titik untuk memilihnya. Pemegang lengkungnya muncul di sebelah — seret untuk melengkungkan garis."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy pontra a kijelöléséhez. Mellette megjelennek az ívfogói – húzd őket a vonal hajlításához."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "点をタップして選びます。隣に曲線のハンドルが現れるので、ドラッグして線を曲げます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一个节点以选中它。旁边会出现曲线控制柄——拖动它们即可弯曲线条。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점을 탭해 선택하세요. 옆에 곡선 핸들이 나타납니다 — 드래그해 선을 구부리세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta punkti, et see valida. Kõrvale ilmuvad kõvera pidemed – lohista neid joone painutamiseks."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți un punct pentru a-l selecta. Mânerele sale curbe apar alături - trageți-le pentru a îndoi linia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een punt om het te selecteren. De curvehandvatten verschijnen ernaast. Versleep ze om de lijn te buigen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點一個節點以選中它。旁邊會出現曲線控制柄——拖動它們即可彎曲線條。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op 'n punt om dit te kies. Die kurwe-handvatsels verskyn langsaan — sleep hulle om die lyn te buig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij punkt, aby go wybrać. Obok pojawią się uchwyty krzywych — przeciągnij je, aby zagiąć linię."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться точки, щоб вибрати її. Його ручки кривої з’являються поруч — перетягніть їх, щоб зігнути лінію."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçmek için bir noktaya dokunun. Eğri tutamaçları yan tarafta görünür; çizgiyi bükmek için bunları sürükleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na bod jej vyberete. Jeho úchopy křivek se objeví vedle — přetažením čáry ohnete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na bod ho vyberiete. Vedľa sa zobrazia jej úchopy kriviek – potiahnutím ich ohnete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ένα σημείο για να το επιλέξετε. Οι λαβές καμπύλης του εμφανίζονται δίπλα — σύρετέ τις για να λυγίσετε τη γραμμή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en punkt för att välja den. Dess kurvhandtag visas bredvid — dra dem för att böja linjen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på et punkt for at vælge det. Dens kurvede håndtag vises ved siden af ​​- træk dem for at bøje linjen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på et punkt for å velge det. Dens kurvehåndtak vises ved siden av – dra dem for å bøye linjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse piste napauttamalla sitä. Sen kaarevat kahvat näkyvät vierekkäin – taivuta viivaa vetämällä niitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk satu titik untuk memilihnya. Pegangan kurvanya muncul di samping — seret untuk membengkokkan garis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào một điểm để chọn nó. Các điểm điều khiển đường cong của nó xuất hiện dọc theo — kéo chúng để uốn cong đường."
          }
        }
      }
    },
    "Tap a result to open its page and reveal the matching controls.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Ergebnis, um die zugehörige Seite und die passenden Einstellungen zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un resultado para abrir su página y ver los controles correspondientes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta tulemust, et avada selle leht ja näha vastavaid seadeid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un résultat pour ouvrir sa page et afficher les réglages correspondants."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy találatra a hozzá tartozó oldal és beállítások megnyitásához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un risultato per aprire la relativa pagina e mostrare i controlli corrispondenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索結果をタップすると、そのページが開き、該当する設定項目が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 결과를 탭하면 해당 페이지가 열리고 관련 설정 항목이 표시됩니다."
