    "A press lights its neighbours too.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Pers verlig ook sy bure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Anschlag beleuchtet auch die Nachbartasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al pulsar, también se iluminan las teclas vecinas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajutus süütab ka naabrid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une frappe éclaire aussi les touches voisines."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy leütés a szomszédos gombokat is megvilágítja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pressione illumina anche i tasti vicini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押すと隣のキーも一緒に光ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누르면 이웃한 키도 함께 밝아집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu tekanan turut menerangi kekunci sebelah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada toque ilumina também as teclas vizinhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатие подсвечивает и соседние клавиши."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下时相邻按键也会亮起。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O presă își luminează și vecinii."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een pers verlicht ook zijn buren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下時相鄰按鍵也會亮起。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prasa oświetla także swoich sąsiadów."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Преса запалює і своїх сусідів."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir basın komşularını da aydınlatır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tisk osvětluje i své sousedy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačiareň osvetľuje aj svojich susedov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα πιεστήριο ανάβει και τους γείτονές του."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En press lyser upp sina grannar också."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En presse tænder også for sine naboer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En presse lyser også opp naboene sine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehdistö valaisee myös naapureitaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pers juga menerangi tetangganya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một báo chí cũng thắp sáng hàng xóm của nó."
          }
        }
      }
    },
    "A profile remembers your whole setup: how the keyboard behaves, its layout, and how it feels. Save a few and switch between them in one tap. Your theme stays put no matter which one you're on.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Profiel onthou jou hele opstelling: hoe die sleutelbord optree, sy uitleg en hoe dit voel. Stoor 'n paar en wissel met een kraan tussen hulle. Jou tema bly sit, maak nie saak watter een jy is nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Profil merkt sich dein ganzes Setup: wie sich die Tastatur verhält, ihr Layout und wie sie sich anfühlt. Speichere ein paar und wechsle mit einem Tipp zwischen ihnen. Dein Theme bleibt gleich, egal in welchem du bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un perfil recuerda toda tu configuración: cómo se comporta el teclado, su distribución y cómo se siente. Guarda varios y cambia entre ellos con un toque. Tu tema se queda igual sin importar en cuál estés."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiil peab meeles kogu su seadistuse: kuidas klaviatuur käitub, selle paigutuse ja tunnetuse. Salvesta mõni ja vaheta neid ühe puudutusega. Sinu teema jääb samaks, ükskõik millise profiili peal sa oled."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un profil retient toute ta configuration : le comportement du clavier, sa disposition et son ressenti. Enregistres-en plusieurs et passe de l'un à l'autre d'un toucher. Ton thème reste en place peu importe le profil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A profil megjegyzi a teljes beállításodat: hogyan viselkedik a billentyűzet, milyen az elrendezése és milyen érzés használni. Ments el párat, és egy koppintással válts köztük. A témád a helyén marad, bármelyiket is használod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un profilo ricorda tutta la tua configurazione: come si comporta la tastiera, il suo layout e come la senti. Salvane un paio e passa dall'uno all'altro con un tocco. Il tuo tema resta lì, qualunque profilo usi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルは設定をまるごと覚えます。キーボードの動き、レイアウト、感触まで。いくつか保存しておけば、ワンタップで切り替えられます。どれを使ってもテーマはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필은 키보드가 어떻게 움직이는지, 배치는 어떤지, 느낌은 어떤지까지 설정을 통째로 기억해요. 몇 개 저장해 두고 탭 한 번으로 바꿔 쓰세요. 어느 프로필을 쓰든 테마는 그대로예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil mengingati keseluruhan persediaan anda: cara papan kekunci berfungsi, susun aturnya, dan rasanya. Simpan beberapa dan tukar antaranya dengan satu ketikan. Tema anda kekal, tak kira yang mana anda guna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um perfil guarda toda a tua configuração: como o teclado se comporta, o esquema dele e a sensação que dá. Guarda alguns e troca entre eles com um toque. O teu tema fica, seja qual for o perfil em que estás."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль запоминает всю настройку: как ведёт себя клавиатура, её раскладку и ощущения от неё. Сохраните несколько и переключайтесь одним нажатием. Тема остаётся прежней, в каком бы профиле вы ни были."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置会记住你的整套设置：键盘怎么反应、怎么排布、什么手感。存几个，一键就能切。不管切到哪个，你的主题都不变。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un profil își amintește întreaga configurație: cum se comportă tastatura, aspectul acesteia și cum se simte. Salvați câteva și comutați între ele dintr-o singură atingere. Tema dvs. rămâne în continuare, indiferent pe care vă aflați."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een profiel onthoudt uw hele configuratie: hoe het toetsenbord zich gedraagt, de indeling ervan en hoe het aanvoelt. Bewaar er een paar en schakel er met één tik tussen. Je thema blijft staan, ongeacht welk thema je gebruikt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配置會記住你的整套設定：鍵盤怎麼反應、怎麼排布、什麼手感。存幾個，一鍵就能切。不管切到哪個，你的主題都不變。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil zapamiętuje całą konfigurację: zachowanie klawiatury, jej układ i wrażenia. Zaoszczędź kilka i przełączaj się między nimi jednym dotknięciem. Twój motyw pozostanie niezmieniony, niezależnie od tego, na którym się znajdujesz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профіль запам’ятовує всі ваші налаштування: як поводиться клавіатура, її розкладка та відчуття. Збережіть кілька та перемикайтеся між ними одним дотиком. Ваша тема залишається на місці незалежно від того, яку ви обрали."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil tüm kurulumunuzu hatırlar: klavyenin nasıl davrandığını, düzenini ve nasıl hissettiğini. Birkaçını kaydedin ve tek dokunuşla aralarında geçiş yapın. Hangisinde olursanız olun temanız aynı kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil si pamatuje celé vaše nastavení: jak se klávesnice chová, její rozložení a pocit. Ušetřete několik a přepínejte mezi nimi jedním klepnutím. Vaše téma zůstane bez ohledu na to, na kterém jste."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil si zapamätá celé vaše nastavenie: ako sa klávesnica správa, jej rozloženie a ako pôsobí. Uložte si niekoľko a prepínajte medzi nimi jediným klepnutím. Vaša téma zostane zachovaná bez ohľadu na to, na ktorej ste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα προφίλ θυμάται ολόκληρη τη ρύθμισή σας: πώς συμπεριφέρεται το πληκτρολόγιο, τη διάταξή του και πώς αισθάνεται. Αποθηκεύστε μερικά και κάντε εναλλαγή μεταξύ τους με ένα πάτημα. Το θέμα σας παραμένει τοποθετημένο σε όποιο θέμα κι αν βρίσκεστε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En profil kommer ihåg hela din installation: hur tangentbordet beter sig, dess layout och hur det känns. Spara några och växla mellan dem med ett tryck. Ditt tema förblir kvar oavsett vilket du är på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En profil husker hele din opsætning: hvordan tastaturet opfører sig, dets layout og hvordan det føles. Gem nogle få og skift mellem dem med et enkelt tryk. Dit tema bliver siddende, uanset hvilket du er på."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En profil husker hele oppsettet ditt: hvordan tastaturet oppfører seg, dets layout og hvordan det føles. Spar noen få og bytt mellom dem med ett trykk. Temaet ditt blir stående uansett hvilket du er på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiili muistaa koko asetuksesi: miten näppäimistö toimii, sen asettelu ja miltä se tuntuu. Tallenna muutama ja vaihda niiden välillä yhdellä napautuksella. Teemasi pysyy paikallaan riippumatta siitä, kumpaa olet valinnut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil mengingat seluruh pengaturan Anda: bagaimana perilaku keyboard, tata letaknya, dan bagaimana rasanya. Simpan beberapa dan beralih di antara keduanya dalam satu ketukan. Tema Anda tetap sama, apa pun tema yang Anda gunakan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu hình ghi nhớ toàn bộ thiết lập của bạn: cách bàn phím hoạt động, bố cục và cảm giác sử dụng. Lưu một số và chuyển đổi giữa chúng chỉ bằng một lần nhấn. Chủ đề của bạn vẫn được giữ nguyên cho dù bạn đang sử dụng chủ đề nào."
          }
        }
      }
    },
    "A profile saves the whole keyboard: theme, layout, sizes, every setting.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Profiel stoor die hele sleutelbord: tema, uitleg, groottes, elke instelling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Profil sichert die ganze Tastatur: Design, Layout, Größen, jede Einstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un perfil guarda el teclado entero: tema, disposición, tamaños, todos los ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiil salvestab terve klaviatuuri: teema, paigutuse, suurused, iga seade."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un profil enregistre le clavier entier : thème, disposition, tailles, tous les réglages."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy profil az egész billentyűzetet elmenti: témát, elrendezést, méreteket, minden beállítást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un profilo salva tutta la tastiera: tema, layout, dimensioni, ogni impostazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルは、テーマ、レイアウト、サイズなどキーボードの設定をまるごと保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필은 테마와 레이아웃, 크기 등 키보드 설정 전체를 저장합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu profil menyimpan keseluruhan papan kekunci: tema, susun atur, saiz, setiap tetapan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um perfil guarda o teclado inteiro: tema, esquema, tamanhos, todas as definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль сохраняет клавиатуру целиком: тему, раскладку, размеры, все настройки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个配置文件会保存整块键盘：主题、布局、尺寸，每一项设置。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un profil salvează întreaga tastatură: temă, aspect, dimensiuni, fiecare setare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een profiel bewaart het hele toetsenbord: thema, lay-out, formaten, elke instelling."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個配置檔案會儲存整塊鍵盤：主題、佈局、尺寸，每一項設定。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil zapisuje całą klawiaturę: motyw, układ, rozmiary, każde ustawienie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профіль зберігає всю клавіатуру: тему, розкладку, розміри, усі налаштування."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir profil klavyenin tamamını kaydeder: tema, düzen, boyutlar, her ayar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil ukládá celou klávesnici: téma, rozložení, velikosti, každé nastavení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil uloží celú klávesnicu: tému, rozloženie, veľkosti, každé nastavenie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα προφίλ αποθηκεύει ολόκληρο το πληκτρολόγιο: θέμα, διάταξη, μεγέθη, κάθε ρύθμιση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En profil sparar hela tangentbordet: tema, layout, storlekar, varje inställning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En profil gemmer hele tastaturet: tema, layout, størrelser, alle indstillinger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En profil lagrer hele tastaturet: tema, layout, størrelser, alle innstillinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiili tallentaa koko näppäimistön: teeman, asettelun, koot ja kaikki asetukset."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil menyimpan keseluruhan keyboard: tema, tata letak, ukuran, setiap pengaturan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một cấu hình lưu toàn bộ bàn phím: chủ đề, bố cục, kích thước, mọi cài đặt."
          }
        }
      }
    },
    "A quick animation on the letter itself each tap, on top of the key press. Pauses during fast typing.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Vinnige animasie op die letter self elke tik, bo-op die sleuteldruk. Pouses tydens vinnige tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kurze Animation des Buchstabens selbst bei jedem Tippen, zusätzlich zum Tastendruck. Pausiert bei schnellem Tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una animación rápida en la propia letra con cada toque, además de la pulsación de la tecla. Se pausa al escribir rápido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga puudutusega kiire animatsioon tähel endal, lisaks klahvivajutusele. Peatub kiire tipimise ajal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une brève animation de la lettre elle-même à chaque frappe, en plus de la pression de touche. Se met en pause pendant la saisie rapide."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyors animáció magán a betűn minden koppintáskor, a gombnyomás mellett. Gyors gépelés közben szünetel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una breve animazione sulla lettera a ogni tocco, in aggiunta alla pressione del tasto. Si sospende durante la digitazione veloce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー押下に加えて、タップのたびに文字自体に短いアニメーションを表示します。高速入力中は一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 누름과 함께 탭할 때마다 글자 자체에 짧은 애니메이션이 적용됩니다. 빠르게 입력할 때는 일시 중지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Animasi pantas pada huruf itu sendiri setiap ketikan, di samping tekanan kekunci. Terhenti sebentar semasa menaip pantas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma animação rápida na própria letra a cada toque, além da pressão da tecla. Pausa durante a escrita rápida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрая анимация на самой букве при каждом нажатии, поверх нажатия клавиши. Замирает при быстрой печати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次点按时字母本身的快速动画，叠加在按键动画之上。快速输入时会暂停。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O animație rapidă pe litera în sine la fiecare apăsare, în partea de sus a apăsării tastei. Se întrerupe în timpul tastării rapide."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een snelle animatie van de letter zelf bij elke tik, bovenop de toetsaanslag. Pauzeert tijdens snel typen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次點按時字母本身的快速動畫，疊加在按鍵動畫之上。快速輸入時會暫停。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybka animacja samej litery po każdym dotknięciu, po naciśnięciu klawisza. Zatrzymuje się podczas szybkiego pisania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Швидка анімація самої літери при кожному дотику над натисканням клавіші. Робить паузи під час швидкого введення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşa basıldığında her dokunuşta harfin kendisi üzerinde hızlı bir animasyon. Hızlı yazma sırasında duraklar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychlá animace na samotném písmenu při každém klepnutí nad stisknutím klávesy. Pauza během rychlého psaní."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rýchla animácia na samotnom písmene pri každom klepnutí nad stlačením klávesu. Pauza počas rýchleho písania."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια γρήγορη κινούμενη εικόνα στο ίδιο το γράμμα κάθε πάτημα, πάνω από το πάτημα του πλήκτρου. Παύση κατά τη γρήγορη πληκτρολόγηση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En snabb animering på själva bokstaven varje tryck, ovanpå tangenttryckningen. Pausar under snabb skrivning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En hurtig animation på selve bogstavet hvert tryk oven på tastetrykket. Pause under hurtig indtastning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En rask animasjon på selve bokstaven hvert trykk, på toppen av tastetrykket. Pauser under rask skriving."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikaanimaatio itse kirjaimeen jokaisella napautuksella, näppäinpainalluksen päällä. Taukoja nopean kirjoittamisen aikana."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Animasi cepat pada huruf itu sendiri setiap ketukan, di atas penekanan tombol. Jeda saat mengetik cepat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình ảnh động nhanh trên chính chữ cái đó mỗi lần nhấn, bên trên phím bấm. Tạm dừng khi gõ nhanh."
          }
        }
      }
    },
    "A read-only copy from the last time you opened the Clink keyboard. Edit these in iOS Settings.": {
      "comment": "Text replacement settings page. iOS entries are a read-only snapshot shared by the keyboard extension; Settings opens the app settings page.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A read-only copy from the last time you opened the Clink keyboard. Edit these in iOS Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia de consulta de la última vez que abriste el teclado Clink. Puedes editar estas sustituciones en Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie en lecture seule datant de la dernière ouverture du clavier Clink. Modifie ces remplacements dans les Réglages iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine schreibgeschützte Kopie vom letzten Öffnen der Clink-Tastatur. Du kannst diese Ersetzungen in den iOS-Einstellungen bearbeiten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia di sola lettura dell’ultima volta che hai aperto la tastiera Clink. Puoi modificare queste sostituzioni nelle Impostazioni di iOS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cópia só de leitura da última vez que abriste o teclado Clink. Podes editar estas substituições nas Definições do iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия для просмотра, сохранённая при последнем открытии клавиатуры Clink. Изменить эти замены можно в настройках iOS."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan untuk dilihat sahaja daripada kali terakhir anda membuka papan kekunci Clink. Edit penggantian ini dalam Seting iOS."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink billentyűzet legutóbbi megnyitásakor mentett, csak olvasható másolat. Ezeket a szövegcseréket az iOS Beállításokban szerkesztheted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回Clinkキーボードを開いたときの内容です。ここでは閲覧のみ可能です。編集するにはiOSの「設定」を開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是上次打开 Clink 键盘时保存的只读副本。请前往 iOS“设置”进行编辑。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 Clink 키보드를 열었을 때 저장된 읽기 전용 사본입니다. iOS 설정에서 편집할 수 있습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjutuskaitstud koopia ajast, mil viimati Clinki klaviatuuri avasid. Neid asendusi saad muuta iOS-i seadetes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O copie numai în citire de la ultima deschidere a tastaturii Clink. Editați-le în Configurări iOS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een alleen-lezen kopie van de laatste keer dat u het Clink-toetsenbord opende. Bewerk deze in iOS-instellingen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是上次開啟 Clink 鍵盤時儲存的只讀副本。請前往 iOS“設定”進行編輯。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "‘n Lees-enkel-kopie van die laaste keer dat jy die Clink sleutelbord geopen het. Wysig hierdie in iOS Instellings."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia tylko do odczytu z ostatniego otwarcia klawiatury Clink. Edytuj je w Ustawieniach iOS."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія лише для читання з моменту останнього відкриття клавіатури Clink. Відредагуйте їх у налаштуваннях iOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink klavyeyi en son açtığınız zamanın salt okunur kopyası. Bunları iOS Ayarlarında düzenleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie pouze pro čtení z doby, kdy jste naposledy otevřeli klávesnici Clink. Upravte je v Nastavení iOS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kópia len na čítanie z posledného otvorenia klávesnice Clink. Upravte ich v nastaveniach iOS."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα αντίγραφο μόνο για ανάγνωση από την τελευταία φορά που ανοίξατε το πληκτρολόγιο Clink. Επεξεργαστείτε τα στις Ρυθμίσεις iOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En skrivskyddad kopia från senaste gången du öppnade Clink-tangentbordet. Redigera dessa i iOS-inställningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En skrivebeskyttet kopi fra sidste gang, du åbnede Clink-tastaturet. Rediger disse i iOS-indstillinger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En skrivebeskyttet kopi fra forrige gang du åpnet Clink-tastaturet. Rediger disse i iOS-innstillinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain luku -kopio siitä, kun viimeksi avasit Clink-näppäimistön. Muokkaa näitä iOS-asetuksissa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan hanya-baca dari terakhir kali Anda membuka keyboard Clink. Edit ini di Pengaturan iOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao chỉ đọc từ lần cuối bạn mở bàn phím Clink. Chỉnh sửa những điều này trong Cài đặt iOS."
          }
        }
      }
    },
