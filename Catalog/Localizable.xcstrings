    "Drag the handle to resize the strip. Double-tap the strip to start over.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el asa para cambiar el tamaño de la tira. Toca dos veces para empezar de cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse la poignée pour redimensionner la bande. Tape deux fois pour recommencer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh den Griff, um den Streifen zu skalieren. Doppeltippen setzt ihn zurück."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina la maniglia per ridimensionare la striscia. Tocca due volte per ricominciare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta o puxador para redimensionar a faixa. Toca duas vezes para recomeçar."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret pemegang untuk saiz semula jalur. Ketik dua kali untuk mula semula."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd a fogantyút a sáv méretezéséhez. Dupla koppintás újrakezdi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドルをドラッグして帯の大きさを変えます。ダブルタップでやり直し。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动手柄调整条的大小。双击条子即可重来。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핸들을 끌어 띠 크기를 바꿉니다. 두 번 탭하면 처음부터."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista käepidet riba suuruse muutmiseks. Topelt-puuduta riba, et alustada uuesti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяните за ручку, чтобы изменить размер полосы. Дважды коснитесь полосы, чтобы начать заново."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep die handvatsel om die grootte van die strook te verander. Dubbeltik op die strook om oor te begin."
          }
        }
      }
    },
