    "Clipboard, notepad, translate, emoji, calculator. Turn on the ones you want and skip the rest.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenablage, Notizblock, Übersetzen, Emoji, Rechner. Schalt die ein, die du willst, und lass den Rest weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portapapeles, bloc de notas, traducción, emoji, calculadora. Activa los que quieras y deja el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presse-papiers, bloc-notes, traduction, emoji, calculatrice. Active ceux que tu veux et ignore les autres."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vágólap, jegyzettömb, fordítás, emoji, számológép. Kapcsold be, amelyiket szeretnéd, a többit hagyd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appunti, blocco note, traduzione, emoji, calcolatrice. Attiva quelli che vuoi e lascia perdere il resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード、メモ帳、翻訳、絵文字、電卓。使いたいものだけオンにして、あとは飛ばせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드, 메모장, 번역, 이모지, 계산기. 원하는 것만 켜고 나머지는 건너뛰세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan keratan, pad nota, terjemah, emoji, kalkulator. Hidupkan yang anda mahu dan langkau yang lain."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Área de transferência, bloco de notas, tradução, emoji, calculadora. Liga as que quiseres e ignora as restantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер обмена, блокнот, перевод, эмодзи, калькулятор. Включите нужное, остальное пропустите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板、记事本、翻译、表情、计算器。想要哪个就开哪个，其余的跳过。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lõikelaud, märkmik, tõlge, emoji, kalkulaator. Lülita sisse need, mida tahad, ja jäta ülejäänud vahele."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klembord, notaboek, vertaal, emoji's, sakrekenaar. Skakel dié aan wat jy wil hê en slaan die res oor."
          }
        }
      }
    },
    "Clips in this group become ungrouped.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips in dieser Gruppe sind dann nicht mehr gruppiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips de este grupo se quedan sin grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clips de ce groupe seront dégroupés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ebben a csoportban lévő elemek kikerülnek a csoportból."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clip di questo gruppo torneranno senza gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループのクリップはグループなしに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹의 클립은 그룹에서 빠져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip dalam kumpulan ini akan keluar dari kumpulan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os clipes deste grupo deixam de estar agrupados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фрагменты из этой группы останутся без группы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个分组里的剪贴内容会变成没分组的状态。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selles grupis olevad klipid muutuvad grupita."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Knipsels in hierdie groep raak ongegroepeer."
          }
        }
      }
    },
    "Clips pop in a panel over the keys. Tap to paste.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips erscheinen in einem Panel über den Tasten. Tippe zum Einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips aparecen en un panel sobre las teclas: toca para pegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clips apparaissent dans un panneau au-dessus des touches. Touche pour coller."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elemek egy panelen jelennek meg a billentyűk fölött. Koppints a beillesztéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
