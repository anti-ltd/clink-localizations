    "Add a tab of your recently used emoji at the start of the emoji keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg 'n oortjie van jou onlangs gebruikte emoji by die begin van die emoji-sleutelbord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz am Anfang der Emoji-Tastatur einen Tab mit deinen zuletzt benutzten Emojis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una pestaña con los emoji que usaste hace poco al principio del teclado de emoji."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa emoji-klaviatuuri algusesse kaart sinu viimati kasutatud emojidega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un onglet avec tes emoji récents au début du clavier emoji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tedd a nemrég használt emojijaid egy fülre az emoji-billentyűzet elejére."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una scheda con le emoji usate di recente all'inizio della tastiera emoji."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵文字キーボードの先頭に、最近使った絵文字のタブを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이모지 키보드 맨 앞에 최근 쓴 이모지 탭을 넣어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah tab emoji yang baru anda guna di awal papan kekunci emoji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um separador com os teus emoji recentes no início do teclado de emoji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить вкладку недавних эмодзи в начало клавиатуры эмодзи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在表情键盘最前面加一栏你最近用过的表情。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați o filă cu emoji-ul folosit recent la începutul tastaturii emoji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een tabblad van je recent gebruikte emoji toe aan het begin van het emoji-toetsenbord."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在表情鍵盤最前面加一欄你最近用過的表情。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj kartę ostatnio używanego emoji na początku klawiatury emoji."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте вкладку нещодавно використаних емодзі на початку клавіатури емодзі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji klavyesinin başlangıcına son kullandığınız emojilerin bir sekmesini ekleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na začátek klávesnice s emotikony přidejte kartu nedávno použitých emotikonů."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte kartu nedávno použitých emodži na začiatok klávesnice emodži."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε μια καρτέλα του emoji που χρησιμοποιήσατε πρόσφατα στην αρχή του πληκτρολογίου emoji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en flik med din nyligen använda emoji i början av emoji-tangentbordet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en fane med din nyligt brugte emoji i starten af emoji-tastaturet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en fane av din nylig brukte emoji på starten av emoji-tastaturet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää äskettäin käyttämiesi emojien välilehti emoji-näppäimistön alkuun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan tab emoji yang baru-baru ini Anda gunakan di awal papan ketik emoji."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một tab biểu tượng cảm xúc được sử dụng gần đây của bạn vào đầu bàn phím biểu tượng cảm xúc."
          }
        }
      }
    },
    "Add a tab of your recently used emoji to the emoji keyboard. Drag it anywhere you like on the Categories tab.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg 'n oortjie van jou onlangs gebruikte emoji by die emoji-sleutelbord. Sleep dit enige plek waar jy wil op die Kategorieë-oortjie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz einen Tab mit deinen zuletzt benutzten Emojis auf die Emoji-Tastatur. Unter „Kategorien“ ziehst du ihn dorthin, wo du ihn haben willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade al teclado de emoji una pestaña con los que usaste hace poco. En «Categorías» puedes arrastrarla donde quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa emoji-klaviatuurile kaart oma viimati kasutatud emojidega. Lohista see kaardile „Kategooriad\" sinna, kuhu soovid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute au clavier emoji un onglet avec tes emoji récents. Dans « Catégories », fais-le glisser où tu veux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tedd a nemrég használt emojijaidat egy fülre az emoji-billentyűzeten. A „Kategóriák” fülön oda húzod, ahová szeretnéd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi alla tastiera emoji una scheda con quelle usate di recente. In «Categorie» la trascini dove vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近使った絵文字のタブを絵文字キーボードに追加します。「カテゴリ」タブで好きな位置にドラッグできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근에 쓴 이모지 탭을 이모지 키보드에 넣어요. ‘카테고리’ 탭에서 원하는 자리로 끌어다 놓을 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah tab emoji yang baru anda guna pada papan kekunci emoji. Seret ke mana-mana yang anda suka di tab Kategori."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona ao teclado de emoji um separador com os que usaste há pouco. Em «Categorias», arrasta-o para onde quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить вкладку недавних эмодзи на клавиатуру эмодзи. Перетащите её куда угодно на вкладке «Категории»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在表情键盘里加一栏你最近用过的表情。可以在「分类」里拖到你想要的位置。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați o filă cu emoji-ul folosit recent pe tastatura emoji. Trageți-l oriunde doriți în fila Categorii."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een tabblad van je recent gebruikte emoji toe aan het emoji-toetsenbord. Sleep het waar u maar wilt op het tabblad Categorieën."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在表情鍵盤裡加一欄你最近用過的表情。可以在「分類」裡拖到你想要的位置。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj kartę ostatnio używanego emoji do klawiatury emoji. Przeciągnij go w dowolne miejsce na karcie Kategorie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте вкладку з нещодавно використаними смайлами на клавіатуру смайлів. Перетягніть його куди завгодно на вкладці «Категорії»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son kullandığınız emojilerin bir sekmesini emoji klavyesine ekleyin. Kategoriler sekmesinde istediğiniz yere sürükleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte kartu nedávno použitých emotikonů na klávesnici emodži. Přetáhněte jej kamkoli na kartě Kategorie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte kartu nedávno použitých emodži na klávesnicu emodži. Presuňte ho kdekoľvek na karte Kategórie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε μια καρτέλα του emoji που χρησιμοποιήσατε πρόσφατα στο πληκτρολόγιο emoji. Σύρετε το οπουδήποτε θέλετε στην καρτέλα Κατηγορίες."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en flik med din nyligen använda emoji till emoji-tangentbordet. Dra den vart du vill på fliken Kategorier."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en fane med din nyligt brugte emoji til emoji-tastaturet. Træk den hvor som helst du vil på fanen Kategorier."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en fane av din nylig brukte emoji til emoji-tastaturet. Dra den hvor som helst du vil på Kategorier-fanen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää äskettäin käyttämiesi emojien välilehti emoji-näppäimistöön. Vedä se haluamaasi kohtaan Luokat-välilehdessä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan tab emoji yang baru-baru ini Anda gunakan ke keyboard emoji. Seret ke mana pun Anda suka di tab Kategori."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một tab biểu tượng cảm xúc được sử dụng gần đây của bạn vào bàn phím biểu tượng cảm xúc. Kéo nó vào bất kỳ đâu bạn thích trên tab Danh mục."
          }
        }
      }
    },
    "Add a word once and Clink stops fighting it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een keer 'n woord by en Clink hou op om daarmee te veg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füg ein Wort einmal hinzu, und Clink hört auf, dagegen anzukämpfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una palabra una vez y Clink deja de pelear con ella."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa sõna üks kord ja Clink lõpetab selle vastu võitlemise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un mot une fois et Clink arrête de le combattre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add hozzá a szót egyszer, és a Clink többé nem harcol ellene."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una parola una volta e Clink smette di combatterla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語を一度追加すれば、Clinkはもう直そうとしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어를 한 번만 추가하면 Clink가 더는 고치려 하지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah perkataan sekali dan Clink berhenti melawannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona uma palavra uma vez e o Clink deixa de lutar contra ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте слово один раз — и Clink перестанет с ним спорить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把词添加一次，Clink 就不再和它较劲。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă un cuvânt o dată și Clink încetează să lupte cu el."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg één keer een woord toe en Clink stopt ertegen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把詞新增一次，Clink 就不再和它較勁。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj jedno słowo, a Clink przestanie z nim walczyć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте слово один раз, і Clink перестане боротися з ним."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kelimeyi bir kez eklediğinizde Clink onunla mücadele etmeyi bırakır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte slovo jednou a Clink s ním přestane bojovat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte slovo raz a Clink prestane bojovať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε μια λέξη μία φορά και το Clink σταματά να το παλεύει."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till ett ord en gång och Clink slutar bekämpa det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj et ord én gang, og Clink holder op med at bekæmpe det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til et ord én gang, og Clink slutter å kjempe mot det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää sana kerran ja Clink lopettaa taistelun sitä vastaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan satu kata sekali dan Clink berhenti melawannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một từ một lần và Clink sẽ ngừng đấu tranh với từ đó."
          }
        }
      }
    },
