    "Learning happens entirely on this device. Nothing you type is uploaded, and clearing wipes the learned words immediately.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer vind geheel en al op hierdie toestel plaas. Niks wat jy tik word opgelaai nie, en uitvee vee die aangeleerde woorde onmiddellik uit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lernen passiert komplett auf diesem Gerät. Nichts, was du tippst, wird hochgeladen, und beim Löschen sind die gelernten Wörter sofort weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aprendizaje ocurre entero en este dispositivo. Nada de lo que escribes se sube, y al borrar se van las palabras aprendidas al momento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Õppimine toimub täielikult selles seadmes. Midagi, mida tipid, ei laadita üles ja tühjendamine kustutab õpitud sõnad koheselt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apprentissage se fait entièrement sur cet appareil. Rien de ce que tu tapes n'est envoyé, et l'effacement supprime les mots appris tout de suite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tanulás teljes egészében ezen az eszközön történik. Semmi nem kerül fel a netre abból, amit írsz, és ha törlöd, a megtanult szavak azonnal eltűnnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apprendimento avviene tutto su questo dispositivo. Nulla di ciò che scrivi viene caricato, e cancellando elimini subito le parole imparate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習はすべてこのデバイスの中だけで行われます。入力した内容はアップロードされませんし、消去すると学習した単語はすぐに消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학습은 전부 이 기기에서만 이뤄져요. 입력한 내용은 어디에도 올라가지 않고, 지우면 배운 단어도 바로 사라져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelajaran berlaku sepenuhnya pada peranti ini. Apa yang anda taip tak dimuat naik, dan mengosongkannya padam perkataan yang dipelajari serta-merta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aprendizagem acontece toda neste dispositivo. Nada do que escreves é enviado, e ao limpar apagas logo as palavras aprendidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обучение целиком проходит на этом устройстве. Ничего из напечатанного не загружается, а очистка стирает выученные слова сразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学习全在这台设备上进行。你打的东西一点都不会上传，清除会立刻抹掉学过的词。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Învățarea are loc în întregime pe acest dispozitiv. Nimic din ceea ce tastați nu este încărcat, iar ștergerea șterge imediat cuvintele învățate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leren gebeurt volledig op dit apparaat. Niets dat u typt, wordt geüpload en bij het wissen worden de geleerde woorden onmiddellijk gewist."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "學習全在這臺裝置上進行。你打的東西一點都不會上傳，清除會立刻抹掉學過的詞。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauka odbywa się wyłącznie na tym urządzeniu. Nic, co wpiszesz, nie zostanie przesłane, a wyczyszczenie natychmiast usuwa wyuczone słowa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навчання відбувається повністю на цьому пристрої. Ніщо, що ви вводите, не завантажується, а очищення негайно стирає вивчені слова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğrenme tamamen bu cihazda gerçekleşir. Yazdığınız hiçbir şey yüklenmez ve temizleme işlemi öğrenilen kelimeleri anında siler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Učení probíhá výhradně na tomto zařízení. Nic, co zadáte, se nenahraje a vymazáním se naučená slova okamžitě smažou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Učenie prebieha výlučne na tomto zariadení. Nič, čo zadáte, sa neodovzdá a vymazaním sa naučené slová okamžite vymažú."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μάθηση γίνεται εξ ολοκλήρου σε αυτήν τη συσκευή. Τίποτα που πληκτρολογείτε δεν μεταφορτώνεται και η εκκαθάριση διαγράφει αμέσως τις λέξεις που μαθαίνετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inlärning sker helt och hållet på den här enheten. Inget du skriver laddas upp, och när du rensar raderas de inlärda orden omedelbart."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læring sker udelukkende på denne enhed. Intet, du skriver, bliver uploadet, og rydning sletter de lærte ord med det samme."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Læring skjer utelukkende på denne enheten. Ingenting du skriver blir lastet opp, og sletting sletter de lærte ordene umiddelbart."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppiminen tapahtuu kokonaan tällä laitteella. Mitään kirjoittamaasi ei ladata, ja tyhjennys pyyhkii opitut sanat välittömästi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelajaran terjadi sepenuhnya di perangkat ini. Tidak ada yang Anda ketik yang diunggah, dan penghapusan kata-kata yang dipelajari akan segera dihapus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc học diễn ra hoàn toàn trên thiết bị này. Không có nội dung nào bạn nhập được tải lên và việc xóa sẽ xóa sạch các từ đã học ngay lập tức."
          }
        }
      }
    },
    "Learning is optional. Words you teach Clink stay in the App Group.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer is opsioneel. Woorde wat jy vir Clink leer bly in die App Group."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lernen ist optional. Wörter, die du Clink beibringst, bleiben in der App Group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aprendizaje es opcional. Las palabras que le enseñas a Clink se quedan en el App Group."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Õppimine on valikuline. Sõnad, mida sa Clinkile õpetad, jäävad App Groupi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apprentissage est facultatif. Les mots que tu apprends à Clink restent dans l'App Group."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tanulás nem kötelező. Amit megtanítasz a Clinknek, az az App Groupban marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imparare è facoltativo. Le parole che insegni a Clink restano nell'App Group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習を使うかどうかは自由です。Clink に教えた単語は App Group の中に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학습은 선택이에요. Clink에 알려준 단어는 App Group 안에만 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelajaran ini pilihan. Perkataan yang anda ajar Clink kekal dalam App Group."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprender é opcional. As palavras que ensinas ao Clink ficam no App Group."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обучение необязательно. Слова, которым вы научили Clink, остаются в App Group."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学词是可选的。你教给 Clink 的词只留在 App Group 里。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Învățarea este opțională. Cuvintele pe care le predați Clink rămân în Grupul de aplicații."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leren is optioneel. Woorden die je Clink leert, blijven in de App Group."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "學詞是可選的。你教給 Clink 的詞只留在 App Group 裡。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauka jest opcjonalna. Słowa, których uczysz Clink, pozostają w grupie aplikacji."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навчання необов'язкове. Слова, яким ви навчаєте Clink, залишаються в групі додатків."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğrenme isteğe bağlıdır. Clink'e öğrettiğiniz kelimeler Uygulama Grubunda kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Učení je volitelné. Slova, která naučíte Clink, zůstávají ve skupině aplikací."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Učenie je voliteľné. Slová, ktoré naučíte Clink, zostávajú v skupine aplikácií."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μάθηση είναι προαιρετική. Οι λέξεις που διδάσκετε στο Clink παραμένουν στην Ομάδα Εφαρμογών."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inlärning är valfritt. Ord du lär Clink stannar i appgruppen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læring er valgfrit. Ord, du lærer Clink, bliver i App-gruppen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Læring er valgfritt. Ord du lærer Clink forblir i App Group."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppiminen on valinnaista. Sanat, joita opetat Clink, pysyvät sovellusryhmässä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belajar adalah opsional. Kata-kata yang Anda ajarkan Clink tetap berada di Grup Aplikasi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc học là tùy chọn. Những từ bạn dạy Clink vẫn nằm trong Nhóm ứng dụng."
          }
        }
      }
    },
