    "Set the key, text and background colors, and give light and dark separate looks.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stel die sleutel-, teks- en agtergrondkleure, en gee lig en donker aparte voorkoms."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg die Farben für Tasten, Text und Hintergrund fest und gib Hell und Dunkel jeweils ein eigenes Aussehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define los colores de teclas, texto y fondo, y dale a claro y oscuro aspectos distintos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Määra klahvi, teksti ja tausta värvid ning anna heledale ja tumedale eraldi ilme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définis les couleurs des touches, du texte et de l'arrière-plan, et donne au clair et au sombre un rendu distinct."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsd be a billentyűk, a szöveg és a háttér színét, és adj a világosnak és a sötétnek külön megjelenést."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta i colori di tasti, testo e sfondo, e dai a chiaro e scuro un aspetto ciascuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー、文字、背景の色を決め、ライトとダークにそれぞれの見た目を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키와 글자, 배경 색을 정하고, 밝은 모드와 어두운 모드에 각각 다른 모습을 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan warna kekunci, teks dan latar belakang, dan berikan mod cerah serta gelap rupa masing-masing."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Define as cores das teclas, do texto e do fundo, e dá ao claro e ao escuro aspetos separados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте цвета клавиш, текста и фона и сделайте светлому и тёмному виду разное оформление."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定按键、文字和背景的颜色，再给浅色和深色各配一套样子。"
          }
        }
      }
    },
    "Set the key, text and background colours, and give light and dark separate looks.": {
