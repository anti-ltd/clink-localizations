            "value": "Não há nenhuma subscrição associada a esta conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К этому аккаунту не привязана ни одна подписка."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada langganan dipautkan kepada akaun ini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehhez a fiókhoz nincs előfizetés kapcsolva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントに紐づいているサブスクリプションはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户尚未关联任何订阅。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에 연결된 구독이 없습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle kontoga pole seotud ühtegi tellimust."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Niciun abonament nu este asociat acestui cont."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen abonnement aan dit account gekoppeld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號尚未連結任何訂閱。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen intekening is aan hierdie rekening gekoppel nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z tym kontem nie jest powiązana żadna subskrypcja."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До цього облікового запису не прив’язано жодної підписки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesaba bağlı bir abonelik yok."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S tímto účtem není propojeno žádné předplatné."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "S týmto účtom nie je prepojené žiadne predplatné."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει συνδρομή συνδεδεμένη με αυτόν τον λογαριασμό."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen prenumeration är kopplad till det här kontot."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke knyttet et abonnement til denne konto."
          }
        },
        "nb": {
