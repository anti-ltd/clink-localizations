    "Punctuate what I say and tighten it. Same meaning, fewer words.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Punteer wat ek sê en maak dit strenger. Dieselfde betekenis, minder woorde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz die Zeichensetzung und straff es. Gleiche Aussage, weniger Worte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntúa lo que digo y condénsalo. Mismo sentido, menos palabras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pane kirjavahemärgid ja tõmba kokku. Sama tähendus, vähem sõnu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponctue ce que je dis et resserre-le. Même sens, moins de mots."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tedd ki a központozást, és tömörítsd. Ugyanaz az értelem, kevesebb szó."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punteggia quello che dico e stringilo. Stesso senso, meno parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容に句読点をつけて引き締めて。意味はそのまま、言葉は少なく。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 말한 내용에 문장부호를 넣고 간결하게 줄여 줘. 뜻은 그대로, 말은 짧게."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Letak tanda baca pada apa yang saya sebut dan padatkannya. Makna sama, kata lebih sedikit."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontua o que digo e condensa. Mesmo sentido, menos palavras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расставить знаки препинания и подтянуть сказанное. Тот же смысл, меньше слов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给我说的加上标点并精简。意思不变，字数更少。"
          }
        }
      }
    },
