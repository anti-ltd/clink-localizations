    "Copy a complete prompt, paste it into any chat assistant, then paste its reply back here. No provider or API key is needed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia un prompt completo, pégalo en cualquier asistente de chat y luego pega aquí su respuesta. No hace falta proveedor ni clave de API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez une requête complète, collez-la dans n’importe quel assistant de conversation, puis collez sa réponse ici. Aucun fournisseur ni clé d’API n’est nécessaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere einen vollständigen Prompt, füge ihn in einen beliebigen Chat-Assistenten ein und füge dessen Antwort hier wieder ein. Ein Anbieter oder API-Schlüssel ist nicht nötig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia un prompt completo, incollalo in un qualsiasi assistente di chat, poi incolla qui la sua risposta. Non servono provider né chiave API."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie um prompt completo, cole-o em qualquer assistente de chat e depois cole a resposta aqui. Não é preciso provedor nem chave de API."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте полный запрос, вставьте его в любой чат-ассистент, а затем вставьте его ответ сюда. Провайдер и ключ API не нужны."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin gesaan lengkap, tampal ke mana-mana pembantu sembang, kemudian tampal jawapannya di sini. Tiada pembekal atau kunci API diperlukan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Másold ki a teljes promptot, illeszd be bármelyik csevegőasszisztensbe, majd illeszd ide a válaszát. Nincs szükség szolgáltatóra vagy API-kulcsra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全なプロンプトをコピーして任意のチャットアシスタントに貼り付け、その返答をここに貼り付けます。プロバイダやAPIキーは不要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制完整提示词，粘贴到任意聊天助手，再把它的回复粘贴回这里。无需服务商或 API 密钥。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 프롬프트를 복사해 원하는 챗 어시스턴트에 붙여넣은 다음, 그 답변을 여기에 붙여넣으세요. 제공자나 API 키가 필요 없습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopeeri terviklik viip, kleebi see mis tahes vestlusassistenti ja kleebi selle vastus siia tagasi. Teenusepakkujat ega API-võtit pole vaja."
          }
        }
      }
    },
