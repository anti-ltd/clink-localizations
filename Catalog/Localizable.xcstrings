    "How much your finger can move during a hold before it registers as a swipe instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit sich dein Finger beim Halten bewegen darf, bevor es stattdessen als Wischen gilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto puede moverse tu dedo durante una pulsación antes de que cuente como deslizamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De combien ton doigt peut bouger pendant un maintien avant que ce soit compris comme un balayage."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyit mozdulhat az ujjad tartás közben, mielőtt inkább húzásként érzékeli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto può muoversi il dito durante una pressione prima che valga come uno scorrimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押し中に指が動いても、スワイプと見なされずにいられる範囲です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누르고 있는 동안 손가락이 얼마나 움직여야 스와이프로 바뀌는지예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak jari anda boleh gerak masa tahan sebelum ia dikira sebagai leret pula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto o teu dedo se pode mexer durante uma pressão antes de contar como deslize."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько палец может сдвинуться во время удержания, прежде чем это будет засчитано как скольжение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住时手指能动多少，超过就当成滑动了。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui palju su sõrm võib hoidmise ajal liikuda, enne kui see registreeritakse pühkimisena."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoeveel jou vinger tydens 'n hou kan beweeg voordat dit eerder as 'n swiep registreer."
          }
        }
      }
    },
    "How predictive text changes as you type. Morph reshapes each word in place like the native iOS suggestion bar.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie sich Textvorschläge beim Tippen verändern. Morphing formt jedes Wort an Ort und Stelle um, wie die native iOS-Vorschlagsleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo cambia el texto predictivo mientras escribes. Transformación remodela cada palabra en su sitio, como la barra de sugerencias nativa de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment le texte prédictif évolue pendant la saisie. Transformation remodèle chaque mot sur place, comme la barre de suggestions native d'iOS."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Így változik a prediktív szöveg gépelés közben. Az Átalakulás minden szót a helyén formál át, akár a natív iOS javaslatsáv."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come cambia il testo predittivo mentre scrivi. Trasformazione rimodella ogni parola sul posto, come la barra dei suggerimenti nativa di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力中の予測テキストの変わり方。モーフは純正iOSの候補バーのように、各単語をその場で変形させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력할 때 예측 텍스트가 바뀌는 방식입니다. 모프는 기본 iOS 추천 바처럼 각 단어를 제자리에서 변형합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cara teks ramalan berubah semasa anda menaip. Morf membentuk semula setiap perkataan di tempatnya seperti bar cadangan asli iOS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como o texto preditivo muda enquanto escreve. Transformação remodela cada palavra no lugar, como a barra de sugestões nativa do iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как подсказки меняются по ходу печати. «Перетекание» перестраивает каждое слово на месте, как родная строка подсказок iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入时预测文本的变化方式。“变形”会像 iOS 原生建议栏一样就地重塑每个词。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuidas ennustav tekst tipimise käigus muutub. Ümberkujundus muudab iga sõna kohapeal, nagu iOS-i süsteemne soovituseriba."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoe voorspellende teks verander soos jy tik. Morph hervorm elke woord in plek soos die inheemse iOS-voorstelbalk."
          }
        }
      }
    },
    "How quickly repeat accelerates to max speed. Higher gets there faster.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie schnell die Wiederholung auf volle Geschwindigkeit kommt. Höher ist schneller da."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con qué rapidez la repetición llega a la velocidad máxima. Más alto llega antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quelle vitesse la répétition atteint sa vitesse max. Plus haut y arrive plus vite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Milyen gyorsan gyorsul fel az ismétlés a maximális sebességre. A magasabb hamarabb odaér."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto in fretta la ripetizione arriva alla velocità massima. Più alto ci arriva prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リピートが最高速に上がるまでの速さです。高いほど早くそこに届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복이 최고 속도까지 얼마나 빨리 붙는지예요. 높을수록 더 빨리 도달해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selaju mana ulangan memecut ke kelajuan maksimum. Lagi tinggi lagi cepat sampai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com que rapidez a repetição acelera até à velocidade máxima. Mais alto chega lá mais depressa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как быстро повтор разгоняется до максимума. Больше — быстрее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复删除加速到最快有多快。数值越高到得越快。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui kiiresti kordus kiireneb maksimumini. Kõrgem jõuab sinna kiiremini."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoe vinnig herhaal versnel tot maksimum spoed. Hoër kom vinniger daar."
          }
        }
      }
    },
    "How strongly predictions affect the hitboxes. Lower is subtle, higher pushes the bias harder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark Vorhersagen die Trefferflächen beeinflussen. Niedriger ist dezent, höher drückt die Tendenz kräftiger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con qué fuerza las predicciones cambian las áreas táctiles. Más bajo es sutil, más alto empuja más el sesgo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quel point les prédictions influent sur les zones de frappe. Plus bas, c'est subtil ; plus haut, ça force le biais."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyire erősen hatnak az előrejelzések a találati zónákra. Az alacsonyabb finom, a magasabb erősebben tolja a torzítást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto le previsioni influiscono sulle aree di tocco. Più basso è discreto, più alto spinge di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測がタップ範囲に与える影響の強さです。低いと控えめ、高いと偏りが強く出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예측이 터치 영역에 얼마나 세게 영향을 주는지예요. 낮으면 은은하고, 높으면 더 강하게 밀어붙여요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuat mana ramalan mempengaruhi kotak sentuh. Lagi rendah lagi halus, lagi tinggi tolak berat sebelah lebih kuat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com que força as previsões afetam as áreas táteis. Mais baixo é subtil, mais alto puxa mais pela tendência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько сильно предсказания влияют на зоны нажатия. Меньше — едва заметно, больше — смещение жёстче."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预测对点击区域的影响有多强。越低越不明显，越高偏向越猛。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui tugevasti ennustused tabamustsoone mõjutavad. Madalam on peen, kõrgem surub kaldu tugevamini."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoe sterk beïnvloed voorspellings die hitboxes. Laer is subtiel, hoër druk die vooroordeel harder."
          }
        }
      }
    },
    "How the delete key reacts to each deletion, including every step while held down.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie die Löschtaste auf jedes Löschen reagiert, einschließlich jedes Schritts beim Gedrückthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo reacciona la tecla de eliminar a cada eliminación, incluido cada paso mientras la mantienes pulsada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment la touche Supprimer réagit à chaque suppression, y compris à chaque étape lorsqu'elle est maintenue."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Így reagál a törlőgomb minden törlésre, a nyomva tartás minden lépését is beleértve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come il tasto elimina reagisce a ogni cancellazione, compreso ogni passaggio mentre lo tieni premuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除のたびに削除キーがどう反応するか。長押し中の各ステップにも適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제할 때마다 삭제 키가 반응하는 방식으로, 길게 누르는 동안의 모든 단계에도 적용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cara kekunci padam bertindak balas pada setiap pemadaman, termasuk setiap langkah semasa ditekan lama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como a tecla Eliminar reage a cada eliminação, incluindo cada passo enquanto é mantida premida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как клавиша удаления отзывается на каждое удаление, в том числе на каждом шаге при удержании."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除键对每次删除的反应方式，包括长按期间的每一步。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuidas kustutusklahv reageerib igale kustutamisele, sealhulgas igale sammule allhoidmise ajal."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoe die delete-sleutel op elke uitvee reageer, insluitend elke stap terwyl dit ingehou word."
          }
        }
      }
    },
    "How the key moves when pressed. Only applies when Bloom is on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie sich die Taste beim Drücken bewegt. Gilt nur, wenn Bloom aktiviert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo se mueve la tecla al pulsarla. Solo se aplica cuando Bloom está activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment la touche bouge quand elle est pressée. S'applique uniquement lorsque Bloom est activé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Így mozog a gomb lenyomáskor. Csak bekapcsolt Bloom mellett érvényes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come si muove il tasto quando viene premuto. Si applica solo con Bloom attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
