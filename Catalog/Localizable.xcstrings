            "value": "Perubahan di sini hanya digunakan pada penampilan ini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az itteni módosítások csak erre a megjelenésre vonatkoznak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでの変更は、この外観にのみ適用されます。"
          }
        },
        "zh-Hans": {
