    "Preview the theme below, then choose whether to import it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau dir das Design unten in der Vorschau an und entscheide dann, ob du es importierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira el tema abajo y luego decide si lo importas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévisualise le thème ci-dessous, puis choisis de l'importer ou non."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézd meg lent a téma előnézetét, aztán döntsd el, importálod-e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda l'anteprima del tema qui sotto, poi decidi se importarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下でテーマをプレビューしてから、読み込むかどうか選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에서 테마를 미리 보고, 가져올지 정해 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratonton tema di bawah, kemudian pilih sama ada nak import atau tidak."
          }
        },
        "pt": {
