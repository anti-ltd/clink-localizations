    "Sets key height to %lld pt and matches this theme's spacing.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel sleutelhoogte op %lld pt en pas hierdie tema se spasiëring toe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt die Tastenhöhe auf %lld pt und übernimmt die Abstände dieses Designs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija la altura de tecla en %lld pt y aplica el espaciado de este tema."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Määrab klahvi kõrguseks %lld pt ja võtab üle selle teema vahed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle la hauteur des touches sur %lld pt et reprend les espacements de ce thème."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűmagasságot %lld pt értékre állítja, és átveszi a téma térközeit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta l'altezza dei tasti su %lld pt e applica le spaziature di questo tema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの高さを%lld ptにし、このテーマの間隔に合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 높이를 %lld pt로 설정하고 이 테마의 간격을 적용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menetapkan tinggi kekunci kepada %lld pt dan menyamai jarak tema ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Define a altura das teclas em %lld pt e aplica o espaçamento deste tema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задаёт высоту клавиш %lld pt и отступы из этой темы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将按键高度设为 %lld pt，并采用此主题的间距。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setează înălțimea cheii la %lld pt și se potrivește cu spațierea acestei teme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt de sleutelhoogte in op %lld pt en komt overeen met de spatiëring van dit thema."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將按鍵高度設為 %lld pt，並採用此主題的間距。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia wysokość klucza na %lld pt i dopasowuje odstępy tego motywu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлює висоту ключа на %lld pt і відповідає інтервалу цієї теми."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar yüksekliğini %lld pt olarak ayarlar ve bu temanın aralığıyla eşleşir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví výšku klíče na %lld pt a odpovídá rozestupu tohoto motivu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví výšku kľúča na %lld pt a zhoduje sa s rozostupom tejto témy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορίζει το ύψος του κλειδιού σε %lld pt και ταιριάζει με το διάστημα αυτού του θέματος."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställer in nyckelhöjden till %lld pt och matchar detta temas avstånd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstiller nøglehøjden til %lld pt og matcher dette temas mellemrum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Setter nøkkelhøyde til %lld pt og samsvarer med dette temaets avstand."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettaa näppäimen korkeudeksi %lld pt ja vastaa tämän teeman väliä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyetel tinggi kunci ke %lld pt dan mencocokkan spasi tema ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt chiều cao phím thành %lld pt và khớp với khoảng cách của chủ đề này."
          }
        }
      }
    },
