    "Trace a word by gliding across the letters. Lift to insert it. Tapping still works normally.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek 'n woord na deur oor die letters te gly. Lig om dit in te voeg. Tik werk steeds normaal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne ein Wort, indem du über die Buchstaben gleitest. Heb den Finger, um es einzufügen. Tippen geht weiterhin ganz normal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traza una palabra deslizando el dedo por las letras. Levántalo para insertarla. Tocar sigue funcionando igual."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Joonista sõna tähtede peal libisedes. Tõsta sõrm, et see sisestada. Puudutamine töötab endiselt tavaliselt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace un mot en glissant sur les lettres. Lève le doigt pour l'insérer. Le toucher marche toujours normalement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajzolj egy szót úgy, hogy végigcsúszol a betűkön. Emeld fel az ujjad a beszúráshoz. A koppintás továbbra is működik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia una parola scorrendo sulle lettere. Solleva il dito per inserirla. Il tocco funziona ancora come sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字の上を指でなぞって単語を書きます。指を離すと挿入されます。タップも今までどおり使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자 위를 쭉 미끄러뜨려서 단어를 그려요. 손을 떼면 입력돼요. 그냥 톡톡 누르는 것도 잘 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejak perkataan dengan meluncur merentasi huruf. Angkat untuk memasukkannya. Mengetik masih berfungsi seperti biasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traça uma palavra deslizando pelas letras. Levanta o dedo para a inserir. Tocar continua a funcionar como sempre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите по буквам, чтобы очертить слово. Поднимите палец — оно вставится. Обычные нажатия при этом работают как всегда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在字母上滑一下就能划出一个单词，抬起手指就插入。点按照样能用。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasează un cuvânt alunecând peste litere. Ridicați pentru a o introduce. Atingerea încă funcționează normal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Traceer een woord door over de letters te glijden. Til het op om het in te brengen. Het tikken werkt nog steeds normaal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在字母上滑一下就能劃出一個單詞，抬起手指就插入。點按照樣能用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź słowo, przesuwając się po literach. Podnieś, aby go włożyć. Stukanie nadal działa normalnie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведіть слово, ковзаючи по літерах. Підніміть, щоб вставити його. Натискання все ще працює нормально."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harflerin üzerinde kaydırarak bir kelimenin izini sürün. Takmak için kaldırın. Dokunma hala normal şekilde çalışıyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte slovo klouzáním po písmenech. Zvednutím jej vložíte. Klepání stále funguje normálně."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obkresľujte slovo kĺzaním po písmenách. Nadvihnutím ho vložíte. Poklepanie stále funguje normálne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανιχνεύστε μια λέξη περνώντας στα γράμματα. Σηκώστε για να το τοποθετήσετε. Το πάτημα εξακολουθεί να λειτουργεί κανονικά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spåra ett ord genom att glida över bokstäverna. Lyft för att sätta in den. Tappning fungerar fortfarande normalt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spor et ord ved at glide hen over bogstaverne. Løft for at indsætte det. Tapning fungerer stadig normalt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spor et ord ved å gli over bokstavene. Løft for å sette den inn. Tapping fungerer fortsatt normalt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jäljitä sana liukumalla kirjainten yli. Aseta se nostamalla. Koputus toimii edelleen normaalisti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lacak sebuah kata dengan meluncur melintasi huruf-huruf. Angkat untuk memasukkannya. Penyadapan masih berfungsi normal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi một từ bằng cách lướt qua các chữ cái. Nhấc lên để chèn nó. Nhấn vẫn hoạt động bình thường."
          }
        }
      }
    },
