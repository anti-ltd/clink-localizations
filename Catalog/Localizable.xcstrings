    "From Home, open Themes, then scroll to Background.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne auf Start die Seite Themes und scrolle zu Hintergrund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde Inicio, abre Temas y baja hasta Fondo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava avalehel „Teemad” ja keri jaotiseni „Taust”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis Accueil, ouvre Thèmes, puis fais défiler jusqu’à Arrière-plan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kezdőlapon nyisd meg a Témák oldalt, majd görgess a Háttér részhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da Home, apri Temi e scorri fino a Sfondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ホーム」から「テーマ」を開き、「背景」までスクロールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘홈’에서 ‘테마’를 열고 ‘배경’까지 스크롤하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari Utama, buka Tema, kemudian tatal ke Latar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de Início, abre Temas e desloca-te até Fundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На главной странице откройте «Темы» и прокрутите до раздела «Фон»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“主页”打开“主题”，然后滚动到“背景”。"
          }
        }
      }
    },
