          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースキーを長押しするとキーがトラックパッドに。自由になぞってカーソルを動かせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스바를 누르고 있으면 키가 트랙패드로 변해요. 아무 데나 미끄러뜨려 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan bar ruang dan kekunci bertukar menjadi trackpad. Luncur ke mana-mana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a barra de espaço premida e as teclas tornam-se um trackpad. Desliza para onde quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержите пробел — и клавиши станут трекпадом. Ведите куда угодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住空格键，键盘就变成触控板，随意滑动。"
          }
        }
      }
    },
    "Hold the space bar, then slide left and right to move the cursor.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
