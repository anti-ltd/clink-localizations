    "Imported automations stay off. Importing never grants plugin permissions.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las automatizaciones importadas quedan desactivadas. La importación nunca concede permisos a los plugins."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les automatisations importées restent désactivées. L’importation n’accorde jamais d’autorisations aux plugins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importierte Automationen bleiben deaktiviert. Ein Import erteilt Plugins keine Berechtigungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le automazioni importate restano disattivate. L’importazione non concede mai autorizzazioni ai plugin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As automações importadas ficam desativadas. Importar nunca concede permissões aos plugins."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортированные автоматизации остаются выключенными. Импорт не выдаёт разрешений плагинам."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Automasi yang diimport kekal dimatikan. Import tidak memberikan kebenaran pemalam."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az importált automatizálások kikapcsolva maradnak. Az importálás nem ad engedélyt a bővítményeknek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んだオートメーションは無効のままです。読み込みによってプラグインに権限が付与されることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的自动化保持关闭。导入不会授予插件权限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 자동화는 꺼진 상태로 유지됩니다. 가져오기로 플러그인 권한이 부여되지는 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Imporditud automaatikad jäävad välja lülitatuks. Import ei anna pistikprogrammidele õigusi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatizările importate rămân dezactivate. Importul nu acordă niciodată permisiuni pentru plugin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geïmporteerde automatiseringen blijven uitgeschakeld. Importeren geeft nooit toestemming voor plug-ins."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入的自動化保持關閉。匯入不會授予外掛許可權。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingevoerde outomatisasies bly afgeskakel. Invoer verleen nooit inprop-toestemmings nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaimportowane automatyzacje pozostają wyłączone. Importowanie nigdy nie zapewnia uprawnień wtyczek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортована автоматика залишається вимкненою. Імпорт ніколи не надає дозволи плагіну."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarılan otomasyonlar kapalı kalır. İçe aktarma hiçbir zaman eklenti izinleri vermez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Importované automatizace zůstávají vypnuté. Import nikdy neudělí oprávnění pluginu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Importované automatizácie zostávajú vypnuté. Import nikdy neudelí povolenia doplnku."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εισαγόμενοι αυτοματισμοί παραμένουν εκτός λειτουργίας. Η εισαγωγή δεν παρέχει ποτέ δικαιώματα προσθήκης."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Importerade automatiseringar förblir avstängda. Importering ger aldrig pluginbehörigheter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Importerede automatiseringer forbliver slukket. Import giver aldrig plugin-tilladelser."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importert automatisering forblir av. Importering gir aldri plugin-tillatelser."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuodut automaatiot pysyvät poissa. Tuonti ei koskaan anna laajennuksille käyttöoikeuksia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatisasi yang diimpor tetap tidak aktif. Mengimpor tidak pernah memberikan izin plugin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động hóa nhập khẩu không hoạt động. Việc nhập không bao giờ cấp quyền cho plugin."
          }
        }
      }
    },
