    "Stops Clink's microphone session.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet die Mikrofonsitzung von Clink."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene la sesión de micrófono de Clink."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lõpetab Clinki mikrofoniseansi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête la session microphone de Clink."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Leállítja a Clink mikrofon-munkamenetét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe la sessione del microfono di Clink."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkのマイクセッションを終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink의 마이크 세션을 종료합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghentikan sesi mikrofon Clink."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina a sessão de microfone do Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершает сеанс работы Clink с микрофоном."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止 Clink 的麦克风会话。"
          }
        }
      }
    },
    "Stops the light getting bright enough to swallow the letter on the key. Turn off for the boldest color.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keer dat die lig helder genoeg word om die letter op die sleutel te sluk. Skakel af vir die sterkste kleur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass das Licht so hell wird, dass es den Buchstaben auf der Taste verschluckt. Aus für die kräftigste Farbe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que la luz sea tan intensa que se coma la letra de la tecla. Desactívalo para el color más intenso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoiab ära, et valgus muutuks nii eredaks, et see neelaks klahvil oleva tähe. Lülita välja kõige julgema värvi jaoks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche la lumière de devenir si vive qu'elle avale la lettre sur la touche. Désactivez pour la couleur la plus intense."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megakadályozza, hogy a fény elnyomja a gombon lévő betűt. Kapcsold ki a legerősebb színért."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita che la luce diventi così intensa da inghiottire la lettera sul tasto. Disattiva per il colore più intenso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの文字が光に飲まれない明るさに抑えます。オフにすると最も鮮やかな色になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛이 키의 글자를 삼킬 만큼 밝아지지 않게 합니다. 끄면 색이 가장 진해집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghalang cahaya menjadi terlalu terang sehingga menelan huruf pada kekunci. Matikan untuk warna paling berani."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede que a luz fique tão intensa que engula a letra da tecla. Desliga para a cor mais intensa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не даёт свету стать настолько ярким, чтобы поглотить букву на клавише. Выключите для самого насыщенного цвета."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免灯光亮到吞掉按键上的字母。关闭可获得最浓的色彩。"
          }
        }
      }
    },
