        }
      }
    },
    "Every setting goes back to how Clink shipped. Your themes, profiles, and saved words are kept.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke instelling gaan terug na hoe Clink gestuur het. Jou temas, profiele en gestoorde woorde word gehou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Einstellungen gehen zurück auf den Auslieferungszustand von Clink. Deine Themes, Profile und gespeicherten Wörter bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los ajustes vuelven a como venía Clink. Tus temas, perfiles y palabras guardadas se mantienen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga seadistus naaseb Clinki väljalaskeolekusse. Sinu teemad, profiilid ja salvestatud sõnad jäävad alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les réglages reviennent à l’état d’origine de Clink. Tes thèmes, profils et mots enregistrés sont conservés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden beállítás visszaáll arra, ahogy a Clink érkezett. A témáid, profiljaid és mentett szavaid megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le impostazioni tornano com’era Clink all’inizio. Temi, profili e parole salvate restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定はすべて Clink の初期状態に戻ります。テーマ、プロファイル、保存した単語はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정이 모두 Clink의 처음 상태로 돌아갑니다. 테마, 프로필, 저장한 단어는 그대로 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua tetapan kembali kepada keadaan asal Clink. Tema, profil dan perkataan simpanan anda kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as definições voltam ao estado em que o Clink veio. Os teus temas, perfis e palavras guardadas ficam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все настройки вернутся к тому, какими Clink был из коробки. Темы, профили и сохранённые слова останутся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有设置都会回到 Clink 出厂时的状态。你的主题、配置文件和已保存的词会保留。"
          }
        }
      }
    },
    "Every tap is recorded against the key you meant.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke tik word opgeneem teen die sleutel wat jy bedoel het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Tipper wird der Taste zugeordnet, die du gemeint hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada toque se registra en la tecla que querías pulsar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga vajutus salvestatakse klahvi vastu, mida tahtsid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque appui est enregistré sur la touche que tu visais."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden koppintás ahhoz a billentyűhöz kerül, amelyikre gondoltál."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni tocco viene registrato sul tasto che volevi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップはすべて、意図したキーに紐づけて記録されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 탭이 원래 누르려던 키에 기록됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap ketikan direkodkan pada kekunci yang anda maksudkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada toque fica registado na tecla que querias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое нажатие записывается напротив той клавиши, в которую вы целились."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次点按都会记在你原本想按的那个键上。"
          }
        }
      }
    },
    "Every time the keyboard opens, shortcuts get loaded into memory. Short strings expand to full phrases and show up as suggestions.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke keer as die sleutelbord oopmaak, word kortpaaie in die geheue gelaai. Kort stringe brei uit na volledige frases en verskyn as voorstelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mal, wenn die Tastatur öffnet, werden Kürzel in den Speicher geladen. Kurze Zeichenfolgen werden zu ganzen Phrasen und erscheinen als Vorschläge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que se abre el teclado, los atajos se cargan en memoria. Las cadenas cortas se expanden a frases completas y aparecen como sugerencias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga kord, kui klaviatuur avaneb, laaditakse otseteed mällu. Lühendid laienevad täisfraasideks ja ilmuvad soovitustena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À chaque ouverture du clavier, les raccourcis sont chargés en mémoire. Les chaînes courtes se développent en phrases complètes et apparaissent dans les suggestions."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahányszor megnyílik a billentyűzet, a rövidítések betöltődnek a memóriába. A rövid karakterláncok teljes kifejezésekké bővülnek, és javaslatként jelennek meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni volta che la tastiera si apre, le scorciatoie vengono caricate in memoria. Le stringhe brevi si espandono in frasi complete e compaiono come suggerimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードを開くたびに、ショートカットがメモリに読み込まれます。短い文字列が完全なフレーズに展開され、候補として表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 열릴 때마다 단축어가 메모리에 올라와요. 짧은 문자열이 완전한 문구로 확장돼서 추천으로 나와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap kali papan kekunci dibuka, pintasan dimuatkan ke dalam memori. Rentetan pendek berkembang jadi frasa penuh dan muncul sebagai cadangan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre que o teclado abre, os atalhos são carregados na memória. Textos curtos expandem-se em frases completas e aparecem como sugestões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При каждом открытии клавиатуры сокращения загружаются в память. Короткие строки разворачиваются в полные фразы и появляются в подсказках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次键盘打开时，快捷替换都会加载进内存。短字符串会展开成完整短语，并作为建议出现。"
          }
        }
      }
    },
    "Every tool has its own page, with the switch at the top and everything it can do underneath.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke instrument het sy eie bladsy, met die skakelaar aan die bokant en alles wat dit kan doen daaronder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Werkzeug hat seine eigene Seite: oben der Schalter, darunter alles, was es kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada herramienta tiene su propia página: el interruptor arriba y todo lo que sabe hacer debajo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Igal tööriistal on oma leht: üleval lüliti, all kõik, mida ta oskab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque outil a sa page : l'interrupteur en haut, et tout ce qu'il sait faire en dessous."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden eszköznek saját oldala van: fent a kapcsoló, alatta minden, amit tud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni strumento ha la sua pagina: in alto l'interruttore, sotto tutto quello che sa fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールごとにページがあり、上部にスイッチ、その下にできることが並びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구마다 자기 페이지가 있고, 위에 스위치, 아래에 할 수 있는 일이 모여 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap alat ada halamannya sendiri, dengan suis di atas dan segala kebolehannya di bawah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ferramenta tem a sua página: o interruptor em cima e tudo o que sabe fazer por baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого инструмента своя страница: переключатель сверху, всё остальное — под ним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个工具都有自己的页面：开关在上面，能做的事在下面。"
          }
        }
      }
    },
    "Everyday typing works without Full Access. Turn it on for clipboard access, custom **clink** sound packs, haptics and GIF browsing.": {
      "comment": "GIF browser UI and accessibility. Native-speaker editorial sign-off for this release is tracked in docs/gif-tool-localization-review.md.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyday typing works without Full Access. Turn it on for clipboard access, custom **clink** sound packs, haptics and GIF browsing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes escribir normalmente sin Acceso completo. Actívalo para acceder al portapapeles, usar packs de sonidos personalizados de **clink**, activar la respuesta háptica y explorar GIFs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux taper normalement sans l’Accès complet. Active-le pour accéder au presse-papiers, utiliser les packs de sons personnalisés **clink**, profiter du retour haptique et parcourir des GIFs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normales Tippen funktioniert ohne Vollzugriff. Aktiviere ihn für den Zugriff auf die Zwischenablage, eigene **clink**-Soundpakete, Haptik und das Durchsuchen von GIFs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi scrivere normalmente senza Accesso completo. Attivalo per accedere agli appunti, usare i pacchetti di suoni personalizzati **clink**, il feedback aptico e sfogliare GIF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes escrever normalmente sem Acesso total. Ativa-o para aceder à área de transferência, usar pacotes de sons personalizados **clink**, resposta háptica e explorar GIFs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычный ввод работает без Полного доступа. Включите его для доступа к буферу обмена, пользовательских звуковых наборов **clink**, тактильного отклика и просмотра GIF."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penaipan biasa berfungsi tanpa Akses penuh. Hidupkannya untuk mengakses papan klip, menggunakan pek bunyi tersuai **clink**, maklum balas haptik dan melayari GIF."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szokásos gépelés Teljes hozzáférés nélkül is működik. A vágólap eléréséhez, az egyéni **clink** hangcsomagokhoz, a rezgéses visszajelzéshez és a GIF-ek böngészéséhez kapcsold be."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の入力はフルアクセスなしでも利用できます。クリップボード、カスタムの**clink**サウンドパック、触覚フィードバック、GIFの閲覧を使うには、フルアクセスをオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日常输入无需“完全访问”。如需访问剪贴板、使用自定义 **clink** 声音包、触感反馈或浏览 GIF，请开启此权限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반적인 입력은 전체 접근 없이도 가능해요. 클립보드 접근, 사용자 설정 **clink** 사운드 팩, 햅틱, GIF 둘러보기를 사용하려면 전체 접근을 켜세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavaline kirjutamine töötab ilma täisjuurdepääsuta. Luba see lõikelaua, kohandatud **clink**-helipakettide, puutetagasiside ja GIF-ide sirvimise kasutamiseks."
          }
        }
      }
    },
    "Everything": {
