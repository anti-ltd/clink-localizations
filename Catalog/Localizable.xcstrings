    "Preview the theme below, then choose whether to import it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorbeskou die tema hieronder en kies dan of jy dit wil invoer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau dir das Design unten in der Vorschau an und entscheide dann, ob du es importierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira el tema abajo y luego decide si lo importas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaata teemat all eelnevalt ja otsusta siis, kas importida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévisualise le thème ci-dessous, puis choisis de l'importer ou non."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézd meg lent a téma előnézetét, aztán döntsd el, importálod-e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda l'anteprima del tema qui sotto, poi decidi se importarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下でテーマをプレビューしてから、読み込むかどうか選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에서 테마를 미리 보고, 가져올지 정해 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratonton tema di bawah, kemudian pilih sama ada nak import atau tidak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê a pré-visualização do tema abaixo e depois decide se o queres importar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите тему ниже и решите, импортировать ли её."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先在下面预览这个主题，再决定要不要导入。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Previzualizați tema de mai jos, apoi alegeți dacă o importați."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk hieronder een voorbeeld van het thema en kies vervolgens of u het wilt importeren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先在下面預覽這個主題，再決定要不要匯入。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetl podgląd motywu poniżej, a następnie zdecyduj, czy chcesz go zaimportować."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляньте тему нижче та виберіть, чи імпортувати її."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki temayı önizleyin ve ardından içe aktarılıp aktarılmayacağını seçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prohlédněte si níže uvedený motiv a poté zvolte, zda jej chcete importovat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukážte si motív nižšie a potom vyberte, či ho chcete importovať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε προεπισκόπηση του θέματος παρακάτω και, στη συνέχεια, επιλέξτε εάν θα το εισαγάγετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förhandsgranska temat nedan och välj sedan om du vill importera det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se et eksempel på temaet nedenfor, og vælg derefter, om du vil importere det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhåndsvis temaet nedenfor, og velg om du vil importere det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esikatsele alla olevaa teemaa ja valitse sitten, tuodaanko se."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau tema di bawah, lalu pilih apakah akan mengimpornya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem trước chủ đề bên dưới, sau đó chọn có nhập chủ đề đó hay không."
          }
        }
      }
    },
