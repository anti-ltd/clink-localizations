    "Retune the selected switch. Drag the pad for pitch and tone.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el sonido del interruptor seleccionado. Arrastra sobre el panel para cambiar la altura y el timbre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste le son du mécanisme sélectionné. Fais glisser sur le pavé pour régler la hauteur et le timbre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe den Klang des gewählten Schalters an. Zieh auf dem Feld, um Tonhöhe und Klangfarbe zu ändern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola il suono dell’interruttore selezionato. Trascina sul riquadro per modificare altezza e timbro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste o som do interruptor selecionado. Arraste no painel para alterar a altura e o timbre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте звук выбранного переключателя. Перетаскивайте по полю, чтобы менять высоту и тембр."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laraskan bunyi suis yang dipilih. Seret pada pad untuk mengubah pic dan warna nada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangold át a kiválasztott kapcsolót. A felületen húzva állíthatod a hangmagasságot és a hangszínt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したスイッチの音を調整します。パッドをドラッグして音の高さと音色を変えられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调节所选轴体的声音。拖动面板可调整音高和音色。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 스위치의 소리를 조정합니다. 패드를 드래그하여 음높이와 음색을 바꿔 보세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seadista valitud lüliti heli. Helikõrguse ja kõlavärvi muutmiseks lohista puutealal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reajustați comutatorul selectat. Trageți pad-ul pentru ton și ton."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel de geselecteerde schakelaar opnieuw af. Versleep de pad voor toonhoogte en toon."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調節所選軸體的聲音。拖動面板可調整音高和音色。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel die geselekteerde skakelaar weer in. Sleep die raakvlak vir toonhoogte en klankkleur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostrój ponownie wybrany przełącznik. Przeciągnij pad, aby ustawić wysokość i ton."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переналаштуйте вибраний перемикач. Перетягніть панель для висоти та тону."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen anahtarı yeniden ayarlayın. Perde ve ton için pedi sürükleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přelaďte vybraný přepínač. Přetáhněte pad pro výšku a tón."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prelaďte vybraný prepínač. Potiahnite pad pre výšku a tón."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συντονίστε ξανά τον επιλεγμένο διακόπτη. Σύρετε το pad για τον τόνο και τον τόνο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in den valda omkopplaren igen. Dra knappen för tonhöjd och ton."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genindstil den valgte kontakt. Træk tastaturet for tonehøjde og tone."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Still inn den valgte bryteren på nytt. Dra puten for tonehøyde og tone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viritä valittu kytkin uudelleen. Vedä tyynyä saadaksesi äänenkorkeuden ja sävyn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setel ulang sakelar yang dipilih. Seret bantalan untuk nada dan nada."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều chỉnh lại công tắc đã chọn. Kéo miếng đệm để điều chỉnh cao độ và âm sắc."
          }
        }
      }
    },
