    "Built-in themes can’t be changed. We’ll make an editable copy of it for you to tweak.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingeboude temas kan nie verander word nie. Ons sal 'n redigeerbare kopie daarvan maak vir jou om aan te pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Integrierte Themes lassen sich nicht ändern. Wir erstellen dir eine bearbeitbare Kopie zum Anpassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los temas integrados no se pueden modificar. Te haremos una copia editable para que la ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisseehitatud teemasid ei saa muuta. Me teeme sinu jaoks muudetava koopia, mida kohandada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les thèmes intégrés ne peuvent pas être modifiés. On va t'en faire une copie modifiable à personnaliser."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beépített témák nem módosíthatók. Készítünk belőle egy szerkeszthető másolatot, amit már alakíthatsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I temi integrati non si possono modificare. Ne creeremo una copia modificabile per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵テーマは変更できません。編集できるコピーを作成するので、そちらを調整してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 테마는 수정할 수 없어요. 편집 가능한 복사본을 만들어 드릴 테니 그걸 손보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema terbina dalam tidak boleh diubah. Kami akan buat salinan boleh edit untuk anda ubah suai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os temas integrados não podem ser alterados. Vamos criar-te uma cópia editável para ajustares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенные темы менять нельзя. Мы сделаем её копию, которую можно править."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置主题不能修改。我们会给你生成一份可编辑的副本，随便调整。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Temele încorporate nu pot fi modificate. Vom face o copie editabilă a acesteia pe care o puteți modifica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingebouwde thema's kunnen niet worden gewijzigd. We maken er een bewerkbare kopie van die u kunt aanpassen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內建主題不能修改。我們會給你生成一份可編輯的副本，隨便調整。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wbudowanych motywów nie można zmieniać. Zrobimy jego edytowalną kopię, abyś mógł ją ulepszyć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вбудовані теми не можна змінити. Ми зробимо його редаговану копію, яку ви зможете налаштувати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerleşik temalar değiştirilemez. İnce ayar yapabilmeniz için bunun düzenlenebilir bir kopyasını oluşturacağız."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vestavěné motivy nelze změnit. Vytvoříme pro vás upravitelnou kopii, kterou si můžete upravit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vstavané motívy sa nedajú zmeniť. Vytvoríme pre vás upraviteľnú kópiu, ktorú si môžete upraviť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ενσωματωμένα θέματα δεν μπορούν να αλλάξουν. Θα δημιουργήσουμε ένα επεξεργάσιμο αντίγραφό του για να το τροποποιήσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbyggda teman kan inte ändras. Vi kommer att göra en redigerbar kopia av den för dig att finjustera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indbyggede temaer kan ikke ændres. Vi laver en redigerbar kopi af den, så du kan finjustere den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innebygde temaer kan ikke endres. Vi lager en redigerbar kopi av den som du kan finpusse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisäisiä teemoja ei voi muuttaa. Teemme siitä muokattavan kopion, jota voit muokata."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema bawaan tidak dapat diubah. Kami akan membuat salinan yang dapat diedit untuk Anda sesuaikan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể thay đổi chủ đề tích hợp. Chúng tôi sẽ tạo một bản sao có thể chỉnh sửa của nó để bạn chỉnh sửa."
          }
        }
      }
    },
