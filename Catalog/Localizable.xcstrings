    "Type a few words, then open AI to rewrite, proofread, or change the tone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp ein paar Wörter, dann öffne die KI, um sie umzuschreiben, zu prüfen oder den Ton zu ändern."
          }
        },
        "es": {
          "stringUnit": {
