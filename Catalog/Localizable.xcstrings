    "One bar of your recent emoji. Pick how many fit.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een balk van jou onlangse emosiekone. Kies hoeveel pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Balken mit deinen zuletzt genutzten Emojis. Wähle, wie viele passen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra con tus emojis recientes. Elige cuántos caben."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üks riba sinu viimaste emojidega. Vali, mitu mahub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une barre de tes emojis récents. Choisis combien en afficher."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy sáv a legutóbbi emojikkal. Állítsd be, hány fér el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra con le emoji recenti. Scegli quante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近使った絵文字のバーです。いくつ並べるか選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 이모지 한 줄입니다. 몇 칸인지 고르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu bar emoji terkini anda. Pilih berapa yang muat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma barra com os teus emojis recentes. Escolhe quantos cabem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна полоса ваших недавних эмодзи. Выберите, сколько поместится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一条最近表情栏。自己选能放几个。"
          }
        }
      }
    },
    "One card covers the keys and the space around them.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een kaart dek die sleutels en die spasie rondom hulle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte deckt die Tasten und den Platz um sie herum ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola tarjeta cubre las teclas y el espacio a su alrededor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üks kaart katab klahvid ja nende ümber oleva ruumi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule carte couvre les touches et l'espace autour."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen kártya fedi le a billentyűket és a körülöttük lévő helyet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola scheda copre i tasti e lo spazio attorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーと、その周囲の余白は一枚のカードにまとまっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키와 그 주변 여백은 카드 하나에 모여 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu kad merangkumi kekunci dan ruang di sekelilingnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um só cartão cobre as teclas e o espaço à volta delas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна карточка накрывает клавиши и пространство вокруг них."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键和它们周围的空间都在同一张卡片里。"
          }
        }
      }
    },
    "One clean line in your theme color.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een skoon lyn in jou temakleur."
          }
