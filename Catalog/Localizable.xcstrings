            "value": "La langue que cette disposition écrit. Change celle qu'elle utilise dans Langues."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyelv, amit ez az elrendezés ír. Hogy melyiket használja, a Nyelvek alatt állítod."
          }
        },
        "it": {
          "stringUnit": {
