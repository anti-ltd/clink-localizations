            "value": "Przytrzymaj spację, a następnie przesuń w lewo i w prawo, aby przesunąć kursor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте пробіл, потім проведіть ліворуч і праворуч, щоб перемістити курсор."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluk çubuğunu basılı tutun, ardından imleci hareket ettirmek için sola ve sağa kaydırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte mezerník a posuňte kurzor doleva a doprava."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the space bar, then slide left and right to move the cursor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε το πλήκτρο διαστήματος και, στη συνέχεια, σύρετε αριστερά και δεξιά για να μετακινήσετε τον κέρσορα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll ned mellanslagstangenten och dra sedan åt vänster och höger för att flytta markören."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold mellemrumstasten, og skub derefter til venstre og højre for at flytte markøren."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold mellomromstasten, og skyv deretter til venstre og høyre for å flytte markøren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä välilyöntinäppäintä painettuna ja siirrä kohdistinta liu'uttamalla vasemmalle ja oikealle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan bilah spasi, lalu geser ke kiri dan kanan untuk menggerakkan kursor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ phím cách, sau đó trượt sang trái và phải để di chuyển con trỏ."
          }
        }
      }
    },
