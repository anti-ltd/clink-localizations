    "Set Width to how far in you want the keys to come.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel die breedte in op hoe ver jy wil hê die sleutels moet kom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell die Breite darauf ein, wie weit die Tasten hereinrücken sollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el Ancho a lo que quieras que se acerquen las teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Määra Laius sellele, kui kaugele klahvid sisse tuleksid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle la Largeur selon la distance dont tu veux rapprocher les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Szélességgel add meg, mennyire húzódjanak beljebb a billentyűk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la Larghezza a quanto vuoi che i tasti si avvicinino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「幅」で、キーをどこまで内側に寄せるかを決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너비로 키를 얼마나 안쪽으로 당길지 정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan Lebar mengikut sejauh mana anda mahu kekunci masuk ke dalam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta a Largura conforme queiras as teclas mais para dentro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте «Ширину» — насколько клавиши должны сдвинуться внутрь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用“宽度”决定按键往里收多少。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setați Lățimea la cât de departe doriți să ajungă cheile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel Breedte in op hoe ver u wilt dat de toetsen komen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用“寬度”決定按鍵往裡收多少。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw Szerokość na głębokość, na jaką mają wchodzić klawisze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановіть Width (Ширина) на те, наскільки далеко ви хочете, щоб ключі заходили."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genişlik'i tuşların ne kadar uzağa gelmesini istediğinize ayarlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte Šířku na to, jak daleko chcete klíče dostat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte šírku podľa toho, ako ďaleko chcete, aby sa klávesy dostali."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρυθμίστε το Width στο πόσο μακριά θέλετε να έρθουν τα κλειδιά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in Bredd på hur långt in du vill att nycklarna ska komma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstil Bredde til, hvor langt ind du vil have tasterne til at komme."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Still inn Bredde til hvor langt inn du vil at nøklene skal komme."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta Leveys kuinka pitkälle haluat avainten tulevan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur Lebar ke seberapa jauh Anda ingin kuncinya masuk."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt Chiều rộng thành khoảng cách bạn muốn các phím đến."
          }
        }
      }
    },
