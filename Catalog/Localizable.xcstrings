    "Runtime checks use sample inputs. Test the draft before enabling it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Laufzeitprüfungen verwenden Beispieleingaben. Teste den Entwurf, bevor du ihn aktivierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las comprobaciones usan datos de ejemplo. Prueba el borrador antes de activarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Käituskontrollid kasutavad näidissisendeid. Testi mustandit enne selle lubamist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vérifications utilisent des données d’exemple. Teste le brouillon avant de l’activer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A futásidejű ellenőrzések mintaadatokat használnak. Engedélyezés előtt teszteld a vázlatot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I controlli in esecuzione usano dati di esempio. Prova la bozza prima di attivarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行時の検証にはサンプル入力を使用しています。有効にする前に下書きをテストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 검사는 예제 입력을 사용합니다. 활성화하기 전에 초안을 테스트하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semakan masa jalan menggunakan input contoh. Uji draf sebelum mengaktifkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As verificações usam dados de exemplo. Testa o rascunho antes de o ativares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверки выполняются на примерах входных данных. Протестируйте черновик перед включением."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行检查使用的是示例输入。启用前请测试草稿。"
          }
        }
      }
    },
