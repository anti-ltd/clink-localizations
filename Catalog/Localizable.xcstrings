    "The download didn’t finish. Check your connection and try again.": {
      "comment": "Android-only: a translation or handwriting model download failed; the button under it retries. Translations drafted for the Android port; native-speaker review required before release. Add to clink-index.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aflaai het nie voltooi nie. Kontroleer jou verbinding en probeer weer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stahování se nedokončilo. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
