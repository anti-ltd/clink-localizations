    "Empty slots stay blank if you have fewer tools on.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Leë gleuwe bly leeg as jy minder gereedskap aan het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leere Plätze bleiben frei, wenn weniger Tools an sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los huecos vacíos se quedan en blanco si tienes menos herramientas activas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tühjad kohad jäävad tühjaks, kui sul on vähem tööriistu sees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les emplacements restants restent vides si tu actives moins d’outils."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az üres helyek üresek maradnak, ha kevesebb eszköz van bekapcsolva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli slot vuoti restano vuoti se hai meno strumenti attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンのツールが少ないと、空き枠は空のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켠 도구가 더 적으면 빈 칸은 비어 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Slot kosong kekal kosong jika lebih sedikit alat dihidupkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os espaços vazios ficam em branco se tiveres menos ferramentas ligadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пустые ячейки остаются пустыми, если включено меньше инструментов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开的工具较少时，空位保持空白。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fantele goale rămân goale dacă aveți mai puține unelte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege slots blijven leeg als je minder gereedschap hebt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟的工具較少時，空位保持空白。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Puste miejsca pozostają puste, jeśli masz mniej narzędzi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порожні слоти залишаються порожніми, якщо у вас менше інструментів."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha az aletiniz varsa boş yuvalar boş kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud máte méně nástrojů, prázdné sloty zůstanou prázdné."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak máte menej nástrojov, prázdne sloty zostanú prázdne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι κενές υποδοχές παραμένουν κενές εάν έχετε λιγότερα εργαλεία."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomma platser förblir tomma om du har färre verktyg på dig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomme pladser forbliver tomme, hvis du har færre værktøjer på."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomme spor forblir tomme hvis du har færre verktøy på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyhjät paikat pysyvät tyhjinä, jos käytössäsi on vähemmän työkaluja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Slot kosong akan tetap kosong jika peralatan Anda lebih sedikit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các khe trống vẫn trống nếu bạn có ít công cụ hơn."
          }
        }
      }
    },
    "Empty slots stay blank until you copy more text.": {
      "extractionState": "manual",
      "localizations": {
