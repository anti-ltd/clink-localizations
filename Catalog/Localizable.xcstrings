          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhľadávanie obrázkov GIF dosiahlo svoj hodinový limit. Skúste to znova neskôr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναζήτηση GIF έχει φτάσει το ωριαίο όριο. Δοκιμάστε ξανά αργότερα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
