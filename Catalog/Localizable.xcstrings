    "Capitalization, apostrophes, quotes, and spacing tidy up as you type.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoofletters, apostrofe, aanhalingstekens en spasiëring maak netjies terwyl jy tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Großschreibung, Apostrophe, Anführungszeichen und Abstände werden beim Tippen aufgeräumt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayúsculas, apóstrofos, comillas y espaciado se ordenan mientras escribes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Suurtäht, ülakoma, jutumärgid ja vahed korrastuvad tipimise käigus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Majuscules, apostrophes, guillemets et espacement se corrigent pendant que tu écris."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nagybetűk, aposztrófok, idézőjelek és szóközök gépelés közben rendbe jönnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Maiuscole, apostrofi, virgolette e spaziatura si sistemano mentre scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大文字化、アポストロフィ、引用符、スペースが入力しながら整います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대문자, 아포스트로피, 따옴표, 띄어쓰기가 입력하는 동안 알아서 정리돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Huruf besar, tanda koma atas, tanda petik dan jarak dikemaskan semasa anda menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Maiúsculas, apóstrofos, aspas e espaçamento organizam-se enquanto escreves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заглавные буквы, апострофы, кавычки и пробелы приводятся в порядок прямо по ходу печати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大小写、撇号、引号和间距会在你打字时自动整理好。"
          }
        }
      }
    },
    "Capitalization, punctuation, and the symbol page's return to letters, handled while you type.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Großschreibung, Zeichensetzung und die Rückkehr von der Symbolseite zu den Buchstaben, alles beim Tippen erledigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayúsculas, puntuación y la vuelta a las letras desde la página de símbolos, resueltas mientras escribes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Suurtähed, kirjavahemärgid ja sümbolilehelt tähtede juurde naasmine, kõik see käib tipimise ajal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Majuscules, ponctuation et retour aux lettres depuis la page des symboles, gérés pendant que tu tapes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagybetűk, központozás és a szimbólumoldalról a betűkhöz való visszatérés, mindezt gépelés közben intézi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Maiuscole, punteggiatura e ritorno alle lettere dalla pagina dei simboli, gestiti mentre scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大文字化、句読点、記号ページから文字への復帰を、入力しながら処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대문자, 구두점, 기호 페이지에서 문자로 돌아가기까지 입력하는 동안 알아서 처리해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Huruf besar, tanda baca dan kembali ke huruf daripada halaman simbol, diuruskan semasa anda menaip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Maiúsculas, pontuação e o regresso às letras a partir da página de símbolos, tratados enquanto escreves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заглавные буквы, пунктуация и возврат к буквам со страницы символов, всё это делается по ходу печати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大小写、标点，以及从符号页返回字母，都在你打字时自动处理。"
          }
        }
      }
    },
    "Capitalize the first letter of a sentence.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoofletter die eerste letter van 'n sin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den ersten Buchstaben eines Satzes großschreiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon en mayúscula la primera letra de cada frase."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjuta lause esimene täht suure algustähega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mets une majuscule à la première lettre d'une phrase."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagybetűvel írja a mondat első betűjét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrive in maiuscolo la prima lettera di una frase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文の最初の文字を大文字にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문장 첫 글자를 대문자로 써요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Besarkan huruf pertama setiap ayat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Põe a primeira letra da frase em maiúscula."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делать первую букву предложения заглавной."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把句子的首字母改成大写。"
          }
        }
      }
    },
