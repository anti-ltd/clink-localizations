          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnite kulisu, aby sa zobrazovala aplikácia, do ktorej píšete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιήστε το Backdrop για να εμφανιστεί η εφαρμογή που πληκτρολογείτε."
