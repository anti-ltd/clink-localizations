    "Reduce Motion (Accessibility) is on, so the light holds still. Presses still light up.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducir movimiento está activado en Accesibilidad, por lo que la luz permanece fija. Las pulsaciones siguen iluminándose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire les animations est activé dans Accessibilité, donc la lumière reste fixe. Les touches s’allument toujours à l’appui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bewegung reduzieren“ ist unter Bedienungshilfen aktiv, deshalb bleibt das Licht unbewegt. Tastendrücke leuchten weiterhin auf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci movimento è attivo in Accessibilità, quindi la luce resta ferma. I tasti si illuminano ancora alla pressione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzir movimento está ativo em Acessibilidade, pelo que a luz fica estática. As teclas continuam a iluminar-se ao premir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Универсальном доступе включено уменьшение движения, поэтому подсветка неподвижна. Нажатия по-прежнему подсвечиваются."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurangkan Pergerakan dihidupkan dalam Kebolehcapaian, jadi cahaya tidak bergerak. Kekunci masih menyala apabila ditekan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kisegítő lehetőségekben be van kapcsolva a Mozgás csökkentése, ezért a fény nem mozog. A leütések továbbra is felvillannak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アクセシビリティ」の「視差効果を減らす」がオンのため、光の動きを止めています。キーを押したときの点灯は続きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“辅助功能”中的“减弱动态效果”已开启，灯光保持静止。按键按下时仍会亮起。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용의 동작 줄이기가 켜져 있어 빛이 움직이지 않습니다. 키를 누르면 계속 빛납니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hõlbustuse liikumise vähendamine on sisse lülitatud, seega valgus ei liigu. Vajutused süütavad endiselt valguse."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducerea mișcării (accesibilitatea) este activată, astfel încât lumina rămâne nemișcată. Presele încă se aprind."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweging verminderen (Toegankelijkheid) is ingeschakeld, dus het licht blijft stil. Drukken lichten nog steeds op."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“輔助功能”中的“減弱動態效果”已開啟，燈光保持靜止。按鍵按下時仍會亮起。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Verminder beweging\" (Toeganklikheid) is aan, dus bly die liggie stil. Drukke laat dit steeds lig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcja Redukuj ruch (dostępność) jest włączona, więc światło pozostaje nieruchome. Prasy nadal się świecą."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зменшити рух (спеціальні можливості) увімкнено, тому світло залишається нерухомим. Преси ще світяться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketi Azalt (Erişilebilirlik) açık olduğundan ışık sabit kalır. Presler hala yanıyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omezit pohyb (přístupnost) je zapnutá, takže světlo zůstává nehybné. Lisy stále svítí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Redukcia pohybu (prístupnosť) je zapnutá, takže svetlo zostane nehybné. Lisy stále svietia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Reduce Motion (Accessibility) είναι αναμμένο, οπότε το φως παραμένει ακίνητο. Τα πατήματα συνεχίζουν να ανάβουν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducera rörelse (tillgänglighet) är på, så lampan håller stilla. Pressar lyser fortfarande."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducer Motion (Accessibility) er tændt, så lyset holder stille. Pressene lyser stadig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduser bevegelse (tilgjengelighet) er på, så lyset holder stille. Trykkene lyser fortsatt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce Motion (Accessibility) on päällä, joten valo pysyy paikallaan. Painekkeet palavat edelleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurangi Gerakan (Aksesibilitas) aktif, sehingga lampu tetap diam. Mesin press masih menyala."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giảm chuyển động (Trợ năng) đang bật nên đèn vẫn giữ nguyên. Máy ép vẫn sáng."
          }
        }
      }
    },
    "Reduce Motion is on in Accessibility. The glass fill stays, but the liquid merge, press bloom, and ambient motion don't run.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verminder beweging is aan in Toeganklikheid. Die glasvulsel bly, maar die vloeistof smelt saam, druk bloei, en omringende beweging loop nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Bedienungshilfen ist „Bewegung reduzieren“ aktiv. Die Glasfüllung bleibt, aber flüssiges Verschmelzen, Aufblühen beim Tippen und Umgebungsbewegung laufen nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Reducir movimiento» está activado en Accesibilidad. El relleno de cristal se mantiene, pero la fusión líquida, el destello al pulsar y el movimiento ambiental no se ejecutan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hõlbustustes on Liigutuste vähendamine sees. Klaastäide jääb, aga vedelsulamine, vajutuse bloom ja õhustikuliikumine ei tööta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Réduire les animations » est activé dans Accessibilité. Le remplissage en verre reste, mais la fusion liquide, la floraison à l'appui et le mouvement d'ambiance ne s'exécutent pas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kisegítő lehetőségeknél be van kapcsolva a Mozgás csökkentése. Az üvegkitöltés marad, de a folyékony összeolvadás, a lenyomási felvillanás és a háttérmozgás nem fut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Riduci movimento» è attivo in Accessibilità. Il riempimento in vetro resta, ma fusione liquida, fioritura alla pressione e movimento ambientale non vengono eseguiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティで「視差効果を減らす」がオンです。ガラスの塗りは残り、リキッドの融合、押した瞬間の広がり、環境アニメーションは動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용에서 ‘동작 줄이기’가 켜져 있습니다. 유리 채움은 남고 리퀴드 병합, 누를 때의 번짐, 배경 움직임은 실행되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Kurangkan Gerakan’ dihidupkan dalam Kebolehaksesan. Isian kaca kekal, tetapi gabungan cecair, kembang ketika ditekan dan gerakan latar tidak berjalan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«Reduzir movimento» está ativado na Acessibilidade. O preenchimento de vidro fica, mas a fusão líquida, o brilho ao tocar e o movimento ambiente não são executados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Универсальном доступе» включено «Уменьшение движения». Стеклянная заливка остаётся, но жидкое слияние, свечение при нажатии и фоновое движение не работают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能中已开启「减弱动态效果」。玻璃填充保留，但液态融合、按下绽放和环境动效都不会运行。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducerea mișcării este activată în Accesibilitate. Umplutura de sticlă rămâne, dar lichidul se îmbină, apăsați înflorirea și mișcarea ambientală nu rulează."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweging verminderen is ingeschakeld in Toegankelijkheid. De glasvulling blijft, maar de vloeistof versmelt, drukt op bloei en de omgevingsbeweging loopt niet."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助功能中已開啟「減弱動態效果」。玻璃填充保留，但液態融合、按下綻放和環境動效都不會執行。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcja Redukuj ruch jest włączona w obszarze Dostępność. Wypełnienie szklane pozostaje, ale połączenie cieczy, rozkwit prasy i ruch otoczenia nie działają."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зменшити рух увімкнено в доступності. Скляна заливка залишається, але злиття рідини, пресування та рух навколишнього середовища не працюють."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik'te Hareketi Azalt seçeneği açık. Cam dolgusu kalıyor, ancak sıvı birleşimi, baskı patlaması ve ortam hareketi çalışmıyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omezit pohyb je zapnutý v Usnadnění. Skleněná výplň zůstává, ale kapalina se spojuje, lisuje a okolní pohyb neprobíhá."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V časti Prístupnosť je zapnutá funkcia Reduce Motion. Sklenená výplň zostáva, ale kvapalina sa spája, lisuje sa a okolitý pohyb neprebieha."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Reduce Motion είναι ενεργοποιημένο στην Προσβασιμότητα. Το γέμισμα γυαλιού παραμένει, αλλά το υγρό συγχωνεύεται, πιέστε το bloom και η κίνηση του περιβάλλοντος δεν εκτελείται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducera rörelse är på i tillgänglighet. Glasfyllningen stannar, men vätskan smälter samman, pressar ut och omgivande rörelser rinner inte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducer Motion er slået til i Tilgængelighed. Glasfyldet forbliver, men væsken smelter sammen, presser blomstring og omgivende bevægelse løber ikke."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduser bevegelse er på i Tilgjengelighet. Glassfyllingen forblir, men væsken smelter sammen, presser oppblomstring og omgivelsesbevegelser renner ikke."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce Motion on käytössä esteettömyystilassa. Lasitäyttö pysyy, mutta neste sulautuu, puristaa kukintaa ja ympäristön liike eivät toimi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurangi Gerakan aktif di Aksesibilitas. Isian gelas tetap ada, tetapi cairan menyatu, mekar tekan, dan gerakan sekitar tidak berjalan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giảm chuyển động được bật trong Trợ năng. Lớp thủy tinh vẫn giữ nguyên, nhưng chất lỏng hợp nhất, nhấn nở và chuyển động xung quanh không chạy."
          }
        }
      }
    },
    "Reduce effects under load": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verminder effekte onder vrag"
          }
        },
        "de": {
