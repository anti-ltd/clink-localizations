        }
      }
    },
    "Membership details are unavailable. Refresh to try again.": {
      "comment": "Private account membership summary and setup guidance on iOS and Android. Store and account metadata are display-only; sharing requires separate consent.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los detalles de la suscripción no están disponibles. Actualiza para volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les détails de l’abonnement sont indisponibles. Actualise pour réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mitgliedschaftsdetails sind nicht verfügbar. Aktualisiere, um es erneut zu versuchen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dettagli dell’abbonamento non sono disponibili. Aggiorna per riprovare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os detalhes da subscrição não estão disponíveis. Atualiza para tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сведения о подписке недоступны. Обновите, чтобы повторить попытку."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Butiran keahlian tidak tersedia. Muat semula untuk mencuba lagi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előfizetés részletei nem érhetők el. Frissíts az újrapróbálkozáshoz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンバーシップの詳細を取得できません。更新して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法获取会员详情，请刷新后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멤버십 정보를 불러올 수 없습니다. 새로 고침하여 다시 시도해 주세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikmesuse andmed pole saadaval. Uuesti proovimiseks värskenda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Detaliile abonamentului nu sunt disponibile. Reîmprospătează pentru a încerca din nou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De abonnementsgegevens zijn niet beschikbaar. Vernieuw om het opnieuw te proberen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法取得會員詳細資訊，請重新整理後再試。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidmaatskapbesonderhede is nie beskikbaar nie. Verfris om weer te probeer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szczegóły członkostwa są niedostępne. Odśwież, aby spróbować ponownie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відомості про підписку недоступні. Оновіть, щоб спробувати ще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üyelik ayrıntılarına ulaşılamıyor. Tekrar denemek için yenileyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrobnosti členství nejsou dostupné. Obnovte je a zkuste to znovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrobnosti členstva nie sú dostupné. Obnovte ich a skúste to znova."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λεπτομέρειες της συνδρομής δεν είναι διαθέσιμες. Κάντε ανανέωση για να δοκιμάσετε ξανά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Medlemsuppgifterna är inte tillgängliga. Uppdatera för att försöka igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oplysninger om medlemskabet er ikke tilgængelige. Opdater for at prøve igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Medlemskapsinformasjonen er ikke tilgjengelig. Oppdater for å prøve igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jäsenyyden tiedot eivät ole saatavilla. Yritä uudelleen päivittämällä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detail keanggotaan tidak tersedia. Muat ulang untuk mencoba lagi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tải thông tin thành viên. Hãy làm mới để thử lại."
          }
        }
      }
    },
