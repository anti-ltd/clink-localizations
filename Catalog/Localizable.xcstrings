        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak moc se jednotlivé klávesy vyboulí směrem ven, když přes ně přejedete prstem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako veľmi sa jednotlivé klávesy vydutia smerom von, keď po nich prejdete prstom."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο διογκώνεται κάθε πλήκτρο προς τα έξω καθώς το δάχτυλό σας περνά από πάνω του."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur mycket varje tangent buktar utåt när ditt finger passerar över den."
          }
