    "Clink couldn't read that file. Try a wav, m4a, or mp3.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink no pudo leer ese archivo. Prueba un wav, m4a o mp3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink n’a pas pu lire ce fichier. Essaie un wav, m4a ou mp3."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink konnte die Datei nicht lesen. Probier wav, m4a oder mp3."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink non è riuscito a leggere quel file. Prova un wav, m4a o mp3."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clink não conseguiu ler esse ficheiro. Experimenta wav, m4a ou mp3."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink tidak dapat membaca fail itu. Cuba wav, m4a atau mp3."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink nem tudta olvasni a fájlt. Próbálj wav, m4a vagy mp3 fájlt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkはそのファイルを読めませんでした。wav、m4a、mp3を試してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 读不了这个文件。试试 wav、m4a 或 mp3。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink이 그 파일을 읽지 못했어요. wav, m4a, mp3를 써 보세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink ei saanud seda faili lugeda. Proovi wav, m4a või mp3."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink не смог прочитать этот файл. Попробуйте wav, m4a или mp3."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clink kon nie daardie lêer lees nie. Probeer 'n wav, m4a of mp3."
          }
        }
      }
    },
