        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите звуки клавиш и выберите набор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“按键音”，选一个声音包。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita sisse Klahvi helid ja vali helipakk."
          }
        },
        "af": {
