    "Pins, notepad notes, and calculator results live in the App Group.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spelde, notaboek-aantekeninge en sakrekenaarresultate lewendig in die App Group."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anheftungen, Notizblock-Notizen und Rechnerergebnisse liegen in der App Group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos fijados, las notas del bloc y los resultados de la calculadora se quedan en el App Group."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinnitused, märkmiku märkmed ja kalkulaatori tulemused asuvad App Groupis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes épingles, notes du bloc-notes et résultats de la calculatrice restent dans l'App Group."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rögzített elemek, a jegyzetek és a számológép eredményei az App Groupban maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pin, le note del blocco note e i risultati della calcolatrice stanno nell'App Group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン、メモ、電卓の結果は App Group に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정, 메모장 메모, 계산기 결과는 App Group 안에 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin, nota notepad dan hasil kalkulator disimpan dalam App Group."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pins, notas do bloco de notas e resultados da calculadora ficam no App Group."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплённое, заметки из блокнота и результаты калькулятора лежат в App Group."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定项、记事本笔记和计算器结果都存在 App Group 里。"
          }
        }
      }
    },
