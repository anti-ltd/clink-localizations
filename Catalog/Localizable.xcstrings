    "Word lists ship inside Clink. No download step when you type.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wortlisten stecken in Clink drin. Kein Download beim Tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las listas de palabras vienen dentro de Clink. Nada que descargar al escribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les listes de mots sont incluses dans Clink. Rien à télécharger quand tu tapes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szólisták a Clinkben vannak. Gépelés közben nincs letöltés."
          }
