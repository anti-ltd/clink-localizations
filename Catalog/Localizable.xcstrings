          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinki pilve ega sünkroonimiskontot pole."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Daar is geen Clink-wolk en geen sinkroniseringsrekening nie."
          }
        }
      }
    },
