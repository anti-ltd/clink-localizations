    "Session expired. Use a pairing code or recovery key.": {
      "comment": "Optional private app account and purchase sharing. No email or typing data. Recovery key and pairing codes are secrets.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión ha caducado. Usa un código de vinculación o una clave de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Session expirée. Utilise un code d’association ou une clé de récupération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzung abgelaufen. Verwende einen Kopplungscode oder Wiederherstellungsschlüssel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessione scaduta. Usa un codice di abbinamento o una chiave di recupero."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão expirou. Usa um código de emparelhamento ou uma chave de recuperação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс истёк. Используйте код сопряжения или ключ восстановления."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi tamat tempoh. Gunakan kod pasangan atau kunci pemulihan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A munkamenet lejárt. Használj párosítási kódot vagy helyreállítási kulcsot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの有効期限が切れました。ペアリングコードまたは復旧キーを使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话已过期。请使用配对码或恢复密钥。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 만료되었습니다. 페어링 코드나 복구 키를 사용해 주세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seanss on aegunud. Kasuta sidumiskoodi või taastevõtit."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiune expirată. Folosește un cod de asociere sau o cheie de recuperare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessie verlopen. Gebruik een koppelcode of herstelsleutel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段已過期。請使用配對碼或復原密鑰。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessie het verval. Gebruik ’n paarkode of herstelsleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja wygasła. Użyj kodu parowania lub klucza odzyskiwania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс завершено. Скористайтеся кодом сполучення або ключем відновлення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumun süresi doldu. Eşleştirme kodu veya kurtarma anahtarı kullanın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnost relace vypršela. Použij párovací kód nebo klíč pro obnovení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnosť relácie vypršala. Použi párovací kód alebo kľúč na obnovenie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συνεδρία έληξε. Χρησιμοποίησε κωδικό σύζευξης ή κλειδί ανάκτησης."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessionen har gått ut. Använd en parkopplingskod eller återställningsnyckel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessionen er udløbet. Brug en parringskode eller gendannelsesnøgle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Økten har utløpt. Bruk en paringskode eller gjenopprettingsnøkkel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Istunto on vanhentunut. Käytä pariliitoskoodia tai palautusavainta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi kedaluwarsa. Gunakan kode pemasangan atau kunci pemulihan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên đã hết hạn. Hãy dùng mã ghép đôi hoặc khóa khôi phục."
          }
        }
      }
    },
    "Share subscriptions between iOS and Android. Internet verification is required.": {
      "comment": "Optional private app account and purchase sharing. No email or typing data. Recovery key and pairing codes are secrets.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte suscripciones entre iOS y Android. Se requiere verificación por internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage tes abonnements entre iOS et Android. Une vérification par internet est nécessaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile Abonnements zwischen iOS und Android. Eine Überprüfung über das Internet ist erforderlich."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi gli abbonamenti tra iOS e Android. È necessaria la verifica tramite internet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Partilha subscrições entre iOS e Android. É necessária verificação pela internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте подписки на iOS и Android. Требуется проверка через интернет."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kongsi langganan antara iOS dan Android. Pengesahan melalui internet diperlukan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszd meg előfizetéseidet iOS és Android között. Internetes ellenőrzés szükséges."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSとAndroidでサブスクリプションを共有します。インターネットでの確認が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 和 Android 之间共享订阅，需要联网验证。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS와 Android 간에 구독을 공유합니다. 인터넷을 통한 확인이 필요합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga tellimusi iOS-i ja Androidi vahel. Vajalik on interneti kaudu kontrollimine."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Partajează abonamentele între iOS și Android. Este necesară verificarea prin internet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel abonnementen tussen iOS en Android. Verificatie via internet is vereist."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 和 Android 之間共享訂閱，需要透過網路驗證。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel intekeninge tussen iOS en Android. Verifikasie via die internet is nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępniaj subskrypcje między iOS a Androidem. Wymagana jest weryfikacja przez internet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Користуйтеся підписками на iOS та Android. Потрібна перевірка через інтернет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelikleri iOS ve Android arasında paylaşın. İnternet üzerinden doğrulama gerekir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílej předplatné mezi iOS a Androidem. Je potřeba ověření přes internet."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdieľaj predplatné medzi iOS a Androidom. Potrebné je overenie cez internet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μοιράσου συνδρομές μεταξύ iOS και Android. Απαιτείται επαλήθευση μέσω διαδικτύου."
          }
        },
        "sv": {
