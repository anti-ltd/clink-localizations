    "Spread is how far the light reaches around the key you press, in key widths.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verspreiding is hoe ver die lig om die sleutel wat jy druk, in sleutelwydtes reik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausbreitung ist, wie weit das Licht um die gedrückte Taste herum reicht – in Tastenbreiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensión es hasta dónde llega la luz alrededor de la tecla que pulsas, en anchos de tecla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulatus näitab, kui kaugele valgus vajutatud klahvi ümber ulatub, klahvilaiustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étendue indique jusqu’où la lumière s’étend autour de la touche appuyée, en largeurs de touche."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) Terjedés azt adja meg, milyen messzire ér a fény a lenyomott billentyű körül, billentyűszélességben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffusione è quanto lontano arriva la luce attorno al tasto che premi, in larghezze di tasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「広がり」は、押したキーの周りに光が届く範囲です（キー幅単位）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘퍼짐’은 누른 키 주변으로 빛이 퍼지는 거리입니다(키 너비 기준)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebaran ialah sejauh mana cahaya mencapai di sekeliling kekunci yang anda tekan, dalam lebar kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcance é a distância que a luz alcança à volta da tecla que carregas, em larguras de tecla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Разброс» — насколько далеко свет расходится вокруг нажатой клавиши, в ширинах клавиши."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「扩散范围」是光在所按按键周围扩散的范围，以按键宽度计。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspândirea este cât de departe ajunge lumina în jurul tastei pe care o apăsați, în lățimi ale tastei."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreiding is hoe ver het licht reikt rond de toets die u indrukt, in toetsbreedtes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「擴散範圍」是光在所按按鍵周圍擴散的範圍，以按鍵寬度計。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozproszenie to odległość, jaką światło dociera wokół naciśniętego klawisza, w szerokości klawiszy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розповсюдження – це те, наскільки світло досягає навколо клавіші, яку ви натискаєте, у ширині клавіші."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayılma, ışığın bastığınız tuşun etrafında tuş genişliklerinde ne kadar uzağa ulaştığıdır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spread je to, jak daleko světlo dosáhne kolem klávesy, kterou stisknete, v šířkách kláves."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpätie je to, ako ďaleko svetlo dosiahne okolo klávesu, ktorú stlačíte, v šírkach klávesov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Spread είναι το πόσο μακριά φτάνει το φως γύρω από το πλήκτρο που πατάτε, σε πλάτη πλήκτρων."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spridning är hur långt ljuset når runt knappen du trycker på, i tangentbredder."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spredning er, hvor langt lyset når omkring den tast, du trykker på, i tastebredder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spredning er hvor langt lyset når rundt tasten du trykker på, i tastebredder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Levitys tarkoittaa, kuinka pitkälle valo ulottuu painamasi näppäimen ympäriltä näppäinleveyksinä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyebaran adalah seberapa jauh jangkauan cahaya di sekitar tombol yang Anda tekan, dalam lebar tombol."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ lan tỏa là khoảng cách ánh sáng chiếu tới xung quanh phím bạn nhấn, tính theo độ rộng phím."
          }
        }
      }
    },
