          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在空格左边或右边加一个，再给它指定要做的事。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați unul în stânga sau în dreapta spațiului și dați-i ceea ce ar trebui să facă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg er een toe links of rechts van de spatie en geef hem wat hij moet doen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在空格左邊或右邊加一個，再給它指定要做的事。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj jeden po lewej lub prawej stronie spacji i nadaj mu to, co powinien zrobić."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте один ліворуч або праворуч від пробілу та дайте йому те, що він має робити."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alanın soluna veya sağına bir tane ekleyin ve ona ne yapması gerektiğini verin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte jeden vlevo nebo vpravo od prostoru a dejte mu, co má dělat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte jeden naľavo alebo napravo od priestoru a dajte mu, čo má robiť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ένα στα αριστερά ή δεξιά του διαστήματος και δώστε του τι πρέπει να κάνει."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en till vänster eller höger om mellanslag och ge den vad den ska göra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en til venstre eller højre for mellemrummet, og giv den, hvad den skal gøre."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en til venstre eller høyre for mellomrom, og gi den det den skal gjøre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää yksi tilan vasemmalle tai oikealle puolelle ja anna sille, mitä sen pitäisi tehdä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan satu di kiri atau kanan ruang, dan berikan apa yang seharusnya dilakukannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một cái vào bên trái hoặc bên phải của khoảng trống và cung cấp cho nó những gì nó nên làm."
          }
        }
      }
    },
    "Add one under Create: the shortcut, then the phrase it turns into.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge unter Erstellen zuerst das Kürzel und dann den Text ein, der es ersetzen soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade uno en Crear: primero el atajo y después la frase en la que se convierte."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa jaotises „Loo” kõigepealt lühend ja seejärel fraas, millega see asendatakse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute-en un dans Créer : le raccourci, puis la phrase qui le remplace."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Létrehozás résznél előbb add meg a rövidítést, majd a kifejezést, amellyé ki szeretnéd egészíteni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungine una in Crea: prima la scorciatoia, poi la frase in cui si trasforma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「作成」で、ショートカットと変換後のフレーズを順に入力して追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘만들기’에서 단축어를 입력한 다음, 단축어가 바뀔 문구를 입력해 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan di bahagian Cipta: masukkan singkatan, kemudian frasa penggantinya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um em Criar: primeiro o atalho e depois a frase que o substitui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В разделе «Создать» сначала введите сокращение, затем фразу, в которую оно будет разворачиваться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“创建”中，先输入快捷短语，再输入要替换成的内容，然后添加。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați una sub Creare: comanda rapidă, apoi expresia în care se transformă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg er een toe onder Maken: de snelkoppeling en vervolgens de zin waarin deze verandert."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在“建立”中，先輸入快捷短語，再輸入要替換成的內容，然後新增。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een by onder Skep: die skramsleutel, dan die frase waarna dit omskakel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj go w obszarze Utwórz: skrót, a następnie frazę, w którą się zmienia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте один у розділі «Створити»: ярлик, а потім фразу, у яку він перетворюється."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oluştur'un altına bir tane ekleyin: kısayol, ardından dönüştüğü ifade."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednu přidejte pod Vytvořit: zkratku a poté frázi, na kterou se změní."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte ho do časti Vytvoriť: skratku a potom frázu, na ktorú sa zmení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ένα κάτω από το Create: τη συντόμευση και μετά τη φράση στην οποία μετατρέπεται."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en under Skapa: genvägen, sedan frasen den blir till."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en under Opret: genvejen og derefter den sætning, den bliver til."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en under Opprett: snarveien, deretter uttrykket det blir til."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää Luo-kohtaan: pikakuvake ja sitten lause, josta se muuttuu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan satu di bawah Buat: pintasan, lalu frasa yang diubah menjadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một cụm từ trong phần Tạo: phím tắt, sau đó chuyển thành cụm từ."
          }
        }
      }
    },
