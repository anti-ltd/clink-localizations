          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての文字の長押しでアクセントと記号の両方 (A → á à â … @)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 글자를 길게 누르면 악센트와 기호 둘 다 (A → á à â … @)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksen dan simbol sekali pada tekan lama setiap huruf (A → á à â … @)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
