    "Do the maths without leaving the keyboard": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Doen die wiskunde sonder om die sleutelbord te verlaat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechne, ohne die Tastatur zu verlassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz cálculos sin salir del teclado"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee arvutusi klaviatuurilt lahkumata"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais des calculs sans quitter le clavier"
