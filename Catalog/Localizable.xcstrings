    "Both accents and a symbol on every letter’s long-press (A → á à â … @)": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide aksente en 'n simbool op elke letter se langdruk (A → á à â … @)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akzente und ein Symbol beim langen Drücken jedes Buchstabens (A → á à â … @)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acentos y un símbolo en cada pulsación larga de letra (A → á à â … @)"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Nii aksendid kui sümbol iga tähe pikkvajutusel (A → á à â … @)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des accents et un symbole sur l'appui long de chaque lettre (A → á à â … @)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ékezetek és egy szimbólum is minden betű hosszú lenyomásán (A → á à â … @)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sia accenti sia un simbolo sulla pressione prolungata di ogni lettera (A → á à â … @)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての文字の長押しでアクセントと記号の両方 (A → á à â … @)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 글자를 길게 누르면 악센트와 기호 둘 다 (A → á à â … @)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksen dan simbol sekali pada tekan lama setiap huruf (A → á à â … @)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acentos e um símbolo no toque prolongado de cada letra (A → á à â … @)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И акценты, и символ по долгому нажатию на каждой букве (A → á à â … @)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个字母长按既有重音也有一个符号（A → á à â … @）"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atât accente, cât și un simbol pe apăsarea lungă a fiecărei litere (A → á à â … @)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zowel accenten als een symbool bij het lang indrukken van elke letter (A → á à â … @)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個字母長按既有重音也有一個符號（A → á à â … @）"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarówno akcenty, jak i symbol po długim naciśnięciu każdej litery (A → á à â … @)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наголос і символ під час тривалого натискання кожної літери (A → á à â … @)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her harfe uzun basıldığında hem vurgu hem de bir sembol (A → á à â … @)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Akcenty i symbol na dlouhém stisku každého písmene (A → á à â … @)"
          }
        },
        "sk": {
          "stringUnit": {
