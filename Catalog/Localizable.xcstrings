    "Sends your whole text along with the selection, so the edit fits what's around it. Also in the keyboard's AI Tools options.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stuur jou hele teks saam met die keuse, sodat die wysiging pas by wat rondom dit is. Ook in die sleutelbord se AI Tools-opsies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schickt deinen ganzen Text zusammen mit der Auswahl, damit die Änderung zum Umfeld passt. Auch in den KI-Werkzeuge-Optionen der Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía todo tu texto junto con la selección, para que la edición encaje con lo que la rodea. También en las opciones de Herramientas de IA del teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saadab kogu sinu teksti koos valikuga, nii et muudatus sobituks ümbritsevaga. Samuti klaviatuuri TI-tööriistade valikutes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie tout ton texte avec la sélection, pour que la modification s'accorde à ce qui l'entoure. Aussi dans les options Outils IA du clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elküldi a teljes szöveget a kijelöléssel együtt, hogy a szerkesztés illeszkedjen a környezetéhez. A billentyűzet MI-eszközök beállításai közt is elérhető."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia tutto il testo insieme alla selezione, così la modifica si adatta al contesto. Anche nelle opzioni Strumenti AI della tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択部分と一緒に文章全体を送るので、まわりに合った手直しになります。キーボードの AI ツールのオプションにもあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 항목과 함께 전체 텍스트를 보내서, 수정이 주변에 맞게 돼요. 키보드의 AI 도구 옵션에도 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghantar keseluruhan teks anda bersama pilihan, supaya suntingan sesuai dengan sekelilingnya. Juga dalam pilihan Alat AI papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia o teu texto todo junto com a seleção, para a edição encaixar no que está à volta. Também nas opções de Ferramentas de IA do teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передаёт весь текст вместе с выделением, чтобы правка вписалась в окружение. Есть и в настройках «Инструментов ИИ» на клавиатуре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把你的整段文本连同选区一起发送，让修改贴合上下文。键盘的 AI 工具选项里也有。"
          }
        }
      }
    },
