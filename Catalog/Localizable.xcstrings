            "value": "Yazmak için konuşun"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mluvte a zadejte"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovorte a píšte"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μιλήστε για να πληκτρολογήσετε"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tala för att skriva"
          }
        },
        "da": {
          "stringUnit": {
