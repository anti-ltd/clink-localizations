        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes revogá-lo quando quiseres em Definições → Geral → Teclado → Clink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
