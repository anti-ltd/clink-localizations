          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누를 때 키가 움직이는 방식입니다. 블룸이 켜져 있을 때만 적용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cara kekunci bergerak apabila ditekan. Hanya berkesan apabila Bloom dihidupkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como a tecla se move ao ser premida. Aplica-se apenas com o Bloom ativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как клавиша движется при нажатии. Работает только при включённом «Свечении»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下按键时的动画方式。仅在开启 Bloom 时生效。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuidas klahv vajutamisel liigub. Kehtib ainult siis, kui Bloom on sees."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoe die sleutel beweeg wanneer dit gedruk word. Geld slegs wanneer Bloom aan is."
          }
        }
      }
    },
    "How the keyboard animates in each time it opens.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
