          "stringUnit": {
            "state": "translated",
            "value": "Alusta mistahes ülalolevast paigutusest, seejärel liiguta klahve ja lisa ridu kaardil Klahvid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pars d’une disposition ci-dessus, puis déplace des touches et ajoute des rangées dans l’onglet Touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Indulj el a fenti elrendezések bármelyikéből, majd a Billentyűk fülön mozgasd a billentyűket és adj hozzá sorokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parti da una delle disposizioni qui sopra, poi sposta i tasti e aggiungi righe nella scheda Tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上のレイアウトのどれかから始めて、「キー」タブでキーを動かしたり行を足したりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위의 배열 중 하나로 시작한 다음 ‘키’ 탭에서 키를 옮기고 행을 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulakan daripada mana-mana susun atur di atas, kemudian alihkan kekunci dan tambah baris dalam tab Kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa por qualquer esquema acima e depois move teclas e acrescenta linhas no separador Teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возьмите любую раскладку выше за основу, а потом двигайте клавиши и добавляйте ряды на вкладке «Клавиши»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先从上面任选一套布局，然后在「按键」标签页里移动按键、添加行。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începeți de la orice aspect de mai sus, apoi mutați tastele și adăugați rânduri în fila Chei."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin vanuit een willekeurige bovenstaande lay-out, verplaats vervolgens de toetsen en voeg rijen toe op het tabblad Toetsen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先從上面任選一套佈局，然後在「按鍵」標籤頁裡移動按鍵、新增行。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od dowolnego układu powyżej, a następnie przesuń klawisze i dodaj wiersze na karcie Klawisze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть із будь-якого макета вище, потім перемістіть клавіші та додайте рядки на вкладці «Клавіші»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarıdaki herhangi bir düzenden başlayın, ardından tuşları taşıyın ve Anahtarlar sekmesine satır ekleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začněte z libovolného výše uvedeného rozvržení, poté přesuňte klávesy a přidejte řádky na kartě Klávesy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Začnite z ľubovoľného rozloženia vyššie, potom presuňte klávesy a pridajte riadky na karte Klávesy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινήστε από οποιαδήποτε διάταξη παραπάνω, μετακινήστε τα πλήκτρα και προσθέστε σειρές στην καρτέλα Κλειδιά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja från valfri layout ovan, flytta sedan tangenter och lägg till rader på fliken Nycklar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Start fra et hvilket som helst layout ovenfor, flyt derefter taster og tilføj rækker på fanen Taster."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Start fra et hvilket som helst oppsett ovenfor, flytt deretter taster og legg til rader på Taster-fanen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita mistä tahansa yllä olevasta asettelusta, siirrä sitten näppäimiä ja lisää rivejä Näppäimet-välilehdelle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dari tata letak apa pun di atas, lalu pindahkan tombol dan tambahkan baris pada tab Kunci."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu từ bất kỳ bố cục nào ở trên, sau đó di chuyển các phím và thêm hàng trên tab Phím."
          }
        }
      }
    },
