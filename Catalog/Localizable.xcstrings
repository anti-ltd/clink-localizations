          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat turun pek tindakan tidak dapat disahkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a transferência do pacote de ações."
          }
        },
        "ru": {
