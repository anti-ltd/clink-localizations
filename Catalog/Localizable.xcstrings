    "You slide instead of tapping, one word per stroke.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy gly in plaas van om te tik, een woord per slag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statt zu tippen, ziehst du: ein Wort pro Zug."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En vez de tocar, deslizas: una palabra por trazo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa libised vajutamise asemel, üks sõna liugude kohta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au lieu de taper, tu glisses : un mot par tracé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintás helyett húzol: egy szó egy vonással."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invece di toccare, scorri: una parola per tratto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップの代わりになぞって、ひと続きで1語を入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두드리는 대신 밀어서, 한 번에 한 단어씩 씁니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda meleret dan bukan mengetik: satu perkataan bagi setiap lerekan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em vez de tocar, deslizas: uma palavra por traço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не нажимаете, а ведёте пальцем — по слову за движение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不用一个个点，改成划：一笔一个词。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisați în loc să apăsați, un cuvânt pe lovitura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je schuift in plaats van te tikken, één woord per slag."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不用一個個點，改成劃：一筆一個詞。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuwasz zamiast stukać, jedno słowo na pociągnięcie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви ковзаєте, а не натискаєте, одне слово за штрих."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuruş başına bir kelime olmak üzere, dokunmak yerine kaydırırsınız."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místo klepání posouváte jedno slovo na tah."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Namiesto klepnutia posúvate jedno slovo na ťah."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γλιστράτε αντί να πατήσετε, μία λέξη ανά χτύπημα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du glider istället för att knacka, ett ord per slag."
