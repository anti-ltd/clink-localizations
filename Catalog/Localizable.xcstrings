    "This action takes no input, so it runs with an empty string.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie aksie neem geen invoer nie, so dit loop met 'n leë string."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion benötigt keine Eingabe, sie läuft mit einer leeren Zeichenfolge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no necesita entrada, se ejecuta con una cadena vacía."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See tegevus ei võta sisendit, seega töötab ta tühja sõnega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action ne prend aucune entrée, elle s'exécute avec une chaîne vide."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a művelet nem igényel bemenetet, üres karakterlánccal fut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione non richiede input, viene eseguita con una stringa vuota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアクションは入力を必要としません。空の文字列で実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 액션은 입력이 필요 없어요. 빈 문자열로 실행돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini tidak memerlukan input, ia berjalan dengan rentetan kosong."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação não precisa de entrada, corre com uma string vazia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это действие не принимает текст на вход, поэтому запускается с пустой строкой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个操作不需要输入，会以空字符串运行。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această acțiune nu necesită introducere, deci rulează cu un șir gol."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze actie vereist geen invoer en wordt daarom uitgevoerd met een lege tekenreeks."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個操作不需要輸入，會以空字串執行。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta akcja nie wymaga żadnych danych wejściowych, więc działa z pustym ciągiem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця дія не потребує введення, тому виконується з порожнім рядком."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
