    "Backlight the keys as they glow and react": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verlig die sleutels terwyl hulle gloei en reageer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasten hinterleuchten, damit sie glühen und reagieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroilumina las teclas para que brillen y reaccionen"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgusta klahve tahapoolt, et need helendaksid ja reageeriksid"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétroéclairez les touches pour qu'elles brillent et réagissent"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Világítsd meg a gombokat, hogy ragyogjanak és reagáljanak"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroillumina i tasti perché brillino e reagiscano"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを光らせ、反応させる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키에 조명을 넣어 빛나고 반응하게"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terangi kekunci supaya bercahaya dan bertindak balas"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroilumina as teclas para brilharem e reagirem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсветите клавиши, чтобы они светились и реагировали"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为按键打光，让它发光并作出反应"
          }
        }
      }
    },
    "Backlight your keyboard the way a mechanical one glows: steady, moving, or lighting up under your fingers.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verlig jou sleutelbord soos 'n meganiese een gloei: bestendig, beweeg of verlig onder jou vingers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinterleuchte deine Tastatur wie eine mechanische: ruhig, in Bewegung oder aufleuchtend unter deinen Fingern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroilumina tu teclado como brilla uno mecánico: fijo, en movimiento o encendiéndose bajo tus dedos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgusta oma klaviatuur tahapoolt nii, nagu helendab mehaaniline klaviatuur: ühtlane, liikuvas või sinu sõrmede all süttiv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétroéclairez votre clavier comme un clavier mécanique : fixe, en mouvement ou s'allumant sous vos doigts."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Világítsd meg a billentyűzetet, ahogy egy mechanikus teszi: nyugodtan, mozgásban vagy az ujjaid alatt felvillanva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroilumina la tastiera come una meccanica: fissa, in movimento o che si accende sotto le dita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メカニカルキーボードのように、キーボードをバックライトで光らせます。静かに、流れるように、あるいは指の下で点灯します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메카니컬 키보드처럼 키보드에 조명을 넣습니다. 가만히, 흐르듯이, 또는 손가락 아래에서 켜지도록."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terangi papan kekunci anda seperti papan mekanikal: tetap, bergerak, atau menyala di bawah jari anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroilumina o teclado como um mecânico: fixo, em movimento ou acendendo sob os dedos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсветите клавиатуру, как механическую: ровно, с движением или загораясь под пальцами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像机械键盘那样为键盘打光：静止、流动，或在指尖下亮起。"
          }
        }
      }
    },
