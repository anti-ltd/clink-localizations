    "Link mode inserts the GIF link from the keyboard and copies it from the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link mode inserts the GIF link from the keyboard and copies it from the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo de enlace, el teclado inserta el enlace del GIF y la app lo copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode lien, le clavier insère le lien du GIF et l’app le copie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Link-Modus fügt die Tastatur den GIF-Link ein, während die App ihn kopiert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In modalità link, la tastiera inserisce il link della GIF e l’app lo copia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo de ligação, o teclado insere a ligação do GIF e a aplicação copia-a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В режиме ссылки клавиатура вставляет ссылку на GIF, а приложение копирует её."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam mod pautan, papan kekunci menyisipkan pautan GIF, manakala aplikasi menyalinnya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hivatkozás módban a billentyűzet beilleszti a GIF hivatkozását, az alkalmazás pedig másolja azt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクモードでは、キーボードからはGIFのリンクを挿入し、アプリからはリンクをコピーします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在链接模式下，键盘会插入 GIF 链接，App 则会复制链接。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 모드에서는 키보드가 GIF 링크를 삽입하고 앱은 링크를 복사합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingirežiimis sisestab klaviatuur GIF-i lingi ja rakendus kopeerib selle."
          }
        }
      }
    },
