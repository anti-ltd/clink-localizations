    "Percentages use your saved settings, never the last automated result. Supported size limits still apply.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los porcentajes se calculan sobre los ajustes guardados, nunca sobre el último resultado automático. Se respetan los límites de tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pourcentages utilisent les réglages enregistrés, jamais le dernier résultat automatisé. Les limites de taille restent applicables."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozente beziehen sich auf deine gespeicherten Einstellungen, nie auf das letzte Automationsergebnis. Die Größenlimits gelten weiterhin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le percentuali si riferiscono alle impostazioni salvate, mai all’ultimo risultato automatico. Restano validi i limiti di dimensione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As percentagens usam as definições guardadas, nunca o último resultado automático. Os limites de tamanho continuam a aplicar-se."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценты считаются от сохранённых настроек, а не от последнего результата автоматизации. Ограничения размеров сохраняются."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peratus menggunakan tetapan tersimpan, bukan hasil automasi terakhir. Had saiz masih terpakai."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A százalékok a mentett beállításokra vonatkoznak, soha nem az előző automatizált eredményre. A méretkorlátok továbbra is érvényesek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "割合は保存済みの設定を基準とし、直前の自動調整結果は使いません。対応サイズの制限は引き続き適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "百分比以保存的设置为基准，不使用上一次自动化结果。支持的尺寸限制仍然适用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비율은 마지막 자동화 결과가 아닌 저장된 설정을 기준으로 합니다. 지원되는 크기 제한은 계속 적용됩니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Protsendid lähtuvad salvestatud seadetest, mitte eelmisest automaatika tulemusest. Suurusepiirangud kehtivad endiselt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Procentele folosesc setările salvate, niciodată ultimul rezultat automat. Limitele de dimensiune acceptate se aplică în continuare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentages gebruiken uw opgeslagen instellingen, nooit het laatste geautomatiseerde resultaat. Ondersteunde groottelimieten zijn nog steeds van toepassing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "百分比以儲存的設定為基準，不使用上一次自動化結果。支援的尺寸限制仍然適用。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Persentasies gebruik jou gestoorde instellings, nooit die laaste outomatiese resultaat nie. Ondersteunde groottebeperkings geld steeds."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Procenty korzystają z zapisanych ustawień, nigdy z ostatniego automatycznego wyniku. Obsługiwane limity rozmiaru nadal obowiązują."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У відсотках використовуються ваші збережені налаштування, а не останній автоматичний результат. Обмеження підтримуваного розміру все ще діють."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzdeler, son otomatik sonucu asla değil, kayıtlı ayarlarınızı kullanır. Desteklenen boyut sınırları hâlâ geçerlidir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Procenta používají vaše uložená nastavení, nikdy poslední automatický výsledek. Stále platí limity podporované velikosti."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentá používajú vaše uložené nastavenia, nikdy nie posledný automatický výsledok. Podporované limity veľkosti stále platia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ποσοστά χρησιμοποιούν τις αποθηκευμένες ρυθμίσεις σας, ποτέ το τελευταίο αυτοματοποιημένο αποτέλεσμα. Τα υποστηριζόμενα όρια μεγέθους εξακολουθούν να ισχύουν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Procentandelar använder dina sparade inställningar, aldrig det senaste automatiska resultatet. Storleksbegränsningar som stöds gäller fortfarande."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Procentdele bruger dine gemte indstillinger, aldrig det sidste automatiske resultat. Understøttede størrelsesgrænser gælder stadig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosentandeler bruker de lagrede innstillingene dine, aldri det siste automatiserte resultatet. Støttede størrelsesgrenser gjelder fortsatt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosentit käyttävät tallennettuja asetuksiasi, eivät koskaan viimeistä automaattista tulosta. Tuetut kokorajoitukset ovat edelleen voimassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Persentase menggunakan pengaturan tersimpan Anda, bukan hasil otomatis terakhir. Batasan ukuran yang didukung masih berlaku."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tỷ lệ phần trăm sử dụng cài đặt đã lưu của bạn, không bao giờ là kết quả tự động cuối cùng. Giới hạn kích thước được hỗ trợ vẫn được áp dụng."
          }
        }
      }
    },
