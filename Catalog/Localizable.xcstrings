        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードやメモは、それぞれのパネルの設定から消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드나 메모장은 각 패널 설정에서 지울 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam papan keratan atau notepad dari tetapan setiap panel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa a área de transferência ou o bloco de notas nas definições de cada painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить буфер обмена или блокнот можно в настройках соответствующей панели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在各个面板的设置里清空剪贴板或记事本。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tühjenda lõikelaud või märkmik iga paneeli seadetest."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vee knipbord of notaboek uit elke paneel se instellings."
          }
        }
      }
    },
    "With one tool enabled, opening Tools jumps straight into it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist nur ein Tool aktiviert, öffnet „Tools“ direkt dieses Tool."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una sola herramienta activada, abrir Herramientas va directo a ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un seul outil activé, ouvrir Outils y accède directement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha csak egy eszköz van bekapcsolva, az Eszközök megnyitása egyenesen abba ugrik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un solo strumento attivo, aprire Strumenti porta dritto lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なツールが1つだけの場合、ツールを開くとそのツールに直接進みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구가 하나만 켜져 있으면 도구를 열었을 때 바로 그 도구로 이동합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika hanya satu alat diaktifkan, membuka Alat terus masuk ke situ."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com apenas uma ferramenta ativada, abrir Ferramentas vai direto a ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включён только один инструмент, «Инструменты» сразу открываются на нём."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只启用一个工具时，打开\"工具\"会直接进入该工具。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühe tööriistaga sisse lülitatuna hüppab Tööriistade avamine otse sellesse."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Met een instrument geaktiveer, spring die opening van Tools reguit daarin."
          }
        }
      }
    },
    "With shift on, it just uppercases.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei aktivem Umschalt wird nur großgeschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Mayús activado, solo pasa a mayúsculas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Maj activé, la touche passe juste en majuscule."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktív Shift mellett csak nagybetűs lesz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con shift attivo, passa solo in maiuscolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフトがオンのときは大文字になるだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시프트가 켜져 있으면 그냥 대문자가 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semasa shift aktif, huruf hanya jadi besar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o shift ativo, apenas passa a maiúsculas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При включённом Shift это просто становится заглавным."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 开启时只会变成大写。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõstuklahviga kirjutab ta lihtsalt suureks."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Met shift aan, is dit net hoofletters."
          }
        }
      }
    },
