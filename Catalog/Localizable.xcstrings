    "Save recently copied text and images for quick re-paste. Adds a clipboard icon to the suggestions bar.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoor onlangs gekopieerde teks en beelde vir vinnige herplak. Voeg 'n knipbordikoon by die voorstellebalk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkt sich kürzlich kopierte Texte und Bilder, damit du sie schnell wieder einfügen kannst. Fügt der Vorschlagsleiste ein Zwischenablage-Symbol hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el texto y las imágenes que copias hace poco para volver a pegarlos rápido. Añade un icono de portapapeles a la barra de sugerencias."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvesta hiljuti kopeeritud tekst ja pildid kiireks taaskleepimiseks. Lisab soovituseribale lõikelaua ikooni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde le texte et les images copiés récemment pour les recoller vite fait. Ajoute une icône de presse-papiers à la barre de suggestions."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elmenti a nemrég másolt szövegeket és képeket, hogy gyorsan újra beilleszthesd. Egy vágólap ikont tesz a javaslatsávba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva testi e immagini copiati di recente per incollarli di nuovo al volo. Aggiunge un'icona degli appunti alla barra dei suggerimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近コピーしたテキストや画像を保存して、すぐに貼り付け直せます。候補バーにクリップボードのアイコンを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 복사한 글과 이미지를 저장해 두고 빠르게 다시 붙여넣어요. 추천 바에 클립보드 아이콘이 생겨요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan teks dan imej yang baru disalin supaya senang tampal semula. Ia tambah ikon papan keratan pada bar cadangan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda texto e imagens que copiaste há pouco para colares outra vez depressa. Põe um ícone de área de transferência na barra de sugestões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять недавно скопированные текст и изображения для быстрой повторной вставки. Добавляет значок буфера обмена в строку подсказок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存你最近复制的文字和图片，方便随手再粘贴。会在候选栏加一个剪贴板图标。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvați textul și imaginile copiate recent pentru re-inserare rapidă. Adaugă o pictogramă clipboard în bara de sugestii."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar onlangs gekopieerde tekst en afbeeldingen zodat u ze snel opnieuw kunt plakken. Voegt een klembordpictogram toe aan de suggestiebalk."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存你最近複製的文字和圖片，方便隨手再貼上。會在候選欄加一個剪貼簿圖示。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz ostatnio skopiowany tekst i obrazy, aby szybko je ponownie wkleić. Dodaje ikonę schowka do paska sugestii."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть нещодавно скопійований текст і зображення для швидкого повторного вставлення. Додає піктограму буфера обміну на панель пропозицій."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı bir şekilde yeniden yapıştırmak için yakın zamanda kopyalanan metin ve görüntüleri kaydedin. Öneri çubuğuna bir pano simgesi ekler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte nedávno zkopírovaný text a obrázky pro rychlé opětovné vložení. Přidá ikonu schránky na lištu návrhů."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte nedávno skopírovaný text a obrázky na rýchle opätovné prilepenie. Pridá ikonu schránky na panel návrhov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύστε κείμενο και εικόνες που αντιγράφηκαν πρόσφατα για γρήγορη επαναεπικόλληση. Προσθέτει ένα εικονίδιο του προχείρου στη γραμμή προτάσεων."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara nyligen kopierad text och bilder för snabb inklistring igen. Lägger till en urklippsikon i förslagsfältet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem nyligt kopieret tekst og billeder for hurtig genindsættelse. Tilføjer et udklipsholderikon til forslagslinjen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre nylig kopiert tekst og bilder for rask innliming på nytt. Legger til et utklippstavleikon i forslagslinjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna äskettäin kopioitu teksti ja kuvat nopeaa uudelleenliittämistä varten. Lisää leikepöydän kuvakkeen ehdotuspalkkiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan teks dan gambar yang baru saja disalin untuk ditempel ulang dengan cepat. Menambahkan ikon papan klip ke bilah saran."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu văn bản và hình ảnh được sao chép gần đây để dán lại nhanh chóng. Thêm biểu tượng clipboard vào thanh gợi ý."
          }
        }
      }
    },
