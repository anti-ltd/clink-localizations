    "Prices load once the App Store is reachable. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Pryse laai sodra die App Store bereikbaar is. Gaan jou verbinding na en probeer weer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Preise werden geladen, sobald der App Store erreichbar ist. Prüfe deine Verbindung und versuch es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios aparecerán cuando se pueda conectar con el App Store. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinnad laaditakse, niipea kui App Store on kättesaadav. Kontrolli ühendust ja proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prix s'afficheront dès que l'App Store sera joignable. Vérifie ta connexion et réessaie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az árak akkor töltődnek be, amikor elérhető az App Store. Ellenőrizd a kapcsolatot, majd próbáld újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prezzi compariranno quando l'App Store sarà raggiungibile. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeに接続すると価格が表示されます。通信状況を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에 연결되면 가격이 표시돼요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga akan dimuatkan apabila App Store boleh dicapai. Semak sambungan dan cuba lagi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os preços aparecem quando for possível aceder à App Store. Verifica a ligação e tenta novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены загружаются, когда App Store становится доступен. Проверьте соединение и попробуйте снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到 App Store 后会显示价格。请检查网络连接，然后重试。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prețurile se încarcă odată ce App Store este accesibil. Verificați conexiunea și încercați din nou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijzen worden geladen zodra de App Store bereikbaar is. Controleer uw verbinding en probeer het opnieuw."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線到 App Store 後會顯示價格。請檢查網路連線，然後重試。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceny ładują się, gdy App Store będzie dostępny. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціни завантажуються, коли App Store стає доступним. Перевірте підключення та повторіть спробу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiyatlar App Store'e ulaşıldığında yüklenir. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceny se načítají, jakmile bude App Store dosažitelný. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceny sa načítajú po dosiahnutí App Store. Skontrolujte pripojenie a skúste to znova."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τιμές φορτώνονται μόλις το App Store είναι προσβάσιμο. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Priserna laddas när App Store kan nås. Kontrollera din anslutning och försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Priserne indlæses, når App Store er tilgængelig. Tjek din forbindelse, og prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisene lastes inn når App Store er tilgjengelig. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinnat latautuvat, kun App Store on tavoitettavissa. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga dimuat setelah App Store dapat dijangkau. Periksa koneksi Anda dan coba lagi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá sẽ tải khi có thể truy cập App Store. Hãy kiểm tra kết nối của bạn và thử lại."
          }
        }
      }
    },
