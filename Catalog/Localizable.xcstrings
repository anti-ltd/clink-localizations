    "Changing access clears this plugin's saved state. Code and version changes require approval again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el acceso borra el estado guardado del plugin. Si cambia el código o la versión, se solicitará tu aprobación de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier les accès efface l’état enregistré de ce plugin. Tout changement de code ou de version nécessite un nouvel accord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du den Zugriff änderst, wird der gespeicherte Zustand dieses Plugins gelöscht. Änderungen an Code oder Version erfordern eine erneute Zustimmung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificare l’accesso cancella lo stato salvato del plugin. Le modifiche al codice o alla versione richiedono una nuova approvazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar o acesso apaga o estado guardado deste plugin. As alterações ao código ou à versão exigem nova aprovação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение доступа удалит сохранённое состояние плагина. При изменении кода или версии потребуется новое разрешение."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menukar akses memadamkan keadaan tersimpan pemalam ini. Perubahan kod atau versi memerlukan kelulusan semula."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hozzáférés módosítása törli a bővítmény mentett állapotát. A kód vagy a verzió módosításakor új jóváhagyás szükséges."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスを変更すると、このプラグインの保存済み状態が消去されます。コードやバージョンが変わると、再度承認が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改访问权限会清除插件保存的状态。代码或版本更改后需要重新批准。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근 권한을 변경하면 플러그인의 저장된 상태가 지워집니다. 코드나 버전이 변경되면 다시 승인해야 합니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Juurdepääsu muutmine kustutab pistikprogrammi salvestatud oleku. Koodi või versiooni muutmine nõuab uut nõusolekut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing access clears this plugin's saved state. Code and version changes require approval again."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbarea accesului șterge starea salvată a acestui plugin. Modificările de cod și versiuni necesită din nou aprobare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als u de toegang wijzigt, wordt de opgeslagen status van deze plug-in gewist. Code- en versiewijzigingen vereisen opnieuw goedkeuring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改訪問許可權會清除外掛儲存的狀態。程式碼或版本更改後需要重新批准。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verandering van toegang maak die plugin se gestoorde toestand skoon. Kode- en weergaweveranderings benodig weer goedkeuring."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana dostępu kasuje zapisany stan tej wtyczki. Zmiany w kodzie i wersji wymagają ponownego zatwierdzenia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна доступу очищає збережений стан цього плагіна. Зміни коду та версії знову потребують схвалення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişimi değiştirmek bu eklentinin kayıtlı durumunu temizler. Kod ve versiyon değişiklikleri tekrar onay gerektirir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna přístupu vymaže uložený stav tohoto pluginu. Změny kódu a verze vyžadují opětovné schválení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmena prístupu vymaže uložený stav tohto doplnku. Zmeny kódu a verzie vyžadujú opätovné schválenie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αλλαγή της πρόσβασης διαγράφει την αποθηκευμένη κατάσταση αυτής της προσθήκης. Οι αλλαγές κώδικα και έκδοσης απαιτούν ξανά έγκριση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du ändrar åtkomst rensas plugin-programmets sparade tillstånd. Kod- och versionsändringar kräver godkännande igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændring af adgang rydder dette plugins gemte tilstand. Kode- og versionsændringer kræver godkendelse igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endring av tilgang sletter denne pluginens lagrede tilstand. Kode- og versjonsendringer krever godkjenning på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttöoikeuden muuttaminen tyhjentää tämän laajennuksen tallennetun tilan. Koodi- ja versiomuutokset vaativat uudelleen hyväksynnän."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah akses akan menghapus status tersimpan plugin ini. Perubahan kode dan versi memerlukan persetujuan lagi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc thay đổi quyền truy cập sẽ xóa trạng thái đã lưu của plugin này. Những thay đổi về mã và phiên bản cần được phê duyệt lại."
          }
        }
      }
    },
