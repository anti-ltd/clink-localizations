          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwyder elke pasgemaakte profiel permanent. Ingeboude profiele word behou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwale usuwa każdy profil niestandardowy. Wbudowane profile zostają zachowane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назавжди видаляє всі власні профілі. Вбудовані профілі зберігаються."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her özel profili kalıcı olarak kaldırır. Yerleşik profiller korunur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvale odstraní každý vlastní profil. Vestavěné profily jsou zachovány."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Natrvalo odstráni každý vlastný profil. Vstavané profily sú zachované."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταργεί οριστικά κάθε προσαρμοσμένο προφίλ. Διατηρούνται τα ενσωματωμένα προφίλ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar bort varje anpassad profil permanent. Inbyggda profiler behålls."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner permanent alle brugerdefinerede profiler. Indbyggede profiler bevares."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner hver egendefinert profil permanent. Innebygde profiler beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa pysyvästi kaikki mukautetut profiilit. Sisäänrakennetut profiilit säilytetään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus setiap profil khusus secara permanen. Profil bawaan disimpan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa vĩnh viễn mọi hồ sơ tùy chỉnh. Hồ sơ tích hợp được lưu giữ."
          }
        }
      }
    },
    "Permanently removes every custom theme and its background photos.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt dauerhaft alle eigenen Themes und ihre Hintergrundfotos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente todos los temas personalizados y sus fotos de fondo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemaldab jäädavalt kõik kohandatud teemad ja nende taustafotod."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement tous les thèmes personnalisés et leurs photos d’arrière-plan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Végleg eltávolít minden egyéni témát és háttérképét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove definitivamente tutti i temi personalizzati e le relative foto di sfondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのカスタムテーマと背景写真を完全に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 사용자 설정 테마와 배경 사진을 영구적으로 제거합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengalih keluar semua tema tersuai dan foto latarnya secara kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove permanentemente todos os temas personalizados e as respetivas fotos de fundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратно удаляет все пользовательские темы и их фоновые фотографии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
