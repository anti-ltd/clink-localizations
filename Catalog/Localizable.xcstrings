    "Always-on keys ride along on all of them, either side of the space bar, no matter which layout or language you're in.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altyd-aan-sleutels ry saam op almal van hulle, weerskante van die spasiebalk, maak nie saak in watter uitleg of taal jy is nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauerhafte Tasten sind überall dabei, links oder rechts von der Leertaste, egal in welchem Layout oder welcher Sprache du bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas siempre visibles te acompañan en todas, a un lado u otro de la barra espaciadora, sea cual sea la distribución o el idioma."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Püsiklahvid on kaasas kõikjal, tühikuklahvi kummalegi poole, ükskõik millises paigutuses või keeles sa oled."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches toujours présentes te suivent partout, d'un côté ou de l'autre de la barre d'espace, quelle que soit la disposition ou la langue."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mindig látható billentyűk mindegyiken ott vannak, a szóköz két oldalán, bármilyen kiosztásban vagy nyelven gépelsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti sempre presenti ti seguono ovunque, ai lati della barra spaziatrice, qualunque sia il layout o la lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「常時表示のキー」はスペースバーの左右に置かれ、レイアウトや言語が変わっても付いてきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 있는 키는 스페이스바 양옆에 자리 잡고, 레이아웃이나 언어가 바뀌어도 그대로 따라다닙니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci sentiasa ada mengikut anda pada semuanya, di kiri atau kanan bar ruang, tidak kira susun atur atau bahasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas sempre presentes acompanham-te em todos, de um lado ou outro da barra de espaços, seja qual for o esquema ou o idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постоянные клавиши едут вместе с ними по обе стороны пробела, в какой бы раскладке или языке вы ни были."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常驻按键会跟着你出现在每套布局上，在空格键的左边或右边，不管用哪种布局或语言。"
          }
        }
      }
    },
