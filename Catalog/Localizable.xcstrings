    "To bring the rest back, tap Show everything at the bottom of that screen.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Om die res terug te bring, tik Wys alles onderaan daardie skerm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um den Rest zurückzuholen, tippe unten auf diesem Bildschirm auf „Alles anzeigen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recuperar lo demás, toca Mostrar todo al final de esa pantalla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ülejäänu tagasi tuua, puuduta selle ekraani all Kuva kõik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour récupérer le reste, touche Tout afficher en bas de cet écran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A többi visszahozásához koppints a képernyő alján a Mutass mindent gombra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per riavere il resto, tocca Mostra tutto in fondo a quella schermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻すには、その画面の下にある「すべて表示」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나머지를 되돌리려면 그 화면 맨 아래의 ‘전체 보기’를 누릅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mendapatkannya semula, ketik Tunjukkan semuanya di bahagian bawah skrin itu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para trazeres o resto de volta, toca em Mostrar tudo no fim desse ecrã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы вернуть остальное, нажмите «Показать всё» внизу того экрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想找回其余部分，点那一屏底部的“显示全部”。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a aduce restul înapoi, atingeți Afișați totul în partea de jos a ecranului respectiv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om de rest terug te brengen, tik je op Alles weergeven onder aan dat scherm."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想找回其餘部分，點那一屏底部的“顯示全部”。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby przywrócić resztę, dotknij Pokaż wszystko u dołu ekranu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб повернути решту, торкніться «Показати все» внизу екрана."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri kalanını geri getirmek için ekranın alt kısmındaki Her şeyi göster'e dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li zbytek vrátit zpět, klepněte na Zobrazit vše ve spodní části obrazovky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete vrátiť zvyšok späť, klepnite na Zobraziť všetko v dolnej časti obrazovky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να επαναφέρετε τα υπόλοιπα, πατήστε Εμφάνιση όλων στο κάτω μέρος αυτής της οθόνης."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att ta tillbaka resten, tryck på Visa allt längst ned på skärmen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at bringe resten tilbage, tryk på Vis alt nederst på skærmen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å få resten tilbake, trykk på Vis alt nederst på skjermen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit palauttaa loput napauttamalla Näytä kaikki kyseisen näytön alareunassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengembalikan sisanya, ketuk Tampilkan semuanya di bagian bawah layar itu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để đưa phần còn lại trở lại, hãy nhấn Hiển thị mọi thứ ở cuối màn hình đó."
          }
        }
      }
    },
    "To make your own, tap Create theme.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Om jou eie te maak, tik Skep tema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ein eigenes tippst du auf „Theme erstellen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para hacer uno tuyo, toca Crear tema."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Oma tegemiseks puuduta Loo teema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour créer le tien, touche Créer un thème."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sajátot a Hozzon létre témát gombbal indíthatsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per farne uno tuo, tocca Crea tema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
