            "state": "translated",
            "value": "AI Tools panelinden kaldırılacaktır. Bu geri alınamaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bude odstraněn z panelu nástrojů AI. Toto nelze vrátit zpět."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstráni sa z panela nástrojov AI. Toto sa nedá vrátiť späť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα αφαιρεθεί από τον πίνακα AI Tools. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kommer att tas bort från AI-verktygspanelen. Detta kan inte ångras."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det fjernes fra AI-værktøjspanelet. Dette kan ikke fortrydes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det vil bli fjernet fra AI Tools-panelet. Dette kan ikke angres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se poistetaan AI Tools -paneelista. Tätä ei voi kumota."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu akan dihapus dari panel AI Tools. Hal ini tidak dapat dibatalkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó sẽ bị xóa khỏi bảng Công cụ AI. Không thể hoàn tác việc này."
          }
        }
      }
    },
    "It's separate from what you type in, so the app can be in one language while the keyboard writes another.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is apart van wat jy intik, so die toepassing kan in een taal wees terwyl die sleutelbord 'n ander skryf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie ist unabhängig davon, worin du schreibst: die App kann in einer Sprache laufen, während die Tastatur eine andere tippt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es independiente de lo que escribes: la app puede estar en un idioma mientras el teclado escribe en otro."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on eraldi sellest, mida sa tipid, nii et rakendus võib olla ühes keeles, samal ajal kui klaviatuur tipib teises."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est indépendante de ce que tu écris : l'app peut être dans une langue pendant que le clavier en tape une autre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Független attól, hogy min gépelsz: az app lehet az egyik nyelven, míg a billentyűzet egy másikon ír."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È indipendente da ciò in cui scrivi: l'app può stare in una lingua mentre la tastiera ne scrive un'altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力する言語とは別なので、アプリは一つの言語、キーボードは別の言語という組み合わせもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 언어와는 별개라, 앱은 한 언어로 두고 키보드로는 다른 언어를 쓸 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia berasingan daripada bahasa taipan anda: apl boleh dalam satu bahasa sementara papan kekunci menulis dalam bahasa lain."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É independente do que escreves: a app pode estar num idioma enquanto o teclado escreve noutro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не связано с языком печати, поэтому приложение может быть на одном языке, а клавиатура писать на другом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它和你打字用的语言是分开的：App 可以是一种语言，键盘写另一种。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este separat de ceea ce tastați, astfel încât aplicația poate fi într-o limbă în timp ce tastatura scrie alta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het staat los van wat u typt, dus de app kan in de ene taal zijn terwijl het toetsenbord een andere taal schrijft."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它和你打字用的語言是分開的：App 可以是一種語言，鍵盤寫另一種。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest to niezależne od tego, co wpiszesz, więc aplikacja może być w jednym języku, podczas gdy klawiatura pisze w innym."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не те, що ви вводите, тому програма може працювати однією мовою, а клавіатура пише іншою."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazdıklarınızdan farklıdır, dolayısıyla klavye başka bir dilde yazarken uygulama bir dilde olabilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to oddělené od toho, co píšete, takže aplikace může být v jednom jazyce, zatímco klávesnice píše jiný."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to oddelené od toho, čo zadávate, takže aplikácia môže byť v jednom jazyku, zatiaľ čo klávesnica píše v inom."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι ξεχωριστό από αυτό που πληκτρολογείτε, ώστε η εφαρμογή να μπορεί να είναι σε μια γλώσσα ενώ το πληκτρολόγιο γράφει μια άλλη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den är skild från vad du skriver in, så appen kan vara på ett språk medan tangentbordet skriver ett annat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er adskilt fra det, du indtaster, så appen kan være på ét sprog, mens tastaturet skriver et andet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er atskilt fra det du skriver inn, så appen kan være på ett språk mens tastaturet skriver et annet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on erillinen kirjoittamastasi tekstistä, joten sovellus voi olla yhdellä kielellä ja näppäimistö kirjoittaa toisella kielellä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini terpisah dari apa yang Anda ketik, sehingga aplikasi dapat menggunakan satu bahasa sementara keyboard menulis bahasa lain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó tách biệt với nội dung bạn nhập, vì vậy ứng dụng có thể ở một ngôn ngữ trong khi bàn phím viết ngôn ngữ khác."
          }
        }
      }
    },
    "Its dictionaries stay on this device, but nothing will be typing in it. You can’t undo this.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sy woordeboeke bly op hierdie toestel, maar niks sal daarin tik nie. Jy kan dit nie ongedaan maak nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wörterbücher bleiben auf dem Gerät, aber getippt wird darin nicht mehr. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus diccionarios se quedan en el dispositivo, pero ya no se escribirá en él. No se puede deshacer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle sõnaraamatud jäävad sellesse seadmesse, aga selles ei tipita enam midagi. Seda ei saa tagasi võtta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses dictionnaires restent sur l’appareil, mais plus rien ne s’écrira dans cette langue. C’est irréversible."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szótárai az eszközön maradnak, de többé nem gépelsz rajta. Ez nem vonható vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoi dizionari restano sul dispositivo, ma non ci scriverai più. L’operazione non è reversibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書は端末に残りますが、この言語で入力することはできなくなります。取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전은 기기에 남지만, 이 언어로는 더 이상 입력하지 않습니다. 되돌릴 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamusnya kekal pada peranti ini, tetapi tiada apa-apa akan ditaip dalamnya lagi. Tindakan ini tidak boleh dibatalkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dicionários ficam neste dispositivo, mas deixas de escrever nele. Não dá para desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его словари останутся на устройстве, но печатать на нём больше ничего не будет. Отменить это нельзя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的词典会留在这台设备上，但不会再用它输入。此操作无法撤销。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicționarele sale rămân pe acest dispozitiv, dar nu va introduce nimic în el. Nu poți anula acest lucru."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De woordenboeken blijven op dit apparaat staan, maar er wordt niets in getypt. Je kunt dit niet ongedaan maken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的詞典會留在這臺裝置上，但不會再用它輸入。此操作無法撤銷。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego słowniki pozostaną na tym urządzeniu, ale nic nie będzie w nim pisane. Nie możesz tego cofnąć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його словники залишаються на цьому пристрої, але в ньому нічого не друкуватимуть. Ви не можете скасувати це."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözlükleri bu cihazda kalacak, ancak içine hiçbir şey yazılmayacak. Bunu geri alamazsınız."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho slovníky zůstanou v tomto zařízení, ale nic do něj nebude psát. Tuto akci nelze vrátit zpět."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho slovníky zostanú v tomto zariadení, ale nič sa v ňom nebude písať. Túto akciu nemôžete vrátiť späť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα λεξικά του παραμένουν σε αυτήν τη συσκευή, αλλά τίποτα δεν θα πληκτρολογεί σε αυτήν. Δεν μπορείτε να το αναιρέσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dess ordböcker finns kvar på den här enheten, men ingenting kommer att skrivas i den. Du kan inte ångra detta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dens ordbøger forbliver på denne enhed, men intet vil skrive i den. Du kan ikke fortryde dette."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordbøkene forblir på denne enheten, men ingenting vil skrives inn i den. Du kan ikke angre dette."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen sanakirjat pysyvät tällä laitteella, mutta siihen ei kirjoiteta mitään. Tätä ei voi kumota."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamusnya tetap ada di perangkat ini, tetapi tidak ada yang bisa diketik di dalamnya. Anda tidak dapat membatalkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ điển của nó vẫn còn trên thiết bị này, nhưng sẽ không có gì được gõ vào đó. Bạn không thể hoàn tác việc này."
          }
        }
      }
    },
