          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの隅に小さなペットが住んでいて、入力に反応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 구석에 작은 펫이 살면서 입력에 반응해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
