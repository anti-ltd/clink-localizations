    "Compute delay 200ms. Fewer checks, best battery.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bereken vertraging 200ms. Minder tjeks, beste battery."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechenverzögerung 200 ms. Weniger Prüfungen, beste Akkulaufzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retardo de cálculo 200ms. Menos comprobaciones, mejor batería."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvutuse viive 200 ms. Vähem kontrolle, parim aku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai de calcul de 200 ms. Moins de vérifs, meilleure autonomie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Számítási késleltetés 200 ms. Kevesebb ellenőrzés, kímélőbb az akkuval."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritardo di calcolo 200ms. Meno controlli, più batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算の間隔は200ms。チェックが少なく、バッテリーにいちばんやさしい設定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산 지연 200ms. 검사를 덜 하고 배터리가 제일 오래가요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengah kiraan 200ms. Kurang semakan, bateri paling jimat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atraso de cálculo de 200ms. Menos verificações, melhor bateria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержка вычисления 200 мс. Меньше проверок, лучше для батареи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算延迟 200ms。检查更少，最省电。"
          }
        }
      }
    },
    "Compute delay 30ms. Snappiest bar, most CPU. The native default.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bereken vertraging 30ms. Snappiste bar, meeste CPU. Die inheemse verstek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechenverzögerung 30 ms. Flinkste Leiste, meiste CPU. Der Native-Standard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retardo de cálculo 30ms. Barra más ágil, más CPU. El valor nativo predeterminado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvutuse viive 30 ms. Nobedaim riba, enim CPU. Süsteemne vaikeväärtus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai de calcul de 30 ms. Barre la plus réactive, plus de CPU. Le réglage natif par défaut."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Számítási késleltetés 30 ms. Leggyorsabb sáv, több CPU. A natív alapértelmezés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritardo di calcolo 30ms. Barra più reattiva, più CPU. L'impostazione nativa predefinita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算の間隔は30ms。バーがいちばんキビキビ動き、CPUもいちばん使います。 ネイティブの初期設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산 지연 30ms. 바가 제일 빠르고 CPU를 제일 많이 써요. 네이티브 기본값."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengah kiraan 30ms. Bar paling pantas, guna CPU paling banyak. Nilai asal lalai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atraso de cálculo de 30ms. Barra mais rápida, mais CPU. O padrão nativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержка вычисления 30 мс. Самая отзывчивая строка, больше всего нагрузки на процессор. Нативное значение по умолчанию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算延迟 30ms。候选栏最跟手，CPU 占用也最高。 原生默认值。"
          }
        }
      }
    },
