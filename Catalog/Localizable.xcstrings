    "Tap Restore Purchases, signed in with the Apple Account you bought it on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Käufe wiederherstellen“ — angemeldet mit dem Apple-Account, mit dem du gekauft hast."
          }
        },
        "es": {
