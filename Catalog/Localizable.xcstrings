    "Your clips ride the suggestion bar. Tap to paste.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou snitte ry die voorstelbalk. Tik om te plak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Clips liegen in der Vorschlagsleiste. Tippe zum Einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus clips van en la barra de sugerencias: toca para pegar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu klipid sõidavad soovituseribal. Puuduta, et kleepida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes clips s'affichent dans la barre de suggestions. Touche pour coller."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágólap-elemek a javaslatsávban. Koppints a beillesztéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue clip stanno nella barra dei suggerimenti: tocca per incollare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップは変換候補バーに表示されます。タップで貼り付け。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립이 추천 바에 표시돼요. 탭하면 붙여넣기돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip anda berada pada bar cadangan. Ketik untuk tampal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus clips ficam na barra de sugestões. Toque para colar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши фрагменты едут в строке подсказок. Нажмите, чтобы вставить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴内容显示在候选栏，点按即可粘贴。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipurile dvs. merg pe bara de sugestii. Atingeți pentru a lipi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je clips verschijnen op de suggestiebalk. Tik om te plakken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼內容顯示在候選欄，點按即可貼上。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje klipy wyświetlają się na pasku sugestii. Kliknij, aby wkleić."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші кліпи їздять на панелі пропозицій. Торкніться, щоб вставити."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipleriniz öneri çubuğuna biner. Yapıştırmak için dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše klipy jsou na liště návrhů. Klepnutím vložíte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše klipy sú na paneli návrhov. Klepnutím prilepíte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κλιπ σας οδηγούν στη γραμμή προτάσεων. Πατήστε για επικόλληση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina klipp går i förslagsfältet. Tryck för att klistra in."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine klip kører på forslagslinjen. Tryk for at indsætte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klippene dine kjører på forslagslinjen. Trykk for å lime inn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leikesi ohjaavat ehdotuspalkkia. Liitä napauttamalla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip Anda berada di bilah saran. Ketuk untuk menempelkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clip của bạn xuất hiện trên thanh gợi ý. Nhấn để dán."
          }
        }
      }
    },
    "Your conversation stays on your device. GIF searches and selections go to KLIPY.": {
      "comment": "GIF browser UI and accessibility. Native-speaker editorial sign-off for this release is tracked in docs/gif-tool-localization-review.md.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your conversation stays on your device. GIF searches and selections go to KLIPY."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu conversación se queda en tu dispositivo. Las búsquedas y selecciones de GIFs se envían a KLIPY."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta conversation reste sur ton appareil. Tes recherches et tes choix de GIFs sont envoyés à KLIPY."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Unterhaltung bleibt auf deinem Gerät. GIF-Suchanfragen und deine GIF-Auswahl werden an KLIPY gesendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversazione resta sul tuo dispositivo. Le ricerche e le selezioni di GIF vengono inviate a KLIPY."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua conversa fica no teu dispositivo. As pesquisas e seleções de GIFs são enviadas à KLIPY."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша переписка остаётся на устройстве. В KLIPY отправляются поисковые запросы и сведения о выбранных GIF."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbualan anda kekal pada peranti anda. Carian dan pilihan GIF dihantar kepada KLIPY."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszélgetésed az eszközödön marad. A GIF-kereséseket és a kiválasztott GIF-ek adatait elküldjük a KLIPY-nek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話の内容はデバイス上に保たれます。GIFの検索内容と選択情報はKLIPYに送信されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话内容保留在你的设备上。GIF 搜索和选择信息会发送给 KLIPY。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화 내용은 기기에만 남아요. GIF 검색 내용과 선택 정보는 KLIPY로 전송돼요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu vestlus jääb seadmesse. GIF-ide otsingud ja valikud saadetakse KLIPY-le."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversația dvs. rămâne pe dispozitiv. Căutările și selecțiile GIF merg la KLIPY."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw gesprek blijft op uw apparaat staan. GIF-zoekopdrachten en -selecties gaan naar KLIPY."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話內容保留在你的裝置上。GIF 搜尋和選擇資訊會傳送給 KLIPY。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou gesprek bly op jou toestel. GIF-soektogte en -keuses word na KLIPY gestuur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja rozmowa pozostanie na Twoim urządzeniu. Wyszukiwania i selekcje GIF trafiają do KLIPY."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша розмова залишається на вашому пристрої. Пошук і вибір GIF переходять до KLIPY."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşmanız cihazınızda kalır. GIF aramaları ve seçimleri KLIPY'ye gider."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše konverzace zůstane na vašem zařízení. Vyhledávání a výběr obrázků GIF přejde na KLIPY."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša konverzácia zostane na vašom zariadení. Vyhľadávanie a výber obrázkov GIF prejde na KLIPY."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συνομιλία σας παραμένει στη συσκευή σας. Οι αναζητήσεις και οι επιλογές GIF πηγαίνουν στο KLIPY."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din konversation stannar på din enhet. GIF-sökningar och val går till KLIPY."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din samtale forbliver på din enhed. GIF-søgninger og -valg går til KLIPY."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtalen din forblir på enheten din. GIF-søk og valg går til KLIPY."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskustelusi pysyy laitteessasi. GIF-haut ja -valinnat siirtyvät KLIPY:hen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Percakapan Anda tetap ada di perangkat Anda. Pencarian dan pemilihan GIF pergi ke KLIPY."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện của bạn vẫn còn trên thiết bị của bạn. Các tìm kiếm và lựa chọn GIF sẽ chuyển đến KLIPY."
          }
        }
      }
    },
    "Your current settings stay as they are.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou huidige instellings bly soos dit is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine aktuellen Einstellungen bleiben, wie sie sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus ajustes actuales se quedan como están."
