          "stringUnit": {
            "state": "translated",
            "value": "Затем продлевается ежемесячно. Отмена в любое время."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemudian diperbaharui setiap bulan. Batalkan pada bila-bila masa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezután havonta megújul. Bármikor lemondható."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その後は毎月更新されます。いつでも解約できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后每月续订，可随时取消。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이후 매월 갱신됩니다. 언제든 취소할 수 있습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seejärel uueneb iga kuu. Tühista igal ajal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoi se reînnoiește lunar. Anulați oricând."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daarna maandelijks verlengd. Annuleer op elk gewenst moment."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後每月續訂，可隨時取消。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hernu daarna maandeliks. Kanselleer enige tyd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następnie odnawia się co miesiąc. Anuluj w dowolnym momencie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потім оновлюється щомісяця. Скасувати будь-коли."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha sonra aylık olarak yenilenir. İstediğiniz zaman iptal edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poté se měsíčně obnovuje. Kdykoli zrušit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potom sa obnovuje mesačne. Zrušiť kedykoľvek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στη συνέχεια ανανεώνεται κάθε μήνα. Ακύρωση ανά πάσα στιγμή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förnyas sedan varje månad. Avbryt när som helst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes derefter månedligt. Annuller når som helst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes deretter månedlig. Avbryt når som helst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen jälkeen uusitaan kuukausittain. Peru milloin tahansa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemudian diperbarui setiap bulan. Batalkan kapan saja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau đó gia hạn hàng tháng. Hủy bỏ bất cứ lúc nào."
          }
        }
      }
    },
    "There are no keys, just a mic and something asking me to buy": {
      "extractionState": "manual",
