    "Up to %@ groups. Swipe a clip right in the keyboard panel to assign it.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot %@ groepe. Swiep 'n snit regs in die sleutelbordpaneel om dit toe te wys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu %@ Gruppen. Wisch einen Clip nach rechts, um ihn zuzuordnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta %@ grupos. Desliza un clip a la derecha en el panel del teclado para asignarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuni %@ gruppi. Viipa klipid klaviatuuri paneelil paremale, et need määrata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'à %@ groupes. Balaie un clip vers la droite dans le panneau du clavier pour l'assigner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb %@ csoport. Húzz egy vágólap-elemet jobbra a billentyűzet panelén, hogy hozzárendeld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a %@ gruppi. Scorri una clip verso destra nel pannello della tastiera per assegnarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループは最大 %@ 個までです。キーボードパネルでクリップを右にスワイプすると割り当てられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹은 최대 %@개예요. 키보드 패널에서 클립을 오른쪽으로 밀면 그룹에 넣을 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehingga %@ kumpulan. Leret klip ke kanan dalam panel papan kekunci untuk masukkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até %@ grupos. Desliza um clipe para a direita no painel do teclado para o atribuíres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До %@ групп. Смахните фрагмент вправо в панели на клавиатуре, чтобы отнести его к группе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %@ 个分组。在键盘面板里把剪贴内容向右滑，就能分到组里。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Până la grupurile %@. Glisați un clip spre dreapta în panoul tastaturii pentru a-l atribui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaal %@-groepen. Veeg een clip naar rechts in het toetsenbordpaneel om deze toe te wijzen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %@ 個分組。在鍵盤面板裡把剪貼內容向右滑，就能分到組裡。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do grup %@. Przesuń klip w prawo na panelu klawiatury, aby go przypisać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До груп %@. Щоб призначити кліп, проведіть пальцем праворуч на панелі клавіатури."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gruplarına kadar. Bir klibi atamak için klavye panelinde sağa kaydırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až do skupin %@. Chcete-li klip přiřadit, přejeďte prstem doprava na panelu klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Až do skupín %@. Potiahnite klip doprava na paneli klávesnice a priraďte ho."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έως ομάδες %@. Σύρετε ένα κλιπ προς τα δεξιά στον πίνακα του πληκτρολογίου για να το αντιστοιχίσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp till %@-grupper. Svep ett klipp åt höger på tangentbordspanelen för att tilldela det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op til %@ grupper. Stryg et klip til højre i tastaturpanelet for at tildele det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptil %@-grupper. Sveip et klipp til høyre i tastaturpanelet for å tilordne det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ryhmiin asti. Määritä leike pyyhkäisemällä oikealle näppäimistöpaneelissa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingga grup %@. Gesek klip ke kanan di panel keyboard untuk menetapkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lên đến nhóm %@. Vuốt một clip sang phải trong bảng bàn phím để gán nó."
          }
        }
      }
    },
    "Up to %@ groups. Swipe a clip right on History or in the keyboard panel to assign it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot %@ groepe. Swiep 'n snit regs op Geskiedenis of in die sleutelbordpaneel om dit toe te wys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu %@ Gruppen. Wische in „Verlauf“ oder auf dem Tastatur-Panel nach rechts über einen Clip, um ihn zuzuweisen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta %@ grupos. Desliza un fragmento a la derecha en Historial o en el panel del teclado para asignarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuni %@ rühma. Pühkige fragmendil paremale ajaloos või klaviatuuripaneelil, et see määrata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'à %@ groupes. Balayez un fragment vers la droite dans l'historique ou le panneau du clavier pour l'assigner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb %@ csoport. Csúsztasd jobbra egy folyamatot az Előzményekben vagy a billentyűzet-panelen a hozzárendeléshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a %@ gruppi. Scorri un frammento a destra nella Cronologia o nel pannello della tastiera per assegnarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大%@グループ。履歴またはキーボードパネルでクリップを右にスワイプすると割り当てられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 %@개 그룹. 기록 또는 키보드 패널에서 클립을 오른쪽으로 스와이프하면 지정됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehingga %@ kumpulan. Leret klip ke kanan dalam Sejarah atau panel papan kekunci untuk menetapkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até %@ grupos. Deslize um fragmento para a direita no Histórico ou no painel do teclado para o atribuir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До %@ групп. Проведите по фрагменту вправо в «Истории» или на панели клавиатуры, чтобы назначить его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %@ 个分组。在历史记录或键盘面板中向右滑动片段即可分配。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Până la grupurile %@. Glisați un clip la dreapta pe Istoric sau în panoul de la tastatură pentru a-l atribui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaal %@-groepen. Veeg een fragment naar rechts in de Geschiedenis of in het toetsenbordpaneel om het toe te wijzen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %@ 個分組。在歷史記錄或鍵盤面板中向右滑動片段即可分配。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do grup %@. Przesuń klip w prawo w Historii lub na panelu klawiatury, aby go przypisać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До груп %@. Щоб призначити кліп, проведіть пальцем праворуч в історії або на панелі клавіатури."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gruplarına kadar. Bir klibi atamak için Geçmiş'te veya klavye panelinde sağa kaydırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až do skupin %@. Chcete-li klip přiřadit, přejeďte prstem doprava na Historie nebo na panelu klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Až do skupín %@. Ak chcete klip priradiť, potiahnite prstom doprava v časti História alebo na paneli klávesnice."
          }
        },
