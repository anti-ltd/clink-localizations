          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一条平滑的丝带，有流光掠过。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O panglică netedă, cu o strălucire de lumină călătorie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een glad lint met een reizende glinstering van licht."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一條平滑的絲帶，有流光掠過。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gładka wstążka z podróżującym błyskiem światła."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гладка стрічка з мандрівним блиском світла."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezici bir ışık parıltısına sahip pürüzsüz bir şerit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hladká stuha s putujícím odleskem světla."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hladká stuha s putujúcim odleskom svetla."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια λεία κορδέλα με μια ακτίνα φωτός που ταξιδεύει."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett slätt band med en resande glimt av ljus."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et glat bånd med et rejseglimt af lys."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et glatt bånd med et reiseglimt av lys."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sileä nauha, jossa kimaltelevaa valoa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pita halus dengan kilatan cahaya keliling."
          }
        },
        "vi": {
