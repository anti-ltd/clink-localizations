    "Clink capitalises and adds punctuation on its own": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink schreibt groß und setzt Satzzeichen von selbst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink pone mayúsculas y puntuación por su cuenta"
          }
        },
        "fr": {
          "stringUnit": {
