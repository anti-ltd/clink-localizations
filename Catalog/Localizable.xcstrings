    "Links credit the source projects. Opening one leaves the app.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakels gee krediet aan die bronprojekte. As u een oopmaak, word die toepassing verlaat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links verweisen auf die Ursprungsprojekte. Beim Öffnen verlässt du die App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces acreditan los proyectos originales. Al abrir uno, sales de la app."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingid osutavad allikprojektidele. Ühe avamisel lahkud rakendusest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens créditent les projets d'origine. En ouvrir un te fait quitter l'app."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A linkek a forrásprojekteket ismerik el. Megnyitásukkor elhagyod az appot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link accreditano i progetti originali. Aprirne uno ti fa uscire dall'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクは元のプロジェクトへのクレジットです。開くとアプリの外に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크는 원본 프로젝트를 표시해요. 열면 앱 밖으로 나가게 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pautan memberi kredit kepada projek sumber. Membukanya keluar dari apl."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os links dão crédito aos projetos de origem. Abrir um sai da app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки — благодарность исходным проектам. Переход по ссылке уводит из приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接会指向原始项目，点开会离开这个应用。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkurile creditează proiectele sursă. Deschiderea unuia iese din aplicație."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Links crediteren de bronprojecten. Als u er één opent, wordt de app verlaten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結會指向原始專案，點開會離開這個應用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Linki podają projekty źródłowe. Otwarcie jednego powoduje opuszczenie aplikacji."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання посилаються на вихідні проекти. Відкриваючи один, програма залишає додаток."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantılar kaynak projelere atıfta bulunur. Birini açmak uygulamadan çıkar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkazy připisují zdrojové projekty. Otevřením jednoho opustíte aplikaci."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkazy pripisujú zdrojové projekty. Otvorením jedného opustíte aplikáciu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σύνδεσμοι πιστώνουν τα έργα πηγής. Ανοίγοντας ένα φεύγει από την εφαρμογή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Länkar krediterar källprojekten. Att öppna en lämnar appen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Links krediterer kildeprojekterne. Åbning af en forlader appen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lenker krediterer kildeprosjektene. Åpning av en forlater appen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkit antavat tunnustusta lähdeprojektille. Kun avaat yhden, sovellus poistuu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan memberi kredit pada proyek sumber. Membukanya akan meninggalkan aplikasi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết ghi nhận các dự án nguồn. Mở một cái sẽ rời khỏi ứng dụng."
          }
        }
      }
    },
    "Links in the app are for attribution. They open Safari only if you tap them.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakels in die toepassing is vir toeskrywing. Hulle maak Safari net oop as jy daarop tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links in der App dienen der Namensnennung. Safari öffnet sich nur, wenn du sie antippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces de la app son para dar crédito. Solo abren Safari si los tocas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingid rakenduses on autoritunnustuse jaoks. Need avavad Safari ainult siis, kui sa neid puudutad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens dans l'app servent à l'attribution. Ils n'ouvrent Safari que si tu les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appban lévő linkek a forrás megjelölésére vannak. A Safarit csak akkor nyitják meg, ha rájuk koppintasz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link nell'app servono per l'attribuzione. Aprono Safari solo se li tocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内のリンクは出典を示すためのものです。タップしたときだけ Safari が開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 안의 링크는 출처를 밝히려고 넣은 거예요. 눌렀을 때만 Safari가 열려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pautan dalam app ini untuk atribusi. Ia cuma buka Safari kalau anda ketiknya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ligações na app são para atribuição. Só abrem o Safari se as tocares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки в приложении нужны для указания авторства. Safari откроется, только если вы на них нажмёте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用里的链接是用来署名的。你点了才会打开 Safari。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkurile din aplicație sunt pentru atribuire. Ei deschid Safari numai dacă le atingeți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Links in de app zijn ter attributie. Ze openen Safari alleen als je erop tikt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用裡的連結是用來署名的。你點了才會開啟 Safari。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Linki w aplikacji służą do przypisania autorstwa. Otwierają Safari tylko wtedy, gdy je dotkniesz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання в додатку призначені для атрибуції. Вони відкривають Safari, лише якщо їх торкнутися."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadaki bağlantılar atıf içindir. Safari'yi yalnızca onlara dokunduğunuzda açarlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkazy v aplikaci slouží k uvedení zdroje. Safari otevřou, pouze když na ně klepnete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkazy v aplikácii slúžia na uvedenie zdroja. Safari otvoria, iba ak na ne klepnete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σύνδεσμοι στην εφαρμογή προορίζονται για απόδοση. Ανοίγουν το Safari μόνο αν τους πατήσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Länkar i appen är för attribution. De öppnar bara Safari om du trycker på dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Links i appen er til attribution. De åbner kun Safari, hvis du trykker på dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Linker i appen er for attribusjon. De åpner Safari bare hvis du trykker på dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksen linkit on tarkoitettu tekijän määrittämistä varten. Ne avaavat Safarin vain, jos kosketat niitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan di aplikasi adalah untuk atribusi. Mereka membuka Safari hanya jika Anda mengetuknya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các liên kết trong ứng dụng là để ghi công. Chúng chỉ mở Safari nếu bạn chạm vào chúng."
          }
        }
      }
    },
