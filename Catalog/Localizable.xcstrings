    "Load data and pictures from these sites on this plugin’s pages in the app. Never from the keyboard.": {
      "comment": "Explains the plugin Network permission. The list of website host names is shown directly beneath it.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt Daten und Bilder von diesen Websites auf den Seiten dieses Plugins in der App. Nie über die Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga datos e imágenes de estos sitios en las páginas de este plugin dentro de la app. Nunca desde el teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadib neilt saitidelt andmeid ja pilte selle pistikprogrammi lehtedele rakenduses. Klaviatuurilt mitte kunagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge des données et des images depuis ces sites dans les pages de ce plugin, dans l’app. Jamais depuis le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adatok és képek betöltése ezekről a webhelyekről a bővítmény oldalain az appban. A billentyűzetről soha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica dati e immagini da questi siti nelle pagine di questo plugin all’interno dell’app. Mai dalla tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内のこのプラグインのページで、これらのサイトからデータと画像を読み込みます。キーボードからは読み込みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 안의 이 플러그인 페이지에서 이 사이트들의 데이터와 이미지를 불러옵니다. 키보드에서는 불러오지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muatkan data dan gambar daripada laman ini pada halaman pemalam ini dalam apl. Tidak sekali-kali daripada papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega dados e imagens destes sites nas páginas deste plugin na app. Nunca a partir do teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружать данные и изображения с этих сайтов на страницах плагина в приложении. Никогда — с клавиатуры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App 内此插件的页面中，从这些网站加载数据和图片。绝不会从键盘加载。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încărcați date și imagini de pe aceste site-uri pe paginile acestui plugin din aplicație. Niciodată de la tastatură."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laad gegevens en afbeeldingen van deze sites op de pagina's van deze plug-in in de app. Nooit vanaf het toetsenbord."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App 內此外掛的頁面中，從這些網站載入資料和圖片。絕不會從鍵盤載入。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laai data en prente van hierdie webwerwe af na hierdie inprop se bladsye in die toepassing. Nooit vanaf die sleutelbord nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Załaduj dane i zdjęcia z tych witryn na stronach tej wtyczki w aplikacji. Nigdy z klawiatury."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажте дані та зображення з цих сайтів на сторінки цього плагіна в програмі. Ніколи з клавіатури."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sitelerdeki verileri ve resimleri uygulamadaki bu eklentinin sayfalarına yükleyin. Asla klavyeden."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načtěte data a obrázky z těchto webů na stránky tohoto pluginu v aplikaci. Nikdy z klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Načítajte údaje a obrázky z týchto stránok na stránkach tohto doplnku v aplikácii. Nikdy nie z klávesnice."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φορτώστε δεδομένα και εικόνες από αυτούς τους ιστότοπους στις σελίδες αυτής της προσθήκης στην εφαρμογή. Ποτέ από το πληκτρολόγιο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladda data och bilder från dessa webbplatser på detta plugins sidor i appen. Aldrig från tangentbordet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indlæs data og billeder fra disse websteder på dette plugins sider i appen. Aldrig fra tastaturet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Last inn data og bilder fra disse nettstedene på denne plugin-siden i appen. Aldri fra tastaturet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataa tietoja ja kuvia näistä sivustoista tämän laajennuksen sivuille sovelluksessa. Ei koskaan näppäimistöltä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat data dan gambar dari situs-situs ini di halaman plugin ini di aplikasi. Tidak pernah dari keyboard."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải dữ liệu và hình ảnh từ các trang web này trên các trang của plugin này trong ứng dụng. Không bao giờ từ bàn phím."
          }
        }
