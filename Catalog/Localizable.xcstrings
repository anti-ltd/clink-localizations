    },
    "Add one to the left or right of space, and give it what it should do.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg een links of regs van spasie by en gee dit wat dit moet doen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg eine links oder rechts von der Leertaste an und gib ihr eine Aufgabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una a la izquierda o a la derecha del espacio y dile qué debe hacer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa üks tühikust vasakule või paremale ja anna talle ülesanne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutes-en une à gauche ou à droite de l'espace, et dis-lui quoi faire."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegyél fel egyet a szóköz bal vagy jobb oldalára, és add meg, mit csináljon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungine uno a sinistra o a destra dello spazio e assegnagli cosa fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースの左か右に1つ追加して、そのキーの役割を決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스 왼쪽이나 오른쪽에 하나 추가하고, 무슨 일을 할지 정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah satu di kiri atau kanan ruang, dan tetapkan apa yang perlu dilakukannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona uma à esquerda ou à direita do espaço e define o que ela faz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте её слева или справа от пробела и задайте, что она делает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在空格左边或右边加一个，再给它指定要做的事。"
          }
        }
      }
    },
    "Add one under Create: the shortcut, then the phrase it turns into.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge unter Erstellen zuerst das Kürzel und dann den Text ein, der es ersetzen soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade uno en Crear: primero el atajo y después la frase en la que se convierte."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa jaotises „Loo” kõigepealt lühend ja seejärel fraas, millega see asendatakse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute-en un dans Créer : le raccourci, puis la phrase qui le remplace."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Létrehozás résznél előbb add meg a rövidítést, majd a kifejezést, amellyé ki szeretnéd egészíteni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungine una in Crea: prima la scorciatoia, poi la frase in cui si trasforma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「作成」で、ショートカットと変換後のフレーズを順に入力して追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘만들기’에서 단축어를 입력한 다음, 단축어가 바뀔 문구를 입력해 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan di bahagian Cipta: masukkan singkatan, kemudian frasa penggantinya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um em Criar: primeiro o atalho e depois a frase que o substitui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В разделе «Создать» сначала введите сокращение, затем фразу, в которую оно будет разворачиваться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“创建”中，先输入快捷短语，再输入要替换成的内容，然后添加。"
          }
        }
      }
    },
    "Add one: the shortcut, then the phrase it turns into.": {
      "extractionState": "manual",
