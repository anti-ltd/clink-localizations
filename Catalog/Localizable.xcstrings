    "Type a shortcut, press space, and Clink inserts the phrase. Stays on this device; overrides Settings → Keyboard shortcuts on conflict.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik 'n kortpad, druk spasie, en Clink voeg die frase in. Bly op hierdie toestel; ignoreer Instellings → Sleutelbordkortpaaie op konflik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe das Kürzel, drücke die Leertaste, und Clink setzt den Ausdruck ein. Bleibt auf diesem Gerät und geht bei gleichem Kürzel den Einstellungen vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe el atajo, pulsa espacio y Clink inserta la frase. Se queda en este dispositivo y tiene prioridad sobre los atajos de Ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipi otsetee, vajuta tühikut ja Clink sisestab fraasi. Jääb sellesse seadmesse; konfliktis alistab Seaded → Klaviatuuri otseteed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tape le raccourci, appuie sur espace et Clink insère l'expression. Reste sur cet appareil et l'emporte sur les raccourcis des Réglages."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd be a rövidítést, nyomj szóközt, és a Clink beszúrja a kifejezést. Ezen az eszközön marad, és ütközés esetén felülírja a Beállítások rövidítéseit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi la scorciatoia, premi spazio e Clink inserisce la frase. Resta su questo dispositivo e ha la precedenza sulle scorciatoie di Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを入力してスペースを押すと、フレーズが挿入されます。この端末に留まり、重複時は「設定」のショートカットより優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어를 입력하고 스페이스를 누르면 문구가 삽입됩니다. 이 기기에만 저장되고, 겹칠 때는 설정의 단축어보다 우선합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip pintasan, tekan space, dan Clink memasukkan frasa itu. Kekal pada peranti ini dan mengatasi pintasan dalam Tetapan jika bertindih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve o atalho, carrega no espaço e o Clink insere a frase. Fica neste dispositivo e prevalece sobre os atalhos dos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наберите сокращение, нажмите пробел — и Clink вставит фразу. Остаётся на этом устройстве; при конфликте перебивает системные сокращения из Настроек → «Клавиатура»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入快捷方式再按空格，Clink 就会插入短语。只保存在这台设备上，冲突时优先于“设置”里的快捷方式。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastați o comandă rapidă, apăsați spațiu și Clink inserează fraza. Rămâne pe acest dispozitiv; înlocuiește Configurări → Comenzi rapide de la tastatură în caz de conflict."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ een snelkoppeling, druk op de spatiebalk en Clink voegt de zin in. Blijft op dit apparaat; overschrijft Instellingen → Sneltoetsen bij conflict."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入快捷方式再按空格，Clink 就會插入短語。只儲存在這臺裝置上，衝突時優先於“設定”裡的快捷方式。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz skrót, naciśnij spację, a Clink wstawi frazę. Pozostaje na tym urządzeniu; zastępuje Ustawienia → Skróty klawiaturowe w przypadku konfliktu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть ярлик, натисніть пробіл, і Clink вставить фразу. Залишається на цьому пристрої; перевизначає Параметри → Комбінації клавіш у разі конфлікту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kısayol yazın, boşluk tuşuna basın ve Clink ifadeyi ekler. Bu cihazda kalır; Çakışma durumunda Ayarlar → Klavye kısayollarını geçersiz kılar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte zkratku, stiskněte mezerník a Clink vloží frázi. Zůstane na tomto zařízení; přepíše Nastavení → Klávesové zkratky při konfliktu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíšte skratku, stlačte medzerník a Clink vloží frázu. Zostane na tomto zariadení; prepíše Nastavenia → Klávesové skratky pri konflikte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολογήστε μια συντόμευση, πατήστε το πλήκτρο διαστήματος και το Clink εισάγει τη φράση. Παραμένει σε αυτήν τη συσκευή. παρακάμπτει τις Ρυθμίσεις → Συντομεύσεις πληκτρολογίου σε διένεξη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv en genväg, tryck på blanksteg och Clink infogar frasen. Blir kvar på den här enheten; åsidosätter Inställningar → Kortkommandon vid konflikt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv en genvej, tryk på mellemrumstasten, og Clink indsætter sætningen. Forbliver på denne enhed; tilsidesætter Indstillinger → Tastaturgenveje ved konflikt."
          }
        },
        "nb": {
          "stringUnit": {
