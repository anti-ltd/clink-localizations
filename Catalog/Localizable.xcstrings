    "No trail. Nothing is drawn while you glide.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen spoor nie. Niks word geteken terwyl jy gly nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Spur. Beim Gleiten wird nichts gezeichnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin rastro. No se dibuja nada mientras deslizas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jälge pole. Libisemise ajal ei joonistata midagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune traînée. Rien ne s'affiche pendant que tu glisses."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs nyomvonal. Húzás közben semmi nem rajzolódik ki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna scia. Non viene disegnato niente mentre scorri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軌跡なし。スワイプ中は何も描かれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "궤적 없음. 밀어서 입력하는 동안 아무것도 그리지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada jejak. Tiada apa-apa dilukis semasa anda meluncur."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem rasto. Não é desenhado nada enquanto deslizas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без следа. Во время скольжения ничего не рисуется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不显示轨迹。滑动时什么都不画。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără urmă. Nimic nu este desenat în timp ce aluneci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen spoor. Er wordt niets getekend terwijl u glijdt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不顯示軌跡。滑動時什麼都不畫。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadnego śladu. Podczas szybowania nic nie jest rysowane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніякої стежки. Під час ковзання нічого не малюється."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İz yok. Siz süzülürken hiçbir şey çizilmez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádná stopa. Při klouzání se nic nekreslí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadna stopa. Počas plachtenia sa nič nekreslí."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς ίχνος. Τίποτα δεν σχεδιάζεται ενώ γλιστράτε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget spår. Ingenting ritas medan du glider."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen spor. Der bliver ikke tegnet noget, mens du glider."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen sti. Ingenting tegnes mens du glir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei polkua. Mitään ei piirretä liukuessasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada jejak. Tidak ada yang tergambar saat Anda meluncur."
