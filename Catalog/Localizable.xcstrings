        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lò xo thanh cách lắng xuống nhanh như thế nào. Thấp hơn là nhanh hơn."
          }
        }
      }
    },
    "How fast the spring settles. Lower is snappier, higher is more relaxed.": {
