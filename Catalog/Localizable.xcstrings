    "Already paid? Tap Restore Purchases on that screen and the keys come back.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Reeds betaal? Tik op Herstel aankope op daardie skerm en die sleutels kom terug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon bezahlt? Tippe dort auf „Käufe wiederherstellen“, dann sind die Tasten wieder da."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya has pagado? Toca Restaurar compras en esa pantalla y las teclas vuelven."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Juba makstud? Puuduta sellel ekraanil valikut „Taasta ostud\" ja klahvid tulevad tagasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà payé ? Touche Restaurer les achats sur cet écran et les touches reviennent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már fizettél? Koppints ott a Vásárlások visszaállítása gombra, és visszajönnek a billentyűk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già pagato? Tocca Ripristina acquisti su quella schermata e i tasti tornano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに購入済みなら、その画面で「購入を復元」をタップすればキーが戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 결제했다면 그 화면에서 구매 복원을 누르면 키가 돌아옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah bayar? Ketik Pulihkan Pembelian pada skrin itu dan kekuncinya kembali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já pagaste? Toca em Restaurar compras nesse ecrã e as teclas voltam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже оплатили? Нажмите «Восстановить покупки» на том экране — и всё вернётся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经付过了？在那个界面点“恢复购买”，按键就回来了。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja plătit? Atingeți Restabiliți achizițiile pe ecranul respectiv și cheile revin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al betaald? Tik op Aankopen herstellen op dat scherm en de toetsen komen terug."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經付過了？在那個介面點“恢復購買”，按鍵就回來了。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już zapłacony? Kliknij Przywróć zakupy na tym ekranie, a klucze wrócą."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вже заплатили? Натисніть «Відновити покупки» на цьому екрані, і ключі повернуться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten ödeme yaptınız mı? Bu ekranda Satın Alınanları Geri Yükle'ye dokunduğunuzda tuşlar geri gelir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Již zaplaceno? Klepněte na Obnovit nákupy na této obrazovce a klávesy se vrátí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Už zaplatené? Klepnite na Obnoviť nákupy na tejto obrazovke a klávesy sa vrátia späť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχετε ήδη πληρωθεί; Πατήστε Επαναφορά αγορών σε αυτήν την οθόνη και τα κλειδιά επιστρέφουν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redan betalt? Tryck på Återställ köp på den skärmen och nycklarna kommer tillbaka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Allerede betalt? Tryk på Gendan køb på den skærm, og tasterne kommer tilbage."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Allerede betalt? Trykk på Gjenopprett kjøp på den skjermen og tastene kommer tilbake."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Onko jo maksettu? Napauta Palauta ostokset kyseisellä näytöllä ja avaimet tulevat takaisin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah dibayar? Ketuk Pulihkan Pembelian di layar itu dan tombolnya kembali."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thanh toán chưa? Nhấn vào Khôi phục giao dịch mua trên màn hình đó và các phím sẽ quay trở lại."
          }
        }
      }
    },
    "Also fix words in search bars and other fields that normally turn autocorrect off. Never in URL, email, or number fields.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak ook woorde in soekbalke en ander velde reg wat gewoonlik outokorreksie afskakel. Nooit in URL-, e-pos- of nommervelde nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigiert Wörter auch in Suchleisten und anderen Feldern, die die Autokorrektur normalerweise abschalten. Nie in URL-, E-Mail- oder Zahlenfeldern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige también palabras en barras de búsqueda y otros campos que normalmente desactivan la autocorrección. Nunca en campos de URL, correo o números."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paranda ka sõnu otsinguribadel ja muudel väljadel, mis tavaliselt lülitavad automaatparanduse välja. Mitte kunagi URL-, e-posti- ega numbri-väljades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige aussi les mots dans les barres de recherche et les autres champs qui coupent normalement la correction auto. Jamais dans les champs URL, e-mail ou numériques."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olyan keresőmezőkben és más mezőkben is javít, ahol az automatikus javítás általában ki van kapcsolva. URL-, e-mail- és számmezőkben soha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corregge le parole anche nelle barre di ricerca e in altri campi che di solito disattivano la correzione automatica. Mai nei campi URL, email o numerici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ふだんは自動修正がオフになる検索バーなどのフィールドでも単語を直します。URL、メール、数字のフィールドでは行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보통 자동 수정이 꺼지는 검색창이나 다른 필드에서도 단어를 고쳐요. URL, 이메일, 숫자 필드에서는 절대 안 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Betulkan juga perkataan dalam bar carian dan medan lain yang biasanya matikan autobetul. Tak pernah dalam medan URL, e-mel, atau nombor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige também palavras nas barras de pesquisa e noutros campos que costumam desligar a correção automática. Nunca em campos de URL, email ou números."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправлять слова и в строках поиска и других полях, где автокоррекция обычно отключена. Никогда — в полях адресов, почты и чисел."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在搜索框等平时关掉自动更正的字段里也帮你改词。绝不在网址、邮箱或数字字段里改。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "De asemenea, remediați cuvintele din barele de căutare și din alte câmpuri care dezactivează corectarea automată. Niciodată în câmpurile URL, e-mail sau numere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigeer ook woorden in zoekbalken en andere velden waarvoor autocorrectie normaal gesproken is uitgeschakeld. Nooit in URL-, e-mail- of nummervelden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在搜尋框等平時關掉自動更正的欄位裡也幫你改詞。絕不在網址、郵箱或數字欄位裡改。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napraw także słowa w paskach wyszukiwania i innych polach, które zwykle wyłączają autokorektę. Nigdy w polach adresu URL, adresu e-mail lub numeru."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Також виправте слова в рядках пошуку та інших полях, які зазвичай вимикають автовиправлення. Ніколи в полях URL-адреси, електронної пошти чи номера."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıca arama çubuklarındaki ve normalde otomatik düzeltmeyi kapatan diğer alanlardaki sözcükleri de düzeltin. URL, e-posta veya numara alanlarında asla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravte také slova ve vyhledávacích panelech a dalších polích, která normálně automatické opravy vypínají. Nikdy v poli URL, e-mailu nebo čísla."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravte aj slová vo vyhľadávacích paneloch a iných poliach, ktoré bežne vypínajú automatické opravy. Nikdy v poli URL, e-mailu alebo čísla."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίσης, διορθώστε λέξεις σε γραμμές αναζήτησης και άλλα πεδία που συνήθως απενεργοποιούν την αυτόματη διόρθωση. Ποτέ σε πεδία URL, email ή αριθμού."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixa även ord i sökfält och andra fält som normalt stänger av autokorrigering. Aldrig i URL-, e-post- eller nummerfält."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ret også ord i søgelinjer og andre felter, der normalt slår autokorrektur fra. Aldrig i URL-, e-mail- eller nummerfelter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rett også ord i søkefelt og andre felt som normalt slår av autokorrektur. Aldri i URL-, e-post- eller nummerfelt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korjaa myös sanat hakupalkeissa ja muissa kentissä, jotka yleensä poistavat automaattisen korjauksen käytöstä. Ei koskaan URL-, sähköposti- tai numerokentissä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbaiki juga kata-kata di bilah pencarian dan bidang lain yang biasanya menonaktifkan koreksi otomatis. Jangan pernah di bidang URL, email, atau nomor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng thời sửa các từ trong thanh tìm kiếm và các trường khác thường tắt tính năng tự động sửa. Không bao giờ có trong các trường URL, email hoặc số."
          }
        }
      }
    },
