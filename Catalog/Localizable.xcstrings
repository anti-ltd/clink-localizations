    "Swipe up on the Return key to change language. The keys change with it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streich auf der Eingabetaste nach oben, um die Sprache zu wechseln. Die Tasten wechseln mit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia arriba en la tecla de retorno para cambiar de idioma. Las teclas cambian con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaie vers le haut sur la touche Retour pour changer de langue. Les touches changent avec elle."
          }
        },
        "hu": {
          "stringUnit": {
