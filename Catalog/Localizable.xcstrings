          }
        }
      }
    },
    "A tiny pet lives in the corner of your keyboard and reacts as you type.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "’n Klein troeteldier woon in die hoek van jou sleutelbord en reageer terwyl jy tik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Ecke deiner Tastatur wohnt ein kleines Haustier, das auf dein Tippen reagiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pequeña mascota vive en la esquina del teclado y reacciona mientras escribes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu klaviatuuri nurgas elab tilluke lemmikloom, mis reageerib sinu tipimisele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
