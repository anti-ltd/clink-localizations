    "One dial takes them from fully rounded to square-edged.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem einzigen Drehregler wechselst du von vollständig abgerundeten zu eckigen Tasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo dial permite pasar de bordes totalmente redondeados a esquinas rectas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühe nupuga saad muuta kuju täiesti ümarast kandiliseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule commande rotative permet de passer de bords entièrement arrondis à des angles droits."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen tárcsával állíthatod a formát a teljesen lekerekítettől a szögletesig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
