    "3pt key · 4pt row. Even gaps between keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "3pt sleutel · 4pt ry. Selfs gapings tussen sleutels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taste 3 pt · Reihe 4 pt. Gleichmäßige Lücken zwischen den Tasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecla 3pt · fila 4pt. Huecos iguales entre teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "3 pt klahv · 4 pt rida. Ühtlased pilud klahvide vahel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche 3 pt · rangée 4 pt. Espaces réguliers entre les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "3 pt billentyű · 4 pt sor. Egyenletes rések a billentyűk közt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasto 3pt · riga 4pt. Spazi uguali tra i tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー3pt · 行4pt。キーの間が均等にあきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 3pt · 행 4pt. 키 사이 간격이 고르게 떨어져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci 3pt · baris 4pt. Jurang sekata antara kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecla 3pt · linha 4pt. Espaços iguais entre as teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиша 3pt · ряд 4pt. Равные зазоры между клавишами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键3pt · 行4pt。按键间距很匀。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasta 3pt · rând 4pt. Chiar și goluri între taste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3pt sleutel · 4pt rij. Zelfs openingen tussen de toetsen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵3pt · 行4pt。按鍵間距很勻。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisz 3 pkt. · Wiersz 4 pkt. Nawet przerwy między klawiszami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ключ 3 пт · ряд 4 пт. Рівні проміжки між клавішами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3nokta tuşu · 4nk satır. Tuşlar arasındaki boşluklar bile."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "3pt klíč · 4pt řádek. Dokonce i mezery mezi klávesami."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "3pt kľúč · 4pt riadok. Dokonca aj medzery medzi klávesmi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλήκτρο 3pt · Σειρά 4pt. Ακόμη και κενά μεταξύ των κλειδιών."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "3pt nyckel · 4pt rad. Även mellanrum mellan nycklar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "3pt nøgle · 4pt række. Selv mellemrum mellem tasterne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "3pt nøkkel · 4pt rad. Til og med mellomrom mellom tastene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "3 pt avain · 4 pt rivi. Tasaiset aukot näppäinten välillä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci 3pt · baris 4pt. Bahkan kesenjangan antar tombol."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím 3pt · hàng 4pt. Ngay cả khoảng cách giữa các phím."
          }
        }
      }
