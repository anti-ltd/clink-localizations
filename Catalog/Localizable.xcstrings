        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogyan jelöli magát a nyelvbillentyű: zászlóval, földgömbbel vagy régiókóddal. Ha nincs zászló, a földgömbre vált."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come si mostra il tasto lingua: bandiera, globo o codice regione. Ripiega sul globo quando non c'è una bandiera disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語キーの表示のしかたです。旗、地球儀、または地域コード。旗がないときは地球儀になります。"
