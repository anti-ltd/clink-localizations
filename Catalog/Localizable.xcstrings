    "Picks the most natural word, not just the most common": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies die mees natuurlike woord, nie net die algemeenste nie"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt das natürlichste Wort, nicht nur das häufigste"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la palabra más natural, no solo la más común"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valib kõige loomulikuma sõna, mitte ainult kõige sagedasema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisit le mot le plus naturel, pas seulement le plus courant"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legtermészetesebb szót választja, nem csak a leggyakoribbat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sceglie la parola più naturale, non solo la più comune"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん多い単語ではなく、いちばん自然な単語を選びます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 흔한 단어가 아니라 가장 자연스러운 단어를 골라요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih perkataan paling semula jadi, bukan sekadar yang paling biasa"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe a palavra mais natural, não só a mais comum"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирает самое естественное слово, а не просто самое частое"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑最自然的词，不只是最常见的"
          }
        }
      }
    },
    "Picks up the names, slang, and jargon you type, not words the dictionary already has.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tel die name, slengtaal en jargon op wat jy tik, nie woorde wat die woordeboek reeds het nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkt sich Namen, Slang und Fachwörter, die du tippst – keine Wörter, die schon im Wörterbuch stehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende los nombres, la jerga y los tecnicismos que escribes, no las palabras que ya están en el diccionario."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabab nimesid, slängi ja žargooni, mida tipid, mitte sõnu, mis juba sõnaraamatus on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retient les noms, l'argot et le jargon que tu tapes, pas les mots que le dictionnaire connaît déjà."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjegyzi a neveket, a szlenget és a szakszavakat, amiket írsz – a szótárban meglévőket nem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impara i nomi, lo slang e il gergo che scrivi, non le parole che il dizionario ha già."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書にない名前やスラング、専門用語だけを覚えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전에 없는 이름, 은어, 전문 용어만 기억합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengingat nama, slanga dan jargon yang awak taip — bukan perkataan yang sudah ada dalam kamus."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda os nomes, a gíria e o jargão que escreves, não as palavras que o dicionário já tem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подхватывает имена, сленг и жаргон, которые вы печатаете, — а не слова, уже известные словарю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只记住你输入的名字、俚语和行话，词典里已有的词不记。"
          }
        }
      }
    },
