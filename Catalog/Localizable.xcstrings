    "That file isn't a NuKey theme, or it's from a newer version of NuKey than Clink can read.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Daardie lêer is nie 'n NuKey-tema nie, of dit kom van 'n nuwer weergawe van NuKey as wat Clink kan lees."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist kein NuKey-Design oder stammt aus einer neueren NuKey-Version, als Clink lesen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese archivo no es un tema de NuKey, o procede de una versión de NuKey más reciente de la que Clink puede leer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See fail ei ole NuKey teema või pärineb NuKey uuemast versioonist, kui Clink lugeda oskab."
