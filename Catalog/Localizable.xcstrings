    "Export a profile backup, or delete the app to wipe the App Group.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer 'n profielrugsteun uit, of vee die toepassing uit om die toepassinggroep uit te vee."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportier ein Profil-Backup, oder lösch die App, um die App Group zu leeren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta una copia de tu perfil, o borra la app para vaciar el App Group."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspordi profiili varukoopia või kustuta rakendus, et tühjendada App Group."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte une sauvegarde de profil, ou supprime l'app pour effacer l'App Group."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportálj egy profilmentést, vagy töröld az appot, hogy kiürüljön az App Group."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta un backup del profilo, oppure elimina l'app per cancellare l'App Group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルのバックアップを書き出すか、アプリを消せば App Group もまるごと消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필 백업을 내보내거나, 앱을 지우면 App Group도 같이 지워져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksport sandaran profil, atau padam app untuk kosongkan App Group."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta uma cópia de segurança do perfil, ou apaga a app para limpar o App Group."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выгрузите резервную копию профиля или удалите приложение, чтобы стереть App Group."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出一份配置备份，或者删掉应用来清空 App Group。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportați o copie de rezervă a profilului sau ștergeți aplicația pentru a șterge grupul de aplicații."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporteer een profielback-up of verwijder de app om de appgroep te wissen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出一份配置備份，或者刪掉應用來清空 App Group。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyeksportuj kopię zapasową profilu lub usuń aplikację, aby wyczyścić grupę aplikacji."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експортуйте резервну копію профілю або видаліть програму, щоб стерти групу програм."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir profil yedeğini dışa aktarın veya Uygulama Grubunu silmek için uygulamayı silin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportujte zálohu profilu nebo odstraňte aplikaci a vymažte skupinu aplikací."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportujte zálohu profilu alebo odstráňte aplikáciu a vymažte skupinu aplikácií."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξαγάγετε ένα αντίγραφο ασφαλείας προφίλ ή διαγράψτε την εφαρμογή για να διαγράψετε την Ομάδα Εφαρμογών."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportera en säkerhetskopia av profilen eller ta bort appen för att rensa appgruppen."
          }
        },
        "da": {
