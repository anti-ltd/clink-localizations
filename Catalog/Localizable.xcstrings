    "Steps in on the corrections the keyboard isn't sure about, so the close calls land right more often.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Greift bei Korrekturen ein, bei denen sich die Tastatur unsicher ist, damit knappe Fälle öfter richtig landen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Echa una mano en las correcciones de las que el teclado no está seguro, para que los casos dudosos acierten más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne un coup de main sur les corrections dont le clavier n'est pas sûr, pour que les cas limites tombent juste plus souvent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Besegít azoknál a javításoknál, amikben a billentyűzet nem biztos, így a bizonytalan esetek gyakrabban lesznek helyesek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interviene sulle correzioni di cui la tastiera non è sicura, così i casi incerti vanno a buon fine più spesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードが迷っている修正に手を貸して、際どいものもより正しく直るようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 긴가민가하는 수정에 끼어들어서, 애매한 경우를 더 자주 제대로 맞춰요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Campur tangan bila papan kekunci tak pasti dengan pembetulan, supaya keputusan rapat lebih kerap betul."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra em ação nas correções sobre as quais o teclado não tem a certeza, para que os casos duvidosos acertem mais vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вмешивается там, где клавиатура не уверена в исправлении, чтобы спорные случаи чаще решались верно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘拿不准的更正上多帮一把，让那些没把握的情况更常改对。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekkab parandustesse, mille suhtes klaviatuur pole kindel, nii et kahtlased juhtumid tabavad sagedamini õigesti."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stap in op die regstellings waaroor die sleutelbord nie seker is nie, so die close calls land meer gereeld reg."
          }
        }
      }
    },
    "Sticks close to the original wording, phrase by phrase.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt nah am Original, Wendung für Wendung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ciñe a la redacción original, frase por frase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste au plus près du texte d'origine, expression par expression."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szorosan követi az eredeti megfogalmazást, fordulatról fordulatra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta fedele al testo originale, frase per frase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原文の言い回しを一語一句そのままたどります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원문의 표현을 구절 단위로 그대로 따릅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengekalkan susunan kata asal, rangkai kata demi rangkai kata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém-se fiel à redação original, expressão a expressão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держится близко к исходным формулировкам, фраза за фразой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐句贴合原文的措辞。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Püsib originaali sõnastuse lähedal, fraasi kaupa."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bly naby die oorspronklike bewoording, frase vir frase."
          }
        }
      }
    },
    "Still missing? Raise Prediction strength a notch.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer noch daneben? Dreh die Vorhersagestärke eine Stufe hoch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sigues fallando? Sube un punto la Fuerza de predicción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours à côté ? Monte la Force de prédiction d'un cran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még mindig mellémegy? Told feljebb egy fokkal az Előrejelzés erősségét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbagli ancora? Alza di un gradino l'Intensità della previsione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それでも外れる場合は、「予測の強さ」を一段上げてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래도 빗나가면 예측 강도를 한 단계 올려 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih tersasar? Naikkan Kekuatan ramalan satu takuk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuas a falhar? Sobe a Força da previsão um ponto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё равно не хватает? Поднимите «Силу предсказаний» на ступень."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还是按不准？把“预测强度”往上调一档。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Endiselt puudu? Tõsta Ennustuse tugevust ühe astme võrra."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog steeds vermis? Verhoog voorspellingssterkte 'n kerf."
          }
        }
      }
    },
