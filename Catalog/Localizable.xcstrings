          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Trükkimine jääb sinu seadmesse. Ei kontot ega jälgimist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ввод остаётся на вашем устройстве. Без аккаунта и отслеживания."
