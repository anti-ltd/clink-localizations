    "Turn off Auto-capitalize or Auto punctuation. Smart quotes is one card down, under Punctuation.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel Outo-hoofletter of Outo-leestekens af. Slim aanhalingstekens is een kaart onder, onder Leestekens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Automatische Großschreibung oder Automatische Zeichensetzung aus. Intelligente Anführungszeichen findest du eine Karte tiefer, unter Zeichensetzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva Mayúsculas automáticas o Puntuación automática. Las Comillas tipográficas están una tarjeta más abajo, en Puntuación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita välja Automaatne suurtäht või Automaatsed kirjavahemärgid. Nutikad jutumärgid on kaardi võrra allpool jaotises Kirjavahemärgistus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive Majuscules automatiques ou Ponctuation automatique. Les Guillemets typographiques sont une carte plus bas, dans Ponctuation."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold ki az Automatikus nagybetűs írást vagy az Automatikus írásjeleket. Az Okos idézőjelek egy kártyával lejjebb, a Központozás alatt vannak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva Maiuscole automatiche o Punteggiatura automatica. Le Virgolette intelligenti sono una scheda più in basso, in Punteggiatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動大文字入力」または「自動句読点」をオフにします。「スマート引用符」は一つ下の「句読点」カードにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 대문자 또는 자동 문장 부호를 끄세요. 스마트 따옴표는 한 카드 아래 구두점에 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan Huruf besar automatik atau Tanda baca automatik. Tanda kutip pintar berada satu kad di bawah, dalam Tanda baca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga Maiúsculas automáticas ou Pontuação automática. As Aspas inteligentes ficam um cartão abaixo, em Pontuação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите «Автозаглавные» или «Автопунктуацию». «Типографские кавычки» — карточкой ниже, в «Знаках препинания»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭“自动大写”或“自动标点”。“智能引号”在下面一张卡片“标点”里。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivați scrierea cu majuscule automate sau punctuația automată. Ghilimele inteligente sunt cu o carte mai jos, sub Punctuație."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel automatisch hoofdlettergebruik of automatische interpunctie uit. Slimme aanhalingstekens staan ​​één kaart lager, onder Interpunctie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉“自動大寫”或“自動標點”。“智慧引號”在下面一張卡片“標點”裡。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz automatyczne pisanie wielkimi literami lub automatyczną interpunkcję. Inteligentne cytaty znajdują się o jedną kartę w dół, w obszarze Interpunkcja."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкніть автоматичне використання великих літер або автоматичну пунктуацію. Розумні лапки знаходяться на одну картку вниз, у розділі Пунктуація."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik büyük harf yap veya Otomatik noktalama işaretlerini kapatın. Akıllı alıntılar, Noktalama İşaretleri altında bir kart aşağıdadır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypněte Automatická velká písmena nebo Automatická interpunkce. Chytré uvozovky jsou o jednu kartu níže, pod interpunkcí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnite automatické veľké písmená alebo automatickú interpunkciu. Inteligentné úvodzovky sú o jednu kartu nižšie v časti Interpunkcia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιήστε την αυτόματη χρήση κεφαλαίων ή την αυτόματη στίξη. Τα έξυπνα εισαγωγικά είναι ένα φύλλο κάτω, κάτω από τα σημεία στίξης."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stäng av Auto-versal eller Auto interpunktion. Smarta citat är ett kort ner, under Skiljetecken."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiver Auto-store eller Automatisk tegnsætning. Smarte citater er et kort ned under Tegnsætning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå av Auto-store bokstaver eller Automatisk tegnsetting. Smarte anførselstegn er ett kort ned, under Tegnsetting."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita isot kirjaimet tai automaattiset välimerkit pois päältä. Älykkäät lainaukset on yksi kortti alaspäin, kohdassa Välimerkit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan Huruf besar otomatis atau Tanda baca otomatis. Kutipan cerdas terletak satu kartu di bawah, di bawah Tanda Baca."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt Tự động viết hoa hoặc Tự động chấm câu. Dấu ngoặc kép thông minh là một thẻ nằm dưới Dấu câu."
          }
        }
      }
    },
