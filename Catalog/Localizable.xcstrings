    "Turn on Adaptive hitboxes to fine-tune the prediction.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel Adaptive hitboxes aan om die voorspelling te verfyn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte adaptive Trefferflächen ein, um die Vorhersage feiner einzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las zonas táctiles adaptativas para afinar la predicción."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita sisse Kohanduvad tabamustsoonid, et ennustust peenhäälestada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active les zones tactiles adaptatives pour affiner la prédiction."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be az Adaptív találati mezőket az előrejelzés finomhangolásához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le aree tattili adattive per mettere a punto la previsione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測を細かく調整するには、アダプティブヒットボックスをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예측을 세밀하게 맞추려면 적응형 히트박스를 켜주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Kotak sentuh adaptif untuk memperhalus ramalan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga as zonas de toque adaptativas para afinar a previsão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Адаптивные зоны нажатия», чтобы точнее настроить предсказание."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启自适应触区来微调预测。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați casetele de acces adaptive pentru a ajusta predicția."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel adaptieve hitboxes in om de voorspelling te verfijnen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟自適應觸區來微調預測。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Adaptacyjne hitboxy, aby dostosować przewidywanie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть адаптивні хітбокси, щоб точно налаштувати прогноз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahminde ince ayar yapmak için Uyarlanabilir isabet alanlarını açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte Adaptivní hitboxy, abyste doladili předpověď."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite Adaptívne prístupové polia, aby ste doladili predpoveď."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε τα Adaptive hitboxes για να τελειοποιήσετε την πρόβλεψη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera Adaptiva hitboxar för att finjustera förutsägelsen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Adaptive hitboxes til for at finjustere forudsigelsen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Adaptive hitboxes for å finjustere prediksjonen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota mukautuvat osumalaatikot käyttöön ennusteen hienosäätämiseksi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan kotak hit Adaptif untuk menyempurnakan prediksi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật hộp sát thương Thích ứng để tinh chỉnh dự đoán."
          }
        }
      }
    },
    "Turn on Adaptive hitboxes.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel Adaptive hitboxes aan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte „Adaptive Trefferzonen“ ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Áreas táctiles adaptables."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita sisse Kohanduvad tabamustsoonid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active Zones tactiles adaptatives."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be az Adaptív hitboxokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Aree tattili adattive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「適応型ヒットボックス」をオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적응형 터치 영역을 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Kotak sentuh adaptif."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga as Áreas táteis adaptáveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Адаптивные зоны нажатия»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“自适应触控区”。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați casetele de acces adaptive."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel adaptieve hitboxen in."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟“自適應觸控區”。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz adaptacyjne hitboxy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть адаптивні хітбокси."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarlanabilir hitbox'ları açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte Adaptivní hitboxy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite Adaptívne prístupové polia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε τα Adaptive hitboxes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera Adaptiva hitboxar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Adaptive hitboxe til."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Adaptive hitboxes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota mukautuvat osumalaatikot käyttöön."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan hitbox adaptif."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật hitbox thích ứng."
          }
        }
      }
    },
    "Turn on Analytics in Clink to see your typing here.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel Analytics in Clink aan om jou tik hier te sien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Statistiken in Clink ein, um dein Tippverhalten hier zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las Estadísticas en Clink para ver aquí tu forma de escribir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita Clinkis sisse Statistika, et näha siin oma tipimist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active les Statistiques dans Clink pour voir ta frappe ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a Statisztikát a Clinkben, hogy itt lásd a gépelésedet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le Statistiche in Clink per vedere qui la tua scrittura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkで入力統計をオンにすると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink에서 통계를 켜면 여기서 타이핑 기록을 볼 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Statistik dalam Clink untuk lihat penaipan anda di sini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga as Estatísticas no Clink para veres aqui a tua escrita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Статистику» в Clink, чтобы увидеть здесь свою печать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Clink 中打开统计功能，就能在这里查看你的打字情况。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați Google Analytics în Clink pentru a vedea cum scrieți aici."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Analytics in Clink in om uw typen hier te zien."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Clink 中開啟統計功能，就能在這裡檢視你的打字情況。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Analytics w Clink, aby zobaczyć, co tu piszesz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть аналітику в Clink, щоб бачити, як ви вводите тут."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buraya yazdıklarınızı görmek için Clink'te Analytics'i açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte Analytics v Clink, abyste zde viděli, co píšete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite službu Analytics v Clink, aby ste tu videli, čo píšete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε το Analytics στο Clink για να δείτε την πληκτρολόγηση εδώ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera Analytics i Clink för att se hur du skriver här."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Analytics til i Clink for at se din indtastning her."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Analytics i Clink for å se hvordan du skriver her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota Analytics käyttöön Clink:ssä nähdäksesi kirjoittamasi täällä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan Analytics di Clink untuk melihat pengetikan Anda di sini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Analytics trong Clink để xem nội dung bạn nhập tại đây."
          }
        }
      }
    },
    "Turn on Animate backgrounds, on the Backdrop tab, to use these.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel Animeer agtergronde op die Agtergrond-oortjie aan om dit te gebruik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere „Hintergründe animieren“ im Tab „Hintergrund“, um das hier zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Animar fondos, en la pestaña Fondo, para usar esto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita Tausta kaardil sisse Animeeri taustu, et neid kasutada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active Animer les arrière-plans, dans l'onglet Arrière-plan, pour t'en servir."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a Hátterek animálása beállítást a Háttér fülön, hogy ezeket használhasd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Anima gli sfondi, nella scheda Sfondo, per usarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「背景」タブで「背景をアニメーション」をオンにすると使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경 탭에서 배경 애니메이션을 켜면 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Animasikan latar, dalam tab Latar belakang, untuk menggunakannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga Animar fundos, no separador Fundo, para usares isto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Анимировать фоны» на вкладке «Задний план», чтобы этим пользоваться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“背景”标签里开启“动画背景”即可使用。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați Animați fundaluri, în fila Fundal, pentru a le folosi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Animate-achtergronden in op het tabblad Achtergrond om deze te gebruiken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在“背景”標籤裡開啟“動畫背景”即可使用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby z nich korzystać, włącz opcję Animuj tła na karcie Tło."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Animate фони на вкладці Фон, щоб використовувати їх."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunları kullanmak için Arka Plan sekmesinde Arka planları canlandır'ı açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li je používat, zapněte na kartě Pozadí Animate pozadí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak ich chcete použiť, zapnite animované pozadia na karte Pozadie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε την Κίνηση φόντου, στην καρτέλα Backdrop, για να τα χρησιμοποιήσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera Animera bakgrunder på fliken Bakgrund för att använda dessa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Animer baggrunde til på fanen Baggrund for at bruge disse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Animer bakgrunner på Bakteppe-fanen for å bruke disse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota Animoi taustat käyttöön Tausta-välilehdessä, jos haluat käyttää niitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan Animate backgrounds, pada tab Backdrop, untuk menggunakannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật nền Hoạt hình trên tab Phông nền để sử dụng các nền này."
          }
        }
      }
    },
    "Turn on Apple Intelligence above first.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel eers Apple Intelligence hierbo aan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere zuerst oben Apple Intelligence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero activa Apple Intelligence arriba."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita kõigepealt ülal sisse Apple Intelligence."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active d’abord Apple Intelligence ci-dessus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előbb kapcsold be fent az Apple Intelligence-t."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva prima Apple Intelligence qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に上の Apple Intelligence をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 위의 Apple Intelligence를 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Apple Intelligence di atas dahulu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative primeiro o Apple Intelligence acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала включите Apple Intelligence выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开上方的 Apple Intelligence。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați mai întâi Apple Intelligence de mai sus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel hierboven eerst Apple Intelligence in."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先開啟上方的 Apple Intelligence。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw włącz Apple Intelligence powyżej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку увімкніть Apple Intelligence вище."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk önce yukarıdaki Apple Intelligence'i açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve zapněte Apple Intelligence výše."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najskôr zapnite Apple Intelligence vyššie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε πρώτα το Apple Intelligence παραπάνω."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Apple Intelligence ovan först."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tænd først Apple Intelligence ovenfor."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Apple Intelligence ovenfor først."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kytke ensin päälle yllä oleva Apple Intelligence."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan Apple Intelligence di atas terlebih dahulu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước tiên hãy bật Apple Intelligence ở trên."
          }
        }
      }
    },
