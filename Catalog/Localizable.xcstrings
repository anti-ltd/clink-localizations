    "Save your current setup as a profile and it shows up in the keyboard's switcher.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoor jou huidige opstelling as 'n profiel en dit verskyn in die sleutelbord se skakelaar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher dein aktuelles Setup als Profil, dann taucht es im Wechsler auf der Tastatur auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tu configuración actual como perfil y aparecerá en el teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvesta oma praegune seadistus profiilina ja see ilmub klaviatuuri vahetajasse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre ta config actuelle comme profil et elle apparaîtra dans le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentsd el a mostani beállításodat profilként, és megjelenik a billentyűzet váltójában."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva la configurazione attuale come profilo e comparirà nel selettore della tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまのセットアップをプロファイルとして保存すると、キーボードの切り替えに出てきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 설정을 프로필로 저장하면 키보드 전환 목록에 나타납니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan persediaan semasa anda sebagai profil dan ia akan muncul dalam penukar papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde a configuração atual como perfil e ela aparece no teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните текущую настройку как профиль — и он появится в переключателе на клавиатуре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把当前配置存成配置文件，它就会出现在键盘的切换器里。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvați configurația curentă ca profil și va apărea în comutatorul tastaturii."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla uw huidige configuratie op als profiel en deze verschijnt in de schakelaar van het toetsenbord."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把當前配置存成配置檔案，它就會出現在鍵盤的切換器裡。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz bieżącą konfigurację jako profil, a pojawi się ona w przełączniku klawiatury."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть поточні налаштування як профіль, і вони відобразяться в перемикачі клавіатури."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut kurulumunuzu bir profil olarak kaydedin; klavyenin değiştiricisinde görünecektir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte aktuální nastavení jako profil a zobrazí se v přepínači klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte svoje aktuálne nastavenie ako profil a zobrazí sa v prepínači klávesnice."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύστε την τρέχουσα ρύθμιση ως προφίλ και εμφανίζεται στο διακόπτη του πληκτρολογίου."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara din nuvarande inställning som en profil så visas den i tangentbordets switcher."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem din nuværende opsætning som en profil, og den vises i tastaturets switcher."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre ditt nåværende oppsett som en profil, og det vises i tastaturets bryter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna nykyinen asetuksesi profiilina, niin se näkyy näppäimistön vaihtajassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan pengaturan Anda saat ini sebagai profil dan itu akan muncul di pengalih keyboard."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu thiết lập hiện tại của bạn dưới dạng hồ sơ và nó sẽ hiển thị trong trình chuyển đổi của bàn phím."
          }
        }
      }
    },
    "Save your whole setup to a file to back it up or share it, then import it on another device.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoor jou hele opstelling in 'n lêer om dit te rugsteun of te deel, en voer dit dan op 'n ander toestel in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere deine ganze Einrichtung in einer Datei, um sie zu sichern oder zu teilen, und importiere sie dann auf einem anderen Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda toda tu configuración en un archivo para tener una copia o compartirla, y luego impórtala en otro dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvesta kogu oma seadistus faili, et varundada või jagada, ja impordi see siis teises seadmes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre toute ta config dans un fichier pour la sauvegarder ou la partager, puis importe-la sur un autre appareil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentsd el az egész beállításodat egy fájlba, hogy legyen róla mentés vagy megoszthasd, majd töltsd be egy másik eszközön."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva tutta la tua configurazione in un file per farne un backup o condividerla, poi importala su un altro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定をまるごとファイルに保存して、バックアップや共有ができます。別のデバイスで読み込むこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 전체를 파일로 저장해서 백업하거나 공유하고, 다른 기기에서 다시 가져올 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan seluruh persediaan anda ke fail untuk sandaran atau kongsi, kemudian import pada peranti lain."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda toda a tua configuração num ficheiro para lhe fazeres cópia de segurança ou a partilhares e depois importa-la noutro dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните всю настройку в файл, чтобы сделать резервную копию или поделиться, а потом импортируйте её на другом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把你的整套设置存成文件，用来备份或分享，再在别的设备上导入。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvați întreaga configurație într-un fișier pentru a-l face copii de rezervă sau pentru a-l partaja, apoi importați-l pe alt dispozitiv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla uw hele installatie op in een bestand om er een back-up van te maken of deel het, en importeer het vervolgens op een ander apparaat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把你的整套設定存成檔案，用來備份或分享，再在別的裝置上匯入。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz całą konfigurację w pliku, aby utworzyć kopię zapasową lub udostępnić ją, a następnie zaimportuj ją na inne urządzenie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть усе налаштування у файл, щоб зробити його резервну копію або поділитися ним, а потім імпортуйте його на інший пристрій."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedeklemek veya paylaşmak için tüm kurulumunuzu bir dosyaya kaydedin ve ardından başka bir cihaza aktarın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte celé nastavení do souboru, abyste jej mohli zálohovat nebo sdílet, a poté jej importujte do jiného zařízení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte celé nastavenie do súboru, aby ste ho zálohovali alebo zdieľali, a potom ho importujte do iného zariadenia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύστε ολόκληρη τη ρύθμισή σας σε ένα αρχείο για να δημιουργήσετε αντίγραφα ασφαλείας ή να το μοιραστείτε και, στη συνέχεια, εισαγάγετέ το σε άλλη συσκευή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara hela installationen till en fil för att säkerhetskopiera eller dela den och importera den sedan till en annan enhet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem hele din opsætning i en fil for at sikkerhedskopiere den eller dele den, og importer den derefter til en anden enhed."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre hele oppsettet til en fil for å sikkerhetskopiere det eller dele det, og importer det deretter til en annen enhet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna koko asetuksesi tiedostoon varmuuskopioimista tai jakamista varten ja tuo se sitten toiseen laitteeseen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan seluruh pengaturan Anda ke file untuk dicadangkan atau dibagikan, lalu impor ke perangkat lain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu toàn bộ thiết lập của bạn vào một tệp để sao lưu hoặc chia sẻ, sau đó nhập nó vào một thiết bị khác."
          }
        }
      }
    },
