    "Dictation types what you say, into whatever field you're in.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktee tik wat jy sê, in watter veld jy ook al is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Diktat tippt, was du sagst, direkt in das Feld, in dem du gerade bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado escribe lo que dices en el campo en el que estés."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteerimine tipib selle, mida sa ütled, välja, kus iganes sa oled."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée écrit ce que tu dis, dans le champ où tu te trouves."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktálás abba a mezőbe írja, amit mondasz, ahol épp vagy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura scrive quello che dici nel campo in cui ti trovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力は、話した内容を今いる入力欄にそのまま書き込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기는 말한 내용을 지금 있는 입력란에 그대로 적습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imlak menaip apa yang anda sebut, ke dalam medan yang sedang anda gunakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado escreve o que dizes, no campo onde estiveres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовка печатает сказанное прямо в то поле, где вы находитесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听写会把你说的话写进你当前所在的输入框。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictarea scrie ceea ce spui, indiferent de domeniul în care te afli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicteren typt wat u zegt, in welk vakgebied u zich ook bevindt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽寫會把你說的話寫進你當前所在的輸入框。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie wpisuje to, co mówisz, w dowolnej dziedzinie, w której się znajdujesz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктант вводить те, що ви говорите, у будь-яку сферу діяльності."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte, söylediklerinizi hangi alanda olursanız olun içine yazar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktát píše, co říkáte, do jakéhokoli oboru, ve kterém se pohybujete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktát píše, čo hovoríte, do akejkoľvek oblasti, v ktorej sa nachádzate."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η υπαγόρευση πληκτρολογεί αυτό που λέτε, σε όποιο πεδίο κι αν βρίσκεστε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteringen skriver in vad du säger, i vilket område du än är inom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering indskriver, hvad du siger, i det felt, du er i."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering skriver inn det du sier, uansett hvilket felt du er i."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanelu kirjoittaa sanomasi mihin tahansa kenttään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte mengetikkan apa yang Anda ucapkan, ke dalam bidang apa pun yang Anda geluti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chính tả sẽ nhập những gì bạn nói vào bất kỳ lĩnh vực nào bạn đang làm."
          }
        }
      }
    },
