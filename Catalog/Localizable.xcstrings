    "Browse everything you've saved in Cling and tap to type it wherever you are.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Blaai deur alles wat jy in Cling gestoor het en tik om dit te tik waar jy ook al is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchstöbere alles, was du in Cling gespeichert hast, und tippe darauf, um es überall einzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora todo lo que has guardado en Cling y toca para escribirlo donde estés."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirvi kõike, mida oled Clingi salvestanud, ja puuduta, et see kuskil tipida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcours tout ce que tu as enregistré dans Cling et touche pour l’écrire où que tu sois."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Böngészd végig, amit a Clingbe mentettél, és koppints rá, hogy bárhol beírd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfoglia tutto quello che hai salvato in Cling e tocca per scriverlo ovunque ti trovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling に保存したものを見て、タップすればどこでも入力できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling에 저장한 것을 둘러보고 탭하면 어디서든 입력됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak imbas semua yang anda simpan dalam Cling dan ketik untuk menaipnya di mana sahaja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja tudo o que guardou no Cling e toque para escrever onde estiver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте всё, что сохранили в Cling, и одним нажатием вставляйте это где угодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览你在 Cling 里保存的一切，轻点即可输入到任何地方。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răsfoiți tot ce ați salvat în Cling și atingeți pentru a le introduce oriunde v-ați afla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blader door alles wat je in Cling hebt opgeslagen en tik om het te typen, waar je ook bent."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽你在 Cling 裡儲存的一切，輕點即可輸入到任何地方。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądaj wszystko, co zapisałeś w Cling i dotknij, aby wpisać to, gdziekolwiek jesteś."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляньте все, що ви зберегли в Cling, і торкніться, щоб ввести його, де б ви не були."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling'te kaydettiğiniz her şeye göz atın ve nerede olursanız olun yazmak için dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Procházejte vše, co jste si uložili do Cling, a klepnutím to zadejte, ať jste kdekoli."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prezrite si všetko, čo ste si uložili do Cling, a ťuknutím to zadajte, nech ste kdekoľvek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιηγηθείτε σε όλα όσα έχετε αποθηκεύσει στο Cling και πατήστε για να τα πληκτρολογήσετε όπου κι αν βρίσκεστε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bläddra igenom allt du har sparat i Cling och tryck för att skriva det var du än är."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemse alt, hvad du har gemt i Cling, og tryk for at skrive det, uanset hvor du er."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bla gjennom alt du har lagret i Cling og trykk for å skrive det uansett hvor du er."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selaa kaikkea, mitä olet tallentanut Cling:ään ja napauta kirjoittaaksesi se missä tahansa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelajahi semua yang Anda simpan di Cling dan ketuk untuk mengetiknya di mana pun Anda berada."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Duyệt qua mọi thứ bạn đã lưu trong Cling và nhấn để nhập nội dung đó mọi lúc mọi nơi."
          }
        }
      }
    },
