    "This plugin can read and change your keyboard settings and edit text. Choose which additional data it may access.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plugin puede leer y cambiar los ajustes del teclado y editar texto. Elige a qué otros datos puede acceder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce plugin peut lire et modifier les réglages du clavier et le texte. Choisis les autres données auxquelles il peut accéder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Plugin kann deine Tastatureinstellungen lesen und ändern sowie Text bearbeiten. Wähle, auf welche weiteren Daten es zugreifen darf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo plugin può leggere e modificare le impostazioni della tastiera e il testo. Scegli a quali altri dati può accedere."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plugin pode ler e alterar as definições do teclado e editar texto. Escolha a que outros dados pode aceder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот плагин может читать и менять настройки клавиатуры и редактировать текст. Выберите, к каким дополнительным данным разрешить доступ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemalam ini boleh membaca dan mengubah tetapan papan kekunci serta menyunting teks. Pilih data tambahan yang boleh diaksesnya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bővítmény olvashatja és módosíthatja a billentyűzet beállításait, valamint szöveget szerkeszthet. Válaszd ki, milyen további adatokhoz férhet hozzá."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプラグインはキーボード設定の読み取りと変更、テキストの編集ができます。追加でアクセスを許可するデータを選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此插件可以读取和更改键盘设置，并编辑文本。请选择它还可以访问哪些数据。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 플러그인은 키보드 설정을 읽고 변경하며 텍스트를 편집할 수 있습니다. 추가로 접근을 허용할 데이터를 선택하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See pistikprogramm saab lugeda ja muuta klaviatuuri seadeid ning teksti redigeerida. Vali, millistele lisaandmetele see ligi pääseb."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plugin can read and change your keyboard settings and edit text. Choose which additional data it may access."
          }
        }
      }
    },
    "This plugin changed. Close this sheet and review it again.": {
