    "Works out to %@ a month. Renews yearly. Cancel anytime.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das entspricht %@ pro Monat. Verlängert sich jährlich. Jederzeit kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equivale a %@ al mes. Se renueva cada año. Cancela cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça revient à %@ par mois. Renouvellement annuel. Résiliable à tout moment."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez havi %@-nak felel meg. Évente megújul. Bármikor lemondhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrisponde a %@ al mese. Si rinnova ogni anno. Annulla quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月あたり%@になります。年ごとに自動更新。いつでも解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월 %@ 꼴이에요. 매년 자동 갱신되고, 언제든 취소할 수 있어요."
