    "Animation sets how long the hold takes and how far a slide travels.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Animasie stel hoe lank die hou neem en hoe ver 'n skyfie beweeg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter „Animation“ stellst du ein, wie lange das Halten dauert und wie weit ein Zug reicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Animación se ajusta cuánto hay que mantener pulsado y cuánto recorre un deslizamiento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Animatsioon sätestab, kui kaua kestab hoidmine ja kui kaugele liug liigub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation règle la durée de l'appui et la distance parcourue par un glissement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Animáció alatt állítható, mennyi ideig kell nyomni, és milyen messzire visz egy húzás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Animazione imposti quanto dura la pressione e quanto lontano arriva uno scorrimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しの時間とスライドの移動量は「アニメーション」で設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 누르는 시간과 미는 거리는 애니메이션에서 정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Animasi menetapkan berapa lama tahanan itu dan sejauh mana lerekan bergerak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Animação defines quanto tempo dura a pressão e a distância que um deslize percorre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анимация задаёт, сколько длится удержание и как далеко уходит скольжение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按需要多久、滑动走多远，都在“动画”里设。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Animația stabilește cât durează reținerea și cât de departe parcurge un diapozitiv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Animatie bepaalt hoe lang het vasthouden duurt en hoe ver een dia reist."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按需要多久、滑動走多遠，都在“動畫”裡設。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Animacja określa czas trwania zatrzymania i odległość przesuwania się slajdu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Анімація встановлює тривалість утримання та відстань руху слайда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Animasyon, beklemenin ne kadar süreceğini ve slaytın ne kadar uzağa gideceğini ayarlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Animace nastavuje, jak dlouho trvá držení a jak daleko se snímek posune."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Animácia nastavuje, ako dlho trvá podržanie a ako ďaleko sa posúva snímka."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κινούμενη εικόνα ορίζει πόσο χρόνο διαρκεί το κράτημα και πόσο μακριά θα διανύσει μια διαφάνεια."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation anger hur lång tid hållningen tar och hur långt en bild färdas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation angiver, hvor lang tid det tager, og hvor langt et dias kører."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Animasjon angir hvor lang tid ventingen tar og hvor langt et lysbilde kjører."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Animaatio määrittää, kuinka kauan pito kestää ja kuinka pitkälle dia kulkee."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Animasi mengatur berapa lama waktu yang dibutuhkan untuk menahan dan seberapa jauh perpindahan slide."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt ảnh đặt thời gian giữ và khoảng cách trang chiếu di chuyển."
          }
        }
      }
    },
