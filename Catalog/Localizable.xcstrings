    "Analytics counts your speed, your corrections and the keys you miss, and keeps all of it on the phone.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics tel jou spoed, jou regstellings en die sleutels wat jy mis, en hou dit alles op die foon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Statistiken zählen dein Tempo, deine Korrekturen und die Tasten, die du verfehlst — alles bleibt auf dem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estadísticas cuentan tu velocidad, tus correcciones y las teclas que fallas, y lo guardan todo en el teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistika loendab sinu kiiruse, parandused ja klahvid, mida mööda lubad, ja hoiab kõik selle telefonis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les statistiques comptent ta vitesse, tes corrections et les touches que tu rates, et gardent tout sur le téléphone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Statisztikák számolják a sebességedet, a javításaidat és az elvétett billentyűket — mindez a telefonon marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le statistiche contano la tua velocità, le correzioni e i tasti che sbagli, e tengono tutto sul telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「入力統計」は速度・修正回数・押し間違えたキーを数えます。データはすべて端末内に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통계는 속도와 수정 횟수, 잘못 누른 키를 세어 둡니다. 모두 기기 안에만 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik mengira kelajuan anda, pembetulan anda dan kekunci yang tersasar, dan menyimpan semuanya dalam telefon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As estatísticas contam a tua velocidade, as tuas correcções e as teclas que falhas, e guardam tudo no telemóvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статистика считает вашу скорость, исправления и промахи по клавишам — и всё это остаётся на телефоне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“统计”会记录你的速度、改了多少次、常按错哪些键，所有数据都留在手机上。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics vă numără viteza, corecțiile și cheile pe care le pierdeți și le păstrează pe telefon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics telt uw snelheid, uw correcties en de toetsen die u mist, en bewaart dit allemaal op de telefoon."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“統計”會記錄你的速度、改了多少次、常按錯哪些鍵，所有資料都留在手機上。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics zlicza Twoją prędkość, poprawki i brakujące klawisze, a wszystko to przechowuje w telefonie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аналітика підраховує вашу швидкість, ваші виправлення та ключі, які ви пропустили, і зберігає все це в телефоні."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics hızınızı, düzeltmelerinizi ve kaçırdığınız tuşları sayar ve bunların hepsini telefonda tutar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics počítá vaši rychlost, vaše opravy a klávesy, které vám chybí, a vše uchovává v telefonu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Služba Analytics počíta vašu rýchlosť, opravy a klávesy, ktoré vám chýbajú, a uchováva to všetko v telefóne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Analytics μετράει την ταχύτητά σας, τις διορθώσεις και τα κλειδιά που χάνετε και τα κρατά όλα στο τηλέφωνο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics räknar din hastighet, dina korrigeringar och nycklar du missar, och sparar allt på telefonen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics tæller din hastighed, dine rettelser og de taster, du går glip af, og gemmer det hele på telefonen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics teller hastigheten din, rettelsene dine og tastene du går glipp av, og beholder alt på telefonen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics laskee nopeudesi, korjauksesi ja näppäimet, joita et saa, ja pitää kaiken puhelimessa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics menghitung kecepatan Anda, koreksi Anda, dan kunci yang Anda lewatkan, dan menyimpan semuanya di ponsel."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics đếm tốc độ của bạn, những lần sửa của bạn cũng như những phím bạn bỏ lỡ và lưu tất cả thông tin đó vào điện thoại."
          }
        }
      }
    },
