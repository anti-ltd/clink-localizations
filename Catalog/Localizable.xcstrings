          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte „Hintergrund anzeigen“ aus, damit die App durchscheint, in der du gerade tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
