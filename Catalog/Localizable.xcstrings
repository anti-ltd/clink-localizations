        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” on sisseehitatud paigutus. Luuakse muudetav koopia ilma selleta: %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” on sisäänrakennettu asettelu. Tästä luodaan muokattava oma kopio ilman kohdetta %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est une disposition intégrée. Une copie modifiable sera créée, sans : %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” beépített kiosztás. Szerkeszthető saját másolat készül, ennek elhagyásával: %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” adalah tata letak bawaan. Ini membuat salinan kustom yang dapat diedit tanpa %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” è un layout integrato. Verrà creata una copia personalizzata modificabile senza: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は内蔵レイアウトです。次を除いた編集できるカスタムコピーを作成します：%@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) 기본 레이아웃입니다. 다음을 뺀 편집 가능한 사본을 만듭니다: %@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ialah susun atur terbina dalam. Salinan tersuai yang boleh diedit akan dibuat tanpa: %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» er et innebygd oppsett. Dette lager en redigerbar egen kopi uten %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’ is een ingebouwde indeling. Er wordt een bewerkbare eigen kopie gemaakt zonder %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” to wbudowany układ. Zostanie utworzona edytowalna kopia własna bez elementu: %2$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” é um esquema incorporado. Será criada uma cópia personalizada editável sem: %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” este un aspect integrat. Se creează o copie personalizată editabilă fără %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — встроенная раскладка. Будет создана редактируемая копия без: %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ je vstavané rozloženie. Vytvorí sa upraviteľná vlastná kópia bez %2$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” är en inbyggd layout. En redigerbar egen kopia skapas utan %2$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” yerleşik bir düzen. %2$@ olmadan düzenlenebilir özel bir kopya oluşturulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» — вбудована розкладка. Буде створено редаговану власну копію без елемента: %2$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” là bố cục có sẵn. Thao tác này tạo một bản sao tùy chỉnh có thể chỉnh sửa, không có %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是内置布局。将创建不含以下内容的可编辑自定义副本：%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」是內建鍵盤配置。這會建立一份可編輯的自訂副本，但不含%2$@。"
          }
        }
      }
    },
    "Couldn’t load this repository.": {
      "comment": "Layout page, Layouts part: alert message when a layout repository's catalog can't be read (iOS shows the store's error text). Translations drafted for the Android port (batch B7); native-speaker review required before release. Add to clink-index.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon nie hierdie bewaarplek laai nie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento repozitář se nepodařilo načíst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke indlæse dette repository."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Repository konnte nicht geladen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η φόρτωση αυτού του αποθετηρίου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar este repositorio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seda hoidlat ei õnnestunud laadida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä repositoriota ei voitu ladata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger ce dépôt."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült betölteni ezt a tárolót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memuat repositori ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare questo repository."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリを読み込めませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장소를 불러올 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memuatkan repositori ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke laste inn dette repositoriet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan deze repository niet laden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać tego repozytorium."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar este repositório."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut încărca acest depozit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить этот репозиторий."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento repozitár sa nepodarilo načítať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att läsa in det här arkivet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu depo yüklenemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити цей репозиторій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tải kho lưu trữ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入此仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入此儲存庫。"
          }
        }
      }
