    "Paint the theme’s color, gradient or photo behind the keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verf die tema se kleur, gradiënt of foto agter die sleutels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Male die Farbe, den Verlauf oder das Foto des Themes hinter die Tasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta el color, degradado o foto del tema detrás de las teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Maali teema värv, üleminek või foto klahvide taha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peins la couleur, le dégradé ou la photo du thème derrière les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fesd fel a téma színét, színátmenetét vagy fotóját a billentyűk mögé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna il colore, la sfumatura o la foto del tema dietro i tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマの色、グラデーション、写真をキーの背後に描きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마의 색상, 그라데이션, 사진을 키 뒤에 깔아줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukis warna, kecerunan atau foto tema di sebalik kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta a cor, gradiente ou foto do tema por trás das teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисовать за клавишами цвет, градиент или фото темы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把主题的颜色、渐变或图片铺在按键背后。"
          }
        }
      }
    },
    "Paint the theme’s color, gradient or photo behind the keys. Off, the app you’re typing in shows through.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verf die tema se kleur, gradiënt of foto agter die sleutels. Af, die toepassing wat jy intik, wys deur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Malt die Farbe, den Verlauf oder das Foto des Designs hinter die Tasten. Aus scheint die App durch, in der du gerade tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta el color, el degradado o la foto del tema detrás de las teclas. Desactivado, se ve la app en la que escribes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Maalib teema värvi, ülemineku või foto klahvide taha. Välja lülitatuna paistab läbi rakendus, kus sa tipid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peint la couleur, le dégradé ou la photo du thème derrière les touches. Désactivé, l'app dans laquelle tu écris se voit à travers."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A téma színét, színátmenetét vagy fotóját festi a billentyűk mögé. Kikapcsolva átlátszik az app, amelybe éppen gépelsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipinge il colore, il gradiente o la foto del tema dietro i tasti. Disattivato, si vede l'app in cui stai scrivendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマの色、グラデーション、写真をキーの後ろに描きます。オフにすると、入力中のアプリが透けて見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마의 색상, 그러데이션, 사진을 키 뒤에 칠합니다. 끄면 입력 중인 앱이 그대로 비칩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Melukis warna, gradien atau foto tema di belakang kekunci. Bila dimatikan, apl yang anda taip padanya kelihatan menembusi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta a cor, o gradiente ou a fotografia do tema por trás das teclas. Desligado, vê-se a app onde estás a escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисовать за клавишами цвет, градиент или фото темы. Выключено — сквозь них видно приложение, в котором вы печатаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在按键后方绘制主题的颜色、渐变或照片。关闭后，正在输入的 App 会透出来。"
          }
        }
      }
    },
