    "Overrides disappear when conditions stop matching.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios temporales se eliminan al dejar de cumplirse las condiciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages temporaires disparaissent quand les conditions ne sont plus remplies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Einstellungen enden, sobald die Bedingungen nicht mehr erfüllt sind."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche temporanee terminano quando le condizioni non sono più soddisfatte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações temporárias terminam quando as condições deixam de se verificar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временные настройки снимаются, когда условия перестают выполняться."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapan sementara tamat apabila syarat tidak lagi dipenuhi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ideiglenes beállítások megszűnnek, ha a feltételek már nem teljesülnek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "条件を満たさなくなると、一時設定は解除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
