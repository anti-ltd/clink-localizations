    "How wide the ripple spreads. Larger values swell more neighbouring keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe wyd versprei die rimpeling. Groter waardes swel meer naburige sleutels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit sich die Welle ausbreitet. Höhere Werte lassen mehr Nachbartasten anschwellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto se extiende la onda. Con valores más altos se agrandan más teclas vecinas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui laialt laine levib. Suuremad väärtused paisutavad rohkem naaberklahve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La largeur de l'ondulation. Plus la valeur est grande, plus les touches voisines gonflent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Milyen szélesen terjed a hullám. Nagyobb értéknél több szomszédos billentyű duzzad meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto si allarga l'onda. Con valori più alti si gonfiano più tasti vicini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "波紋が広がる範囲です。大きくするほど、まわりのキーがたくさん膨らみます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물결이 얼마나 넓게 퍼질지예요. 값이 클수록 주변 키가 더 많이 부풀어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluas mana riak itu merebak. Nilai lebih besar buat lebih banyak kekunci sebelah membengkak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até onde a ondulação se espalha. Valores maiores incham mais teclas à volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько широко расходится волна. Чем больше, тем больше соседних клавиш раздувается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "涟漪扩散的范围。值越大，一起鼓起的相邻键就越多。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de largă se răspândește ondulația. Valorile mai mari umflă mai multe chei învecinate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe breed de rimpel zich verspreidt. Bij grotere waarden zwellen meer aangrenzende toetsen op."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "漣漪擴散的範圍。值越大，一起鼓起的相鄰鍵就越多。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak szeroko rozprzestrzenia się fala. Większe wartości powiększają więcej sąsiednich kluczy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскільки широко поширюється хвиля. Більші значення збільшують кількість сусідніх ключів."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalgalanmanın ne kadar geniş yayıldığı. Daha büyük değerler daha fazla komşu anahtarı şişirir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak široké se vlnění šíří. Větší hodnoty zvětšují více sousedních klíčů."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako široko sa vlnenie šíri. Väčšie hodnoty nabobtnajú viac susedných kľúčov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο πλατιά απλώνεται ο κυματισμός. Οι μεγαλύτερες τιμές διογκώνουν περισσότερα γειτονικά κλειδιά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur brett krusningen sprider sig. Större värden sväller fler närliggande nycklar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "How wide the ripple spreads. Larger values swell more neighbouring keys."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor bredt krusningen sprer seg. Større verdier sveller flere nabonøkler."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka laajalle aaltoilu leviää. Suuremmat arvot lisäävät vierekkäisiä avaimia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa luas penyebaran riaknya. Nilai yang lebih besar akan membengkakkan lebih banyak kunci tetangga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sóng lan rộng biết bao. Giá trị lớn hơn sẽ làm tăng thêm các khóa lân cận."
          }
        }
      }
    },
