    "Quick notepad is off. Turn it on to use and customize it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vinnige notaboek is af. Skakel dit aan om dit te gebruik en aan te pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Notizblock ist aus. Schalte ihn ein, um ihn zu nutzen und anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloc rápido está desactivado. Actívalo para usarlo y personalizarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiirmärkmik on väljas. Lülita see sisse, et kasutada ja kohandada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
