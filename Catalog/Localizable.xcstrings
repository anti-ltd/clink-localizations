    "To move from Clink to another keyboard, open Tools on the keyboard and tap Switch keyboard.": {
      "comment": "Android FAQ step: how to switch from Clink to another installed keyboard.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Om van Clink na 'n ander sleutelbord oor te skakel, maak Gereedskap op die sleutelbord oop en tik Wissel sleutelbord."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li přejít z Clinku na jinou klávesnici, otevřete na klávesnici Nástroje a klepněte na Přepnout klávesnici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du vil skifte fra Clink til et andet tastatur, skal du åbne Værktøjer på tastaturet og trykke på Skift tastatur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um von Clink zu einer anderen Tastatur zu wechseln, öffne auf der Tastatur „Werkzeuge“ und tippe auf „Tastatur wechseln“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να μεταβείτε από το Clink σε άλλο πληκτρολόγιο, ανοίξτε τα Εργαλεία στο πληκτρολόγιο και πατήστε Αλλαγή πληκτρολογίου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pasar de Clink a otro teclado, abre Herramientas en el teclado y toca Cambiar de teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkilt teisele klaviatuurile minekuks ava klaviatuuril Tööriistad ja puuduta valikut Vaheta klaviatuuri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihtaaksesi Clinkistä toiseen näppäimistöön avaa näppäimistön Työkalut ja napauta Vaihda näppäimistö."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour passer de Clink à un autre clavier, ouvre Outils sur le clavier et touche Changer de clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a Clinkről másik billentyűzetre váltanál, nyisd meg a billentyűzeten az Eszközöket, és koppints a Billentyűzet váltása lehetőségre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk beralih dari Clink ke papan ketik lain, buka Alat di papan ketik lalu ketuk Ganti papan ketik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per passare da Clink a un'altra tastiera, apri Strumenti sulla tastiera e tocca Cambia tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink から別のキーボードに切り替えるには、キーボードで「ツール」を開き、「キーボードを切り替え」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink에서 다른 키보드로 바꾸려면 키보드에서 도구를 열고 키보드 전환을 탭하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk beralih daripada Clink ke papan kekunci lain, buka Alat pada papan kekunci dan ketik Tukar papan kekunci."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å bytte fra Clink til et annet tastatur åpner du Verktøy på tastaturet og trykker på Bytt tastatur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wil je van Clink naar een ander toetsenbord, open dan Gereedschap op het toetsenbord en tik op Wissel van toetsenbord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby przejść z Clink na inną klawiaturę, otwórz Narzędzia na klawiaturze i dotknij Zmień klawiaturę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para passar do Clink para outro teclado, abre Ferramentas no teclado e toca em Mudar de teclado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca să treci de la Clink la altă tastatură, deschide Instrumente pe tastatură și atinge Schimbă tastatura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы перейти с Clink на другую клавиатуру, откройте «Инструменты» на клавиатуре и нажмите «Сменить клавиатуру»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete prejsť z Clinku na inú klávesnicu, otvorte na klávesnici Nástroje a ťuknite na Prepnúť klávesnicu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill gå från Clink till ett annat tangentbord öppnar du Verktyg på tangentbordet och trycker på Byt tangentbord."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink'ten başka bir klavyeye geçmek için klavyede Araçlar'ı açın ve Klavyeyi değiştir'e dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб перейти з Clink на іншу клавіатуру, відкрийте «Інструменти» на клавіатурі й торкніться «Змінити клавіатуру»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để chuyển từ Clink sang bàn phím khác, hãy mở Công cụ trên bàn phím và nhấn Chuyển bàn phím."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从 Clink 切换到其他键盘，请在键盘上打开“工具”，然后轻点“切换键盘”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要從 Clink 切換到其他鍵盤，請在鍵盤上打開「工具」，然後點一下「切換鍵盤」。"
          }
        }
      }
    },
