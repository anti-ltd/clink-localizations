    "Add apostrophes to contractions like “dont” → “don’t”.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg apostrofe by kontraksies soos \"moenie\" → \"moenie\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt Apostrophe in Kontraktionen, etwa „dont“ → „don’t“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade apóstrofos a las contracciones, como “dont” → “don’t”."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa kontraktsioonidele ülakoma, näiteks „dont\" → „don't\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des apostrophes aux contractions, comme « dont » → « don’t »."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegyél aposztrófot az egybeírt szavakba, például „dont” → „don’t”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge l'apostrofo alle contrazioni, tipo “dont” → “don’t”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「dont」→「don’t」のような短縮形にアポストロフィを付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“dont” → “don’t” 처럼 축약형에 아포스트로피를 넣어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah tanda kutip pada singkatan seperti “dont” → “don’t”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona apóstrofos às contrações, como “dont” → “don’t”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставить апострофы в сокращениях: «dont» → «don’t»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给缩写补上撇号，比如 “dont” → “don’t”。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați apostrofe la contracții precum „dont” → „don’t”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg apostrofs toe aan samentrekkingen zoals “niet” → “niet”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給縮寫補上撇號，比如 “dont” → “don’t”。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj apostrofy do skurczów, takich jak „nie” → „nie”."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте апостроф до скорочень, наприклад «dont» → «don’t»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Dont\" → \"don't\" gibi kısaltmalara kesme işareti ekleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ke kontrakcím přidejte apostrofy jako „nedělej“ → „nedělej“."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte apostrofy ku kontrakciám ako „dont“ → „not“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε απόστροφους σε συστολές όπως \"δεν\" → \"δεν\"."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till apostrof till sammandragningar som \"inte\" → \"inte\"."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj apostrof til sammentrækninger som \"dont\" → \"don't\"."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til apostrof til sammentrekninger som \"ikke\" → \"ikke\"."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää supistuksiin heittomerkkejä, kuten \"älä\" → \"älä\"."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan apostrof pada kontraksi seperti “jangan” → “jangan”."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm dấu nháy đơn vào các từ viết tắt như “dont” → “don’t”."
          }
        }
      }
    },
