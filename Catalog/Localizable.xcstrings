            "state": "translated",
            "value": "Tanda yang ditulis pintasan spasi ganda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu lối tắt hai khoảng trắng ghi."
          }
        }
      }
    },
