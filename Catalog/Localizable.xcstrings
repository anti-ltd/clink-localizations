    },
    "Turn Key popups off, or leave them on and set how they spring.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel sleutelopspringers af, of laat hulle aan en stel in hoe hulle spring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte die Tasten-Popups aus — oder lass sie an und stell ein, wie stark sie federn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva las ventanas emergentes de tecla, o déjalas y ajusta cómo rebotan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita Klahvide hüpikud välja või jäta nad sisse ja määra nende vedrustus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive les bulles de touche, ou garde-les et règle leur rebond."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold ki a Kulcs felugró ablakokat, vagy hagyd bekapcsolva, és állítsd be, hogyan rugóznak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva i Popup dei tasti, oppure lasciali attivi e regola il loro rimbalzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キーのポップアップ」をオフにするか、オンのままで弾み方を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 팝업을 끄거나, 켜 둔 채 튀어오르는 정도를 조절하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan Pop timbul kekunci, atau biarkan hidup dan laraskan lantunannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga os Balões de tecla, ou deixa-os ligados e ajusta o salto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите всплывающие клавиши — или оставьте их и настройте, как они пружинят."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关掉“按键弹出框”，或者留着它，调一下弹跳的感觉。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivați ferestrele pop-up Key sau lăsați-le activate și setați modul în care vor apărea."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Key-pop-ups uit of laat ze ingeschakeld en stel in hoe ze opspringen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關掉“按鍵彈出框”，或者留著它，調一下彈跳的感覺。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz wyskakujące okienka z klawiszami lub pozostaw je włączone i ustaw sposób ich wyświetlania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкніть спливаючі вікна клавіш або залиште їх увімкненими та встановіть, як вони відкриваються."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar açılır pencerelerini kapatın veya açık bırakın ve nasıl yayılacaklarını ayarlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyskakovací okna klíčů vypněte nebo je nechte zapnutá a nastavte, jak budou pružit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnite vyskakovacie okná kľúča alebo ich nechajte zapnuté a nastavte spôsob ich pruženia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιήστε τα αναδυόμενα παράθυρα πλήκτρων ή αφήστε τα ενεργοποιημένα και ρυθμίστε τον τρόπο ανέλιξης."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stäng av nyckelpopups eller låt dem vara på och ställ in hur de fjädrar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå nøgle-popups fra, eller lad dem være tændt, og indstil, hvordan de springer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå av nøkkelpopups, eller la dem stå på og angi hvordan de fjærer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita avainponnahdusikkunat pois päältä tai jätä ne päälle ja määritä, miten ne joustavat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan pop-up Kunci, atau biarkan aktif dan atur tampilannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt các cửa sổ bật lên Key hoặc để chúng bật và đặt cách chúng hoạt động."
          }
        }
      }
    },
    "Turn Key press haptics on and set the feel on the pad.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Haptik beim Tastendruck und stelle das Tastengefühl auf dem Pad ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Vibración al pulsar tecla y ajusta el tacto en la superficie de control."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita sisse „Klahvivajutuse haptika” ja kohanda tunnetust puutealal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active Retour haptique à la frappe et règle le ressenti sur le pavé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a Billentyűnyomás haptika beállítást, és a vezérlőfelületen állítsd be az érzetet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Feedback aptico alla pressione e regola la sensazione sul riquadro di controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キー押下時の触覚フィードバック」をオンにし、パッドで触感を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘키 입력 햅틱’을 켜고 패드에서 느낌을 조절하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Haptik tekanan kekunci dan laraskan rasanya pada pad."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa Vibração ao premir tecla e ajusta a sensação na superfície de controlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Тактильная отдача при нажатии» и настройте ощущения на сенсорной панели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启“按键触感反馈”，然后在调节面板上调整触感。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați funcția tactilă de apăsare a tastei și setați senzația pe pad."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel de toetsaanslaghaptiek in en stel het gevoel op de pad in."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟“按鍵觸感反饋”，然後在調節面板上調整觸感。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel haptiese terugvoer vir sleuteldrukke aan en stel die gevoel op die paneel in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz dotykowe naciśnięcie klawisza i ustaw wyczucie pada."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть тактильну функцію натискання клавіш і встановіть відчуття на панелі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuş basma dokunsal özelliğini açın ve ped üzerindeki hissi ayarlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte haptiku stisknutí klávesy a nastavte pocit na podložce."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite haptiku stlačenia klávesu a nastavte pocit na podložke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε την απτική πίεση του πλήκτρου και ρυθμίστε την αίσθηση στο pad."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på tangenttryckningshaptik och ställ in känslan på plattan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå tastetryk-haptics til, og indstil følelsen på puden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på tastetrykk-haptics og sett følelsen på puten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota näppäinpainalluksen haptics käyttöön ja säädä tyynyn tuntuma."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan haptik tekan tombol dan atur nuansa pada pad."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật cảm giác nhấn phím và đặt cảm giác trên bàn phím."
          }
        }
      }
    },
