    "Thanks. The results reached the team with this build and iPhone model attached.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias. Los resultados han llegado al equipo con esta versión y el modelo de iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci. Les résultats sont arrivés à l’équipe, avec cette version et le modèle d’iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke. Die Ergebnisse sind mit diesem Build und dem iPhone-Modell beim Team angekommen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie. I risultati sono arrivati al team insieme a questa build e al modello di iPhone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado. Os resultados chegaram à equipa com esta versão e o modelo de iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо. Результаты получены командой вместе с номером сборки и моделью iPhone."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih. Hasilnya telah sampai kepada pasukan bersama binaan ini dan model iPhone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Köszönjük. Az eredmények ezzel a buildszámmal és az iPhone típusával együtt megérkeztek a csapathoz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます。結果はこのビルドと iPhone の機種情報とともにチームに届きました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谢谢。结果已连同此版本号和 iPhone 型号一起送达团队。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감사합니다. 결과가 이 빌드 정보와 iPhone 모델과 함께 팀에 전달되었습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aitäh. Tulemused jõudsid meeskonnani koos selle järgu ja iPhone’i mudeliga."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Multumesc. Rezultatele au ajuns la echipa cu această construcție și modelul de iPhone atașat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt. De resultaten bereikten het team met dit build- en iPhone-model eraan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "謝謝。結果已連同此版本號和 iPhone 型號一起送達團隊。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dankie. Die resultate het die span bereik, tesame met hierdie bouweergawe en iPhone-model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzięki. Wyniki dotarły do ​​zespołu z tą wersją i podłączonym modelem iPhone'a."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "дякую Результати надійшли до команди з цією конструкцією та моделлю iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teşekkürler. Sonuçlar ekibe bu yapı ve iPhone modeli eklenmiş olarak ulaştı."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "děkuji. Výsledky se dostaly k týmu s touto sestavou a připojeným modelem iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "dakujem. Výsledky sa dostali k tímu s touto zostavou a pripojeným modelom iPhone."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ευχαριστώ. Τα αποτελέσματα έφτασαν στην ομάδα με αυτήν την κατασκευή και το μοντέλο iPhone συνδεδεμένο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack. Resultaten nådde teamet med denna build och iPhone-modell bifogad."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak. Resultaterne nåede holdet med denne build og iPhone-model vedhæftet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk. Resultatene nådde teamet med denne bygge- og iPhone-modellen vedlagt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiitos. Tulokset saavuttivat tiimin tämän rakenteen ja iPhone-mallin kanssa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih. Hasilnya mencapai tim dengan build ini dan model iPhone terpasang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn. Kết quả đã đến với nhóm có bản dựng này và mẫu iPhone kèm theo."
          }
        }
      }
