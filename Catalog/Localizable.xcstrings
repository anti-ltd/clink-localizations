    "Make a pack from your own clicks: a file, a recording, or a copy of a built-in one to start from.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak 'n pak uit jou eie klikke: 'n lêer, 'n opname, of 'n kopie van 'n ingeboude een om van te begin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bau dir ein Paket aus deinen eigenen Klicks – eine Datei, eine Aufnahme oder eine Kopie eines vorinstallierten Pakets als Startpunkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un paquete con tus propios clics: un archivo, una grabación o una copia de uno integrado para empezar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee pakk omaenda klõpsudest: fail, salvestus või sisseehitatud pakist tehtud koopia, millest alustada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un pack avec tes propres clics — un fichier, un enregistrement, ou une copie d'un pack intégré pour partir de quelque chose."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Készíts csomagot a saját kattanásaidból – egy fájlból, egy felvételből, vagy egy beépített csomag másolatából kiindulva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un pacchetto con i tuoi clic — un file, una registrazione o una copia di uno integrato da cui partire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のクリック音でパックを作れます。ファイル、録音、または内蔵パックのコピーから始められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 만든 클릭 소리로 팩을 만들어 보세요. 파일, 녹음, 또는 기본 제공 팩의 복사본에서 시작할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipta pek daripada bunyi klik anda sendiri — daripada fail, rakaman, atau salinan pek terbina dalam sebagai permulaan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria um pacote com os teus próprios cliques — um ficheiro, uma gravação ou uma cópia de um integrado para começares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соберите набор из своих щелчков — из файла, из записи или из копии встроенного набора для начала."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你自己的按键声做一个声音包——可以来自文件、录音，或复制一个内置包作为起点。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creați un pachet din propriile clicuri: un fișier, o înregistrare sau o copie a unuia încorporat de la care să începeți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een pakket met uw eigen klikken: een bestand, een opname of een kopie van een ingebouwd bestand om mee te beginnen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用你自己的按鍵聲做一個聲音包——可以來自檔案、錄音，或複製一個內建包作為起點。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stwórz paczkę z własnych kliknięć: plik, nagranie lub kopia wbudowanego na początek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зробіть пакет із власних кліків: файл, запис або копію вбудованого, щоб почати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi tıklamalarınızla bir paket oluşturun: başlamak için bir dosya, bir kayıt veya yerleşik bir paketin kopyası."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořte balíček z vlastních kliknutí: soubor, záznam nebo kopii vestavěného souboru, ze kterého můžete začít."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvorte si balík z vlastných kliknutí: súbor, záznam alebo kópiu vstavaného súboru, od ktorého môžete začať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε ένα πακέτο από τα δικά σας κλικ: ένα αρχείο, μια εγγραφή ή ένα αντίγραφο ενός ενσωματωμένου για να ξεκινήσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör ett paket från dina egna klick: en fil, en inspelning eller en kopia av en inbyggd att börja från."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lav en pakke fra dine egne klik: en fil, en optagelse eller en kopi af en indbygget til at starte fra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lag en pakke fra dine egne klikk: en fil, et opptak eller en kopi av en innebygd til å starte fra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo paketti omista napsautuksistasi: tiedosto, tallenne tai kopio sisäänrakennetusta paketista aloittaaksesi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buatlah paket dari klik Anda sendiri: file, rekaman, atau salinan dari paket bawaan untuk memulai."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo một gói từ các cú nhấp chuột của riêng bạn: một tệp, bản ghi hoặc bản sao của gói tích hợp để bắt đầu."
          }
        }
      }
    },
