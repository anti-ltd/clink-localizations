    "Key totals only. The order of your taps is never saved.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert wird nur, wie oft du jede Taste drückst – niemals die Reihenfolge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key totals only. The order of your taps is never saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se cuenta el uso de cada tecla. Nunca se guarda el orden de las pulsaciones."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvestatakse ainult iga klahvi vajutuste arv, mitte vajutuste järjekord."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le nombre de frappes par touche est conservé, jamais leur ordre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a billentyűnkénti leütésszámot mentjük, a leütések sorrendjét soha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene salvato solo il numero di pressioni per tasto, mai il loro ordine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーごとの入力回数のみを保存します。入力の順序は保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키별 입력 횟수만 저장하며, 입력 순서는 저장하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya jumlah ketikan bagi setiap kekunci disimpan, bukan urutannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só é guardado o número de toques em cada tecla, nunca a sua ordem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняется только число нажатий каждой клавиши, но не их порядок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保存各按键的使用次数，绝不保存按键顺序。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numai totalurile cheie. Ordinea atingerilor dvs. nu este niciodată salvată."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen belangrijke totalen. De volgorde van uw tikken wordt nooit opgeslagen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅儲存各按鍵的使用次數，絕不儲存按鍵順序。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Slegs sleuteltotale. Die volgorde van jou tikbewegings word nooit gestoor nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko najważniejsze sumy. Kolejność dotknięć nigdy nie jest zapisywana."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише ключові суми. Порядок натискань ніколи не зберігається."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca anahtar toplamları. Dokunmalarınızın sırası hiçbir zaman kaydedilmez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze klíčové součty. Pořadí vašich kohoutků se nikdy neuloží."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Iba kľúčové súčty. Poradie vašich klepnutí sa nikdy neuloží."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο βασικά σύνολα. Η σειρά των πατημάτων σας δεν αποθηκεύεται ποτέ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast nyckelsummor. Ordningen på dina kranar sparas aldrig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun nøgletotaler. Rækkefølgen af ​​dine tryk bliver aldrig gemt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare nøkkeltotaler. Rekkefølgen på dine trykk blir aldri lagret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain avainsummat. Hanojen järjestystä ei koskaan tallenneta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Total kunci saja. Urutan ketukan Anda tidak pernah disimpan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tổng số chính. Thứ tự các lần nhấn của bạn không bao giờ được lưu."
          }
        }
      }
    },
