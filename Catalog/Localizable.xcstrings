        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik bly op jou toestel. Geen rekening of dop nie."
          }
        }
      }
    },
    "Unlock the tools and customization that turn Clink into your personal keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea las herramientas y la personalización que hacen de Clink tu teclado personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquez les outils et la personnalisation qui font de Clink votre clavier personnel."
          }
        },
        "de": {
          "stringUnit": {
