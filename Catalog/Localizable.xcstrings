    "Broad, flat and translucent, like a highlighter.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancho, plano y translúcido, como un rotulador fluorescente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Large, plat et translucide, comme un surligneur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breit, flach und durchscheinend, wie ein Textmarker."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Largo, piatto e traslucido, come un evidenziatore."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Largo, plano e translúcido, como um marcador."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar, rata dan lut sinar, seperti penyerlah."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Széles, lapos és áttetsző, mint egy szövegkiemelő."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅広で平らで半透明、蛍光ペンのような。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宽大、扁平且半透明，像荧光笔一样。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넓고 평평하며 반투명한, 형광펜처럼."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai, lame ja läbipaistev, nagu tõstpliiats."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Широкий, плоский и полупрозрачный, как маркер."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Breed, plat en deurskynend, soos 'n highlighter."
          }
        }
      }
    },
