    "Bold head, fine tail, with a glowing tip.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vet kop, fyn stert, met 'n gloeiende punt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräftiger Kopf, feiner Schwanz, mit leuchtender Spitze."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabeza gruesa, cola fina, con una punta brillante."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paks pea, peen saba, sädelev ots."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tête épaisse, queue fine, avec une pointe lumineuse."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastag fej, vékony farok, ragyogó véggel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testa spessa, coda sottile, con una punta luminosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "太い頭に細い尾、光る先端。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "굵은 머리, 가는 꼬리, 빛나는 끝."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kepala tebal, ekor halus, dengan hujung bercahaya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabeça grossa, cauda fina, com uma ponta brilhante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Толстая головка и тонкий хвост со светящимся кончиком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粗头细尾，尖端发光。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap îndrăzneț, coadă fină, cu vârf strălucitor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stevige kop, fijne staart, met een gloeiende punt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "粗頭細尾，尖端發光。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odważna głowa, delikatny ogon ze świecącym końcem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жирна голова, тонкий хвіст із сяючим кінчиком."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalın kafalı, ince kuyruklu ve parlak uçlu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tučná hlava, jemný ocas, se zářící špičkou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odvážna hlava, jemný chvost, so svietiacou špičkou."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τολμηρό κεφάλι, λεπτή ουρά, με λαμπερή άκρη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Djärvt huvud, fin svans, med en glödande spets."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fedt hoved, fin hale, med en glødende spids."
          }
        },
        "nb": {
          "stringUnit": {
