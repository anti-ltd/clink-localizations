    "I paid, and Clink is asking me to pay again": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ek het betaal, en Clink vra my om weer te betaal"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe bezahlt, und Clink will schon wieder Geld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He pagado y Clink me pide pagar otra vez"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma maksin ja Clink palub jälle maksta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai payé, et Clink me redemande de payer"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fizettem, a Clink mégis újra fizetést kér"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho pagato, e Clink mi chiede di pagare di nuovo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入済みなのに、Clinkがまた購入を求めてきます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제했는데 Clink이 또 결제하라고 해요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya sudah bayar, tetapi Clink meminta bayaran lagi"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu paguei, e o Clink está a pedir-me para pagar outra vez"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я заплатил, а Clink снова просит оплату"
