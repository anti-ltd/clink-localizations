          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink'in mikrofon oturumunu durdurur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví relaci mikrofonu Clink."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví reláciu mikrofónu Clink."
          }
        },
