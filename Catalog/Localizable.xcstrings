    "Colors only, the photo stays here": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Slegs kleure, die foto bly hier"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Farben, das Foto bleibt hier"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los colores, la foto se queda aquí"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainult värvid, pilt jääb siia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleurs seules, la photo reste ici"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a színek, a fotó itt marad"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i colori, la foto resta qui"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色のみ。写真はこの端末に残ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상만, 사진은 이 기기에 남습니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna sahaja, fotonya kekal di sini"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só as cores, a foto fica aqui"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только цвета, фото останется здесь"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅颜色，照片留在本机"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numai culori, fotografia rămâne aici"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen kleuren, de foto blijft hier"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅顏色，照片留在本機"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko kolory, zdjęcie zostaje tutaj"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тільки кольори, фото залишається тут"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca renkler, fotoğraf burada kalacak"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze barvy, fotografie zde zůstane"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Iba farby, fotka tu zostane"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο χρώματα, η φωτογραφία μένει εδώ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast färger, bilden stannar här"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun farver, billedet bliver her"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun farger, bildet forblir her"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain värit, kuva jää tähän"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna saja, fotonya tetap di sini"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có màu sắc, ảnh vẫn ở đây"
          }
        }
      }
    },
