    "Some optional effects are paused to keep typing smooth. Glass itself is untouched.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sommige opsionele effekte word onderbreek om glad te tik. Glas self is onaangeraak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige optionale Effekte pausieren, damit das Tippen flüssig bleibt. Das Glas selbst bleibt unangetastet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos efectos opcionales están en pausa para que escribir siga siendo fluido. El cristal no cambia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mõned valikulised efektid on peatatud, et tipimine jääks sujuvaks. Klaas ise jääb puutumata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains effets facultatifs sont en pause pour garder une frappe fluide. Le verre, lui, ne change pas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány nem kötelező effekt szünetel, hogy a gépelés gördülékeny maradjon. Maga az üveg változatlan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni effetti opzionali sono in pausa per mantenere fluida la digitazione. Il vetro resta invariato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力を滑らかに保つため、一部の任意エフェクトを止めています。ガラス自体はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력이 매끄럽도록 일부 선택적인 효과를 멈췄습니다. 글래스 자체는 그대로입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebahagian kesan pilihan dijeda supaya taipan kekal lancar. Kaca itu sendiri tidak berubah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns efeitos opcionais estão em pausa para a escrita continuar fluida. O vidro em si não muda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть необязательных эффектов приостановлена, чтобы печать оставалась плавной. Само стекло не затронуто."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了保持输入流畅，部分可选特效暂停了。玻璃本身没有变化。"
          }
        }
      }
    },
