    "All effects are optional. They run on press or appearance only, so the keyboard stays fast.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle effekte is opsioneel. Hulle werk slegs op druk of voorkoms, so die sleutelbord bly vinnig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Effekte sind optional. Sie laufen nur beim Drücken oder Einblenden, damit die Tastatur schnell bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los efectos son opcionales. Solo se ejecutan al pulsar o al aparecer, así que el teclado sigue yendo rápido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik efektid on valikulised. Need töötavad ainult vajutusel või ilmumisel, nii et klaviatuur jääb kiireks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les effets sont facultatifs. Ils ne tournent qu'à l'appui ou à l'apparition, comme ça le clavier reste rapide."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden effekt opcionális. Csak megnyomáskor vagy megjelenéskor futnak, így a billentyűzet gyors marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli effetti sono facoltativi. Partono solo alla pressione o alla comparsa, così la tastiera resta veloce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エフェクトはどれもお好みです。押したときや表示されたときだけ動くので、キーボードは速いままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 효과는 선택이에요. 누르거나 나타날 때만 돌아서 키보드가 계속 빨라요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua kesan bersifat pilihan. Ia jalan semasa ditekan atau muncul sahaja, jadi papan kekunci kekal pantas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os efeitos são opcionais. Só correm ao premires ou ao aparecerem, por isso o teclado mantém-se rápido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все эффекты необязательны. Они срабатывают только при нажатии или появлении, поэтому клавиатура остаётся быстрой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有特效都是可选的。它们只在按下或出现时运行，所以键盘一直很快。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate efectele sunt opționale. Acestea rulează numai la apăsare sau la apariție, astfel încât tastatura rămâne rapidă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle effecten zijn optioneel. Ze werken alleen op druk of uiterlijk, dus het toetsenbord blijft snel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有特效都是可選的。它們只在按下或出現時執行，所以鍵盤一直很快。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie efekty są opcjonalne. Działają tylko po naciśnięciu lub pojawieniu się, więc klawiatura pozostaje szybka."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі ефекти необов’язкові. Вони працюють лише при натисканні або зовнішньому вигляді, тому клавіатура залишається швидкою."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm efektler isteğe bağlıdır. Yalnızca basında veya görünümde çalışırlar, böylece klavye hızlı kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny efekty jsou volitelné. Běží pouze na stisk nebo vzhled, takže klávesnice zůstává rychlá."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky efekty sú voliteľné. Fungujú iba na stlačenie alebo vzhľad, takže klávesnica zostáva rýchla."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα τα εφέ είναι προαιρετικά. Λειτουργούν μόνο με το πάτημα ή την εμφάνιση, έτσι το πληκτρολόγιο παραμένει γρήγορο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla effekter är valfria. De körs endast på tryck eller utseende, så tangentbordet förblir snabbt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle effekter er valgfrie. De kører kun på tryk eller udseende, så tastaturet forbliver hurtigt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle effekter er valgfrie. De kjører kun på trykk eller utseende, så tastaturet holder seg raskt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tehosteet ovat valinnaisia. Ne toimivat vain painalluksella tai ulkonäöllä, joten näppäimistö pysyy nopeana."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua efek bersifat opsional. Mereka berjalan saat ditekan atau ditampilkan saja, sehingga keyboard tetap cepat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả các hiệu ứng là tùy chọn. Chúng chỉ chạy khi nhấn hoặc hiển thị, vì vậy bàn phím luôn hoạt động nhanh."
          }
        }
      }
    },
