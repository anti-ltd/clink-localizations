        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teras putih terang dalam cahaya lembut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um núcleo branco intenso dentro de um brilho suave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Яркое белое ядро внутри мягкого свечения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柔光包着一道明亮的白芯。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un miez alb strălucitor într-o strălucire moale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een helderwitte kern met daarin een zachte gloed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "柔光包著一道明亮的白芯。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasny biały rdzeń wewnątrz miękkiej poświaty."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Яскраве біле ядро всередині м'яке світіння."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumuşak bir parıltının içinde parlak beyaz bir çekirdek."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasně bílé jádro uvnitř jemné záře."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasné biele jadro vo vnútri jemnej žiary."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας φωτεινός λευκός πυρήνας μέσα σε μια απαλή λάμψη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ljus vit kärna inuti ett mjukt sken."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En lys hvid kerne inde i en blød glød."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En lys hvit kjerne inne i en myk glød."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirkkaan valkoinen ydin pehmeän hehkun sisällä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Inti putih terang di dalam cahaya lembut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lõi màu trắng sáng bên trong ánh sáng dịu nhẹ."
          }
        }
      }
    },
    "A clear knob showing the dial inside, to match the Switches keys.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mando transparente con el dial a la vista, a juego con las teclas que muestran el interruptor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une molette transparente laissant voir le cadran, assortie aux touches à mécanisme apparent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein durchsichtiger Drehregler mit sichtbarer Skala, passend zu den Tasten mit sichtbaren Schaltern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una manopola trasparente con quadrante a vista, abbinata ai tasti con interruttore visibile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um botão transparente com o mostrador à vista, a condizer com as teclas de interruptor visível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прозрачная ручка с видимым циферблатом в стиле клавиш с открытыми переключателями."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol lutsinar yang menampakkan dail di dalam, sepadan dengan kekunci bersuis terdedah."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Átlátszó tekerő látható számlappal, a kapcsolókat megmutató billentyűkhöz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内部の目盛りが見える透明なノブです。スイッチが見えるキーに合います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内部刻度清晰可见的透明旋钮，与展示轴体的按键相配。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내부 눈금이 보이는 투명 노브로, 스위치가 드러나는 키와 어울립니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Läbipaistev pöördnupp nähtava skaalaga, mis sobib avatud lülititega klahvidega."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un buton clar care arată cadranul din interior, pentru a se potrivi cu tastele Comutatoare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een duidelijke knop die de wijzerplaat aan de binnenkant laat zien, passend bij de schakelaartoetsen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內部刻度清晰可見的透明旋鈕，與展示軸體的按鍵相配。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "‘n Deursigtige knop wat die syfer binne wys, om by die Switches-sleutels te pas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejrzyste pokrętło pokazujące tarczę znajdującą się w środku, pasujące do klawiszy Switches."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чітка ручка, на якій видно циферблат усередині, відповідно до клавіш перемикачів."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar tuşlarıyla eşleşecek şekilde iç kısımdaki kadranı gösteren net bir düğme."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasný knoflík s číselníkem uvnitř, který odpovídá tlačítkům přepínačů."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasný gombík zobrazujúci ciferník vo vnútri, ktorý zodpovedá tlačidlám prepínačov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα καθαρό κουμπί που δείχνει το καντράν στο εσωτερικό, για να ταιριάζει με τα πλήκτρα διακόπτη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tydlig ratt som visar ratten inuti, för att matcha Switch-knapparna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En tydelig knap, der viser urskiven indeni, for at matche Switch-tasterne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En tydelig knott som viser skiven inni, for å matche brytertastene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selkeä nuppi, joka näyttää sisällä olevan valitsin, joka vastaa kytkimien näppäimiä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenop bening yang menampilkan pelat jam di dalamnya, agar sesuai dengan tombol Sakelar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một núm xoay rõ ràng hiển thị mặt số bên trong, để khớp với các phím của Switch."
          }
        }
      }
    },
    "A control id is the anchor a plugin names in section(). A page id is what a clink:// link opens.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bedienelement-ID ist der Anker, den ein Plugin in section() nennt. Eine Seiten-ID ist das, was ein clink://-Link öffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ID de un control es el ancla que un plugin indica en section(). El ID de una página es lo que abre un enlace clink://."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Juhtelemendi ID on ankur, mida pistikprogramm section() sees nimetab. Lehe ID on see, mida clink://-link avab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identifiant d'une commande est l'ancre qu'un plugin nomme dans section(). L'identifiant d'une page est ce qu'ouvre un lien clink://."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vezérlő azonosítója az a horgony, amelyet egy bővítmény a section() hívásban megnevez. Az oldal azonosítója az, amit egy clink:// hivatkozás megnyit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ID di un controllo è l'ancora che un plugin indica in section(). L'ID di una pagina è ciò che apre un link clink://."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントロール ID はプラグインが section() で指定するアンカーです。ページ ID は clink:// リンクが開くものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨트롤 ID는 플러그인이 section()에서 지정하는 앵커입니다. 페이지 ID는 clink:// 링크가 여는 대상입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "ID kawalan ialah sauh yang dinamakan plugin dalam section(). ID halaman ialah apa yang dibuka oleh pautan clink://."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ID de um controlo é a âncora que um plugin indica em section(). O ID de uma página é o que uma ligação clink:// abre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор элемента это якорь, который плагин называет в section(). Идентификатор страницы это то, что открывает ссылка clink://."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控件 ID 是插件在 section() 中指定的锚点。页面 ID 是 clink:// 链接打开的目标。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ID de control este ancora pe care un plugin o numește în section(). Un ID de pagină este ceea ce se deschide un link: //."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een controle-ID is het anker dat een plug-in noemt in section(). Een pagina-ID is wat een clink://-link opent."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制元件 ID 是外掛在 section() 中指定的錨點。頁面 ID 是 clink:// 連結開啟的目標。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "‘n Beheereenheid-ID is die anker wat ‘n inprop in section() noem. ‘n Bladsy-ID is wat ‘n clink://-skakel oopmaak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Identyfikator kontrolny to kotwica nazw wtyczek w sekcji (). Identyfikator strony to to, co otwiera link clink://."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ідентифікатор елемента керування — це прив’язка імен плагіна в розділі(). Ідентифікатор сторінки – це те, що відкриває посилання clink://."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kontrol kimliği, () bölümündeki eklenti adlarının çapasıdır. Sayfa kimliği, clink:// bağlantısının açıldığı şeydir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "ID ovládacího prvku je kotva a názvy zásuvných modulů v section(). ID stránky je to, co otevře odkaz clink://."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "ID ovládacieho prvku je kotva a názvy doplnkov v sekcii (). ID stránky je to, čo otvorí odkaz clink://."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα αναγνωριστικό ελέγχου είναι η άγκυρα που ονομάζει ένα πρόσθετο στην ενότητα(). Ένα αναγνωριστικό σελίδας είναι αυτό που ανοίγει ένας σύνδεσμος clink://."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett kontroll-id är ankaret som ett plugin namnger i avsnitt(). Ett sid-id är vad en clink://-länk öppnar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et kontrol-id er ankeret, som et plugin navngiver i afsnit(). Et side-id er det, som et clink://-link åbner."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En kontroll-ID er ankeret et plugin navn i seksjon(). En side-ID er det en clink://-kobling åpner."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohjaustunnus on liitännäisen nimen ankkuri section(). Sivutunnus on se, jonka clink://-linkki avaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Id kontrol adalah jangkar nama plugin di bagian(). Id halaman adalah apa yang dibuka oleh tautan clink://."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Id điều khiển là điểm neo của tên plugin trong phần(). Id trang là nội dung mà liên kết clink:// sẽ mở ra."
          }
        }
      }
    },
    "A couple taps in Settings and you're typing with Clink everywhere.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Paar tik in Instellings en jy tik oral met Clink."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar Tipps in den Einstellungen und du tippst überall mit Clink."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un par de toques en Ajustes y ya escribes con Clink en todas partes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mõni puudutus seadetes ja sa tipid igal pool Clinkiga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux ou trois appuis dans Réglages et tu tapes avec Clink partout."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pár koppintás a Beállításokban, és már mindenhol a Clinkkel gépelsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paio di tocchi in Impostazioni e scrivi con Clink ovunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で数回タップすれば、どこでも Clink で入力できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 몇 번만 누르면 어디서나 Clink로 칠 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa ketikan dalam Tetapan dan anda boleh menaip dengan Clink di mana-mana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uns toques nas Definições e ficas a escrever com o Clink em todo o lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пара нажатий в Настройках — и вы печатаете в Clink где угодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置里点几下，你就能到处用 Clink 打字了。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Câteva atingeri în Configurări și tastați cu Clink peste tot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een paar tikken in Instellingen en je typt overal met Clink."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定裡點幾下，你就能到處用 Clink 打字了。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilka kliknięć w Ustawienia i wszędzie piszesz za pomocą Clink."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пару натискань у налаштуваннях, і ви скрізь друкуватимете з Clink."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'a birkaç dokunuşla her yere Clink ile yazıyorsunuz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pár klepnutí v Nastavení a všude píšete pomocí Clink."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pár ťuknutí v Nastaveniach a všade píšete so Clink."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάποια πατήματα στις Ρυθμίσεις και πληκτρολογείτε με το Clink παντού."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett par tryck i Inställningar och du skriver med Clink överallt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et par tryk i Indstillinger, og du skriver med Clink overalt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et par trykk i Innstillinger og du skriver med Clink overalt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutama napautus Asetuksissa ja kirjoitat Clink:llä kaikkialla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa ketukan di Pengaturan dan Anda mengetik dengan Clink di mana saja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ cần nhấn vài lần trong Cài đặt là bạn có thể gõ phím bằng Clink ở mọi nơi."
          }
        }
      }
    },
    "A faint line with stars twinkling along it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "’n Dowwe lyn met sterre wat daarlangs flikker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine zarte Linie mit funkelnden Sternen darauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea tenue con destellos por encima."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hägus joon, mille ääres tähed vilguvad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ligne discrète parsemée d'étincelles."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Halvány vonal, rajta csillogó szikrákkal."
          }
        },
