            "value": "Alegeți Permite și iOS nu mai cere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies Toestaan en iOS stopt met vragen."
          }
        },
        "zh-Hant": {
