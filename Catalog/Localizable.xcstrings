        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε χώρο για να σύρετε. Τα πλήκτρα παραμένουν ορατά αλλά αδρανή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll mellanslag för att dra. Nycklar förblir synliga men blir inerta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold plads for at trække. Taster forbliver synlige, men bliver inaktive."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold mellomrom for å dra. Taster forblir synlige, men blir inerte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä tilaa vetääksesi. Avaimet pysyvät näkyvissä, mutta pysyvät paikallaan."
