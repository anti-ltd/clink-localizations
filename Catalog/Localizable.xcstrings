    "Adds the punctuation and capitals speech recognition misses. Your words are left exactly as you said them.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg die leestekens en hoofletters spraakherkenning mis. Jou woorde word presies gelaat soos jy dit gesê het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Zeichensetzung und Großschreibung hinzu, die die Spracherkennung übersieht. Ihre Wörter bleiben genau so, wie Sie sie gesagt haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la puntuación y mayúsculas que el reconocimiento de voz no capta. Tus palabras quedan exactamente como las dijiste."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisab kirjavahemärgid ja suurtähed, mida kõnetuvastus vahele jätab. Sinu sõnad jäävad täpselt nii, nagu sa ütlesid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute la ponctuation et les majuscules que la reconnaissance vocale oublie. Vos mots restent exactement comme vous les avez dits."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiegészíti az írásjeleket és nagybetűket, amiket a beszédfelismerés kihagy. A szavak pontosan úgy maradnak, ahogy mondta őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge la punteggiatura e le maiuscole che il riconoscimento vocale perde. Le tue parole rimangono esattamente come le hai dette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声認識が見逃す句読点や大文字を補います。話した言葉はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 인식이 놓친 구두점과 대문자를 추가합니다. 말한 단어는 그대로 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambah tanda baca dan huruf besar yang terlepas oleh pengecaman pertuturan. Perkataan anda kekal seperti yang anda ucapkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona a pontuação e maiúsculas que o reconhecimento de fala não capta. As suas palavras ficam exatamente como as disse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет знаки препинания и заглавные буквы, которые распознавание речи пропускает. Ваши слова остаются ровно такими, как вы их сказали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加语音识别遗漏的标点和大小写。你所说的话保持原样。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă semnele de punctuație și majusculele de recunoaștere a vorbirii. Cuvintele tale au rămas exact așa cum le-ai spus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt de ontbrekende spraakherkenning van interpunctie en hoofdletters toe. Je woorden blijven precies zoals je ze hebt gezegd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增語音識別遺漏的標點和大小寫。你所說的話保持原樣。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje brakujące znaki interpunkcyjne i wielkie litery w rozpoznawaniu mowy. Twoje słowa pozostały dokładnie takie, jakie je wypowiedziałeś."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає промахи розпізнавання мовлення пунктуації та великих літер. Ваші слова залишилися точно такими, як ви їх сказали."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşma tanımada eksik olan noktalama işaretlerini ve büyük harfleri ekler. Sözlerin aynen söylediğin gibi kaldı."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidá interpunkci a velká písmena, která chybí při rozpoznávání řeči. Vaše slova zůstala přesně tak, jak jste je řekl."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridá interpunkciu a veľké písmená, ktoré chýbajú pri rozpoznávaní reči. Vaše slová zostali presne tak, ako ste ich povedali."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέτει τα σημεία στίξης και τα κεφαλαία αστοχίες αναγνώρισης ομιλίας. Τα λόγια σου μένουν ακριβώς όπως τα είπες."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägger till skiljetecken och versaler taligenkänningsmissar. Dina ord lämnas precis som du sa dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføjer tegnsætning og store bogstaver talegenkendelse misser. Dine ord efterlades præcis, som du sagde dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legger til tegnsetting og store bokstaver for talegjenkjenning. Ordene dine blir stående nøyaktig slik du sa dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää välimerkit ja isot kirjaimet puheentunnistuksen puutteet. Sanasi on jätetty juuri sellaisiksi kuin sanoit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan kesalahan pengenalan tanda baca dan huruf kapital. Kata-kata Anda dibiarkan persis seperti yang Anda ucapkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm dấu câu và nhận dạng giọng nói viết hoa bị thiếu. Lời nói của bạn được để lại chính xác như bạn đã nói."
          }
        }
      }
    },
