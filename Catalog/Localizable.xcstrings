    "Tashkeel replaces this key’s current hold actions with its Arabic marks.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel vervang hierdie sleutel se huidige hou-aksies met sy Arabiese merke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel ersetzt die aktuellen Halteaktionen dieser Taste durch arabische Zeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel sustituye las acciones actuales al mantener pulsada esta tecla por sus signos árabes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel asendab selle klahvi praegused pikalt vajutamise toimingud araabia märkidega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel remplace les actions d’appui prolongé actuelles de cette touche par ses signes arabes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tashkeel a billentyű jelenlegi hosszan nyomás műveleteit arab jelekre cseréli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel sostituisce le attuali azioni di pressione prolungata di questo tasto con i segni arabi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeelはこのキーの現在の長押しアクションをアラビア語の記号に置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel은 이 키의 현재 길게 누르기 동작을 아랍어 기호로 바꿉니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel menggantikan tindakan tekan lama kekunci ini dengan tanda Arabnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tashkeel substitui as ações atuais de toque longo desta tecla pelos seus sinais árabes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel заменит текущие действия удержания этой клавиши арабскими знаками."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel 会用阿拉伯语符号替换此按键当前的长按操作。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel înlocuiește acțiunile actuale de reținere ale acestei chei cu mărcile sale arabe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel vervangt de huidige hold-acties van deze toets door zijn Arabische markeringen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel 會用阿拉伯語符號替換此按鍵當前的長按操作。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel zastępuje bieżące działania wstrzymania tego klawisza jego arabskimi znakami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel замінює поточні дії утримання цієї клавіші своїми арабськими позначками."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel, bu anahtarın mevcut tutma eylemlerini Arapça işaretleriyle değiştirir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel nahrazuje současné blokování tohoto klíče jeho arabskými značkami."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel nahrádza súčasné akcie tohto kľúča jeho arabskými značkami."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Tashkeel αντικαθιστά τις τρέχουσες ενέργειες κράτησης αυτού του κλειδιού με τα αραβικά σήματα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel ersätter den här nyckelns nuvarande hållåtgärder med dess arabiska tecken."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel erstatter denne nøgles nuværende hold-handlinger med dens arabiske mærker."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel erstatter denne nøkkelens nåværende hold-handlinger med dens arabiske merker."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel korvaa tämän avaimen nykyiset pitotoiminnot arabialaisilla merkeillä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel mengganti tindakan penahanan kunci ini dengan tanda Arabnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel thay thế hành động giữ hiện tại của phím này bằng dấu tiếng Ả Rập."
