            "value": "Fang an zu tippen. Beide werden gleichzeitig geprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a escribir. Los dos se revisan a la vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakka tipitama. Mõlemad kontrollitakse korraga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence à écrire. Les deux sont vérifiées en même temps."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdj gépelni. Mindkettőt egyszerre ellenőrzi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comincia a scrivere. Entrambe vengono controllate insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとは入力するだけです。両方の言語が同時にチェックされます。"
