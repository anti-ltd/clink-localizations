          "stringUnit": {
            "state": "translated",
            "value": "Tik ergens met een andere vinger terwijl u de spatiebalk ingedrukt houdt om te beginnen met markeren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住空格時用另一根手指點按任意處即可開始選中。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij w dowolnym miejscu innym palcem, przytrzymując spację, aby rozpocząć wyróżnianie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться будь-де іншим пальцем, утримуючи пробіл, щоб почати виділення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vurgulamayı başlatmak için boşluk tutarken başka bir parmağınızla herhangi bir yere dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li začít zvýrazňovat, klepněte kamkoli jiným prstem a podržte mezerník."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete začať zvýrazňovať, klepnite kdekoľvek iným prstom a zároveň podržte medzeru."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε οπουδήποτε με ένα άλλο δάχτυλο κρατώντας το διάστημα για να ξεκινήσετε την επισήμανση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck var som helst med ett annat finger samtidigt som du håller mellanslag för att börja markera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk hvor som helst med en anden finger, mens du holder mellemrummet for at begynde at fremhæve."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk hvor som helst med en annen finger mens du holder mellomrom for å begynne å utheve."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita korostus napauttamalla mitä tahansa toisella sormella samalla, kun pidät välilyönnin painettuna."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk di mana saja dengan jari lainnya sambil menahan spasi untuk mulai menyorot."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào bất kỳ đâu bằng ngón tay khác trong khi giữ khoảng trắng để bắt đầu đánh dấu."
          }
        }
      }
    },
    "Tap buttons in the preview. Text they insert shows up here.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
