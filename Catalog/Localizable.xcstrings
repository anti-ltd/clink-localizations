    "Open the labeled Tools menu from the bar. You can also keep the 123 shortcut for faster access.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak die gemerkte Gereedskap-kieslys in die balk oop. Jy kan ook die 123-kortpad hou vir vinniger toegang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne das beschriftete Tools-Menü in der Leiste. Für schnelleren Zugriff kannst du auch den 123-Kurzbefehl behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el menú Herramientas de la barra. También puedes mantener el atajo 123 para acceder más rápido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava nimetatud Tööriistade menüü ribalt. Kiirema ligipääsu jaoks võid hoida ka 123-otsetee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le menu Outils dans la barre. Tu peux aussi garder le raccourci 123 pour y accéder plus vite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a feliratozott Eszközök menüt a sávból. A gyorsabb eléréshez a 123 parancsikont is megtarthatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri il menu Strumenti dalla barra. Puoi anche tenere la scorciatoia 123 per accedervi più in fretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーにある「ツール」メニューを開きます。すばやく開けるよう、123ショートカットを残すこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바에서 이름이 표시된 도구 메뉴를 여세요. 더 빠르게 열 수 있도록 123 단축키를 유지할 수도 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka menu Alatan berlabel daripada bar. Anda juga boleh kekalkan pintasan 123 untuk akses lebih pantas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o menu Ferramentas na barra. Também podes manter o atalho 123 para um acesso mais rápido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте подписанное меню «Инструменты» с полосы. Можно также оставить ярлык 123 для более быстрого доступа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从工具栏打开带文字的“工具”菜单。也可以保留 123 快捷入口，方便快速打开。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți meniul etichetat Instrumente din bară. De asemenea, puteți păstra comanda rapidă 123 pentru un acces mai rapid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open het gelabelde menu Extra vanuit de balk. U kunt ook de snelkoppeling 123 behouden voor snellere toegang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從工具欄開啟帶文字的“工具”選單。也可以保留 123 快捷入口，方便快速開啟。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz na pasku menu oznaczone etykietą Narzędzia. Możesz także zachować skrót 123, aby uzyskać szybszy dostęp."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте меню «Інструменти» на панелі. Ви також можете зберегти ярлик 123 для швидшого доступу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çubuktan etiketli Araçlar menüsünü açın. Daha hızlı erişim için 123 kısayolunu da saklayabilirsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete nabídku Nástroje z lišty. Můžete si také ponechat zkratku 123 pro rychlejší přístup."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na paneli otvorte ponuku Nástroje. Môžete si tiež ponechať skratku 123 pre rýchlejší prístup."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το μενού Εργαλεία με την ετικέτα από τη γραμμή. Μπορείτε επίσης να διατηρήσετε τη συντόμευση 123 για ταχύτερη πρόσβαση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna menyn Verktyg från fältet. Du kan också behålla genvägen 123 för snabbare åtkomst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn menuen Værktøjer fra linjen. Du kan også beholde 123-genvejen for hurtigere adgang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne den merket Verktøy-menyen fra linjen. Du kan også beholde 123-snarveien for raskere tilgang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa palkista Työkalut-valikko. Voit myös pitää 123-pikanäppäimen nopeampaa käyttöä varten."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka menu Alat berlabel dari bilah. Anda juga dapat menyimpan pintasan 123 untuk akses lebih cepat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở menu Công cụ có nhãn từ thanh. Bạn cũng có thể giữ phím tắt 123 để truy cập nhanh hơn."
          }
        }
      }
    },
