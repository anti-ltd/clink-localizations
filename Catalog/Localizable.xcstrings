    "Swells and thins with your speed, like a real nib.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ensancha y se afina con tu velocidad, como un plumín real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'épaissit et s'amincit selon votre vitesse, comme une vraie plume."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird mit Ihrer Geschwindigkeit dicker und dünner, wie eine echte Feder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si allarga e si assottiglia con la velocità, come un vero pennino."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarga e afina com a sua velocidade, como uma pena verdadeira."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengembang dan menipis mengikut kepantasan anda, seperti mata pena sebenar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastagsága változik a sebességgel, akár egy valódi tollhegy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "速度に合わせて太くなったり細くなったり、まるで本物のペン先のように。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随你的速度自动变化粗细，如同真实的笔尖。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "속도에 따라 굵어졌다 가늘어졌다, 진짜 펜촉처럼."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paisub ja aheneb sinu kiirusega, nagu päris sulega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Утолщается и утончается в зависимости от скорости, как настоящее перо."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Swel en verdun met jou spoed, soos 'n regte penpunt."
          }
        }
      }
    },
