            "state": "translated",
            "value": "Các thay đổi ở đây chỉ áp dụng cho diện mạo này."
          }
        }
      }
    },
    "No purchases were found to restore. Check that you’re using the Apple Account you purchased with.": {
      "extractionState": "manual",
      "comment": "Restore Purchases result in the membership plan picker.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han encontrado compras para restaurar. Comprueba que estás usando la cuenta de Apple con la que compraste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun achat à restaurer n’a été trouvé. Vérifie que tu utilises le compte Apple avec lequel tu as effectué tes achats."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurden keine Käufe zum Wiederherstellen gefunden. Prüfe, ob du den Apple Account verwendest, mit dem du die Käufe getätigt hast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono stati trovati acquisti da ripristinare. Verifica di usare l’Apple Account con cui hai effettuato gli acquisti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foram encontradas compras para restaurar. Confirma que estás a usar a Conta Apple com que fizeste as compras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки для восстановления не найдены. Убедитесь, что вы используете Аккаунт Apple, с которым совершали покупки."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada pembelian ditemui untuk dipulihkan. Pastikan anda menggunakan Akaun Apple yang digunakan untuk membuat pembelian."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem található visszaállítható vásárlás. Ellenőrizd, hogy a vásárláshoz használt Apple-fiókkal vagy-e bejelentkezve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元できる購入が見つかりませんでした。購入時と同じApple Accountを使用しているか確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到可恢复的购买项目。请确认你使用的是购买时所用的 Apple 账户。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원할 구입 항목을 찾을 수 없습니다. 구입할 때 사용한 Apple 계정으로 로그인했는지 확인해 주세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taastatavaid oste ei leitud. Kontrolli, kas kasutad sama Apple’i kontot, millega ostud tegid."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-au găsit achiziții de restaurat. Verifică dacă folosești contul Apple cu care ai făcut achizițiile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen aankopen gevonden om te herstellen. Controleer of je de Apple Account gebruikt waarmee je de aankopen hebt gedaan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到可回復的購買項目。請確認你使用的是購買時所用的 Apple 帳號。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen aankope is gevind om te herstel nie. Maak seker dat jy die Apple-rekening gebruik waarmee jy die aankope gedoen het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono zakupów do odtworzenia. Sprawdź, czy używasz konta Apple, za pomocą którego dokonano zakupów."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не знайдено покупок для відновлення. Переконайтеся, що ви використовуєте обліковий запис Apple, з яким здійснювали покупки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yüklenecek satın alım bulunamadı. Satın alırken kullandığınız Apple Hesabı ile giriş yaptığınızdan emin olun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyly nalezeny žádné nákupy k obnovení. Zkontroluj, že používáš účet Apple, se kterým byly nákupy provedeny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenašli sa žiadne nákupy na obnovenie. Skontroluj, či používaš Apple účet, s ktorým boli nákupy uskutočnené."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκαν αγορές για επαναφορά. Βεβαιώσου ότι χρησιμοποιείς τον Λογαριασμό Apple με τον οποίο έκανες τις αγορές."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga köp hittades att återskapa. Kontrollera att du använder det Apple-konto som du gjorde köpen med."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet nogen køb at gendanne. Kontrollér, at du bruger den Apple-konto, du foretog købene med."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen kjøp å gjenopprette. Kontroller at du bruker Apple-kontoen du foretok kjøpene med."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palautettavia ostoja ei löytynyt. Tarkista, että käytät samaa Apple-tiliä kuin ostoja tehdessäsi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada pembelian yang dapat dipulihkan. Pastikan Anda menggunakan Akun Apple yang digunakan saat membeli."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy giao dịch mua nào để khôi phục. Hãy kiểm tra xem bạn có đang dùng Tài khoản Apple đã dùng để mua hay không."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No purchases were found to restore. Check that you’re using the Apple Account you purchased with."
          }
        }
      }
    },
    "Purchases couldn’t be restored. Please try again.": {
      "extractionState": "manual",
      "comment": "Restore Purchases result in the membership plan picker.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido restaurar las compras. Vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de restaurer les achats. Réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Käufe konnten nicht wiederhergestellt werden. Bitte versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile ripristinare gli acquisti. Riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível restaurar as compras. Tenta novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось восстановить покупки. Попробуйте ещё раз."
          }
