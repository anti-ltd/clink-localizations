          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acțiunile activate apar în spatele butonului de acțiune al tastaturii."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingeschakelde acties verschijnen achter de actieknop van het toetsenbord."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
