    "Learned per language, so your French never corrects your English.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leer per taal, so jou Frans korrigeer nooit jou Engels nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird pro Sprache gelernt – dein Französisch korrigiert nie dein Englisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aprende por idioma, así que tu francés nunca corrige tu inglés."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Õpitakse keele kaupa, nii et sinu prantsuse ei paranda kunagi sinu inglise keelt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appris par langue : ton français ne corrigera jamais ton anglais."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyelvenként tanul, így a francia szavak sosem javítják az angolt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si impara per lingua, così il tuo francese non corregge mai il tuo inglese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語ごとに学習するので、フランス語が英語を書き換えることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어별로 학습해서 프랑스어가 영어를 고치는 일은 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipelajari mengikut bahasa, jadi bahasa Perancis awak tidak akan membetulkan bahasa Inggeris."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É aprendido por idioma, por isso o teu francês nunca corrige o teu inglês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обучение идёт отдельно по языкам, поэтому французский никогда не полезет исправлять английский."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按语言分开学习，法语不会去改你的英文。"
          }
        }
      }
    },
