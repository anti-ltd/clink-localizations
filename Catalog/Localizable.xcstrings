    "Hold the key to pick a character or open a panel, Gboard-style.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou die sleutel in om 'n karakter te kies of maak 'n paneel in Gboard-styl oop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt die Taste gedrückt, um ein Zeichen zu wählen oder ein Panel zu öffnen, so wie bei Gboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la tecla para elegir un carácter o abrir un panel, al estilo Gboard."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia klahvi, et valida märk või avada paneel, Gboardi moodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens la touche pour choisir un caractère ou ouvrir un panneau, façon Gboard."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd lenyomva a billentyűt egy karakter kiválasztásához vagy egy panel megnyitásához, Gboard-módra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto il tasto per scegliere un carattere o aprire un pannello, stile Gboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを長押しすると、文字を選んだりパネルを開いたりできます（Gboard 風）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 길게 눌러서 문자를 고르거나 패널을 열어요. Gboard처럼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan kekunci untuk pilih aksara atau buka panel, gaya Gboard."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a tecla premida para escolher um caráter ou abrir um painel, ao estilo do Gboard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержите клавишу, чтобы выбрать символ или открыть панель — как в Gboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按按键就能挑一个字符或打开一个面板，跟 Gboard 一样。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți apăsată tasta pentru a alege un caracter sau pentru a deschide un panou, în stil Gboard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de toets ingedrukt om een personage te kiezen of open een paneel in Gboard-stijl."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按按鍵就能挑一個字元或開啟一個面板，跟 Gboard 一樣。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj klawisz, aby wybrać postać lub otworzyć panel w stylu Gboard."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
