        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sztuczna inteligencja jest włączona, ale sugestie %@ Offline działają normalnie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AI увімкнено, але пропозиції %@ Offline працюють у звичайному режимі."
          }
