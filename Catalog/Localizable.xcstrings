    },
    "The suggestion bar and the corrections are separate switches, so you can keep one and drop the other.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschlagsleiste und Korrekturen sind getrennte Schalter, du kannst also eines behalten und das andere loswerden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de sugerencias y las correcciones son interruptores distintos, así que puedes quedarte con una y quitar las otras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre de suggestions et les corrections sont deux interrupteurs distincts : tu peux garder l'une et supprimer les autres."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A javaslatsáv és a javítások külön kapcsoló, így az egyiket megtarthatod, a másikat elhagyhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra dei suggerimenti e le correzioni sono interruttori separati, quindi puoi tenere l'una e togliere le altre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補バーと自動修正は別のスイッチなので、片方だけ残すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천 바와 수정은 서로 다른 스위치라, 하나만 남겨 둘 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bar cadangan dan pembetulan ialah suis berasingan, jadi anda boleh kekalkan satu dan buang yang lain."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de sugestões e as correções são interruptores diferentes, por isso podes ficar com uma e largar a outra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка подсказок и исправления — разные переключатели, так что одно можно оставить, а другое убрать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议栏和更正是两个独立开关，可以留一个、去一个。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soovituseriba ja parandused on eraldi lüliti, nii et saad ühe hoida ja teise ära jätta."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die voorstelbalk en die regstellings is aparte skakelaars, sodat jy een kan hou en die ander kan laat val."
          }
        }
      }
    },
    "The text after your selection.": {
