    "Your themes, layouts, custom keys and sounds, exactly how you set them up.": {
      "extractionState": "stale",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou temas, uitlegte, pasgemaakte sleutels en klanke, presies hoe jy dit opgestel het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Themes, Layouts, eigenen Tasten und Sounds, genau wie du sie eingerichtet hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus temas, disposiciones, teclas personalizadas y sonidos, tal como los configuraste."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu teemad, paigutused, kohandatud klahvid ja helid, täpselt nii, nagu sa seadistasid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes thèmes, dispositions, touches personnalisées et sons, exactement comme tu les as réglés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A témáid, elrendezéseid, egyéni billentyűid és hangjaid, pontosan úgy, ahogy beállítottad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi temi, layout, tasti personalizzati e suoni, esattamente come li hai impostati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ、レイアウト、カスタムキー、サウンドが設定したままで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마, 레이아웃, 커스텀 키와 사운드가 설정한 그대로 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema, susun atur, kekunci tersuai dan bunyi anda, tepat seperti yang anda tetapkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus temas, esquemas, teclas personalizadas e sons, tal como os configuraste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши темы, раскладки, свои клавиши и звуки — ровно в том виде, в каком вы их настроили."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的主题、布局、自定义按键和音效，保持原样。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Temele, aspectele, tastele și sunetele personalizate, exact cum le-ați configurat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw thema's, lay-outs, aangepaste toetsen en geluiden, precies zoals u ze heeft ingesteld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的主題、佈局、自定義按鍵和音效，保持原樣。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje motywy, układy, niestandardowe klawisze i dźwięki — dokładnie tak, jak je skonfigurujesz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші теми, макети, спеціальні клавіші та звуки, саме так, як ви їх налаштували."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temalarınız, düzenleriniz, özel tuşlarınız ve sesleriniz, tam olarak onları nasıl ayarladığınız gibi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše motivy, rozvržení, vlastní klávesy a zvuky, přesně tak, jak je nastavíte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše témy, rozloženia, vlastné klávesy a zvuky, presne tak, ako ste si ich nastavili."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα θέματα, οι διατάξεις, τα προσαρμοσμένα πλήκτρα και οι ήχοι σας, όπως ακριβώς τα ρυθμίσατε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina teman, layouter, anpassade tangenter och ljud, exakt hur du ställer in dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine temaer, layouts, brugerdefinerede taster og lyde, præcis hvordan du konfigurerer dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine temaer, oppsett, egendefinerte taster og lyder, nøyaktig hvordan du setter dem opp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teemasi, asettelusi, mukautetut näppäimet ja äänet, juuri niin kuin olet määrittänyt ne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema, tata letak, tombol khusus, dan suara Anda, persis seperti cara Anda mengaturnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ đề, bố cục, phím và âm thanh tùy chỉnh của bạn, chính xác như cách bạn thiết lập chúng."
          }
        }
      }
    },
