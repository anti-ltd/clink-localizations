    "The language this layout types. Change which layout it uses in Languages.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache, die dieses Layout schreibt. Welches Layout sie nutzt, änderst du unter Sprachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma que escribe esta disposición. Cambia cuál usa en Idiomas."
          }
        },
        "fr": {
          "stringUnit": {
