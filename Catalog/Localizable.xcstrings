            "state": "translated",
            "value": "%@ ist ein festes Layout. Mach dir eine eigene Kopie, um Tasten nur auf diesem Layout zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es una distribución integrada. Haz tu propia copia para tener teclas solo en esta distribución."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on sisseehitatud paigutus. Tee sellest oma koopia, et hoida klahve ainult sellel paigutusel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est une disposition intégrée. Fais-en une copie pour garder des touches sur cette disposition seulement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ egy beépített elrendezés. Csinálj róla saját másolatot, ha csak ezen az elrendezésen akarsz billentyűket tartani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è un layout integrato. Fanne una tua copia per tenere i tasti solo su questo layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は最初から入っているレイアウトです。このレイアウトだけにキーを置くには、コピーを作ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 은(는) 기본 레이아웃이에요. 이 레이아웃에만 키를 두려면 복사본을 만들어서 쓰세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ialah susun atur siap sedia. Buat salinan anda sendiri untuk mengekalkan kekunci pada susun atur ini sahaja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é um esquema integrado. Faz uma cópia tua para manteres teclas só neste esquema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — встроенная раскладка. Сделайте свою копию, чтобы клавиши остались только в ней."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是内置布局。复制一份，就能只在这个布局上留按键了。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ este un aspect încorporat. Fă-ți propria copie a acestuia pentru a păstra cheile numai pentru acest aspect."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is een ingebouwde lay-out. Maak er uw eigen kopie van om de toetsen alleen op deze lay-out te houden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是內建佈局。複製一份，就能只在這個佈局上留按鍵了。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ to układ wbudowany. Utwórz własną kopię, aby zachować klucze tylko w tym układzie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a built-in layout. Зробіть свою власну копію, щоб ключі залишалися лише на цьому макеті."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yerleşik bir düzendir. Anahtarları yalnızca bu düzende tutmak için kendi kopyanızı oluşturun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je vestavěné rozložení. Vytvořte si jeho vlastní kopii, aby klíče zůstaly pouze v tomto rozložení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je vstavané rozloženie. Vytvorte si vlastnú kópiu, aby sa kľúče zachovali iba v tomto rozložení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ είναι μια ενσωματωμένη διάταξη. Δημιουργήστε το δικό σας αντίγραφο για να διατηρήσετε τα κλειδιά μόνο σε αυτήν τη διάταξη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är en inbyggd layout. Gör din egen kopia av den för att behålla nycklarna enbart på den här layouten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er et indbygget layout. Lav din egen kopi af det for at beholde nøglerne på dette layout alene."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er en innebygd layout. Lag din egen kopi av den for å beholde nøklene på denne layouten alene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on sisäänrakennettu asettelu. Tee siitä oma kopio, jotta avaimet säilyvät vain tässä asettelussa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
