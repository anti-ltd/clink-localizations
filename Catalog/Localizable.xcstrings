    "Come back after a couple of days to see your weekly trend.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom terug na 'n paar dae om jou weeklikse neiging te sien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau in ein paar Tagen wieder vorbei, um deinen Wochentrend zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve dentro de un par de días para ver la tendencia de la semana."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tule mõne päeva pärast tagasi, et näha oma nädalatrendi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviens dans quelques jours pour voir ta tendance de la semaine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézz vissza pár nap múlva a heti trendért."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna tra un paio di giorni per vedere l'andamento della settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数日後に戻ると、週間の傾向を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "며칠 뒤에 다시 오면 주간 추이를 볼 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Datang semula selepas beberapa hari untuk melihat trend mingguan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta daqui a alguns dias para veres a tendência da semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернитесь через пару дней, чтобы увидеть свою недельную динамику."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过几天再来看看本周趋势。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveniți după câteva zile pentru a vedea tendința dvs. săptămânală."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom na een paar dagen terug om uw wekelijkse trend te zien."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過幾天再來看看本週趨勢。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wróć po kilku dniach, aby zobaczyć swój tygodniowy trend."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверніться через пару днів, щоб побачити свій тижневий тренд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftalık trendinizi görmek için birkaç gün sonra tekrar gelin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraťte se po několika dnech a podívejte se na svůj týdenní trend."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vráťte sa o pár dní a pozrite si svoj týždenný trend."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιστρέψτε μετά από μερικές ημέρες για να δείτε την εβδομαδιαία τάση σας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom tillbaka efter ett par dagar för att se din veckotrend."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom tilbage efter et par dage for at se din ugentlige trend."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom tilbake etter et par dager for å se den ukentlige trenden din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaa muutaman päivän kuluttua nähdäksesi viikkotrendisi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembalilah setelah beberapa hari untuk melihat tren mingguan Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy quay lại sau một vài ngày để xem xu hướng hàng tuần của bạn."
          }
        }
      }
    },
