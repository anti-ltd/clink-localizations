    "s, stutters and false starts that come with talking out loud.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "s, hakkel en vals begin wat gepaard gaan met hardop praat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "s, Stotterer und Fehlstarts, die beim lauten Sprechen passieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "s, tartamudeos y falsos arranques de hablar en voz alta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "d, komistused ja valed algused, mis kaasnevad valju häälega rääkimisega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "s, bégaiements et faux départs qui viennent avec le fait de parler à voix haute."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "s, dadogások és hamis kezdések, amik a hangos beszéddel járnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "s, balbettii e falsi inizi che arrivano parlando ad alta voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "の言い淀みや、話し声に伴う吃りや言い間違い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ", 더듬거림 및 말할 때 나오는 헛시작."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "s, gagap dan permulaan palsu yang datang dengan bercakap kuat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "s, gaguejos e falsos começos que vêm com falar em voz alta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«э-э», запинки и ложные начала, которые бывают при разговоре вслух."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "、结巴和说话时的重新起头。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "s, bâlbâieli și porniri false care vin cu vorbirea cu voce tare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "stotteren en valse starts die gepaard gaan met hardop praten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "、結巴和說話時的重新起頭。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "jąkania i falstarty towarzyszące głośnemu mówieniu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "s, заїкання та фальстарти, які виникають під час розмови вголос."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek sesle konuşmanın getirdiği kekemelikler ve yanlış başlangıçlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "s, koktání a falešné začátky, které přicházejí s mluvením nahlas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "s, koktanie a falošné začiatky, ktoré prichádzajú s rozprávaním nahlas."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "s, τραύλισμα και λανθασμένες εκκινήσεις που συνοδεύονται από το να μιλάς δυνατά."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "s, stammar och tjuvstarter som kommer med att prata högt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "s, stammer og falske starter, der følger med at tale højt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "s, stamming og falske starter som følger med å snakke høyt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "s, änkytystä ja vääriä aloituksia, jotka tulevat ääneen puhumisesta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "s, kegagapan dan permulaan yang salah yang muncul saat berbicara dengan suara keras."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "s, nói lắp và bắt đầu sai khi nói to."
          }
        }
      }
    },
    "setting(), set_setting() and release() take the same ids. The grey text is what each one accepts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
