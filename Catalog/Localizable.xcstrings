    "Future taps get nudged back toward the target.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toekomstige krane word teruggestoot na die teiken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spätere Tipper werden wieder Richtung Ziel geschoben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los toques siguientes se empujan de vuelta hacia el objetivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulevased vajutused nihutatakse tagasi sihi poole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appuis suivants sont ramenés vers la cible."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A későbbi koppintásokat visszatereli a cél felé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tocchi successivi vengono spinti di nuovo verso il bersaglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以降のタップは狙った位置へ寄せて補正されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이후의 탭은 목표 지점 쪽으로 살짝 당겨집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketikan seterusnya ditolak semula ke arah sasaran."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os toques seguintes são empurrados de volta para o alvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующие нажатия подтягиваются обратно к цели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后的点按会被往目标方向拉回。"
          }
        }
      }
    },
