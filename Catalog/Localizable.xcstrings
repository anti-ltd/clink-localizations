    "Fonts you make stay on this device. They aren't attached to themes you share.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuentes que creas se quedan en este dispositivo. No se adjuntan a los temas que compartes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les polices que tu crées restent sur cet appareil. Elles ne sont pas jointes aux thèmes que tu partages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst erstellte Schriften bleiben auf diesem Gerät. Sie werden geteilten Themes nicht beigefügt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I font che crei restano su questo dispositivo. Non vengono allegati ai temi che condividi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As fontes que cria ficam neste dispositivo. Não são anexadas aos temas que partilha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Созданные вами шрифты остаются на этом устройстве. Они не прикрепляются к темам, которыми вы делитесь."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fon yang anda cipta kekal pada peranti ini. Ia tidak dilampirkan pada tema yang anda kongsi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az általad készített betűtípusok ezen az eszközön maradnak. A megosztott témákhoz nem csatolódnak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成したフォントはこの端末に残ります。共有するテーマには添付されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你制作的字体保留在此设备上，不会随分享的主题一起发送。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 만든 글꼴은 이 기기에만 남습니다. 공유하는 테마에는 첨부되지 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu loodud fondid jäävad sellesse seadmesse. Neid ei lisata jagatavatele teemadele."
          }
        }
      }
    },
