          "stringUnit": {
            "state": "translated",
            "value": "Paneel asendab klaviatuuri täieliku tõlkijaga. Kleebi tekst, vali keel ja sisesta seejärel tulemus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le panneau remplace le clavier par un traducteur complet. Colle du texte, choisis une langue, puis insère le résultat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A panel teljes fordítóra cseréli a billentyűzetet. Illessz be szöveget, válassz nyelvet, majd szúrd be az eredményt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pannello sostituisce la tastiera con un traduttore completo. Incolla il testo, scegli una lingua e inserisci il risultato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルを開くと、キーボード全体が翻訳画面になります。テキストを貼り付け、言語を選び、結果を挿入できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널을 열면 키보드가 전체 번역기로 바뀌어요. 텍스트를 붙여넣고 언어를 고른 다음 결과를 입력하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel menggantikan papan kekunci dengan penterjemah penuh. Tampal teks, pilih bahasa, kemudian sisipkan hasilnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O painel substitui o teclado por um tradutor completo. Cola texto, escolhe um idioma e insere o resultado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель заменяет клавиатуру полноценным переводчиком. Вставьте текст, выберите язык и вставьте результат."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板会将键盘替换为完整的翻译器。粘贴文本，选择语言，然后插入结果。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Panoul înlocuiește tastatura cu un traducător complet. Lipiți text, alegeți o limbă, apoi introduceți rezultatul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneel vervangt het toetsenbord door een volledige vertaler. Plak de tekst, kies een taal en voeg het resultaat in."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面板會將鍵盤替換為完整的翻譯器。貼上文字，選擇語言，然後插入結果。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel zastępuje klawiaturę pełnym tłumaczem. Wklej tekst, wybierz język, a następnie wstaw wynik."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель замінює клавіатуру на повноцінний перекладач. Вставте текст, виберіть мову та вставте результат."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel, klavyeyi tam bir tercümanla değiştirir. Metni yapıştırın, bir dil seçin ve ardından sonucu ekleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel nahrazuje klávesnici plnohodnotným překladačem. Vložte text, vyberte jazyk a vložte výsledek."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel nahrádza klávesnicu plnohodnotným prekladačom. Prilepte text, vyberte jazyk a potom vložte výsledok."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο πίνακας αντικαθιστά το πληκτρολόγιο με έναν πλήρη μεταφραστή. Επικολλήστε κείμενο, επιλέξτε μια γλώσσα και, στη συνέχεια, εισαγάγετε το αποτέλεσμα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel ersätter tangentbordet med en komplett översättare. Klistra in text, välj ett språk och infoga sedan resultatet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel erstatter tastaturet med en fuld oversætter. Indsæt tekst, vælg et sprog, og indsæt derefter resultatet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel erstatter tastaturet med en full oversetter. Lim inn tekst, velg et språk, og sett inn resultatet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneeli korvaa näppäimistön täydellä kääntäjällä. Liitä teksti, valitse kieli ja lisää sitten tulos."
          }
        },
        "id": {
          "stringUnit": {
