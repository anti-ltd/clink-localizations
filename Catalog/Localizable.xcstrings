          "stringUnit": {
            "state": "translated",
            "value": "Η διάταξη δεν πέρασε την επαλήθευση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La distribución no superó la verificación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paigutus ei läbinud kontrolli."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettelu ei läpäissyt tarkistusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposition n’a pas passé la vérification."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiosztás nem ment át az ellenőrzésen."
