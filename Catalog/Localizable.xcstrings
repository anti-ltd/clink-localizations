          "stringUnit": {
            "state": "translated",
            "value": "Fundo tem tudo: se a cor ou a fotografia do tema chegam a ser pintadas, e o que se move por cima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Фоне» собрано всё: рисуется ли вообще цвет или фото темы и что движется поверх них."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「背景」里都有：主题的颜色或照片要不要画出来，以及上面有什么在动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background has the lot: whether the theme's color or photo is painted at all, and what moves on top of it."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fundalul are multe: dacă culoarea temei sau fotografia este pictată deloc și ce se mișcă deasupra acesteia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De achtergrond bepaalt veel: of de kleur of foto van het thema überhaupt is geverfd, en wat er bovenop beweegt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「背景」裡都有：主題的顏色或照片要不要畫出來，以及上面有什麼在動。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tło ma wiele do powiedzenia: czy kolor motywu lub zdjęcie jest w ogóle namalowane i co się na nim porusza."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У фоні багато: чи намальовано колір теми чи фотографії взагалі, і що рухається поверх них."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka planda çok şey var: temanın renginin veya fotoğrafının boyalı olup olmadığı ve bunun üzerinde nelerin hareket ettiği."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozadí má hodně: zda je barva tématu nebo fotografie vůbec namalovaná a co se na ní pohybuje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozadie má veľa: či je farba témy alebo fotografia vôbec namaľovaná a čo sa na nej pohybuje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το φόντο έχει πολλά: αν το χρώμα ή η φωτογραφία του θέματος είναι καθόλου ζωγραφισμένα και τι κινείται πάνω του."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrunden är avgörande: om temats färg eller foto över huvud taget är målad och vad som rör sig ovanpå det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baggrunden har partiet: om temaets farve eller foto overhovedet er malet, og hvad der rører sig oven på det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrunnen har mye: om temaets farge eller foto i det hele tatt er malt, og hva som beveger seg på toppen av det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustalla on paljon merkitystä: onko teeman väri tai valokuva maalattu ollenkaan ja mikä sen päällä liikkuu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latar belakang mempunyai banyak hal: apakah warna tema atau foto dilukis, dan apa yang bergerak di atasnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nền có rất nhiều thứ: liệu màu sắc hoặc ảnh của chủ đề có được vẽ hay không và những gì di chuyển trên đó."
          }
        }
      }
    },
    "Backlight the keys as they glow and react": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlig die sleutels terwyl hulle gloei en reageer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasten hinterleuchten, damit sie glühen und reagieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroilumina las teclas para que brillen y reaccionen"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgusta klahve tahapoolt, et need helendaksid ja reageeriksid"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétroéclairez les touches pour qu'elles brillent et réagissent"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Világítsd meg a gombokat, hogy ragyogjanak és reagáljanak"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroillumina i tasti perché brillino e reagiscano"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを光らせ、反応させる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키에 조명을 넣어 빛나고 반응하게"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terangi kekunci supaya bercahaya dan bertindak balas"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroilumina as teclas para brilharem e reagirem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсветите клавиши, чтобы они светились и реагировали"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为按键打光，让它发光并作出反应"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Iluminează tastele în timp ce luminează și reacționează"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlicht de toetsen terwijl ze oplichten en reageren"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為按鍵打光，讓它發光並作出反應"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podświetlaj klawisze, gdy świecą i reagują"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсвічуйте клавіші, коли вони світяться та реагують"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parıldadıklarında ve tepki verdiklerinde tuşları arkadan aydınlatın"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsvícení kláves, když svítí a reagují"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsvietenie kláves, keď svietia a reagujú"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φωτίστε τα πλήκτρα καθώς λάμπουν και αντιδρούν"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Belys tangenterna när de lyser och reagerar"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baggrundslys tasterne, når de lyser og reagerer"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Belys tastene når de lyser og reagerer"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustavalo näppäimet, kun ne hehkuvat ja reagoivat"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu latar tombol saat menyala dan bereaksi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đèn nền các phím khi chúng phát sáng và phản ứng"
          }
        }
      }
    },
    "Backlight your keyboard the way a mechanical one glows: steady, moving, or lighting up under your fingers.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlig jou sleutelbord soos 'n meganiese een gloei: bestendig, beweeg of verlig onder jou vingers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinterleuchte deine Tastatur wie eine mechanische: ruhig, in Bewegung oder aufleuchtend unter deinen Fingern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroilumina tu teclado como brilla uno mecánico: fijo, en movimiento o encendiéndose bajo tus dedos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgusta oma klaviatuur tahapoolt nii, nagu helendab mehaaniline klaviatuur: ühtlane, liikuvas või sinu sõrmede all süttiv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éclaire ton clavier comme un clavier mécanique : lumière fixe, animée ou qui s’allume sous tes doigts."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Világítsd meg a billentyűzetet, ahogy egy mechanikus teszi: nyugodtan, mozgásban vagy az ujjaid alatt felvillanva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroilumina la tastiera come una meccanica: fissa, in movimento o che si accende sotto le dita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メカニカルキーボードのように、キーボードをバックライトで光らせます。静かに、流れるように、あるいは指の下で点灯します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메카니컬 키보드처럼 키보드에 조명을 넣습니다. 가만히, 흐르듯이, 또는 손가락 아래에서 켜지도록."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terangi papan kekunci anda seperti papan mekanikal: tetap, bergerak, atau menyala di bawah jari anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Retroilumina o teclado como um mecânico: fixo, em movimento ou acendendo sob os dedos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсветите клавиатуру, как механическую: ровно, с движением или загораясь под пальцами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像机械键盘那样为键盘打光：静止、流动，或在指尖下亮起。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Iluminați tastatura de fundal așa cum strălucește una mecanică: constant, în mișcare sau luminând sub degete."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlicht uw toetsenbord zoals een mechanisch toetsenbord oplicht: stabiel, bewegend of oplichtend onder uw vingers."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "像機械鍵盤那樣為鍵盤打光：靜止、流動，或在指尖下亮起。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podświetlaj klawiaturę tak, jak świeci klawiatura mechaniczna: stale, w ruchu lub świecąca pod palcami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсвічуйте клавіатуру так само, як світиться механічна: рівномірно, рухомо або світиться під вашими пальцями."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyenizi mekanik bir klavyenin parladığı şekilde arkadan aydınlatın: sabit, hareketli veya parmaklarınızın altında parlıyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsvícení klávesnice tak, jak svítí mechanická: stabilní, pohyblivá nebo svítící pod prsty."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsvietenie klávesnice tak, ako žiari mechanická: stabilne, pohybuje sa alebo svieti pod vašimi prstami."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φωτίστε το πληκτρολόγιό σας με τον τρόπο που λάμπει ένα μηχανικό: σταθερό, κινούμενο ή φωτισμένο κάτω από τα δάχτυλά σας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Belys ditt tangentbord så som ett mekaniskt lyser: stadigt, rör sig eller lyser upp under fingrarna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baggrundsbelys dit tastatur, som et mekanisk tastatur lyser: konstant, bevæger sig eller lyser op under fingrene."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrunnsbelys tastaturet slik et mekanisk lys lyser: stødig, beveger seg eller lyser opp under fingrene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustavalo näppäimistösi samalla tavalla kuin mekaaninen hehkuu: tasaisesti, liikkuva tai valaiseva sormiesi alla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya latar keyboard Anda seperti cahaya mekanis: stabil, bergerak, atau menyala di bawah jari Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đèn nền bàn phím của bạn giống như bàn phím cơ phát sáng: ổn định, di chuyển hoặc sáng lên dưới ngón tay của bạn."
          }
        }
      }
    },
