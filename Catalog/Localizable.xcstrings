          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz przełącznik profili, aby móc zamieniać profile z poziomu samej klawiatury."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть перемикач профілів, і ви зможете міняти профілі з самої клавіатури."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil Değiştiriciyi açın; profilleri klavyenin kendisinden değiştirebilirsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
