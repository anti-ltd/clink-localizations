    "The pet fidgets and looks around between keystrokes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Haustier zappelt und schaut sich zwischen den Tastendrücken um."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mascota se mueve y mira a su alrededor entre pulsaciones."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lemmik nihverdab ja vaatab klahvivajutuste vahel ringi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’animal gigote et regarde autour de lui entre les frappes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kisállat fészkelődik és körülnéz a billentyűleütések között."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’animaletto si agita e si guarda intorno tra un tasto e l’altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "打鍵の合間にペットがそわそわ動いて周りを見回します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누르는 사이 펫이 꼼지락거리며 둘러봐요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Haiwan peliharaan bergerak-gerak dan melihat sekeliling antara ketukan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O animal mexe-se e olha à volta entre toques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Питомец ёрзает и оглядывается между нажатиями."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宠物会在按键之间动来动去、四处张望。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Animalul de companie se agită și se uită în jur între apăsări de taste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het huisdier friemelt en kijkt rond tussen de toetsaanslagen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寵物會在按鍵之間動來動去、四處張望。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die troeteldier beweeg rusteloos en kyk rond tussen sleuteldrukke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwierzak wierci się i rozgląda pomiędzy naciśnięciami klawiszy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вихованець вередує і озирається між натисканнями клавіш."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evcil hayvan, tuş vuruşları arasında kıpırdanıyor ve etrafına bakıyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezi stisky kláves se mazlíček vrtí a rozhlíží se."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Domáce zviera sa medzi stlačeniami kláves vrtí a rozhliada sa."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κατοικίδιο ταράζεται και κοιτάζει τριγύρω ανάμεσα στα πλήκτρα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Husdjuret darrar och ser sig omkring mellan knapptryckningarna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kæledyret roder og ser sig omkring mellem tastetryk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjæledyret fikler og ser seg rundt mellom tastetrykkene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lemmikki pyörittelee ja katselee ympärilleen näppäinpainallusten välillä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hewan peliharaan itu gelisah dan melihat sekeliling di antara penekanan tombol."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con vật cưng bồn chồn và nhìn xung quanh giữa các lần nhấn phím."
          }
        }
      }
    },
    "The plugin draws this element. Its own settings are on the Plugins tab.": {
