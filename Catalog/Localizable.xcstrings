          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드도 함께 옮길지 고르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih sama ada papan keratan anda turut serta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide se a área de transferência também vai."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решите, поедет ли с ними буфер обмена."
