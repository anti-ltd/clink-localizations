            "value": "Baixa a Permanência do toque até zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сведите «Задержку нажатия» к нулю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把“按压停留”拖到零。"
          }
        }
      }
    },
    "Drag it down for squarer keys, up for rounder ones.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep dit af vir vierkantige sleutels, op vir ronder sleutels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach unten ziehen macht sie kantiger, nach oben runder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bájalo para teclas más cuadradas, súbelo para más redondeadas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista alla kandilisemate klahvide jaoks, üles ümaramate jaoks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baisse-le pour des touches plus carrées, monte-le pour plus rondes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd lejjebb a szögletesebb, feljebb a kerekebb billentyűkért."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbassalo per tasti più squadrati, alzalo per averli più tondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下げると角ばり、上げると丸くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내리면 각지고, 올리면 둥글어집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Turunkan untuk kekunci lebih bersegi, naikkan untuk lebih bulat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa-o para teclas mais quadradas, sobe-o para mais redondas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведите вниз — клавиши квадратнее, вверх — круглее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调低更方正，调高更圆润。"
          }
        }
      }
    },
    "Drag left and right to move the caret.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep links en regs om die skuifbalk te skuif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links und rechts ziehen, um den Cursor zu bewegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra izquierda y derecha para mover el cursor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista vasakule ja paremale kursori liigutamiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser gauche/droite pour déplacer le curseur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd balra és jobbra a kurzor mozgatásához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina a sinistra e a destra per spostare il cursore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右にドラッグしてキャレットを動かします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽·오른쪽으로 드래그해 캐럿을 움직입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret kiri dan kanan untuk gerakkan kursor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta esquerda e direita para mover o cursor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведите влево и вправо, чтобы перемещать курсор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左右拖动移动插入点。"
          }
        }
      }
    },
    "Drag on the blank bar to move the cursor. Tap does nothing.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep op die leë balk om die wyser te beweeg. Tik doen niks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh auf dem leeren Balken, um den Cursor zu bewegen. Tippen macht nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra la barra en blanco para mover el cursor. Tocar no hace nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista tühjal ribal kursori liigutamiseks. Puudutus ei tee midagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser la barre vide pour déplacer le curseur. Toucher ne fait rien."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd az üres sávon a kurzor mozgatásához. A koppintás nem csinál semmit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina sulla barra vuota per spostare il cursore. Toccare non fa nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空白のバーをドラッグしてカーソルを動かします。タップでは何も起きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 바를 드래그해 커서를 움직입니다. 탭은 아무 일도 안 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret pada bar kosong untuk gerakkan kursor. Ketik tidak buat apa-apa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta na barra em branco para mover o cursor. Tocar não faz nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведите по пустой полосе, чтобы перемещать курсор. Касание ничего не делает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在空白栏上拖动来移动光标。点按无效。"
          }
        }
      }
    },
    "Drag sideways for characters, up and down for lines.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep sywaarts vir karakters, op en af ​​vir lyne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seitwärts für Zeichen, hoch/runter für Zeilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra de lado para caracteres, arriba y abajo para líneas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista küljelt tähtede jaoks, üles-alla ridade jaoks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser latéralement pour les caractères, haut/bas pour les lignes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldalra a karakterekhez, fel-le a sorokhoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina di lato per i caratteri, su e giù per le righe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横方向で文字、上下で行を移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가로로 글자, 위아래로 줄 단위 이동합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret sisi untuk aksara, atas dan bawah untuk baris."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta de lado para caracteres, cima e baixo para linhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведите в стороны — по символам, вверх и вниз — по строкам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左右拖动按字符移，上下拖动按行移。"
          }
        }
      }
    },
    "Drag stickers to move them. Pinch or use the size slider to resize.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep plakkers om hulle te skuif. Knyp of gebruik die grootteskuifbalk om die grootte te verander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe Sticker, um sie zu verschieben. Zum Größenändern kneife oder nutze den Größenregler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra las pegatinas para moverlas. Pellizca o usa el control de tamaño para redimensionarlas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista kleepse liigutamiseks. Suuruse muutmiseks näpi või kasuta suuruselülitit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les autocollants pour les déplacer. Pincez ou utilisez le curseur de taille pour les redimensionner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd a matricákat mozgatáshoz. Méretezéshez csipesszel vagy a méretcsúszkával."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina gli adesivi per spostarli. Pizzica o usa il cursore per ridimensionarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステッカーをドラッグして移動。ピンチまたはサイズスライダーで拡大縮小。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스티커를 드래그하여 이동하세요. 크기는 핀치하거나 크기 슬라이더로 조절하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret pelekat untuk menggerakkannya. Cubit atau gunakan peluncur saiz untuk menukar saiz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste os adesivos para movê-los. Aperte ou use o controle de tamanho para redimensionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте стикеры, чтобы перемещать их. Изменяйте размер щипком или ползунком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动贴纸以移动它们。用双指捏合或大小滑块调整尺寸。"
          }
        }
      }
    },
    "Drag the handle to resize the strip, or turn the dials. Double-tap the strip to start over.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep die handvatsel om die grootte van die strook te verander, of draai die draaiknoppe. Dubbeltik op die strook om oor te begin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh am Griff, um den Streifen zu ändern, oder dreh an den Reglern. Doppeltippen auf den Streifen setzt alles zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el tirador para cambiar el tamaño de la tira o gira los diales. Toca dos veces la tira para empezar de cero."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista käepidet riba suuruse muutmiseks või keera ratast. Topelt-puuduta riba, et alustada uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser la poignée pour redimensionner la bande, ou tourne les molettes. Double-tape la bande pour tout remettre à zéro."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd a fogantyút a sáv átméretezéséhez, vagy tekerd a tárcsákat. A sávra duplán koppintva minden visszaáll."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina la maniglia per ridimensionare la striscia oppure gira le manopole. Tocca due volte la striscia per ricominciare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つまみをドラッグすると帯の大きさが変わります。ダイヤルでも調整でき、帯をダブルタップすると元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손잡이를 끌어 띠 크기를 바꾸거나 다이얼을 돌려 조절하세요. 띠를 두 번 탭하면 처음 상태로 돌아갑니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret pemegang untuk mengubah saiz jalur, atau putar dailnya. Ketik dua kali pada jalur untuk kembali asal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta a pega para redimensionar a faixa ou roda os seletores. Toca duas vezes na faixa para recomeçar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяните за ручку, чтобы изменить размер полосы, или покрутите регуляторы. Двойное нажатие по полосе начинает заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动手柄即可调整数字带大小，也可以转动旋钮。双击数字带即可恢复原状。"
          }
        }
      }
    },
    "Drag the handle to resize the strip. Double-tap the strip to start over.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep die handvatsel om die grootte van die strook te verander. Dubbeltik op die strook om oor te begin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh den Griff, um den Streifen zu skalieren. Doppeltippen setzt ihn zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el asa para cambiar el tamaño de la tira. Toca dos veces para empezar de cero."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista käepidet riba suuruse muutmiseks. Topelt-puuduta riba, et alustada uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse la poignée pour redimensionner la bande. Tape deux fois pour recommencer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd a fogantyút a sáv méretezéséhez. Dupla koppintás újrakezdi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina la maniglia per ridimensionare la striscia. Tocca due volte per ricominciare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドルをドラッグして帯の大きさを変えます。ダブルタップでやり直し。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핸들을 끌어 띠 크기를 바꿉니다. 두 번 탭하면 처음부터."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret pemegang untuk saiz semula jalur. Ketik dua kali untuk mula semula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta o puxador para redimensionar a faixa. Toca duas vezes para recomeçar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяните за ручку, чтобы изменить размер полосы. Дважды коснитесь полосы, чтобы начать заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动手柄调整条的大小。双击条子即可重来。"
          }
        }
      }
    },
    "Drag the knob up or right to turn it up.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh den Regler nach oben oder rechts, um ihn aufzudrehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra la rueda hacia arriba o a la derecha para subirla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Suurendamiseks lohista keerajat üles või paremale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser la molette vers le haut ou la droite pour augmenter la valeur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd a tekerőt felfelé vagy jobbra a növeléshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina la manopola in alto o a destra per alzarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノブを上か右にドラッグすると上がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노브를 위나 오른쪽으로 드래그하면 올라갑니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret tombol ke atas atau kanan untuk menaikkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste o botão para cima ou para a direita para aumentar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяните регулятор вверх или вправо, чтобы прибавить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上或向右拖动旋钮即可调高。"
          }
        }
      }
    },
    "Drag the padding handles on the preview to set how much room the keyboard takes.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die Abstandsgriffe in der Vorschau, um festzulegen, wie viel Platz die Tastatur einnimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los tiradores de los márgenes en la vista previa para ajustar cuánto espacio ocupa el teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista eelvaates veeriste pidemeid, et määrata, kui palju ruumi klaviatuur võtab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser les poignées des marges dans l’aperçu pour régler la place occupée par le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előnézet térközállító fogantyúival beállíthatod, mekkora helyet foglaljon a billentyűzet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le maniglie dei margini nell’anteprima per regolare lo spazio occupato dalla tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューの余白ハンドルをドラッグして、キーボードが占める範囲を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 보기의 여백 조절점을 드래그해 키보드가 차지하는 공간을 조절하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret pemegang jarak tepi pada pratonton untuk menetapkan ruang yang digunakan oleh papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta as pegas das margens na pré-visualização para ajustar o espaço ocupado pelo teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте маркеры отступов на предпросмотре, чтобы настроить, сколько места занимает клавиатура."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动预览中的边距控制点，调整键盘占用的空间。"
          }
        }
      }
    },
    "Drag through the rest of the letters without lifting.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep deur die res van die letters sonder om op te lig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh ohne abzusetzen durch die restlichen Buchstaben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra por el resto de las letras sin levantar el dedo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista läbi ülejäänud tähtede ilma sõrge tõstmata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser sur les autres lettres sans lever le doigt."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd végig a többi betűn felemelés nélkül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina sulle altre lettere senza staccare il dito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指を離さずに、残りの文字をなぞります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손가락을 떼지 말고 나머지 글자들을 지나가세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret melalui huruf yang lain tanpa mengangkat jari."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta pelas restantes letras sem levantar o dedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите по остальным буквам, не отрывая палец."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手指不抬起，划过其余的字母。"
          }
        }
      }
    },
    "Drag to move the row.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para mover la fila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser pour déplacer la rangée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Verschieben der Reihe ziehen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per spostare la riga."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para mover a fila."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы переместить ряд."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk mengalihkan baris."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd a sor áthelyezéséhez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして行を移動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以移动此行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 행을 이동하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rea liigutamiseks lohista."
          }
        }
      }
    },
    "Drag to move. Pinch to zoom.": {
      "comment": "Instructions for the photo framing preview. Drag the photo to reposition it on the key; move two fingers together or apart to change its scale.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Verschieben ziehen. Zum Zoomen zwei Finger auseinander- oder zusammenziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to move. Pinch to zoom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para mover. Pellizca para ajustar el zoom."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista liigutamiseks. Suurendamiseks või vähendamiseks vii kaks sõrme lahku või kokku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser pour déplacer. Pince pour zoomer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd el a mozgatáshoz. Két ujjal csippentve nagyíthatsz vagy kicsinyíthetsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per spostare. Pizzica per regolare lo zoom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして移動できます。ピンチして拡大・縮小できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 이동하세요. 두 손가락을 오므리거나 벌려 확대 또는 축소하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk mengalih. Cubit untuk mengezum."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta para mover. Junta ou afasta dois dedos para ajustar o zoom."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте, чтобы переместить. Сводите и разводите пальцы, чтобы изменить масштаб."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以移动，双指捏合或张开以缩放。"
          }
        }
      }
    },
    "Drag to reorder the languages in the keyboard's Translate menu, and switch off any you don't want to see there.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep om die tale in die sleutelbord se Vertaal-kieslys te herrangskik, en skakel enige wat jy nie daar wil sien nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh die Sprachen in die gewünschte Reihenfolge für das Übersetzen-Menü und schalte aus, was du dort nicht sehen möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para ordenar los idiomas del menú Traducir del teclado y desactiva los que no quieras ver."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista keeli klaviatuuri Tõlgi menüü järjestuse muutmiseks ja lülita välja need, mida sa seal näha ei taha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser les langues pour les réorganiser dans le menu Traduire du clavier, et désactive celles que tu ne veux pas voir."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzással rendezd át a billentyűzet Fordítás menüjének nyelveit, és kapcsold ki, amit nem szeretnél látni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare le lingue nel menu Traduci della tastiera e disattiva quelle che non vuoi vedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグしてキーボードの翻訳メニューの言語を並べ替え、表示しない言語はオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 번역 메뉴의 언어를 드래그해 순서를 바꾸고, 보지 않을 언어는 꺼 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk menyusun semula bahasa dalam menu Terjemah papan kekunci dan matikan bahasa yang tak mahu dilihat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta para reordenar os idiomas no menu Traduzir do teclado e desativa os que não queres ver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте, чтобы изменить порядок языков в меню «Перевод» на клавиатуре, и выключайте те, которые не хотите там видеть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动可调整键盘“翻译”菜单中的语言顺序，也可关闭不想显示的语言。"
          }
        }
      }
    },
    "Drag to reorder, or tap the minus to take something out.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Neuordnen ziehen oder auf das Minus tippen, um etwas zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar o toca el menos para quitar algo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista järjestuse muutmiseks või puuduta miinust, et midagi eemaldada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser pour réorganiser, ou touche le signe moins pour retirer un élément."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd az átrendezéshez, vagy koppints a mínuszra az eltávolításhoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare o tocca il meno per togliere qualcosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで並べ替え、マイナスをタップで取り除きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그해서 순서를 바꾸거나 빼기를 눌러 항목을 빼세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk susun semula, atau ketik tolak untuk mengeluarkan sesuatu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar ou toque no menos para tirar algo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы изменить порядок, или нажмите минус, чтобы убрать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以重新排序，或轻点减号移除项目。"
          }
        }
      }
    },
    "Drag to reorder, switch off what you never use. A tab with nothing in it is left out of the keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep om te herrangskik, skakel af wat jy nooit gebruik nie. 'n Oortjie met niks daarin nie, word uit die sleutelbord gelaat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh sie in die Reihenfolge, die du willst, und schalte aus, was du nie brauchst. Ein leerer Tab taucht auf der Tastatur gar nicht erst auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrástralas para ordenarlas y apaga las que no uses nunca. Una pestaña vacía no aparece en el teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista järjestamiseks, lülita välja see, mida sa kunagi ei kasuta. Tühi kaart jäetakse klaviatuurilt ära."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais-les glisser pour les ranger et désactive celles que tu n'utilises jamais. Un onglet vide n'apparaît pas sur le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd őket a kívánt sorrendbe, és kapcsold ki, amit sosem használsz. Az üres fül meg sem jelenik a billentyűzeten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascinale per riordinarle e spegni quelle che non usi mai. Una scheda vuota non compare sulla tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替え、使わないものはオフにできます。中身が空のタブはキーボードには出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끌어서 순서를 바꾸고, 안 쓰는 건 꺼두세요. 비어 있는 탭은 키보드에 나오지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk susun semula, matikan yang anda tak pernah guna. Tab yang kosong tak muncul pada papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta para reordenar e desliga o que nunca usas. Um separador vazio não aparece no teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскиванием задайте порядок и выключите то, чем не пользуетесь. Пустая вкладка на клавиатуру не попадает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动排序，用不上的直接关掉。空的分类不会出现在键盘上。"
          }
        }
      }
    },
    "Drag to reorder. The suggestions stretch to fill whatever room is left.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Neuordnen ziehen. Die Vorschläge füllen den restlichen Platz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Las sugerencias ocupan el espacio que quede."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestuse muutmiseks lohista. Soovitused täidavad ülejäänud ruumi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser pour réorganiser. Les suggestions occupent l’espace restant."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd az átrendezéshez. A javaslatok kitöltik a maradék helyet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. I suggerimenti occupano lo spazio rimasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで並べ替え。候補は残りのスペースいっぱいに広がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그해서 순서를 바꾸세요. 추천 단어가 남은 공간을 채웁니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk susun semula. Cadangan mengisi ruang yang tinggal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. As sugestões ocupam o espaço que sobrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы изменить порядок. Подсказки занимают всё оставшееся место."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以重新排序。建议会填满剩余空间。"
          }
        }
      }
    },
