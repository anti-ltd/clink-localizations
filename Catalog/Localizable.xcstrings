    "Clipboard, notepad, translate, emoji, calculator. Turn on the ones you want and skip the rest.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klembord, notaboek, vertaal, emoji's, sakrekenaar. Skakel dié aan wat jy wil hê en slaan die res oor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenablage, Notizblock, Übersetzen, Emoji, Rechner. Schalt die ein, die du willst, und lass den Rest weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portapapeles, bloc de notas, traducción, emoji, calculadora. Activa los que quieras y deja el resto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lõikelaud, märkmik, tõlge, emoji, kalkulaator. Lülita sisse need, mida tahad, ja jäta ülejäänud vahele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presse-papiers, bloc-notes, traduction, emoji, calculatrice. Active ceux que tu veux et ignore les autres."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vágólap, jegyzettömb, fordítás, emoji, számológép. Kapcsold be, amelyiket szeretnéd, a többit hagyd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appunti, blocco note, traduzione, emoji, calcolatrice. Attiva quelli che vuoi e lascia perdere il resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード、メモ帳、翻訳、絵文字、電卓。使いたいものだけオンにして、あとは飛ばせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드, 메모장, 번역, 이모지, 계산기. 원하는 것만 켜고 나머지는 건너뛰세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan keratan, pad nota, terjemah, emoji, kalkulator. Hidupkan yang anda mahu dan langkau yang lain."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Área de transferência, bloco de notas, tradução, emoji, calculadora. Liga as que quiseres e ignora as restantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер обмена, блокнот, перевод, эмодзи, калькулятор. Включите нужное, остальное пропустите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板、记事本、翻译、表情、计算器。想要哪个就开哪个，其余的跳过。"
          }
        }
      }
    },
    "Clips in this group become ungrouped.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Knipsels in hierdie groep raak ongegroepeer."
          }
        },
        "de": {
