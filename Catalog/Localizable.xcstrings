    "Light laid over the keys. Your theme's colors stay put underneath.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lig oor die sleutels gelê. Jou tema se kleure bly onder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht über den Tasten. Die Farben deines Themes bleiben darunter erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz sobre las teclas. Los colores de tu tema se mantienen debajo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgus laotatakse klahvidele. Sinu teema värvid jäävad all hoituks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une lumière posée sur les touches. Les couleurs du thème restent en dessous."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fény a gombok fölött. A téma színei alatta maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Luce sopra i tasti. I colori del tema restano sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの上に光を重ねます。テーマの色はその下に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 위에 빛을 덮습니다. 테마 색은 그 아래 그대로 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya di atas kekunci. Warna tema anda kekal di bawahnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz por cima das teclas. As cores do teu tema ficam por baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свет поверх клавиш. Цвета вашей темы остаются под ним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯光叠在按键上，主题的颜色仍留在下面。"
          }
        }
      }
    },
    "Light laid over the keys. Your theme's colours stay put underneath.": {
