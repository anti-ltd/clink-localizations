    "Deep, rounded thock of a lubed brown switch.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Diep, afgeronde knoop van 'n gesmeerde bruin skakelaar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiefer, runder Thock eines geschmierten Brown-Switches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpe grave y redondo de un interruptor marrón lubricado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sügav, ümar thock määritud brown-lülitilt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son profond et rond d'un switch brun lubrifié."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mély, kerek koppanás egy kent barna kapcsolótól."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suono profondo e rotondo di uno switch brown lubrificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "潤滑した茶軸の、深く丸いコトッという音。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윤활한 갈축의 깊고 둥근 도각 소리."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunyi thock dalam dan bulat daripada suis coklat berpelincir."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Som grave e redondo de um switch castanho lubrificado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глубокий округлый «ток» смазанного коричневого переключателя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "润滑茶轴深沉圆润的敲击声。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adanc, rotunjit al unui comutator maro lubrifiat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diepe, ronde tulp van een gesmeerde bruine schakelaar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "潤滑茶軸深沉圓潤的敲擊聲。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głęboki, zaokrąglony zatrzask nasmarowanego brązowego przełącznika."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Глибокий округлий стрижень змащеного коричневого стрижня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yağlanmış kahverengi bir anahtarın derin, yuvarlak girişi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
