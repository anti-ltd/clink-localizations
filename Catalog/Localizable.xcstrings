    "Type with the keyboard and your insights will appear here.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik met die sleutelbord en jou insigte sal hier verskyn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe mit der Tastatur und deine Einblicke erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe con el teclado y tus datos aparecerán aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipi klaviatuuriga ja sinu ülevaated ilmuvad siia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le clavier et tes données apparaîtront ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
