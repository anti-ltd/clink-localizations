    "The heavy ones do: lighting, the swipe trail, animated backgrounds. You can take them down yourself.": {
      "comment": "Android-only copy for the companion app (batch B3: FAQ, Home, Tools mode, Feedback), replacing iOS settings paths and services. Translations drafted for the Android port; native-speaker review required before release. Add to clink-index.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die swaar een doen: beligting, die veegspoor, geanimeerde agtergronde. Jy kan hulle self afskaal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ty náročné ano: osvětlení, stopa tahu, animovaná pozadí. Můžete je sami ztlumit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De tunge gør: lys, swipe-sporet, animerede baggrunde. Du kan selv skrue ned for dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aufwendigen schon: Beleuchtung, die Wischspur, animierte Hintergründe. Du kannst sie selbst zurückfahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα βαριά ναι: ο φωτισμός, το ίχνος σύρσης, τα κινούμενα φόντα. Μπορείτε να τα περιορίσετε μόνοι σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pesadas sí: la iluminación, el rastro del deslizamiento, los fondos animados. Puedes reducirlas tú mismo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasked küll: valgustus, libistamise jälg, animeeritud taustad. Saad neid ise vähendada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Raskaat kuluttavat: valaistus, pyyhkäisyjälki, animoidut taustat. Voit itse keventää niitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plus lourdes, oui : l'éclairage, la traînée du balayage, les fonds animés. Tu peux les réduire toi-même."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nehezebbek igen: a világítás, a csúsztatás nyoma, az animált hátterek. Ezeket magad is visszaveheted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang berat ya: pencahayaan, jejak geser, latar animasi. Anda bisa menguranginya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle pesanti sì: l'illuminazione, la scia dello scorrimento, gli sfondi animati. Puoi ridurle tu stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重いものは消費します。ライティング、スワイプの軌跡、アニメーション背景です。自分で控えめにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무거운 것들은 그렇습니다. 조명, 스와이프 자국, 움직이는 배경이요. 직접 줄일 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang berat, ya: pencahayaan, jejak leretan, latar beranimasi. Anda boleh mengurangkannya sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De tunge gjør det: lys, sveipesporet, animerte bakgrunner. Du kan skru dem ned selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zware wel: verlichting, het veegspoor, geanimeerde achtergronden. Je kunt ze zelf terugschroeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te ciężkie tak: podświetlenie, ślad przesuwania, animowane tła. Możesz je sam ograniczyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As pesadas sim: a iluminação, o rasto do deslize, os fundos animados. Podes reduzi-las tu mesmo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cele grele, da: iluminarea, urma glisării, fundalurile animate. Le poți reduce singur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяжёлые — да: подсветка, след свайпа, анимированные фоны. Их можно убавить самостоятельно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tie náročné áno: osvetlenie, stopa ťahu, animované pozadia. Môžete ich sami stlmiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De tunga gör det: belysning, svepspåret, animerade bakgrunder. Du kan dra ner på dem själv."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağır olanlar tüketir: aydınlatma, kaydırma izi, hareketli arka planlar. Bunları kendiniz azaltabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Важкі — так: підсвічування, слід свайпу, анімовані фони. Ви можете самі їх приглушити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những hiệu ứng nặng thì có: ánh sáng, vệt vuốt, nền động. Bạn có thể tự giảm bớt chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重的那些会：灯光、滑行轨迹、动态背景。你可以自己把它们调低。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "較耗電的效果會：燈光、滑動軌跡、動態背景。你可以自行調低它們。"
          }
        }
      }
    },
