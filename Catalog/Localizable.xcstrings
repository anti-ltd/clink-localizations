          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci gli effetti sotto carico"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "負荷が高いときはエフェクトを控えめに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부하가 걸리면 효과 줄이기"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurangkan kesan bila beban tinggi"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzir efeitos sob carga"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ослаблять эффекты под нагрузкой"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "负载高时减少特效"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduceți efectele sub sarcină"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verminder effecten onder belasting"
          }
        },
        "zh-Hant": {
