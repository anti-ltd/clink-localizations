          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan satu tangan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím tắt một tay"
          }
        }
      }
    },
    "One-time purchase. Payment charged to your Apple Account. Restore anytime from this screen.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time purchase. Betaling gehef teen jou Apple-rekening. Herstel enige tyd vanaf hierdie skerm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmaliger Kauf. Die Zahlung wird deinem Apple Account belastet. Du kannst den Kauf jederzeit auf diesem Bildschirm wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. El pago se carga a tu cuenta de Apple. Puedes restaurarlo cuando quieras desde esta pantalla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühekordne ost. Makse võetakse sinu Apple’i kontolt. Taasta igal ajal sellelt ekraanilt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achat unique. Le paiement est débité de ton compte Apple. Tu peux le restaurer à tout moment depuis cet écran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyszeri vásárlás. A fizetést az Apple-fiókodra terheljük. Erről a képernyőről bármikor visszaállíthatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisto una tantum. Il pagamento viene addebitato sul tuo Apple Account. Puoi ripristinarlo quando vuoi da questa schermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度だけの購入です。Apple Accountに請求されます。この画面からいつでも復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일회성 구매예요. Apple 계정으로 결제되며, 언제든 이 화면에서 복원할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian sekali sahaja. Bayaran dikenakan pada Akaun Apple anda. Pulihkan pada bila-bila masa daripada skrin ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. O pagamento é cobrado na tua Conta Apple. Podes restaurar a compra quando quiseres neste ecrã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разовая покупка. Оплата списывается с вашего Apple Account. Восстановить можно в любой момент с этого экрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性购买。费用将从你的 Apple 账户扣除。你可以随时在此页面恢复购买。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziție unică. Plata debitată în contul tău Apple. Restaurați oricând de pe acest ecran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenmalige aankoop. Betaling wordt in rekening gebracht op uw Apple-account. Herstel op elk gewenst moment vanaf dit scherm."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性購買。費用將從你的 Apple 賬戶扣除。你可以隨時在此頁面恢復購買。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorazowy zakup. Płatność pobrana z Twojego konta Apple. Przywróć w dowolnym momencie z tego ekranu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одноразова покупка. Оплата стягується з вашого облікового запису Apple. Відновити будь-коли з цього екрана."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kerelik satın alma. Payment charged to your Apple Account. Bu ekrandan istediğiniz zaman geri yükleyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorázový nákup. Platba naúčtovaná na váš účet Apple. Obnovit kdykoli z této obrazovky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorazový nákup. Platba naúčtovaná na váš účet Apple. Obnoviť kedykoľvek z tejto obrazovky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εφάπαξ αγορά. Η πληρωμή χρεώνεται στον λογαριασμό σας Apple. Επαναφορά ανά πάσα στιγμή από αυτήν την οθόνη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Engångsköp. Betalning debiteras ditt Apple-konto. Återställ när som helst från den här skärmen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Engangskøb. Betaling debiteres din Apple-konto. Gendan når som helst fra denne skærm."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Engangskjøp. Betaling belastet Apple-kontoen din. Gjenopprett når som helst fra denne skjermen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kertaostos. Maksu veloitetaan Apple-tililtäsi. Palauta milloin tahansa tältä näytöltä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian satu kali. Pembayaran dibebankan ke Akun Apple Anda. Pulihkan kapan saja dari layar ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mua một lần. Khoản thanh toán được tính vào Tài khoản Apple của bạn. Khôi phục bất cứ lúc nào từ màn hình này."
          }
        }
      }
    },
    "Only affects keys that switch on, like Shift.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Affekteer slegs sleutels wat aanskakel, soos Shift."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt nur für Tasten, die sich einschalten lassen, etwa Umschalt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo afecta a las teclas que se encienden, como Mayúsculas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mõjutab ainult klahve, mida saab sisse lülitada, nagu tõstuklahv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne concerne que les touches qui peuvent s’activer, comme Majuscules."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a bekapcsolható billentyűkre vonatkozik, például a Shiftre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale solo per i tasti che possono accendersi, come Maiuscole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにできるキーだけが対象です。Shift などです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜고 끌 수 있는 키에만 적용돼요. Shift 같은 키요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya melibatkan kekunci yang boleh dihidupkan, seperti Shift."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só afeta as teclas que podem acender, como Maiúsculas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действует только на клавиши-переключатели вроде Shift."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只影响可以开启的按键，比如 Shift。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afectează numai tastele care pornesc, cum ar fi Shift."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft alleen invloed op toetsen die worden ingeschakeld, zoals Shift."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隻影響可以開啟的按鍵，比如 Shift。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpływa tylko na klawisze, które się włączają, np. Shift."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Впливає лише на клавіші, які вмикаються, як-от Shift."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Shift gibi açılan tuşları etkiler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovlivňuje pouze klávesy, které se zapínají, jako je Shift."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovplyvňuje iba klávesy, ktoré sa zapínajú, napríklad Shift."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επηρεάζει μόνο τα πλήκτρα που ενεργοποιούνται, όπως το Shift."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Påverkar bara tangenter som slås på, som Shift."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Påvirker kun taster, der tænder, såsom Shift."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påvirker bare taster som slås på, som Shift."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaikuttaa vain näppäimiin, jotka kytkeytyvät päälle, kuten Shift."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya memengaruhi tombol yang aktif, seperti Shift."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ ảnh hưởng đến các phím bật, như Shift."
          }
        }
      }
    },
    "Only appears with two or more languages.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint nur bei zwei oder mehr Sprachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo aparece con dos o más idiomas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmub ainult kahe või enama keelega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'apparaît qu'avec deux langues ou plus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak két vagy több nyelvnél jelenik meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appare solo con due o più lingue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つ以上の言語があるときだけ表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어가 두 개 이상일 때만 나타납니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya muncul dengan dua bahasa atau lebih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só aparece com dois ou mais idiomas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Появляется только при двух и более языках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在有两种或以上语言时显示。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apare numai cu două sau mai multe limbi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschijnt alleen met twee of meer talen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在有兩種或以上語言時顯示。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verskyn slegs met twee of meer tale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojawia się tylko w przypadku dwóch lub więcej języków."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відображається лише з двома або більше мовами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca iki veya daha fazla dilde görünür."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje se pouze ve dvou nebo více jazycích."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje sa iba v dvoch alebo viacerých jazykoch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζεται μόνο με δύο ή περισσότερες γλώσσες."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas endast med två eller flera språk."
