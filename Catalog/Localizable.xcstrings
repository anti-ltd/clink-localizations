    "Microphone access is off for Clink. Turn it on in Settings to record.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofoontoegang is af vir Clink. Skakel dit aan in Instellings om op te neem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mikrofonzugriff ist für Clink deaktiviert. Schalte ihn in den Einstellungen ein, um aufzunehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al micrófono está desactivado para Clink. Actívalo en Ajustes para grabar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkil pole mikrofonile juurdepääsu. Lülita see seadetes sisse, et salvestada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au micro est désactivé pour Clink. Active-le dans Réglages pour enregistrer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofonhoz való hozzáférés ki van kapcsolva a Clinknél. Kapcsold be a Beállításokban, hogy felvehess."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al microfono è disattivato per Clink. Attivalo in Impostazioni per registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink のマイクへのアクセスがオフになっています。録音するには、設定でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink의 마이크 접근 권한이 꺼져 있어요. 녹음하려면 설정에서 켜 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon dimatikan untuk Clink. Hidupkan dalam Tetapan untuk merakam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone está desligado para o Clink. Liga-o nas Definições para gravares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к микрофону для Clink выключен. Включите его в Настройках, чтобы записывать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 的麦克风权限被关掉了。到设置里打开就能录音。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul la microfon este dezactivat pentru Clink. Activați-l în Configurări pentru a înregistra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfoontoegang is uitgeschakeld voor Clink. Schakel het in Instellingen in om op te nemen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 的麥克風許可權被關掉了。到設定裡開啟就能錄音。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do mikrofonu jest wyłączony w przypadku Clink. Włącz tę opcję w Ustawieniach, aby nagrywać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до мікрофона для Clink вимкнено. Увімкніть його в налаштуваннях, щоб записувати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink için mikrofon erişimi kapalı. Kaydetmek için Ayarlar'da açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup k mikrofonu je u Clink vypnutý. Chcete-li nahrávat, zapněte jej v Nastavení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prístup k mikrofónu je pre Clink vypnutý. Ak chcete nahrávať, zapnite ho v Nastaveniach."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσβαση στο μικρόφωνο είναι απενεργοποιημένη για το Clink. Ενεργοποιήστε το στις Ρυθμίσεις για εγγραφή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonåtkomst är avstängd för Clink. Slå på den i Inställningar för att spela in."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonadgang er slået fra for Clink. Slå det til i Indstillinger for at optage."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofontilgang er av for Clink. Slå den på i Innstillinger for å ta opp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonin käyttö on pois päältä mallissa Clink. Ota se käyttöön asetuksista tallentaaksesi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon dinonaktifkan untuk Clink. Aktifkan di Pengaturan untuk merekam."
          }
        },
        "vi": {
