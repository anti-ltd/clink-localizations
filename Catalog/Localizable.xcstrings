    "Camera scanning is unavailable. Import a QR image from Photos instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera scanning is unavailable. Import a QR image from Photos instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede escanear con la cámara. Importa una imagen QR desde Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scan avec la caméra est indisponible. Importe une image de code QR depuis Photos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Scannen mit der Kamera ist nicht verfügbar. Importiere ein QR-Bild aus Fotos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scansione con la fotocamera non è disponibile. Importa un’immagine QR da Foto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível ler códigos com a câmara. Importa uma imagem QR da app Fotografias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование камерой недоступно. Импортируйте изображение QR-кода из приложения «Фото»."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imbasan kamera tidak tersedia. Import imej QR daripada Foto."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kamerás beolvasás nem érhető el. Importálj egy QR-kódot tartalmazó képet a Fotókból."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラでスキャンできません。「写真」からQRコードの画像を読み込んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用相机扫描。请从“照片”导入二维码图片。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라로 스캔할 수 없습니다. 사진 앱에서 QR 코드 이미지를 가져오세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaameraga skannimine pole saadaval. Impordi QR-koodi pilt rakendusest Fotod."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanarea camerei nu este disponibilă. Importați o imagine QR din Fotografii."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Camerascannen is niet beschikbaar. Importeer in plaats daarvan een QR-afbeelding uit Foto's."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用相機掃描。請從“照片”匯入二維碼圖片。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera-skandering is nie beskikbaar nie. Importeer eerder 'n QR-beeld vanaf Foto's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanowanie aparatem jest niedostępne. Zamiast tego zaimportuj obraz QR ze Zdjęć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканування камерою недоступне. Натомість імпортуйте QR-зображення з Фото."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera taraması kullanılamıyor. Bunun yerine Fotoğraflar'dan bir QR görüntüsünü içe aktarın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenování fotoaparátem není k dispozici. Místo toho importujte obrázek QR z Fotek."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenovanie fotoaparátom nie je k dispozícii. Namiesto toho importujte obrázok QR z Fotiek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σάρωση κάμερας δεν είναι διαθέσιμη. Αντ' αυτού, εισάγετε μια εικόνα QR από τις Φωτογραφίες."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraskanning är inte tillgänglig. Importera en QR-bild från Foton istället."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerascanning er ikke tilgængelig. Importer i stedet et QR-billede fra Fotos."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraskanning er utilgjengelig. Importer et QR-bilde fra Bilder i stedet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraskannaus ei ole käytettävissä. Tuo sen sijaan QR-kuva Kuvista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemindaian kamera tidak tersedia. Impor gambar QR dari Foto saja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng quét máy ảnh không khả dụng. Thay vào đó, hãy nhập hình ảnh QR từ Ảnh."
          }
        }
      }
    },
