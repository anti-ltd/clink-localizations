    "Type a few words, then open AI to rewrite, proofread, or change the tone.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik 'n paar woorde en maak dan KI oop om te herskryf, proeflees of die toon te verander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp ein paar Wörter, dann öffne die KI, um sie umzuschreiben, zu prüfen oder den Ton zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe unas palabras y abre la IA para reescribir, corregir o cambiar el tono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipi mõned sõnad ja ava TI, et ümber kirjutada, üle lugeda või tooni muuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tape quelques mots, puis ouvre l'IA pour réécrire, relire ou changer le ton."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írj be pár szót, aztán nyisd meg az MI-t átíráshoz, lektoráláshoz vagy a hangnem módosításához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi qualche parola, poi apri l'IA per riscrivere, correggere o cambiare tono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何か少し打ってから AI を開くと、書き直し、校正、トーン変更ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 마디 입력한 다음 AI를 열어서 다시 쓰거나, 교정하거나, 말투를 바꿔보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip beberapa perkataan, kemudian buka AI untuk tulis semula, semak atau tukar nada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve umas palavras e abre a IA para reescrever, rever ou mudar o tom."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напечатайте несколько слов, а затем откройте ИИ, чтобы переписать текст, проверить его или сменить тон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先打几个字，再打开 AI 来改写、校对或换个语气。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastați câteva cuvinte, apoi deschideți AI pentru a rescrie, a corecta sau a schimba tonul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ een paar woorden en open vervolgens AI om te herschrijven, proeflezen of de toon te veranderen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先打幾個字，再開啟 AI 來改寫、校對或換個語氣。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz kilka słów, a następnie otwórz sztuczną inteligencję, aby przepisać, sprawdzić lub zmienić ton."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть кілька слів, а потім відкрийте AI, щоб переписати, перевірити або змінити тон."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç kelime yazın, ardından yeniden yazmak, düzeltmeler yapmak veya tonu değiştirmek için AI'yı açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napište pár slov a poté otevřete AI, abyste mohli přepsat, zkontrolovat nebo změnit tón."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíšte pár slov a potom otvorte AI na prepísanie, korektúru alebo zmenu tónu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολογήστε μερικές λέξεις και, στη συνέχεια, ανοίξτε το AI για να ξαναγράψετε, να διορθώσετε ή να αλλάξετε τον τόνο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv några ord och öppna sedan AI för att skriva om, korrekturläsa eller ändra tonen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv et par ord, og åbn derefter AI for at omskrive, korrekturlæse eller ændre tonen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn noen få ord, og åpne deretter AI for å skrive om, korrekturlese eller endre tonen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita muutama sana ja avaa tekoäly kirjoittaaksesi uudelleen, oikolukeaksesi tai muuttaaksesi sävyä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik beberapa kata, lalu buka AI untuk menulis ulang, mengoreksi, atau mengubah nada."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập một vài từ, sau đó mở AI để viết lại, hiệu đính hoặc thay đổi giọng điệu."
          }
        }
      }
    },
