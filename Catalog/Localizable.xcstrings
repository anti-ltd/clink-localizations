    "Save your current setup as a profile and it shows up in the keyboard's switcher.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher dein aktuelles Setup als Profil, dann taucht es im Wechsler auf der Tastatur auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tu configuración actual como perfil y aparecerá en el teclado."
          }
        },
        "fr": {
