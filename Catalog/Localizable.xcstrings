    "Optional · turn it on in Settings to use custom feedback.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsioneel · skakel dit in Instellings aan om gepasmaakte terugvoer te gebruik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional · aktiviere es in den Einstellungen für eigenes Feedback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional · actívalo en Ajustes para usar respuesta personalizada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valikuline · kohandatud tagasiside jaoks lülita see seadetes sisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif · activez-le dans Réglages pour utiliser des retours personnalisés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionális · az egyéni visszajelzéshez kapcsold be a Beállításokban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo · attivalo in Impostazioni per usare feedback personalizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意・カスタムフィードバックを使うには「設定」でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항 · 사용자화 피드백을 사용하려면 설정에서 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan · hidupkan dalam Tetapan untuk menggunakan maklum balas tersuai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional · ativa nas Definições para usar resposta personalizada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно · включите в Настройках для пользовательской отдачи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选 · 在“设置”中开启，即可使用自定义反馈。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțional · activați-l în Configurări pentru a utiliza feedback personalizat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel · schakel dit in Instellingen in om aangepaste feedback te gebruiken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選 · 在“設定”中開啟，即可使用自定義反饋。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalnie · włącz tę opcję w Ustawieniach, aby korzystać z niestandardowych informacji zwrotnych."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов’язково · увімкніть це в налаштуваннях, щоб використовувати власні відгуки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı · Özel geri bildirimi kullanmak için bunu Ayarlar'da açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volitelné · zapněte jej v Nastavení, abyste mohli používat vlastní zpětnou vazbu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Voliteľné · Ak chcete používať vlastnú spätnú väzbu, zapnite ju v Nastaveniach."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προαιρετικό · ενεργοποιήστε το στις Ρυθμίσεις για να χρησιμοποιήσετε προσαρμοσμένα σχόλια."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfritt · aktivera den i Inställningar för att använda anpassad feedback."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfrit · slå det til i Indstillinger for at bruge tilpasset feedback."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt · slå den på i Innstillinger for å bruke tilpasset tilbakemelding."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinnainen · ota se käyttöön asetuksista, jos haluat käyttää mukautettua palautetta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional · aktifkan di Pengaturan untuk menggunakan umpan balik khusus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn · bật tính năng này trong Cài đặt để sử dụng phản hồi tùy chỉnh."
          }
        }
      }
    },
    "Optional. iOS only allows haptics and pasteboard reads when Full Access is on.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsioneel. iOS laat slegs haptiese en plakbordlees toe wanneer Volle Toegang aan is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. iOS erlaubt Haptik und Zugriff auf die Zwischenablage nur mit Vollzugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. iOS solo permite vibración y leer el portapapeles con el acceso completo activado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valikuline. iOS lubab haptikat ja lõikelaua lugemist ainult siis, kui täisjuurdepääs on sees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. iOS n'autorise les vibrations et la lecture du presse-papiers qu'avec l'accès complet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem kötelező. Az iOS csak teljes hozzáféréssel enged rezgést és vágólap-olvasást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. iOS permette vibrazioni e lettura degli appunti solo con l'accesso completo attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使うかどうかは自由です。iOS では、フルアクセスがオンのときだけ触覚とペーストボードの読み取りができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택이에요. iOS는 전체 접근을 켰을 때만 햅틱과 클립보드 읽기를 허용해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan. iOS cuma benarkan haptik dan bacaan papan keratan apabila Akses Penuh dihidupkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. O iOS só permite háptica e leitura da área de transferência com o acesso total ligado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не обязательно. iOS разрешает тактильную отдачу и чтение буфера обмена только при включённом полном доступе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。iOS 只有在开了完全访问时才允许触觉反馈和读取剪贴板。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțional. iOS permite răspunsul haptic și citirea clipboardului doar când accesul complet este activat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel. iOS staat alleen haptische en plakbordlezen toe als Volledige toegang is ingeschakeld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選。iOS 只有在開了完整取用時才允許觸覺反饋和讀取剪貼簿。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. iOS umożliwia odczyt dotykowy i ekranowy tylko wtedy, gdy włączony jest pełny dostęp."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додатково. iOS дозволяє тактильні зчитування та читання з картону, лише коли ввімкнено повний доступ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. iOS yalnızca Tam Erişim açıkken dokunsal ve çalışma alanı okumalarına izin verir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volitelné. iOS umožňuje pouze haptické čtení a čtení na ploše, když je zapnutý Úplný přístup."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Voliteľné. iOS umožňuje iba hmatové čítanie a čítanie na ploche, keď je zapnutý Úplný prístup."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προαιρετικό. Το iOS επιτρέπει μόνο αναγνώσεις απτικών και χαρτονιού όταν είναι ενεργοποιημένη η Full Access."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfritt. iOS tillåter endast haptik och läser av pasteboard när Full Access är på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfrit. iOS tillader kun haptik og plakataflæsning, når fuld adgang er slået til."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt. iOS tillater kun haptics og pasteboard-lesing når Full Access er på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinnainen. iOS sallii vain haptic- ja pahvilukemisen, kun Full Access on käytössä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional. iOS hanya mengizinkan pembacaan haptik dan pasteboard saat Akses Penuh aktif."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bắt buộc. iOS chỉ cho phép đọc xúc giác và bảng dán khi bật Toàn quyền truy cập."
          }
        }
      }
    },
