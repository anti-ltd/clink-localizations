    "Drawn on the real keyboard in other apps, so you can see where taps land.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auf der echten Tastatur in anderen Apps gezeichnet, damit du siehst, wo Tipper landen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se dibuja sobre el teclado real en otras apps, para que veas dónde caen tus toques."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Joonistatakse päris klaviatuurile teistes rakendustes, et näeksid, kuhu puudutused langevad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessiné sur le vrai clavier dans les autres apps, pour voir où tombent vos frappes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A valódi billentyűzetre rajzolódik más appokban, így látod, hová esnek az érintések."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegnato sulla tastiera reale nelle altre app, così vedi dove arrivano i tocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のアプリの実際のキーボード上に描かれ、タップがどこに当たるかがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱의 실제 키보드 위에 그려져 탭이 어디에 닿는지 볼 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilukis pada papan kekunci sebenar dalam apl lain, supaya anda nampak di mana ketikan jatuh."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhado no teclado real em outros apps, para você ver onde os toques caem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисуется на настоящей клавиатуре в других приложениях, чтобы было видно, куда попадают нажатия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘制在其他 App 中的真实键盘上，让你看到点按落在哪里。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenat pe tastatura reală în alte aplicații, astfel încât să puteți vedea unde aterizează robinetele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Getekend op het echte toetsenbord in andere apps, zodat je kunt zien waar tikken terechtkomen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繪製在其他 App 中的真實鍵盤上，讓你看到點按落在哪裡。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geteken op die regte sleutelbord in ander toepassings, sodat jy kan sien waar tik plaasvind."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rysowane na prawdziwej klawiaturze w innych aplikacjach, dzięki czemu możesz zobaczyć, gdzie trafiają dotknięcia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Намальовано на справжній клавіатурі в інших програмах, тож ви можете бачити, куди потрапляють дотики."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer uygulamalardaki gerçek klavyede çizilmiştir, böylece dokunuşların nereye indiğini görebilirsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakresleno na skutečné klávesnici v jiných aplikacích, takže můžete vidět, kde dopadají kohoutky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakreslené na skutočnej klávesnici v iných aplikáciách, takže môžete vidieť, kde dopadajú klepnutia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδιασμένο στο πραγματικό πληκτρολόγιο σε άλλες εφαρμογές, ώστε να μπορείτε να δείτε πού προσγειώνονται τα χτυπήματα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritat på det riktiga tangentbordet i andra appar, så att du kan se var kranarna landar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegnet på det rigtige tastatur i andre apps, så du kan se, hvor haner lander."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegnet på det ekte tastaturet i andre apper, slik at du kan se hvor trykk lander."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirretty todelliselle näppäimistölle muissa sovelluksissa, jotta näet, mihin hanat laskeutuvat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digambar pada keyboard sebenarnya di aplikasi lain, sehingga Anda dapat melihat di mana ketukan mendarat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được vẽ trên bàn phím thực trong các ứng dụng khác, do đó bạn có thể biết vị trí chạm."
          }
        }
      }
    },
    "Draws the theme background color or photo behind the keys.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken die tema agtergrondkleur of foto agter die sleutels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Hintergrundfarbe oder das Foto des Themes hinter den Tasten an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja detrás de las teclas el color o la foto de fondo del tema."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvab teema taustavärvi või foto klahvide taga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche la couleur ou la photo de fond du thème derrière les touches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk mögé rajzolja a téma háttérszínét vagy fényképét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna dietro i tasti il colore di sfondo del tema o la foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマの背景色や写真を、キーの後ろに表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마 배경 색이나 사진을 키 뒤에 그려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukis warna latar tema atau foto di belakang kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra a cor ou a foto de fundo do tema por trás das teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисует за клавишами фоновый цвет или фото темы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在按键后面显示主题的背景颜色或照片。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenează culoarea de fundal a temei sau fotografia în spatele tastelor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekent de achtergrondkleur of foto van het thema achter de toetsen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在按鍵後面顯示主題的背景顏色或照片。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rysuje kolor tła motywu lub zdjęcie za klawiszami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Малює фоновий колір теми або фотографію за клавішами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşların arkasına temanın arka plan rengini veya fotoğrafını çizer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakreslí barvu pozadí motivu nebo fotografii za klávesy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakreslí farbu pozadia motívu alebo fotografiu za klávesy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδιάζει το χρώμα φόντου του θέματος ή τη φωτογραφία πίσω από τα πλήκτρα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritar temat bakgrundsfärg eller foto bakom tangenterna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegner temaets baggrundsfarve eller foto bag tasterne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegner temaets bakgrunnsfarge eller bilde bak tastene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirtää teeman taustavärin tai valokuvan näppäinten taakse."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggambar warna latar belakang tema atau foto di balik tombol."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẽ màu nền của chủ đề hoặc ảnh đằng sau các phím."
          }
        }
      }
    },
