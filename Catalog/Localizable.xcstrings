    "Open Keys, turn on One-handed mode, and pick a side.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maak sleutels oop, skakel eenhandmodus aan en kies 'n kant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne „Tasten“, schalte den Einhandmodus ein und wähle eine Seite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Teclas, activa el Modo a una mano y elige un lado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava Klahvid, lülita sisse Ühekäeline režiim ja vali pool."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Touches, active le Mode à une main et choisis un côté."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Billentyűket, kapcsold be az Egykezes módot, és válassz oldalt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Tasti, attiva la Modalità a una mano e scegli un lato."
          }
