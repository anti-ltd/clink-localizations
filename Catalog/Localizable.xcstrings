    "Run a different action while the key is held, e.g. tap 🙂 for emoji, hold for 123.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer 'n ander aksie uit terwyl die sleutel vasgehou word, bv. tik 🙂 vir emoji's, hou vir 123."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt eine andere Aktion aus, während die Taste gehalten wird, z. B. 🙂 tippen für Emoji, halten für 123."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta una acción distinta mientras mantienes pulsada la tecla; por ejemplo, toca 🙂 para emoji, mantén para 123."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Käivita teine tegevus, kui klahvi hoitakse, nt. puuduta 🙂 emoji jaoks, hoia 123 jaoks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance une action différente quand la touche est maintenue, par ex. touche 🙂 pour les emoji, maintiens pour 123."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Más műveletet futtat, amíg a billentyűt nyomva tartod, pl. koppints 🙂-re az emojiért, tartsd nyomva a 123-ért."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui un'azione diversa mentre il tasto è premuto, ad es. tocca 🙂 per l'emoji, tieni premuto per 123."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを長押ししているあいだ、別のアクションを実行します。例: 🙂 をタップで絵文字、長押しで 123。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누르고 있는 동안 다른 동작을 실행해요. 예: 🙂을 탭하면 이모지, 길게 누르면 123."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan tindakan berbeza semasa kekunci ditahan, cth. ketik 🙂 untuk emoji, tahan untuk 123."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa uma ação diferente enquanto a tecla é mantida premida, ex.: toca 🙂 para emoji, mantém premido para 123."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполнять другое действие при удержании клавиши — например, нажатие 🙂 даёт эмодзи, удержание — 123."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键被长按时执行另一个操作，比如点 🙂 打表情，长按打 123。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Efectuați o acțiune diferită în timp ce tasta este apăsată, de ex. atingeți 🙂 pentru emoji, țineți apăsat timp de 123."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een andere actie uit terwijl de toets ingedrukt wordt gehouden, b.v. tik op 🙂 voor emoji, houd vast voor 123."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鍵被長按時執行另一個操作，比如點 🙂 打表情，長按打 123。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj klawisz i wykonaj inną akcję, np. dotknij 🙂, aby wyświetlić emoji, przytrzymaj przez 123."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконайте іншу дію, утримуючи клавішу, напр. торкніться 🙂 для емодзі, утримуйте для 123."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuş basılı tutulduğunda farklı bir eylem gerçekleştirin, ör. Emoji için 🙂'ye dokunun, 123'e kadar basılı tutun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při držení klávesy spusťte jinou akci, např. klepnutím 🙂 pro emoji podržte 123."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počas držania klávesu spustite inú akciu, napr. ťuknite 🙂 ak chcete emoji, podržte na 123."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτελέστε μια διαφορετική ενέργεια ενώ κρατάτε το κλειδί, π.χ. πατήστε 🙂 για emoji, κρατήστε πατημένο το 123."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kör en annan åtgärd medan nyckeln hålls nedtryckt, t.ex. tryck på 🙂 för emoji, håll i 123."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kør en anden handling, mens tasten holdes nede, f.eks. tryk på 🙂 for emoji, hold nede i 123."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjør en annen handling mens tasten holdes nede, f.eks. trykk på 🙂 for emoji, hold inne for 123."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suorita eri toiminto, kun näppäintä pidetään painettuna, esim. napauta 🙂 nähdäksesi emoji, pidä painettuna 123."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan tindakan berbeda saat kunci ditahan, mis. ketuk 🙂 untuk emoji, tahan hingga 123."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy một hành động khác trong khi phím được giữ, ví dụ: nhấn 🙂 để có biểu tượng cảm xúc, giữ trong 123."
          }
        }
      }
