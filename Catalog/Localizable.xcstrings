    "Record typing stats. Off by default; you can turn it back on anytime.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken tikstatistieke op. Af by verstek; jy kan dit enige tyd weer aanskakel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp-Statistiken aufzeichnen. Standardmäßig aus; du kannst es jederzeit wieder einschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra estadísticas de escritura. Desactivado por defecto; puedes volver a activarlo cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvesta tipimisstatistikat. Vaikimisi väljas; sa võid igal ajal tagasi sisse lülitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre les statistiques de frappe. Désactivé par défaut ; tu peux le réactiver à tout moment."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzíti a gépelési statisztikákat. Alapértelmezetten ki van kapcsolva; bármikor visszakapcsolhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra le statistiche di digitazione. Disattivato di default; puoi riattivarlo quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力統計を記録します。デフォルトではオフですが、いつでもオンに戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이핑 통계를 기록해요. 기본값은 꺼짐이고, 언제든 다시 켤 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod statistik menaip. Dimatikan secara lalai; anda boleh hidupkannya semula bila-bila masa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Regista estatísticas de escrita. Desligado por predefinição; podes voltar a ligar quando quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывать статистику печати. По умолчанию выключено, включить можно в любой момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录打字统计数据。默认关闭，随时可以重新打开。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrați statisticile de tastare. Oprit implicit; îl poți reporni oricând."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreer typestatistieken. Standaard uitgeschakeld; Je kunt het op elk gewenst moment weer inschakelen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄打字統計資料。預設關閉，隨時可以重新開啟。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejestruj statystyki pisania. Domyślnie wyłączone; możesz go ponownie włączyć w dowolnym momencie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записуйте статистику набору тексту. Вимкнено за замовчуванням; ви можете будь-коли ввімкнути його знову."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazma istatistiklerini kaydedin. Varsayılan olarak kapalı; istediğiniz zaman tekrar açabilirsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenávejte statistiky psaní. Ve výchozím nastavení vypnuto; můžete jej kdykoli znovu zapnout."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenajte štatistiky písania. Predvolene vypnuté; môžete ho kedykoľvek znova zapnúť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταγράψτε στατιστικά στοιχεία πληκτρολόγησης. Απενεργοποίηση από προεπιλογή. μπορείτε να το ενεργοποιήσετε ξανά ανά πάσα στιγμή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela in skrivstatistik. Av som standard; du kan slå på den igen när som helst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optag skrivestatistik. Fra som standard; du kan tænde den igen når som helst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta opp skrivestatistikk. Av som standard; du kan slå den på igjen når som helst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna kirjoitustilastot. Oletuksena pois päältä; voit kytkeä sen takaisin päälle milloin tahansa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam statistik pengetikan. Mati secara default; Anda dapat menyalakannya kembali kapan saja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại số liệu thống kê đánh máy. Tắt theo mặc định; bạn có thể bật lại bất cứ lúc nào."
          }
        }
      }
    },
    "Record where your taps land on each key, per layout & language, to shape the keyboard to you": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken aan waar jou krane op elke sleutel land, per uitleg en taal, om die sleutelbord vir jou te vorm"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasst, wo deine Tipps auf jeder Taste landen, pro Layout & Sprache, um die Tastatur auf dich anzupassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra dónde caen tus toques en cada tecla, por disposición e idioma, para moldear el teclado a tu medida"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvestab, kuhu sinu vajutused igal klahvil maanduvad, paigutuse ja keele kaupa, et klaviatuur sinuga kohanduks"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre où tes appuis atterrissent sur chaque touche, par disposition et langue, pour adapter le clavier à toi"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzíti, hova esnek a koppintásaid az egyes billentyűkön, elrendezésenként és nyelvenként, hogy hozzád formálja a billentyűzetet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra dove atterrano i tuoi tocchi su ogni tasto, per layout e lingua, per modellare la tastiera su di te"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーでタップがどこに着地するかを、レイアウトと言語ごとに記録して、キーボードをあなたに合わせます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이아웃과 언어별로 각 키에서 탭이 어디에 닿는지 기록해서 키보드를 나에게 맞춰요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod di mana ketikan anda mendarat pada setiap kekunci, ikut susun atur & bahasa, untuk bentukkan papan kekunci mengikut anda"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Regista onde os teus toques caem em cada tecla, por esquema e idioma, para moldar o teclado a ti"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывать, куда попадают ваши нажатия на каждой клавише, отдельно по раскладкам и языкам, чтобы подстроить клавиатуру под вас"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录你在每个键上的落点，按布局和语言分别记，把键盘塑造成适合你的"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrați unde aterizează atingerile dvs. pe fiecare tastă, în funcție de aspect și limbă, pentru a vă modela tastatura"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreer waar uw tikken op elke toets terechtkomen, per lay-out en taal, om het toetsenbord naar uw wensen vorm te geven"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄你在每個鍵上的落點，按佈局和語言分別記，把鍵盤塑造成適合你的"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejestruj miejsca, w których dotykasz każdego klawisza, według układu i języka, aby dostosować klawiaturę do swoich potrzeb"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записуйте місця натискання кожної клавіші за розкладкою та мовою, щоб налаштувати клавіатуру під себе"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyeyi kendinize göre şekillendirmek için, düzene ve dile göre dokunuşlarınızın her tuşun üzerinde nereye geldiğini kaydedin"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenejte, kde se vaše klepnutí dotkne jednotlivých kláves, podle rozvržení a jazyka, aby se vám klávesnice přizpůsobila"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenajte si, kde sa vaše klepnutia dostanú na jednotlivé klávesy, podľa rozloženia a jazyka, aby ste si mohli prispôsobiť klávesnicu"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταγράψτε πού προσγειώνονται τα χτυπήματά σας σε κάθε πλήκτρο, ανά διάταξη και γλώσσα, για να διαμορφώσετε το πληκτρολόγιο για εσάς"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela in var dina tryck landar på varje tangent, per layout och språk, för att forma tangentbordet efter dig"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optag, hvor dine tryk lander på hver tast, pr. layout og sprog, for at forme tastaturet til dig"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer hvor trykkene dine lander på hver tast, per layout og språk, for å forme tastaturet til deg"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muokkaa näppäimistöä itsellesi sopivaksi kirjaamalla, missä napauksesi osuvat kussakin näppäimessä, asettelun ja kielen mukaan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat lokasi ketukan Anda pada setiap tombol, per tata letak & bahasa, untuk membentuk keyboard sesuai keinginan Anda"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại vị trí bạn nhấn vào từng phím, theo bố cục và ngôn ngữ, để định hình bàn phím cho phù hợp với bạn"
          }
        }
      }
    },
