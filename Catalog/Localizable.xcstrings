    "Typing stays on your device. Optional cloud AI sends the text you choose to your provider.": {
      "comment": "Android setup privacy note. Cloud translation is optional and requires a saved provider, API key and explicit consent.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikwerk bly op jou toestel. Opsionele wolk-KI stuur die teks wat jy kies na jou verskaffer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co píšete, zůstává ve vašem zařízení. Volitelná cloudová AI odesílá vybraný text vašemu poskytovateli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, du skriver, bliver på din enhed. Valgfri AI i skyen sender den tekst, du vælger, til din udbyder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du tippst, bleibt auf deinem Gerät. Wenn du Cloud-KI nutzt, wird der von dir ausgewählte Text an deinen Anbieter gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσα πληκτρολογείτε παραμένουν στη συσκευή σας. Αν επιλέξετε τεχνητή νοημοσύνη στο cloud, το κείμενο που διαλέγετε αποστέλλεται στον πάροχό σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que escribes se queda en tu dispositivo. Si usas la IA en la nube, el texto que elijas se enviará a tu proveedor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisestatud tekst jääb sinu seadmesse. Valikuline pilvepõhine tehisintellekt saadab sinu valitud teksti sinu teenusepakkujale."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoittamasi teksti pysyy laitteellasi. Jos otat pilvitekoälyn käyttöön, valitsemasi teksti lähetetään palveluntarjoajallesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tu tapes reste sur ton appareil. Si tu utilises l’IA dans le cloud, le texte que tu choisis est envoyé à ton fournisseur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amit beírsz, az az eszközödön marad. Ha bekapcsolod a felhőalapú MI-t, az általad kiválasztott szöveg a szolgáltatódhoz kerül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang Anda ketik tetap di perangkat. Jika Anda menggunakan AI cloud, teks yang Anda pilih dikirim ke penyedia Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che scrivi resta sul tuo dispositivo. Se usi l’IA nel cloud, il testo che scegli viene inviato al tuo fornitore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力した内容はデバイス内に留まります。クラウドAIを利用する場合は、選んだテキストがプロバイダに送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력한 내용은 기기에만 저장돼요. 클라우드 AI를 선택해 사용하면 선택한 텍스트가 제공자에게 전송돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang anda taip kekal pada peranti anda. Jika anda menggunakan AI awan, teks yang anda pilih dihantar kepada pembekal anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du skriver, blir på enheten din. Hvis du velger å bruke KI i skyen, sendes teksten du velger, til leverandøren din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je typt, blijft op je apparaat. Als je cloud-AI gebruikt, wordt de tekst die je kiest naar je aanbieder gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co piszesz, pozostaje na urządzeniu. Jeśli włączysz AI w chmurze, wybrany przez Ciebie tekst zostanie wysłany do Twojego dostawcy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que escreves fica no teu dispositivo. Se usares IA na nuvem, o texto que escolheres será enviado ao teu fornecedor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceea ce tastezi rămâne pe dispozitivul tău. Dacă alegi să folosești AI în cloud, textul selectat este trimis furnizorului tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что вы вводите, остаётся на устройстве. Если вы включите облачный ИИ, выбранный вами текст будет отправлен вашему провайдеру."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "To, čo píšete, zostáva vo vašom zariadení. Ak zapnete cloudovú AI, vybraný text sa odošle vášmu poskytovateľovi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du skriver stannar på din enhet. Om du väljer att använda AI i molnet skickas den text du väljer till din leverantör."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazdıklarınız cihazınızda kalır. İsteğe bağlı bulut yapay zekâsını kullanırsanız seçtiğiniz metin sağlayıcınıza gönderilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе, що ви вводите, залишається на пристрої. Якщо ви ввімкнете хмарний ШІ, вибраний вами текст буде надіслано вашому постачальнику."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung bạn gõ được giữ trên thiết bị. Nếu dùng AI đám mây, văn bản bạn chọn sẽ được gửi đến nhà cung cấp của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你输入的内容保留在设备上。如果选择使用云端 AI，你选中的文本会发送给你的提供商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你輸入的內容會保留在裝置上。如果選擇使用雲端 AI，你選取的文字會傳送給你的供應商。"
          }
        }
      }
    },
