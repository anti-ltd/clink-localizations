            "value": "Un'onda di colore attraversa i tasti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma onda de cor atravessa as teclas."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelombang warna bergerak melintasi kekunci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Színhullám fut végig a gombokon."
          }
        },
        "ja": {
