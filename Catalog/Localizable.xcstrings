    "Smoothing tidies the traced outline. Keep it low to hold on to the wobble of your own hand.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El suavizado ordena el contorno trazado. Mantenlo bajo para conservar el temblor de tu propia mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lissage régularise le contour. Garde une valeur faible pour préserver les irrégularités naturelles de ton tracé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Glättung räumt die erzeugte Kontur auf. Niedrig halten, um das Zittern deiner Hand zu bewahren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ammorbidimento ripulisce il contorno ricavato. Tienilo basso per conservare il tremolio della tua mano."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A suavização limpa o contorno traçado. Mantenha-a baixa para preservar o tremor da sua própria mão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сглаживание упорядочивает полученный контур. Оставьте его слабым, чтобы сохранить дрожь вашей руки."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelicinan mengemas garis luar yang dihasilkan. Kekalkan rendah untuk mengekalkan getaran tangan anda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A simítás rendezi a kapott körvonalat. Tartsd alacsonyan, hogy megmaradjon a saját kezed remegése."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スムージングは生成された輪郭を整えます。手の揺らぎを残したいときは低めにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑会整理描摹出的轮廓。想保留手绘的自然抖动就调低一些。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다듬기는 추출된 윤곽을 정리합니다. 손의 떨림을 남기려면 낮게 유지하세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Silumine korrastab saadud kontuuri. Hoia see madal, et säilitada oma käe värin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Netezirea ordonează conturul trasat. Ține-l jos pentru a te ține de clătinarea propriei mâini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met vloeiend maken wordt de overgetrokken omtrek opgeruimd. Houd het laag om het wiebelen van uw eigen hand vast te houden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑會整理描摹出的輪廓。想保留手繪的自然抖動就調低一些。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gladmaak verfyn die getekende buitelyn. Hou dit laag om die bewing van jou eie hand te behou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygładzanie porządkuje narysowany kontur. Trzymaj go nisko, aby utrzymać drżenie własnej ręki."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Згладжування впорядковує промальований контур. Тримайте його низько, щоб утримати коливання власної руки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pürüzsüzleştirme, izlenen taslağı düzenler. Kendi elinizin yalpalamasına tutunabilmek için alçakta tutun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhlazování uklidí nakreslený obrys. Udržujte jej nízko, abyste se drželi kolísání vlastní ruky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhladzovanie upratuje načrtnutý obrys. Udržujte ho nízko, aby ste sa držali kolísania vlastnej ruky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εξομάλυνση τακτοποιεί το διαγραμμένο περίγραμμα. Κρατήστε το χαμηλά για να κρατηθείτε από την ταλάντευση του χεριού σας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utjämning städar den spårade konturen. Håll den låg för att hålla fast vid din egen hands vinkling."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udjævning ordner det sporede omrids. Hold det lavt for at holde fast i din egen hånds vaklen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utjevning rydder den sporede omrisset. Hold det lavt for å holde på vinglingen fra din egen hånd."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasoitus siistii piirrettyjä ääriviivoja. Pidä se matalalla pitääksesi kiinni oman kätesi huojunnasta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghalusan merapikan garis luar yang dijiplak. Jaga agar tetap rendah untuk menahan goyangan tangan Anda sendiri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm mịn đường viền được vạch ra. Giữ nó ở mức thấp để giữ vững bàn tay chao đảo của chính bạn."
          }
        }
      }
    },
