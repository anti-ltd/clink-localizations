    "Pick ABC, 123 or #+= on the Keys tab. All keys and rows are arranged directly in the live preview.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies ABC, 123 of #+= op die Sleutels-oortjie. Alle sleutels en rye word direk in die regstreekse voorskou gerangskik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl ABC, 123 oder #+= im Tab „Tasten“. Alle Tasten und Reihen ordnest du direkt in der Live-Vorschau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige ABC, 123 o #+= en la pestaña Teclas. Todas las teclas y filas se organizan en la vista previa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali kaardil Klahvid ABC, 123 või #+=. Kõik klahvid ja read paigutatakse otse reaalaja eelvaates."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis ABC, 123 ou #+= dans l'onglet Touches. Touches et rangées s'agencent directement dans l'aperçu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd az ABC, 123 vagy #+= lapot a Billentyűk fülön. A billentyűket és sorokat az élő előnézetben rendezed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli ABC, 123 o #+= nella scheda Tasti. Tasti e righe si sistemano direttamente nell'anteprima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キー」タブで ABC・123・#+= を選びます。キーと行はライブプレビューで直接並べ替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘키’ 탭에서 ABC, 123, #+= 를 고르세요. 키와 행은 실시간 미리보기에서 바로 배치합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih ABC, 123 atau #+= pada tab Kekunci. Semua kekunci dan baris disusun terus dalam pratonton langsung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe ABC, 123 ou #+= no separador Teclas. Todas as teclas e linhas são organizadas na pré-visualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите ABC, 123 или #+= на вкладке «Клавиши». Все клавиши и ряды расставляются прямо в живом предпросмотре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「按键」标签里选 ABC、123 或 #+=。所有按键和行都直接在实时预览里排布。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți ABC, 123 sau #+= din fila Chei. Toate tastele și rândurile sunt aranjate direct în previzualizarea live."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies ABC, 123 of #+= op het tabblad Sleutels. Alle toetsen en rijen worden direct in de live preview gerangschikt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「按鍵」標籤裡選 ABC、123 或 #+=。所有按鍵和行都直接在實時預覽裡排布。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz ABC, 123 lub #+= na karcie Klucze. Wszystkie klawisze i wiersze są rozmieszczone bezpośrednio w podglądzie na żywo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть ABC, 123 або #+= на вкладці «Клавіші». Усі клавіші та рядки впорядковуються безпосередньо в попередньому перегляді."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşlar sekmesinde ABC, 123 veya #+= seçeneğini seçin. Tüm tuşlar ve satırlar doğrudan canlı önizlemede düzenlenir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na kartě Klávesy vyberte ABC, 123 nebo #+=. Všechny klávesy a řádky jsou uspořádány přímo v živém náhledu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na karte Klávesy vyberte ABC, 123 alebo #+=. Všetky klávesy a riadky sú usporiadané priamo v živom náhľade."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ABC, 123 ή #+= στην καρτέλα Πλήκτρα. Όλα τα πλήκτρα και οι σειρές ταξινομούνται απευθείας στη ζωντανή προεπισκόπηση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ABC, 123 eller #+= på fliken Nycklar. Alla nycklar och rader är ordnade direkt i liveförhandsvisningen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg ABC, 123 eller #+= på fanen Keys. Alle taster og rækker er arrangeret direkte i live preview."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg ABC, 123 eller #+= på Taster-fanen. Alle nøkler og rader er ordnet direkte i live-forhåndsvisningen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse Näppäimet-välilehdeltä ABC, 123 tai #+=. Kaikki näppäimet ja rivit järjestetään suoraan live-esikatselussa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih ABC, 123 atau #+= pada tab Tombol. Semua tombol dan baris disusun langsung di live preview."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ABC, 123 hoặc #+= trên tab Phím. Tất cả các phím và hàng được sắp xếp trực tiếp trong bản xem trước trực tiếp."
          }
        }
      }
    },
