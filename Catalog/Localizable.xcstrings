    "No search field, no category tabs. Swipe the grid to change category.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen soekveld, geen kategorie-oortjies nie. Swiep die rooster om kategorie te verander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Suchfeld, keine Kategorie-Tabs. Kategorie wechselst du per Wisch über das Raster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin campo de búsqueda ni pestañas de categorías. Desliza por la cuadrícula para cambiar de categoría."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsinguvälja ega kategooriakaarte pole. Viipa ruudustikku, et kategooriat vahetada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni champ de recherche ni onglets de catégories. Balaye la grille pour changer de catégorie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Se keresőmező, se kategóriafülek. A rácson húzva váltasz kategóriát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente campo di ricerca né schede delle categorie. Scorri sulla griglia per cambiare categoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索欄もカテゴリタブもなし。グリッドをスワイプしてカテゴリを切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색창도, 카테고리 탭도 없어요. 그리드를 밀어서 카테고리를 바꿔요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada medan carian, tiada tab kategori. Leret pada grid untuk tukar kategori."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem campo de pesquisa nem separadores de categorias. Desliza na grelha para mudar de categoria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без поля поиска и вкладок категорий. Смахивайте по сетке, чтобы менять категорию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有搜索框，也没有分类栏。在网格上滑动切换分类。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără câmp de căutare, fără file de categorii. Glisați grila pentru a schimba categoria."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen zoekveld, geen categorietabbladen. Veeg over het raster om van categorie te veranderen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有搜尋框，也沒有分類欄。在網格上滑動切換分類。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak pola wyszukiwania i zakładek kategorii. Przesuń siatkę, aby zmienić kategorię."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ні поля пошуку, ні вкладок категорій. Гортайте сітку, щоб змінити категорію."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama alanı yok, kategori sekmesi yok. Kategoriyi değiştirmek için ızgarayı kaydırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné vyhledávací pole, žádné karty kategorií. Chcete-li změnit kategorii, přejeďte po mřížce."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadne vyhľadávacie pole, žiadne karty kategórií. Ak chcete zmeniť kategóriu, prejdite prstom po mriežke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς πεδίο αναζήτησης, χωρίς καρτέλες κατηγορίας. Σύρετε το πλέγμα για να αλλάξετε κατηγορία."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget sökfält, inga kategoriflikar. Svep rutnätet för att ändra kategori."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
