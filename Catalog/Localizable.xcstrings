    "Polite and professional, for work and strangers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höflich und professionell, für Beruf und Fremde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cortés y profesional: para el trabajo y con desconocidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poli et professionnel, pour le travail et les inconnus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Udvarias és szakszerű, munkához és idegenekhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cortese e professionale: per il lavoro e con gli sconosciuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "丁寧でビジネス向き。仕事や初対面の相手に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정중하고 격식 있는 말투. 업무나 처음 만나는 사람에게."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sopan dan profesional, untuk kerja dan orang yang tidak dikenali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cortês e profissional, para o trabalho e para desconhecidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вежливо и по-деловому — для работы и незнакомых людей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "礼貌得体，适合工作场合和陌生人。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viisakas ja professionaalne, tööks ja võõrastele."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beleefd en professioneel, vir werk en vreemdelinge."
          }
        }
      }
    },
