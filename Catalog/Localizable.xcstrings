    "Undo key left of space, Redo key right of space": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontdoen sleutel links van spasie, Herhaal sleutel regs van spasie"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rückgängig-Taste links, Wiederholen-Taste rechts von der Leertaste"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecla Deshacer a la izquierda y Rehacer a la derecha de la barra espaciadora"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagasivõtu klahv tühikust vasakul, uuestitegemise klahv paremal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Annuler à gauche de la barre d'espace, touche Rétablir à droite"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszavonás gomb a szóköz bal, Újra gomb a jobb oldalán"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasto Annulla a sinistra e Ripristina a destra della barra spaziatrice"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースバーの左に取り消しキー、右にやり直しキー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스바 왼쪽에 실행 취소 키, 오른쪽에 다시 실행 키"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci Buat asal di kiri, kekunci Buat semula di kanan bar ruang"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecla Desfazer à esquerda e Refazer à direita da barra de espaços"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиша отмены слева от пробела, клавиша возврата — справа"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销键在空格键左侧，重做键在右侧"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulați tasta din stânga spațiului, Refaceți tasta din dreapta spațiului"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toets ongedaan maken links van de spatie, toets Opnieuw rechts van de spatie"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷鍵在空格鍵左側，重做鍵在右側"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisz Cofnij po lewej stronie spacji, Klawisz Ponów po prawej stronie spacji"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіша скасування ліворуч від пробілу, клавіша повтору праворуч від пробілу"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alanın solundaki tuşu geri al, Alanın sağındaki Yinele tuşu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátit zpět klávesu vlevo od mezery, Znovu klávesu vpravo od mezery"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Späť kľúč naľavo od priestoru, zopakovať kľúč napravo od priestoru"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναίρεση πλήκτρου αριστερά του διαστήματος, Επανάληψη του πλήκτρου δεξιά του διαστήματος"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ångra tangent till vänster om mellanslag, Gör om tangent till höger om mellanslag"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortryd tast til venstre for mellemrum, Gentag tast til højre for mellemrum"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angre-tast til venstre for mellomrom, Gjenta-tast til høyre for mellomrom"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumoa-näppäin välilyönnin vasemmalla puolella, Toista-näppäin välilyönnin oikealla puolella"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membatalkan tombol di kiri spasi, Mengulangi tombol di kanan spasi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tác phím bên trái khoảng trắng, Làm lại phím bên phải khoảng trắng"
