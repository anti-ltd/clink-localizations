            "value": "Klip muncul dalam panel di atas kekunci. Ketik untuk tampal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os clips aparecem num painel sobre as teclas. Toque para colar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фрагменты появляются в панели поверх клавиш. Нажмите, чтобы вставить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
