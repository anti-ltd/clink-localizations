          "stringUnit": {
            "state": "translated",
            "value": "Definier transform(text). Was es zurückgibt, wird eingefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define transform(text). Se inserta lo que devuelva."
          }
        },
        "et": {
