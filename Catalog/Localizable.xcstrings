        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 소리를 켜고 사운드 팩을 고르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Bunyi kekunci dan pilih pek bunyi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
