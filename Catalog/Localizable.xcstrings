    "Drifts behind the keys in the theme’s colors and lights up where you type. With the background hidden it plays over the app you’re in.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dryf agter die sleutels in die tema se kleure en verlig waar jy tik. Met die agtergrond versteek, speel dit oor die toepassing waarin jy is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Treibt in den Farben des Designs hinter den Tasten und leuchtet dort auf, wo du tippst. Bei ausgeblendetem Hintergrund läuft es über der App, in der du gerade bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mueve detrás de las teclas con los colores del tema y se ilumina donde escribes. Con el fondo oculto, se ve sobre la app en la que estés."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Triibib klahvide taga teema värvides ja süttib seal, kuhu sa tipid. Tausta peitmise korral mängib see rakenduse peal, kus sa oled."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dérive derrière les touches dans les couleurs du thème et s'illumine là où tu tapes. Si l'arrière-plan est masqué, il joue par-dessus l'app où tu es."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A téma színeiben sodródik a billentyűk mögött, és ott világít fel, ahol gépelsz. Elrejtett háttérnél az éppen használt app fölött játszik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si muove dietro i tasti nei colori del tema e si illumina dove scrivi. Con lo sfondo nascosto scorre sopra l'app in cui sei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマの色でキーの後ろを漂い、入力した場所が光ります。背景を非表示にしていると、使用中のアプリの上で動きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마 색으로 키 뒤에서 흐르고 입력하는 곳이 빛나요. 배경을 숨기면 지금 쓰는 앱 위에서 움직입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanyut di belakang kekunci dalam warna tema dan menyala di tempat anda menaip. Jika latar disembunyikan, ia bermain di atas app yang anda guna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Move-se por trás das teclas com as cores do tema e acende onde escreves. Com o fundo escondido, passa por cima da app onde estás."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плывёт за клавишами в цветах темы и светится там, где вы печатаете. Если фон скрыт, движение идёт поверх приложения, в котором вы находитесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以主题配色在按键后方流动，并在你输入的位置亮起。隐藏背景时，它会在你正在使用的 App 上方播放。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se deplasează în spatele tastelor în culorile temei și se aprinde acolo unde tastați. Cu fundalul ascuns, se joacă peste aplicația în care vă aflați."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweeft achter de toetsen in de kleuren van het thema en licht op waar je typt. Met de achtergrond verborgen, wordt het afgespeeld via de app waarin u zich bevindt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以主題配色在按鍵後方流動，並在你輸入的位置亮起。隱藏背景時，它會在你正在使用的 App 上方播放。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dryfuje za klawiszami w kolorach motywu i podświetla się podczas pisania. Gdy tło jest ukryte, odtwarzane jest w aplikacji, w której się znajdujesz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відображається за клавішами в кольорах теми та підсвічується там, де ви вводите текст. Коли фон приховано, він відтворюється поверх програми, у якій ви перебуваєте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temanın renkleri tuşların arkasında kayar ve yazdığınız yerde ışık yanar. Arka plan gizlendiğinde, içinde bulunduğunuz uygulama üzerinden oynatılır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za klávesami se posune barvy motivu a rozsvítí se tam, kde píšete. Se skrytým pozadím se přehrává přes aplikaci, ve které se nacházíte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Farby témy sa posunú za klávesy a rozsvieti sa tam, kde píšete. So skrytým pozadím sa prehrá cez aplikáciu, v ktorej sa nachádzate."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρασύρεται πίσω από τα πλήκτρα στα χρώματα του θέματος και ανάβει όπου πληκτρολογείτε. Με το φόντο κρυμμένο, παίζει πάνω από την εφαρμογή στην οποία βρίσκεστε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Drivs bakom tangenterna i temats färger och lyser upp där du skriver. Med bakgrunden dold spelas den över appen du är i."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Drifter bag tasterne i temaets farver og lyser op, hvor du skriver. Med baggrunden skjult afspilles den over den app, du er i."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Går bak tastene i temaets farger og lyser opp der du skriver. Med bakgrunnen skjult spiller den over appen du er i."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajahtaa näppäinten taakse teeman väreissä ja syttyy kirjoittaessasi. Kun tausta on piilotettu, se toistaa käyttämäsi sovelluksen päällä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melayang di belakang tombol sesuai warna tema dan menyala di tempat Anda mengetik. Dengan latar belakang tersembunyi, itu diputar di aplikasi yang Anda gunakan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di chuyển phía sau các phím với màu sắc của chủ đề và sáng lên ở nơi bạn nhập. Với nền bị ẩn, nó sẽ phát trên ứng dụng bạn đang sử dụng."
          }
        }
      }
    },
