    "Fonts you make stay on this device. They aren't attached to themes you share.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuentes que creas se quedan en este dispositivo. No se adjuntan a los temas que compartes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les polices que tu crées restent sur cet appareil. Elles ne sont pas jointes aux thèmes que tu partages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst erstellte Schriften bleiben auf diesem Gerät. Sie werden geteilten Themes nicht beigefügt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I font che crei restano su questo dispositivo. Non vengono allegati ai temi che condividi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As fontes que cria ficam neste dispositivo. Não são anexadas aos temas que partilha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Созданные вами шрифты остаются на этом устройстве. Они не прикрепляются к темам, которыми вы делитесь."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fon yang anda cipta kekal pada peranti ini. Ia tidak dilampirkan pada tema yang anda kongsi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az általad készített betűtípusok ezen az eszközön maradnak. A megosztott témákhoz nem csatolódnak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成したフォントはこの端末に残ります。共有するテーマには添付されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你制作的字体保留在此设备上，不会随分享的主题一起发送。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 만든 글꼴은 이 기기에만 남습니다. 공유하는 테마에는 첨부되지 않습니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu loodud fondid jäävad sellesse seadmesse. Neid ei lisata jagatavatele teemadele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonturile pe care le creați rămân pe acest dispozitiv. Ele nu sunt atașate temelor pe care le distribuiți."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lettertypen die u maakt, blijven op dit apparaat staan. Ze zijn niet gekoppeld aan thema's die u deelt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你製作的字型保留在此裝置上，不會隨分享的主題一起傳送。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonte wat jy maak bly op hierdie toestel. Hulle is nie gekoppel aan temas wat jy deel nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czcionki, które utworzysz, pozostaną na tym urządzeniu. Nie są one powiązane z udostępnianymi przez Ciebie motywami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шрифти, які ви створюєте, залишаються на цьому пристрої. Вони не пов’язані з темами, якими ви ділитеся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oluşturduğunuz yazı tipleri bu cihazda kalır. Paylaştığınız temalara bağlı değiller."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Písma, která vytvoříte, zůstanou na tomto zařízení. Nejsou připojeny k tématům, která sdílíte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Písma, ktoré vytvoríte, zostanú v tomto zariadení. Nie sú pripojené k témam, ktoré zdieľate."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι γραμματοσειρές που δημιουργείτε παραμένουν σε αυτήν τη συσκευή. Δεν συνδέονται με θέματα που μοιράζεστε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Teckensnitt du gör stannar på den här enheten. De är inte kopplade till teman som du delar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrifttyper, du laver, bliver på denne enhed. De er ikke knyttet til temaer, du deler."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrifter du lager forblir på denne enheten. De er ikke knyttet til temaer du deler."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luomasi fontit pysyvät tällä laitteella. Niitä ei ole liitetty jakamiisi teemoihin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Font yang Anda buat tetap ada di perangkat ini. Mereka tidak terikat pada tema yang Anda bagikan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phông chữ bạn tạo vẫn còn trên thiết bị này. Chúng không gắn liền với chủ đề bạn chia sẻ."
          }
        }
      }
    },
