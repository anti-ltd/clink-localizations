    "The words themselves don’t change. This only moves them. To filter the list against a different language’s writing rules, import the file again.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die woorde self verander nie. Dit beweeg hulle net. Om die lys teen 'n ander taal se skryfreëls te filtreer, voer die lêer weer in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wörter selbst ändern sich nicht. Sie werden nur verschoben. Um die Liste nach den Schreibregeln einer anderen Sprache zu filtern, importiere die Datei erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras no cambian. Solo se mueven. Para filtrar la lista con las reglas de escritura de otro idioma, importa el archivo de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sõnad ise ei muutu. See ainult liigutab neid. Et loendit teise keele kirjareeglite järgi filtreerida, impordi fail uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots eux-mêmes ne changent pas. Ils sont seulement déplacés. Pour filtrer la liste selon les règles d’écriture d’une autre langue, réimportez le fichier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Maguk a szavak nem változnak, csak átkerülnek. Ha egy másik nyelv írásszabályai szerint szűrnéd a listát, importáld újra a fájlt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole non cambiano. Vengono solo spostate. Per filtrare l’elenco con le regole di scrittura di un’altra lingua, importa di nuovo il file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語そのものは変わりません。移動するだけです。別の言語の表記ルールで絞り込むには、ファイルを取り込み直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어 자체는 바뀌지 않고 옮겨지기만 합니다. 다른 언어의 표기 규칙으로 걸러내려면 파일을 다시 가져오세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataannya sendiri tidak berubah. Ia hanya berpindah. Untuk menapis senarai mengikut peraturan tulisan bahasa lain, import fail itu semula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras em si não mudam. Só são movidas. Para filtrar a lista pelas regras de escrita de outro idioma, importa o ficheiro outra vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сами слова не меняются — они только переносятся. Чтобы отфильтровать список по правилам письма другого языка, импортируйте файл заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词本身不会变，只是换个归属。若想按另一门语言的书写规则重新筛选词表，请重新导入文件。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuvintele în sine nu se schimbă. Asta doar îi mișcă. Pentru a filtra lista în funcție de regulile de scriere ale unei alte limbi, importați din nou fișierul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De woorden zelf veranderen niet. Dit brengt hen alleen maar in beweging. Om de lijst te filteren op basis van de schrijfregels van een andere taal, importeert u het bestand opnieuw."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詞本身不會變，只是換個歸屬。若想按另一門語言的書寫規則重新篩選詞表，請重新匯入檔案。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Same słowa się nie zmieniają. To ich tylko porusza. Aby przefiltrować listę według reguł zapisu w innym języku, zaimportuj plik ponownie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Самі слова не змінюються. Це їх тільки рухає. Щоб відфільтрувати список за правилами написання іншої мови, імпортуйте файл ще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelimelerin kendisi değişmez. Bu sadece onları harekete geçirir. Listeyi farklı bir dilin yazma kurallarına göre filtrelemek için dosyayı tekrar içe aktarın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slova samotná se nemění. To je pouze posouvá. Chcete-li seznam filtrovat podle pravidel psaní v jiném jazyce, importujte soubor znovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Samotné slová sa nemenia. Toto ich len posúva. Ak chcete zoznam filtrovať podľa pravidiel písania v inom jazyku, importujte súbor znova."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ίδιες οι λέξεις δεν αλλάζουν. Αυτό μόνο τους συγκινεί. Για να φιλτράρετε τη λίστα με βάση τους κανόνες γραφής διαφορετικής γλώσσας, εισαγάγετε ξανά το αρχείο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Orden i sig förändras inte. Detta rör bara dem. För att filtrera listan mot ett annat språks skrivregler, importera filen igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordene i sig selv ændrer sig ikke. Dette flytter dem kun. For at filtrere listen mod et andet sprogs skriveregler skal du importere filen igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordene i seg selv endres ikke. Dette beveger dem bare. For å filtrere listen mot et annet språks skriveregler, importer filen på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Itse sanat eivät muutu. Tämä vain liikuttaa heitä. Jos haluat suodattaa luettelon eri kielen kirjoitussääntöjen mukaan, tuo tiedosto uudelleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata-katanya sendiri tidak berubah. Ini hanya menggerakkan mereka. Untuk memfilter daftar berdasarkan aturan penulisan bahasa lain, impor kembali file tersebut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản thân các từ không thay đổi. Điều này chỉ di chuyển chúng. Để lọc danh sách theo quy tắc viết của ngôn ngữ khác, hãy nhập lại tệp."
          }
        }
      }
    },
