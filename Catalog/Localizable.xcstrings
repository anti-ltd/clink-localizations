    "Say what you want done": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sê wat jy gedoen wil hê"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag, was passieren soll"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di lo que quieres que haga"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ütle, mida tahad teha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis ce que tu veux faire"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mondd meg, mi legyen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di' cosa vuoi che faccia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "してほしいことを言う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 걸 말하기"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebut apa yang anda mahu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz o que queres que faça"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажите, что нужно сделать"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说出你想做什么"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spune ce vrei să faci"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg wat je gedaan wilt hebben"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說出你想做什麼"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz, co chcesz zrobić"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажіть, що ви хочете зробити"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne yapılmasını istediğini söyle"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řekněte, co chcete udělat"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povedzte, čo chcete urobiť"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πες αυτό που θέλεις να γίνει"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säg vad du vill göra"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sig, hvad du vil have gjort"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Si hva du vil ha gjort"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sano mitä haluat tehdä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Katakan apa yang ingin Anda lakukan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói những gì bạn muốn làm"
          }
        }
      }
    },
    "Say which app you were typing in and what iOS you're on. It's usually the thing that narrows it down.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sê in watter toepassing jy getik het en op watter iOS jy is. Dit is gewoonlik die ding wat dit vernou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag dazu, in welcher App du getippt hast und welches iOS du hast. Meistens grenzt genau das die Sache ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinos en qué app escribías y qué iOS tienes. Suele ser lo que acota el problema."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ütle ka, millises rakenduses sa tipisid ja millisel iOS-il oled. Tavaliselt see kitsendabki asja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Précise dans quelle app tu tapais et quelle version d'iOS tu as. C'est en général ce qui réduit le champ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd meg, melyik appban gépeltél és milyen iOS van a telefonon. Általában ez szűkíti le a kört."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicci in quale app stavi scrivendo e che iOS hai. Di solito è quello che restringe il campo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリで入力していたか、iOSのバージョンも添えてください。たいていそれで絞り込めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 앱에서 입력 중이었는지와 iOS 버전을 함께 알려 주세요. 보통 그것으로 범위가 좁혀집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebutkan dalam app mana anda menaip dan iOS yang anda guna. Selalunya itu yang mempersempit puncanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz em que app estavas a escrever e que iOS tens. É quase sempre o que estreita a busca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишите, в каком приложении вы печатали и какая у вас версия iOS. Обычно именно это и сужает круг поисков."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说一下你在哪个 App 里打字、用的是哪个 iOS 版本。多半就是这两点缩小了范围。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spuneți ce aplicație ați introdus și pe ce iOS vă aflați. De obicei, este lucrul care o restrânge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg welke app je aan het typen was en welke iOS je gebruikt. Het is meestal het ding dat het beperkt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說一下你在哪個 App 裡打字、用的是哪個 iOS 版本。多半就是這兩點縮小了範圍。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz, w której aplikacji wpisałeś i z jakiego iOS korzystasz. Zwykle jest to rzecz, która zawęża zakres."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажіть, у якій програмі ви вводили текст і який iOS використовуєте. Зазвичай це те, що звужує його."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi uygulamayı yazdığınızı ve hangi iOS'te olduğunuzu söyleyin. Genellikle onu daraltan şey budur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řekněte, ve které aplikaci jste psali a na jakém iOS používáte. Obvykle je to věc, která to zužuje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povedzte, v ktorej aplikácii ste písali a na ktorom iOS práve používate. Zvyčajne je to vec, ktorá to zužuje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πείτε σε ποια εφαρμογή πληκτρολογούσατε και σε ποιο iOS χρησιμοποιείτε. Συνήθως είναι αυτό που το στενεύει."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säg vilken app du skrev i och vilken iOS du använder. Det är oftast det som begränsar det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sig, hvilken app du skrev i, og hvilken iOS du bruger. Det er normalt det, der indsnævrer det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Si hvilken app du skrev inn og hvilken iOS du bruker. Det er vanligvis tingen som begrenser det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sano, mitä sovellusta kirjoitit ja mitä iOS-laitetta käytät. Yleensä se on se, joka kaventaa sitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ucapkan aplikasi mana yang Anda ketik dan iOS apa yang Anda gunakan. Biasanya hal itulah yang mempersempitnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho biết bạn đang nhập ứng dụng nào và bạn đang sử dụng iOS nào. Đó thường là thứ thu hẹp nó lại."
          }
        }
      }
    },
    "Says it the way a fluent speaker would.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sê dit soos 'n vlot spreker sou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formuliert es so, wie es ein Muttersprachler sagen würde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo dice como lo diría un hablante nativo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sõnastab seda nii, nagu teeks sujuv kõneleja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le formule comme le ferait un locuteur natif."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Úgy fogalmaz, ahogy egy anyanyelvi beszélő mondaná."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo dice come lo direbbe un madrelingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "母語話者が話すような言い回しにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원어민이 말하듯 옮깁니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyampaikannya seperti penutur fasih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz como diria um falante nativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорит так, как сказал бы носитель языка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用母语者的说法来表达。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O spune așa cum ar face un vorbitor fluent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegt het zoals een vloeiend spreker dat zou doen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用母語者的說法來表達。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mówi to tak, jak zrobiłby to biegły mówca."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорить це так, як вільно розмовляє."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu akıcı bir konuşmacının söyleyeceği şekilde söylüyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Říká to tak, jak by to řekl plynulý řečník."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovorí to tak, ako by to povedal plynulý rečník."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το λέει όπως θα έκανε ένας άπταιστα ομιλητής."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säger det som en flytande talare skulle göra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Siger det som en flydende taler ville."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sier det slik en flytende foredragsholder ville gjort det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanoo sen kuten sujuva puhuja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengatakannya seperti yang dilakukan oleh pembicara yang fasih."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói theo cách của một người nói trôi chảy."
          }
        }
      }
    },
