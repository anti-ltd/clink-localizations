        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohyblivé efekty, které se přehrávají na pozadí motivu pod klávesami."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
