    "Subscribe or go lifetime to use Clink in every app. Your free in-app keyboard stays free.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken in of gaan leeftyd om Clink in elke toepassing te gebruik. Jou gratis inprogram-sleutelbord bly gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Abo oder dem Lifetime-Kauf kannst du Clink in jeder App verwenden. Die kostenlose Tastatur in der App bleibt kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscríbete o elige la compra de por vida para usar Clink en todas las apps. El teclado gratuito dentro de la app seguirá siendo gratis."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Telli või vali eluaegne, et kasutada Clinki igas rakenduses. Sinu tasuta rakendusesisene klaviatuur jääb tasuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonne-toi ou choisis l'achat à vie pour utiliser Clink dans toutes tes apps. Le clavier gratuit dans l'app reste gratuit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előfizetéssel vagy örökös vásárlással minden appban használhatod a Clinket. Az appon belüli ingyenes billentyűzet ingyenes marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbonati o scegli l'acquisto a vita per usare Clink in tutte le app. La tastiera gratuita dentro l'app resta gratuita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションまたは買い切りで、すべてのアプリでClinkを使えます。アプリ内の無料キーボードはこれからも無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독하거나 평생 이용권을 구매하면 모든 앱에서 Clink를 쓸 수 있어요. 앱 안의 무료 키보드는 계속 무료예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Langgan atau pilih akses seumur hidup untuk menggunakan Clink dalam semua app. Papan kekunci percuma dalam app kekal percuma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscreve ou escolhe a compra vitalícia para usar o Clink em todas as apps. O teclado grátis dentro da app continua grátis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформите подписку или выберите пожизненный доступ, чтобы использовать Clink во всех приложениях. Ваша бесплатная клавиатура в приложении остаётся бесплатной."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅或购买终身版，即可在所有 App 中使用 Clink。App 内的免费键盘会一直免费。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonați-vă sau continuați să utilizați Clink în fiecare aplicație. Tastatura gratuită în aplicație rămâne gratuită."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonneer je of ga levenslang om Clink in elke app te gebruiken. Uw gratis in-app-toetsenbord blijft gratis."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱或購買終身版，即可在所有 App 中使用 Clink。App 內的免費鍵盤會一直免費。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrybuj lub skorzystaj z dożywotniego abonamentu, aby używać Clink w każdej aplikacji. Twoja bezpłatna klawiatura w aplikacji pozostanie bezpłatna."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підпишіться або довічно використовуйте Clink у кожному додатку. Ваша безкоштовна клавіатура в програмі залишається безкоштовною."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink'i her uygulamada kullanmak için abone olun veya ömür boyu devam edin. Ücretsiz uygulama içi klavyeniz ücretsiz kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se k odběru nebo doživotně a používejte Clink v každé aplikaci. Vaše bezplatná klávesnice v aplikaci zůstane zdarma."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscribe or go lifetime to use Clink in every app. Vaša bezplatná klávesnica v aplikácii zostane bezplatná."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγγραφείτε ή χρησιμοποιήστε το Clink σε κάθε εφαρμογή. Το δωρεάν πληκτρολόγιο εντός εφαρμογής παραμένει δωρεάν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumerera eller gå livet ut för att använda Clink i varje app. Ditt gratis tangentbord i appen förblir gratis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonner eller gå livet ud for at bruge Clink i hver app. Dit gratis tastatur i appen forbliver gratis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonner eller gå livet ut for å bruke Clink i hver app. Ditt gratis tastatur i appen forblir gratis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaa tai käytä eliniän ajan Clink:ää kaikissa sovelluksissa. Ilmainen sovelluksen sisäinen näppäimistö pysyy ilmaiseksi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlangganan atau gunakan seumur hidup untuk menggunakan Clink di setiap aplikasi. Papan ketik dalam aplikasi gratis Anda tetap gratis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký hoặc sử dụng trọn đời để sử dụng Clink trong mọi ứng dụng. Bàn phím trong ứng dụng miễn phí của bạn vẫn miễn phí."
          }
        }
      }
    },
    "Subscribe to unlock Dictation, AI Tools, and everything else": {
