    "The text you copy, ready on every device. Copied images stay on the device that saved them.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die teks wat jy kopieer, gereed op elke toestel. Gekopieerde beelde bly op die toestel wat hulle gestoor het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text, den du kopierst, steht auf jedem Gerät bereit. Kopierte Bilder bleiben auf dem Gerät, das sie gespeichert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto que copias, listo en todos tus dispositivos. Las imágenes copiadas se quedan en el dispositivo que las guardó."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst, mida kopeerid, on valmis igas seadmes. Kopeeritud pildid jäävad seadmesse, mis need salvestas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte que tu copies, prêt sur chaque appareil. Les images copiées restent sur l’appareil qui les a enregistrées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A másolt szöveged minden eszközön kéznél van. A másolt képek azon az eszközön maradnak, amelyik elmentette őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo che copi, pronto su ogni dispositivo. Le immagini copiate restano sul dispositivo che le ha salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたテキストをすべてのデバイスで使えます。コピーした画像は保存したデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 텍스트를 모든 기기에서 바로 사용할 수 있습니다. 복사한 이미지는 저장한 기기에 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang anda salin, tersedia pada setiap peranti. Imej yang disalin kekal pada peranti yang menyimpannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto que copias, pronto em todos os dispositivos. As imagens copiadas ficam no dispositivo que as guardou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопированный текст доступен на всех устройствах. Скопированные изображения остаются на том устройстве, где были сохранены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你复制的文本可在每台设备上随时取用。复制的图片则保留在保存它的设备上。"
          }
        }
      }
    },
    "The text you copy, ready on every device. Copied images stay put.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die teks wat jy kopieer, gereed op elke toestel. Gekopieerde beelde bly sit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kopierte Text, auf jedem Gerät bereit. Kopierte Bilder bleiben, wo sie sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto que copias, listo en todos tus dispositivos. Las imágenes copiadas se quedan donde están."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst, mida kopeerid, on valmis igas seadmes. Kopeeritud pildid jäävad paigale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte que tu copies, prêt sur chaque appareil. Les images copiées restent où elles sont."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A másolt szöveg minden eszközödön kéznél van. A másolt képek a helyükön maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo che copi, pronto su ogni dispositivo. Le immagini copiate restano dove sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたテキストをどの端末でもすぐに。コピーした画像はその端末に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 텍스트를 모든 기기에서 바로 사용할 수 있습니다. 복사한 이미지는 그 자리에 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang anda salin, sedia pada setiap peranti. Imej yang disalin kekal di tempatnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto que copias, pronto em todos os dispositivos. As imagens copiadas ficam onde estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопированный текст доступен на всех устройствах. Скопированные изображения остаются на месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你复制的文字，在每台设备上随时可用。复制的图片则留在原处。"
          }
        }
      }
    },
    "The theme-pack download could not be completed. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download des Theme-Pakets konnte nicht abgeschlossen werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la descarga del paquete de temas. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teemapaketi allalaadimist ei õnnestunud lõpetada. Kontrolli ühendust ja proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement du pack de thèmes n’a pas pu être terminé. Vérifie ta connexion et réessaie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A témacsomag letöltését nem sikerült befejezni. Ellenőrizd a kapcsolatot, és próbáld újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile completare il download del pacchetto di temi. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマパックのダウンロードを完了できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마 팩 다운로드를 완료할 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat turun pek tema tidak dapat diselesaikan. Semak sambungan anda dan cuba lagi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a transferência do pacote de temas. Verifique a ligação e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить загрузку пакета тем. Проверьте подключение и попробуйте снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成主题包下载。请检查网络连接并重试。"
          }
        }
      }
    },
    "The theme-pack download could not be verified.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download des Theme-Pakets konnte nicht überprüft werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la descarga del paquete de temas."
          }
        },
        "et": {
          "stringUnit": {
