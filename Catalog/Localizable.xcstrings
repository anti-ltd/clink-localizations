    "List gives each note a full-width row with the first couple of lines.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Lys gee elke noot 'n volwydte ry met die eerste paar reëls."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste gibt jeder Notiz eine Zeile über die volle Breite mit den ersten paar Zeilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista da a cada nota una fila de ancho completo con las primeras líneas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loend annab igale märkmele täislaiuses rea esimeste ridadega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste donne à chaque note une ligne pleine largeur avec les premières lignes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista minden jegyzetnek teljes szélességű sort ad az első pár sorral."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco dà a ogni nota una riga a tutta larghezza con le prime righe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストは各メモを全幅の行に並べ、冒頭の数行を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록은 메모마다 전체 너비 행을 주고 앞부분 몇 줄을 보여줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai memberi setiap nota satu baris selebar skrin dengan beberapa baris pertama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista dá a cada nota uma linha de largura total com as primeiras linhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Список» отводит каждой заметке строку во всю ширину с первыми парой строк текста."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表让每条备忘占满一行，显示开头几行。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Listă oferă fiecărei note un rând cu lățimea completă cu primele două linii."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lijst geeft elke noot een rij over de volledige breedte met de eerste paar regels."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列表讓每條備忘佔滿一行，顯示開頭幾行。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista daje każdej notatce wiersz o pełnej szerokości z kilkoma pierwszymi liniami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список надає кожній ноті рядок на всю ширину з першими двома рядками."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste, her nota ilk birkaç satırı içeren tam genişlikte bir satır verir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seznam dává každé notě řádek plné šířky s prvními dvěma řádky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoznam dáva každej note riadok s plnou šírkou s prvými pármi riadkov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λίστα δίνει σε κάθε νότα μια σειρά πλήρους πλάτους με τις πρώτες δύο γραμμές."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista ger varje anteckning en fullbreddsrad med de första par raderna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "List giver hver note en række i fuld bredde med de første par linjer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "List gir hver note en rad i full bredde med de første par linjene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista antaa jokaiselle nuotille täysleveän rivin parilla ensimmäisellä rivillä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar memberi setiap nada baris lebar penuh dengan beberapa baris pertama."
          }
        },
        "vi": {
          "stringUnit": {
