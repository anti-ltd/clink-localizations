    "Your pet, shown live. Give it a poke. Pick a species, corner, and size below.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou troeteldier, regstreeks gewys. Gee dit 'n slag. Kies 'n spesie, hoek en grootte hieronder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Haustier, live. Stups es an. Wähle unten Art, Ecke und Größe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mascota, en vivo. Dale un toque. Elige especie, esquina y tamaño abajo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu lemmikloom, reaalajas. Torka teda. Vali all liik, nurk ja suurus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compagnon, en direct. Donne-lui un petit coup. Choisis l'espèce, le coin et la taille ci-dessous."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kisállatod élőben. Bökd meg. Lent válassz fajt, sarkot és méretet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo pet, dal vivo. Dagli un colpetto. Sotto scegli specie, angolo e dimensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペットのライブ表示。つついてみてください。下で種類・位置・サイズを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펫을 실시간으로 보여줘요. 한번 찔러보세요. 아래에서 종류, 위치, 크기를 고르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peliharaan anda, dipapar secara langsung. Cuba cuit. Pilih spesies, sudut dan saiz di bawah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua mascote, ao vivo. Dá-lhe um toque. Escolhe espécie, canto e tamanho abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш питомец вживую. Ткните в него. Вид, угол и размер выбираются ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宠物的实时样子。戳它一下试试。下面可以选种类、角落和大小。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Animalul tău de companie, prezentat live. Dă-i o lovitură. Alegeți o specie, un colț și o dimensiune de mai jos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw huisdier, live getoond. Geef het een por. Kies hieronder een soort, hoek en maat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寵物的實時樣子。戳它一下試試。下面可以選種類、角落和大小。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój zwierzak pokazany na żywo. Daj to szturchnąć. Wybierz gatunek, narożnik i rozmiar poniżej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш домашній улюбленець, показаний наживо. Тикніть його. Виберіть вид, кут і розмір нижче."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evcil hayvanınız canlı olarak gösteriliyor. Bir dürt. Aşağıdan bir tür, köşe ve boyut seçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš mazlíček, ukázaný živě. Dej to šťouchnout. Níže vyberte druh, roh a velikost."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš domáci miláčik zobrazený naživo. Daj do toho štuchnutie. Nižšie vyberte druh, roh a veľkosť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κατοικίδιό σας, εμφανίζεται ζωντανά. Δώστε του ένα σακάκι. Επιλέξτε ένα είδος, γωνία και μέγεθος παρακάτω."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt husdjur, visas live. Ge det en peta. Välj en art, hörn och storlek nedan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kæledyr, vist live. Giv det et smut. Vælg en art, hjørne og størrelse nedenfor."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjæledyret ditt, vist live. Gi den et stikk. Velg art, hjørne og størrelse nedenfor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lemmikkisi, näytetään livenä. Syö sitä. Valitse laji, kulma ja koko alta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hewan peliharaan Anda, ditampilkan secara langsung. Coba saja. Pilih spesies, sudut, dan ukuran di bawah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thú cưng của bạn, được hiển thị trực tiếp. Hãy chọc nó một cái. Chọn một loài, góc và kích thước bên dưới."
          }
        }
      }
    },
