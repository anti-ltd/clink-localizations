            "state": "translated",
            "value": "Otro panel ya usa este ID. Un plugin abre el que aparezca primero."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seda ID-d kasutab juba teine paneel. Pistikprogramm avab neist esimese."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre panneau utilise déjà cet ID. Un plug-in ouvre celui qui vient en premier."
          }
