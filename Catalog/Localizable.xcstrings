    "Turn on Adaptive hitboxes to fine-tune the prediction.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel Adaptive hitboxes aan om die voorspelling te verfyn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte adaptive Trefferflächen ein, um die Vorhersage feiner einzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las zonas táctiles adaptativas para afinar la predicción."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita sisse Kohanduvad tabamustsoonid, et ennustust peenhäälestada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active les zones tactiles adaptatives pour affiner la prédiction."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be az Adaptív találati mezőket az előrejelzés finomhangolásához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le aree tattili adattive per mettere a punto la previsione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測を細かく調整するには、アダプティブヒットボックスをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예측을 세밀하게 맞추려면 적응형 히트박스를 켜주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Kotak sentuh adaptif untuk memperhalus ramalan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga as zonas de toque adaptativas para afinar a previsão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Адаптивные зоны нажатия», чтобы точнее настроить предсказание."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启自适应触区来微调预测。"
          }
        }
      }
    },
