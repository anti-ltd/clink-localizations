    "Search for the setting and set it how you had it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Soek vir die instelling en stel dit soos jy dit gehad het."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Such die Einstellung und stell sie wieder so ein, wie du sie hattest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca el ajuste y déjalo como lo tenías."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsi seadistus ja sea see nii, nagu sul oli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherche le réglage et remets-le comme tu l’avais."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Keresd meg a beállítást, és állítsd vissza úgy, ahogy volt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca l’impostazione e rimettila com’era."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その設定を検索して、元の状態に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 설정을 검색해 원래대로 되돌리세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari tetapan itu dan tetapkannya seperti dahulu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Procura a definição e põe-na como a tinhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите настройку через поиск и верните её к прежнему значению."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索这项设置，把它改回原来的样子。"
          }
        }
      }
    },
    "Search from the bar on any tab to look through the settings themselves.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Soek vanaf die balk op enige oortjie om self deur die instellings te kyk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über das Suchfeld oben in jedem Tab durchsuchst du die Einstellungen selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la búsqueda de cualquier pestaña para buscar en los ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsi mis tahes kaardi ribalt, et sirvida seadeid ise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la recherche en haut de n'importe quel onglet pour chercher dans les réglages."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármelyik lap tetején lévő keresővel magukban a beállításokban is kereshetsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca dalla barra in cima a qualsiasi scheda per guardare tra le impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各タブ上部の検索から、設定そのものを探せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 탭 위쪽 검색창으로 설정 자체를 찾아볼 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Guna carian di atas mana-mana tab untuk mencari dalam tetapan itu sendiri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa a pesquisa no topo de qualquer separador para procurar nas próprias definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищите через строку на любой вкладке, чтобы пройтись по самим настройкам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意标签页顶部的搜索框里可以直接搜索设置。"
          }
        }
      }
    },
