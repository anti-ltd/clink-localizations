    "Drag to resize this key. The rest of the row makes room.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep om die grootte van hierdie sleutel te verander. Die res van die ry maak plek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen, um die Größe dieser Taste zu ändern. Der Rest der Reihe macht Platz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
