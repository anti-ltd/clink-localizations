        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak hierdie oortjie oop nadat die bewaarplek 'n vrystelling gepubliseer het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz tę zakładkę po opublikowaniu wersji w repozytorium."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте цю вкладку після того, як сховище опублікує випуск."
          }
        },
        "tr": {
          "stringUnit": {
