            "value": "Vaše profily a motívy zostanú v tomto zariadení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα προφίλ και τα θέματά σας παραμένουν σε αυτήν τη συσκευή."
          }
        },
        "sv": {
          "stringUnit": {
