    "Use the controls above, or fire a hook. What the plugin asks the keyboard for shows up here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze die Bedienelemente oben oder löse einen Hook aus. Was das Plugin von der Tastatur verlangt, erscheint hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa los controles de arriba o dispara un hook. Lo que el plugin le pide al teclado aparece aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasuta ülal olevaid juhtelemente või käivita haak. Siin näed, mida pistikprogramm klaviatuurilt palub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les commandes ci-dessus, ou déclenchez un hook. Ce que le plugin demande au clavier s'affiche ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használd a fenti vezérlőket, vagy indíts el egy horogpontot. Itt jelenik meg, mit kér a bővítmény a billentyűzettől."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa i controlli qui sopra, o attiva un hook. Ciò che il plugin chiede alla tastiera compare qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上のコントロールを使うか、フックを起動してください。プラグインがキーボードに求めたことがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위의 컨트롤을 사용하거나 훅을 실행해 보세요. 플러그인이 키보드에 요청한 내용이 여기에 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan kawalan di atas, atau cetuskan cangkuk. Apa yang plugin minta daripada papan kekunci muncul di sini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use os controlos acima ou dispare um hook. O que o plugin pede ao teclado aparece aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте элементы выше или вызовите хук. Здесь появится то, что плагин запросил у клавиатуры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用上方的控件，或触发一个钩子。插件向键盘提出的请求会显示在这里。"
          }
        }
      }
    },
    "Use the current value or a saved profile. Edit structured settings on their usual Clink screen, then capture them here.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el valor actual o un perfil guardado. Edita los ajustes estructurados en su pantalla habitual de Clink y cópialos aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la valeur actuelle ou un profil enregistré. Modifie les réglages structurés dans leur écran Clink habituel, puis copie-les ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende den aktuellen Wert oder ein gespeichertes Profil. Bearbeite strukturierte Einstellungen auf ihrer gewohnten Clink-Seite und übernimm sie dann hier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il valore attuale o un profilo salvato. Modifica le impostazioni strutturate nella schermata Clink abituale, poi acquisiscile qui."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o valor atual ou um perfil guardado. Edita as definições estruturadas no ecrã habitual do Clink e captura-as aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте текущее значение или сохранённый профиль. Измените составные настройки на обычном экране Clink, затем скопируйте их сюда."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan nilai semasa atau profil tersimpan. Edit tetapan berstruktur pada skrin Clink biasanya, kemudian salin ke sini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használd a jelenlegi értéket vagy egy mentett profilt. A strukturált beállításokat a szokásos Clink-képernyőn szerkeszd, majd vedd át itt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の値または保存済みのプロファイルを使用します。複合的な設定は通常のClink画面で編集し、ここで取り込んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用当前值或已保存的配置。在 Clink 原有设置页面编辑结构化设置，然后在此获取。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 값이나 저장된 프로필을 사용하세요. 구조화된 설정은 기존 Clink 화면에서 편집한 후 여기로 가져오세요."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasuta praegust väärtust või salvestatud profiili. Muuda liitseadeid nende tavalisel Clinki lehel ja võta need siin üle."
          }
        }
      }
    },
    "Uses your exact tap location to pick the right word": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gebruik jou presiese tikplek om die regte woord te kies"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt deine genaue Tipp-Position, um das richtige Wort zu wählen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la posición exacta de tu toque para elegir la palabra correcta"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasutab sinu täpset vajutuskohta, et õige sõna valida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sert de l'emplacement exact de ton appui pour choisir le bon mot"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pontos koppintási helyedet használja a megfelelő szó kiválasztásához"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la posizione esatta del tuo tocco per scegliere la parola giusta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップした正確な位置を使って、正しい単語を選びます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확한 탭 위치를 써서 알맞은 단어를 골라요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Guna lokasi tepat ketikan anda untuk pilih perkataan yang betul"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa a localização exata do teu toque para escolher a palavra certa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует точное место нажатия, чтобы выбрать нужное слово"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你精确的点按位置来挑对的词"
          }
        }
      }
    },
