    "Reorder the keyboard's Translate menu, switch off any you don't want, and download a language to use it offline.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Herrangskik die sleutelbord se Vertaal-kieslys, skakel enige wat jy nie wil hê nie, en laai 'n taal af om dit vanlyn te gebruik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordne das Übersetzen-Menü der Tastatur, schalte ungewollte Sprachen ab und lade eine Sprache herunter, um sie offline zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordena el menú de Traducir del teclado, desactiva las que no quieras y descarga un idioma para usarlo sin conexión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrasta klaviatuuri Tõlgi menüü, lülita välja need, mida ei taha, ja laadi keel alla, et seda ühenduseta kasutada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réorganise le menu Traduire du clavier, désactive celles que tu ne veux pas et télécharge une langue pour l'utiliser hors ligne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendezd át a billentyűzet Fordítás menüjét, kapcsold ki a nem kívántakat, és tölts le egy nyelvet az offline használathoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riordina il menu Traduci della tastiera, disattiva quelle che non vuoi e scarica una lingua per usarla offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの翻訳メニューを並べ替え、不要な言語をオフにし、オフラインで使う言語をダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 번역 메뉴를 재정렬하고, 원치 않는 언어는 끄고, 오프라인으로 쓸 언어를 내려받아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun semula menu Terjemah papan kekunci, matikan yang anda tak mahu, dan muat turun bahasa untuk guna luar talian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordena o menu Traduzir do teclado, desliga as que não queres e transfere um idioma para o usares offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняйте порядок в меню перевода на клавиатуре, выключайте ненужное и загружайте язык, чтобы пользоваться им офлайн."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新排序键盘的翻译菜单，关掉不想要的语言，并下载语言以便离线使用。"
          }
        }
      }
    },
