    "Holds the light back so letters never wash out.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält das Licht zurück, damit Buchstaben nie verblassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contiene la luz para que las letras nunca se pierdan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoiab valgust tagasi, et tähed kunagi ei hajuks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retient la lumière pour que les lettres ne soient jamais délavées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszafogja a fényt, hogy a betűk sose fakuljanak el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trattiene la luce così le lettere non sbiadiscono mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光を控えめにして、文字が見えなくならないようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛을 줄여 글자가 묻히지 않게 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menahan cahaya supaya huruf tidak pudar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Contém a luz para que as letras nunca desapareçam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приглушает свет, чтобы буквы не терялись."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适当收敛光线，让字母始终清晰可见。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reține lumina înapoi, astfel încât literele să nu se spele niciodată."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt het licht tegen zodat letters nooit uitwassen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適當收斂光線，讓字母始終清晰可見。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou die lig terug sodat letters nooit vervaag nie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymuje światło, dzięki czemu litery nigdy się nie zmywają."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Затримує світло, щоб літери ніколи не зникали."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işığı geri tutar, böylece harfler asla solmaz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržuje světlo, takže písmena se nikdy nevymyjí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržiava svetlo, takže písmená sa nikdy nezmyjú."
          }
