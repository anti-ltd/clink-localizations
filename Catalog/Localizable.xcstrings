    "Everything before the cursor.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles voor die wyser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles vor dem Cursor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que hay antes del cursor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik enne kursorit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui se trouve avant le curseur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden a kurzor előtt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che si trova prima del cursore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルより前のすべて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서 앞의 모든 내용."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua teks sebelum kursor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que está antes do cursor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что до курсора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标前的所有内容。"
          }
        }
      }
    },
    "Everything here runs on device with Apple Intelligence. Nothing leaves your phone.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles hier loop op toestel met Apple Intelligence. Niks verlaat jou foon nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles hier läuft mit Apple Intelligence direkt auf dem Gerät. Nichts verlässt dein iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo esto funciona en el dispositivo con Apple Intelligence. Nada sale de tu iPhone."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik siin töötab Apple Intelligence’iga seadmel. Midagi ei lahku sinu telefonist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout fonctionne sur l'appareil avec Apple Intelligence. Rien ne quitte ton iPhone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt minden az eszközön fut az Apple Intelligence segítségével. Semmi nem hagyja el az iPhone-odat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui funziona tutto sul dispositivo con Apple Intelligence. Nulla lascia il tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにある機能はすべてApple Intelligenceを使ってデバイス上で動きます。iPhoneの外にデータは出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기의 모든 기능은 Apple Intelligence를 사용해 기기에서 실행돼요. 어떤 내용도 iPhone 밖으로 나가지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya berjalan pada peranti dengan Apple Intelligence. Tiada apa-apa keluar daripada iPhone anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo aqui funciona no dispositivo com o Apple Intelligence. Nada sai do teu iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё здесь работает на устройстве с Apple Intelligence. Ничто не покидает ваш телефон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里的一切都通过 Apple Intelligence 在设备端运行。任何内容都不会离开你的 iPhone。"
          }
        }
      }
    },
    "Everything is already in the bar.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles ist schon in der Leiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está todo en la barra."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik on juba ribal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est déjà dans la barre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már minden a sávon van."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È già tutto nella barra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてバーに追加済みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 항목이 이미 바에 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya sudah ada dalam bar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já está tudo na barra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё уже на панели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有项目都已在栏中。"
          }
        }
      }
    },
    "Everything is encrypted on this device before it goes up. The key stays in your iCloud Keychain, so only your devices can open it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles word op hierdie toestel geïnkripteer voordat dit opgaan. Die sleutel bly in jou iCloud-sleutelhanger, so net jou toestelle kan dit oopmaak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wird auf diesem Gerät verschlüsselt, bevor es hochgeht. Der Schlüssel bleibt in deinem iCloud-Schlüsselbund, sodass nur deine Geräte ihn öffnen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se cifra en este dispositivo antes de subir. La clave se queda en tu llavero de iCloud, así que solo tus dispositivos pueden abrirla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik krüptitakse selles seadmes enne üleslaadimist. Võti jääb sinu iCloudi võtmehoidlasse, nii et ainult sinu seadmed saavad seda avada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est chiffré sur cet appareil avant d’être envoyé. La clé reste dans ton trousseau iCloud, donc seuls tes appareils peuvent l’ouvrir."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden titkosítva lesz ezen az eszközön, mielőtt feltöltődne. A kulcs az iCloud-kulcskarikádon marad, így csak a te eszközeid tudják megnyitni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto viene cifrato su questo dispositivo prima di partire. La chiave resta nel tuo portachiavi iCloud, così solo i tuoi dispositivi possono aprirla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてアップロード前にこの端末で暗号化されます。鍵はiCloudキーチェーンに残るため、開けるのはあなたの端末だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 데이터는 업로드 전에 이 기기에서 암호화됩니다. 키는 iCloud 키체인에 남아 있어 사용자의 기기만 열 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya disulitkan pada peranti ini sebelum dihantar. Kuncinya kekal dalam Rantai Kunci iCloud anda, jadi hanya peranti anda boleh membukanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo é encriptado neste dispositivo antes de subir. A chave fica no teu porta-chaves do iCloud, por isso só os teus dispositivos a conseguem abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё шифруется на этом устройстве до отправки. Ключ остаётся в вашей Связке ключей iCloud, поэтому открыть данные могут только ваши устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容在上传前都会在这台设备上加密。密钥保存在你的 iCloud 钥匙串中，只有你的设备能打开。"
          }
        }
      }
    },
    "Everything runs on device with Apple Intelligence. Nothing leaves your phone. Each feature stays off until you turn it on here.": {
      "extractionState": "stale",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles loop op toestel met Apple Intelligence. Niks verlaat jou foon nie. Elke kenmerk bly af totdat jy dit hier aanskakel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles läuft mit Apple Intelligence auf dem Gerät. Nichts verlässt dein Handy. Jede Funktion bleibt aus, bis du sie hier einschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo funciona en el dispositivo con Apple Intelligence. Nada sale de tu teléfono. Cada función está apagada hasta que la actives aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik töötab Apple Intelligence’iga seadmel. Midagi ei lahku sinu telefonist. Iga funktsioon jääb välja, kuni sa selle siin sisse lülidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout tourne sur l'appareil avec Apple Intelligence. Rien ne quitte ton téléphone. Chaque fonction reste désactivée tant que tu ne l'actives pas ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden az eszközön fut az Apple Intelligence-szel. Semmi nem hagyja el a telefonodat. Minden funkció ki van kapcsolva, amíg itt be nem kapcsolod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto gira sul dispositivo con Apple Intelligence. Niente lascia il tuo telefono. Ogni funzione resta spenta finché non la attivi qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて Apple Intelligence を使って端末の中で動きます。入力した内容が iPhone の外に出ることはありません。どの機能も、ここでオンにするまで動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 Apple Intelligence로 기기에서 돌아가요. 아무것도 폰을 떠나지 않아요. 각 기능은 여기서 켜기 전까진 꺼져 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya berjalan dalam peranti dengan Apple Intelligence. Tiada apa keluar dari telefon anda. Setiap ciri kekal mati sampai anda hidupkannya di sini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Corre tudo no dispositivo com a Apple Intelligence. Nada sai do teu telemóvel. Cada funcionalidade fica desligada até a ligares aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё работает на устройстве через Apple Intelligence. Ничего не покидает телефон. Каждая функция выключена, пока вы не включите её здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都靠 Apple Intelligence 在设备上运行。什么都不会离开你的手机。每项功能都是关着的，直到你在这里打开它。"
          }
        }
      }
    },
    "Everything runs on this phone with Apple Intelligence. It works offline, nothing you type leaves the device, and every AI feature stays off until you switch it on here.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles loop op hierdie foon met Apple Intelligence. Dit werk vanlyn, niks wat jy tik verlaat die toestel nie, en elke KI-kenmerk bly af totdat jy dit hier aanskakel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles läuft mit Apple Intelligence hier auf dem Handy. Es geht offline, nichts, was du tippst, verlässt das Gerät, und jede KI-Funktion bleibt aus, bis du sie hier einschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo funciona en este teléfono con Apple Intelligence. Va sin conexión, nada de lo que escribes sale del dispositivo, y cada función de IA está apagada hasta que la enciendas aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik töötab selles telefonis Apple Intelligence’iga. Töötab ühenduseta, midagi, mida tipid, ei lahku seadmest ja iga TI-funktsioon jääb välja, kuni sa selle siin sisse lülidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout tourne sur ce téléphone avec Apple Intelligence. Ça marche hors ligne, rien de ce que tu écris ne quitte l'appareil, et chaque fonction d'IA reste désactivée tant que tu ne l'actives pas ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen a telefonon minden az Apple Intelligence-szel fut. Offline is működik, amit írsz, nem hagyja el a készüléket, és minden MI-funkció ki van kapcsolva, amíg itt be nem kapcsolod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto gira su questo telefono con Apple Intelligence. Funziona offline, niente di quello che scrivi lascia il dispositivo e ogni funzione IA resta spenta finché non la attivi qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて Apple Intelligence を使ってこの iPhone の中で動きます。オフラインでも使えて、入力した内容が端末の外に出ることはありません。AI 機能はどれも、ここでオンにするまで動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 이 폰에서 Apple Intelligence로 돌아가요. 오프라인에서도 되고, 입력한 내용은 기기 밖으로 안 나가요. 모든 AI 기능은 여기서 켜기 전까진 꺼져 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya berjalan pada telefon ini dengan Apple Intelligence. Ia berfungsi luar talian, apa yang anda taip tak keluar dari peranti, dan setiap ciri AI kekal mati sampai anda hidupkannya di sini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Corre tudo neste telefone com a Apple Intelligence. Funciona offline, nada do que escreves sai do dispositivo, e todas as funcionalidades de IA ficam desligadas até as ligares aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё работает на этом телефоне через Apple Intelligence. Он обходится без сети, ничего из напечатанного не покидает устройство, и каждая функция ИИ выключена, пока вы не включите её здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都靠 Apple Intelligence 在这台手机上运行。离线也能用，你输入的内容不会离开设备，每项 AI 功能都是关着的，直到你在这里打开它。"
          }
        }
      }
    },
    "Everything runs on-device": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles loop op die toestel"
          }
