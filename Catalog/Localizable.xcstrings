    "Microphone or speech recognition access is turned off for Clink. Turn it back on to dictate.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toegang tot mikrofoon of spraakherkenning is afgeskakel vir Clink. Skakel dit weer aan om te dikteer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff aufs Mikrofon oder die Spracherkennung ist für Clink deaktiviert. Schalte ihn wieder ein, um zu diktieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al micrófono o al reconocimiento de voz está desactivado para Clink. Vuelve a activarlo para dictar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkil on mikrofoni või kõnetuvastuse juurdepääs välja lülitatud. Lülita see tagasi sisse, et dikteerida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au micro ou à la reconnaissance vocale est désactivé pour Clink. Réactive-le pour dicter."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofonhoz vagy a beszédfelismeréshez való hozzáférés ki van kapcsolva a Clinknél. Kapcsold vissza, hogy diktálhass."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al microfono o al riconoscimento vocale è disattivato per Clink. Riattivalo per dettare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink のマイクまたは音声認識へのアクセスがオフになっています。もう一度オンにすると音声入力を使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink의 마이크 또는 음성 인식 접근 권한이 꺼져 있어요. 다시 켜면 받아쓸 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon atau pengecaman pertuturan dimatikan untuk Clink. Hidupkannya semula untuk berimlak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone ou ao reconhecimento de voz está desligado para o Clink. Volta a ligá-lo para ditares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для Clink выключен доступ к микрофону или распознаванию речи. Включите его снова, чтобы диктовать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink 的麦克风或语音识别权限被关掉了。重新打开就能口述输入。"
          }
        }
      }
    },
