    "Translation already works offline. Turn this on for better results.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertaling werk reeds vanlyn. Skakel dit aan vir beter resultate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzen funktioniert schon offline. Schalt das für bessere Ergebnisse ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción ya funciona sin conexión. Activa esto para obtener mejores resultados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlge töötab juba ühenduseta. Lülita see sisse paremate tulemuste jaoks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction marche déjà hors ligne. Active ça pour de meilleurs résultats."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fordítás offline is működik. Kapcsold be a jobb eredményekért."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione funziona già offline. Attivala per risultati migliori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳はすでにオフラインで動きます。より良い結果のためにはこれをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역은 이미 오프라인으로 돼요. 더 나은 결과를 원하면 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan sudah berfungsi luar talian. Hidupkan ini untuk hasil lebih baik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução já funciona offline. Liga isto para melhores resultados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод и так работает офлайн. Включите это, чтобы результат стал лучше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译本来就能离线用。想要更好的效果就打开这个。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducerea funcționează deja offline. Activați acest lucru pentru rezultate mai bune."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertalen werkt al offline. Schakel dit in voor betere resultaten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻譯本來就能離線用。想要更好的效果就開啟這個。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tłumaczenie działa już w trybie offline. Włącz tę opcję, aby uzyskać lepsze wyniki."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переклад вже працює офлайн. Увімкніть це для кращих результатів."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri zaten çevrimdışı çalışıyor. Daha iyi sonuçlar için bunu açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překlad již funguje offline. Zapněte toto pro lepší výsledky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Preklad už funguje offline. Zapnite toto pre lepšie výsledky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μετάφραση λειτουργεί ήδη εκτός σύνδεσης. Ενεργοποιήστε το για καλύτερα αποτελέσματα."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Översättning fungerar redan offline. Slå på detta för bättre resultat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oversættelse fungerer allerede offline. Slå dette til for bedre resultater."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oversettelse fungerer allerede offline. Slå på dette for bedre resultater."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käännös toimii jo offline-tilassa. Ota tämä käyttöön saadaksesi parempia tuloksia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan sudah berfungsi offline. Aktifkan ini untuk hasil yang lebih baik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dịch đã hoạt động ngoại tuyến. Hãy bật tính năng này để có kết quả tốt hơn."
          }
        }
      }
    },
    "Translation already works offline. Turn this on if you'd rather use Apple Intelligence for better results, all on your device.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertaling werk reeds vanlyn. Skakel dit aan as jy eerder Apple Intelligence wil gebruik vir beter resultate, alles op jou toestel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzen funktioniert schon offline. Schalt das ein, wenn du für bessere Ergebnisse lieber Apple Intelligence nimmst, alles auf deinem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción ya funciona sin conexión. Activa esto si prefieres usar Apple Intelligence para mejores resultados, todo en tu dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlge töötab juba ühenduseta. Lülita see sisse, kui eelistad paremate tulemuste jaoks Apple Intelligence’i, kõik sinu seadmes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction marche déjà hors ligne. Active ça si tu préfères utiliser Apple Intelligence pour de meilleurs résultats, le tout sur ton appareil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fordítás offline is működik. Kapcsold be, ha inkább az Apple Intelligence-t szeretnéd jobb eredményhez, mindezt a te eszközödön."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione funziona già offline. Attivala se preferisci usare Apple Intelligence per risultati migliori, tutto sul tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳はすでにオフラインで動きます。より良い結果のために Apple Intelligence を使いたいときはこれをオンにしてください。すべてデバイスの中で処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역은 이미 오프라인으로 잘 돼요. 더 나은 결과를 원하면 이걸 켜서 Apple Intelligence를 쓰면 돼요. 전부 기기에서 처리돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan sudah berfungsi luar talian. Hidupkan ini jika anda lebih suka guna Apple Intelligence untuk hasil lebih baik, semuanya pada peranti anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução já funciona offline. Liga isto se preferires usar o Apple Intelligence para melhores resultados, tudo no teu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод и так работает офлайн. Включите это, если хотите более качественный результат через Apple Intelligence — всё на вашем устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译本来就能离线用。如果你更想用 Apple Intelligence 换更好的效果，就开这个，全都在你的设备上完成。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducerea funcționează deja offline. Activați această opțiune dacă preferați să utilizați Apple Intelligence pentru rezultate mai bune, toate pe dispozitivul dvs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertalen werkt al offline. Schakel dit in als u liever Apple Intelligence gebruikt voor betere resultaten, allemaal op uw apparaat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻譯本來就能離線用。如果你更想用 Apple Intelligence 換更好的效果，就開這個，全都在你的裝置上完成。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tłumaczenie działa już w trybie offline. Włącz tę opcję, jeśli wolisz używać Apple Intelligence w celu uzyskania lepszych wyników, a wszystko to na swoim urządzeniu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переклад вже працює офлайн. Увімкніть це, якщо ви бажаєте використовувати Apple Intelligence для кращих результатів на своєму пристрої."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri zaten çevrimdışı çalışıyor. Daha iyi sonuçlar için Apple Intelligence'i cihazınızda kullanmayı tercih ediyorsanız bunu açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překlad již funguje offline. Toto zapněte, pokud chcete pro lepší výsledky používat Apple Intelligence, to vše na vašem zařízení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Preklad už funguje offline. Túto možnosť zapnite, ak chcete na dosiahnutie lepších výsledkov radšej použiť Apple Intelligence, a to všetko vo svojom zariadení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μετάφραση λειτουργεί ήδη εκτός σύνδεσης. Ενεργοποιήστε το εάν προτιμάτε να χρησιμοποιήσετε το Apple Intelligence για καλύτερα αποτελέσματα, όλα στη συσκευή σας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Översättning fungerar redan offline. Aktivera detta om du hellre vill använda Apple Intelligence för bättre resultat, allt på din enhet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oversættelse fungerer allerede offline. Slå dette til, hvis du hellere vil bruge Apple Intelligence for bedre resultater, alt sammen på din enhed."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oversettelse fungerer allerede offline. Slå på dette hvis du heller vil bruke Apple Intelligence for bedre resultater, alt på enheten din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käännös toimii jo offline-tilassa. Ota tämä käyttöön, jos haluat mieluummin käyttää Apple Intelligence:ää saadaksesi parempia tuloksia laitteellasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan sudah berfungsi offline. Aktifkan ini jika Anda lebih suka menggunakan Apple Intelligence untuk hasil yang lebih baik, semuanya di perangkat Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dịch đã hoạt động ngoại tuyến. Hãy bật tính năng này nếu bạn muốn sử dụng Apple Intelligence để có kết quả tốt hơn, tất cả đều có trên thiết bị của bạn."
          }
        }
      }
    },
