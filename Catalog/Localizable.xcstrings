            "value": "Fjerner hvert tilpasset tema og dets bakgrunnsbilder permanent."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa pysyvästi kaikki mukautetut teemat ja sen taustakuvat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus secara permanen setiap tema khusus dan foto latar belakangnya."
