    "e.g. Correctly punctuate and formalize what I say": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Setz meine Zeichensetzung richtig und formuliere es förmlicher"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej. Puntúa bien lo que digo y hazlo más formal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ex. Ponctue correctement ce que je dis et rends-le plus formel"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "pl. Tedd helyesen a központozást, és fogalmazd hivatalosabbra"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "es. Punteggia bene quello che dico e rendilo più formale"
          }
