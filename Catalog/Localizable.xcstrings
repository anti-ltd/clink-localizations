            "value": "Tashkeel sustituye las acciones actuales al mantener pulsada esta tecla por sus signos árabes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel remplace les actions d’appui prolongé actuelles de cette touche par ses signes arabes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel ersetzt die aktuellen Halteaktionen dieser Taste durch arabische Zeichen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel sostituisce le attuali azioni di pressione prolungata di questo tasto con i segni arabi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tashkeel substitui as ações atuais de toque longo desta tecla pelos seus sinais árabes."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel menggantikan tindakan tekan lama kekunci ini dengan tanda Arabnya."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tashkeel a billentyű jelenlegi hosszan nyomás műveleteit arab jelekre cseréli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeelはこのキーの現在の長押しアクションをアラビア語の記号に置き換えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel 会用阿拉伯语符号替换此按键当前的长按操作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel은 이 키의 현재 길게 누르기 동작을 아랍어 기호로 바꿉니다."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel asendab selle klahvi praegused pikalt vajutamise toimingud araabia märkidega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashkeel заменит текущие действия удержания этой клавиши арабскими знаками."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tashkeel vervang hierdie sleutel se huidige hou-aksies met sy Arabiese merke."
          }
        }
      }
    },
    "The switcher follows the Tools menu style: choose Grid for tiles or Cards for a list.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
