    "Quick notepad is off. Turn it on to use and customize it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinnige notaboek is af. Skakel dit aan om dit te gebruik en aan te pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Notizblock ist aus. Schalte ihn ein, um ihn zu nutzen und anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloc rápido está desactivado. Actívalo para usarlo y personalizarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiirmärkmik on väljas. Lülita see sisse, et kasutada ja kohandada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bloc-notes est désactivé. Active-le pour l'utiliser et le personnaliser."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gyorsjegyzet ki van kapcsolva. Kapcsold be, hogy használhasd és beállíthasd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco note è disattivato. Attivalo per usarlo e personalizzarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモはオフです。オンにすると使えて、設定も変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 메모가 꺼져 있어요. 켜면 쓰고 설정도 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota pantas dimatikan. Hidupkannya untuk guna dan sesuaikannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O bloco de notas está desligado. Liga-o para o usares e personalizares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрый блокнот выключен. Включите его, чтобы пользоваться и настраивать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速记事已关闭。打开后就能使用并调整设置。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocul de note rapid este dezactivat. Porniți-l pentru ao utiliza și personalizați."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snel Kladblok staat uit. Schakel het in om het te gebruiken en aan te passen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速記事已關閉。開啟後就能使用並調整設定。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybki notatnik jest wyłączony. Włącz go, aby go używać i dostosowywać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Швидкий блокнот вимкнено. Увімкніть його, щоб використовувати та налаштовувати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı not defteri kapalı. Kullanmak ve özelleştirmek için açın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychlý poznámkový blok je vypnutý. Zapněte jej, abyste jej mohli používat a přizpůsobovat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rýchly poznámkový blok je vypnutý. Zapnite ho, aby ste ho mohli používať a prispôsobovať."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Quick Notepad είναι απενεργοποιημένο. Ενεργοποιήστε το για να το χρησιμοποιήσετε και να το προσαρμόσετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snabbanteckningsblocket är avstängt. Slå på den för att använda och anpassa den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtig notesblok er slukket. Tænd den for at bruge og tilpasse den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtignotisblokk er av. Slå den på for å bruke og tilpasse den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikamuistio on pois päältä. Ota se käyttöön, jotta voit käyttää ja muokata sitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notepad cepat tidak aktif. Aktifkan untuk menggunakan dan menyesuaikannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Notepad nhanh đã tắt. Bật nó lên để sử dụng và tùy chỉnh nó."
          }
        }
      }
    },
