        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Largura da linha do rasto desenhada debaixo do teu dedo ao deslizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ширина линии следа, которая рисуется под пальцем во время скольжения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
