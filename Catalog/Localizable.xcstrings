          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoeveel die spasiebalk uitbrei wanneer getik word."
          }
        }
      }
    },
    "How much the space bar tilts in the direction you're sliding the cursor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark sich die Leertaste in die Richtung neigt, in die du den Cursor schiebst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto se inclina la barra espaciadora hacia el lado al que deslizas el cursor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De combien la barre d'espace s'incline dans le sens où tu fais glisser le curseur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyire dől a szóköz abba az irányba, amerre a kurzort csúsztatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto si inclina la barra spaziatrice nella direzione in cui fai scorrere il cursore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルをスライドさせる向きに、スペースバーがどれくらい傾くかです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서를 미는 방향으로 스페이스바가 얼마나 기우는지예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak bar ruang condong ke arah anda meluncurkan kursor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto a barra de espaços se inclina na direção em que deslizas o cursor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько пробел наклоняется в ту сторону, куда вы ведёте курсор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
