    "Your keyboard is exactly as it shipped. Anything you change turns up here, so you can find it again or put it back.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou sleutelbord is presies soos dit verskeep is. Enigiets wat jy verander, verskyn hier, sodat jy dit weer kan vind of terugsit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tastatur ist genau so, wie sie ausgeliefert wurde. Alles, was du änderst, taucht hier auf, damit du es wiederfindest oder zurückstellst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teclado está tal como vino. Todo lo que cambies aparecerá aquí, para que puedas encontrarlo o dejarlo como estaba."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu klaviatuur on täpselt väljalaskeolekus. Kõik, mida muudad, ilmub siia, et saaksid selle üles leida või tagasi panna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton clavier est exactement dans son état d’origine. Tout ce que tu modifies apparaît ici, pour le retrouver ou le remettre comme avant."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzeted pontosan olyan, amilyen érkezett. Amit megváltoztatsz, itt bukkan fel, hogy visszataláld vagy visszaállítsd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua tastiera è esattamente com’era all’inizio. Tutto ciò che cambi compare qui, così lo ritrovi o lo rimetti com’era."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードは出荷時のままです。変更したものはここに並ぶので、あとから見つけたり元に戻したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 처음 상태 그대로입니다. 무엇이든 바꾸면 여기에 나타나므로 다시 찾거나 되돌릴 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan kekunci anda betul-betul seperti asal. Apa sahaja yang anda ubah akan muncul di sini, supaya anda boleh menjumpainya semula atau mengembalikannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu teclado está tal como veio. Tudo o que mudares aparece aqui, para o encontrares outra vez ou o pores como estava."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша клавиатура ровно такая, какой вышла из коробки. Всё, что вы измените, появится здесь — чтобы найти это снова или вернуть обратно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的键盘和出厂时一模一样。你改动的任何设置都会出现在这里，方便你再找到它或还原。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastatura dvs. este exact așa cum a fost expediată. Orice schimbați apare aici, așa că îl puteți găsi din nou sau îl puteți pune înapoi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw toetsenbord is precies zoals het is verzonden. Alles wat u wijzigt, wordt hier weergegeven, zodat u het kunt terugvinden of terugplaatsen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的鍵盤和出廠時一模一樣。你改動的任何設定都會出現在這裡，方便你再找到它或還原。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja klawiatura jest dokładnie taka, jak została wysłana. Wszystko, co zmienisz, pojawi się tutaj, więc możesz to znaleźć ponownie lub odłożyć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша клавіатура точно така, як вона постачається. Усе, що ви змінюєте, з’являється тут, тому ви можете знайти це знову або повернути назад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyeniz tam olarak gönderildiği gibidir. Değiştirdiğiniz her şey burada görünür, böylece onu tekrar bulabilir veya geri koyabilirsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše klávesnice je přesně taková, jak byla dodána. Cokoli změníte, objeví se zde, takže to můžete znovu najít nebo vrátit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša klávesnica je presne taká, ako bola dodaná. Všetko, čo zmeníte, sa objaví tu, takže to môžete znova nájsť alebo vrátiť."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πληκτρολόγιό σας είναι ακριβώς όπως αποστέλλεται. Οτιδήποτε αλλάζετε εμφανίζεται εδώ, ώστε να μπορείτε να το βρείτε ξανά ή να το επαναφέρετε."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt tangentbord är exakt som det levererades. Allt du ändrar dyker upp här, så att du kan hitta det igen eller lägga tillbaka det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit tastatur er præcis, som det blev leveret. Alt, hvad du ændrer, dukker op her, så du kan finde det igen eller lægge det tilbage."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturet ditt er akkurat slik det ble levert. Alt du endrer dukker opp her, slik at du kan finne det igjen eller sette det tilbake."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näppäimistö on juuri sellainen kuin se toimitettiin. Kaikki mitä muutat, ilmestyy tänne, joten voit löytää sen uudelleen tai laittaa sen takaisin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard Anda persis seperti yang dikirimkan. Apa pun yang Anda ubah akan muncul di sini, sehingga Anda dapat menemukannya lagi atau mengembalikannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bàn phím của bạn chính xác như khi được vận chuyển. Bất cứ điều gì bạn thay đổi sẽ xuất hiện ở đây, vì vậy bạn có thể tìm lại hoặc đặt lại."
          }
        }
      }
    },
