        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A téma színét, színátmenetét vagy fotóját festi a billentyűk mögé. Kikapcsolva átlátszik az app, amelybe éppen gépelsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipinge il colore, il gradiente o la foto del tema dietro i tasti. Disattivato, si vede l'app in cui stai scrivendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマの色、グラデーション、写真をキーの後ろに描きます。オフにすると、入力中のアプリが透けて見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마의 색상, 그러데이션, 사진을 키 뒤에 칠합니다. 끄면 입력 중인 앱이 그대로 비칩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Melukis warna, gradien atau foto tema di belakang kekunci. Bila dimatikan, apl yang anda taip padanya kelihatan menembusi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta a cor, o gradiente ou a fotografia do tema por trás das teclas. Desligado, vê-se a app onde estás a escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисовать за клавишами цвет, градиент или фото темы. Выключено — сквозь них видно приложение, в котором вы печатаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在按键后方绘制主题的颜色、渐变或照片。关闭后，正在输入的 App 会透出来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paint the theme’s color, gradient or photo behind the keys. Off, the app you’re typing in shows through."
          }
        }
      }
    },
