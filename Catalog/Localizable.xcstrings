    "Removes every word Clink picked up from your typing. Custom words stay.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwyder elke woord wat geklink word van jou tikwerk. Gepasmaakte woorde bly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt alle Wörter, die Clink aus deinem Tippen übernommen hat. Eigene Wörter bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todas las palabras que Clink aprendió de tu escritura. Se conservan las palabras personalizadas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemaldab kõik sõnad, mille Clink sinu tippimisest õppis. Kohandatud sõnad jäävad alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime tous les mots que Clink a appris en tapant. Les mots personnalisés restent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolít minden szót, amit Clink a gépelésedből tanult. A saját szavak megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove tutte le parole che Clink ha imparato dalla tua digitazione. Le parole personalizzate restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink が入力から学習した単語をすべて削除します。カスタム単語は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink가 입력에서 학습한 모든 단어를 제거합니다. 사용자 단어는 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengalih keluar semua perkataan yang dipelajari Clink daripada taipan anda. Perkataan tersuai kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove todas as palavras que o Clink aprendeu com a sua digitação. As palavras personalizadas permanecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет все слова, которые Clink выучил из вашего ввода. Пользовательские слова сохраняются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 Clink 从你的输入中学到的所有词语。自定义词语会保留。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină fiecare cuvânt Clink preluat din tastarea dvs. Cuvintele personalizate rămân."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert elk woord dat Clink heeft opgepikt tijdens het typen. Aangepaste woorden blijven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 Clink 從你的輸入中學到的所有詞語。自定義詞語會保留。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa każde słowo, które Clink wczytał podczas pisania. Niestandardowe słowa pozostają."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє кожне слово, яке Clink підібрав під час введення. Користувацькі слова залишаються."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink'in yazarken yakaladığı her kelimeyi kaldırır. Özel kelimeler kalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraní každé slovo, které Clink zachytil z vašeho psaní. Vlastní slova zůstávají."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstráni každé slovo, ktoré Clink zachytil z vášho písania. Vlastné slová zostávajú."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταργεί κάθε λέξη που έχει συλλέξει το Clink από την πληκτρολόγησή σας. Οι προσαρμοσμένες λέξεις μένουν."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar bort varje ord Clink som plockas upp från din skrivning. Anpassade ord stannar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner hvert ord Clink opfanget fra din indtastning. Brugerdefinerede ord bliver."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner hvert ord Clink plukket opp fra skrivingen din. Egendefinerte ord blir værende."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa jokaisen sanan, jonka Clink poimi kirjoittamisestasi. Mukautetut sanat pysyvät."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus setiap kata yang diambil Clink dari pengetikan Anda. Kata-kata khusus tetap ada."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa mọi từ Clink có được khi bạn gõ. Từ tùy chỉnh ở lại."
          }
        }
      }
    },
    "Removes the restarts recorded on this device. Nothing else changes.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwyder die herbeginsels wat op hierdie toestel aangeteken is. Niks anders verander nie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt die auf diesem Gerät gespeicherten Neustarts. Sonst ändert sich nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina los reinicios guardados en este dispositivo. No cambia nada más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemaldab sellesse seadmesse salvestatud taaskäivitused. Midagi muud ei muutu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les redémarrages enregistrés sur cet appareil. Rien d'autre ne change."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törli az ezen az eszközön rögzített újraindulásokat. Más nem változik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove i riavvii registrati su questo dispositivo. Nient'altro cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末に記録された再起動を削除します。ほかには何も変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 기록된 다시 시작 항목을 지워요. 다른 건 그대로예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuang mula semula yang direkodkan pada peranti ini. Tiada apa-apa lagi berubah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove os reinícios registados neste dispositivo. Não muda mais nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет записи о перезапусках на этом устройстве. Больше ничего не меняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除这台设备上记录的重启信息。其他内容不受影响。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină repornirile înregistrate pe acest dispozitiv. Nimic altceva nu se schimbă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert de herstarts die op dit apparaat zijn opgenomen. Verder verandert er niets."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除這臺裝置上記錄的重啟資訊。其他內容不受影響。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa ponowne uruchomienia zapisane na tym urządzeniu. Nic innego się nie zmienia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє перезапуски, записані на цьому пристрої. Більше нічого не змінюється."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda kayıtlı yeniden başlatmaları kaldırır. Başka hiçbir şey değişmiyor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraní restarty zaznamenané na tomto zařízení. Nic jiného se nemění."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstráni reštarty zaznamenané na tomto zariadení. Nič iné sa nemení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταργεί τις επανεκκινήσεις που έχουν καταγραφεί σε αυτήν τη συσκευή. Τίποτα άλλο δεν αλλάζει."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar bort omstarter som registrerats på den här enheten. Inget annat förändras."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner genstarter, der er optaget på denne enhed. Intet andet ændrer sig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner omstartene som er registrert på denne enheten. Ingenting annet endres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa tälle laitteelle tallennetut uudelleenkäynnistykset. Mikään muu ei muutu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus restart yang direkam pada perangkat ini. Tidak ada hal lain yang berubah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa các lần khởi động lại được ghi trên thiết bị này. Không có gì khác thay đổi."
          }
        }
      }
    },
