    "The other keys in the row give way to make space. You can also drag a key's edge in the preview.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ander sleutels in die ry maak plek om plek te maak. Jy kan ook 'n sleutel se rand in die voorskou sleep."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die anderen Tasten der Reihe machen Platz. Du kannst auch in der Vorschau am Rand einer Taste ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las demás teclas de la fila se apartan para hacer sitio. También puedes arrastrar el borde de una tecla en la vista previa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülejäänud klahvid reas teevad ruumi. Sa võid ka eelvaates klahvi serva lohistada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres touches de la rangée s'écartent pour faire de la place. Tu peux aussi tirer le bord d'une touche dans l'aperçu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sor többi billentyűje helyet ad neki. Az előnézetben a billentyű szélét is húzhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli altri tasti della riga si stringono per fare spazio. Puoi anche trascinare il bordo di un tasto nell'anteprima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ行のほかのキーが縮んで場所を空けます。プレビューでキーの端をドラッグしても変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 행의 다른 키들이 자리를 내줘요. 미리보기에서 키의 가장자리를 끌어도 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci lain dalam baris itu beralah untuk beri ruang. Anda juga boleh seret tepi kekunci dalam pratonton."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As outras teclas da linha abrem espaço. Também podes puxar a extremidade de uma tecla na pré-visualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остальные клавиши в ряду подвинутся, освобождая место. Можно также потянуть за край клавиши в предпросмотре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一行的其他按键会让出空间。你也可以在预览里拖按键的边缘。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Celelalte taste din rând cedează loc pentru a face spațiu. De asemenea, puteți trage marginea unei taste în previzualizare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De andere toetsen in de rij maken plaats om ruimte te maken. U kunt ook de rand van een toets in het voorbeeld slepen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一行的其他按鍵會讓出空間。你也可以在預覽裡拖按鍵的邊緣。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostałe klawisze w rzędzie ustępują, aby zrobić miejsce. Możesz także przeciągnąć krawędź klawisza na podglądzie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інші клавіші в рядку звільняють місце. Ви також можете перетягнути край клавіші в попередньому перегляді."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıradaki diğer tuşlar yer açmak için yer açıyor. Ayrıca önizlemede bir anahtarın kenarını da sürükleyebilirsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatní klávesy v řadě uvolňují místo. V náhledu můžete také přetáhnout okraj klávesy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatné klávesy v rade ustupujú, aby sa vytvoril priestor. V náhľade môžete tiež potiahnuť okraj klávesu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα άλλα πλήκτρα στη σειρά δίνουν τη θέση τους για να κάνουν χώρο. Μπορείτε επίσης να σύρετε την άκρη ενός κλειδιού στην προεπισκόπηση."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De andra nycklarna i raden ger vika för att göra utrymme. Du kan också dra en tangents kant i förhandsgranskningen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De andre taster i rækken giver plads for at gøre plads. Du kan også trække en nøgles kant i forhåndsvisningen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De andre tastene i raden viker for å gjøre plass. Du kan også dra en nøkkelkant i forhåndsvisningen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muut rivin näppäimet antavat tilaa tehdäkseen tilaa. Voit myös vetää näppäimen reunaa esikatselussa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol lain di baris memberi jalan untuk memberi ruang. Anda juga dapat menyeret tepi tombol di pratinjau."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím khác trong hàng nhường chỗ cho khoảng trống. Bạn cũng có thể kéo cạnh của phím trong bản xem trước."
          }
        }
      }
    },
    "The output is inserted at the cursor, keeping the input.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die afvoer word by die wyser ingevoeg, en behou die invoer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgabe wird an der Cursorposition eingefügt, deine Eingabe bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado se inserta donde tengas el cursor y se conserva lo que escribiste."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Väljund sisestatakse kursori kohale, sisend jääb alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat s'insère au niveau du curseur, sans toucher au texte d'origine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kimenet a kurzorhoz kerül be, a bevitt szöveg megmarad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'output viene inserito al cursore, tenendo l'input."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力はそのままに、カーソル位置に結果を挿入します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력한 내용은 그대로 두고 커서 위치에 결과가 들어가요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasilnya dimasukkan pada kursor, input anda kekal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado é inserido no cursor, mantendo o que escreveste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат вставляется у курсора, а исходный текст остаётся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果会插入到光标处，输入的内容还留着。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieșirea este inserată la cursor, păstrând intrarea."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitvoer wordt ingevoegd bij de cursor, waarbij de invoer behouden blijft."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果會插入到游標處，輸入的內容還留著。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane wyjściowe zostaną wstawione przy kursorze, zachowując wprowadzone dane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
