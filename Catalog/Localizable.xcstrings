    "Slide to move the cursor, and lift where you want it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skuif om die wyser te beweeg en lig op waar jy dit wil hê."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh, um den Cursor zu bewegen, und heb den Finger dort, wo er stehen soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para mover el cursor y levanta el dedo donde lo quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Libista, et kursorit liigutada, ja tõsta sõrm seal, kus tahad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser pour déplacer le curseur et lève le doigt à l'endroit voulu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzással mozgasd a kurzort, és ott emeld fel az ujjad, ahol jó."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri per spostare il cursore e solleva il dito dove vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのままスライドしてカーソルを動かし、置きたい位置で指を離します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밀어서 커서를 옮기고, 원하는 자리에서 손가락을 떼세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret untuk menggerakkan kursor, dan angkat jari di tempat yang anda mahu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para mover o cursor e levanta o dedo onde o queres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведите, чтобы двигать курсор, и поднимите палец там, где он вам нужен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动移动光标，到位了就抬手。"
          }
        }
      }
    },
