    "Changes Clink’s menus and screens, not the languages you type in.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert die Sprache von Clinks Menüs und Bildschirmen, nicht die Sprachen, in denen du tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el idioma de los menús y las pantallas de Clink, no los idiomas en los que escribes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muudab Clinki menüüde ja ekraanide keelt, mitte keeli, milles tipid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change la langue des menus et des écrans de Clink, pas celles dans lesquelles vous écrivez."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Clink menüinek és képernyőinek nyelvét módosítja, nem azokat a nyelveket, amelyeken gépelsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la lingua dei menu e delle schermate di Clink, non le lingue in cui scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinkのメニューや画面の言語を変更します。入力する言語は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink의 메뉴와 화면 언어를 바꿔요. 입력하는 언어는 바뀌지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menukar bahasa menu dan skrin Clink, bukan bahasa yang anda taip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda o idioma dos menus e ecrãs do Clink, não os idiomas em que escreves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
