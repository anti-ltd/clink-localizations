    "Predicts your next letter and silently enlarges likely keys without moving them, like the native keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorspel jou volgende letter en vergroot stilweg waarskynlike sleutels sonder om hulle te skuif, soos die inheemse sleutelbord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagt deinen nächsten Buchstaben voraus und vergrößert wahrscheinliche Tasten ganz unauffällig, ohne sie zu verschieben, wie die native Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predice tu siguiente letra y agranda sin ruido las teclas probables, sin moverlas, como el teclado nativo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennustab sinu järgmise tähe ja suurendab vaikselt tõenäolisi klahve neid liigutamata, nagu süsteemne klaviatuur."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prédit ta prochaine lettre et agrandit discrètement les touches probables sans les bouger, comme le clavier natif."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjósolja a következő betűt, és csendben megnöveli a valószínű billentyűket anélkül, hogy elmozdítaná őket, mint a natív billentyűzet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevede la lettera che scriverai e ingrandisce di nascosto i tasti probabili senza spostarli, come la tastiera nativa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "純正キーボードのように、次に打つ文字を予測して、来そうなキーを動かさずにそっと大きくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 키보드처럼 다음 글자를 예측해서, 키를 옮기지 않고 나올 만한 키를 슬쩍 키워요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramal huruf anda seterusnya dan besarkan kekunci yang berkemungkinan secara senyap tanpa mengalihkannya, macam papan kekunci asli."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevê a tua próxima letra e aumenta discretamente as teclas prováveis sem as mexer, como o teclado nativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предсказывает следующую букву и незаметно увеличивает вероятные клавиши, не сдвигая их, — как родная клавиатура."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预测你的下一个字母，像原生键盘那样悄悄放大可能的键，但不挪动它们。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevăd următoarea ta literă și mărește în tăcere tastele probabile fără a le muta, cum ar fi tastatura nativă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorspelt je volgende letter en vergroot stilletjes de waarschijnlijke toetsen zonder ze te verplaatsen, net als bij het standaardtoetsenbord."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預測你的下一個字母，像原生鍵盤那樣悄悄放大可能的鍵，但不挪動它們。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przewiduje następną literę i cicho powiększa prawdopodobne klawisze bez ich przesuwania, jak natywna klawiatura."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогнозує вашу наступну літеру та безшумно збільшує ймовірні клавіші, не пересуваючи їх, як рідна клавіатура."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki harfinizi tahmin eder ve yerel klavye gibi olası tuşları hareket ettirmeden sessizce büyütür."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předvídá vaše další písmeno a tiše zvětšuje pravděpodobné klávesy, aniž by je pohybovala, jako nativní klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predpovedá vaše ďalšie písmeno a ticho zväčšuje pravdepodobné klávesy bez toho, aby ich posúvala, ako je to pri natívnej klávesnici."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προβλέπει το επόμενο γράμμα σας και μεγεθύνει αθόρυβα τα πιθανά πλήκτρα χωρίς να τα μετακινήσει, όπως το εγγενές πληκτρολόγιο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förutsäger din nästa bokstav och förstorar tyst troliga tangenter utan att flytta dem, som det inbyggda tangentbordet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forudsiger dit næste bogstav og forstørrer sandsynlige taster lydløst uden at flytte dem, som det oprindelige tastatur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forutsier den neste bokstaven din og forstørrer sannsynlige taster stille uten å flytte dem, som det opprinnelige tastaturet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennustaa seuraavan kirjaimen ja suurentaa äänettömästi todennäköisiä näppäimiä siirtämättä niitä, kuten alkuperäistä näppäimistöä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memprediksi huruf berikutnya dan secara diam-diam memperbesar kemungkinan tombol tanpa memindahkannya, seperti keyboard asli."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dự đoán chữ cái tiếp theo của bạn và âm thầm phóng to các phím có thể có mà không cần di chuyển chúng, giống như bàn phím gốc."
          }
        }
      }
    },
