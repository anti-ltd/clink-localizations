    "Typing stays on your device. Accounts are optional.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que escribes se queda en tu dispositivo. Las cuentas son opcionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tu tapes reste sur ton appareil. Les comptes sont facultatifs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Eingaben bleiben auf deinem Gerät. Ein Konto ist freiwillig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che digiti resta sul dispositivo. L’account è facoltativo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que escreves fica no teu dispositivo. A conta é opcional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводимый текст остаётся на устройстве. Аккаунт необязателен."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang anda taip kekal pada peranti. Akaun adalah pilihan sahaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A begépelt szöveg az eszközödön marad. A fiók nem kötelező."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
