    "Touch target size for each key relative to the visible key. Lower is more precise, higher catches more taps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch-Zielgröße jeder Taste im Verhältnis zur sichtbaren Taste. Niedriger ist präziser, höher fängt mehr Tippfehler ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño del objetivo táctil de cada tecla respecto a la tecla visible. Menor es más preciso, mayor capta más toques."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga klahvi puutepiirkond võrreldes nähtava klahviga. Väiksem on täpsem, suurem püüab rohkem puudutusi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille de la cible tactile de chaque touche par rapport à la touche visible. Plus bas est plus précis, plus haut capte plus de frappes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden billentyű érintési célterülete a látható billentyűhöz képest. Alacsonyabb pontosabb, magasabb több érintést fog meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensione del bersaglio tattile di ogni tasto rispetto al tasto visibile. Più basso è più preciso, più alto cattura più tocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見えているキーに対する各キーのタッチ判定領域のサイズ。小さいほど正確、大きいほどタップを拾いやすい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보이는 키 대비 각 키의 터치 영역 크기. 낮을수록 정밀하고 높을수록 더 많은 탭을 잡습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saiz sasaran sentuhan setiap kekunci berbanding kekunci yang kelihatan. Lebih rendah lebih tepat, lebih tinggi menangkap lebih banyak ketukan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho do alvo tátil de cada tecla em relação à tecla visível. Menor é mais preciso, maior capta mais toques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер области касания каждой клавиши относительно видимой клавиши. Меньше — точнее, больше — ловит больше нажатий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个按键的触摸目标大小相对于可见按键。较低更精确，较高能捕捉更多点击。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Raak teikengrootte vir elke sleutel relatief tot die sigbare sleutel. Laer is meer presies, hoër vang meer krane."
          }
        }
      }
    },
