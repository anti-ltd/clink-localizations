    "Copy the text below. Speed uses correct characters; every five counts as one word.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe den Text unten ab. Für das Tempo zählen nur richtige Zeichen. Je fünf Zeichen ergeben ein Wort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the text below. Speed uses correct characters; every five counts as one word."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia el texto de abajo. La velocidad se calcula con los caracteres correctos: cada cinco cuentan como una palabra."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjuta allolev tekst ümber. Kiirust arvutatakse õigesti sisestatud märkide järgi: viis märki loetakse üheks sõnaks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recopie le texte ci-dessous. La vitesse est calculée à partir des caractères corrects : cinq caractères comptent pour un mot."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Másold le az alábbi szöveget. A sebességet a helyesen beírt karakterekből számítjuk: öt karakter egy szónak felel meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricopia il testo qui sotto. La velocità si basa sui caratteri corretti: ogni cinque caratteri contano come una parola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の文章を入力してください。正しく入力した文字で速度を計算し、5文字を1語として数えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 문장을 그대로 입력해 주세요. 속도는 정확히 입력한 글자를 기준으로 계산하며, 다섯 글자를 한 단어로 셉니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip semula teks di bawah. Kelajuan dikira berdasarkan aksara yang betul; setiap lima aksara dikira sebagai satu perkataan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia o texto abaixo. A velocidade é calculada a partir dos caracteres corretos: cada cinco contam como uma palavra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перепечатайте текст ниже. Скорость рассчитывается по верно набранным символам: каждые пять символов считаются одним словом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照着下方的文字输入。速度按正确输入的字符计算，每5个字符计为一个词。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiați textul de mai jos. Viteza folosește caractere corecte; fiecare cinci contează ca un cuvânt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieer onderstaande tekst. Snelheid gebruikt correcte karakters; elke vijf telt als één woord."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照著下方的文字輸入。速度按正確輸入的字元計算，每5個字元計為一個詞。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieer die teks hieronder. Spoed gebruik korrekte karakters; elke vyf tel as een woord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiuj poniższy tekst. Prędkość używa poprawnych znaków; każde pięć liczy się jako jedno słowo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопіюйте наведений нижче текст. Швидкість використовує правильні символи; кожні п'ять вважаються одним словом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki metni kopyalayın. Hız doğru karakterleri kullanır; her beşi bir kelime sayılır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkopírujte text níže. Rychlost používá správné znaky; každých pět se počítá jako jedno slovo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopírujte text nižšie. Rýchlosť používa správne znaky; každých päť sa počíta ako jedno slovo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντιγράψτε το παρακάτω κείμενο. Η ταχύτητα χρησιμοποιεί σωστούς χαρακτήρες. κάθε πέντε μετράει ως μία λέξη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiera texten nedan. Speed ​​använder korrekta tecken; var femte räknas som ett ord."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopier teksten nedenfor. Speed ​​bruger korrekte tegn; hver femte tæller som ét ord."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopier teksten nedenfor. Speed ​​bruker riktige tegn; hver femte teller som ett ord."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioi alla oleva teksti. Speed ​​käyttää oikeita merkkejä; joka viides lasketaan yhdeksi sanaksi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin teks di bawah ini. Kecepatan menggunakan karakter yang benar; setiap lima dihitung sebagai satu kata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao chép văn bản dưới đây. Tốc độ sử dụng ký tự chính xác; cứ năm chữ được tính là một từ."
          }
        }
      }
    },
