            "value": "설정의 인공지능에서 끌 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikannya di bawah Kecerdasan Buatan dalam tetapan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga-o em Inteligência artificial, nas definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключить это можно в настройках, в разделе «Искусственный интеллект»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想关就在设置的人工智能里关掉。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita see välja seadetes jaotises Tehisintellekt."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel dit af onder Kunsmatige Intelligensie in instellings."
          }
        }
      }
    },
    "Turn it on for custom haptics, clipboard history, and paste in panels.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalt ihn ein für eigene Haptik, Zwischenablageverlauf und Einfügen in Panels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo para vibración a tu gusto, historial del portapapeles y pegar en los paneles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active-le pour les vibrations perso, l'historique du presse-papiers et le collage dans les panneaux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be, ha egyéni rezgést, vágólap-előzményeket és beillesztést szeretnél a paneleken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo per vibrazioni personalizzate, cronologia appunti e incolla nei pannelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム触覚、クリップボード履歴、パネルへの貼り付けを使いたいときはオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커스텀 햅틱, 클립보드 기록, 패널 붙여넣기를 쓰려면 켜주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkannya untuk haptik tersuai, sejarah papan keratan dan tampal dalam panel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga-o para háptica à tua medida, histórico da área de transferência e colar nos painéis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите его ради своей тактильной отдачи, истории буфера обмена и вставки в панелях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开了它，就能用自定义触觉、剪贴板历史，还能在面板里粘贴。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita see sisse kohandatud haptika, lõikelaua ajaloo ja paneelides kleepimise jaoks."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skakel dit aan vir pasgemaakte haptics, knipbordgeskiedenis en plak in panele."
          }
        }
      }
    },
    "Turn it on. It's in the keyboard's tools menu straight away.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte es ein. Es steht sofort im Werkzeugmenü der Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívala. Aparece en el menú de herramientas del teclado al momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
