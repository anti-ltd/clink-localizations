    "Pick a style: a steady glow, a spectrum, a ripple that follows your typing.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies 'n styl: 'n bestendige gloed, 'n spektrum, 'n rimpeling wat jou tik volg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Stil: ruhiges Leuchten, Farbspektrum oder eine Welle, die deinem Tippen folgt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un estilo: brillo fijo, espectro o una onda que sigue tu escritura."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali stiil: kindel sära, spekter või laine, mis järgib sinu tipimist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un style : lueur fixe, spectre, ou onde qui suit ta frappe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz stílust: nyugodt fény, színskála vagy a gépelésedet követő hullám."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli uno stile: bagliore fisso, spettro, o un'onda che segue quello che scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタイルを選びます。落ち着いた発光、スペクトル、入力に合わせて広がる波などがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스타일을 고르세요. 은은한 발광, 스펙트럼, 입력을 따라 번지는 물결이 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih gaya: cahaya tetap, spektrum, atau riak yang mengikut taipan anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um estilo: brilho fixo, espetro, ou uma onda que segue a tua escrita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите стиль: ровное сияние, спектр или волну, идущую за вашей печатью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑一种样式：稳定的辉光、色谱，或跟着你打字扩散的涟漪。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți un stil: o strălucire constantă, un spectru, o ondulație care urmează tastarea dvs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een stijl: een constante gloed, een spectrum, een rimpeling die uw typen volgt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "挑一種樣式：穩定的輝光、色譜，或跟著你打字擴散的漣漪。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz styl: stały blask, widmo, fala podążająca za Twoim pisaniem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть стиль: рівне світіння, спектр, хвилі, які слідують за вашим набором."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir stil seçin: Sabit bir parlaklık, bir spektrum, yazınızı takip eden bir dalgalanma."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte si styl: stálou záři, spektrum, vlnění, které následuje po vašem psaní."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte si štýl: stálu žiaru, spektrum, vlnenie, ktoré nasleduje po vašom písaní."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ένα στυλ: μια σταθερή λάμψη, ένα φάσμα, έναν κυματισμό που ακολουθεί την πληκτρολόγησή σας."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en stil: en stadig glöd, ett spektrum, en krusning som följer ditt skrivande."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en stil: en stabil glød, et spektrum, en krusning, der følger din skrivning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en stil: en jevn glød, et spekter, en krusning som følger skrivingen din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse tyyli: tasainen hehku, spektri, aaltoilu, joka seuraa kirjoittamistasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih gaya: cahaya yang stabil, spektrum, riak yang mengikuti pengetikan Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một kiểu: ánh sáng ổn định, quang phổ, gợn sóng theo sau thao tác gõ của bạn."
          }
        }
      }
    },
    "Pick an animated background on Backdrop to give it colors.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
