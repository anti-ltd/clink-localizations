          "stringUnit": {
            "state": "translated",
            "value": "무료로 바뀌기 전에 구매하셨기 때문에 Clink는 평생 회원님의 것입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda membeli Clink sebelum ia menjadi percuma, jadi ia milik anda seumur hidup."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você comprou o Clink antes de ele ficar grátis, então ele é seu para sempre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы купили Clink до того, как он стал бесплатным, поэтому он ваш навсегда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 Clink 免费之前就已购买，所以它终身属于你。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai cumpărat Clink înainte de a fi gratuit, așa că este al tău pe viață."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt Clink gekocht voordat deze gratis werd, dus hij is levenslang van jou."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 Clink 免費之前就已購買，所以它終身屬於你。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupiłeś Clink, zanim został darmowy, więc jest Twój na całe życie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви купили Clink до того, як він став безкоштовним, тому він ваш на все життя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clink'i ücretsiz olmadan önce satın aldınız, yani ömür boyu sizindir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koupili jste si Clink předtím, než byl zdarma, takže je váš na celý život."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kúpili ste si Clink predtým, ako bol zadarmo, takže je váš na celý život."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγοράσατε το Clink προτού διατεθεί δωρεάν, επομένως είναι δικό σας εφ' όρου ζωής."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du köpte Clink innan den blev gratis, så den är din för livet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du købte Clink, før den blev gratis, så den er din for livet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kjøpte Clink før den ble gratis, så den er din for livet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostit Clink:n ennen kuin se meni ilmaiseksi, joten se on sinun loppuelämäsi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda membeli Clink sebelum menjadi gratis, jadi ini milik Anda seumur hidup."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã mua Clink trước khi nó miễn phí nên nó là của bạn suốt đời."
          }
        }
      }
    },
    "You can also put a Tools key wherever you like in the Layout editor.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy kan ook 'n Gereedskap-sleutel plaas waar jy wil in die uitlegredigeerder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Layout-Editor kannst du außerdem überall eine Werkzeug-Taste unterbringen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes poner una tecla de Herramientas donde quieras en el editor de disposición."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa võid ka paigutada tööriistaklahvi kuhu iganes Paigutuse redaktoris."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux aussi placer une touche Outils où tu veux dans l'éditeur de disposition."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elrendezésszerkesztőben bárhová tehetsz egy Eszközök billentyűt is."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi anche mettere un tasto Strumenti dove preferisci nell'editor del layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトエディタで、ツールキーを好きな場所に置くこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이아웃 편집기에서 도구 키를 원하는 자리에 놓을 수도 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda juga boleh meletakkan kekunci Alat di mana-mana dalam editor susun atur."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Também podes pôr uma tecla de Ferramentas onde quiseres no editor de esquemas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавишу инструментов можно поставить куда угодно в редакторе раскладки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你也可以在布局编辑器里，把工具键放到任何位置。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "De asemenea, puteți pune o cheie Instrumente oriunde doriți în editorul de aspect."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U kunt ook een Tools-toets plaatsen waar u maar wilt in de Layout-editor."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你也可以在佈局編輯器裡，把工具鍵放到任何位置。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz także umieścić klawisz Narzędzia w dowolnym miejscu w edytorze układu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви також можете розмістити клавішу «Інструменти» будь-де в редакторі макета."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıca Düzen düzenleyicide istediğiniz yere bir Araçlar tuşu koyabilirsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete také umístit klávesu Tools kamkoli v editoru rozložení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V editore rozloženia môžete tiež umiestniť kláves Tools kamkoľvek chcete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε επίσης να βάλετε ένα κλειδί Εργαλεία όπου θέλετε στο πρόγραμμα επεξεργασίας διάταξης."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan också placera en verktygsnyckel var du vill i layoutredigeraren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan også sætte en Værktøjsnøgle, hvor du vil, i Layout-editoren."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan også legge inn en verktøytast hvor du vil i layoutredigeringsprogrammet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit myös laittaa Työkalut-näppäimen minne tahansa asettelueditoriin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda juga dapat meletakkan kunci Alat di mana pun Anda suka di editor Layout."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn cũng có thể đặt phím Công cụ ở bất cứ đâu bạn muốn trong trình chỉnh sửa Bố cục."
          }
        }
      }
    },
    "You can build it yourself: give it a name, a layout, and a word list to spell-check against.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy kan dit self bou: gee dit 'n naam, 'n uitleg en 'n woordelys om na te gaan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst sie selbst anlegen: Name, Layout und eine Wortliste, gegen die geprüft wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes crearlo tú: le pones nombre, distribución y una lista de palabras con la que corregir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa saad ta ise ehitada: anna nimi, paigutus ja sõnaloend, mille vastu kontrollida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux la créer toi-même : un nom, une disposition, et une liste de mots pour la correction."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Magad is létrehozhatod: adj neki nevet, kiosztást és egy szólistát, amihez a helyesírás igazodik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi crearla tu: un nome, un layout e un elenco di parole su cui fare il controllo ortografico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分でつくれます。名前とレイアウトを決め、スペルチェック用の単語リストを用意するだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 만들 수 있습니다. 이름과 레이아웃을 정하고, 맞춤법 검사에 쓸 단어 목록을 넣으면 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh membinanya sendiri: beri nama, susun atur, dan senarai perkataan untuk semakan ejaan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes criá-lo tu: dás-lhe um nome, um esquema e uma lista de palavras para a verificação ortográfica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его можно собрать самому: дайте название, раскладку и список слов для проверки орфографии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以自己造一个：起个名字、选好布局，再给它一份用于拼写检查的词表。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îl puteți construi singur: dați-i un nume, un aspect și o listă de cuvinte cu care să verificați ortografic."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt het zelf bouwen: geef het een naam, een lay-out en een woordenlijst om de spelling te controleren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以自己造一個：起個名字、選好佈局，再給它一份用於拼寫檢查的詞表。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz go zbudować samodzielnie: nadaj mu nazwę, układ i listę słów do sprawdzania pisowni."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете створити його самостійно: дайте йому назву, макет і список слів для перевірки орфографії."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu kendiniz oluşturabilirsiniz: ona bir ad, bir düzen ve yazım denetimi yapılacak bir sözcük listesi verin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete si jej vytvořit sami: dejte mu název, rozvržení a seznam slov pro kontrolu pravopisu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžete si ho vytvoriť sami: pomenujte ho, rozloženie a zoznam slov na kontrolu pravopisu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να το δημιουργήσετε μόνοι σας: δώστε του ένα όνομα, μια διάταξη και μια λίστα λέξεων για ορθογραφικό έλεγχο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan bygga den själv: ge den ett namn, en layout och en ordlista att stavningskontrollera mot."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan bygge det selv: giv det et navn, et layout og en ordliste til stavekontrol i forhold til."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan bygge den selv: gi den et navn, et oppsett og en ordliste for stavekontroll mot."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit rakentaa sen itse: anna sille nimi, asettelu ja sanaluettelo oikeinkirjoituksen tarkistamista varten."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat membuatnya sendiri: beri nama, tata letak, dan daftar kata untuk diperiksa ejaannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể tự xây dựng nó: đặt tên, bố cục và danh sách từ để kiểm tra chính tả."
          }
        }
      }
    },
    "You can close this sheet. Find your requests and results in Build tasks.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can close this sheet. Find your requests and results in Build tasks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dieses Fenster schließen. Deine Anfragen und Ergebnisse findest du unter „Erstellungsaufgaben“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cerrar esta ventana. Encontrarás tus solicitudes y resultados en Tareas de creación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võid selle akna sulgeda. Päringud ja tulemused leiad koostamisülesannete alt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux fermer cette fenêtre. Retrouve tes demandes et résultats dans les tâches de création."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt az ablakot bezárhatod. Kéréseidet és az eredményeket a Létrehozási feladatok között találod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi chiudere questa finestra. Trovi le richieste e i risultati in Attività di creazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面は閉じても大丈夫です。リクエストと結果は「作成タスク」で確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면을 닫아도 됩니다. 요청과 결과는 생성 작업에서 확인할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menutup tetingkap ini. Cari permintaan dan hasil anda dalam Tugas pembinaan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes fechar esta janela. Encontras os teus pedidos e resultados em Tarefas de criação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это окно можно закрыть. Запросы и результаты доступны в разделе «Задачи создания»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以关闭此窗口。请求和结果可在“生成任务”中查看。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți închide această foaie. Găsiți solicitările și rezultatele dvs. în Build tasks."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U kunt dit blad sluiten. Vind uw verzoeken en resultaten in Build-taken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以關閉此視窗。請求和結果可在“生成任務”中檢視。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy kan hierdie venster toemaak. Vind jou versoeke en resultate onder \"Bou-take\"."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz zamknąć ten arkusz. Znajdź swoje żądania i wyniki w zadaniach tworzenia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете закрити цей аркуш. Знайдіть свої запити та результати в завданнях побудови."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sayfayı kapatabilirsiniz. İsteklerinizi ve sonuçlarınızı Derleme görevlerinde bulun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento list můžete zavřít. Najděte své požadavky a výsledky v úlohách sestavení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento list môžete zavrieť. Nájdite svoje požiadavky a výsledky v úlohách zostavovania."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να κλείσετε αυτό το φύλλο. Βρείτε τα αιτήματα και τα αποτελέσματά σας στο Build tasks."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan stänga det här arket. Hitta dina önskemål och resultat i Bygguppgifter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan lukke dette ark. Find dine anmodninger og resultater i Byg opgaver."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan lukke dette arket. Finn dine forespørsler og resultater i Bygg oppgaver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit sulkea tämän arkin. Löydä pyyntösi ja tulokset Build-tehtävistä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat menutup sheet ini. Temukan permintaan dan hasil Anda di tugas Build."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể đóng trang tính này. Tìm yêu cầu và kết quả của bạn trong Nhiệm vụ xây dựng."
          }
        }
      }
    },
    "You can keep up to %lld imported dictionaries. Remove one to make room.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy kan byhou tot %lld ingevoerde woordeboeke. Verwyder een om plek te maak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst bis zu %lld importierte Wörterbücher behalten. Entferne eines, um Platz zu schaffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes tener hasta %lld diccionarios importados. Elimina uno para hacer sitio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa võid hoida kuni %lld imporditud sõnaraamatut. Eemalda üks, et ruumi teha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux conserver jusqu’à %lld dictionnaires importés. Supprimes-en un pour faire de la place."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb %lld importált szótárat tarthatsz meg. Törölj egyet, hogy helyet szabadíts fel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi tenere fino a %lld dizionari importati. Rimuovine uno per fare spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んだ辞書は最大 %lld 個までです。ひとつ削除して空きを作ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 사전은 최대 %lld개까지 보관할 수 있습니다. 하나를 삭제해 자리를 비우세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menyimpan sehingga %lld kamus yang diimport. Buang satu untuk memberi ruang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes manter até %lld dicionários importados. Remove um para abrir espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно держать до %lld импортированных словарей. Уберите один, чтобы освободить место."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可保留 %lld 个导入的词典。请删除一个以腾出空间。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți păstra până la %lld dicționare importate. Scoateți unul pentru a face loc."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U kunt maximaal geïmporteerde %lld-woordenboeken bewaren. Verwijder er één om ruimte te maken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可保留 %lld 個匯入的詞典。請刪除一個以騰出空間。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz mieć dostęp do słowników zaimportowanych przez %lld. Usuń jeden, aby zrobić miejsce."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете зберігати до %lld імпортованих словників. Видаліть один, щоб звільнити місце."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld'e kadar içe aktarılan sözlükleri saklayabilirsiniz. Yer açmak için birini çıkarın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete si ponechat až %lld importovaných slovníků. Odstraňte jeden, abyste uvolnili místo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžete si ponechať až %lld importovaných slovníkov. Odstráňte jeden, aby ste uvoľnili miesto."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να διατηρήσετε έως και εισαγόμενα λεξικά %lld. Αφαιρέστε ένα για να κάνετε χώρο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan behålla upp till %lld importerade ordböcker. Ta bort en för att få plats."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan beholde op til %lld importerede ordbøger. Fjern en for at gøre plads."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan beholde opptil %lld importerte ordbøker. Fjern en for å få plass."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit säilyttää jopa %lld tuotuja sanakirjoja. Poista yksi tehdäksesi tilaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat menyimpan hingga kamus yang diimpor %lld. Hapus satu untuk memberi ruang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể theo kịp các từ điển đã nhập %lld. Loại bỏ một cái để nhường chỗ."
          }
        }
      }
    },
    "You can rename and delete Cling's things from the keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy kan Cling se goed van die sleutelbord hernoem en uitvee."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Clings Sachen direkt von der Tastatur aus umbenennen und löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes renombrar y eliminar cosas de Cling desde el teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa saad Clingi asju klaviatuurilt ümber nimetada ja kustutada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux renommer et supprimer les éléments de Cling depuis le clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűzetről átnevezheted és törölheted a Cling elemeit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi rinominare ed eliminare le cose di Cling dalla tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードから Cling の項目の名前変更や削除ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드에서 Cling의 항목을 이름 변경하고 삭제할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menamakan semula dan memadam perkara Cling dari papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode renomear e eliminar as coisas do Cling a partir do teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объекты Cling можно переименовывать и удалять прямо с клавиатуры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以从键盘重命名和删除 Cling 里的内容。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți redenumi și șterge lucrurile lui Cling de la tastatură."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de dingen van Cling hernoemen en verwijderen via het toetsenbord."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以從鍵盤重新命名和刪除 Cling 裡的內容。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz zmieniać nazwy i usuwać rzeczy Cling z klawiatury."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете перейменовувати та видаляти речі Cling з клавіатури."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cling'in eşyalarını klavyeden yeniden adlandırabilir ve silebilirsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Věci Cling můžete přejmenovat a odstranit z klávesnice."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Veci Cling môžete premenovať a odstrániť z klávesnice."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να μετονομάσετε και να διαγράψετε τα πράγματα του Cling από το πληκτρολόγιο."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan byta namn på och ta bort Cling saker från tangentbordet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan omdøbe og slette Cling's ting fra tastaturet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan gi nytt navn til og slette Cling sine ting fra tastaturet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit nimetä uudelleen ja poistaa Cling:n asioita näppäimistöltä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat mengganti nama dan menghapus item Cling dari keyboard."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể đổi tên và xóa những thứ của Cling khỏi bàn phím."
          }
        }
      }
    },
    "You can search in the app’s selected language or in English.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst in der ausgewählten App-Sprache oder auf Englisch suchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes buscar en el idioma seleccionado para la app o en inglés."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saad otsida rakenduse jaoks valitud keeles või inglise keeles."
