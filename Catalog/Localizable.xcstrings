    "Enabled actions appear behind the keyboard's action button.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geaktiveerde handelinge verskyn agter die sleutelbord se aksieknoppie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivierte Aktionen erscheinen hinter der Aktions-Taste der Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones activadas aparecen detrás del botón de acción del teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lubatud tegevused ilmuvad klaviatuuri tegevusnupu taha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions activées apparaissent derrière le bouton d'action du clavier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az engedélyezett műveletek a billentyűzet művelet gombja mögött jelennek meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le azioni attivate compaiono dietro il pulsante azioni della tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なアクションはキーボードのアクションボタンの奥に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜둔 액션은 키보드의 액션 버튼 뒤에 나타나요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan yang diaktifkan muncul di sebalik butang tindakan papan kekunci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ações ativadas aparecem atrás do botão de ação do teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включённые действия появляются за кнопкой действий на клавиатуре."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
