    "Clear data or turn features off whenever you want.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Vee data uit of skakel kenmerke af wanneer jy wil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Daten löschen oder Funktionen ausschalten, wann immer du willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra tus datos o desactiva funciones cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tühjenda andmeid või lülita funktsioone välja, millal iganes tahad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface des données ou coupe des fonctions quand tu veux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármikor törölheted az adatokat, vagy kikapcsolhatod a funkciókat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella i dati o disattiva le funzioni quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データを消したり機能をオフにしたり、いつでもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 언제든 지우고, 기능도 언제든 끌 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam data atau matikan ciri bila-bila masa anda mahu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa dados ou desliga funcionalidades quando quiseres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляйте данные или выключайте функции когда угодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
