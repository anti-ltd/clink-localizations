    "Gestures has the trail, timings, and two-thumb word composition: both thumbs can build one word.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebare het die spoor, tydsberekeninge en tweeduimwoordsamestelling: albei duime kan een woord bou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter „Gesten“ findest du die Spur, die Zeiten und die Zwei-Daumen-Wortkomposition: Beide Daumen können ein Wort bilden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Gestos están la estela, los tiempos y la composición de palabras con dos pulgares: ambos pueden formar una palabra."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Žestide all on jälg, ajastused ja kahe pöidla sõnakoostamine: mõlemad pöidlad saavad moodustada ühe sõna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Gestes se trouvent la traînée, les délais et la composition à deux pouces : les deux pouces peuvent former un seul mot."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gesztusok között van a csík, az időzítés és a két hüvelykujjas szóalkotás: mindkét hüvelykujj egy szót építhet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Gesti trovi la scia, i tempi e la composizione a due pollici: entrambi possono creare una sola parola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ジェスチャ」には軌跡や時間の設定に加え、両方の親指で1語を作る入力もあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제스처에는 궤적과 타이밍은 물론, 양쪽 엄지로 한 단어를 만드는 입력도 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerak isyarat mempunyai jejak, pemasaan dan gubahan perkataan dua ibu jari: kedua-duanya boleh membina satu perkataan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Gestos estão o rasto, os tempos e a composição de palavras a dois polegares: ambos podem construir uma palavra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Жестах» — след пальца, тайминги и составление слова двумя большими пальцами: оба могут создавать одно слово."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“手势”里有轨迹、时间设置，以及双拇指组词：两个拇指可以共同组成一个词。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesturile are traseul, sincronizarea și compoziția cuvintelor cu două degete mari: ambele degete mari pot construi un cuvânt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebaren hebben het spoor, de timing en de woordsamenstelling met twee duimen: beide duimen kunnen één woord vormen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“手勢”裡有軌跡、時間設定，以及雙拇指組詞：兩個拇指可以共同組成一個詞。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesty mają ślad, synchronizację i kompozycję słów dwoma kciukami: oba kciuki mogą zbudować jedno słowo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жести мають слід, час і складання слів двома великими пальцями: обидва великі пальці можуть складати одне слово."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketlerde iz, zamanlama ve iki başparmak ile kelime kompozisyonu bulunur: her iki başparmak da bir kelime oluşturabilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesta mají stopu, časování a složení slov dvěma palci: oba palce mohou vytvořit jedno slovo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestá majú stopu, načasovanie a zloženie slov dvoma palcami: oba palce môžu vytvoriť jedno slovo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι χειρονομίες έχουν τη διαδρομή, τους χρονισμούς και τη σύνθεση λέξεων με δύο αντίχειρες: και οι δύο αντίχειρες μπορούν να δημιουργήσουν μια λέξη."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gester har spåret, timing och ordsammansättning med två tummar: båda tummarna kan bygga ett ord."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestures har sporet, timing og ordsammensætning med to tommelfingre: begge tommelfingre kan bygge ét ord."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gester har sporet, timingen og ordsammensetningen med to tommelfinger: begge tomlene kan bygge ett ord."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleissä on jäljitys, ajoitukset ja kahden peukalon sanakokoonpano: molemmat peukalot voivat rakentaa yhden sanan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestur memiliki jejak, pengaturan waktu, dan komposisi kata dengan dua jempol: kedua jempol dapat membentuk satu kata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cử chỉ có dấu vết, thời gian và bố cục từ bằng hai ngón tay cái: cả hai ngón tay cái đều có thể tạo thành một từ."
          }
        }
      }
    },
    "Gestures → Cursor sets movement type, feel, and tap to select.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebare → Wyser stel bewegingtipe, gevoel en tik om te kies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesten → Cursor stellt Bewegungsart, Gefühl und Tippen zum Markieren ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestos → Cursor ajusta el tipo de movimiento, el tacto y tocar para seleccionar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Žestid → Kursor sätestab liikumise liigi, tunnetuse ja puudutuse valimiseks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestes → Curseur règle le type de mouvement, le ressenti et toucher pour sélectionner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesztusok → Kurzor állítja a mozgás típusát, az érzést és az érintésre kijelölést."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesti → Cursore imposta tipo di movimento, feeling e tocca per selezionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジェスチャー → カーソルで移動の種類、感触、タップして選択を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제스처 → 커서에서 이동 방식, 느낌, 탭해서 선택을 설정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerak isyarat → Kursor menetapkan jenis pergerakan, rasa, dan ketik untuk pilih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestos → Cursor define o tipo de movimento, o toque e tocar para selecionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жесты → Курсор задаёт тип движения, ощущение и «касание для выделения»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手势 → 光标可设置移动方式、手感和点按选择。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesturi → Cursorul setează tipul de mișcare, senzația și atingeți pentru a selecta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebaren → Cursor stelt het bewegingstype en gevoel in en tikt om te selecteren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手勢 → 游標可設定移動方式、手感和點按選擇。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesty → Kursor ustawia typ i styl ruchu, a następnie dotknij, aby wybrać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жести → Курсор встановлює тип руху, відчуття та торкання для вибору."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketler → İmleç hareket türünü, hissi ayarlar ve seçmek için dokunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesta → Kurzor nastavuje typ pohybu, pocit a klepnutím vyberte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestá → Kurzor nastavuje typ pohybu, pocit a klepnutím ho vyberiete."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χειρονομίες → Ο κέρσορας ορίζει τον τύπο κίνησης, την αίσθηση και πατήστε για επιλογή."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gester → Markören ställer in rörelsetyp, känsla och tryck för att välja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevægelser → Markør indstiller bevægelsestype, følelse og tryk for at vælge."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevegelser → Markør angir bevegelsestype, følelse og trykk for å velge."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleet → Kohdistin määrittää liiketyypin, tunteen ja valitse napauttamalla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerakan → Kursor mengatur jenis gerakan, rasa, dan ketuk untuk memilih."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cử chỉ → Con trỏ đặt kiểu chuyển động, cảm giác và chạm để chọn."
          }
        }
      }
    },
