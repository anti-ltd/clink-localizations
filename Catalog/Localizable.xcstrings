    "Learns where you actually tap each key and corrects for it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lernt, wo du jede Taste tatsächlich triffst, und gleicht das aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende dónde tocas realmente cada tecla y lo corrige."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Õpib, kuhu sa iga klahvi tegelikult puudutad, ja parandab selle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprend où vous touchez réellement chaque touche et le corrige."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megtanulja, hol érinted valójában az egyes billentyűket, és korrigálja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impara dove tocchi davvero ogni tasto e lo corregge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーを実際にタップする位置を学習して補正します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 키를 실제로 어디를 누르는지 학습해 보정해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mempelajari di mana anda sebenarnya menyentuh setiap kekunci dan membetulkannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende onde tocas realmente em cada tecla e corrige-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запоминает, куда вы на самом деле нажимаете на каждую клавишу, и исправляет это."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学习你实际点按每个键的位置并加以校正。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Află unde atingeți efectiv fiecare tastă și o corectează."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leert waar u daadwerkelijk op elke toets tikt en corrigeert daarvoor."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "學習你實際點按每個鍵的位置並加以校正。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer waar jy werklik elke sleutel tik en pas daarvolgens aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uczy się, gdzie faktycznie naciskasz każdy klawisz i koryguje to."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дізнається, де ви фактично натискаєте кожну клавішу, і виправляє це."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her bir tuşa gerçekte nereye dokunduğunuzu öğrenir ve buna göre düzeltme yapar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Učí se, kam vlastně klepnete na jednotlivé klávesy, a opraví to."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Učí sa, kde vlastne klepnete na jednotlivé klávesy, a opraví to."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μαθαίνει πού αγγίζετε πραγματικά κάθε πλήκτρο και το διορθώνει."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lär dig var du faktiskt trycker på varje tangent och korrigerar för det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lærer, hvor du rent faktisk trykker på hver tast og korrigerer for det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lærer hvor du faktisk trykker på hver tast og korrigerer for det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppii, missä todellisuudessa painat kutakin näppäintä, ja korjaa sen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelajari di mana Anda sebenarnya mengetuk setiap tombol dan memperbaikinya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm hiểu vị trí bạn thực sự nhấn vào từng phím và sửa lỗi đó."
          }
        }
      }
    },
    "Learns where you personally tap vs the key center": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer waar jy persoonlik tik teenoor die sleutelsentrum"
          }
        },
        "de": {
