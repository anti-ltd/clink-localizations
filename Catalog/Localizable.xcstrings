            "value": "好きな位置にキーや行を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 자리에 키나 행을 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah kekunci, atau baris, di tempat yang anda mahu."
          }
        },
