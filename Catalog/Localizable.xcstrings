    "Open Theme and tap one. The preview above changes as you go.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maak Tema oop en tik een. Die voorskou hierbo verander soos jy gaan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne „Design“ und tippe eines an. Die Vorschau darüber ändert sich sofort mit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Tema y toca uno. La vista previa de arriba cambia sobre la marcha."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava Teema ja puuduta üht. Ülalolev eelvaade muutub kohe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Thème et touches-en un. L'aperçu au-dessus change au fur et à mesure."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Témát, és koppints egyre. A fenti előnézet rögtön követi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Tema e toccane uno. L'anteprima sopra cambia man mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「テーマ」を開いてタップします。上のプレビューがその場で切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마를 열고 하나를 누르세요. 위쪽 미리보기가 바로 바뀝니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Tema dan ketik satu. Pratonton di atas berubah serta-merta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Tema e toca num. A pré-visualização em cima muda à medida que vais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Темы» и нажмите на любую. Предпросмотр выше меняется на ходу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“主题”点一个，上面的预览会跟着变。"
          }
        }
      }
    },
    "Open Theme and turn on Match system appearance.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maak Tema oop en skakel Pas stelselvoorkoms aan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne „Design“ und schalte „An Systemdarstellung anpassen“ ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Tema y activa Coincidir con el aspecto del sistema."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava Teema ja lülita sisse Jälgi süsteemi välimust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Thème et active Suivre l'apparence du système."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Témát, és kapcsold be az Illessze a rendszer megjelenését."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Tema e attiva Abbina all'aspetto del sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「テーマ」を開いて「システムの外観に合わせる」をオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마를 열고 시스템 화면 모드 따르기를 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Tema dan hidupkan Padankan penampilan sistem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Tema e liga Corresponder à aparência do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Темы» и включите «Как в системе»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“主题”，开启“匹配系统外观”。"
          }
        }
      }
    },
    "Open Themes and tap one. The preview above changes as you go.": {
      "comment": "FAQ instructions or search description. Match the localized screen and control names. Translation authored and independently reviewed by AI for 1.4.8; human native-speaker release review remains pending.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Themes und tippe auf eines. Die Vorschau darüber zeigt deine Auswahl sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Temas y toca uno. La vista previa de arriba cambia con cada selección."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava „Teemad” ja puuduta üht teemat. Ülal olev eelvaade muutub koos sinu valikuga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Thèmes et touche un thème. L’aperçu au-dessus change à chaque sélection."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Témák oldalt, és koppints egy témára. A fenti előnézet rögtön követi a választásodat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Temi e toccane uno. L’anteprima in alto cambia a ogni scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「テーマ」を開き、使いたいテーマをタップします。選ぶたびに上のプレビューが変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘테마’를 열고 원하는 테마를 탭하세요. 선택할 때마다 위쪽 미리 보기가 바뀝니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Tema dan ketik satu tema. Pratonton di atas berubah mengikut pilihan anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Temas e toca num tema. A pré-visualização acima muda a cada seleção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Темы» и нажмите на одну из них. Предпросмотр сверху сразу покажет изменения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“主题”，轻点一个主题。上方的预览会随选择即时更新。"
          }
        }
      }
    },
