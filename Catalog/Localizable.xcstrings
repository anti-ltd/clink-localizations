    "A panel replaces the keys with a UI of your own: a calculator, a board of snippets, anything you can lay out in Python.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Panel ersetzt die Tasten durch eine eigene UI: einen Taschenrechner, ein Snippet-Board, alles, was du in Python bauen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panel sustituye las teclas por una interfaz tuya: una calculadora, un tablero de fragmentos, lo que se te ocurra montar en Python."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panneau remplace les touches par ta propre interface : une calculatrice, un tableau de snippets, tout ce que tu peux construire en Python."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A panel lecseréli a billentyűket egy általad épített felületre: lehet számológép, snippet-tábla, bármi, amit Pythonban összeraksz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pannello sostituisce i tasti con un'interfaccia tua: una calcolatrice, una bacheca di snippet, qualsiasi cosa tu riesca a costruire in Python."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルはキーの代わりに自分だけのUIを表示します。電卓でも、スニペット集でも、Pythonで組めるものなら何でも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널은 키 대신 직접 만든 UI로 바꿔줘요. 계산기든, 스니펫 모음이든, 파이썬으로 만들 수 있는 건 뭐든지요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel menggantikan kekunci dengan UI anda sendiri: kalkulator, papan snippet, apa-apa sahaja yang boleh anda bina dalam Python."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um painel substitui as teclas por uma interface tua: uma calculadora, um quadro de snippets, o que quiseres montar em Python."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель заменяет клавиши вашим собственным интерфейсом: калькулятором, доской заготовок — чем угодно, что можно собрать на Python."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板会用你自己设计的界面替换按键：计算器、代码片段板，只要能用 Python 搭出来的都行。"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneel asendab klahvid sinu enda kasutajaliidesega: kalkulaator, tekstinippide tahvel — kõik, mida saad Pythonis üles ehitada."
          }
        },
        "af": {
          "stringUnit": {
            "state": "needs_review",
            "value": "'n Paneel vervang die sleutels met 'n UI van jou eie: 'n sakrekenaar, 'n bord van brokkies, enigiets wat jy in Python kan uitlê."
          }
        }
      }
    },
    "A photo fills behind the keys and overrides the gradient.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Foto liegt hinter den Tasten und überschreibt den Farbverlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una foto llena el fondo de las teclas y reemplaza el degradado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une photo remplit l'arrière des touches et remplace le dégradé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűk mögött egy fotó jelenik meg, ami felülírja a színátmenetet."
          }
        },
        "it": {
